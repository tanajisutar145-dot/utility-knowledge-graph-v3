# Copy to .env and fill in. Never commit .env.

# --- Neo4j (Neo4j Desktop / Server 5.13+ with the APOC plugin) -----------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# A dedicated database is created automatically when missing (Enterprise / Desktop developer licence).
# Neo4j Community has a single database: use neo4j.
NEO4J_DATABASE=utility-kg-v3

# --- LLM: Text2Cypher, answer generation (and entity extraction when extraction.mode = extract) ---
# LLM_PROVIDER: openai | openai_compatible | azure_openai | anthropic | ollama
#   openai_compatible: any OpenAI-compatible server, set LLM_BASE_URL (e.g. http://localhost:8000/v1)
#   azure_openai: LLM_BASE_URL = https://<resource>.openai.azure.com, LLM_MODEL = deployment name
#   ollama: LLM_BASE_URL defaults to http://localhost:11434
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
# Optional, Azure only:
# LLM_API_VERSION=2024-10-21

# --- Embeddings: chunk vectors for the vector / hybrid retrievers -------------
# Configured independently of the LLM (Anthropic has no embeddings API).
# EMBEDDING_PROVIDER: openai | openai_compatible | azure_openai | ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# Must match the model's output size (probed automatically when left empty).
EMBEDDING_DIMENSIONS=768
# Optional, Azure only:
# EMBEDDING_API_VERSION=2024-10-21

# --- Optional: alternative config file --------------------------------------------
# UKG_CONFIG=C:/path/to/another/config.yaml
