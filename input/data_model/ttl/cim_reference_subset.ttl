@prefix cmm: <http://www.utility-cmm.org/ontology/silver#> .
@prefix cmmsa: <http://www.utility-cmm.org/ontology/silver/subject-area#> .


<http://www.utility-cmm.org/ontology/cim-subset> a owl:Ontology ; dcterms:title "IEC CIM subset referenced by the Utility CMM"@en ; owl:versionInfo "CIM100 (CIM17) subset for CMM 1.0.0" .

cim:ACDCTerminal a owl:Class ;
    rdfs:label "ACDCTerminal"@en ;
    rdfs:comment "An electrical connection point (AC or DC) to a piece of conducting equipment."@en ;
    rdfs:subClassOf cim:IdentifiedObject ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" .

cim:ACLineSegment a owl:Class ;
    rdfs:label "ACLineSegment"@en ;
    rdfs:comment "A wire or combination of wires used to carry AC current between points in the power system."@en ;
    rdfs:subClassOf cim:ConductingEquipment ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" .

cim:ActivityRecord a owl:Class ;
    rdfs:label "ActivityRecord"@en ;
    rdfs:comment "Records activity for an entity at a point in time."@en ;
    rdfs:subClassOf cim:IdentifiedObject ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" .

cim:Agreement a owl:Class ;
    rdfs:label "Agreement"@en ;
    rdfs:comment "Formal agreement between two parties defining the terms and conditions for a set of services."@en ;
    rdfs:subClassOf cim:Document ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" .

cim:AnalogValue a owl:Class ;
    rdfs:label "AnalogValue"@en ;
    rdfs:comment "AnalogValue represents an analog MeasurementValue."@en ;
    rdfs:subClassOf cim:MeasurementValue ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" .

cim:AncillaryServiceClearing a owl:Class ;
    rdfs:label "AncillaryServiceClearing"@en ;
    rdfs:comment "Model of results of market clearing with respect to ancillary service products."@en ;
    cmm:cimPackage "IEC62325::MarketResults" ;
    cmm:cimStandard "IEC 62325-301" .

cim:Asset a owl:Class ;
