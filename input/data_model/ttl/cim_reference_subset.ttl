    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" .

cim:AssetContainer a owl:Class ;
    rdfs:label "AssetContainer"@en ;
    rdfs:comment "Asset that is aggregation of other assets such as conductors, transformers, switchgear, land, fences, buildings."@en ;
