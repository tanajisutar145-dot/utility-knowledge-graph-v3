    cmm:cimDatatype "Boolean" .
cmm:RateSchedule.hasTieredPricing a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has tiered pricing"@en ;
    rdfs:comment "Indicates whether this rate schedule includes tiered or block pricing with different rates for different usage levels."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "has_tiered_pricing" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
