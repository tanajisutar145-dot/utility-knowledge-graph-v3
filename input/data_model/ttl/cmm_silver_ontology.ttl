cmm:SwitchingOrderMaterialRequisition a owl:Class ;
    rdfs:label "Switching Order Material Requisition"@en ;
    rdfs:comment "This association product represents the material requisition relationship between distribution switching orders and materials. It captures the specific materials required for each switching operation, including quantities planned, quantities issued from inventory, staging locations, and material returns. Each record links one switching order to one material with attributes that exist only in the context of this specific requisition.. Existence Justification: In utility distribution operations, switching orders routinely require multiple different materials (poles, transformers, conductors, insulators, hardware, protective equipment), and the same materials are used across many different switching orders over time. The business actively manages material requisitions as operational records, tracking planned quantities, actual issuance from inventory, staging locations for crew pickup, and returns of unused materials after job completion."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.switching_order_material_requisition" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.switching_order_material_requisition" ;
    owl:hasKey ( cmm:SwitchingOrderMaterialRequisition.switchingOrderMaterialRequisitionId ) .

cmm:SwitchingOrderMaterialRequisition.switchingOrderMaterialRequisitionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order material requisition id"@en ;
    rdfs:comment "Unique identifier for this switching order material requisition record. Primary key."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:long ;
    cmm:physicalColumn "switching_order_material_requisition_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Switching Order Material Requisition ID" ;
    cmm:cimDatatype "Integer" .
cmm:SwitchingOrderMaterialRequisition.distributionSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution switching order"@en ;
    rdfs:comment "Foreign key linking to the distribution switching order that requires this material"@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range cmm:DistributionSwitchingOrder ;
    cmm:physicalColumn "distribution_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order Material Requisition - Distribution Switching Order Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_material_requisition_distribution_switching_order_id" ;
    cmm:cimAssociation "IdentifiedObject.SwitchingPlan" .
cmm:SwitchingOrderMaterialRequisition.issuedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "issued by employee"@en ;
    rdfs:comment "Foreign key reference to the warehouse or inventory employee who issued this material to the field crew. Used for accountability and audit trail."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "issued_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issued By Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_material_requisition_issued_by_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:SwitchingOrderMaterialRequisition.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to the material master record for the required material"@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order Material Requisition - Material Master Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_material_requisition_material_master_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpItemMaster" .
cmm:SwitchingOrderMaterialRequisition.receivedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "received by employee"@en ;
    rdfs:comment "Foreign key reference to the field crew member who received this material for the switching order. Used for chain of custody tracking."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "received_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Received By Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_material_requisition_received_by_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:SwitchingOrderMaterialRequisition.issueTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue timestamp"@en ;
    rdfs:comment "Date and time when this material was issued from inventory for this switching order. Used for inventory transaction tracking and crew logistics."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "issue_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issue Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SwitchingOrderMaterialRequisition.quantityIssued a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity issued"@en ;
    rdfs:comment "Actual quantity of this material issued from inventory to the crew for this switching order. May differ from quantity required due to availability or field adjustments."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_issued" ;
    cmm:sqlDataType "DECIMAL(13,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity Issued" ;
    cmm:cimDatatype "Decimal" .
cmm:SwitchingOrderMaterialRequisition.quantityRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity required"@en ;
    rdfs:comment "Planned quantity of this material required for the switching order, expressed in the material's base unit of measure. Determined during switching order planning phase."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_required" ;
    cmm:sqlDataType "DECIMAL(13,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity Required" ;
    cmm:cimDatatype "Decimal" .
cmm:SwitchingOrderMaterialRequisition.requisitionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition status"@en ;
    rdfs:comment "Current lifecycle status of this material requisition. Tracks progression from planning through issuance to return or consumption."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "requisition_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Requisition Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:SwitchingOrderMaterialRequisition.reservationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation number"@en ;
    rdfs:comment "Inventory reservation identifier linking this requisition to the inventory management system. Used to reserve materials prior to physical issuance."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "reservation_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reservation Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SwitchingOrderMaterialRequisition.returnQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return quantity"@en ;
    rdfs:comment "Quantity of this material returned to inventory after switching order completion. Unused materials are returned to maintain accurate inventory levels."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "return_quantity" ;
    cmm:sqlDataType "DECIMAL(13,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:SwitchingOrderMaterialRequisition.returnTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return timestamp"@en ;
    rdfs:comment "Date and time when unused material was returned to inventory after switching order completion. Null if no return occurred."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "return_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SwitchingOrderMaterialRequisition.stagingLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "staging location"@en ;
    rdfs:comment "Physical location where this material is staged for pickup by the field crew executing the switching order. May be a warehouse, yard, or field staging area identifier."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "staging_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Staging Location" ;
    cmm:cimDatatype "String" .
cmm:SwitchingOrderMaterialRequisition.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Unit of measure for quantities in this requisition record. Typically matches the material's base unit of measure but may differ for operational convenience."@en ;
    rdfs:domain cmm:SwitchingOrderMaterialRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .

cmm:FeederCrewAssignment a owl:Class ;
    rdfs:label "Feeder Crew Assignment"@en ;
    rdfs:comment "This association product represents the operational assignment of field crews to distribution feeders for maintenance, inspection, vegetation management, and emergency restoration work. It captures the assignment lifecycle, responsibility type (primary maintenance crew, backup crew, vegetation management crew), coverage area within the feeder territory, and assignment dates. Each record links one feeder to one crew with attributes that exist only in the context of this assignment relationship. Critical for dispatch optimization in OMS/ADMS, storm restoration planning, crew workload balancing, and regulatory compliance reporting (vegetation management cycles, inspection frequency).. Existence Justification: In energy utility distribution operations, feeders require maintenance, inspection, and emergency restoration services from multiple specialized crews (line crews for electrical work, vegetation management crews for tree trimming, cable crews for underground sections), and each crew is assigned to multiple feeders within their service territory. The business actively manages these assignments with specific responsibility types (primary/backup), coverage areas, and assignment dates to optimize dispatch routing in OMS/ADMS, ensure regulatory compliance (vegetation management cycles), and coordinate storm restoration efforts. This is an operational assignment process, not an analytical correlation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Assignment ;
    cmm:cimCloseMatch cim:Assignment ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.feeder_crew_assignment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.feeder_crew_assignment" ;
    owl:hasKey ( cmm:FeederCrewAssignment.feederCrewAssignmentId ) .

cmm:FeederCrewAssignment.feederCrewAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder crew assignment id"@en ;
    rdfs:comment "Unique identifier for this feeder-crew assignment record. Primary key."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "feeder_crew_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Feeder Crew Assignment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FeederCrewAssignment.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Foreign key linking to the field crew assigned to this feeder for maintenance, inspection, or restoration work."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Crew Assignment - Crew Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_crew_assignment_crew_id" ;
    cmm:cimAssociation "Assignment.Crew" .
cmm:FeederCrewAssignment.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the user or system process that created this assignment record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_crew_assignment_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:FeederCrewAssignment.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to the distribution feeder being maintained or served by this crew assignment."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Crew Assignment - Feeder Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_crew_assignment_feeder_id" ;
    cmm:cimAssociation "Assignment.Feeder" .
cmm:FeederCrewAssignment.lastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user employee"@en ;
    rdfs:comment "Identifier of the user or system process that last modified this assignment record. Used for audit trail."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_crew_assignment_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:FeederCrewAssignment.assignmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment end date"@en ;
    rdfs:comment "Date when this crew assignment to the feeder ended or is planned to end. Null for active assignments. Used to track assignment lifecycle and crew rotation history."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment End Date" ;
    cmm:cimDatatype "Date" .
cmm:FeederCrewAssignment.assignmentStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment start date"@en ;
    rdfs:comment "Date when this crew assignment to the feeder became effective. Used to track assignment history and calculate crew tenure on feeder for knowledge continuity."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Start Date" ;
    cmm:cimDatatype "Date" .
cmm:FeederCrewAssignment.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Current lifecycle status of the crew assignment. ACTIVE assignments are operational and used for dispatch. SUSPENDED assignments are temporarily inactive (crew on mutual aid deployment, equipment out of service). ENDED assignments are historical. PLANNED assignments are future-dated for crew rotation planning."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.status .
cmm:FeederCrewAssignment.assignmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment type"@en ;
    rdfs:comment "Classification of the crew's responsibility for this feeder. PRIMARY_MAINTENANCE crews handle routine maintenance and are first responders for outages. BACKUP crews provide coverage during peak periods or when primary crew is unavailable. VEGETATION_MANAGEMENT crews handle tree trimming cycles. EMERGENCY_RESTORATION crews are assigned during storm events. Determines dispatch priority and work order routing in OMS/ADMS."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.type .
cmm:FeederCrewAssignment.averageResponseTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average response time minutes"@en ;
    rdfs:comment "Historical average time in minutes for this crew to respond to outage calls on this specific feeder, measured from dispatch to arrival. Used for restoration time estimation and crew assignment optimization. Varies by crew-feeder combination due to travel distance and familiarity with feeder topology."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "average_response_time_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Response Time" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:FeederCrewAssignment.coverageAreaDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "coverage area description"@en ;
    rdfs:comment "Textual description of the geographic coverage area or feeder segments this crew is responsible for within the feeder territory. May reference mile markers, geographic boundaries, or circuit sections. Used when a feeder spans multiple crew territories or when specialized crews handle specific segments (e.g., underground vs overhead sections)."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "coverage_area_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Coverage Area Description" ;
    cmm:cimDatatype "String" .
cmm:FeederCrewAssignment.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this assignment record was created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Assignment.createdDateTime .
cmm:FeederCrewAssignment.dispatchPriorityRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority rank"@en ;
    rdfs:comment "Numeric ranking for dispatch priority when multiple crews are assigned to the same feeder. Lower numbers indicate higher priority. Used by OMS/ADMS to route emergency work orders to the most appropriate crew based on assignment type, crew location, and current workload."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "dispatch_priority_rank" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Priority Rank" ;
    cmm:cimDatatype "Integer" .
cmm:FeederCrewAssignment.lastModifiedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified date"@en ;
    rdfs:comment "Timestamp when this assignment record was last updated. Used for change tracking and data freshness assessment."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FeederCrewAssignment.lastWorkOrderDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last work order date"@en ;
    rdfs:comment "Date of the most recent work order completed by this crew on this feeder. Used to track crew activity levels, identify underutilized assignments, and ensure regular crew familiarity with feeder infrastructure."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_work_order_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Work Order Date" ;
    cmm:cimDatatype "Date" .
cmm:FeederCrewAssignment.primaryResponsibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary responsibility flag"@en ;
    rdfs:comment "Indicates whether this crew has primary operational responsibility for the feeder (true) or is a backup/secondary assignment (false). Only one crew should have primary responsibility for a feeder at any time for a given assignment type. Used for dispatch routing and accountability."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "primary_responsibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Responsibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FeederCrewAssignment.workOrderCountYtd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order count ytd"@en ;
    rdfs:comment "Total number of work orders completed by this crew on this feeder in the current calendar year. Used for workload balancing, crew performance assessment, and assignment optimization."@en ;
    rdfs:domain cmm:FeederCrewAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "work_order_count_ytd" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Order Count Year-to-Date" ;
    cmm:cimDatatype "Integer" .


#################################################################
# Subject area: finance
#################################################################

cmm:CostCenter a owl:Class ;
    rdfs:label "Cost Center"@en ;
    rdfs:comment "SAP S/4HANA CO master data entity representing organizational units to which costs are assigned for internal management reporting. Captures cost center ID, name, hierarchy node, responsible manager, controlling area, profit center assignment, currency, validity period, and activity type. SSOT for OPEX cost collection, overhead allocation, and FERC cost-of-service study segmentation across generation, transmission, distribution, and corporate functions."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimExtends cim:Organisation ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.cost_center" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "SAP CO; SAP CO Cost Center (KS01)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.cost_center" ;
    owl:hasKey ( cmm:CostCenter.costCenterId ) .

cmm:CostCenter.costCenterId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center id"@en ;
    rdfs:comment "Unique identifier for the cost center. Primary key for the cost center master data entity in SAP S/4HANA Controlling (CO) module."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:long ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Cost Center ID" ;
    cmm:cimDatatype "Integer" .
cmm:CostCenter.primaryCostEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary cost employee"@en ;
    rdfs:comment "Employee ID of the manager or supervisor responsible for this cost center. Accountable for budget management and cost control."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_cost_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Person ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_cost_center_primary_cost_employee_id" ;
    cmm:cimAssociation "Organisation.ErpPersonnel" .
cmm:CostCenter.activityTypeAllowedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "activity type allowed flag"@en ;
    rdfs:comment "Indicates whether activity types can be posted to this cost center. Relevant for cost centers that provide internal services (e.g., maintenance hours, engineering hours)."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "activity_type_allowed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Activity Type Allowed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.budgetProfileCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget profile code"@en ;
    rdfs:comment "Budget profile defining budget control and availability checking rules for this cost center. Controls whether budget overruns are allowed and how budget warnings are triggered."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_profile_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Profile Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.businessAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area code"@en ;
    rdfs:comment "Business area for segment reporting. Enables cross-company code financial analysis by business line (e.g., Generation, Transmission, Distribution)."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.capexOpexIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex opex indicator"@en ;
    rdfs:comment "Indicates whether costs posted to this cost center are primarily capital expenditures, operational expenditures, or a mix. Used for financial planning and regulatory asset base (RAB) calculations."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_opex_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) / Operational Expenditure (OPEX) Indicator" ;
    cmm:validValues "CAPEX|OPEX|MIXED" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.commitmentManagementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment management flag"@en ;
    rdfs:comment "Indicates whether commitment management (purchase requisitions and purchase orders) is active for this cost center. Used for budget control and funds management."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "commitment_management_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Management Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "Company code representing the legal entity to which this cost center is assigned. Used for external financial reporting and SOX compliance."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.controllingAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlling area code"@en ;
    rdfs:comment "Controlling area to which this cost center belongs. Represents the organizational unit for cost accounting and internal management reporting in SAP CO."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlling_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlling Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.costAllocationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation method"@en ;
    rdfs:comment "Method used to allocate costs from this cost center to other cost objects. Direct allocation assigns costs directly; assessment and distribution use allocation bases; activity-based uses activity drivers."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Method" ;
    cmm:validValues "direct|assessment|distribution|activity_based|none" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.costCenterCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center category"@en ;
    rdfs:comment "High-level classification of the cost center by business function. Used for cost allocation and regulatory reporting segmentation. Reference-value candidates: production|transmission|distribution|customer_service|administrative|sales|research|maintenance|corporate."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_category" ;
    cmm:sqlDataType "STRING" ;
