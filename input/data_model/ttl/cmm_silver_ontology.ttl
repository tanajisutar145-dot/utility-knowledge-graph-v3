cmm:HedgeStrategy a owl:Class ;
    rdfs:label "Hedge Strategy"@en ;
    rdfs:comment "Hedge strategy master record defining the utility's board-approved hedging programs for managing commodity price risk, basis risk, volumetric risk, and credit risk in the wholesale energy portfolio. Captures strategy name, hedge type (fixed-price forward, basis swap, collar, option, heat rate, CRR/FTR), target commodity and delivery period, hedge ratio and target volume, hedge horizon, risk metric targets (VaR, CVaR, expected shortfall), authorized instruments, board approval date and reference, IRP alignment flag, and ASC 815 hedge designation (fair value, cash flow, net investment). Includes hedge effectiveness testing: prospective and retrospective test methods (dollar-offset, regression, critical terms match), effectiveness thresholds, test frequency, test results history, and de-designation triggers. Links to trading books that execute the strategy. Supports hedge accounting documentation, ASC 815/IFRS 9 compliance, effectiveness testing audit trail, and risk committee reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.hedge_strategy" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "ASC 815; ETRM Hedge Program" ;
    cmm:sourceObject "energy_utilities_ecm.trading.hedge_strategy" ;
    owl:hasKey ( cmm:HedgeStrategy.hedgeStrategyId ) .

cmm:HedgeStrategy.hedgeStrategyId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge strategy id"@en ;
    rdfs:comment "Unique identifier for the hedge strategy record. Primary key."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:long ;
    cmm:physicalColumn "hedge_strategy_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Hedge Strategy ID" ;
    cmm:cimDatatype "Integer" .
cmm:HedgeStrategy.book a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "book"@en ;
    rdfs:comment "Identifier of the trading book in the ETRM system (OpenLink Endur) that executes trades under this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range cmm:TradingBook ;
    cmm:physicalColumn "book_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trading Book ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_hedge_strategy_book_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:HedgeStrategy.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Hedging strategies for capital projects (construction cost hedges, fuel hedges for new generation) must link to projects for cost-of-capital tracking. Real business process: IRP filings require disclo"@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_hedge_strategy_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:HedgeStrategy.complianceSoxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance sox control"@en ;
    rdfs:comment "Foreign key linking to compliance.sox_control. Business justification: Hedge strategies designated for hedge accounting must be tested for effectiveness under SOX controls. Internal audit tests hedge effectiveness quarterly as part of SOX 404 financial reporting controls"@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "compliance_sox_control_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Sox Control Id (Foreign Key)" ;
    cmm:sourceColumn "sox_control_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_hedge_strategy_compliance_sox_control_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:HedgeStrategy.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the employee or trader responsible for managing and executing this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Strategy Owner ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_hedge_strategy_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:HedgeStrategy.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: Hedge strategies are designed around price forecast scenarios. Risk managers link hedge strategies to price forecasts for hedge effectiveness testing (ASC 815), prospective/retrospective testing, and"@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_hedge_strategy_energy_price_id" ;
    cmm:cimAssociation "Document.RegularIntervalSchedule" .
cmm:HedgeStrategy.authorizedInstruments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized instruments"@en ;
    rdfs:comment "Comma-separated list of authorized derivative instruments that may be used to execute this hedge strategy (e.g., forwards, futures, swaps, options, collars)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_instruments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Instruments" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.boardApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board approval date"@en ;
    rdfs:comment "Date on which the board of directors approved this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.boardResolutionReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board resolution reference"@en ;
    rdfs:comment "Reference number or identifier of the board resolution that authorized this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "board_resolution_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Resolution Reference" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this hedge strategy record was first created in the system."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:HedgeStrategy.cvarTargetUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cvar target usd"@en ;
    rdfs:comment "Target Conditional Value at Risk (CVaR) or Expected Shortfall limit in USD for tail risk management."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cvar_target_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conditional Value at Risk (CVaR) Target USD" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:HedgeStrategy.dedesignationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dedesignation date"@en ;
    rdfs:comment "Date on which the hedge accounting designation was terminated or de-designated, if applicable."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "dedesignation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-designation Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.dedesignationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dedesignation reason"@en ;
    rdfs:comment "Explanation of why the hedge accounting designation was terminated."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "dedesignation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-designation Reason" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.dedesignationTriggerConditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dedesignation trigger conditions"@en ;
    rdfs:comment "Description of conditions that would trigger de-designation of the hedge accounting relationship (e.g., effectiveness falls outside 80-125%, forecasted transaction no longer probable)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "dedesignation_trigger_conditions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-designation Trigger Conditions" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.deliveryPeriodEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery period end"@en ;
    rdfs:comment "End date of the delivery period covered by this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "delivery_period_end" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.deliveryPeriodStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery period start"@en ;
    rdfs:comment "Start date of the delivery period covered by this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "delivery_period_start" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date on which this hedge strategy is scheduled to end or was terminated."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:HedgeStrategy.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date on which this hedge strategy became effective and operational."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:HedgeStrategy.effectivenessTestMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effectiveness test method"@en ;
    rdfs:comment "Method used to assess hedge effectiveness: dollar-offset, regression analysis, critical terms match, or VaR reduction."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "effectiveness_test_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Effectiveness Test Method" ;
    cmm:validValues "dollar_offset|regression_analysis|critical_terms_match|var_reduction" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.fercReportingCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting category"@en ;
    rdfs:comment "FERC reporting category or classification code applicable to this hedge strategy for regulatory filings."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_reporting_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reporting Category" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.hedgeAccountingDesignation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge accounting designation"@en ;
    rdfs:comment "ASC 815 hedge accounting designation type: fair value hedge, cash flow hedge, net investment hedge, or not designated for hedge accounting."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "hedge_accounting_designation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Accounting Designation" ;
    cmm:validValues "fair_value|cash_flow|net_investment|not_designated" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.hedgeDesignationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge designation date"@en ;
    rdfs:comment "Date on which the hedge accounting designation was formally documented and became effective."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "hedge_designation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Designation Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.hedgeExecutedInBook a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge executed in book"@en ;
    rdfs:comment "FK to trading.trading_book.trading_book_id — Hedge strategies are executed through specific trading books. This FK links board-approved hedging programs to the books that implement them."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:long ;
    cmm:physicalColumn "hedge_executed_in_book" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:HedgeStrategy.hedgeHorizonMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge horizon months"@en ;
    rdfs:comment "Time horizon in months over which the hedge strategy is executed and maintained."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:int ;
    cmm:physicalColumn "hedge_horizon_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Horizon Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:HedgeStrategy.hedgeObjective a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge objective"@en ;
    rdfs:comment "Primary risk management objective of the hedge strategy: price risk, basis risk, volumetric risk, credit risk, operational risk, or regulatory compliance."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "hedge_objective" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Objective" ;
    cmm:validValues "price_risk|basis_risk|volumetric_risk|credit_risk|operational_risk|regulatory_compliance" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.hedgeRatioTargetPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge ratio target pct"@en ;
    rdfs:comment "Target hedge ratio as a percentage of the underlying exposure that the strategy aims to hedge (0-100%)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hedge_ratio_target_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Ratio Target Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HedgeStrategy.hedgeToBook a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge to book"@en ;
    rdfs:comment "FK to trading.trading_book.trading_book_id — Hedge strategies are typically aligned to trading books for ASC 815 hedge accounting designation and effectiveness testing."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:long ;
    cmm:physicalColumn "hedge_to_book" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:HedgeStrategy.hedgedItemDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedged item description"@en ;
    rdfs:comment "Description of the underlying hedged item or forecasted transaction being protected by this strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "hedged_item_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedged Item Description" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.internalNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal notes"@en ;
    rdfs:comment "Free-text field for internal comments, strategy rationale, or special instructions related to this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "internal_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:HedgeStrategy.irpAlignmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "irp alignment flag"@en ;
    rdfs:comment "Indicates whether this hedge strategy is aligned with the utility's Integrated Resource Plan (IRP) as filed with the Public Utility Commission (PUC)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "irp_alignment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) Alignment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HedgeStrategy.irpFilingReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "irp filing reference"@en ;
    rdfs:comment "Reference to the specific IRP filing or docket number that supports this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "irp_filing_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) Filing Reference" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.lastEffectivenessRatioPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last effectiveness ratio pct"@en ;
    rdfs:comment "Calculated effectiveness ratio from the most recent test, expressed as a percentage."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "last_effectiveness_ratio_pct" ;
    cmm:sqlDataType "DECIMAL(7,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Effectiveness Ratio Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HedgeStrategy.lastEffectivenessTestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last effectiveness test date"@en ;
    rdfs:comment "Date of the most recent hedge effectiveness test performed for this strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_effectiveness_test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Effectiveness Test Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.lastEffectivenessTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last effectiveness test result"@en ;
    rdfs:comment "Result of the most recent hedge effectiveness test: highly effective, effective, ineffective, or not tested."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_effectiveness_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Effectiveness Test Result" ;
    cmm:validValues "highly_effective|effective|ineffective|not_tested" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.prospectiveTestThresholdPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prospective test threshold pct"@en ;
    rdfs:comment "Threshold percentage for prospective hedge effectiveness testing (typically 80-125% range per ASC 815)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "prospective_test_threshold_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prospective Test Threshold Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HedgeStrategy.retrospectiveTestThresholdPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retrospective test threshold pct"@en ;
    rdfs:comment "Threshold percentage for retrospective hedge effectiveness testing (typically 80-125% range per ASC 815)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "retrospective_test_threshold_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retrospective Test Threshold Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HedgeStrategy.riskCommitteeApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk committee approval date"@en ;
    rdfs:comment "Date on which the risk committee approved this hedge strategy."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:date ;
    cmm:physicalColumn "risk_committee_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Committee Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:HedgeStrategy.riskCommitteeApprovalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk committee approval flag"@en ;
    rdfs:comment "Indicates whether this hedge strategy has been reviewed and approved by the enterprise risk committee."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "risk_committee_approval_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Committee Approval Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HedgeStrategy.strategyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "strategy code"@en ;
    rdfs:comment "Business identifier code for the hedge strategy, used for external reference and reporting."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "strategy_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Strategy Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{3,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:HedgeStrategy.strategyName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "strategy name"@en ;
    rdfs:comment "Descriptive name of the hedge strategy program as approved by the board."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "strategy_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Strategy Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:HedgeStrategy.strategyStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "strategy status"@en ;
    rdfs:comment "Current lifecycle status of the hedge strategy: active, suspended, terminated, pending approval, or under review."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "strategy_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Strategy Status" ;
    cmm:validValues "active|suspended|terminated|pending_approval|under_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:HedgeStrategy.strategyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "strategy type"@en ;
    rdfs:comment "Classification of the hedge strategy type: fixed-price forward, basis swap, collar, option, heat rate, CRR/FTR (Congestion Revenue Rights/Financial Transmission Rights), volumetric, or credit hedge. Reference-value candidates: fixed_price_forward|basis_swap|collar|option|heat_rate|crr_ftr|volumetric|credit."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "strategy_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Strategy Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:HedgeStrategy.targetCommodity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target commodity"@en ;
    rdfs:comment "The commodity or product being hedged: electricity, natural gas, coal, renewable energy certificate (REC), capacity, or ancillary services."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "target_commodity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Commodity" ;
    cmm:validValues "electricity|natural_gas|coal|renewable_energy_certificate|capacity|ancillary_services" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.targetVolumeMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target volume mmbtu"@en ;
    rdfs:comment "Target volume in million British thermal units (MMBtu) to be hedged under this strategy for natural gas commodities."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_volume_mmbtu" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Volume Million British Thermal Units (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:HedgeStrategy.targetVolumeMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target volume mwh"@en ;
    rdfs:comment "Target volume in megawatt-hours (MWh) to be hedged under this strategy for electricity commodities."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_volume_mwh" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Volume Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:HedgeStrategy.testFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test frequency"@en ;
    rdfs:comment "Frequency at which hedge effectiveness testing is performed: monthly, quarterly, annually, at inception, or event-driven."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Frequency" ;
    cmm:validValues "monthly|quarterly|annually|at_inception|event_driven" ;
    cmm:cimDatatype "String" .
cmm:HedgeStrategy.toTradingBook a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to trading book"@en ;
    rdfs:comment "FK to trading.trading_book.trading_book_id — Hedge strategies are executed through trading books. This FK links strategy definition to execution and enables hedge effectiveness tracking against actual positions."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_trading_book" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:HedgeStrategy.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this hedge strategy record was last modified."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:HedgeStrategy.varConfidenceLevelPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "var confidence level pct"@en ;
    rdfs:comment "Confidence level percentage used for VaR calculation (e.g., 95%, 99%)."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "var_confidence_level_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Value at Risk (VaR) Confidence Level Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HedgeStrategy.varTargetUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "var target usd"@en ;
    rdfs:comment "Target Value at Risk (VaR) limit in USD that the hedge strategy aims to maintain for the portfolio."@en ;
    rdfs:domain cmm:HedgeStrategy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "var_target_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Value at Risk (VaR) Target USD" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:CapacityObligation a owl:Class ;
    rdfs:label "Capacity Obligation"@en ;
    rdfs:comment "Capacity market obligation and resource adequacy record capturing the utility's installed capacity (ICAP) or unforced capacity (UCAP) requirements and committed capacity resources in ISO/RTO capacity markets (PJM RPM, MISO PRA, NYISO ICAP, ISO-NE FCM). Captures obligation period, planning year, required MW, committed resource ID, capacity type (generation, demand response, energy efficiency, import), capacity price ($/MW-day), auction clearing reference, bilateral capacity purchase details, deficiency charge exposure, performance penalty risk, and NERC reliability standard compliance flag. Supports resource adequacy planning and capacity cost allocation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.capacity_obligation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ISO/RTO Capacity Market Obligation" ;
    cmm:sourceObject "energy_utilities_ecm.trading.capacity_obligation" ;
    owl:hasKey ( cmm:CapacityObligation.capacityObligationId ) .

cmm:CapacityObligation.capacityObligationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity obligation id"@en ;
    rdfs:comment "Unique identifier for the capacity obligation record in the ISO/RTO capacity market."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:long ;
    cmm:physicalColumn "capacity_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capacity Obligation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityObligation.batteryStorageAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "battery storage asset"@en ;
    rdfs:comment "Foreign key linking to renewable.battery_storage_asset. Business justification: Battery storage provides capacity in ISO markets with specific performance requirements. Links capacity obligations to battery assets for availability tracking, discharge duration validation, and perf"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:BatteryStorageAsset ;
    cmm:physicalColumn "battery_storage_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Battery Storage Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_battery_storage_asset_id" ;
    cmm:cimAssociation "Document.BatteryUnit" .
cmm:CapacityObligation.bilateralCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bilateral counterparty"@en ;
    rdfs:comment "Identifier of the counterparty in a bilateral capacity purchase agreement, if applicable."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "bilateral_counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Bilateral Counterparty Identifier" ;
    cmm:sourceColumn "counterparty_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_bilateral_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CapacityObligation.capacityRequirement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity requirement"@en ;
    rdfs:comment "Foreign key linking to forecast.capacity_requirement. Business justification: Capacity obligations must satisfy ISO/RTO capacity requirements derived from resource adequacy assessments. Compliance officers link obligations to formal capacity requirements to demonstrate fulfillm"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "capacity_requirement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Requirement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_capacity_requirement_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityObligation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Capacity obligations and associated costs are allocated to cost centers for rate case cost-of-service calculations. Real business process: rate case testimony requires capacity costs by functional cos"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CapacityObligation.demandDrEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "demand dr enrollment"@en ;
    rdfs:comment "Foreign key linking to demand.dr_enrollment. Business justification: Specific DR enrollments satisfy capacity obligations. Real business process: granular capacity resource tracking for ISO capacity market audits, performance measurement, and capacity payment allocatio"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "demand_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_demand_dr_enrollment_id" ;
    cmm:cimAssociation "Document.Agreement" .
cmm:CapacityObligation.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Identifier of the primary capacity resource (generation unit, demand response program, or import contract) committed to satisfy this obligation."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Resource Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_der_system_id" ;
    cmm:cimAssociation "Document.PowerElectronicsConnection" .
cmm:CapacityObligation.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to demand.dr_program. Business justification: Capacity obligations met through DR program enrollment. Real business process: PJM/NYISO/ISO-NE capacity market compliance where load-serving entities use DR programs to satisfy resource adequacy requ"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_dr_program_id" ;
    cmm:cimAssociation "Document.DemandResponseProgram" .
cmm:CapacityObligation.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the capacity planning analyst or resource adequacy manager responsible for managing this obligation."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Planner Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CapacityObligation.loadServingEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load serving entity"@en ;
    rdfs:comment "Identifier of the load serving entity responsible for this capacity obligation."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:LoadServingEntity ;
    cmm:physicalColumn "load_serving_entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Serving Entity (LSE) Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_load_serving_entity_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CapacityObligation.marketBid a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "market bid"@en ;
    rdfs:comment "FK to trading.market_bid.market_bid_id — Capacity obligations may be fulfilled through market participation (capacity auctions). This FK links the obligation to the market bid/award that satisfies it."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:MarketBid ;
    cmm:physicalColumn "market_bid_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_market_bid_id" ;
    cmm:cimAssociation "Document.Bid" .
cmm:CapacityObligation.peakDemand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand"@en ;
    rdfs:comment "Foreign key linking to forecast.peak_demand. Business justification: Capacity obligations are sized based on peak demand forecasts. Load-serving entities link capacity obligations to the peak demand forecasts used to determine required capacity purchases and demonstrat"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:PeakDemand ;
    cmm:physicalColumn "peak_demand_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Peak Demand Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_peak_demand_id" ;
    cmm:cimAssociation "Document.RegularIntervalSchedule" .
cmm:CapacityObligation.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Capacity obligations impact profit center economics and must be tracked for segment profitability analysis. Real business process: monthly management reporting shows capacity costs by profit center fo"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_profit_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CapacityObligation.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Capacity obligations and procurement are reported in state IRP filings and resource adequacy compliance reports. Regulatory teams demonstrate capacity procurement meets state reliability requirements"@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_capacity_obligation_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityObligation.auctionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction date"@en ;
    rdfs:comment "The date on which the capacity auction was conducted and clearing prices were established."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "auction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityObligation.auctionReferenceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction reference code"@en ;
    rdfs:comment "Reference identifier for the ISO/RTO capacity auction in which the capacity was procured (e.g., BRA, incremental auction identifier)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_reference_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Reference Identifier" ;
    cmm:cimDatatype "String" .
cmm:CapacityObligation.auctionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction type"@en ;
    rdfs:comment "Type of capacity procurement mechanism: base residual auction (BRA), incremental auction, reconfiguration auction, or bilateral capacity purchase."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Type" ;
    cmm:validValues "base_residual|incremental|reconfiguration|bilateral" ;
    cmm:cimDatatype "String" .
cmm:CapacityObligation.bilateralContractFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bilateral contract flag"@en ;
    rdfs:comment "Indicates whether the capacity was procured through a bilateral contract outside of the ISO/RTO auction (True) or through the auction mechanism (False)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "bilateral_contract_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bilateral Contract Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacityObligation.bilateralContractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bilateral contract number"@en ;
    rdfs:comment "Contract reference number for bilateral capacity purchase agreements."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "bilateral_contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Bilateral Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapacityObligation.capacityClearingPricePerMwDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity clearing price per mw day"@en ;
    rdfs:comment "The auction clearing price in dollars per megawatt-day for capacity in this zone and planning year, representing the market cost of capacity."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_clearing_price_per_mw_day" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Clearing Price per Megawatt-Day ($/MW-day)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityObligation.capacityMarketProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity market program"@en ;
    rdfs:comment "Name of the specific capacity market program (e.g., PJM Reliability Pricing Model, MISO Planning Resource Auction, NYISO Installed Capacity Market, ISO-NE Forward Capacity Market)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "capacity_market_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Market Program Name" ;
    cmm:cimDatatype "String" .
cmm:CapacityObligation.capacityPerformanceObligationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity performance obligation mw"@en ;
    rdfs:comment "The portion of committed capacity that is designated as Capacity Performance (CP) and subject to enhanced performance requirements and penalties during emergency conditions."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_performance_obligation_mw" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Performance Obligation Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityObligation.capacityShortfallMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity shortfall mw"@en ;
    rdfs:comment "The difference between required capacity and committed capacity, representing unmet obligation exposure (negative values indicate surplus)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_shortfall_mw" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Shortfall Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityObligation.committedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "committed capacity mw"@en ;
    rdfs:comment "The total capacity in megawatts that has been committed through generation resources, demand response, imports, or bilateral contracts to satisfy the obligation."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "committed_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Committed Capacity Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityObligation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this capacity obligation record was first created in the system."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:CapacityObligation.deficiencyChargeRatePerMwDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deficiency charge rate per mw day"@en ;
    rdfs:comment "The penalty rate in dollars per megawatt-day that applies if the utility fails to meet its capacity obligation, typically set by ISO/RTO tariff."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deficiency_charge_rate_per_mw_day" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deficiency Charge Rate per Megawatt-Day ($/MW-day)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityObligation.deficiencyExposureUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deficiency exposure usd"@en ;
    rdfs:comment "The potential financial exposure in USD if the capacity shortfall is not resolved, calculated as capacity_shortfall_mw * deficiency_charge_rate_per_mw_day * days_in_period."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deficiency_exposure_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deficiency Exposure United States Dollars (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapacityObligation.fercReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting flag"@en ;
    rdfs:comment "Indicates whether this capacity obligation must be included in FERC Form 1 or other FERC regulatory filings (True) or is exempt (False)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacityObligation.filingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing date"@en ;
    rdfs:comment "The date on which the capacity obligation and resource commitment were filed with the ISO/RTO for the planning year."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityObligation.forcedOutageRatePct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forced outage rate pct"@en ;
    rdfs:comment "The expected forced outage rate percentage applied to convert installed capacity (ICAP) to unforced capacity (UCAP) for the committed resources."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forced_outage_rate_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forced Outage Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CapacityObligation.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "Code identifying the ISO or RTO capacity market in which this obligation exists (PJM RPM, MISO PRA, NYISO ICAP, ISO-NE FCM). Reference-value candidates: PJM|MISO|NYISO|ISO-NE|CAISO|ERCOT|SPP."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Code" ;
    cmm:cimDatatype "String" .
cmm:CapacityObligation.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The timestamp when this capacity obligation record was last modified, reflecting changes to committed resources, shortfalls, or status."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CapacityObligation.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Indicates whether the capacity obligation and committed resources meet NERC reliability standards for resource adequacy (True) or have compliance gaps (False)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacityObligation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for internal notes, comments, or special conditions related to the capacity obligation, resource procurement strategy, or compliance considerations."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:CapacityObligation.obligationPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation period end date"@en ;
    rdfs:comment "The end date of the capacity obligation period, typically May 31 of the following year for most ISO/RTO markets."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "obligation_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Obligation Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityObligation.obligationPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation period start date"@en ;
    rdfs:comment "The start date of the capacity obligation period, typically June 1 for most ISO/RTO markets."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "obligation_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Obligation Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityObligation.obligationReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation reference number"@en ;
    rdfs:comment "External business identifier for the capacity obligation, used in ISO/RTO filings and internal tracking."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "obligation_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Obligation Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapacityObligation.obligationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation status"@en ;
    rdfs:comment "Current lifecycle status of the capacity obligation: draft (planning), active (obligation period in effect), satisfied (fully committed), deficient (shortfall exists), or closed (period ended)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "obligation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Obligation Status" ;
    cmm:validValues "draft|active|satisfied|deficient|closed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CapacityObligation.obligationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation type"@en ;
    rdfs:comment "Type of capacity obligation: ICAP (Installed Capacity), UCAP (Unforced Capacity), PLC (Peak Load Contribution), or CONE (Cost of New Entry)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "obligation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Obligation Type" ;
    cmm:validValues "ICAP|UCAP|PLC|CONE" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:CapacityObligation.peakLoadForecastMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak load forecast mw"@en ;
    rdfs:comment "The forecasted peak load in megawatts for the obligation period, used as the basis for calculating the capacity requirement."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_load_forecast_mw" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Load Forecast Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityObligation.performancePenaltyRiskFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance penalty risk flag"@en ;
    rdfs:comment "Indicates whether the committed capacity resources are subject to performance penalties during shortage events (True for capacity performance resources in PJM, False otherwise)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "performance_penalty_risk_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Penalty Risk Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacityObligation.planningYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning year"@en ;
    rdfs:comment "The planning year or delivery year for which the capacity obligation applies, typically formatted as YYYY/YYYY (e.g., 2024/2025)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "planning_year" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Year" ;
    cmm:cimDatatype "String" .
cmm:CapacityObligation.pucReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reporting flag"@en ;
    rdfs:comment "Indicates whether this capacity obligation must be reported to the state Public Utility Commission for resource adequacy compliance (True) or not (False)."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacityObligation.requiredCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required capacity mw"@en ;
    rdfs:comment "The total capacity requirement in megawatts that the utility must procure or demonstrate to meet resource adequacy standards."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "required_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Capacity Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityObligation.reserveMarginPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reserve margin pct"@en ;
    rdfs:comment "The planning reserve margin percentage applied to determine the capacity obligation, representing the buffer above forecasted peak load."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reserve_margin_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reserve Margin Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CapacityObligation.totalCapacityCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total capacity cost usd"@en ;
    rdfs:comment "The total cost in USD for procuring the committed capacity over the obligation period, calculated as committed_capacity_mw * capacity_clearing_price_per_mw_day * days_in_period."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_capacity_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Capacity Cost United States Dollars (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapacityObligation.zoneName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zone name"@en ;
    rdfs:comment "Name of the capacity zone or locational deliverability area (LDA) where the obligation applies."@en ;
    rdfs:domain cmm:CapacityObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "zone_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Zone Name" ;
    cmm:cimDatatype "String" .

cmm:SettlementStatement a owl:Class ;
    rdfs:label "Settlement Statement"@en ;
    rdfs:comment "Master reference table for settlement_statement. Referenced by settlement_statement_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MarketStatement ;
    cmm:cimCloseMatch cim:MarketStatement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::MarketManagement" ;
    cmm:cimStandard "IEC 62325-301 / IEC 62325-351" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.settlement_statement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 62325-351" ;
    cmm:sourceObject "energy_utilities_ecm.trading.settlement_statement" ;
    owl:hasKey ( cmm:SettlementStatement.settlementStatementId ) .

cmm:SettlementStatement.settlementStatementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement statement id"@en ;
    rdfs:comment "Primary key for settlement_statement"@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:long ;
    cmm:physicalColumn "settlement_statement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Settlement Statement Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SettlementStatement.contract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contract"@en ;
    rdfs:comment "Identifier of the power purchase agreement or bilateral contract associated with the settlement."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range cmm:TradingContract ;
    cmm:physicalColumn "contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_settlement_statement_contract_id" ;
    cmm:cimAssociation "MarketStatement.Agreement" .
cmm:SettlementStatement.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Identifier of the counterparty (buyer or seller) involved in the settlement."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_settlement_statement_counterparty_id" ;
    cmm:cimAssociation "MarketStatement.MarketParticipant" .
cmm:SettlementStatement.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Identifier of the underlying trade that this settlement statement settles."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_settlement_statement_trade_id" ;
    cmm:cimAssociation "MarketStatement.Trade" .
cmm:SettlementStatement.correctedSettlementStatement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrected settlement statement"@en ;
    rdfs:comment "Self-referencing FK on settlement_statement (corrected_settlement_statement_id)"@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range cmm:SettlementStatement ;
    cmm:physicalColumn "corrected_settlement_statement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_settlement_statement_corrected_settlement_statement_id" ;
    cmm:cimAssociation "MarketStatement.MarketStatement" .
cmm:SettlementStatement.adjustmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment amount"@en ;
    rdfs:comment "Net adjustments (taxes, fees, penalties) applied to the gross amount."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjustment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SettlementStatement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the settlement statement record was first created in the data lake."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MarketStatement.createdDateTime .
cmm:SettlementStatement.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO currency code for the monetary values."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:SettlementStatement.grossAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gross amount"@en ;
    rdfs:comment "Total amount before adjustments, in settlement currency."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gross_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SettlementStatement.invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice number"@en ;
    rdfs:comment "Reference number of the invoice generated for this settlement."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SettlementStatement.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "Market segment for which the settlement applies (e.g., day-ahead, real-time)."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:SettlementStatement.netAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net amount"@en ;
    rdfs:comment "Final amount payable after adjustments, in settlement currency."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SettlementStatement.paymentDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment due date"@en ;
    rdfs:comment "Date by which the net settlement amount must be paid."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:SettlementStatement.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "Current payment status of the settlement."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:SettlementStatement.postedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posted timestamp"@en ;
    rdfs:comment "Timestamp when the settlement statement was posted to the ledger."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "posted_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "DateTime" .
cmm:SettlementStatement.pricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "price per mwh"@en ;
    rdfs:comment "Settlement price applied per megawatt-hour."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:SettlementStatement.productType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "product type"@en ;
    rdfs:comment "Energy product category settled by this statement."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:string ;
    cmm:physicalColumn "product_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:SettlementStatement.quantityMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity mwh"@en ;
    rdfs:comment "Energy quantity settled, expressed in megawatt-hours."@en ;
    rdfs:domain cmm:SettlementStatement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:SettlementStatement.remarks a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remarks"@en ;
    rdfs:comment "Free-form comments or notes related to the settlement."@en ;
