cmm:SafetyIncident.testingProvider a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "testing provider"@en ;
    rdfs:comment "Name of the DOT-certified laboratory or collection site that performed the drug/alcohol test. Required for chain-of-custody documentation."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "testing_provider" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Testing Provider" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.witnessCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "witness count"@en ;
    rdfs:comment "Number of witnesses to the incident. Used to assess investigation completeness and corroboration of incident details."@en ;
