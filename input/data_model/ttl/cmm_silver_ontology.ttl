    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Eligible" ;
    cmm:cimDatatype "Boolean" .
cmm:RateSchedule.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User ID or system identifier of the person or process that created this rate schedule record."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
