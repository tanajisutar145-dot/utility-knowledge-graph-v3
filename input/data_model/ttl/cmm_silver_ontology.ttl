    cmm:physicalColumn "submitted_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Submitted Timestamp" ;
    cmm:cimDatatype "DateTime" .

cmm:EmsLoadForecast a owl:Class ;
    rdfs:label "Ems Load Forecast"@en ;
    rdfs:comment "Operational load forecast records produced by the EMS load forecasting function for the control area. Captures forecast run timestamp, forecast horizon type (hour-ahead, day-ahead, week-ahead), target hour, forecasted system load (MW), weather-adjusted load (MW), temperature input (°F), humidity input (%), forecast model version, and actual load (MW) populated post-interval for accuracy tracking. Distinct from the long-term capacity forecast (owned by forecast domain) — this is the real-time/short-term operational load forecast used by AGC and dispatch."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ConformLoadSchedule ;
    cmm:cimCloseMatch cim:ConformLoadSchedule ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::LoadModel" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.load_forecast" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EMS Load Forecasting / NERC BAL-001" ;
    cmm:sourceObject "energy_utilities_ecm.grid.load_forecast" ;
    owl:hasKey ( cmm:EmsLoadForecast.loadForecastId ) .

cmm:EmsLoadForecast.loadForecastId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load forecast id"@en ;
    rdfs:comment "Primary key for load_forecast"@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:long ;
    cmm:physicalColumn "load_forecast_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Load Forecast Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EmsLoadForecast.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Operational load forecasts are produced for a specific control area. This link scopes forecasts to the correct BA for AGC and dispatch coordination."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_control_area_id" ;
    cmm:cimAssociation "ConformLoadSchedule.ControlArea" .
cmm:EmsLoadForecast.forecastModel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast model"@en ;
    rdfs:comment "Foreign key linking to forecast.model. Business justification: Grid load forecasts should link to the forecast model used for accuracy tracking, model governance, and regulatory compliance. Model metadata (version, type, accuracy metrics) is essential for forecas"@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ForecastModel ;
    cmm:physicalColumn "forecast_model_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Model Id (Foreign Key)" ;
    cmm:sourceColumn "model_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_forecast_model_id" ;
    cmm:cimAssociation "ConformLoadSchedule.Document" .
cmm:EmsLoadForecast.forecastRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast run"@en ;
    rdfs:comment "Foreign key linking to forecast.run. Business justification: Grid domain load forecasts should reference the forecast run metadata for traceability, model versioning, and forecast accuracy analysis. Operators need to know which forecast run produced the values"@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ForecastRun ;
    cmm:physicalColumn "forecast_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_forecast_run_id" ;
    cmm:cimAssociation "ConformLoadSchedule.ActivityRecord" .
cmm:EmsLoadForecast.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Grid load forecasts are spatially scoped to forecast zones for geographic aggregation, weather correlation, and substation-level planning. Forecast zones enable hierarchical load forecasting from feed"@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_forecast_zone_id" ;
    cmm:cimAssociation "ConformLoadSchedule.LoadArea" .
cmm:EmsLoadForecast.loadControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load control area"@en ;
    rdfs:comment "Reference to the control area for which this load forecast was generated."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "load_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_load_control_area_id" ;
    cmm:cimAssociation "ConformLoadSchedule.ControlArea" .
cmm:EmsLoadForecast.loadForecastForControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load_forecast_for_control_area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Load forecasts are produced for a specific control area. Required for AGC and dispatch operations scoping."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "load_forecast_for_control_area" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_load_forecast_for_control_area" ;
    cmm:cimAssociation "ConformLoadSchedule.ControlArea" .
cmm:EmsLoadForecast.toControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Operational load forecasts are produced for a specific control area. This FK scopes the forecast to the correct balancing authority boundary."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "to_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_load_forecast_to_control_area_id" ;
    cmm:cimAssociation "ConformLoadSchedule.ControlArea" .
cmm:EmsLoadForecast.actualLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual load mw"@en ;
    rdfs:comment "The actual measured system load in megawatts (MW) for the target interval, populated post-interval from SCADA telemetry for forecast accuracy tracking and model tuning."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.agcParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc participation flag"@en ;
    rdfs:comment "Boolean flag indicating whether this forecast is actively used by the Automatic Generation Control system for real-time generation dispatch and frequency regulation."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsLoadForecast.baseLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base load mw"@en ;
    rdfs:comment "The baseline load component in megawatts (MW) representing the minimum continuous demand independent of weather or time-of-day variations."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.behindTheMeterGenerationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "behind the meter generation mw"@en ;
    rdfs:comment "The estimated distributed energy resource generation in megawatts (MW) occurring behind customer meters (rooftop solar, battery storage) that reduces net load visible to the grid."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "behind_the_meter_generation_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behind-the-Meter (BTM) Generation (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.cloudCoverInputPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cloud cover input percentage"@en ;
    rdfs:comment "The cloud cover percentage used as input to the load forecasting model, influencing solar radiation and temperature-driven load patterns."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cloud_cover_input_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cloud Cover Input Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmsLoadForecast.confidenceLevelPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level percentage"@en ;
    rdfs:comment "The statistical confidence level of the forecast expressed as a percentage, indicating the model's certainty in the predicted load value."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_level_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidence Level Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmsLoadForecast.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this load forecast record was first created and persisted in the data platform."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ConformLoadSchedule.createdDateTime .
cmm:EmsLoadForecast.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "The name of the source system or application that originated this load forecast record (e.g., EMS vendor name, forecasting module identifier)."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.dayType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "day type"@en ;
    rdfs:comment "The classification of the target day used in the forecast model to account for load pattern variations (weekday, weekend, holiday, or special event day)."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "day_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Day Type" ;
    cmm:validValues "weekday|weekend|holiday|special-event" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.demandResponseAdjustmentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response adjustment mw"@en ;
    rdfs:comment "The expected load reduction in megawatts (MW) from active demand response programs during the target interval, subtracted from gross load to calculate net forecasted load."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_response_adjustment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Adjustment (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "The name or identifier of the Energy Management System that generated this load forecast record."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.forecastErrorMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast error mw"@en ;
    rdfs:comment "The difference between forecasted load and actual load in megawatts (MW), calculated as (actual_load_mw - forecasted_load_mw), used for accuracy metrics and model performance evaluation."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_error_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Error (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.forecastErrorPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast error percentage"@en ;
    rdfs:comment "The forecast error expressed as a percentage of actual load, calculated as ((actual_load_mw - forecasted_load_mw) / actual_load_mw) * 100, used for model accuracy assessment."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_error_percentage" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Error Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmsLoadForecast.forecastHorizonType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast horizon type"@en ;
    rdfs:comment "The temporal horizon category of the forecast indicating the planning timeframe (hour-ahead for AGC, day-ahead for unit commitment, week-ahead for resource planning)."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "forecast_horizon_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Horizon Type" ;
    cmm:validValues "hour-ahead|day-ahead|week-ahead|intra-hour|real-time|multi-day" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.forecastLowerBoundMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast lower bound mw"@en ;
    rdfs:comment "The lower confidence interval bound for the forecasted load in megawatts (MW), representing the low-end estimate for minimum generation and reserve planning."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_lower_bound_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Lower Bound (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.forecastRunTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast run timestamp"@en ;
    rdfs:comment "The timestamp when the forecast model was executed and this forecast record was produced by the EMS load forecasting function."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "forecast_run_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Run Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsLoadForecast.forecastStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast status"@en ;
    rdfs:comment "The lifecycle status of the forecast record indicating whether it is preliminary, final, revised, superseded by a newer forecast, or archived."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "forecast_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Forecast Status" ;
    cmm:validValues "preliminary|final|revised|superseded|archived" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ConformLoadSchedule.status .
cmm:EmsLoadForecast.forecastUpperBoundMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast upper bound mw"@en ;
    rdfs:comment "The upper confidence interval bound for the forecasted load in megawatts (MW), representing the high-end estimate for reserve planning and contingency analysis."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_upper_bound_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Upper Bound (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.forecastedLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecasted load mw"@en ;
    rdfs:comment "The predicted system load in megawatts (MW) for the target interval as calculated by the EMS load forecasting model."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecasted_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecasted Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.humidityInputPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "humidity input percentage"@en ;
    rdfs:comment "The relative humidity percentage used as input to the load forecasting model, influencing cooling load and weather-sensitive demand patterns."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "humidity_input_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Humidity Input Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmsLoadForecast.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The timestamp when this load forecast record was last modified or updated, typically when actual load values are populated post-interval."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmsLoadForecast.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, comments, or explanations regarding forecast anomalies, model adjustments, or special conditions affecting this forecast."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EmsLoadForecast.peakIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak indicator"@en ;
    rdfs:comment "Boolean flag indicating whether the target interval is expected to be a system peak load period, used for resource adequacy and reserve planning."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "peak_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsLoadForecast.piHistorianTag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag"@en ;
    rdfs:comment "The OSIsoft PI historian tag name associated with this load forecast time series for integration with the real-time data historian and operational analytics."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.revisionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision number"@en ;
    rdfs:comment "The sequential revision number for this forecast target interval, incremented each time a new forecast is issued for the same target timestamp."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:int ;
    cmm:physicalColumn "revision_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Revision Number" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Document.revisionNumber .
cmm:EmsLoadForecast.scadaIntegrationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada integration flag"@en ;
    rdfs:comment "Boolean flag indicating whether this forecast record is integrated with SCADA telemetry for real-time actual load comparison and AGC feedback."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_integration_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Integration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsLoadForecast.season a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "season"@en ;
    rdfs:comment "The meteorological season classification for the target interval, used to apply seasonal load pattern adjustments in the forecasting model."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:string ;
    cmm:physicalColumn "season" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Season" ;
    cmm:validValues "winter|spring|summer|fall" ;
    cmm:cimDatatype "String" .
cmm:EmsLoadForecast.targetTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target timestamp"@en ;
    rdfs:comment "The specific date and time for which the load forecast applies (the future interval being forecasted)."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "target_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsLoadForecast.temperatureInputF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature input f"@en ;
    rdfs:comment "The temperature value in degrees Fahrenheit used as input to the load forecasting model, typically representing the control area weighted average or key city temperature."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_input_f" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature Input (°F)" ;
    cmm:cimDatatype "Decimal" .
cmm:EmsLoadForecast.weatherAdjustedLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather adjusted load mw"@en ;
    rdfs:comment "The forecasted load in megawatts (MW) after applying weather normalization adjustments based on temperature, humidity, and other meteorological inputs."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weather_adjusted_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather-Adjusted Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.weatherSensitiveLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather sensitive load mw"@en ;
    rdfs:comment "The portion of forecasted load in megawatts (MW) that is driven by weather conditions (heating, cooling, and weather-dependent industrial processes)."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weather_sensitive_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather-Sensitive Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsLoadForecast.windSpeedInputMph a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind speed input mph"@en ;
    rdfs:comment "The wind speed in miles per hour used as input to the load forecasting model, affecting heating and cooling load calculations."@en ;
    rdfs:domain cmm:EmsLoadForecast ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wind_speed_input_mph" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Speed Input (MPH)" ;
    cmm:unitSymbol "mph" ;
    cmm:cimDatatype "Speed" .

cmm:GenerationDispatch a owl:Class ;
    rdfs:label "Generation Dispatch"@en ;
    rdfs:comment "Transactional record of economic dispatch and unit commitment instructions issued by the EMS to generating units within the control area. Captures dispatch timestamp, generating unit reference, dispatch MW setpoint, economic merit order rank, operating cost ($/MWh), ramp rate (MW/min), minimum/maximum operating limits (MW), dispatch type (economic/emergency/must-run), and operator override indicator. Supports NERC BAL compliance, fuel cost optimization, and generation operations coordination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:GenUnitOpSchedule ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.generation_dispatch" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EMS Economic Dispatch / Unit Commitment" ;
    cmm:sourceObject "energy_utilities_ecm.grid.generation_dispatch" ;
    owl:hasKey ( cmm:GenerationDispatch.generationDispatchId ) .

cmm:GenerationDispatch.generationDispatchId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation dispatch id"@en ;
    rdfs:comment "Unique identifier for the generation dispatch instruction record. Primary key for the generation dispatch transaction."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:long ;
    cmm:physicalColumn "generation_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Generation Dispatch Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:GenerationDispatch.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Dispatch instructions are issued within a control area's generation fleet. FK to control_area is needed for BAL compliance and to scope dispatch to the correct balancing authority."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_control_area_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:GenerationDispatch.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "The identifier of the system operator who issued or approved this dispatch instruction. Populated for manual dispatches or operator overrides."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "System Operator Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_employee_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ErpPersonnel" .
cmm:GenerationDispatch.fuelSupplyContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel supply contract"@en ;
    rdfs:comment "Foreign key linking to supply.fuel_supply_contract. Business justification: Economic dispatch optimization requires fuel contract terms (pricing index, take-or-pay obligations, delivery constraints) to calculate operating costs and ensure contract compliance during unit commi"@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:FuelSupplyContract ;
    cmm:physicalColumn "fuel_supply_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fuel Supply Contract Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_fuel_supply_contract_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Agreement" .
cmm:GenerationDispatch.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Reference to the generating unit receiving this dispatch instruction within the control area."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:GenerationDispatch.generationControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generation control area"@en ;
    rdfs:comment "Reference to the control area issuing this dispatch instruction."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "generation_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_generation_control_area_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:GenerationDispatch.generationDispatchWithinControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generation_dispatch_within_control_area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Economic dispatch instructions are issued to generating units within a control area. Required for NERC BAL compliance scoping and dispatch optimization."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "generation_dispatch_within_control_area" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_generation_dispatch_within_control_area" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:GenerationDispatch.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Economic dispatch decisions often relate to specific internal orders for fuel procurement, emissions compliance projects, or ancillary service provision. Links operational dispatch to financial commit"@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_internal_order_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ErpProjectAccounting" .
cmm:GenerationDispatch.ppa a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa"@en ;
    rdfs:comment "Foreign key linking to trading.ppa. Business justification: Many generation dispatch instructions fulfill PPA delivery obligations. Linking enables real-time PPA compliance monitoring, settlement validation, and curtailment tracking. Essential for renewable en"@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:TradingPpa ;
    cmm:physicalColumn "ppa_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ppa Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_ppa_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Agreement" .
cmm:GenerationDispatch.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Reference to the SCADA point used to monitor the actual output of the generating unit in response to this dispatch instruction."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_scada_point_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Measurement" .
cmm:GenerationDispatch.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Dispatch instructions often execute physical delivery obligations from bilateral energy trades. Operators need trade context for dispatch compliance verification, settlement reconciliation, and audit"@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_generation_dispatch_trade_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Trade" .
cmm:GenerationDispatch.actualOutputMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual output mw"@en ;
    rdfs:comment "The actual real power output in megawatts (MW) achieved by the generating unit in response to this dispatch instruction, as measured by SCADA telemetry. Nullable until the unit responds."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_output_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Output Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationDispatch.agcParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc participation flag"@en ;
    rdfs:comment "Indicates whether this dispatch instruction is part of an Automatic Generation Control (AGC) signal for real-time frequency regulation. True if AGC-controlled, false if manual or economic dispatch."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationDispatch.ancillaryServiceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service type"@en ;
    rdfs:comment "The type of ancillary service this dispatch instruction is providing, if applicable. None indicates energy-only dispatch. Reference-value candidates: regulation_up|regulation_down|spinning_reserve|non_spinning_reserve|voltage_support|black_start|none."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "ancillary_service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Service Type" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.complianceToleranceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance tolerance mw"@en ;
    rdfs:comment "The acceptable deviation in megawatts (MW) between the dispatch setpoint and actual output for the unit to be considered compliant with the dispatch instruction."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "compliance_tolerance_mw" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Tolerance Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationDispatch.contingencyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency flag"@en ;
    rdfs:comment "Indicates whether this dispatch instruction was issued in response to a contingency event (transmission outage, generation loss, or other reliability event). True if contingency-related, false otherwise."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Dispatch Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationDispatch.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this dispatch record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.createdDateTime .
cmm:GenerationDispatch.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "The name of the source system from which this dispatch record originated. Typically the EMS system name or SCADA integration platform."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.dispatchComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch compliance flag"@en ;
    rdfs:comment "Indicates whether the generating unit complied with the dispatch instruction within the required tolerance and timeframe. True if compliant, false if non-compliant. Used for NERC BAL compliance reporting."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispatch_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationDispatch.dispatchMwSetpoint a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch mw setpoint"@en ;
    rdfs:comment "The target real power output in megawatts (MW) that the generating unit is instructed to achieve. This is the primary dispatch instruction value."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "dispatch_mw_setpoint" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Megawatt (MW) Setpoint" ;
    cmm:cimDatatype "Decimal" .
cmm:GenerationDispatch.dispatchNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch number"@en ;
    rdfs:comment "Business identifier for the dispatch instruction, typically generated by the Energy Management System (EMS) for operational tracking and audit purposes."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Instruction Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GenerationDispatch.dispatchReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch reason code"@en ;
    rdfs:comment "The operational reason code explaining why this dispatch instruction was issued. Reference-value candidates: economic_optimization|frequency_regulation|voltage_support|congestion_management|reserve_activation|emergency_response|must_run_contract|renewable_curtailment|manual_override|load_following|spinning_reserve|non_spinning_reserve|black_start."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Reason Code" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.dispatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch status"@en ;
    rdfs:comment "Current lifecycle status of the dispatch instruction: issued (sent to unit), acknowledged (received by unit), active (unit ramping or at setpoint), completed (instruction fulfilled), superseded (replaced by new instruction), or cancelled (instruction voided)."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Status" ;
    cmm:validValues "issued|acknowledged|active|completed|superseded|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.status .
cmm:GenerationDispatch.dispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch timestamp"@en ;
    rdfs:comment "The date and time when the dispatch instruction was issued by the EMS to the generating unit. This is the principal business event timestamp for the dispatch transaction."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Instruction Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GenerationDispatch.dispatchType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch type"@en ;
    rdfs:comment "The classification of the dispatch instruction indicating the operational reason for the dispatch: economic (cost-optimized), emergency (reliability event), must-run (contractual or reliability requirement), regulation (frequency control), manual (operator override), or AGC (Automatic Generation Control)."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Type" ;
    cmm:validValues "economic|emergency|must_run|regulation|manual|agc" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.kind .
cmm:GenerationDispatch.economicMeritOrderRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "economic merit order rank"@en ;
    rdfs:comment "The rank of this generating unit in the economic dispatch merit order at the time of dispatch, where 1 is the lowest-cost unit. Used for economic dispatch optimization and fuel cost minimization."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "economic_merit_order_rank" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Economic Merit Order Rank" ;
    cmm:cimDatatype "Integer" .
cmm:GenerationDispatch.effectiveEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end timestamp"@en ;
    rdfs:comment "The date and time when the dispatch instruction expires or is superseded by a subsequent dispatch instruction. Nullable for open-ended dispatches."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:GenerationDispatch.effectiveStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start timestamp"@en ;
    rdfs:comment "The date and time when the dispatch instruction becomes effective and the generating unit is expected to begin ramping to the target setpoint."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:GenerationDispatch.emissionsRateCo2LbsPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate co2 lbs per mwh"@en ;
    rdfs:comment "The carbon dioxide emissions rate in pounds per megawatt-hour (lbs/MWh) for this generating unit at the dispatch setpoint. Used for environmental compliance and carbon accounting."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_rate_co2_lbs_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Dioxide (CO2) Emissions Rate Pounds per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GenerationDispatch.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "The name or identifier of the Energy Management System (EMS) that issued this dispatch instruction. Used for multi-EMS environments and data lineage tracking."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "The primary fuel type of the generating unit receiving this dispatch instruction. Used for fuel cost tracking and emissions reporting. Reference-value candidates: coal|natural_gas|nuclear|hydro|wind|solar|biomass|oil|geothermal."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time when this dispatch record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GenerationDispatch.locationalMarginalPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "locational marginal price"@en ;
    rdfs:comment "The locational marginal price in dollars per megawatt-hour ($/MWh) at the generating unit's point of interconnection at the time of dispatch. Used for market settlement and economic dispatch optimization."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "locational_marginal_price" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:GenerationDispatch.marketSettlementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market settlement flag"@en ;
    rdfs:comment "Indicates whether this dispatch instruction is subject to wholesale market settlement with the RTO/ISO. True if market-settled, false if bilateral or internal dispatch."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "market_settlement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Settlement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationDispatch.maximumOperatingLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum operating limit mw"@en ;
    rdfs:comment "The maximum continuous operating output in megawatts (MW) for the generating unit. The dispatch setpoint must be at or below this limit."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_operating_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Operating Limit Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationDispatch.minimumOperatingLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum operating limit mw"@en ;
    rdfs:comment "The minimum stable operating output in megawatts (MW) for the generating unit. The dispatch setpoint must be at or above this limit when the unit is online."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_operating_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Operating Limit Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationDispatch.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, comments, or special instructions related to this dispatch instruction. Used for operator communication and post-event review."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:GenerationDispatch.operatingCostPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating cost per mwh"@en ;
    rdfs:comment "The marginal operating cost in dollars per megawatt-hour ($/MWh) for this generating unit at the time of dispatch. Includes fuel cost, variable O&M, and emissions costs. Used for economic dispatch calculations."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "operating_cost_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Cost per Megawatt-Hour (MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GenerationDispatch.operatorOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override flag"@en ;
    rdfs:comment "Indicates whether this dispatch instruction was manually overridden by a system operator, bypassing the automated economic dispatch algorithm. True if operator-initiated, false if system-generated."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationDispatch.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "The OSIsoft PI historian tag name associated with this dispatch instruction for time-series data archival and post-event analysis."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:GenerationDispatch.rampRateMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per min"@en ;
    rdfs:comment "The maximum rate at which the generating unit can change its output in megawatts per minute (MW/min). Used by the EMS to calculate the time required to reach the dispatch setpoint."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Megawatts (MW) per Minute" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:GenerationDispatch.responseTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response time seconds"@en ;
    rdfs:comment "The elapsed time in seconds from when the dispatch instruction was issued to when the generating unit reached the target setpoint within compliance tolerance. Nullable until the unit responds."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "response_time_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Time Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:GenerationDispatch.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "The code identifying the RTO or ISO market in which this dispatch instruction was issued, if applicable. Examples: PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP."@en ;
    rdfs:domain cmm:GenerationDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .

cmm:GridSwitchingOrder a owl:Class ;
    rdfs:label "Grid Switching Order"@en ;
    rdfs:comment "Operational record of a switching order — a formal, sequenced set of switching steps issued by the system operator to field crews for network reconfiguration, isolation, or restoration. Order-level attributes include switching order number, issuing operator, target substation and equipment, safety clearance reference, pre/post-switching network state, execution timestamps, and completion status. Step-level detail (grain: one row per step) captures sequence number, device identifier, action type (open/close/tag/verify), device pre/post-action status, executing crew member, execution timestamp, and step completion status. SSOT for switching order management including granular step-by-step audit trail used in NERC TOP compliance, outage coordination, and post-event review."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingPlan ;
    cmm:cimExactMatch cim:SwitchingPlan ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.grid_switching_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; NERC TOP-001 / GE PowerOn ADMS Switching Order" ;
    cmm:sourceObject "energy_utilities_ecm.grid.grid_switching_order" ;
    owl:hasKey ( cmm:GridSwitchingOrder.gridSwitchingOrderId ) .

cmm:GridSwitchingOrder.gridSwitchingOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order id"@en ;
    rdfs:comment "Unique identifier for the grid switching order. Primary key for this entity."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Grid Switching Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingOrder.affectedFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "affected feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit impacted by the switching operation, if applicable."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "affected_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Affected Feeder ID" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_affected_feeder_id" ;
    cmm:cimAssociation "SwitchingPlan.Feeder" .
cmm:GridSwitchingOrder.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Many switching orders support capital project execution (new substation commissioning, equipment upgrades). Links operational switching activity to capital project tracking for AFUDC calculation, capi"@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_capex_project_id" ;
    cmm:cimAssociation "SwitchingPlan.Project" .
cmm:GridSwitchingOrder.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Identifier of the control area or balancing authority responsible for coordinating this switching order."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_control_area_id" ;
    cmm:cimAssociation "SwitchingPlan.ControlArea" .
cmm:GridSwitchingOrder.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the primary substation where the switching operations will be performed."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Target Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_distribution_substation_id" ;
    cmm:cimAssociation "SwitchingPlan.Substation" .
cmm:GridSwitchingOrder.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: Switching operations at substations with environmental permits (SF6 gas handling, oil containment systems) must comply with permit conditions. This link ensures switching orders respect environmental"@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Environmental Permit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_environmental_permit_id" ;
    cmm:cimAssociation "SwitchingPlan.Document" .
cmm:GridSwitchingOrder.executingCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "executing crew"@en ;
    rdfs:comment "Identifier of the field crew or work group assigned to execute the switching order steps."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "executing_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Executing Crew ID" ;
    cmm:sourceColumn "crew_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_executing_crew_id" ;
    cmm:cimAssociation "SwitchingPlan.Crew" .
cmm:GridSwitchingOrder.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Switching orders for maintenance, capital projects, or emergency work are authorized against internal orders that track labor, materials, and contractor costs. Essential for work order cost settlement"@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_internal_order_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpProjectAccounting" .
cmm:GridSwitchingOrder.primaryGridEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary grid employee"@en ;
    rdfs:comment "Identifier of the system operator or control room operator who created and issued the switching order."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_grid_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issuing Operator ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_primary_grid_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:GridSwitchingOrder.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Identifier of the primary equipment asset (breaker, switch, transformer) that is the subject of the switching order."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Target Equipment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_registry_id" ;
    cmm:cimAssociation "SwitchingPlan.Asset" .
cmm:GridSwitchingOrder.safetyIncident a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident"@en ;
    rdfs:comment "Foreign key linking to workforce.safety_incident. Business justification: Switching orders can result in safety incidents (arc flash, equipment failure injuries). Linking enables OSHA recordkeeping correlation and switching procedure safety analysis for continuous improveme"@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:SafetyIncident ;
    cmm:physicalColumn "safety_incident_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Safety Incident Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_safety_incident_id" ;
    cmm:cimAssociation "SwitchingPlan.Incident" .
cmm:GridSwitchingOrder.stagingWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "staging warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Switching operations require material staging location for crew dispatch planning, especially for capital projects and emergency restoration. Warehouse proximity to target substation drives crew deplo"@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "staging_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Staging Warehouse Id (Foreign Key)" ;
    cmm:sourceColumn "warehouse_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_order_staging_warehouse_id" ;
    cmm:cimAssociation "SwitchingPlan.WorkLocation" .
cmm:GridSwitchingOrder.actualCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion timestamp"@en ;
    rdfs:comment "Actual date and time when the switching order execution was completed and verified, recorded for compliance audit and performance analysis."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingOrder.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time when the switching order execution began, recorded for compliance audit and performance analysis."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingOrder.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Explanation for why the switching order was cancelled or suspended, if applicable, used for operational review and lessons learned."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingOrder.completedStepCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completed step count"@en ;
    rdfs:comment "Number of switching steps that have been successfully completed and verified."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "completed_step_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Completed Step Count" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingOrder.completionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion notes"@en ;
    rdfs:comment "Free-text notes documenting any deviations, issues, or observations recorded during switching order execution, used for post-event review and compliance documentation."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "completion_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Completion Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:GridSwitchingOrder.contingencyAnalysisPerformed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis performed"@en ;
    rdfs:comment "Flag indicating whether a contingency analysis was performed to assess system reliability impacts before approving the switching order."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_performed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Performed" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the switching order record was first created in the system."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingPlan.createdDateTime .
cmm:GridSwitchingOrder.customerNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification required"@en ;
    rdfs:comment "Flag indicating whether customer notifications are required due to planned service interruption resulting from the switching operation."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Required" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the operational system that originated this switching order record, typically the EMS, ADMS, or OMS platform."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingOrder.emsIntegrationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems integration enabled"@en ;
    rdfs:comment "Flag indicating whether the switching order is integrated with the Energy Management System for state estimation and contingency analysis updates."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ems_integration_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Integration Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.estimatedCustomerImpactCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated customer impact count"@en ;
    rdfs:comment "Estimated number of customers who may experience service interruption as a result of the switching operation."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_customer_impact_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Customer Impact Count" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingOrder.estimatedLoadImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated load impact mw"@en ;
    rdfs:comment "Estimated load in megawatts that will be interrupted or transferred during the switching operation, used for system balancing and contingency analysis."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_load_impact_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Load Impact Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GridSwitchingOrder.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when the switching order record was most recently modified, used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GridSwitchingOrder.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Flag indicating whether this switching order is subject to NERC TOP reliability standard compliance reporting and audit requirements."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle status of the switching order from initial draft through approval, execution, and completion or cancellation. Reference-value candidates: draft|approved|issued|in_progress|completed|cancelled|suspended."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.status .
cmm:GridSwitchingOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classification of the switching order based on operational purpose: planned maintenance, emergency response, system restoration, equipment testing, or new asset commissioning."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Type" ;
    cmm:validValues "planned|emergency|maintenance|restoration|testing|commissioning" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.kind .
cmm:GridSwitchingOrder.outageCoordinationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage coordination required"@en ;
    rdfs:comment "Flag indicating whether this switching order requires coordination with neighboring utilities, Regional Transmission Organizations (RTO), or Independent System Operators (ISO)."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "outage_coordination_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Coordination Required" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.piHistorianTagPrefix a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag prefix"@en ;
    rdfs:comment "Tag prefix used in the OSIsoft PI historian system for archiving switching order execution data and equipment status changes."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag_prefix" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Prefix" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingOrder.postSwitchingNetworkState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post switching network state"@en ;
    rdfs:comment "Description of the intended network topology and equipment status after the switching order is completed, used for verification and state estimation."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "post_switching_network_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Post-Switching Network State" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:GridSwitchingOrder.preSwitchingNetworkState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre switching network state"@en ;
    rdfs:comment "Description of the network topology and equipment status before the switching order is executed, used for state verification and rollback planning."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "pre_switching_network_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Pre-Switching Network State" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:GridSwitchingOrder.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Operational priority assigned to the switching order based on system impact, safety considerations, and business urgency."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:validValues "critical|high|normal|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:GridSwitchingOrder.safetyClearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance number"@en ;
    rdfs:comment "Reference number for the associated safety clearance or work permit authorizing personnel to work on de-energized equipment."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Number" ;
    cmm:valuePattern "^[A-Z0-9-]{6,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GridSwitchingOrder.scadaVerificationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada verification enabled"@en ;
    rdfs:comment "Flag indicating whether SCADA telemetry is used to verify equipment status changes during switching order execution."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_verification_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Verification Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingOrder.scheduledCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled completion timestamp"@en ;
    rdfs:comment "Planned date and time when the switching order execution is scheduled to be completed and equipment returned to normal service."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingOrder.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "Planned date and time when the switching order execution is scheduled to begin."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingOrder.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Externally-known unique business identifier for the switching order, used by operators and field crews for reference and communication."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GridSwitchingOrder.taggingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tagging authority"@en ;
    rdfs:comment "Name or identifier of the person or role authorized to place safety tags on equipment during the switching sequence."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "tagging_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tagging Authority" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingOrder.targetEquipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target equipment type"@en ;
    rdfs:comment "Classification of the equipment being switched: circuit breaker, disconnect switch, transformer, or other grid device. Reference-value candidates: circuit_breaker|disconnect_switch|load_break_switch|transformer|capacitor_bank|reactor|bus_tie|recloser."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "target_equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Equipment Type" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingOrder.totalStepCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total step count"@en ;
    rdfs:comment "Total number of individual switching steps defined in this switching order sequence."@en ;
    rdfs:domain cmm:GridSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_step_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Step Count" ;
    cmm:cimDatatype "Integer" .

cmm:GridSwitchingStep a owl:Class ;
    rdfs:label "Grid Switching Step"@en ;
    rdfs:comment "Individual step within a switching order, representing a single discrete switching action (open or close a specific breaker, disconnect switch, or recloser). Captures step sequence number, parent switching order reference, device identifier, action type (open/close/tag/verify), device pre-action status, device post-action status, executing crew member, execution timestamp, and step completion status. Enables granular audit trail of switching sequence execution for NERC TOP compliance and post-event review."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingAction ;
    cmm:cimExactMatch cim:SwitchingAction ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.grid_switching_step" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; NERC TOP-001 Switching Step" ;
    cmm:sourceObject "energy_utilities_ecm.grid.grid_switching_step" ;
    owl:hasKey ( cmm:GridSwitchingStep.gridSwitchingStepId ) .

cmm:GridSwitchingStep.gridSwitchingStepId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching step id"@en ;
    rdfs:comment "Unique identifier for the individual switching step within a switching order. Primary key for the grid switching step entity."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:long ;
    cmm:physicalColumn "grid_switching_step_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Grid Switching Step Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingStep.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the switching device is located. Enables geographic and operational context for crew dispatch and coordination."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_distribution_substation_id" ;
    cmm:cimAssociation "SwitchingAction.Substation" .
cmm:GridSwitchingStep.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Reference to the parent switching order that contains this step. Links the step to its parent switching sequence for operational coordination and audit trail."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_grid_switching_order_id" ;
    cmm:cimAssociation "SwitchingAction.SwitchingPlan" .
cmm:GridSwitchingStep.primaryGridEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary grid employee"@en ;
    rdfs:comment "Identifier of the crew member or operator who executed this switching step. Used for accountability, training assessment, and incident investigation."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_grid_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Executing Crew Member Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_primary_grid_employee_id" ;
    cmm:cimAssociation "SwitchingAction.ErpPersonnel" .
cmm:GridSwitchingStep.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Individual switching steps target specific assets (circuit breakers, disconnects, reclosers). Work management and safety systems require asset-level traceability to retrieve equipment specifications,"@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_registry_id" ;
    cmm:cimAssociation "SwitchingAction.Asset" .
cmm:GridSwitchingStep.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Reference to the SCADA telemetry point that monitors the status of the switching device. Enables automated status verification and real-time operational visibility."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_scada_point_id" ;
    cmm:cimAssociation "SwitchingAction.Measurement" .
cmm:GridSwitchingStep.sparePartsCatalog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts catalog"@en ;
    rdfs:comment "Foreign key linking to supply.spare_parts_catalog. Business justification: Individual switching steps may require specific spare parts (fuses, bushings, control components) for contingency scenarios. Catalog link enables pre-positioning of critical spares at substation befor"@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range cmm:SparePartsCatalog ;
    cmm:physicalColumn "spare_parts_catalog_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Spare Parts Catalog Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_switching_step_spare_parts_catalog_id" ;
    cmm:cimAssociation "SwitchingAction.ErpItemMaster" .
cmm:GridSwitchingStep.actionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action type"@en ;
    rdfs:comment "Type of switching action to be performed on the device. Defines the specific operation required for this step in the switching sequence. Reference-value candidates: open|close|tag|verify|ground|remove_ground|rack_in|rack_out."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Type" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.actualDeviceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual device status"@en ;
    rdfs:comment "Actual observed status of the device after the switching action was executed. Captured from SCADA telemetry or field crew verification for audit trail and discrepancy detection."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "actual_device_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Device Status" ;
    cmm:validValues "open|closed|tagged|grounded|racked_out|unknown" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.actualExecutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual execution timestamp"@en ;
    rdfs:comment "Actual date and time when this switching step was executed. Captured from SCADA system or field crew reporting for precise audit trail and sequence timing analysis."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_execution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingStep.authorizationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization timestamp"@en ;
    rdfs:comment "Date and time when this switching step was authorized for execution. Documents the authorization event for operational audit trail and compliance verification."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "authorization_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingStep.clearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance number"@en ;
    rdfs:comment "Unique identifier of the safety clearance or work permit authorizing this switching step. Links to safety management system for compliance verification."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearance Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GridSwitchingStep.contingencyStepFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency step flag"@en ;
    rdfs:comment "Indicates whether this step is a contingency or alternate step to be executed only if primary steps fail. True for contingency steps, false for primary sequence steps."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_step_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Step Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this switching step record was first created in the system. Establishes the audit trail origin for the step record."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingAction.createdDateTime .
cmm:GridSwitchingStep.criticalStepFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical step flag"@en ;
    rdfs:comment "Indicates whether this step is critical to grid reliability or safety. True for steps that require enhanced verification or cannot be skipped without significant operational impact."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_step_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Step Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that originated this switching step record. Typically the Outage Management System (OMS), Advanced Distribution Management System (ADMS), or Energy Management System (EMS)."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.deviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device name"@en ;
    rdfs:comment "Human-readable name or designation of the switching device for operator recognition and communication. Typically includes substation name and device position identifier."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Name" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.deviceReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device reference"@en ;
    rdfs:comment "Unique identifier of the switching device (breaker, disconnect switch, recloser, or sectionalizing device) that is the target of this switching action. Links to asset registry or SCADA point configuration."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Identifier (ID)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.deviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:comment "Classification of the switching device being operated. Determines operational procedures, safety protocols, and switching sequence constraints."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Type" ;
    cmm:validValues "breaker|disconnect_switch|recloser|sectionalizer|load_break_switch|ground_switch" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.emsControlCommandReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems control command reference"@en ;
    rdfs:comment "Unique identifier of the EMS control command issued to execute this switching step remotely. Links to EMS audit logs for cyber security compliance and operational review."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_control_command_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Control Command Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.executingCrewMemberName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "executing crew member name"@en ;
    rdfs:comment "Name of the crew member or operator who executed this switching step. Provides human-readable identification for operational logs and audit trails."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "executing_crew_member_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Executing Crew Member Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Description of the reason why the switching step failed or could not be completed as planned. Captured for root cause analysis and procedure improvement."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Reason" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.holdTagApplied a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hold tag applied"@en ;
    rdfs:comment "Indicates whether a physical hold tag was applied to the device as part of this switching step. Used for lockout/tagout compliance and worker safety."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "hold_tag_applied" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hold Tag Applied" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.holdTagNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hold tag number"@en ;
    rdfs:comment "Unique identifier of the physical hold tag applied to the device. Enables tracking of lockout/tagout devices for safety compliance and tag removal coordination."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "hold_tag_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Hold Tag Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GridSwitchingStep.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this switching step record was last modified. Tracks the most recent change to the step record for audit trail and data quality monitoring."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GridSwitchingStep.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional operational notes, observations, or special conditions related to this switching step. Captures context not covered by structured fields."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:GridSwitchingStep.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name for the switching device status point. Enables retrieval of historical device status data for post-event analysis and compliance reporting."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.postActionDeviceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post action device status"@en ;
    rdfs:comment "Expected status of the device after the switching action is completed. Used for verification that the switching action achieved the intended result."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "post_action_device_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Action Device Status" ;
    cmm:validValues "open|closed|tagged|grounded|racked_out|unknown" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.preActionDeviceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre action device status"@en ;
    rdfs:comment "Expected status of the device before the switching action is executed. Used for verification and safety checks to ensure proper switching sequence execution."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "pre_action_device_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Action Device Status" ;
    cmm:validValues "open|closed|tagged|grounded|racked_out|unknown" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.remoteOperationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remote operation flag"@en ;
    rdfs:comment "Indicates whether this switching step was executed remotely via SCADA or Energy Management System (EMS) rather than by field crew. True for remote operations, false for manual field operations."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "remote_operation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Operation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.retryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retry count"@en ;
    rdfs:comment "Number of times this switching step was attempted before successful completion. Indicates operational challenges or equipment issues requiring investigation."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "retry_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retry Count" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingStep.safetyClearanceRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance required"@en ;
    rdfs:comment "Indicates whether this switching step requires a safety clearance or work permit before execution. True for steps involving energized equipment or confined spaces."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_clearance_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Clearance Required" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.scadaStatusConfirmed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada status confirmed"@en ;
    rdfs:comment "Indicates whether the device status change was confirmed via SCADA telemetry. True if SCADA confirmation received, false if manual verification only or SCADA unavailable."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_status_confirmed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Status Confirmed" ;
    cmm:cimDatatype "Boolean" .
cmm:GridSwitchingStep.scheduledExecutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled execution timestamp"@en ;
    rdfs:comment "Planned date and time for execution of this switching step. Used for crew scheduling, outage coordination, and operational planning."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_execution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingStep.stepDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step duration minutes"@en ;
    rdfs:comment "Actual elapsed time in minutes from step initiation to completion. Used for operational efficiency analysis, crew performance assessment, and future switching order planning."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "step_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:GridSwitchingStep.stepSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step sequence number"@en ;
    rdfs:comment "Sequential order of this step within the parent switching order. Determines the execution order of switching actions to ensure safe and coordinated grid operations."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "step_sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:GridSwitchingStep.stepStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step status"@en ;
    rdfs:comment "Current execution status of this switching step. Tracks the lifecycle state of the step from planning through completion for operational coordination and audit purposes. Reference-value candidates: pending|in_progress|completed|verified|failed|cancelled|on_hold."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "step_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Step Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingAction.status .
cmm:GridSwitchingStep.switchingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching authority"@en ;
    rdfs:comment "Role or position of the person who authorized this switching step. Defines the level of operational authority required for the switching action."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Authority" ;
    cmm:validValues "system_operator|field_supervisor|transmission_operator|distribution_dispatcher|substation_operator" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.verificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification timestamp"@en ;
    rdfs:comment "Date and time when the switching step completion was verified. Documents the verification event for compliance with two-person verification protocols."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "verification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Verification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridSwitchingStep.verifyingCrewMemberName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verifying crew member name"@en ;
    rdfs:comment "Name of the crew member or operator who verified the completion of this switching step. Provides human-readable identification for verification audit trail."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "verifying_crew_member_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Verifying Crew Member Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:GridSwitchingStep.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts of the circuit or equipment being switched. Critical for safety protocols, crew qualifications, and switching procedure selection."@en ;
    rdfs:domain cmm:GridSwitchingStep ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts - kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:VoltageControlAction a owl:Class ;
    rdfs:label "Voltage Control Action"@en ;
    rdfs:comment "Transactional record of voltage control actions taken by the EMS Volt-VAR optimization or operator to maintain voltage within acceptable limits. Captures action timestamp, control type (capacitor bank switching, reactor switching, transformer tap change, generator VAR dispatch), controlled device reference, pre-action voltage (kV), post-action voltage (kV), MVAR change, initiating cause (automatic/operator), and target bus. Supports NERC FAC-001 voltage profile compliance and reactive power management reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.voltage_control_action" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC FAC-001 / EMS Volt-VAR Control" ;
    cmm:sourceObject "energy_utilities_ecm.grid.voltage_control_action" ;
    owl:hasKey ( cmm:VoltageControlAction.voltageControlActionId ) .

cmm:VoltageControlAction.voltageControlActionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage control action id"@en ;
    rdfs:comment "Unique identifier for the voltage control action record."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "voltage_control_action_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Voltage Control Action ID" ;
    cmm:cimDatatype "Integer" .
cmm:VoltageControlAction.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Reference to the contingency analysis scenario that recommended or triggered this control action. Null for non-contingency-driven actions."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Scenario ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_contingency_id" ;
    cmm:cimAssociation "ActivityRecord.Contingency" .
cmm:VoltageControlAction.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the control area where the voltage control action was executed."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:VoltageControlAction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the system operator who initiated or approved the control action. Null for fully automatic actions. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:VoltageControlAction.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder affected by the voltage control action. Applicable for distribution-level voltage control actions."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_feeder_id" ;
    cmm:cimAssociation "ActivityRecord.Feeder" .
cmm:VoltageControlAction.primaryEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — Voltage control actions target a specific EMS bus (node) to maintain voltage within limits. The FK to ems_node identifies the target bus for the action."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "primary_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "ems_node_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_primary_ems_node_id" ;
    cmm:cimAssociation "ActivityRecord.TopologicalNode" .
cmm:VoltageControlAction.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Reference to the SCADA telemetry point associated with the controlled device."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_scada_point_id" ;
    cmm:cimAssociation "ActivityRecord.Measurement" .
cmm:VoltageControlAction.voltageEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "voltage ems node"@en ;
    rdfs:comment "Reference to the EMS node (bus) where the voltage control action was targeted."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "voltage_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Node ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_voltage_control_action_voltage_ems_node_id" ;
    cmm:cimAssociation "ActivityRecord.TopologicalNode" .
cmm:VoltageControlAction.actionDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action duration seconds"@en ;
    rdfs:comment "Time in seconds from action initiation to completion or stabilization. Includes device response time and system settling time."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "action_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:VoltageControlAction.actionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action status"@en ;
    rdfs:comment "Outcome status of the voltage control action. Successful indicates action completed and achieved desired voltage change, failed indicates action did not execute or had no effect, partial indicates action executed but did not fully achieve target, aborted indicates action was cancelled mid-execution, pending verification indicates action executed but effectiveness not yet confirmed."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Action Status" ;
    cmm:validValues "successful|failed|partial|aborted|pending_verification" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:VoltageControlAction.actionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action timestamp"@en ;
    rdfs:comment "Date and time when the voltage control action was executed in the field. This is the principal business event timestamp representing when the physical control action occurred."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "action_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VoltageControlAction.alarmTriggeredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm triggered flag"@en ;
    rdfs:comment "Indicates whether a voltage alarm was triggered that led to this control action. True if an alarm condition existed, False if action was preventive or scheduled."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "alarm_triggered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Triggered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltageControlAction.complianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance flag"@en ;
    rdfs:comment "Indicates whether this voltage control action was taken to maintain compliance with NERC FAC-001 voltage profile requirements or other regulatory standards. True if compliance-driven, False otherwise."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltageControlAction.controlActionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control action type"@en ;
    rdfs:comment "Type of voltage control action executed. Capacitor bank switching adds reactive power, reactor switching removes reactive power, transformer tap change adjusts voltage ratio, generator VAR dispatch adjusts generator reactive output, static VAR compensator provides dynamic reactive support, synchronous condenser provides rotating reactive reserve."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Control Action Type" ;
    cmm:validValues "capacitor_bank_switching|reactor_switching|transformer_tap_change|generator_var_dispatch|static_var_compensator|synchronous_condenser" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:VoltageControlAction.controlMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Operating mode under which the control action was executed. Automatic indicates system-initiated without operator intervention, manual indicates direct operator command, supervisory indicates operator-approved automatic action, emergency indicates action taken during system emergency, test indicates action performed during commissioning or testing."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Mode" ;
    cmm:validValues "automatic|manual|supervisory|emergency|test" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.controlledDeviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlled device name"@en ;
    rdfs:comment "Name or identifier of the physical device that was controlled (e.g., capacitor bank CB-123, transformer T-456, generator G-789)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlled_device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlled Device Name" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.controlledDeviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlled device type"@en ;
    rdfs:comment "Classification of the controlled device. Capacitor bank provides capacitive reactive power, shunt reactor provides inductive reactive power, load tap changer adjusts transformer voltage, generator provides dynamic VAR support, SVC and STATCOM provide fast dynamic reactive compensation, synchronous condenser provides rotating inertia and reactive support. Reference-value candidates: capacitor_bank|shunt_reactor|load_tap_changer|generator|svc|statcom|synchronous_condenser."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlled_device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlled Device Type" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this voltage control action record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:VoltageControlAction.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that originated this voltage control action record (e.g., GE ADMS, OSIsoft PI, SCADA RTU)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name or identifier of the EMS system that executed or recorded the voltage control action (e.g., GE ADMS, ABB Symphony Plus, Siemens Spectrum)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.initiatingCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating cause"@en ;
    rdfs:comment "Source or trigger that initiated the voltage control action. Automatic Volt-VAR optimization indicates EMS algorithm-driven action, automatic voltage regulator indicates local device control, operator manual indicates human-initiated action, state estimator recommendation indicates action based on network state analysis, contingency analysis recommendation indicates preventive action, scheduled maintenance indicates planned operational adjustment."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initiating Cause" ;
    cmm:validValues "automatic_volt_var_optimization|automatic_voltage_regulator|operator_manual|state_estimator_recommendation|contingency_analysis_recommendation|scheduled_maintenance" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this voltage control action record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:VoltageControlAction.mvarChange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mvar change"@en ;
    rdfs:comment "Change in reactive power in megavolt-amperes reactive resulting from the control action. Positive values indicate capacitive reactive power injection (voltage support), negative values indicate inductive reactive power absorption (voltage reduction)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mvar_change" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megavolt-Ampere Reactive (MVAR) Change" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltageControlAction.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity jurisdiction where the voltage control action occurred. WECC=Western Electricity Coordinating Council, ERCOT=Electric Reliability Council of Texas, MRO=Midwest Reliability Organization, NPCC=Northeast Power Coordinating Council, RF=ReliabilityFirst, SERC=SERC Reliability Corporation, SPP=Southwest Power Pool, TRE=Texas Reliability Entity. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|SPP|TRE."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operator comments, special conditions, or additional context about the voltage control action."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:VoltageControlAction.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name associated with this voltage control action for time-series data archival and retrieval."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.postActionVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post action voltage kv"@en ;
    rdfs:comment "Measured voltage in kilovolts at the target bus after the control action was executed and the system stabilized. Used to assess the effectiveness of the control action."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_action_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Action Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltageControlAction.powerFactorPostAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor post action"@en ;
    rdfs:comment "Power factor measured at the target bus after the control action and system stabilization. Used to assess improvement in reactive power balance."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_post_action" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor Post-Action" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltageControlAction.powerFactorPreAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor pre action"@en ;
    rdfs:comment "Power factor measured at the target bus before the control action. Range -1.0 to 1.0, where values closer to 1.0 indicate better reactive power balance. Negative values indicate leading power factor (capacitive), positive values indicate lagging power factor (inductive)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_pre_action" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor Pre-Action" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltageControlAction.preActionVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre action voltage kv"@en ;
    rdfs:comment "Measured voltage in kilovolts at the target bus immediately before the control action was executed. Used to assess the voltage deviation that triggered the action."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_action_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Action Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltageControlAction.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "Code identifying the RTO or ISO market operator responsible for the transmission system where the action occurred (e.g., CAISO, PJM, MISO, NYISO, ISO-NE, SPP)."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.substationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation name"@en ;
    rdfs:comment "Name of the substation where the controlled device is located."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substation Name" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.tapPositionChange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tap position change"@en ;
    rdfs:comment "Number of tap positions changed for transformer tap control actions. Positive values indicate raise operations, negative values indicate lower operations. Null for non-tap control actions."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "tap_position_change" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tap Position Change" ;
    cmm:cimDatatype "Integer" .
cmm:VoltageControlAction.targetBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target bus name"@en ;
    rdfs:comment "Name of the electrical bus where voltage control was targeted. This is the point in the network where voltage was being regulated."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "target_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Bus Name" ;
    cmm:cimDatatype "String" .
cmm:VoltageControlAction.targetBusVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target bus voltage kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts of the target bus where control action was applied."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_bus_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Bus Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltageControlAction.voltageDeviationPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage deviation percent"@en ;
    rdfs:comment "Percentage deviation of pre-action voltage from the nominal voltage setpoint. Calculated as ((pre_action_voltage - nominal_voltage) / nominal_voltage) * 100. Positive values indicate overvoltage, negative values indicate undervoltage."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_deviation_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Deviation Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:VoltageControlAction.voltageLimitHighKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage limit high kv"@en ;
    rdfs:comment "Upper voltage limit in kilovolts for the target bus as defined by operating procedures or NERC standards. Actions are triggered when voltage approaches or exceeds this limit."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_limit_high_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Limit High (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltageControlAction.voltageLimitLowKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage limit low kv"@en ;
    rdfs:comment "Lower voltage limit in kilovolts for the target bus as defined by operating procedures or NERC standards. Actions are triggered when voltage approaches or falls below this limit."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_limit_low_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Limit Low (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltageControlAction.voltageSetpointKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage setpoint kv"@en ;
    rdfs:comment "Target voltage setpoint in kilovolts that the control action was attempting to achieve or maintain at the target bus."@en ;
    rdfs:domain cmm:VoltageControlAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_setpoint_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Setpoint (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:FrequencyEvent a owl:Class ;
    rdfs:label "Frequency Event"@en ;
    rdfs:comment "Transactional record of a system frequency excursion event detected by the EMS. Captures event start timestamp, nadir frequency (Hz), recovery frequency (Hz), rate of change of frequency (ROCOF in Hz/s), duration (seconds), triggering cause (generation trip, load loss, islanding), under-frequency load shedding (UFLS) activation flag, MW of load shed, and restoration timestamp. SSOT for frequency disturbance events used in NERC BAL-003 frequency response obligation reporting and post-event analysis."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.frequency_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC BAL-003; NERC BAL-003 Frequency Response / IEEE 1159" ;
    cmm:sourceObject "energy_utilities_ecm.grid.frequency_event" ;
    owl:hasKey ( cmm:FrequencyEvent.frequencyEventId ) .

cmm:FrequencyEvent.frequencyEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency event id"@en ;
    rdfs:comment "Unique identifier for the frequency excursion event. Primary key for the frequency event record."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "frequency_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Frequency Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:FrequencyEvent.correctiveActionPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Identifier of the corrective action plan developed in response to this frequency event to prevent recurrence or mitigate future impacts."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Corrective Action Plan ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_corrective_action_plan_id" ;
    cmm:cimAssociation "PSREvent.Document" .
cmm:FrequencyEvent.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Frequency excursion events causing generation/transmission equipment damage trigger emergency stock deployment for restoration. Essential for tracking material response to interconnection-wide disturb"@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_emergency_stock_event_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:FrequencyEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Identifier of the EMS alarm that was triggered when the frequency event was detected. Links the event to the real-time alarm sequence."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Alarm ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_ems_alarm_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:FrequencyEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Large outages trigger frequency events (generation/load imbalance). Linking enables analysis of frequency response, UFLS activation, and NERC BAL-003 compliance for disturbance control standard."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:FrequencyEvent.frequencyControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "frequency control area"@en ;
    rdfs:comment "Identifier of the control area or balancing authority where the frequency event was detected."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "frequency_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:sourceColumn "control_area_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_frequency_control_area_id" ;
    cmm:cimAssociation "PSREvent.ControlArea" .
cmm:FrequencyEvent.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Identifier of the primary SCADA measurement point used to detect and monitor the frequency event, typically a system frequency measurement point."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_scada_point_id" ;
    cmm:cimAssociation "PSREvent.Measurement" .
cmm:FrequencyEvent.toControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Frequency events are detected within a specific control area's EMS. FK to control_area scopes the event for NERC BAL-003 frequency response obligation reporting."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "to_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_frequency_event_to_control_area_id" ;
    cmm:cimAssociation "PSREvent.ControlArea" .
cmm:FrequencyEvent.agcResponseEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc response enabled flag"@en ;
    rdfs:comment "Boolean flag indicating whether Automatic Generation Control (AGC) was active and responding during the frequency event to provide corrective generation adjustments."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_response_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Response Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FrequencyEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this frequency event record was first created in the data system."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PSREvent.createdDateTime .
cmm:FrequencyEvent.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that captured and recorded the frequency event data, typically the Energy Management System (EMS) or SCADA system."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.disturbanceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance mw"@en ;
    rdfs:comment "Magnitude of the generation or load disturbance in Megawatts (MW) that caused the frequency event. Represents the MW imbalance introduced into the system."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disturbance_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disturbance (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FrequencyEvent.eventDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event duration seconds"@en ;
    rdfs:comment "Total duration of the frequency excursion event measured in seconds, from initial detection to restoration or stabilization."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "event_duration_seconds" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:FrequencyEvent.eventEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event end timestamp"@en ;
    rdfs:comment "Timestamp when the frequency excursion event concluded and system frequency returned to acceptable operating range or stabilized."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FrequencyEvent.eventSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event severity"@en ;
    rdfs:comment "Severity classification of the frequency event based on magnitude of frequency deviation, duration, and system impact. Used for prioritization and post-event analysis."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Severity" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.eventStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event start timestamp"@en ;
    rdfs:comment "Timestamp when the frequency excursion event was first detected by the Energy Management System (EMS). Represents the moment system frequency deviated beyond normal operating thresholds."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FrequencyEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the frequency event based on the direction of frequency deviation: under-frequency (frequency drop), over-frequency (frequency rise), or frequency oscillation (sustained fluctuation)."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Type" ;
    cmm:validValues "under_frequency|over_frequency|frequency_oscillation" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.type .
cmm:FrequencyEvent.frequencyDeviationHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency deviation hz"@en ;
    rdfs:comment "Maximum deviation of system frequency from nominal frequency (typically 60 Hz in North America or 50 Hz elsewhere) during the event, measured in Hertz."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_deviation_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Deviation (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.frequencyResponseMwPerHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency response mw per hz"@en ;
    rdfs:comment "Measured frequency response of the balancing authority in Megawatts per Hertz (MW/Hz), calculated as the change in generation output divided by the change in frequency. Key metric for NERC BAL-003 compliance."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_response_mw_per_hz" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Response (MW/Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.generationResponseMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation response mw"@en ;
    rdfs:comment "Total generation response in Megawatts (MW) provided by generating units through governor action, Automatic Generation Control (AGC), or manual dispatch to arrest frequency deviation."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "generation_response_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Response (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FrequencyEvent.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "Name of the North American interconnection where the frequency event occurred: Eastern Interconnection, Western Interconnection, Texas (ERCOT) Interconnection, or Quebec Interconnection."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Name" ;
    cmm:validValues "eastern|western|texas|quebec" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this frequency event record was last modified or updated with additional information."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FrequencyEvent.loadShedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load shed mw"@en ;
    rdfs:comment "Total amount of load shed in Megawatts (MW) through UFLS or manual operator actions to restore frequency balance during the event."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_shed_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Shed (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FrequencyEvent.maxRocofHzPerSecond a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max rocof hz per second"@en ;
    rdfs:comment "Maximum rate of change of frequency observed during the event in Hertz per second (Hz/s). Peak ROCOF value used for worst-case analysis."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "max_rocof_hz_per_second" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Rate of Change of Frequency (ROCOF) (Hz/s)" ;
    cmm:cimDatatype "Decimal" .
cmm:FrequencyEvent.nadirFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nadir frequency hz"@en ;
    rdfs:comment "Lowest system frequency in Hertz (Hz) reached during the under-frequency event. Critical metric for assessing severity of frequency decline and system stability."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nadir_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nadir Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity with jurisdiction over the balancing authority where the event occurred (e.g., WECC, SERC, MRO, NPCC, RF, TRE)."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.operatorNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator notes"@en ;
    rdfs:comment "Free-text notes entered by system operators documenting observations, actions taken, and contextual information about the frequency event."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operator Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:FrequencyEvent.peakFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak frequency hz"@en ;
    rdfs:comment "Highest system frequency in Hertz (Hz) reached during an over-frequency event. Used for over-frequency disturbance analysis."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name for the frequency measurement time series data associated with this event. Used for detailed post-event analysis and trending."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.preEventFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre event frequency hz"@en ;
    rdfs:comment "System frequency in Hertz (Hz) immediately before the disturbance event occurred, representing baseline operating frequency."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_event_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Event Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.recoveryFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery frequency hz"@en ;
    rdfs:comment "System frequency in Hertz (Hz) at the point of stabilization or restoration after the disturbance, indicating the settling point after corrective actions."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recovery_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FrequencyEvent.reportableEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reportable event flag"@en ;
    rdfs:comment "Boolean flag indicating whether the frequency event meets NERC EOP-004 criteria for mandatory reporting to regulatory authorities and the Electricity Reliability Organization (ERO)."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reportable_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reportable Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FrequencyEvent.restorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration timestamp"@en ;
    rdfs:comment "Timestamp when system frequency was fully restored to normal operating range and all corrective actions were completed."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FrequencyEvent.rocofHzPerSecond a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rocof hz per second"@en ;
    rdfs:comment "Rate of Change of Frequency measured in Hertz per second (Hz/s). Indicates how rapidly system frequency is changing and is critical for assessing system inertia and disturbance severity."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rocof_hz_per_second" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate of Change of Frequency (ROCOF) (Hz/s)" ;
    cmm:cimDatatype "Decimal" .
cmm:FrequencyEvent.rootCauseAnalysisCompletedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause analysis completed flag"@en ;
    rdfs:comment "Boolean flag indicating whether a formal root cause analysis has been completed for this frequency event."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "root_cause_analysis_completed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Analysis Completed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FrequencyEvent.triggeringCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering cause"@en ;
    rdfs:comment "Root cause or initiating event that triggered the frequency excursion. Common causes include generation unit trip, sudden load loss, transmission fault, system islanding, or tie-line trip."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Cause" ;
    cmm:validValues "generation_trip|load_loss|transmission_fault|islanding|tie_line_trip|other" ;
    cmm:cimDatatype "String" .
cmm:FrequencyEvent.uflsActivatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ufls activated flag"@en ;
    rdfs:comment "Boolean flag indicating whether Under-Frequency Load Shedding (UFLS) schemes were activated during the event to arrest frequency decline and prevent system collapse."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ufls_activated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Under-Frequency Load Shedding (UFLS) Activated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FrequencyEvent.uflsStageActivated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ufls stage activated"@en ;
    rdfs:comment "Identifier of the UFLS stage or stages that were activated during the event (e.g., Stage 1, Stage 2). Multiple stages may be activated in severe events."@en ;
    rdfs:domain cmm:FrequencyEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "ufls_stage_activated" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Under-Frequency Load Shedding (UFLS) Stage Activated" ;
    cmm:cimDatatype "String" .

cmm:PmuMeasurement a owl:Class ;
    rdfs:label "Pmu Measurement"@en ;
    rdfs:comment "Time-series record of Phasor Measurement Unit (PMU) synchrophasor data ingested from the wide-area measurement system (WAMS) into the OSIsoft PI historian and Silver layer. Captures PMU device reference, UTC timestamp (microsecond precision), voltage phasor magnitude (kV) and angle (degrees), current phasor magnitude (amps) and angle, frequency (Hz), ROCOF (Hz/s), and PDC data quality flags. Supports wide-area situational awareness, oscillation detection, and NERC PRC-002 disturbance monitoring compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AnalogValue ;
    cmm:cimCloseMatch cim:AnalogValue ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.pmu_measurement" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEEE C37.118; IEEE C37.118 Synchrophasor / NERC PRC-002" ;
    cmm:sourceObject "energy_utilities_ecm.grid.pmu_measurement" ;
    owl:hasKey ( cmm:PmuMeasurement.pmuMeasurementId ) .

cmm:PmuMeasurement.pmuMeasurementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu measurement id"@en ;
    rdfs:comment "Unique identifier for the PMU synchrophasor measurement record. Primary key for the pmu_measurement product."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "pmu_measurement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Measurement ID" ;
    cmm:cimDatatype "Integer" .
cmm:PmuMeasurement.pmuDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pmu device"@en ;
    rdfs:comment "Reference to the PMU device that generated this measurement. Links to the physical PMU asset in the asset registry."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range cmm:PmuDevice ;
    cmm:physicalColumn "pmu_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_measurement_pmu_device_id" ;
    cmm:cimAssociation "AnalogValue.RemoteUnit" .
cmm:PmuMeasurement.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Reference to the SCADA point configuration associated with this PMU measurement stream. Links to the SCADA point registry for metadata and configuration."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_measurement_scada_point_id" ;
    cmm:cimAssociation "AnalogValue.Measurement" .
cmm:PmuMeasurement.wamsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "wams event"@en ;
    rdfs:comment "Reference to a WAMS disturbance or oscillation event that this measurement is associated with. Null for routine measurements outside of event windows."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "wams_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Wide-Area Measurement System (WAMS) Event ID" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_measurement_wams_event_id" ;
    cmm:cimAssociation "AnalogValue.Outage" .
cmm:PmuMeasurement.activePowerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active power mw"@en ;
    rdfs:comment "Real power flow in megawatts calculated from voltage and current phasors. Positive values indicate power flowing in the defined direction."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "active_power_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Power Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PmuMeasurement.apparentPowerMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apparent power mva"@en ;
    rdfs:comment "Apparent power in megavolt-amperes, the vector sum of active and reactive power. Represents total power flow magnitude."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "apparent_power_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apparent Power Megavolt-Amperes (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:PmuMeasurement.balancingAuthorityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority code"@en ;
    rdfs:comment "NERC-registered balancing authority code for the control area where this PMU is located. Used for jurisdictional reporting and inter-BA coordination."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority Code" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.currentAngleDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current angle degrees"@en ;
    rdfs:comment "Phase angle of the current phasor in degrees relative to the system reference. Used to calculate power flow and detect phase imbalances."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_angle_degrees" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phasor Angle Degrees" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:PmuMeasurement.currentMagnitudeAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current magnitude amps"@en ;
    rdfs:comment "Magnitude of the current phasor measured in amperes. Represents the RMS current flowing through the monitored circuit element."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_magnitude_amps" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phasor Magnitude Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:PmuMeasurement.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Quality indicator for the PMU measurement data. Good indicates valid GPS-synchronized data; questionable indicates potential issues; invalid indicates data should not be used for analysis."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "good|questionable|invalid|missing|estimated|test" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:PmuMeasurement.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that provided this PMU measurement data. Typically the PDC system name or OSIsoft PI interface identifier."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.equipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type"@en ;
    rdfs:comment "Type of electrical equipment being monitored by this PMU measurement. Determines the interpretation and application of the phasor data."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Type" ;
    cmm:validValues "bus|line|transformer|generator|load" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.frequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency hz"@en ;
    rdfs:comment "Measured system frequency in Hertz at the PMU location. Nominal frequency is 60 Hz in North America or 50 Hz in other regions. Frequency deviations indicate generation-load imbalances."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_hz" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Frequency Hertz (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:PmuMeasurement.ingestionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ingestion timestamp"@en ;
    rdfs:comment "Timestamp when this PMU measurement record was ingested into the Silver layer lakehouse. Used for data lineage and latency monitoring."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "ingestion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Ingestion Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:PmuMeasurement.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "North American interconnection where this PMU is located. The four major interconnections operate asynchronously from each other."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Name" ;
    cmm:validValues "eastern|western|texas|quebec" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the PMU device location in decimal degrees. Used for geospatial visualization and propagation analysis."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:PmuMeasurement.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the PMU device location in decimal degrees. Used for geospatial visualization and propagation analysis."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:PmuMeasurement.measurementTimestampUtc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement timestamp utc"@en ;
    rdfs:comment "Precise UTC timestamp of the synchrophasor measurement with microsecond resolution. GPS-synchronized time reference for wide-area situational awareness and event correlation."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "measurement_timestamp_utc" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Timestamp Universal Coordinated Time (UTC)" ;
    cmm:cimDatatype "DateTime" .
cmm:PmuMeasurement.negativeSequenceVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "negative sequence voltage kv"@en ;
    rdfs:comment "Negative sequence component of the three-phase voltage in kilovolts. Indicates voltage imbalance and potential phase faults."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "negative_sequence_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Negative Sequence Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:PmuMeasurement.nercPrc002Registered a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc prc 002 registered"@en ;
    rdfs:comment "Indicates whether this PMU measurement point is registered for NERC PRC-002 disturbance monitoring compliance. Registered points must retain data for reportable disturbances."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_prc_002_registered" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Protection and Control (PRC) 002 Registered" ;
    cmm:cimDatatype "Boolean" .
cmm:PmuMeasurement.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, data quality annotations, or event context related to this PMU measurement record."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:PmuMeasurement.oscillationDampingRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oscillation damping ratio"@en ;
    rdfs:comment "Damping ratio of the detected oscillation mode. Values below 0.03 indicate poorly damped oscillations requiring operator attention. Null if no oscillation detected."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "oscillation_damping_ratio" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Oscillation Damping Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:PmuMeasurement.oscillationDetectedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oscillation detected flag"@en ;
    rdfs:comment "Indicates whether an inter-area or local oscillation was detected in this measurement window by the WAMS analytics engine. Used for modal analysis and stability assessment."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "oscillation_detected_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Oscillation Detected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PmuMeasurement.oscillationFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oscillation frequency hz"@en ;
    rdfs:comment "Dominant oscillation frequency detected in Hertz. Typical inter-area oscillations range from 0.1 to 1.0 Hz. Null if no oscillation detected."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "oscillation_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Oscillation Frequency Hertz (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:PmuMeasurement.pdcReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pdc reference"@en ;
    rdfs:comment "Reference to the PDC that aggregated and forwarded this PMU measurement. PDCs collect synchrophasor data from multiple PMUs for wide-area monitoring."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "pdc_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Data Concentrator (PDC) ID" ;
    cmm:cimDatatype "Integer" .
cmm:PmuMeasurement.piArchiveEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi archive enabled"@en ;
    rdfs:comment "Indicates whether this PMU measurement stream is actively archived in the OSIsoft PI historian for long-term storage and analysis."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pi_archive_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Archive Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:PmuMeasurement.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name where this PMU measurement stream is archived. Enables correlation with other SCADA and operational data in the PI system."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.pmuConfigurationVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu configuration version"@en ;
    rdfs:comment "Version identifier of the PMU configuration frame active when this measurement was captured. Used to track configuration changes over time."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_configuration_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Configuration Version" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.pmuSyncStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu sync status"@en ;
    rdfs:comment "Overall synchronization status of the PMU device. Synchronized indicates the PMU is GPS-locked and producing valid time-aligned measurements."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_sync_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Synchronization Status" ;
    cmm:validValues "synchronized|unsynchronized|error" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.positiveSequenceVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "positive sequence voltage kv"@en ;
    rdfs:comment "Positive sequence component of the three-phase voltage in kilovolts. Represents the balanced component of the voltage phasor."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "positive_sequence_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Positive Sequence Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:PmuMeasurement.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "Ratio of active power to apparent power, ranging from -1.0 to 1.0. Indicates the efficiency of power transmission and the phase relationship between voltage and current."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:PmuMeasurement.reactivePowerMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power mvar"@en ;
    rdfs:comment "Reactive power flow in megavolt-amperes reactive calculated from voltage and current phasors. Used for voltage control and power factor management."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power Megavolt-Amperes Reactive (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:PmuMeasurement.recordVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record version"@en ;
    rdfs:comment "Version number of this measurement record. Incremented if the record is corrected or reprocessed. Initial version is 1."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "record_version" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Version" ;
    cmm:cimDatatype "Integer" .
cmm:PmuMeasurement.reportingRateFps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting rate fps"@en ;
    rdfs:comment "PMU reporting rate in frames per second. Common rates are 30, 60, or 120 FPS. Higher rates provide better temporal resolution for transient event analysis."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "reporting_rate_fps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Rate Frames Per Second (FPS)" ;
    cmm:cimDatatype "Integer" .
cmm:PmuMeasurement.rocofHzPerSecond a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rocof hz per second"@en ;
    rdfs:comment "Rate of change of frequency measured in Hz per second. High ROCOF values indicate rapid frequency excursions and potential grid instability events requiring immediate response."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rocof_hz_per_second" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate of Change of Frequency (ROCOF) Hertz per Second (Hz/s)" ;
    cmm:cimDatatype "Decimal" .
cmm:PmuMeasurement.substationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation name"@en ;
    rdfs:comment "Name of the substation where the PMU device is installed. Provides geographic and operational context for the measurement."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substation Name" ;
    cmm:cimDatatype "String" .
cmm:PmuMeasurement.timeQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time quality flag"@en ;
    rdfs:comment "GPS time synchronization status. Locked indicates accurate GPS time; unlocked indicates loss of GPS signal; holdover indicates operating on internal clock."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "time_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time Quality Flag" ;
    cmm:validValues "locked|unlocked|holdover|degraded" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:PmuMeasurement.totalHarmonicDistortionCurrentPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total harmonic distortion current percent"@en ;
    rdfs:comment "Total harmonic distortion of the current waveform expressed as a percentage. Indicates non-linear load effects and power quality issues."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_harmonic_distortion_current_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Harmonic Distortion (THD) Current Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PmuMeasurement.totalHarmonicDistortionVoltagePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total harmonic distortion voltage percent"@en ;
    rdfs:comment "Total harmonic distortion of the voltage waveform expressed as a percentage. Measures power quality and the presence of harmonic frequencies."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_harmonic_distortion_voltage_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Harmonic Distortion (THD) Voltage Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PmuMeasurement.voltageAngleDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage angle degrees"@en ;
    rdfs:comment "Phase angle of the voltage phasor in degrees relative to the system reference. Critical for detecting angular separation and stability issues across the wide-area grid."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_angle_degrees" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phasor Angle Degrees" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:PmuMeasurement.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level of the bus or circuit where the PMU is measuring. Common transmission levels include 115, 230, 345, 500, and 765 kV."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:PmuMeasurement.voltageMagnitudeKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage magnitude kv"@en ;
    rdfs:comment "Magnitude of the voltage phasor measured in kilovolts. Represents the RMS voltage at the PMU measurement point."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_magnitude_kv" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phasor Magnitude Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:PmuMeasurement.zeroSequenceVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zero sequence voltage kv"@en ;
    rdfs:comment "Zero sequence component of the three-phase voltage in kilovolts. Indicates ground faults and neutral voltage displacement."@en ;
    rdfs:domain cmm:PmuMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "zero_sequence_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Zero Sequence Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:PmuDevice a owl:Class ;
    rdfs:label "Pmu Device"@en ;
    rdfs:comment "Master record for each Phasor Measurement Unit (PMU) deployed in the wide-area measurement system (WAMS). Captures PMU device name, manufacturer, model, firmware version, GPS synchronization source, reporting rate (frames/second), installed substation reference, monitored bus/line, PDC (Phasor Data Concentrator) assignment, commissioning date, and NERC PRC-002 registration status. SSOT for PMU device inventory used in WAMS configuration and synchrophasor data quality management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:RemoteUnit ;
    cmm:cimCloseMatch cim:RemoteUnit ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::SCADA" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.pmu_device" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEEE C37.118; IEEE C37.118 PMU / NERC PRC-002" ;
    cmm:sourceObject "energy_utilities_ecm.grid.pmu_device" ;
    owl:hasKey ( cmm:PmuDevice.pmuDeviceId ) .

cmm:PmuDevice.pmuDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu device id"@en ;
    rdfs:comment "Unique identifier for the Phasor Measurement Unit device. Primary key for the PMU device master record."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:long ;
    cmm:physicalColumn "pmu_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:PmuDevice.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the balancing authority or control area responsible for the grid region where this PMU is deployed."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_device_control_area_id" ;
    cmm:cimAssociation "RemoteUnit.ControlArea" .
cmm:PmuDevice.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the PMU device is physically installed and commissioned."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_device_distribution_substation_id" ;
    cmm:cimAssociation "RemoteUnit.Substation" .
cmm:PmuDevice.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — PMU devices monitor specific buses/lines in the EMS network model. FK to ems_node identifies which network element the PMU is measuring — required for WAMS data integration with state estimation."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_device_ems_node_id" ;
    cmm:cimAssociation "RemoteUnit.TopologicalNode" .
cmm:PmuDevice.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: PMUs at control centers and critical substations are BES Cyber Assets under NERC CIP-002. Each PMU must be categorized and tracked in the CIP asset inventory for CIP-007 and CIP-010 compliance (system"@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_device_nerc_cip_asset_id" ;
    cmm:cimAssociation "RemoteUnit.Asset" .
cmm:PmuDevice.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: PMU devices are capital assets requiring maintenance, calibration, warranty tracking, depreciation accounting, and spare parts inventory management. Asset management systems need direct linkage to tra"@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_pmu_device_registry_id" ;
    cmm:cimAssociation "RemoteUnit.Asset" .
cmm:PmuDevice.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the PMU device was commissioned and began operational data reporting in the WAMS network."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "PMU Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:PmuDevice.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "Network protocol used by the PMU to transmit synchrophasor data to the PDC (IEEE C37.118, IEC 61850-90-5, DNP3, or Modbus TCP)."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:validValues "ieee_c37_118|iec_61850_90_5|dnp3|modbus_tcp" ;
    cmm:cimDatatype "String" .
cmm:PmuDevice.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this PMU device record was first created in the system."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:RemoteUnit.createdDateTime .
cmm:PmuDevice.criticalInfrastructureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical infrastructure flag"@en ;
    rdfs:comment "Indicates whether this PMU device is designated as critical infrastructure requiring enhanced cybersecurity and physical security controls per NERC CIP standards."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_infrastructure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Infrastructure Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PmuDevice.dataLatencyMs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data latency ms"@en ;
    rdfs:comment "Typical end-to-end latency in milliseconds from PMU measurement to PDC receipt, critical for real-time wide-area monitoring applications."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "data_latency_ms" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Latency (Milliseconds)" ;
    cmm:unitSymbol "s" ;
    cmm:unitMultiplier "m" ;
    cmm:cimDatatype "Seconds" .
cmm:PmuDevice.dataQualityThresholdPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality threshold pct"@en ;
    rdfs:comment "Minimum acceptable data quality percentage for this PMU device, below which alarms are triggered for investigation."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_threshold_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Threshold Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PmuDevice.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or application from which this PMU device master data originated (e.g., WAMS configuration system, asset registry, EMS)."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:PmuDevice.deviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device name"@en ;
    rdfs:comment "Human-readable name or label assigned to the PMU device for operational identification and reference in WAMS configuration."@en ;
    rdfs:domain cmm:PmuDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "PMU Device Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
