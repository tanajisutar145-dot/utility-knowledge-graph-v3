cmm:DrugAlcoholTest a owl:Class ;
    rdfs:label "Drug Alcohol Test"@en ;
    rdfs:comment "DOT and utility-mandated drug and alcohol testing records for safety-sensitive utility positions including CDL drivers, generation plant operators, and transmission/distribution field crews. Captures test type (pre-employment, random, post-accident, reasonable suspicion, return-to-duty), test date, employee, testing provider, result (negative/positive/refused), and follow-up action required. Supports DOT 49 CFR Part 40 compliance and OSHA post-accident investigation requirements."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.drug_alcohol_test" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "DOT 49 CFR Part 40; DOT 49 CFR Part 40; OSHA 1910.120" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.drug_alcohol_test" ;
    owl:hasKey ( cmm:DrugAlcoholTest.drugAlcoholTestId ) .

cmm:DrugAlcoholTest.drugAlcoholTestId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drug alcohol test id"@en ;
    rdfs:comment "Unique identifier for the drug and alcohol test record. Primary key for the drug_alcohol_test product."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:long ;
    cmm:physicalColumn "drug_alcohol_test_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Drug and Alcohol Test ID" ;
    cmm:cimDatatype "Integer" .
cmm:DrugAlcoholTest.primaryDrugEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary drug employee"@en ;
    rdfs:comment "Identifier of the employee who underwent the drug and alcohol test. Links to the employee master record in the workforce domain."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_drug_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_drug_alcohol_test_primary_drug_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:DrugAlcoholTest.safetyIncident a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident"@en ;
    rdfs:comment "Identifier of the workplace accident or incident that triggered a post-accident drug and alcohol test. Links to incident or safety event records for OSHA investigation requirements."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range cmm:SafetyIncident ;
    cmm:physicalColumn "safety_incident_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Post-Accident Incident ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_drug_alcohol_test_safety_incident_id" ;
    cmm:cimAssociation "ActivityRecord.Incident" .
cmm:DrugAlcoholTest.alcoholConcentration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alcohol concentration"@en ;
    rdfs:comment "Measured blood alcohol concentration (BAC) level from breath or blood test, expressed as a decimal (e.g., 0.040 for 0.04%). DOT prohibits safety-sensitive work at 0.04% or higher."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "alcohol_concentration" ;
    cmm:sqlDataType "DECIMAL(5,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alcohol Concentration" ;
    cmm:cimDatatype "Decimal" .
cmm:DrugAlcoholTest.alcoholTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alcohol test result"@en ;
    rdfs:comment "Specific result of the alcohol screening component. Separate from drug result when both are tested."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "alcohol_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alcohol Test Result" ;
    cmm:validValues "negative|positive|refused|invalid|cancelled|not tested" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.cdlDriverTest a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cdl driver test"@en ;
    rdfs:comment "Indicates whether this test was administered to an employee holding a Commercial Driver License under FMCSA regulations."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cdl_driver_test" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Driver License (CDL) Driver Test" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.chainOfCustodyMaintained a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "chain of custody maintained"@en ;
    rdfs:comment "Indicates whether proper chain of custody procedures were followed from specimen collection through laboratory analysis. Required for test validity and legal defensibility."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "chain_of_custody_maintained" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Chain of Custody Maintained" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.collectionSiteAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection site address"@en ;
    rdfs:comment "Physical address of the collection site where the test specimen was obtained. Organizational contact data classified as confidential."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "collection_site_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Site Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.collectionSiteName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection site name"@en ;
    rdfs:comment "Name of the facility or location where the specimen was collected (e.g., clinic name, mobile collection unit, on-site medical facility)."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "collection_site_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Site Name" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.collectorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collector name"@en ;
    rdfs:comment "Name of the certified specimen collector who performed the collection. Required for chain of custody documentation."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "collector_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collector Name" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.confirmationTestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confirmation test date"@en ;
    rdfs:comment "Date the confirmation test was performed following an initial positive screening result."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "confirmation_test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confirmation Test Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.confirmationTestRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confirmation test required"@en ;
    rdfs:comment "Indicates whether a confirmation test is required following an initial positive screening result. DOT requires confirmation testing using gas chromatography/mass spectrometry (GC/MS) or equivalent."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "confirmation_test_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confirmation Test Required" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.confirmationTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confirmation test result"@en ;
    rdfs:comment "Result of the confirmation test. Confirmed positive verifies the initial positive screening; negative overturns the initial positive; cancelled indicates the confirmation test could not be completed."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "confirmation_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confirmation Test Result" ;
    cmm:validValues "confirmed positive|negative|cancelled" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.costCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Cost center code to which the drug and alcohol testing costs are allocated. Used for financial tracking and departmental budgeting."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this drug and alcohol test record was first created in the system. Audit trail for record creation."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:DrugAlcoholTest.disciplinaryActionTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disciplinary action taken"@en ;
    rdfs:comment "Description of disciplinary action taken as a result of the test (e.g., suspension, termination, written warning, mandatory treatment). May reference collective bargaining agreement provisions."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "disciplinary_action_taken" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disciplinary Action Taken" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.dotRegulatedTest a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dot regulated test"@en ;
    rdfs:comment "Indicates whether this test is subject to DOT 49 CFR Part 40 regulations. True for safety-sensitive positions including CDL drivers, pipeline operators, and certain generation plant operators."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dot_regulated_test" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Transportation (DOT) Regulated Test" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.drugTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drug test result"@en ;
    rdfs:comment "Specific result of the drug screening component. Separate from alcohol result when both are tested. Reference-value candidates: negative|positive|refused|adulterated|substituted|invalid|cancelled|not."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "drug_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Drug Test Result" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.employeeNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee notification date"@en ;
    rdfs:comment "Date the employee was notified of the test result. Required for due process and to initiate any appeal or follow-up action timelines."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "employee_notification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Employee Notification Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.followUpActionRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "follow up action required"@en ;
    rdfs:comment "Indicates whether follow-up action is required based on the test result. True for positive results requiring substance abuse professional evaluation, return-to-duty testing, or disciplinary action."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "follow_up_action_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Follow-Up Action Required" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.followUpActionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "follow up action type"@en ;
    rdfs:comment "Type of follow-up action required. May include referral to substance abuse professional (SAP), return-to-duty testing, follow-up testing plan, disciplinary action, or termination. Comma-separated list if multiple actions apply."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "follow_up_action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Follow-Up Action Type" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this drug and alcohol test record was last updated. Audit trail for record changes."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DrugAlcoholTest.legitimateMedicalExplanation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "legitimate medical explanation"@en ;
    rdfs:comment "Indicates whether the MRO determined there was a legitimate medical explanation for a positive test result (e.g., valid prescription for detected substance). If true, the MRO may verify the result as negative."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "legitimate_medical_explanation" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Legitimate Medical Explanation" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or name of the person who last modified this drug and alcohol test record. Audit trail for accountability."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.mroName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mro name"@en ;
    rdfs:comment "Name of the licensed physician serving as Medical Review Officer who reviewed and verified the test result. Required for DOT-mandated testing."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "mro_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Review Officer (MRO) Name" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.mroReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mro review date"@en ;
    rdfs:comment "Date the Medical Review Officer completed review and verification of the test result."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "mro_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Review Officer (MRO) Review Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.mroReviewRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mro review required"@en ;
    rdfs:comment "Indicates whether Medical Review Officer review is required. DOT requires MRO review of all positive, adulterated, substituted, and invalid drug test results."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mro_review_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Review Officer (MRO) Review Required" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.mroVerifiedResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mro verified result"@en ;
    rdfs:comment "Final result verified by the Medical Review Officer after reviewing laboratory results and interviewing the employee. This is the official reportable result."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "mro_verified_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Review Officer (MRO) Verified Result" ;
    cmm:validValues "negative|positive|test cancelled|refusal to test" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional notes or comments regarding the drug and alcohol test, including special circumstances, procedural issues, or follow-up actions. Free-text field for case documentation."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DrugAlcoholTest.postAccidentIncidentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post accident incident date"@en ;
    rdfs:comment "Date of the workplace accident or incident that triggered the post-accident test. DOT requires testing within specified timeframes after qualifying accidents."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "post_accident_incident_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Accident Incident Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.reasonableSuspicionBasis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reasonable suspicion basis"@en ;
    rdfs:comment "Description of the observed behavior or circumstances that provided reasonable suspicion for ordering a drug or alcohol test. Must be documented by a trained supervisor."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "reasonable_suspicion_basis" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reasonable Suspicion Basis" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.refusalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refusal reason"@en ;
    rdfs:comment "Reason for test refusal if result is 'refused'. May include failure to appear, failure to provide adequate specimen, adulterating or substituting specimen, failure to cooperate with collection process, or leaving collection site before process is complete."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "refusal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refusal Reason" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.resultReportedToEmployerDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "result reported to employer date"@en ;
    rdfs:comment "Date the verified test result was officially reported to the employer by the MRO or testing provider. DOT requires timely reporting of verified results."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "result_reported_to_employer_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Result Reported to Employer Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.returnToDutyClearanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return to duty clearance date"@en ;
    rdfs:comment "Date the employee received clearance to return to safety-sensitive duties following completion of SAP-recommended treatment and passing a return-to-duty test."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "return_to_duty_clearance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return-to-Duty Clearance Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.safetySensitivePosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety sensitive position"@en ;
    rdfs:comment "Indicates whether the employee holds a safety-sensitive position requiring drug and alcohol testing under DOT or utility company policy. Includes transmission/distribution field crews, generation plant operators, and CDL drivers."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_sensitive_position" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety-Sensitive Position" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.sapName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap name"@en ;
    rdfs:comment "Name of the Substance Abuse Professional (licensed physician, social worker, psychologist, or certified counselor) who evaluated the employee and recommended treatment."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "sap_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substance Abuse Professional (SAP) Name" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.sapReferralDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap referral date"@en ;
    rdfs:comment "Date the employee was referred to a Substance Abuse Professional following a positive test result. DOT requires SAP evaluation before return-to-duty."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "sap_referral_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substance Abuse Professional (SAP) Referral Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.specimenCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "specimen code"@en ;
    rdfs:comment "Unique identifier assigned to the specimen for chain of custody tracking. Typically a barcode or serial number on the collection container."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "specimen_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Specimen ID" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.specimenType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "specimen type"@en ;
    rdfs:comment "Type of biological specimen collected for testing. Urine is standard for drug tests; breath is standard for alcohol tests; blood, saliva, and hair may be used in specific circumstances."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "specimen_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Specimen Type" ;
    cmm:validValues "urine|breath|blood|saliva|hair" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.splitSpecimenRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "split specimen requested"@en ;
    rdfs:comment "Indicates whether the employee requested analysis of the split specimen following a positive result. DOT requires split specimen testing option for all positive drug tests."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "split_specimen_requested" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Split Specimen Requested" ;
    cmm:cimDatatype "Boolean" .
cmm:DrugAlcoholTest.splitSpecimenResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "split specimen result"@en ;
    rdfs:comment "Result of the split specimen analysis if requested by the employee. Used to verify or refute the original positive result."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "split_specimen_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Split Specimen Result" ;
    cmm:validValues "confirmed positive|negative|test cancelled|not requested" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.substancesDetected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substances detected"@en ;
    rdfs:comment "List of specific controlled substances or drug metabolites detected in a positive drug test (e.g., marijuana metabolites, cocaine metabolites, opiates, amphetamines, PCP). Comma-separated list."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "substances_detected" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substances Detected" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.testCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test category"@en ;
    rdfs:comment "Category of substance tested: drug only, alcohol only, or combined drug and alcohol test."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Category" ;
    cmm:validValues "drug|alcohol|drug and alcohol" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.kind .
cmm:DrugAlcoholTest.testCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test cost amount"@en ;
    rdfs:comment "Total cost of the drug and alcohol test including collection, laboratory analysis, MRO review, and administrative fees. Used for cost tracking and vendor invoice reconciliation."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "test_cost_amount" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrugAlcoholTest.testDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test date"@en ;
    rdfs:comment "Date the drug and alcohol test was administered. Principal business event date for the test record."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Date" ;
    cmm:cimDatatype "Date" .
cmm:DrugAlcoholTest.testNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test number"@en ;
    rdfs:comment "Externally-known unique test number or specimen identifier assigned by the testing provider or internal tracking system. Used for chain of custody and audit trail."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrugAlcoholTest.testResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test result"@en ;
    rdfs:comment "Overall result of the drug and alcohol test. Negative indicates no prohibited substances detected; positive indicates presence of prohibited substances above cutoff levels; refused indicates employee refusal to test; adulterated/substituted indicate specimen tampering; invalid indicates specimen cannot be tested; cancelled indicates test was administratively cancelled. Reference-value candidates: negative|positive|refused|adulterated|substituted|invalid|cancelled."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Result" ;
    cmm:cimDatatype "String" .
cmm:DrugAlcoholTest.testStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test status"@en ;
    rdfs:comment "Current status of the drug and alcohol test in its lifecycle workflow. Tracks progression from scheduling through final result verification. Reference-value candidates: scheduled|specimen."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:DrugAlcoholTest.testTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test timestamp"@en ;
    rdfs:comment "Precise date and time the specimen was collected or the test was administered. Used for chain of custody and compliance reporting."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "test_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrugAlcoholTest.testType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test type"@en ;
    rdfs:comment "Type of drug and alcohol test administered. Pre-employment tests are conducted before hire; random tests are unannounced selections from the covered employee pool; post-accident tests follow qualifying incidents; reasonable suspicion tests are based on observed behavior; return-to-duty tests are required before an employee returns after a positive test; follow-up tests are unannounced tests after return-to-duty."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Type" ;
    cmm:validValues "pre-employment|random|post-accident|reasonable suspicion|return-to-duty|follow-up" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:DrugAlcoholTest.testingProviderCertificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "testing provider certification number"@en ;
    rdfs:comment "Certification or accreditation number of the testing laboratory (e.g., SAMHSA certification number for drug testing labs). Required for DOT compliance."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "testing_provider_certification_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Testing Provider Certification Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrugAlcoholTest.testingProviderName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "testing provider name"@en ;
    rdfs:comment "Name of the laboratory or testing provider that analyzed the specimen and reported results. Must be a DOT-certified laboratory for DOT-mandated tests."@en ;
    rdfs:domain cmm:DrugAlcoholTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "testing_provider_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Testing Provider Name" ;
    cmm:cimDatatype "String" .

cmm:EmployeeQualification a owl:Class ;
    rdfs:label "Employee Qualification"@en ;
    rdfs:comment "Records of employee technical qualifications, trade apprenticeship completions, and utility-specific competency assessments beyond formal certifications — including journeyman lineman qualification, substation operator qualification, generation unit operator qualification, and SCADA operator authorization. Captures qualification type, assessment date, assessor, competency level achieved, and expiration if applicable. Distinct from certifications (which are externally issued); qualifications are internally assessed and awarded."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpCompetency ;
    cmm:cimCloseMatch cim:ErpCompetency ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.employee_qualification" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; IBEW Apprenticeship Standards; NERC CIP-004 Training" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.employee_qualification" ;
    owl:hasKey ( cmm:EmployeeQualification.employeeQualificationId ) .

cmm:EmployeeQualification.employeeQualificationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee qualification id"@en ;
    rdfs:comment "Unique identifier for the employee qualification record. Primary key for the employee qualification entity."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:long ;
    cmm:physicalColumn "employee_qualification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Employee Qualification Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeQualification.primaryEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary employee"@en ;
    rdfs:comment "Reference to the employee who holds this qualification. Links to the employee master record in the workforce domain."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_employee_qualification_primary_employee_id" ;
    cmm:cimAssociation "ErpCompetency.ErpPersonnel" .
cmm:EmployeeQualification.apprenticeshipCompletionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apprenticeship completion flag"@en ;
    rdfs:comment "Indicates whether this qualification represents the successful completion of a formal trade apprenticeship program. True for journeyman-level qualifications achieved through multi-year apprenticeship programs."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "apprenticeship_completion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apprenticeship Completion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeQualification.apprenticeshipHoursCompleted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apprenticeship hours completed"@en ;
    rdfs:comment "Total on-the-job training hours completed as part of the apprenticeship program leading to this qualification. Typically 8,000+ hours for journeyman lineman programs."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:int ;
    cmm:physicalColumn "apprenticeship_hours_completed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apprenticeship Hours Completed" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeQualification.apprenticeshipProgramName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apprenticeship program name"@en ;
    rdfs:comment "Name of the registered apprenticeship program completed, if applicable. Examples include IBEW/NECA Joint Apprenticeship Training Committee (JATC) programs or utility-sponsored apprenticeships."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "apprenticeship_program_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apprenticeship Program Name" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.approvalAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval authority"@en ;
    rdfs:comment "Title or role of the individual or committee with authority to approve and award this qualification. Examples include Director of Operations, Chief Engineer, or Safety and Training Committee."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Authority" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the qualification award was formally approved by the designated authority. May differ from assessment date if management review or committee approval is required."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeQualification.assessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment date"@en ;
    rdfs:comment "Date on which the employee successfully completed the qualification assessment and was awarded the qualification. Serves as the baseline for expiration tracking and renewal scheduling."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeQualification.assessmentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment method"@en ;
    rdfs:comment "Method used to evaluate the employee's competency for this qualification. May include written examinations, practical demonstrations, field evaluations under supervision, simulator assessments, or oral board reviews. Reference-value candidates: written_exam|practical_demonstration|field_evaluation|simulation|oral_board|portfolio_review|combination."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Method" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.assessmentScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment score"@en ;
    rdfs:comment "Numeric score achieved by the employee on the qualification assessment, typically expressed as a percentage or points out of maximum. Used for performance tracking and identifying candidates for advanced qualifications."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "assessment_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Score" ;
    cmm:cimDatatype "Decimal" .
cmm:EmployeeQualification.assessorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessor name"@en ;
    rdfs:comment "Full name of the individual who conducted the qualification assessment. Captured for audit trail and quality assurance purposes."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessor Name" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.competencyLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "competency level"@en ;
    rdfs:comment "Proficiency level achieved by the employee for this qualification, ranging from entry-level to master craftsman. Used for crew assignment, work complexity authorization, and career progression tracking."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "competency_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Competency Level" ;
    cmm:validValues "entry|intermediate|advanced|expert|master" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.continuingEducationRequiredHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "continuing education required hours"@en ;
    rdfs:comment "Number of continuing education or refresher training hours required per renewal cycle to maintain this qualification. Used for training planning and compliance tracking."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "continuing_education_required_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Continuing Education Required Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:EmployeeQualification.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this qualification record was first created in the data platform. Part of standard audit trail for data governance and lineage tracking."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpCompetency.createdDateTime .
cmm:EmployeeQualification.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date from which the qualification becomes valid and the employee is authorized to perform associated work activities. May differ from assessment date if approval or administrative processing is required."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:EmployeeQualification.equipmentTypeAuthorization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type authorization"@en ;
    rdfs:comment "Specific equipment types or asset classes the employee is qualified to operate, maintain, or repair. Examples include circuit breakers, transformers, turbines, generators, protective relays, or Advanced Metering Infrastructure (AMI) systems."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type_authorization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Type Authorization" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date on which the qualification expires and renewal or reassessment is required. Nullable for qualifications that do not have a defined expiration period. Critical for compliance tracking and crew readiness reporting."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:EmployeeQualification.issuingOrganization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing organization"@en ;
    rdfs:comment "Name of the internal department, training center, or organizational unit that awarded this qualification. Examples include Transmission Operations Training Center, Distribution Services Academy, or Generation Training Department."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_organization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Organization" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this qualification record. Used for change tracking, incremental processing, and data quality monitoring."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmployeeQualification.lastRenewalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last renewal date"@en ;
    rdfs:comment "Date of the most recent renewal or reassessment for this qualification. Used to calculate next renewal due date and track compliance history."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_renewal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Renewal Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeQualification.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User identifier or system account that last modified this qualification record. Supports audit trail requirements and data stewardship accountability."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
