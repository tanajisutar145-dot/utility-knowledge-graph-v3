cmm:CorrectiveActionPlan a owl:Class ;
    rdfs:label "Corrective Action Plan"@en ;
    rdfs:comment "Formal corrective action plan (CAP) developed in response to an audit finding, enforcement action, or self-identified compliance gap. Captures the associated finding or violation, root cause analysis narrative, corrective measures committed, milestone schedule, responsible owner, implementation status, and evidence of completion. Used to demonstrate remediation to NERC, FERC, PUC, and EPA. Tracks open CAPs for Board compliance posture reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.corrective_action_plan" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC CMEP; NERC CMEP Mitigation Plan; FERC Compliance Plan" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.corrective_action_plan" ;
    owl:hasKey ( cmm:CorrectiveActionPlan.correctiveActionPlanId ) .

cmm:CorrectiveActionPlan.correctiveActionPlanId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan id"@en ;
    rdfs:comment "Unique identifier for the corrective action plan. Primary key."@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Corrective Action Plan (CAP) ID" ;
    cmm:cimDatatype "Integer" .
cmm:CorrectiveActionPlan.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "FK to compliance.audit_finding.audit_finding_id — Corrective action plans are created in response to audit findings. The CAP must reference the specific finding it remediates. This is the core remediation workflow link."@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_audit_finding_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CorrectiveActionPlan.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Some CAPs require capital investment (equipment replacement, system upgrades, facility modifications). Linking to capex_project enables tracking capital remediation costs, ensures proper capitalizatio"@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:CorrectiveActionPlan.correctiveAuditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective audit finding"@en ;
    rdfs:comment "Reference to the audit finding, enforcement action, or self-identified compliance gap that triggered this corrective action plan."@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "corrective_audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Finding ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_corrective_audit_finding_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CorrectiveActionPlan.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: CAPs require budget allocation for remediation work (labor, materials, contractors). Cost center link enables expense tracking, budget vs. actual variance analysis, and ensures remediation costs are p"@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CorrectiveActionPlan.responsibleDepartmentOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible department org unit"@en ;
    rdfs:comment "Foreign key linking to workforce.org_unit. Business justification: CAPs are assigned to organizational units for resource allocation and budget tracking. Replaces text field with FK to enable departmental compliance workload analysis and cost center allocation."@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "responsible_department_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Department Org Unit Id (Foreign Key)" ;
    cmm:sourceColumn "org_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_responsible_department_org_unit_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CorrectiveActionPlan.responsibleOwnerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible owner employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: CAPs require accountable employee ownership for remediation execution. Replaces text field with FK to enable escalation paths, workload balancing, and performance tracking for compliance remediation r"@en ;
    rdfs:domain cmm:CorrectiveActionPlan ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "responsible_owner_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Owner Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_corrective_action_plan_responsible_owner_employee_id" ;
