cmm:CapexExpenditure.paymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment date"@en ;
    rdfs:comment "The date on which payment was made to the vendor for this capital expenditure. Null if payment is still pending."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "The current payment status of this capital expenditure invoice. Indicates whether the vendor has been paid and tracks accounts payable aging."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Status" ;
    cmm:validValues "pending|paid|partially_paid|overdue|cancelled" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The accounting date on which this CAPEX expenditure transaction was posted to the general ledger. Determines the fiscal period for financial reporting."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.purchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order number"@en ;
    rdfs:comment "The purchase order number associated with this capital expenditure transaction. Links the expenditure to the procurement document."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Purchase Order (PO) Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexExpenditure.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Boolean indicator of whether this capital expenditure is eligible for inclusion in the Regulatory Asset Base (RAB) for rate-making purposes. True if eligible, False otherwise."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexExpenditure.rabInclusionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion date"@en ;
    rdfs:comment "The date on which this capital expenditure was included in the Regulatory Asset Base (RAB) for rate recovery. Used for Return on Equity (ROE) and Weighted Average Cost of Capital (WACC) calculations."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "rab_inclusion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.reversalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal date"@en ;
    rdfs:comment "The date on which this capital expenditure transaction was reversed or cancelled. Null if the transaction has not been reversed."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "reversal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Boolean indicator of whether this capital expenditure transaction has been reversed or cancelled. True if reversed, False otherwise."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexExpenditure.reversalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason"@en ;
    rdfs:comment "A textual explanation of why this capital expenditure transaction was reversed or cancelled. Used for audit trail and root cause analysis."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Reason" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.settlementRule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement rule"@en ;
    rdfs:comment "The settlement rule code that defines how this CAPEX expenditure is allocated or settled to one or more fixed assets. May specify percentage splits or allocation keys."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_rule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Rule" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.sourceDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source document reference"@en ;
    rdfs:comment "The unique document identifier in the source system (e.g., SAP document number) that originated this capital expenditure transaction. Used for traceability and reconciliation."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Document ID" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The name or code of the source operational system from which this capital expenditure record was extracted (e.g., SAP S/4HANA, Oracle ERP)."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "The total tax amount (sales tax, VAT, GST) included in this CAPEX expenditure. Used for tax reporting and recovery calculations."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexExpenditure.usefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "useful life years"@en ;
    rdfs:comment "The estimated useful life of the asset in years, used for calculating depreciation expense. Determined by asset class and regulatory guidelines."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:int ;
    cmm:physicalColumn "useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Useful Life (Years)" ;
