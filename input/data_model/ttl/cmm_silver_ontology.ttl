cmm:EmployeeQualification.passingScoreThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "passing score threshold"@en ;
    rdfs:comment "Minimum score required to successfully achieve the qualification. Captured at time of assessment to preserve historical standards for audit and trend analysis."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "passing_score_threshold" ;
