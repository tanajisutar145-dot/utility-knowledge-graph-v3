    cmm:businessTerm "Worker First Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_name" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.workerLastName a owl:DatatypeProperty , owl:FunctionalProperty ;
