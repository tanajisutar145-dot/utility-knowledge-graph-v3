cmm:FercMarketReport.transactionVolumeMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction volume mwh"@en ;
    rdfs:comment "Total energy volume transacted in the reported period, measured in megawatt-hours (MWh). Represents the quantity of electric energy bought or sold."@en ;
