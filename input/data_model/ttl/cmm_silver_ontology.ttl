    rdfs:comment "Regulatory requirement or mandate authorizing the assistance program (e.g., PUC decision number, state statute reference)."@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_mandate" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Mandate" ;
    cmm:cimDatatype "String" .
cmm:AssistanceProgram.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Program enrollments (now within assistance_program) are linked to a specific service agreement. Required for benefit application and eligibility tracking."@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .

cmm:BillingProgramEnrollment a owl:Class ;
    rdfs:label "Billing Program Enrollment"@en ;
    rdfs:comment "Transactional master entity representing a customer account enrollment in a utility billing program such as CARE, FERA, budget billing, auto-pay, paperless billing, or arrearage management. Captures enrollment date, program type, eligibility verification status, benefit amount, enrollment expiration date, re-certification due date, and disenrollment reason. Managed within Oracle CC&B and SAP IS-U. SSOT for all customer program participation records in the billing domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.billing_program_enrollment" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "Program Enrollment / Customer Program Participation" ;
    cmm:sourceObject "energy_utilities_ecm.billing.billing_program_enrollment" ;
    owl:hasKey ( cmm:BillingProgramEnrollment.billingProgramEnrollmentId ) .

cmm:BillingProgramEnrollment.billingProgramEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing program enrollment id"@en ;
    rdfs:comment "Unique identifier for the customer program enrollment record. Primary key for the program enrollment entity."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "billing_program_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Program Enrollment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:BillingProgramEnrollment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account enrolled in the program. Links to the customer account master entity."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:BillingProgramEnrollment.billingEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing employee"@en ;
    rdfs:comment "User identifier of the utility employee who approved the program enrollment application. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "billing_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_billing_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:BillingProgramEnrollment.billingLastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing last modified by user employee"@en ;
    rdfs:comment "User identifier of the person who last modified this program enrollment record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "billing_last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_billing_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:BillingProgramEnrollment.complianceProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance program"@en ;
    rdfs:comment "Foreign key linking to compliance.program. Business justification: Customer program enrollments (demand response, energy efficiency, low-income assistance) are tracked under compliance programs for regulatory reporting and program administration. Links enrollment to"@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "compliance_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Program Id (Foreign Key)" ;
    cmm:sourceColumn "program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_compliance_program_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:BillingProgramEnrollment.demandDrEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "demand dr enrollment"@en ;
    rdfs:comment "Foreign key linking to demand.dr_enrollment. Business justification: Generic program enrollment table tracks all utility program participation including DR alongside low-income assistance, budget billing, etc. Customer service, program administration, and unified custo"@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "demand_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_demand_dr_enrollment_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:BillingProgramEnrollment.greenTariffSubscription a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "green tariff subscription"@en ;
    rdfs:comment "Foreign key linking to renewable.green_tariff_subscription. Business justification: Green tariff subscriptions are a specific type of program enrollment where customers purchase renewable energy blocks or percentages. Direct relationship required for billing premium charges, allocati"@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:GreenTariffSubscription ;
    cmm:physicalColumn "green_tariff_subscription_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Green Tariff Subscription Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_green_tariff_subscription_id" ;
    cmm:cimAssociation "Agreement.CustomerAgreement" .
cmm:BillingProgramEnrollment.paymentArrangement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement"@en ;
    rdfs:comment "Reference to the associated payment arrangement for arrearage management program enrollments. Links to payment arrangement master entity."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:PaymentArrangement ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Arrangement Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_payment_arrangement_id" ;
    cmm:cimAssociation "Agreement.AuxiliaryAgreement" .
cmm:BillingProgramEnrollment.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise associated with this program enrollment. Links to the premise master entity."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_premise_id" ;
    cmm:cimAssociation "Agreement.ServiceLocation" .
cmm:BillingProgramEnrollment.renewableIncentiveProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable incentive program"@en ;
    rdfs:comment "Foreign key linking to renewable.incentive_program. Business justification: Customers enroll in renewable incentive programs through utility billing systems for solar rebates, green tariffs, and DER programs. Enrollment tracking links customer accounts to program eligibility,"@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:IncentiveProgram ;
    cmm:physicalColumn "renewable_incentive_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Incentive Program Id (Foreign Key)" ;
    cmm:sourceColumn "incentive_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_renewable_incentive_program_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:BillingProgramEnrollment.sgipEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sgip enrollment"@en ;
    rdfs:comment "Foreign key linking to interconnection.sgip_enrollment. Business justification: SGIP (Self-Generation Incentive Program) enrollment for battery storage requires coordinated enrollment in specific utility rate schedules (TOU rates for optimal dispatch). Business process: Program a"@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range cmm:SgipEnrollment ;
    cmm:physicalColumn "sgip_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Sgip Enrollment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_program_enrollment_sgip_enrollment_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:BillingProgramEnrollment.applicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application date"@en ;
    rdfs:comment "Date the customer submitted the program enrollment application. Used for tracking application processing time and eligibility determination."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "application_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the program enrollment application was approved by the utility. Used for processing time metrics and audit trail."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.autoRenewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto renew flag"@en ;
    rdfs:comment "Indicates whether the program enrollment automatically renews upon expiration (True) or requires manual re-enrollment (False). Used for enrollment lifecycle management."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_renew_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Renew Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingProgramEnrollment.benefitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "benefit amount"@en ;
    rdfs:comment "Monthly or per-billing-cycle discount or credit amount provided to the customer under this program enrollment. Used for rate calculation and revenue impact analysis. Expressed in local currency."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "benefit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Benefit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingProgramEnrollment.benefitPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "benefit percentage"@en ;
    rdfs:comment "Percentage discount applied to eligible charges under this program enrollment (e.g., 20% discount on energy charges for CARE customers). Used when benefit is calculated as a percentage rather than fixed amount."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "benefit_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Benefit Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:BillingProgramEnrollment.budgetBillingAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing amount"@en ;
    rdfs:comment "Fixed monthly payment amount for budget billing program enrollments. Calculated based on historical usage and periodically adjusted. Expressed in local currency."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "budget_billing_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingProgramEnrollment.budgetBillingReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing review date"@en ;
    rdfs:comment "Next scheduled date for budget billing amount review and adjustment. Typically occurs annually or semi-annually to true-up actual vs. budgeted usage."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "budget_billing_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Review Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.consentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent date"@en ;
    rdfs:comment "Date on which customer consent or authorization was obtained. Used for compliance tracking and audit trail."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "consent_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.consentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent method"@en ;
    rdfs:comment "Method by which customer consent was obtained: written signature, electronic acceptance, verbal authorization (recorded), or implied consent."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "consent_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Method" ;
    cmm:validValues "written|electronic|verbal|implied" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.consentReceivedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent received flag"@en ;
    rdfs:comment "Indicates whether customer consent or authorization was received for program enrollment (True/False). Required for regulatory compliance and audit purposes."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "consent_received_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Received Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingProgramEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this program enrollment record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:BillingProgramEnrollment.discountType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discount type"@en ;
    rdfs:comment "Type of discount calculation method applied: fixed amount (flat monthly credit), percentage (percent off eligible charges), tiered (discount varies by usage tier), usage-based (discount calculated from consumption)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "discount_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Discount Type" ;
    cmm:validValues "fixed_amount|percentage|tiered|usage_based" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.disenrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disenrollment date"@en ;
    rdfs:comment "Date the customer was disenrolled or removed from the program. Null for active enrollments. Used for churn analysis and program retention metrics."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "disenrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disenrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.disenrollmentInitiatedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disenrollment initiated by"@en ;
    rdfs:comment "Party that initiated the disenrollment: customer (voluntary opt-out), utility (administrative removal), automatic (system-triggered expiration), regulator (compliance action)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "disenrollment_initiated_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disenrollment Initiated By" ;
    cmm:validValues "customer|utility|automatic|regulator" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.disenrollmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disenrollment reason"@en ;
    rdfs:comment "Reason for program disenrollment: customer request (voluntary withdrawal), ineligibility (no longer qualifies), non-payment (payment arrangement breach), moved (service transfer), deceased, program ended (utility discontinued), failed re-certification (did not complete renewal). Reference-value candidates: customer_request|ineligibility|non_payment|moved|deceased|program_ended|failed_recertification."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "disenrollment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disenrollment Reason" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date on which the program enrollment expires or terminates. Null for open-ended enrollments. Used for automatic disenrollment processing and re-certification scheduling."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:BillingProgramEnrollment.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date from which the program benefits and terms become effective for billing and rate calculation purposes. May differ from enrollment date due to billing cycle alignment."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:BillingProgramEnrollment.eligibilityVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verification date"@en ;
    rdfs:comment "Date on which eligibility verification was completed and approved. Used for audit trail and compliance reporting to regulatory authorities."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "eligibility_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.eligibilityVerificationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verification method"@en ;
    rdfs:comment "Method used to verify customer eligibility for the program: income documentation (pay stubs/tax returns), categorical eligibility (participation in other assistance programs), third-party verification (government database check), self-certification, or automatic enrollment."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligibility_verification_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verification Method" ;
    cmm:validValues "income_documentation|categorical_eligibility|third_party_verification|self_certification|automatic_enrollment" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.eligibilityVerificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verification status"@en ;
    rdfs:comment "Status of the eligibility verification process for income-qualified or regulated programs: not verified (initial state), verified (eligibility confirmed), pending verification (under review), verification failed (did not meet criteria), exempt (no verification required)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligibility_verification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verification Status" ;
    cmm:validValues "not_verified|verified|pending_verification|verification_failed|exempt" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.enrollmentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment channel"@en ;
    rdfs:comment "Channel through which the customer enrolled in the program: online portal, phone call center, mail application, in-person at office, automatic enrollment by utility, or third-party agency."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:validValues "online|phone|mail|in_person|automatic|third_party" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date the customer was officially enrolled in the program and benefits became effective. Key business event timestamp for program participation lifecycle."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.enrollmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment number"@en ;
    rdfs:comment "Business-facing unique enrollment number assigned to this program participation record. Used for customer communication and service inquiries."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingProgramEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle status of the program enrollment: pending (application submitted), active (enrolled and receiving benefits), suspended (temporarily inactive), expired (term ended), cancelled (customer or utility terminated), denied (application rejected)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:validValues "pending|active|suspended|expired|cancelled|denied" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:BillingProgramEnrollment.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Scheduled expiration date for time-limited program enrollments requiring periodic re-certification (e.g., annual CARE/FERA re-qualification). Triggers re-certification workflow."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:BillingProgramEnrollment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this program enrollment record was last updated. Used for change tracking and audit trail."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BillingProgramEnrollment.lastRecertificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last recertification date"@en ;
    rdfs:comment "Date of the most recent successful re-certification or eligibility verification. Used to calculate next re-certification due date and track compliance history."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_recertification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Re-certification Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments regarding the program enrollment. Used for documenting special circumstances, customer requests, or processing exceptions."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:BillingProgramEnrollment.priorityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority flag"@en ;
    rdfs:comment "Indicates whether this enrollment has priority status for special handling (True/False). Used for life support, medical baseline, or critical care programs requiring expedited service."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "priority_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Priority Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingProgramEnrollment.programCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program code"@en ;
    rdfs:comment "Standardized code identifying the utility billing program type (e.g., CARE, FERA, BUDGET, AUTOPAY, PAPERLESS, ARREARAGE, TOU, CPP, NEM, DR)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingProgramEnrollment.programName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program name"@en ;
    rdfs:comment "Full descriptive name of the utility billing program (e.g., California Alternate Rates for Energy, Family Electric Rate Assistance, Budget Billing Plan, Auto-Pay Enrollment, Paperless Billing, Arrearage Management Program)."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Program Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:BillingProgramEnrollment.programType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program type"@en ;
    rdfs:comment "High-level classification of the program category: rate assistance programs (CARE/FERA), payment plans (budget billing/arrearage management), billing convenience (auto-pay/paperless), energy efficiency, demand response, net metering, or other. Reference-value candidates: rate_assistance|payment_plan|billing_convenience|energy_efficiency|demand_response|net_metering|other."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.type .
cmm:BillingProgramEnrollment.pucApprovalNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc approval number"@en ;
    rdfs:comment "PUC decision or resolution number authorizing this program. Required for regulatory compliance and audit documentation."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_approval_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Public Utility Commission (PUC) Approval Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingProgramEnrollment.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Rate schedule or tariff code applicable to this program enrollment. Used for billing calculation and rate application. May differ from standard rate for discount programs."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:BillingProgramEnrollment.recertificationDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recertification due date"@en ;
    rdfs:comment "Date by which the customer must complete re-certification to maintain program eligibility. Applicable to income-qualified and regulatory programs requiring periodic eligibility verification."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "recertification_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Re-certification Due Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingProgramEnrollment.regulatoryProgramCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory program code"@en ;
    rdfs:comment "Regulatory or compliance program code assigned by the Public Utility Commission (PUC) or governing body. Used for regulatory reporting and cost recovery tracking."@en ;
    rdfs:domain cmm:BillingProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Program Code" ;
    cmm:cimDatatype "String" .

cmm:ArLedger a owl:Class ;
    rdfs:label "Ar Ledger"@en ;
    rdfs:comment "Transactional entity representing the accounts receivable sub-ledger for customer billing activity, capturing all open item postings including invoiced amounts, payments applied, adjustments, write-offs, balance carry-forwards, and bad debt entries. Stores posting date, document type (invoice, payment, adjustment, write-off, refund), debit/credit indicator, amount, clearing status, clearing date, and GL account. For write-off postings: captures write-off date, write-off amount, reason (bankruptcy, skip, hardship, deceased), approval authority, bad debt GL account, recovery tracking status, and associated collections case reference. Sourced from SAP IS-U FICA open item management and SAP S/4HANA AR sub-ledger. SSOT for customer AR balance, write-off tracking, and bad debt management supporting SOX financial controls and PUC uncollectable expense reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpReceivable ;
    cmm:cimCloseMatch cim:ErpReceivable ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.ar_ledger" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; AR Sub-Ledger / FICA Open Item" ;
    cmm:sourceObject "energy_utilities_ecm.billing.ar_ledger" ;
    owl:hasKey ( cmm:ArLedger.arLedgerId ) .

cmm:ArLedger.arLedgerId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ar ledger id"@en ;
    rdfs:comment "Primary key for ar_ledger"@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:long ;
    cmm:physicalColumn "ar_ledger_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Ar Ledger Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ArLedger.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with this AR ledger entry. Links to the customer account master."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_account_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerAccount" .
cmm:ArLedger.arGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ar gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: AR ledger entries directly map to GL accounts for subledger-to-GL reconciliation. Essential for month-end close, external audits, SOX compliance, and ensuring billing subledger balances tie to general"@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "ar_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ar Gl Account Id (Foreign Key)" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_ar_gl_account_id" ;
    cmm:cimAssociation "ErpReceivable.ErpChartOfAccounts" .
cmm:ArLedger.arInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ar invoice"@en ;
    rdfs:comment "Reference to the invoice document that originated this AR ledger entry, if applicable. Null for non-invoice postings such as payments or adjustments."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "ar_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_ar_invoice_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerBillingInfo" .
cmm:ArLedger.collections a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "collections"@en ;
    rdfs:comment "Reference to the associated collections case if this AR ledger entry is part of an active collections effort. Null if no collections case exists."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:CollectionsCase ;
    cmm:physicalColumn "collections_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Collections Case ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_collections_id" ;
    cmm:cimAssociation "ErpReceivable.Document" .
cmm:ArLedger.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — AR ledger postings reference specific invoices for open item management. Required for FICA clearing and SOX controls."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_invoice_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerBillingInfo" .
cmm:ArLedger.paymentArrangement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement"@en ;
    rdfs:comment "Reference to the payment arrangement plan if this AR ledger entry is covered by an installment agreement. Null if no payment arrangement exists."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:PaymentArrangement ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Arrangement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_payment_arrangement_id" ;
    cmm:cimAssociation "ErpReceivable.AuxiliaryAgreement" .
cmm:ArLedger.primaryArEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary ar employee"@en ;
    rdfs:comment "User ID of the authorized approver who approved this write-off. Null for non-write-off entries. Required for SOX internal controls and audit trail."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_ar_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Write-Off Approval User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_primary_ar_employee_id" ;
    cmm:cimAssociation "ErpReceivable.ErpPersonnel" .
cmm:ArLedger.primaryInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — AR ledger entries reference the source invoice document for open item management and clearing."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "primary_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_ar_ledger_primary_invoice_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerBillingInfo" .
cmm:ArLedger.agingBucket a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aging bucket"@en ;
    rdfs:comment "Classification of this AR ledger entry based on the number of days past due. Used for aging reports and collections prioritization. Calculated from posting date and due date."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "aging_bucket" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Aging Bucket" ;
    cmm:validValues "current|1_30_days|31_60_days|61_90_days|over_90_days" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.arToSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ar to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — AR ledger entries are posted for a specific service agreement. This FK is the backbone of the customer AR sub-ledger."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:long ;
    cmm:physicalColumn "ar_to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ArLedger.badDebtGlAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bad debt gl account code"@en ;
    rdfs:comment "The general ledger account code for bad debt expense associated with this write-off. Null for non-write-off entries. Used for financial statement preparation."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "bad_debt_gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bad Debt General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.clearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing date"@en ;
    rdfs:comment "The date on which this AR ledger entry was cleared (fully paid or offset). Null for open items."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "clearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this AR ledger entry record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpReceivable.createdDateTime .
cmm:ArLedger.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the amounts in this AR ledger entry. Typically USD for US utilities."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ArLedger.debitCreditIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "debit credit indicator"@en ;
    rdfs:comment "Indicates whether this AR ledger entry is a debit (increases receivable balance) or credit (decreases receivable balance). Invoices and adjustments are typically debits; payments and refunds are credits."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "debit_credit_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Debit/Credit Indicator" ;
    cmm:validValues "debit|credit" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.disputeDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute date"@en ;
    rdfs:comment "The date on which the customer initiated a dispute for this AR ledger entry. Null if no dispute exists."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "dispute_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.disputeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute flag"@en ;
    rdfs:comment "Indicates whether this AR ledger entry is under dispute by the customer. True if disputed; false otherwise. Disputed items may be excluded from collections activity."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispute_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ArLedger.disputeReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute reason code"@en ;
    rdfs:comment "Standardized code indicating the reason for the customer dispute. Examples include billing error, meter reading issue, rate dispute. Null if no dispute exists."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Reason Code" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The business date of the underlying transaction or event that gave rise to this AR ledger entry. May differ from posting date for backdated or future-dated transactions."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.documentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document number"@en ;
    rdfs:comment "The externally-known unique document number for this AR ledger entry as recorded in the financial system. Used for audit trail and reconciliation."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ArLedger.documentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "Type of financial document represented by this AR ledger entry. Determines the nature of the posting and its impact on the customer balance. Reference-value candidates: invoice|payment|adjustment|write-off|refund|credit_memo|debit_memo|reversal."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Type" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "due date"@en ;
    rdfs:comment "The date by which payment is expected for this AR ledger entry. Used for aging calculations and collections prioritization. Null for non-invoice postings."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal period (month) within the fiscal year in which this AR ledger entry was posted. Used for monthly financial reporting and variance analysis."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:cimDatatype "Integer" .
cmm:ArLedger.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year in which this AR ledger entry was posted. Used for period-based financial reporting and year-end closing processes."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:ArLedger.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this AR ledger entry record was last updated in the system. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ArLedger.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional comments, explanations, or special handling instructions related to this AR ledger entry. Used for audit trail and customer service reference."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ArLedger.originalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original amount"@en ;
    rdfs:comment "The original posted amount of this AR ledger entry in the transaction currency. Represents the gross amount before any partial payments or adjustments."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Original Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ArLedger.outstandingAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding amount"@en ;
    rdfs:comment "The remaining unpaid balance of this AR ledger entry in the transaction currency. Equals original amount minus any payments or offsets applied. Zero for cleared items."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outstanding Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ArLedger.paymentMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method code"@en ;
    rdfs:comment "The payment method used for this AR ledger entry if it represents a payment. Examples include check, credit card, ACH, cash. Null for non-payment entries."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method Code" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.paymentReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment reference number"@en ;
    rdfs:comment "External reference number for the payment transaction, such as check number, credit card authorization code, or ACH trace number. Null for non-payment entries."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ArLedger.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which this AR ledger entry was posted to the financial system. Used for period-based financial reporting and aging analysis."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.postingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting status"@en ;
    rdfs:comment "Current lifecycle status of the AR ledger entry. Open items represent outstanding receivables; cleared items have been fully paid or offset."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "posting_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Status" ;
    cmm:validValues "open|cleared|partially_cleared|reversed|disputed" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.recoveryTrackingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery tracking status"@en ;
    rdfs:comment "Status of efforts to recover a written-off receivable. Tracks whether the utility is still pursuing collection or has abandoned recovery efforts. Not applicable for non-write-off entries."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "recovery_tracking_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Tracking Status" ;
    cmm:validValues "not_applicable|pending_recovery|recovered|abandoned" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Classification of revenue type for regulatory and financial reporting purposes. Examples include residential, commercial, industrial, street lighting."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.revenueRecognitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue recognition date"@en ;
    rdfs:comment "The date on which revenue associated with this AR ledger entry is recognized for financial reporting purposes. May differ from posting date based on revenue recognition policies."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "revenue_recognition_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Recognition Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this AR ledger entry is a reversal of a previous posting. True for reversal entries; false otherwise. Used for audit trail and error correction tracking."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ArLedger.reversedDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversed document number"@en ;
    rdfs:comment "The document number of the original AR ledger entry that this reversal entry is offsetting. Null for non-reversal entries. Establishes audit trail linkage."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversed_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reversed Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ArLedger.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — AR ledger postings are recorded against a service agreement/account. SSOT for customer AR balance."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ArLedger.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the geographic service territory or regulatory jurisdiction associated with this AR ledger entry. Used for regulatory reporting and revenue allocation."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:ArLedger.writeOffAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off amount"@en ;
    rdfs:comment "The amount written off as uncollectable bad debt. Null for non-write-off entries. Represents the reduction in accounts receivable and corresponding bad debt expense."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "write_off_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ArLedger.writeOffDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off date"@en ;
    rdfs:comment "The date on which this receivable was written off as uncollectable. Null for non-write-off entries. Used for bad debt expense tracking and PUC reporting."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:date ;
    cmm:physicalColumn "write_off_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Date" ;
    cmm:cimDatatype "Date" .
cmm:ArLedger.writeOffFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off flag"@en ;
    rdfs:comment "Indicates whether this AR ledger entry represents a write-off of uncollectable debt. True for write-off postings; false otherwise."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "write_off_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ArLedger.writeOffReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off reason code"@en ;
    rdfs:comment "Standardized code indicating the reason for writing off this receivable. Used for bad debt analysis and regulatory reporting. Null for non-write-off entries."@en ;
    rdfs:domain cmm:ArLedger ; rdfs:range xsd:string ;
    cmm:physicalColumn "write_off_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Reason Code" ;
    cmm:validValues "bankruptcy|skip|hardship|deceased|small_balance|statute_of_limitations" ;
    cmm:cimDatatype "String" .

cmm:CustomerRefund a owl:Class ;
    rdfs:label "Customer Refund"@en ;
    rdfs:comment "Transactional record of a refund issued to a customer for overpayment, deposit return, credit balance, or billing error correction. Captures refund date, amount, method (check, ACH, account credit), reason code, originating credit source, approval status, and disbursement confirmation. Sourced from SAP IS-U FICA and Oracle CC&B. Supports cash disbursement controls and SOX compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Transaction ;
    cmm:cimCloseMatch cim:Transaction ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.refund" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; Customer Refund / Credit Refund" ;
    cmm:sourceObject "energy_utilities_ecm.billing.refund" ;
    owl:hasKey ( cmm:CustomerRefund.refundId ) .

cmm:CustomerRefund.refundId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund id"@en ;
    rdfs:comment "Unique identifier for the refund transaction. Primary key for the refund product."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range xsd:long ;
    cmm:physicalColumn "refund_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Refund Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerRefund.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account that received the refund. Links to the billing account in the customer domain."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:CustomerRefund.billDispute a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bill dispute"@en ;
    rdfs:comment "Reference to the customer dispute or complaint case that triggered this refund. Links to customer service resolution tracking."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:BillDispute ;
    cmm:physicalColumn "bill_dispute_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispute Case Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_bill_dispute_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:CustomerRefund.creditMemo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "credit memo"@en ;
    rdfs:comment "Reference to the credit memo document that authorized this refund. Links to the billing adjustment that created the refundable credit."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:CreditMemo ;
    cmm:physicalColumn "credit_memo_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Credit Memo Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_credit_memo_id" ;
    cmm:cimAssociation "Transaction.ErpReceivable" .
cmm:CustomerRefund.deposit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "deposit"@en ;
    rdfs:comment "FK to billing.deposit.deposit_id — Deposit refunds are a primary refund type. This FK links the refund disbursement back to the originating deposit for financial reconciliation. Note: not all refunds are deposit-related, so this is a n"@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:SecurityDeposit ;
    cmm:physicalColumn "deposit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_deposit_id" ;
    cmm:cimAssociation "Transaction.AuxiliaryAccount" .
cmm:CustomerRefund.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Refunds post to specific GL accounts to reverse revenue or record expense. Link enables proper financial statement presentation, cash flow tracking, and regulatory reporting of customer refunds and ov"@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Refund Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_gl_account_id" ;
    cmm:cimAssociation "Transaction.ErpChartOfAccounts" .
cmm:CustomerRefund.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Reference to the original invoice that generated the credit or overpayment leading to this refund. May be null for deposit returns."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:CustomerRefund.payment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment"@en ;
    rdfs:comment "Foreign key linking to billing.payment. Business justification: Refunds can be issued for overpayments, and linking to the original payment enables full audit trail and reconciliation. Currently refund has account_id and invoice_id but no link to the payment being"@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:CustomerPayment ;
    cmm:physicalColumn "payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_payment_id" ;
    cmm:cimAssociation "Transaction.Transaction" .
cmm:CustomerRefund.refundEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "refund employee"@en ;
    rdfs:comment "System user identifier of the employee who authorized the refund. Required for SOX audit trail and segregation of duties compliance."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "refund_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_refund_employee_id" ;
    cmm:cimAssociation "Transaction.ErpPersonnel" .
cmm:CustomerRefund.refundModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "refund modified by user employee"@en ;
    rdfs:comment "System user identifier of the employee who last modified this refund record. Required for SOX audit trail and change tracking."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "refund_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_refund_modified_by_user_employee_id" ;
    cmm:cimAssociation "Transaction.ErpPersonnel" .
cmm:CustomerRefund.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Foreign key linking to asset.work_order. Business justification: Refunds often result from service quality issues, meter inaccuracies, or outage credits documented in work orders. Customer service, audit trails, and regulatory compliance require traceability from r"@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_refund_work_order_id" ;
    cmm:cimAssociation "Transaction.Work" .
cmm:CustomerRefund.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "The gross monetary value of the refund issued to the customer before any adjustments or withholdings."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerRefund.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date when the refund was formally approved by an authorized user. Establishes the point of financial commitment."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerRefund.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current state of the refund approval workflow. Tracks whether the refund has passed required authorization controls."@en ;
    rdfs:domain cmm:CustomerRefund ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
