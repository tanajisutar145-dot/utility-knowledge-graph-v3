    rdfs:label "settlement number"@en ;
    rdfs:comment "Business identifier for the settlement transaction, typically used in invoicing and payment reconciliation."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_number" ;
