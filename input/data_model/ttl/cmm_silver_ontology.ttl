cmm:SafetyTraining.assessmentScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment score"@en ;
    rdfs:comment "Numerical score achieved by the employee on the training assessment or examination, if applicable. Typically expressed as a percentage."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range xsd:decimal ;
