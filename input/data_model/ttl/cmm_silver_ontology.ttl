cmm:TaxProvision.deferredTaxAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deferred tax asset"@en ;
    rdfs:comment "The cumulative balance of deferred tax assets arising from temporary differences, net operating losses, and tax credits that will reduce future tax payments."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
