cmm:CapexExpenditure.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "The WBS element code against which this CAPEX expenditure is posted. Represents a specific phase or component of the capital project for granular cost tracking."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .

cmm:OpexBudget a owl:Class ;
    rdfs:label "Opex Budget"@en ;
    rdfs:comment "Operational expenditure budget plan in SAP S/4HANA CO-CCA capturing approved O&M spending targets by cost center and cost element group. Records budget version (original, revised, forecast), fiscal year, planned OPEX amount, approved amount, actual spend to date, variance amount and percentage, and regulatory OPEX allowance reference. Supports O&M cost planning against PUC-approved levels, EBITDA forecasting by business unit, and management variance reporting for generation fuel, T&D maintenance, and corporate overhead."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpLedgerBudget ;
    cmm:cimCloseMatch cim:ErpLedgerBudget ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.opex_budget" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; SAP CO-CCA Cost Center Planning (KP06)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.opex_budget" ;
    owl:hasKey ( cmm:OpexBudget.opexBudgetId ) .

cmm:OpexBudget.opexBudgetId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opex budget id"@en ;
    rdfs:comment "Unique identifier for the operational expenditure budget record. Primary key for the OPEX budget entity."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:long ;
    cmm:physicalColumn "opex_budget_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Operational Expenditure (OPEX) Budget ID" ;
    cmm:cimDatatype "Integer" .
cmm:OpexBudget.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Reference to the cost center responsible for this OPEX budget allocation. Links to organizational cost center hierarchy in SAP CO-CCA."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_cost_center_id" ;
    cmm:cimAssociation "ErpLedgerBudget.Organisation" .
cmm:OpexBudget.costElementGroup a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost element group"@en ;
    rdfs:comment "Reference to the cost element group categorizing the type of operational expenditure (e.g., fuel costs, maintenance labor, administrative overhead)."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:CostElementGroup ;
    cmm:physicalColumn "cost_element_group_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Element Group ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_cost_element_group_id" ;
    cmm:cimAssociation "ErpLedgerBudget.IdentifiedObject" .
cmm:OpexBudget.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "The user ID or employee identifier of the person who last modified this budget record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_employee_id" ;
    cmm:cimAssociation "ErpLedgerBudget.ErpPersonnel" .
cmm:OpexBudget.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Foreign key linking to generation.generating_unit. Business justification: O&M budgets are set at the unit level for cost control, budget preparation, and monthly variance reporting. Standard in utility operations."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_generating_unit_id" ;
    cmm:cimAssociation "ErpLedgerBudget.GeneratingUnit" .
cmm:OpexBudget.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Operating expense budgets are developed using load forecasts as primary drivers. O&M costs scale with forecasted energy delivery and peak demand. Critical for annual budgeting cycle and operational pl"@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_load_id" ;
    cmm:cimAssociation "ErpLedgerBudget.ConformLoadSchedule" .
cmm:OpexBudget.ownerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "owner employee"@en ;
    rdfs:comment "Reference to the employee or manager who owns and is accountable for managing this budget line. Links to the workforce or employee master data."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "owner_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Budget Owner ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_owner_employee_id" ;
    cmm:cimAssociation "ErpLedgerBudget.ErpPersonnel" .
cmm:OpexBudget.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level O&M budgets for aggregated operations. Required for annual budget cycle, regulatory filings, and executive reporting."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_power_plant_id" ;
    cmm:cimAssociation "ErpLedgerBudget.Plant" .
cmm:OpexBudget.primaryOpexEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary opex employee"@en ;
    rdfs:comment "Reference to the employee or manager who approved this budget version. Links to the workforce or employee master data for audit trail purposes."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_opex_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Budget Approver ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_primary_opex_employee_id" ;
    cmm:cimAssociation "ErpLedgerBudget.ErpPersonnel" .
cmm:OpexBudget.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "FK to finance.profit_center.profit_center_id — OPEX budgets are set by cost center (merged into organizational_unit). This FK enables budget vs. actual variance reporting by organizational unit — a core management reporting requirement."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_opex_budget_profit_center_id" ;
    cmm:cimAssociation "ErpLedgerBudget.Organisation" .
cmm:OpexBudget.actualSpendAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual spend amount"@en ;
    rdfs:comment "The actual operational expenditure incurred to date for this budget line, sourced from posted cost transactions in SAP FI/CO. Used for variance analysis against planned and approved amounts."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_spend_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Spend Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.approvedOpexAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved opex amount"@en ;
    rdfs:comment "The approved operational expenditure amount after management and regulatory review. This is the authorized spending limit for the period."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_opex_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Operational Expenditure (OPEX) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.availableBudgetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "available budget amount"@en ;
    rdfs:comment "The remaining budget available for new commitments or expenditures, calculated as approved_opex_amount minus (actual_spend_amount plus commitment_amount)."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "available_budget_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Budget Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.budgetApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget approval date"@en ;
    rdfs:comment "The date on which this budget version was formally approved by management or the board, transitioning from draft or submitted status to approved status."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:date ;
    cmm:physicalColumn "budget_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:OpexBudget.budgetCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget category"@en ;
    rdfs:comment "High-level categorization of the OPEX budget line by expenditure type, enabling roll-up reporting and analysis by major cost driver (e.g., fuel costs for generation, maintenance for T&D assets). Reference-value candidates: fuel|labor|maintenance|materials|contracted_services|administrative|regulatory|environmental|technology."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpLedgerBudget.kind .
cmm:OpexBudget.budgetEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget effective date"@en ;
    rdfs:comment "The date from which this budget version becomes effective and active for spending authorization and control."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:date ;
    cmm:physicalColumn "budget_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:OpexBudget.budgetExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget expiration date"@en ;
    rdfs:comment "The date on which this budget version expires and is no longer valid for new commitments or expenditures. Typically the end of the fiscal period or year."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:date ;
    cmm:physicalColumn "budget_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:OpexBudget.budgetLockStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget lock status"@en ;
    rdfs:comment "Indicates whether this budget line is open for changes (unlocked), locked to prevent further modifications, or frozen for regulatory reporting purposes."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_lock_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Lock Status" ;
    cmm:validValues "unlocked|locked|frozen" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.budgetNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget notes"@en ;
    rdfs:comment "Free-text field for capturing additional context, assumptions, or justifications related to this budget line. Used for documenting budget planning rationale and variance explanations."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:OpexBudget.budgetStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget status"@en ;
    rdfs:comment "Current lifecycle status of the budget record indicating its approval and activation state within the budget planning and execution workflow."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Status" ;
    cmm:validValues "draft|submitted|approved|active|closed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpLedgerBudget.status .
cmm:OpexBudget.budgetVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget version"@en ;
    rdfs:comment "The version of the budget record indicating whether this is the original approved budget, a revised budget after adjustments, a forecast update, or a supplemental allocation."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Version" ;
    cmm:validValues "original|revised|forecast|supplemental|baseline" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.businessUnitCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business unit code"@en ;
    rdfs:comment "Code identifying the business unit or division (e.g., Generation, Transmission and Distribution, Corporate) responsible for this OPEX budget line."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_unit_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Unit Code" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.commitmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment amount"@en ;
    rdfs:comment "The total amount of purchase orders, contracts, or other financial commitments issued against this budget line but not yet posted as actual expenditure. Used for funds availability checking."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "commitment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this OPEX budget record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpLedgerBudget.createdDateTime .
cmm:OpexBudget.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this budget record (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:OpexBudget.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "The FERC Uniform System of Accounts code that classifies this OPEX expenditure for regulatory reporting purposes. Ensures compliance with FERC financial reporting requirements."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal period (month or quarter) within the fiscal year for which this budget line applies. Typically 1-12 for monthly periods."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:cimDatatype "Integer" .
cmm:OpexBudget.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year for which this OPEX budget is planned and tracked. Typically a four-digit year (e.g., 2024)."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:OpexBudget.forecastAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast amount"@en ;
    rdfs:comment "The forecasted or projected OPEX expenditure for this budget line based on current run-rate and known future commitments. Used for EBITDA forecasting and financial planning."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.functionalArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area"@en ;
    rdfs:comment "The functional area of utility operations to which this OPEX budget applies, enabling segmentation by core business process (e.g., power generation, T&D operations, customer service). Reference-value candidates: generation|transmission|distribution|customer_service|corporate|regulatory|trading|renewable_energy."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.isCapitalConversionCandidate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is capital conversion candidate"@en ;
    rdfs:comment "Boolean flag indicating whether this OPEX expenditure may be eligible for capitalization or conversion to CAPEX under regulatory accounting rules. Used for financial planning and rate base optimization."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_capital_conversion_candidate" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Capital Conversion Candidate" ;
    cmm:cimDatatype "Boolean" .
cmm:OpexBudget.isRegulatoryReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is regulatory reportable"@en ;
    rdfs:comment "Boolean flag indicating whether this OPEX budget line must be included in regulatory financial reports submitted to PUC or FERC. True if reportable; false otherwise."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_regulatory_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Regulatory Reportable" ;
    cmm:cimDatatype "Boolean" .
cmm:OpexBudget.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this OPEX budget record was last updated or modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OpexBudget.plannedOpexAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned opex amount"@en ;
    rdfs:comment "The planned operational expenditure amount for this cost center and cost element group for the specified fiscal period. Represents the initial budget target before approvals or adjustments."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_opex_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Operational Expenditure (OPEX) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.priorYearActualAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prior year actual amount"@en ;
    rdfs:comment "The actual OPEX expenditure for the same cost center and cost element group in the prior fiscal year. Used for year-over-year trend analysis and budget benchmarking."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "prior_year_actual_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prior Year Actual Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.regulatoryAllowanceReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory allowance reference"@en ;
    rdfs:comment "Reference identifier or docket number for the regulatory filing or rate case order that established the regulatory OPEX allowance for this budget line."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_allowance_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Allowance Reference" ;
    cmm:cimDatatype "String" .
cmm:OpexBudget.regulatoryOpexAllowance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory opex allowance"@en ;
    rdfs:comment "The OPEX spending level approved by the Public Utility Commission (PUC) or regulatory authority for this cost category and period. Used to ensure spending aligns with rate case approvals and regulatory compliance."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulatory_opex_allowance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Operational Expenditure (OPEX) Allowance" ;
    cmm:cimDatatype "Decimal" .
cmm:OpexBudget.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "The monetary variance between approved OPEX budget and actual spend (approved_opex_amount minus actual_spend_amount). Positive values indicate under-spend; negative values indicate over-spend."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OpexBudget.variancePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance percentage"@en ;
    rdfs:comment "The percentage variance between approved OPEX budget and actual spend, calculated as (variance_amount / approved_opex_amount) * 100. Used for management reporting and exception flagging."@en ;
    rdfs:domain cmm:OpexBudget ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .

cmm:InternalOrder a owl:Class ;
    rdfs:label "Internal Order"@en ;
    rdfs:comment "SAP CO internal order used to collect and monitor costs for specific short-term activities such as planned outage repairs, storm restoration events, vegetation management campaigns, or overhead projects not warranting a full WBS structure. Captures order type (overhead, investment, accrual), responsible cost center, settlement rule, budget, actual costs, commitment values, and lifecycle status (created, released, technically complete, closed). Used for O&M job costing, regulatory cost segregation, and FERC account-level cost tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpProjectAccounting ;
    cmm:cimCloseMatch cim:ErpProjectAccounting ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.internal_order" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; SAP CO Internal Order (KO01)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.internal_order" ;
    owl:hasKey ( cmm:InternalOrder.internalOrderId ) .

cmm:InternalOrder.internalOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal order id"@en ;
    rdfs:comment "Unique identifier for the SAP CO internal order. Primary key for cost collection and monitoring of short-term activities."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Internal Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:InternalOrder.internalCostCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal cost center"@en ;
    rdfs:comment "FK to finance.cost_center.cost_center_id — Internal orders settle to cost centers. The responsible cost center is a required organizational assignment for every internal order in SAP CO."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "internal_cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "cost_center_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_internal_cost_center_id" ;
    cmm:cimAssociation "ErpProjectAccounting.Organisation" .
cmm:InternalOrder.internalProfitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal profit center"@en ;
    rdfs:comment "Identifier of the profit center to which internal order costs are allocated for segment profitability analysis and management reporting."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "internal_profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center ID" ;
    cmm:sourceColumn "profit_center_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_internal_profit_center_id" ;
    cmm:cimAssociation "ErpProjectAccounting.Organisation" .
cmm:InternalOrder.internalResponsibleCostCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal responsible cost center"@en ;
    rdfs:comment "Identifier of the cost center accountable for planning, executing, and settling the internal order costs. Links to the organizational unit managing the activity."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "internal_responsible_cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Cost Center ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_internal_responsible_cost_center_id" ;
    cmm:cimAssociation "ErpProjectAccounting.Organisation" .
cmm:InternalOrder.primarySettlementGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary settlement gl account"@en ;
    rdfs:comment "Identifier of the primary GL account to which internal order costs are settled, typically a FERC account code for regulatory cost tracking."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "primary_settlement_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Primary Settlement General Ledger (GL) Account ID" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_primary_settlement_gl_account_id" ;
    cmm:cimAssociation "ErpProjectAccounting.ErpChartOfAccounts" .
cmm:InternalOrder.toProfitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to profit center"@en ;
    rdfs:comment "FK to finance.profit_center.profit_center_id — Internal orders are assigned to responsible cost centers (merged into organizational_unit) for cost collection and settlement. Critical for storm cost tracking and regulatory cost segregation."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "to_profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_to_profit_center_id" ;
    cmm:cimAssociation "ErpProjectAccounting.Organisation" .
cmm:InternalOrder.wbsElement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "Optional reference to a WBS element if this internal order is part of a larger capital project structure, enabling hierarchical cost rollup."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range cmm:WbsElement ;
    cmm:physicalColumn "wbs_element_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_internal_order_wbs_element_id" ;
    cmm:cimAssociation "ErpProjectAccounting.ErpProjectAccounting" .
cmm:InternalOrder.actualCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual cost amount"@en ;
    rdfs:comment "Total actual costs posted to the internal order to date, including labor, materials, services, and overhead allocations, in the company currency."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_cost_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InternalOrder.actualEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end date"@en ;
    rdfs:comment "Actual date when work on the internal order activity was completed, triggering technical completion status and final settlement processing."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual End Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.actualStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start date"@en ;
    rdfs:comment "Actual date when work on the internal order activity commenced, captured from work order confirmations or time entry records."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.auditTrailRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit trail required flag"@en ;
    rdfs:comment "Indicates whether detailed change history and approval documentation must be retained for this internal order to support regulatory audits or rate case proceedings."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "audit_trail_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Audit Trail Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InternalOrder.budgetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget amount"@en ;
    rdfs:comment "Approved budget allocation for the internal order in the company currency, representing the planned cost ceiling for the activity."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "budget_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InternalOrder.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "Cross-company code segment for internal financial reporting, often aligned with business divisions such as Generation, Transmission, Distribution, or Retail."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.capexOpexIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex opex indicator"@en ;
    rdfs:comment "Classification of internal order costs as capital expenditure (CAPEX) for asset capitalization and depreciation, or operational expenditure (OPEX) for immediate expense recognition."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_opex_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) / Operational Expenditure (OPEX) Indicator" ;
    cmm:validValues "CAPEX|OPEX" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.closureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure date"@en ;
    rdfs:comment "Date when the internal order was closed and archived, indicating all costs have been settled and the order is no longer active for any postings."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "closure_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closure Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.commitmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment amount"@en ;
    rdfs:comment "Total committed costs (purchase requisitions and purchase orders) assigned to the internal order but not yet invoiced, used for funds availability checking and budget monitoring."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "commitment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InternalOrder.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code representing the legal entity to which this internal order belongs, used for financial consolidation and regulatory reporting."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.controllingArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlling area"@en ;
    rdfs:comment "SAP Controlling (CO) area code representing the organizational unit for cost accounting and internal reporting, may span multiple company codes."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlling_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlling Area (CO)" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the internal order master record was first created in the system, in ISO 8601 format with timezone."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpProjectAccounting.createdDateTime .
cmm:InternalOrder.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for all monetary amounts on this internal order (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:InternalOrder.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code to which internal order costs are ultimately allocated for regulatory financial reporting and rate case filings."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3,6}$" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.functionalArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area"@en ;
    rdfs:comment "Classification of the internal order by business function for cost-of-sales accounting and segment reporting (e.g., Operations, Maintenance, Administration, Sales)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.longDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "long description"@en ;
    rdfs:comment "Detailed narrative describing the scope, purpose, and business justification for the internal order, including work location, asset references, and regulatory drivers."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "long_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Order Long Description" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "SAP user ID of the person who last modified the internal order master record."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when the internal order master record was last modified, in ISO 8601 format with timezone."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InternalOrder.orderCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order category"@en ;
    rdfs:comment "Business classification of the activity being tracked: planned outage repairs, storm restoration events, vegetation management campaigns, regulatory compliance initiatives, customer-funded projects, asset replacement programs, grid modernization efforts, or other activities. Reference-value candidates: planned_outage|storm_restoration|vegetation_management|regulatory_compliance|customer_project|asset_replacement|grid_modernization|other."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Order Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpProjectAccounting.kind .
cmm:InternalOrder.orderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order number"@en ;
    rdfs:comment "Business-facing alphanumeric identifier for the internal order, used in work requests, cost reports, and regulatory filings."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Order Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InternalOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle status of the internal order: created (initial setup), released (active for posting), technically complete (work finished, final costs pending), closed (settled and archived), or locked (posting blocked for corrections)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Order Status" ;
    cmm:validValues "created|released|technically_complete|closed|locked" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpProjectAccounting.status .
cmm:InternalOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classification of the internal order by accounting treatment: overhead (O&M expense), investment (CAPEX capitalization), accrual (period-end allocation), statistical (non-financial tracking), or settlement (cost redistribution)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Order Type" ;
    cmm:validValues "overhead|investment|accrual|statistical|settlement" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpProjectAccounting.type .
cmm:InternalOrder.plannedEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned end date"@en ;
    rdfs:comment "Scheduled date when work on the internal order activity is planned to be completed, used for milestone tracking and settlement scheduling."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned End Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.plannedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned start date"@en ;
    rdfs:comment "Scheduled date when work on the internal order activity is planned to begin, used for resource planning and project scheduling."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Start Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether costs accumulated on this internal order are eligible for inclusion in the Regulatory Asset Base (RAB) for rate-of-return calculations and rate case filings."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InternalOrder.requestingDepartment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting department"@en ;
    rdfs:comment "Name or code of the business department that initiated the internal order request (e.g., Transmission Operations, Distribution Maintenance, Regulatory Affairs)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_department" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requesting Department" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.settledCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settled cost amount"@en ;
    rdfs:comment "Total costs that have been settled (distributed) from this internal order to receiving cost objects, used to track settlement completeness and reconcile order balances."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "settled_cost_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settled Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InternalOrder.settlementPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period"@en ;
    rdfs:comment "Fiscal period (YYYY-MM format) in which internal order costs are settled to receiving cost objects, used for period-end closing and financial reporting."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period" ;
    cmm:valuePattern "^[0-9]{4}-(0[1-9]|1[0-2])$" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.settlementReceiverType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement receiver type"@en ;
    rdfs:comment "Type of cost object that receives settled costs from this internal order: GL account (direct expense posting), cost center (overhead allocation), asset (capitalization), WBS element (project assignment), or profitability segment (CO-PA)."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_receiver_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Receiver Type" ;
    cmm:validValues "gl_account|cost_center|asset|wbs_element|profitability_segment" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.settlementRuleProfile a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement rule profile"@en ;
    rdfs:comment "Configuration key defining how costs accumulated on this internal order are settled (distributed) to receiving cost objects such as GL accounts, cost centers, assets, or WBS elements at period-end."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_rule_profile" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Rule Profile" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.shortDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "short description"@en ;
    rdfs:comment "Brief title or summary of the internal order activity, typically 40-60 characters, used in reports and work order references."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "short_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Order Short Description" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this internal order is subject to SOX financial controls and audit requirements, triggering additional approval workflows and documentation retention."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InternalOrder.systemStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system status"@en ;
    rdfs:comment "SAP system-controlled status codes concatenated as a string (e.g., CRTD REL SETC TECO CLSD), reflecting automated status transitions based on business transactions."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "system_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Status" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.technicalCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technical completion date"@en ;
    rdfs:comment "Date when the internal order was set to technically complete status, preventing further primary cost postings while allowing settlement and final adjustments."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "technical_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technical Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:InternalOrder.userStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "user status"@en ;
    rdfs:comment "User-defined status value from a configured status profile, enabling business-specific workflow states such as Approved, In Progress, Pending Review, or Rejected."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "user_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "User Status" ;
    cmm:cimDatatype "String" .
cmm:InternalOrder.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "Difference between actual costs and budget amount (actual minus budget), used for cost control reporting and management variance analysis."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InternalOrder.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "SAP user ID of the person who created the internal order master record in the system."@en ;
    rdfs:domain cmm:InternalOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:RegulatoryAsset a owl:Class ;
    rdfs:label "Regulatory Asset"@en ;
    rdfs:comment "Regulatory asset base (RAB) master representing both individual regulatory assets/liabilities and the periodic RAB valuation roll-forward. Individual asset attributes: regulatory asset type (storm costs, pension, environmental remediation, deferred fuel, CWIP), authorization order reference, amortization period, carrying amount, and rate recovery status. RAB valuation attributes: valuation date, opening RAB, CAPEX additions, depreciation charge, disposals, inflation indexation, closing RAB, regulatory jurisdiction, and allowed return amount. Core to rate case financial models, revenue requirement calculations, and PUC/FERC rate proceedings. SSOT for all regulatory assets, deferred cost recovery items, and the net asset base on which the utility earns its regulated return."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.finance.regulatory_asset" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "ASC 980; FERC Account 182 / ASC 980 Regulatory Assets" ;
    cmm:sourceObject "energy_utilities_ecm.finance.regulatory_asset" ;
    owl:hasKey ( cmm:RegulatoryAsset.regulatoryAssetId ) .

cmm:RegulatoryAsset.regulatoryAssetId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset id"@en ;
    rdfs:comment "Unique identifier for the regulatory asset or liability record. Primary key for the regulatory asset base (RAB) master."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:long ;
    cmm:physicalColumn "regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Regulatory Asset ID" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryAsset.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Regulatory assets (deferred storm costs, stranded costs) are often jurisdiction-specific and must be tracked by control area for rate recovery, FERC reporting, state PUC filings, and amortization allo"@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:RegulatoryAsset.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key reference to the cost center responsible for the originating costs or credits that created this regulatory asset or liability."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:RegulatoryAsset.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key reference to the general ledger account in SAP S/4HANA FI where this regulatory asset or liability is recorded."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "General Ledger (GL) Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_gl_account_id" ;
    cmm:cimAssociation "Document.ErpChartOfAccounts" .
cmm:RegulatoryAsset.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level regulatory assets (deferred major maintenance, storm costs). Required for FERC account 182.3 tracking and rate recovery."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:RegulatoryAsset.accruedCarryingCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accrued carrying cost"@en ;
    rdfs:comment "Cumulative carrying costs (interest or return) accrued on the regulatory asset balance, calculated using the authorized rate of return or weighted average cost of capital (WACC)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accrued_carrying_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accrued Carrying Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.allowedReturnAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowed return amount"@en ;
    rdfs:comment "Dollar amount of return on equity (ROE) and debt return that the utility is allowed to earn on this regulatory asset base component during the period, calculated as RAB × WACC."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allowed_return_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowed Return Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.amortizationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amortization end date"@en ;
    rdfs:comment "Scheduled date on which the regulatory asset or liability will be fully amortized and recovered, based on the authorized amortization period."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "amortization_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amortization End Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAsset.amortizationPeriodMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amortization period months"@en ;
    rdfs:comment "Total number of months over which the regulatory asset or liability is authorized to be amortized and recovered through customer rates."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:int ;
    cmm:physicalColumn "amortization_period_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amortization Period (Months)" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryAsset.amortizationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amortization start date"@en ;
    rdfs:comment "Date on which amortization and rate recovery of the regulatory asset or liability began."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "amortization_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amortization Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAsset.assetLiabilityIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset liability indicator"@en ;
    rdfs:comment "Indicates whether this record represents a regulatory asset (deferred cost recoverable from customers) or a regulatory liability (deferred credit owed to customers)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_liability_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset or Liability Indicator" ;
    cmm:validValues "asset|liability" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.assetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset type"@en ;
    rdfs:comment "Classification of the regulatory asset or liability. Storm costs, pension obligations, environmental remediation, deferred fuel costs, construction work in progress (CWIP), deferred tax, regulatory liability, or other. Reference-value candidates: storm_costs|pension_obligation|environmental_remediation|deferred_fuel|cwip|deferred_tax|regulatory_liability|other."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Asset Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:RegulatoryAsset.authorizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization date"@en ;
    rdfs:comment "Date on which the regulatory authority issued the order authorizing this regulatory asset or liability treatment."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "authorization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAsset.authorizationOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization order number"@en ;
    rdfs:comment "Public Utility Commission (PUC) or FERC order number authorizing the deferral and recovery of this regulatory asset, or the refund mechanism for this regulatory liability."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Authorization Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RegulatoryAsset.authorizedReturnRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized return rate"@en ;
    rdfs:comment "Annual rate of return authorized by the regulatory body for calculating carrying costs on the regulatory asset balance. Expressed as a decimal (e.g., 0.0725 for 7.25%)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "authorized_return_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Return Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.capexAdditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex additions"@en ;
    rdfs:comment "Capital expenditure additions to the regulatory asset base during the valuation period, representing new plant and equipment placed in service."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capex_additions" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Additions" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.carryingAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "carrying amount"@en ;
    rdfs:comment "Current net book value of the regulatory asset or liability after amortization, adjustments, and accrued carrying costs. This is the balance sheet amount."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "carrying_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carrying Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.closingRabAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closing rab amount"@en ;
    rdfs:comment "Closing balance of the regulatory asset base at the end of the valuation period, after all additions, depreciation, disposals, and indexation adjustments."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "closing_rab_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closing Regulatory Asset Base (RAB) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this regulatory asset record was first created in the system."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RegulatoryAsset.cumulativeAmortization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative amortization"@en ;
    rdfs:comment "Total amount of the regulatory asset or liability that has been amortized and recovered through customer rates to date."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_amortization" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Amortization" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this record (e.g., USD, CAD, GBP)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RegulatoryAsset.depreciationCharge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation charge"@en ;
    rdfs:comment "Depreciation expense charged against the regulatory asset base during the valuation period, reducing the net book value of rate base assets."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciation_charge" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Charge" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.disallowedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disallowed amount"@en ;
    rdfs:comment "Portion of the regulatory asset that was disallowed by the regulator during prudence review and cannot be recovered from customers."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disallowed_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disallowed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.disposalsRetirements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disposals retirements"@en ;
    rdfs:comment "Net book value of assets retired or disposed from the regulatory asset base during the valuation period."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disposals_retirements" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disposals and Retirements" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date on which this regulatory asset or liability record ceased to be effective. Null for currently active records."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:RegulatoryAsset.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date on which this regulatory asset or liability record became effective and active in the system."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:RegulatoryAsset.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for the regulatory asset or liability (e.g., 182.3 for Other Regulatory Assets, 254 for Other Regulatory Liabilities)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3}(\\.[0-9]{1,2})?$" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.inflationIndexation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inflation indexation"@en ;
    rdfs:comment "Inflation adjustment applied to the regulatory asset base in jurisdictions that use indexed RAB methodologies (e.g., RPI or CPI indexation). Zero in non-indexed jurisdictions."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "inflation_indexation" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inflation Indexation Adjustment" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "User ID or name of the person who last modified this regulatory asset record."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this regulatory asset record was last modified in the system."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RegulatoryAsset.monthlyAmortizationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monthly amortization amount"@en ;
    rdfs:comment "Fixed monthly amortization amount recovered through customer rates, calculated as the original amount divided by the amortization period."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "monthly_amortization_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monthly Amortization Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes providing additional context, regulatory guidance, or special conditions related to this regulatory asset or liability."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Asset Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:RegulatoryAsset.openingRabAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opening rab amount"@en ;
    rdfs:comment "Opening balance of the regulatory asset base at the beginning of the valuation period, before CAPEX additions, depreciation, and disposals."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "opening_rab_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opening Regulatory Asset Base (RAB) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.originalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original amount"@en ;
    rdfs:comment "Original principal amount of the regulatory asset or liability at the time of initial recognition, in the reporting currency."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Original Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.prudenceReviewStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prudence review status"@en ;
    rdfs:comment "Status of the regulatory prudence review for this asset: pending review, approved for full recovery, partially approved (some costs disallowed), or disallowed."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "prudence_review_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prudence Review Status" ;
    cmm:validValues "pending|approved|partially_approved|disallowed" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.rabInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion flag"@en ;
    rdfs:comment "Indicates whether this regulatory asset is included in the regulatory asset base (RAB) for calculating the allowed return on equity (ROE) and revenue requirement."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RegulatoryAsset.rabValuationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab valuation date"@en ;
    rdfs:comment "As-of date for the RAB valuation roll-forward calculation. Typically the end of a reporting period (month-end, quarter-end, or year-end)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "rab_valuation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Valuation Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAsset.rateRecoveryStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate recovery status"@en ;
    rdfs:comment "Current status of rate recovery for this regulatory asset or liability: not started, in progress (actively being recovered), completed (fully recovered), suspended, or denied by regulator."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_recovery_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Recovery Status" ;
    cmm:validValues "not_started|in_progress|completed|suspended|denied" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.rateScheduleReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule reference"@en ;
    rdfs:comment "Reference to the specific rate schedule or tariff rider through which this regulatory asset or liability is being recovered from or refunded to customers."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Reference" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.regulatoryAssetName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset name"@en ;
    rdfs:comment "Descriptive name of the regulatory asset or liability (e.g., Storm Cost Recovery 2023, Deferred Fuel Costs Q4 2024, Environmental Remediation Reserve)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_asset_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Regulatory Asset Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:RegulatoryAsset.regulatoryAssetNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset number"@en ;
    rdfs:comment "Business identifier for the regulatory asset or liability, used in rate case filings and regulatory correspondence. Format: RA-NNNNNNNN."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_asset_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Asset Number" ;
    cmm:valuePattern "^RA-[0-9]{8}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RegulatoryAsset.regulatoryAssetStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset status"@en ;
    rdfs:comment "Current lifecycle status of the regulatory asset: pending regulatory approval, approved for recovery, actively being recovered through rates, fully amortized, written off, or suspended."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_asset_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Asset Status" ;
    cmm:validValues "pending_approval|approved|active_recovery|fully_amortized|written_off|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:RegulatoryAsset.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "Regulatory body with jurisdiction over this asset or liability (e.g., California PUC, FERC, Texas PUC, New York PSC). Determines applicable accounting and rate recovery rules."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAsset.roeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "roe rate"@en ;
    rdfs:comment "Authorized return on equity rate used in the revenue requirement calculation for this regulatory asset. Expressed as a decimal (e.g., 0.0950 for 9.50%)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "roe_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return on Equity (ROE) Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this regulatory asset is subject to Sarbanes-Oxley Act internal control requirements due to materiality or financial statement impact."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RegulatoryAsset.unamortizedBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unamortized balance"@en ;
    rdfs:comment "Remaining principal balance of the regulatory asset or liability that has not yet been amortized or recovered through customer rates."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unamortized_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unamortized Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAsset.waccRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wacc rate"@en ;
    rdfs:comment "Weighted average cost of capital authorized by the regulator for calculating the allowed return on this regulatory asset. Expressed as a decimal (e.g., 0.0675 for 6.75%)."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wacc_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weighted Average Cost of Capital (WACC) Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAsset.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or name of the person who created this regulatory asset record in the system."@en ;
    rdfs:domain cmm:RegulatoryAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:RateCaseFiling a owl:Class ;
    rdfs:label "Rate Case Filing"@en ;
    rdfs:comment "Rate case financial model and filing record submitted to PUC or FERC. Captures filing date, docket number, test year, requested revenue requirement, allowed ROE, WACC, rate base (RAB), proposed rate schedules, intervenor positions, settlement terms, and final order outcome. SSOT for regulatory financial proceedings and revenue requirement determinations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.finance.rate_case_filing" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "PUC/FERC Rate Case Docket" ;
    cmm:sourceObject "energy_utilities_ecm.finance.rate_case_filing" ;
    owl:hasKey ( cmm:RateCaseFiling.rateCaseFilingId ) .

cmm:RateCaseFiling.rateCaseFilingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate case filing id"@en ;
    rdfs:comment "Unique identifier for the rate case filing record. Primary key for the rate case filing entity."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:long ;
    cmm:physicalColumn "rate_case_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Rate Case Filing Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:RateCaseFiling.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Rate cases reference specific IRP scenarios to justify revenue requirements and capital investments. Test year assumptions must align with filed IRP forecasts. Essential for regulatory rate case prepa"@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rate_case_filing_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RateCaseFiling.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Rate cases reference specific plants for cost-of-service calculations, test year data compilation, and rate base valuation. Essential for regulatory proceedings."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rate_case_filing_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:RateCaseFiling.primaryRegulatoryAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary regulatory asset"@en ;
    rdfs:comment "FK to finance.regulatory_asset.regulatory_asset_id — Rate case filings reference the RAB valuation as a core input to revenue requirement calculations. This FK links the regulatory proceeding to the asset base on which return is earned."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range cmm:RegulatoryAsset ;
    cmm:physicalColumn "primary_regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "regulatory_asset_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rate_case_filing_primary_regulatory_asset_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RateCaseFiling.rateRegulatoryAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate regulatory asset"@en ;
    rdfs:comment "FK to finance.regulatory_asset.regulatory_asset_id — Rate case filings include regulatory assets (deferred costs) in the revenue requirement. The filing must reference which regulatory assets are being recovered."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range cmm:RegulatoryAsset ;
    cmm:physicalColumn "rate_regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rate_case_filing_rate_regulatory_asset_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RateCaseFiling.annualRevenueImpact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual revenue impact"@en ;
    rdfs:comment "Estimated annual revenue impact to the utility resulting from the approved rate changes, calculated as the difference between approved and current revenue levels."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_revenue_impact" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Revenue Impact" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.approvedRateBase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved rate base"@en ;
    rdfs:comment "Total value of utility plant and other assets approved by the regulatory commission for earning a return, which may differ from the requested rate base due to disallowances or adjustments."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_rate_base" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Rate Base (Regulatory Asset Base - RAB)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.approvedRevenueRequirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved revenue requirement"@en ;
    rdfs:comment "Total annual revenue requirement approved by the regulatory commission in the final order, which may differ from the requested amount due to adjustments and disallowances."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_revenue_requirement" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Revenue Requirement" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.approvedRoe a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved roe"@en ;
    rdfs:comment "Return on equity percentage approved by the regulatory commission in the final order. Expressed as a decimal (e.g., 0.0950 for 9.50%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_roe" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Return on Equity (ROE)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.approvedWacc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved wacc"@en ;
    rdfs:comment "Weighted average cost of capital approved by the regulatory commission in the final order. Expressed as a decimal (e.g., 0.0675 for 6.75%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_wacc" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Weighted Average Cost of Capital (WACC)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.capitalStructureDebtRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital structure debt ratio"@en ;
    rdfs:comment "Proportion of debt in the approved capital structure used for rate-making purposes. Expressed as a decimal (e.g., 0.4800 for 48%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capital_structure_debt_ratio" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Structure Debt Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.capitalStructureEquityRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital structure equity ratio"@en ;
    rdfs:comment "Proportion of equity in the approved capital structure used for rate-making purposes. Expressed as a decimal (e.g., 0.5200 for 52%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capital_structure_equity_ratio" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Structure Equity Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.costOfDebt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost of debt"@en ;
    rdfs:comment "Weighted average interest rate on the utility's debt used in the rate case calculation. Expressed as a decimal (e.g., 0.0450 for 4.50%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_of_debt" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost of Debt" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this rate case filing record was first created in the system."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RateCaseFiling.customerClassCoverage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer class coverage"@en ;
    rdfs:comment "Customer classes affected by this rate case filing (e.g., residential, commercial, industrial, or all classes). Pipe-separated list if multiple classes."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_class_coverage" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Class Coverage" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.depreciationExpense a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation expense"@en ;
    rdfs:comment "Annual depreciation expense included in the revenue requirement, calculated based on approved depreciation rates and depreciable plant balances."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciation_expense" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Expense" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.docketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "docket number"@en ;
    rdfs:comment "Official docket or case number assigned by the regulatory commission (PUC or FERC) to uniquely identify this rate case proceeding."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RateCaseFiling.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date on which the approved rates become effective and are implemented for customer billing."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rate Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:RateCaseFiling.filingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing date"@en ;
    rdfs:comment "Date on which the rate case application was officially filed with the regulatory commission."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Case Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.filingDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing document reference"@en ;
    rdfs:comment "Reference identifier or URL to the official rate case filing documents, testimony, exhibits, and supporting materials submitted to the regulatory commission."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filing Document Reference" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.filingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing status"@en ;
    rdfs:comment "Current lifecycle status of the rate case filing within the regulatory review process. Reference-value candidates: draft|filed|pending_review|suspended|hearing_scheduled|settlement_negotiations|final_order_issued|approved|denied|withdrawn."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rate Case Filing Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:RateCaseFiling.filingType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing type"@en ;
    rdfs:comment "Classification of the rate case filing indicating the nature of the regulatory request (e.g., general rate case, formula rate update, fuel adjustment clause, purchased power adjustment, rider, tariff amendment)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rate Case Filing Type" ;
    cmm:validValues "general_rate_case|formula_rate|fuel_adjustment|purchased_power_adjustment|rider|tariff_amendment" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:RateCaseFiling.finalOrderDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final order date"@en ;
    rdfs:comment "Date on which the regulatory commission issued its final order or decision on the rate case."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "final_order_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Order Issuance Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.finalOrderOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final order outcome"@en ;
    rdfs:comment "Overall outcome of the rate case as determined in the final commission order."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "final_order_outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Order Outcome" ;
    cmm:validValues "approved_as_filed|approved_with_modifications|partially_approved|denied|withdrawn|remanded" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.hearingScheduledDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hearing scheduled date"@en ;
    rdfs:comment "Date on which the regulatory hearing or evidentiary proceeding is scheduled to begin for this rate case."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "hearing_scheduled_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hearing Scheduled Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.intervenorCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intervenor count"@en ;
    rdfs:comment "Number of intervenor parties formally participating in the rate case proceeding (e.g., consumer advocates, industrial customer groups, environmental organizations)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:int ;
    cmm:physicalColumn "intervenor_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Intervenor Count" ;
    cmm:cimDatatype "Integer" .
cmm:RateCaseFiling.intervenorPositionsSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intervenor positions summary"@en ;
    rdfs:comment "Summary of key positions and recommendations submitted by intervenor parties during the rate case proceeding."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "intervenor_positions_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Intervenor Positions Summary" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.jurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jurisdiction"@en ;
    rdfs:comment "Level of regulatory jurisdiction for this rate case (federal for FERC-jurisdictional wholesale rates, state for retail rates under state PUC authority, municipal for locally-regulated utilities)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction Level" ;
    cmm:validValues "federal|state|municipal" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this rate case filing record was last modified or updated in the system."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RateCaseFiling.operatingExpenses a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating expenses"@en ;
    rdfs:comment "Total annual operating expenses included in the revenue requirement calculation, covering operations and maintenance costs, administrative expenses, and customer service costs."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "operating_expenses" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Expenses (OPEX)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.rateDesignMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate design methodology"@en ;
    rdfs:comment "Description of the rate design methodology proposed or approved in the rate case (e.g., cost-of-service, performance-based ratemaking, decoupling mechanism, time-of-use rates)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_design_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Design Methodology" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.rateIncreasePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate increase percentage"@en ;
    rdfs:comment "Overall percentage increase in customer rates resulting from the approved revenue requirement. Expressed as a decimal (e.g., 0.0350 for 3.50% increase). Negative values indicate rate decreases."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rate_increase_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Increase Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RateCaseFiling.regulatoryCommission a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory commission"@en ;
    rdfs:comment "Name of the regulatory body with jurisdiction over this rate case (e.g., Federal Energy Regulatory Commission, California Public Utilities Commission, New York Public Service Commission)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_commission" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Commission Name" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.requestedRateBase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested rate base"@en ;
    rdfs:comment "Total value of utility plant and other assets on which the utility requests to earn a return, also known as Regulatory Asset Base (RAB). Includes net plant in service, working capital, and other rate base components."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_rate_base" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Rate Base (Regulatory Asset Base - RAB)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.requestedRevenueRequirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested revenue requirement"@en ;
    rdfs:comment "Total annual revenue requirement requested by the utility in the rate case filing, representing the sum of operating expenses, depreciation, taxes, and return on rate base."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_revenue_requirement" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Revenue Requirement" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.requestedRoe a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested roe"@en ;
    rdfs:comment "Return on equity percentage requested by the utility, representing the rate of return on shareholder equity investment. Expressed as a decimal (e.g., 0.1050 for 10.50%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_roe" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Return on Equity (ROE)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.requestedWacc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested wacc"@en ;
    rdfs:comment "Weighted average cost of capital requested by the utility, representing the blended cost of debt and equity financing. Expressed as a decimal (e.g., 0.0725 for 7.25%)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_wacc" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Weighted Average Cost of Capital (WACC)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Geographic service territory or region covered by this rate case filing (e.g., state name, county list, or service area designation)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.settlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement date"@en ;
    rdfs:comment "Date on which the settlement agreement was executed by the parties, if applicable."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Agreement Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.settlementReachedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement reached flag"@en ;
    rdfs:comment "Indicates whether a settlement agreement was reached among parties prior to final commission decision (True if settlement reached, False otherwise)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "settlement_reached_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Reached Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RateCaseFiling.settlementTermsSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement terms summary"@en ;
    rdfs:comment "High-level summary of key settlement terms and conditions agreed upon by the parties, including revenue requirement, ROE, rate base adjustments, and other material provisions."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_terms_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Terms Summary" ;
    cmm:cimDatatype "String" .
cmm:RateCaseFiling.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this rate case filing is subject to SOX financial reporting controls and audit requirements (True for publicly-traded utilities, False otherwise)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RateCaseFiling.taxExpense a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax expense"@en ;
    rdfs:comment "Total tax expense included in the revenue requirement, including federal and state income taxes, property taxes, and other applicable taxes."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_expense" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Expense" ;
    cmm:cimDatatype "Decimal" .
cmm:RateCaseFiling.testYearEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test year end date"@en ;
    rdfs:comment "Ending date of the test year period used as the basis for revenue requirement calculations and rate design in the filing."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_year_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Year End Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.testYearStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test year start date"@en ;
    rdfs:comment "Beginning date of the test year period used as the basis for revenue requirement calculations and rate design in the filing."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_year_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Year Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RateCaseFiling.testYearType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test year type"@en ;
    rdfs:comment "Classification of the test year methodology used in the rate case (historical actual data, future projected data, or hybrid approach combining historical with known adjustments)."@en ;
    rdfs:domain cmm:RateCaseFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_year_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Year Type" ;
    cmm:validValues "historical|future|hybrid" ;
    cmm:cimDatatype "String" .

cmm:RabValuation a owl:Class ;
    rdfs:label "Rab Valuation"@en ;
    rdfs:comment "Regulatory Asset Base valuation record representing the net value of utility assets on which a regulated return is earned. Captures valuation date, opening RAB, CAPEX additions, depreciation charge, disposals, inflation indexation, closing RAB, regulatory jurisdiction, and allowed return amount. Core input to revenue requirement calculations in PUC and FERC rate proceedings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.finance.rab_valuation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "PUC/FERC Rate Base (RAB) Calculation" ;
    cmm:sourceObject "energy_utilities_ecm.finance.rab_valuation" ;
    owl:hasKey ( cmm:RabValuation.rabValuationId ) .

cmm:RabValuation.rabValuationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab valuation id"@en ;
    rdfs:comment "Unique identifier for the regulatory asset base valuation record."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:long ;
    cmm:physicalColumn "rab_valuation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Valuation ID" ;
    cmm:cimDatatype "Integer" .
cmm:RabValuation.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "FK to finance.fixed_asset.fixed_asset_id — RAB valuations are computed from the net book value of regulated fixed assets. The RAB must reference the underlying asset base to support rate case filings and PUC audits."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rab_valuation_fixed_asset_id" ;
    cmm:cimAssociation "Document.FinancialInfo" .
cmm:RabValuation.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: RAB valuations are calculated within IRP scenario contexts for different planning futures. Regulatory asset base projections depend on scenario-specific capex and depreciation assumptions for long-ter"@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rab_valuation_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RabValuation.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: RAB valuations are performed at the plant level for regulatory returns, annual RAB roll-forward, and allowed return calculations. Critical for UK/international regulatory models."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rab_valuation_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:RabValuation.rateCaseFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case filing"@en ;
    rdfs:comment "Foreign key linking to finance.rate_case_filing. Business justification: RAB valuations are prepared for and submitted as part of rate case filings to regulatory commissions. The rate_case_docket_number (STRING) should be replaced with FK to rate_case_filing.rate_case_fili"@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range cmm:RateCaseFiling ;
    cmm:physicalColumn "rate_case_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Case Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_rab_valuation_rate_case_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RabValuation.accumulatedDeferredIncomeTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated deferred income tax amount"@en ;
    rdfs:comment "The accumulated deferred income tax liability that is deducted from the RAB, representing the tax benefit of accelerated depreciation and other timing differences between book and tax accounting."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accumulated_deferred_income_tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Deferred Income Tax (ADIT) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.allowedReturnAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowed return amount"@en ;
    rdfs:comment "The total dollar amount of return the utility is permitted to earn on the closing RAB, calculated as closing RAB multiplied by the allowed WACC or ROE. This is a key component of the revenue requirement."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allowed_return_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowed Return Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.allowedRoePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowed roe percentage"@en ;
    rdfs:comment "The regulatory-approved return on equity percentage that the utility is permitted to earn on the equity portion of its RAB, expressed as a decimal (e.g., 0.0950 for 9.50%)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allowed_roe_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowed Return on Equity (ROE) Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RabValuation.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which the regulatory commission formally approved this RAB valuation and associated revenue requirement."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:RabValuation.assetCategoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset category code"@en ;
    rdfs:comment "The functional classification of assets included in this RAB valuation (generation, transmission, distribution, general plant, intangible assets, or common/shared assets)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_category_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Category Code" ;
    cmm:validValues "GENERATION|TRANSMISSION|DISTRIBUTION|GENERAL_PLANT|INTANGIBLE|COMMON" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.assetDisposalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset disposal amount"@en ;
    rdfs:comment "The net book value of assets retired, sold, or otherwise removed from the rate base during the valuation period, including plant retirements and decommissioning."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_disposal_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Disposal Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.auditTrailReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit trail reference"@en ;
    rdfs:comment "A reference identifier linking this RAB valuation to supporting audit documentation, workpapers, and regulatory filings for compliance and audit trail purposes."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "audit_trail_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Audit Trail Reference" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.businessAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area code"@en ;
    rdfs:comment "The business segment or division code (e.g., electric, gas, water) to which this RAB valuation is allocated, used for segment reporting and cost allocation."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area Code" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.capexAdditionsAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex additions amount"@en ;
    rdfs:comment "The total value of capital investments added to the rate base during the valuation period, including new generation, transmission, distribution assets, and major upgrades placed into service."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capex_additions_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Additions Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.closingRabAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closing rab amount"@en ;
    rdfs:comment "The net book value of rate base assets at the end of the valuation period, calculated as opening RAB plus CAPEX additions minus depreciation minus disposals plus inflation adjustments. This is the base on which the allowed return is calculated."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "closing_rab_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closing Regulatory Asset Base (RAB) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "The internal company or legal entity code for the utility operating company to which this RAB valuation applies, used for multi-entity consolidation."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.constructionWorkInProgressAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "construction work in progress amount"@en ;
    rdfs:comment "The value of capital projects under construction that are included in the RAB before they are placed into service, subject to regulatory approval for CWIP-in-rate-base treatment."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "construction_work_in_progress_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Construction Work in Progress (CWIP) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.costOfDebtPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost of debt percentage"@en ;
    rdfs:comment "The weighted average interest rate on the utility's debt obligations, expressed as a decimal (e.g., 0.0450 for 4.50%). Used to calculate the debt component of WACC."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_of_debt_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost of Debt Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RabValuation.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "The user ID or name of the person who created this RAB valuation record in the financial system."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this RAB valuation record was first created in the system."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RabValuation.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code for all monetary amounts in this RAB valuation record (typically USD for US utilities)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RabValuation.customerAdvancesAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer advances amount"@en ;
    rdfs:comment "The amount of customer contributions and advances for construction that are deducted from the RAB, representing funds provided by customers for line extensions and service installations."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "customer_advances_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Advances Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.debtRatioPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "debt ratio percentage"@en ;
    rdfs:comment "The proportion of the RAB financed by debt capital, expressed as a decimal (e.g., 0.5000 for 50%). Used in conjunction with equity ratio to calculate WACC."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "debt_ratio_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Debt Ratio Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RabValuation.depreciationChargeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation charge amount"@en ;
    rdfs:comment "The total depreciation expense recognized during the valuation period, reducing the RAB in accordance with approved depreciation rates and asset useful lives."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciation_charge_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Charge Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date on which this RAB valuation ceases to be effective for rate-making purposes, typically the end of a rate period or the start of a new rate case."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:RabValuation.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date from which this RAB valuation becomes effective for rate-making purposes, typically the start of a new rate period."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:RabValuation.equityRatioPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equity ratio percentage"@en ;
    rdfs:comment "The proportion of the RAB financed by equity capital, expressed as a decimal (e.g., 0.5000 for 50%). Used in conjunction with debt ratio to calculate WACC."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "equity_ratio_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equity Ratio Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RabValuation.inflationIndexationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inflation indexation amount"@en ;
    rdfs:comment "The adjustment to RAB for inflation indexation where applicable, used in jurisdictions that apply real-terms or indexed RAB methodologies (common in UK-style regulatory frameworks, less common in US FERC jurisdictions)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "inflation_indexation_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inflation Indexation Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.jurisdictionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jurisdiction name"@en ;
    rdfs:comment "The full name of the regulatory jurisdiction or commission (e.g., 'California Public Utilities Commission', 'Federal Energy Regulatory Commission')."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "jurisdiction_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Jurisdiction Name" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "The user ID or name of the person who last modified this RAB valuation record."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this RAB valuation record was last modified in the system."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RabValuation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional comments, explanations, or context regarding this RAB valuation, including regulatory adjustments, special circumstances, or variance explanations."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:RabValuation.openingRabAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opening rab amount"@en ;
    rdfs:comment "The net book value of rate base assets at the beginning of the valuation period, representing the starting point for RAB roll-forward calculations."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "opening_rab_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opening Regulatory Asset Base (RAB) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.regulatoryAssetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset amount"@en ;
    rdfs:comment "The value of regulatory assets (deferred costs approved for future recovery) included in the RAB, such as deferred storm costs, pension obligations, or environmental remediation expenses."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulatory_asset_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.regulatoryJurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction code"@en ;
    rdfs:comment "The regulatory authority governing this RAB valuation (FERC for interstate transmission, State PUC for retail distribution, ISO/RTO for market operations, or multi-jurisdictional for utilities operating across multiple territories)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction Code" ;
    cmm:validValues "FERC|STATE_PUC|MUNICIPAL|COOPERATIVE|ISO_RTO|MULTI_JURISDICTIONAL" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.regulatoryLiabilityAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory liability amount"@en ;
    rdfs:comment "The value of regulatory liabilities (deferred credits to be returned to customers) that reduce the RAB, such as excess deferred taxes or over-collected revenues."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulatory_liability_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Liability Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RabValuation.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this RAB valuation record is subject to SOX internal controls and audit requirements (True for publicly traded utilities, False otherwise)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RabValuation.valuationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation date"@en ;
    rdfs:comment "The date on which this RAB valuation is calculated and recorded, typically aligned with regulatory reporting periods (annual or rate case filing dates)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:date ;
    cmm:physicalColumn "valuation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Valuation Date" ;
    cmm:cimDatatype "Date" .
cmm:RabValuation.valuationMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation method code"@en ;
    rdfs:comment "The methodology used to value the RAB (historical cost, fair value, replacement cost, inflation-indexed, or hybrid approach), as prescribed by the regulatory jurisdiction."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "valuation_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Valuation Method Code" ;
    cmm:validValues "HISTORICAL_COST|FAIR_VALUE|REPLACEMENT_COST|INDEXED|HYBRID" ;
    cmm:cimDatatype "String" .
cmm:RabValuation.valuationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation status"@en ;
    rdfs:comment "The current status of this RAB valuation in the regulatory review and approval process. Reference-value candidates: DRAFT|SUBMITTED|UNDER_REVIEW|APPROVED|REJECTED|AMENDED|FINAL."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:string ;
    cmm:physicalColumn "valuation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Valuation Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:RabValuation.waccPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wacc percentage"@en ;
    rdfs:comment "The blended cost of capital (debt and equity) approved by the regulator for calculating the allowed return on the RAB, expressed as a decimal (e.g., 0.0725 for 7.25%)."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wacc_percentage" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weighted Average Cost of Capital (WACC) Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RabValuation.workingCapitalAllowanceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "working capital allowance amount"@en ;
    rdfs:comment "The amount of working capital included in the RAB to cover the utility's operational cash flow needs, typically calculated as a percentage of operating expenses or using a lead-lag study."@en ;
    rdfs:domain cmm:RabValuation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "working_capital_allowance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Working Capital Allowance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:IntercompanyTransaction a owl:Class ;
    rdfs:label "Intercompany Transaction"@en ;
    rdfs:comment "Intercompany financial transaction record between legal entities within the utility holding company group (e.g., regulated T&D utility, unregulated generation subsidiary, shared services company, fuel procurement entity). Captures sending and receiving company codes, transaction type (management fee, shared service allocation, intercompany loan, dividend, cost recharge, power purchase), amount, transfer pricing method, netting status, elimination flag for consolidation, and SOX/FERC affiliate transaction compliance reference. Supports consolidated financial reporting, FERC affiliate transaction disclosure (18 CFR 35.39), and cross-subsidy prevention controls."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:ErpLedgerEntry ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.intercompany_transaction" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI Intercompany Posting / FERC Affiliate Transaction Rules" ;
    cmm:sourceObject "energy_utilities_ecm.finance.intercompany_transaction" ;
    owl:hasKey ( cmm:IntercompanyTransaction.intercompanyTransactionId ) .

cmm:IntercompanyTransaction.intercompanyTransactionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intercompany transaction id"@en ;
    rdfs:comment "Unique identifier for the intercompany transaction record. Primary key for this entity."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range xsd:long ;
    cmm:physicalColumn "intercompany_transaction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Intercompany Transaction ID" ;
    cmm:cimDatatype "Integer" .
cmm:IntercompanyTransaction.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Intercompany transactions can be assigned to cost centers for tracking intercompany charges by organizational unit. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_cost_center_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Organisation" .
cmm:IntercompanyTransaction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the person or role who approved the intercompany transaction."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_employee_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpPersonnel" .
cmm:IntercompanyTransaction.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Intercompany transactions post to GL accounts for intercompany receivables, payables, and revenue/expense. The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_gl_account_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpChartOfAccounts" .
cmm:IntercompanyTransaction.intercompanyJournalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "intercompany journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Intercompany transactions generate journal entries in both sending and receiving company codes. The link to the GL posting is required for elimination processing and consolidated reporting."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "intercompany_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "journal_entry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_intercompany_journal_entry_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpJournal" .
cmm:IntercompanyTransaction.primaryJournalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Intercompany transactions generate journal entries for both sending and receiving entities. Required for consolidated financial reporting and elimination entries."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "primary_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_primary_journal_entry_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpJournal" .
cmm:IntercompanyTransaction.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Intercompany transactions can be assigned to profit centers for internal management reporting and segment analysis. The profit_center (STRING) should be replaced with FK to profit_center.profit_center"@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_profit_center_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Organisation" .
cmm:IntercompanyTransaction.reversedTransactionIntercompanyTransaction a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reversed transaction intercompany transaction"@en ;
    rdfs:comment "Reference to the original intercompany transaction ID that this transaction reverses, if applicable."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range cmm:IntercompanyTransaction ;
    cmm:physicalColumn "reversed_transaction_intercompany_transaction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reversed Transaction ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_intercompany_transaction_reversed_transaction_intercompany_transaction_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpLedgerEntry" .
cmm:IntercompanyTransaction.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when the intercompany transaction was approved by the designated authority."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:IntercompanyTransaction.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current approval status of the intercompany transaction in the workflow."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "pending|approved|rejected" ;
    cmm:cimDatatype "String" .
cmm:IntercompanyTransaction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the intercompany transaction record was first created in the system."@en ;
    rdfs:domain cmm:IntercompanyTransaction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
