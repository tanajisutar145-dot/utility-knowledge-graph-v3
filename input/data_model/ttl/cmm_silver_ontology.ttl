    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "violation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation End Date" ;
    cmm:cimDatatype "Date" .
cmm:SelfReport.violationRiskFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation risk factor"@en ;
    rdfs:comment "Risk classification of the violated requirement indicating potential impact to bulk electric system reliability."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_risk_factor" ;
    cmm:sqlDataType "STRING" ;
