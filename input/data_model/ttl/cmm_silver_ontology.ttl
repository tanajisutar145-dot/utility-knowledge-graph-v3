cmm:StudyPathAnalysis a owl:Class ;
    rdfs:label "Study Path Analysis"@en ;
    rdfs:comment "This association product represents the analytical relationship between transmission planning studies and transmission paths. It captures the results of analyzing specific transmission paths within a planning study context, including violations identified, contingency scenarios tested, and recommended upgrades. Each record links one planning study to one path with path-specific analysis results that exist only in the context of that study.. Existence Justification: Transmission planning studies analyze multiple transmission paths under various contingency scenarios as required by NERC TPL standards, and each transmission path is analyzed across multiple planning studies over time (different planning horizons, load assumptions, and generation scenarios). Planning engineers explicitly track path-specific analysis results within each study, including violations, limiting contingencies, and recommended upgrades. This is a core operational business process in transmission planning."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.planning_studies ;
    cmm:physicalTable "utility_cmm_silver.transmission.study_path_analysis" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.study_path_analysis" ;
    owl:hasKey ( cmm:StudyPathAnalysis.studyPathAnalysisId ) .

cmm:StudyPathAnalysis.studyPathAnalysisId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study path analysis id"@en ;
    rdfs:comment "Unique identifier for this study-path analysis record. Primary key."@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:long ;
    cmm:physicalColumn "study_path_analysis_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Study Path Analysis Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:StudyPathAnalysis.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Foreign key linking to the transmission path that was analyzed in this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Study Path Analysis - Transmission Path Id" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_study_path_analysis_transmission_path_id" ;
    cmm:cimAssociation "IdentifiedObject.TransmissionPath" .
cmm:StudyPathAnalysis.transmissionPlanningStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission planning study"@en ;
    rdfs:comment "Foreign key linking to the transmission planning study that performed this path analysis"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range cmm:PlanningStudy ;
    cmm:physicalColumn "transmission_planning_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Study Path Analysis - Transmission Planning Study Id" ;
    cmm:sourceColumn "planning_study_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_study_path_analysis_transmission_planning_study_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:StudyPathAnalysis.analysisDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis date"@en ;
    rdfs:comment "Date when this specific path analysis was performed within the planning study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:date ;
    cmm:physicalColumn "analysis_date" ;
