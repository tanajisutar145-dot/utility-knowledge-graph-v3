    cmm:businessTerm "Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_document_tertiary_application_modified_by_user_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
