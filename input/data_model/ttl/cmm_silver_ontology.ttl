cmm:CrewAssignment.crewRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew role"@en ;
    rdfs:comment "Specific role or position the employee holds within the crew, such as crew lead, foreman, journeyman lineman, apprentice lineman, equipment operator, safety observer, or support technician. Reference-value candidates: crew_lead|foreman|journeyman_lineman|apprentice_lineman|equipment_operator|safety_observer|support_technician|meter_technician|substation_technician."@en ;
