cmm:SelfReport.violationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation start date"@en ;
    rdfs:comment "Date when the alleged violation or non-compliance condition first began or occurred."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "violation_start_date" ;
    cmm:sqlDataType "DATE" ;
