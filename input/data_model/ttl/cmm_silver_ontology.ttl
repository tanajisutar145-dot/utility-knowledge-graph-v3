    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Incentive Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CostResponsibility.totalEstimatedCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total estimated cost"@en ;
    rdfs:comment "Total estimated cost for this cost category in USD. Represents the full cost before allocation between applicant and utility."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_estimated_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Estimated Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CostResponsibility.utilityCostShareAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility cost share amount"@en ;
    rdfs:comment "Dollar amount of cost responsibility assigned to the utility in USD. Represents the utility's financial obligation for this cost category, typically recovered through rates."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_cost_share_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utility Cost Share Amount" ;
