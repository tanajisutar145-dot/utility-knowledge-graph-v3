cmm:BatteryVendorServiceAgreement.primaryContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact phone"@en ;
    rdfs:comment "Direct phone number for the vendor contact responsible for this battery asset. Used for emergency response and service coordination."@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_phone" ;
