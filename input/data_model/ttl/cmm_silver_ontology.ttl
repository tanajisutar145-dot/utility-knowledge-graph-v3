    cmm:cimDatatype "Decimal" .
cmm:TaxProvision.excessAditBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "excess adit balance"@en ;
    rdfs:comment "The excess deferred income tax balance arising from the Tax Cuts and Jobs Act rate reduction, requiring amortization per IRS normalization rules."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
