cmm:PenaltyAssessment a owl:Class ;
    rdfs:label "Penalty Assessment"@en ;
    rdfs:comment "Record of monetary penalties and sanctions assessed against the utility by regulatory bodies, including NERC civil monetary penalties (CMPs), FERC civil penalties, EPA administrative penalties, PUC fines, and OSHA citations with penalty amounts. Captures the associated enforcement action, penalty amount proposed, penalty amount final, payment due date, payment status, penalty mitigation factors applied, and whether the penalty was contested. SSOT for regulatory financial exposure tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.penalty_assessment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC CMEP; NERC Sanction Guidelines; FERC Civil Penalty Policy; EPA Civil Penalty Policy" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.penalty_assessment" ;
    owl:hasKey ( cmm:PenaltyAssessment.penaltyAssessmentId ) .

cmm:PenaltyAssessment.penaltyAssessmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty assessment id"@en ;
    rdfs:comment "Unique identifier for the penalty assessment record. Primary key."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "penalty_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Penalty Assessment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:PenaltyAssessment.correctiveActionPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Reference to the corrective action plan developed to address the violation and prevent recurrence."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Corrective Action Plan Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_penalty_assessment_corrective_action_plan_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PenaltyAssessment.enforcementAction a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "enforcement action"@en ;
    rdfs:comment "Reference to the parent enforcement action that resulted in this penalty assessment."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range cmm:EnforcementAction ;
    cmm:physicalColumn "enforcement_action_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Enforcement Action Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_penalty_assessment_enforcement_action_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PenaltyAssessment.responsibleBusinessUnitOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible business unit org unit"@en ;
    rdfs:comment "Foreign key linking to workforce.org_unit. Business justification: Penalty assessments are allocated to organizational units for cost recovery and performance tracking. Replaces text field with FK to enable departmental penalty cost allocation and compliance performa"@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "responsible_business_unit_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Business Unit Org Unit Id (Foreign Key)" ;
    cmm:sourceColumn "org_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_penalty_assessment_responsible_business_unit_org_unit_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:PenaltyAssessment.assessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment date"@en ;
    rdfs:comment "The date the penalty was formally assessed by the regulatory body."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:PenaltyAssessment.boardNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board notification date"@en ;
    rdfs:comment "The date the Board of Directors was notified of this penalty assessment."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_notification_date" ;
