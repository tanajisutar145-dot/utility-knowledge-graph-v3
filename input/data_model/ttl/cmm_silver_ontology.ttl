    cmm:cimExtends cim:TimeSchedule ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:forecast , cmmsa:forecast.resource_planning ;
    cmm:physicalTable "utility_cmm_silver.forecast.planning_period" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.forecast.planning_period" ;
    owl:hasKey ( cmm:PlanningPeriod.planningPeriodId ) .

cmm:PlanningPeriod.planningPeriodId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning period id"@en ;
