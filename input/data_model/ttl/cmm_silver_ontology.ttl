cmm:ContractorCompany.postalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "Postal or ZIP code of the contractor's primary address."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "postal_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
