cmm:WorkSchedule a owl:Class ;
    rdfs:label "Work Schedule"@en ;
    rdfs:comment "Master schedule templates defining shift patterns for utility workforce roles — including rotating 12-hour shifts for generation plant operators, 8-hour day/evening/night shifts for distribution control room dispatchers, on-call rotation schedules for emergency response crews, and standard M-F schedules for administrative staff. Captures schedule name, shift type, hours per shift, rotation cycle, applicable union agreement, and overtime eligibility rules."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:WorkTimeSchedule ;
    cmm:cimCloseMatch cim:WorkTimeSchedule ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.work_schedule" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-6; SAP S/4HANA HCM Work Schedule Rules" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.work_schedule" ;
    owl:hasKey ( cmm:WorkSchedule.workScheduleId ) .

cmm:WorkSchedule.workScheduleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work schedule id"@en ;
    rdfs:comment "Unique identifier for the work schedule template. Primary key."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Work Schedule ID" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.unionAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "union agreement"@en ;
    rdfs:comment "FK to workforce.union_agreement.union_agreement_id — Work schedules for bargaining unit employees must comply with CBA shift provisions, overtime rules, and call-out requirements. This link enables schedule validation against union agreement terms."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range cmm:UnionAgreement ;
    cmm:physicalColumn "union_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_work_schedule_union_agreement_id" ;
    cmm:cimAssociation "WorkTimeSchedule.Agreement" .
cmm:WorkSchedule.applicableDepartments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable departments"@en ;
    rdfs:comment "Comma-separated list of departments or business units that use this schedule (e.g., 'Generation Operations, Transmission Control', 'Distribution Field Services', 'Customer Service'). Used for organizational reporting."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_departments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Departments" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.applicableJobRoles a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable job roles"@en ;
    rdfs:comment "Comma-separated list of job roles or classifications that typically use this schedule (e.g., 'Generation Plant Operator, Control Room Operator', 'Lineman, Field Technician', 'Administrative Staff'). Used for workforce planning."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_job_roles" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Job Roles" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.applicableUnionAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable union agreement"@en ;
    rdfs:comment "Name or identifier of the collective bargaining agreement (CBA) or union contract that governs this schedule (e.g., 'IBEW Local 1245 CBA 2023', 'Non-Union'). Null if not union-covered."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_union_agreement" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Union Agreement" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.breakDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "break duration minutes"@en ;
    rdfs:comment "Total duration of paid and unpaid breaks during the shift in minutes (e.g., 30 for lunch, 60 for lunch plus rest breaks). Used for net work hour calculations."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "break_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Break Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkSchedule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this work schedule template record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:WorkTimeSchedule.createdDateTime .
cmm:WorkSchedule.crewSizeMinimum a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew size minimum"@en ;
    rdfs:comment "Minimum number of employees required per shift under this schedule to maintain safe operations and regulatory compliance (e.g., 2 for line crew, 1 for control room operator). Null if not applicable."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_size_minimum" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Size Minimum" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.crewSizeOptimal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew size optimal"@en ;
    rdfs:comment "Optimal number of employees per shift under this schedule for efficient operations and workload distribution. Used for workforce planning and scheduling optimization."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_size_optimal" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Size Optimal" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this work schedule template ceased or will cease to be effective. Null for currently active schedules with no planned end date."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:WorkSchedule.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this work schedule template became or will become effective for workforce assignments. Used for schedule versioning and historical tracking."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:WorkSchedule.fatigueRiskLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fatigue risk level"@en ;
    rdfs:comment "Assessment of fatigue risk associated with this schedule pattern: low (standard day shifts), moderate (rotating or extended shifts), high (frequent night shifts or compressed schedules). Used for safety and compliance monitoring."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "fatigue_risk_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fatigue Risk Level" ;
    cmm:validValues "low|moderate|high" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.holidayWorkFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "holiday work flag"@en ;
    rdfs:comment "Indicates whether employees on this schedule are expected to work on company-recognized holidays (True) or have holidays off (False). Affects holiday premium pay."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "holiday_work_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Holiday Work Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.hoursPerShift a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hours per shift"@en ;
    rdfs:comment "Standard number of hours in a single shift under this schedule (e.g., 8.00, 10.00, 12.00). Used for time tracking and labor cost allocation."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hours_per_shift" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hours Per Shift" ;
    cmm:cimDatatype "Decimal" .
cmm:WorkSchedule.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or name of the workforce administrator who last modified this schedule template. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this work schedule template record was last updated. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:WorkSchedule.nercCipPersonnelFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip personnel flag"@en ;
    rdfs:comment "Indicates whether employees on this schedule are subject to NERC CIP personnel risk assessment and training requirements (True) due to access to critical cyber assets, or not subject (False)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_personnel_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP (Critical Infrastructure Protection) Personnel Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional information about the schedule template, including special instructions, exceptions, or historical context. Used for operational guidance and documentation."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:WorkSchedule.offDaysPerCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "off days per cycle"@en ;
    rdfs:comment "Number of scheduled off days within one complete rotation cycle. Used for work-life balance analysis and crew availability planning."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "off_days_per_cycle" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Off Days Per Cycle" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.onCallDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on call duration hours"@en ;
    rdfs:comment "Duration of each on-call period in hours (e.g., 24.00 for 24-hour on-call, 168.00 for week-long on-call). Null if on-call rotation is not applicable."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "on_call_duration_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "On-Call Duration Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:WorkSchedule.onCallFrequencyDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on call frequency days"@en ;
    rdfs:comment "Number of days between on-call assignments in the rotation (e.g., 7 for weekly on-call, 14 for bi-weekly). Null if on-call rotation is not applicable."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "on_call_frequency_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "On-Call Frequency Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.onCallRotationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on call rotation flag"@en ;
    rdfs:comment "Indicates whether this schedule includes on-call rotation periods (True) for emergency response, or does not include on-call duty (False)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "on_call_rotation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "On-Call Rotation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.overtimeCalculationBasis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overtime calculation basis"@en ;
    rdfs:comment "Time period over which overtime hours are calculated: daily (hours beyond threshold per day), weekly (hours beyond threshold per week), biweekly, or pay_period."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "overtime_calculation_basis" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime Calculation Basis" ;
    cmm:validValues "daily|weekly|biweekly|pay_period" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.overtimeEligibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overtime eligibility flag"@en ;
    rdfs:comment "Indicates whether employees on this schedule are eligible for overtime pay under FLSA and union agreements (True) or are exempt (False)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "overtime_eligibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime Eligibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.overtimeThresholdHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overtime threshold hours"@en ;
    rdfs:comment "Number of hours worked in a period (daily or weekly) after which overtime rates apply (e.g., 8.00 for daily OT, 40.00 for weekly OT). Null if not applicable."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "overtime_threshold_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime Threshold Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:WorkSchedule.paidBreakMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "paid break minutes"@en ;
    rdfs:comment "Duration of paid breaks during the shift in minutes. Subset of total break duration. Used for payroll and labor cost calculations."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "paid_break_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Paid Break Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkSchedule.rotationCycleDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rotation cycle days"@en ;
    rdfs:comment "Number of days in the complete rotation cycle before the pattern repeats (e.g., 28 for a 4-week rotation, 7 for weekly rotation). Null for fixed schedules."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "rotation_cycle_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rotation Cycle Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.safetySensitiveFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety sensitive flag"@en ;
    rdfs:comment "Indicates whether this schedule is designated for safety-sensitive positions (True) requiring enhanced OSHA compliance, fatigue management, and drug/alcohol testing, or not safety-sensitive (False)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_sensitive_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety-Sensitive Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.scheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule code"@en ;
    rdfs:comment "Short alphanumeric code uniquely identifying the schedule template in workforce systems (e.g., 'GEN-12HR-ROT', 'ADMIN-STD', 'EMERG-OC')."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WorkSchedule.scheduleName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule name"@en ;
    rdfs:comment "Business name of the work schedule template (e.g., '12-Hour Rotating Shift - Generation', 'Standard M-F Admin', 'On-Call Emergency Response')."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Schedule Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:WorkSchedule.scheduleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule type"@en ;
    rdfs:comment "Classification of the schedule pattern: fixed (same shift daily), rotating (shifts change on cycle), on_call (standby/emergency), flexible (variable hours), or compressed (longer shifts, fewer days)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Type" ;
    cmm:validValues "fixed|rotating|on_call|flexible|compressed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:WorkTimeSchedule.type .
cmm:WorkSchedule.shiftDifferentialEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift differential eligible flag"@en ;
    rdfs:comment "Indicates whether employees on this schedule are eligible for shift differential pay (True) for evening, night, or weekend shifts, or not eligible (False)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "shift_differential_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Differential Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.shiftDifferentialRatePct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift differential rate pct"@en ;
    rdfs:comment "Percentage premium applied to base pay for shift differential (e.g., 10.00 for 10% night shift premium, 15.00 for 15% weekend premium). Null if not applicable."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shift_differential_rate_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Differential Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:WorkSchedule.shiftEndTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift end time"@en ;
    rdfs:comment "Standard end time for the shift in HH:mm format (24-hour clock, e.g., '15:00', '23:00', '07:00'). Represents the conclusion of the work period."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "shift_end_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift End Time" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkSchedule.shiftPattern a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift pattern"@en ;
    rdfs:comment "Standard shift pattern designation: day (morning/daytime), evening (afternoon/evening), night (overnight), swing (alternating day/night), split (two separate periods), continental (rotating 12-hour), dupont (4-crew rotation), panama (2-2-3 pattern). Reference-value candidates: day|evening|night|swing|split|continental|dupont|panama."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_pattern" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Pattern" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.shiftStartTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift start time"@en ;
    rdfs:comment "Standard start time for the shift in HH:mm format (24-hour clock, e.g., '07:00', '15:00', '23:00'). Represents the beginning of the work period."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "shift_start_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Start Time" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkSchedule.shiftsPerDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shifts per day"@en ;
    rdfs:comment "Number of distinct shifts in a 24-hour period under this schedule (e.g., 1 for standard day shift, 3 for 8-hour rotating coverage, 2 for 12-hour rotating)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "shifts_per_day" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shifts Per Day" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.unpaidBreakMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unpaid break minutes"@en ;
    rdfs:comment "Duration of unpaid breaks (typically meal periods) during the shift in minutes. Subset of total break duration. Deducted from compensable hours."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "unpaid_break_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unpaid Break Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkSchedule.weekendWorkFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weekend work flag"@en ;
    rdfs:comment "Indicates whether this schedule includes regular weekend work (True) or is Monday-Friday only (False). Used for shift differential and premium pay calculations."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "weekend_work_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weekend Work Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkSchedule.workDaysPerCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work days per cycle"@en ;
    rdfs:comment "Number of actual work days within one complete rotation cycle. Used to calculate average work hours and staffing levels."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "work_days_per_cycle" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Days Per Cycle" ;
    cmm:cimDatatype "Integer" .
cmm:WorkSchedule.workLocationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location type"@en ;
    rdfs:comment "Primary work location type for employees on this schedule: field (outdoor utility infrastructure), plant (generation facility), control_room (SCADA/EMS/DMS operations center), office (administrative), remote (home-based), hybrid (combination)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_location_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Location Type" ;
    cmm:validValues "field|plant|control_room|office|remote|hybrid" ;
    cmm:cimDatatype "String" .
cmm:WorkSchedule.workScheduleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work schedule status"@en ;
    rdfs:comment "Current lifecycle status of the work schedule template: active (in use), inactive (temporarily suspended), draft (under development), deprecated (phased out but retained for historical reference)."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_schedule_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Status" ;
    cmm:validValues "active|inactive|draft|deprecated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:WorkTimeSchedule.status .
cmm:WorkSchedule.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or name of the workforce administrator who created this schedule template. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:WorkSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:ShiftAssignment a owl:Class ;
    rdfs:label "Shift Assignment"@en ;
    rdfs:comment "Transactional records of individual employee shift assignments against work schedule templates, capturing assigned shift date, shift start/end times, assigned location (plant, substation, service center, control room), shift role, and any schedule deviations (swap, coverage, emergency callout). Supports daily crew scheduling, control room staffing compliance, and generation plant minimum staffing requirements."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Assignment ;
    cmm:cimCloseMatch cim:Assignment ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.shift_assignment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "SAP S/4HANA HCM Time Management" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.shift_assignment" ;
    owl:hasKey ( cmm:ShiftAssignment.shiftAssignmentId ) .

cmm:ShiftAssignment.shiftAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift assignment id"@en ;
    rdfs:comment "Unique identifier for the shift assignment record. Primary key for the shift assignment entity."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "shift_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Shift Assignment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ShiftAssignment.alt5ShiftLastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "alt5 shift last modified by user employee"@en ;
    rdfs:comment "Identifier of the system user who last modified this shift assignment record. Audit field for accountability and change tracking."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "alt5_shift_last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_alt5_shift_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "The cost center to which labor costs for this shift assignment are allocated. Used for financial reporting and departmental budgeting."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_cost_center_id" ;
    cmm:cimAssociation "Assignment.Organisation" .
cmm:ShiftAssignment.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Identifier of the crew or team to which the employee is assigned for this shift. Used for coordinated field work, outage response, and maintenance activities. Nullable for individual assignments."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_crew_id" ;
    cmm:cimAssociation "Assignment.Crew" .
cmm:ShiftAssignment.primaryShiftSwapOriginalEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary shift swap original employee"@en ;
    rdfs:comment "Identifier of the original employee who was initially scheduled for this shift before a swap occurred. Nullable if no swap. Used for shift trade tracking and union compliance."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_shift_swap_original_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Employee Identifier (ID) for Shift Swap" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_primary_shift_swap_original_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.primaryWorkSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary work schedule"@en ;
    rdfs:comment "FK to workforce.work_schedule.work_schedule_id — Shift assignments are instances of work schedule templates. This link enables schedule adherence tracking and overtime calculation based on the applicable schedule pattern."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:WorkSchedule ;
    cmm:physicalColumn "primary_work_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "work_schedule_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_primary_work_schedule_id" ;
    cmm:cimAssociation "Assignment.WorkTimeSchedule" .
cmm:ShiftAssignment.quaternaryShiftScheduledByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "quaternary shift scheduled by user employee"@en ;
    rdfs:comment "Identifier of the system user or scheduler who created this shift assignment. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "quaternary_shift_scheduled_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scheduled By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_quaternary_shift_scheduled_by_user_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.quinaryShiftCancelledByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "quinary shift cancelled by user employee"@en ;
    rdfs:comment "Identifier of the system user who cancelled this shift assignment. Nullable for non-cancelled assignments. Used for audit trail."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "quinary_shift_cancelled_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cancelled By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_quinary_shift_cancelled_by_user_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.shiftEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "shift employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Each shift assignment is for a specific employee. Without this FK, daily staffing rosters cannot be generated and control room minimum staffing compliance cannot be verified."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "shift_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_shift_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.shiftTemplate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "shift template"@en ;
    rdfs:comment "Identifier of the work schedule template that defines the standard shift pattern (e.g., 8-hour day shift, 12-hour night shift, rotating shift). References the shift template master."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:ShiftTemplate ;
    cmm:physicalColumn "shift_template_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Shift Template Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_shift_template_id" ;
    cmm:cimAssociation "Assignment.TimeSchedule" .
cmm:ShiftAssignment.shiftWorkSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "shift work schedule"@en ;
    rdfs:comment "Foreign key linking to workforce.work_schedule. Business justification: shift_assignment currently has shift_template_id (BIGINT) which should reference work_schedule (the master schedule template table). The work_schedule table defines shift patterns, rotation cycles, ho"@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:WorkSchedule ;
    cmm:physicalColumn "shift_work_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_shift_work_schedule_id" ;
    cmm:cimAssociation "Assignment.WorkTimeSchedule" .
cmm:ShiftAssignment.tertiaryShiftSupervisorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary shift supervisor employee"@en ;
    rdfs:comment "Identifier of the supervisor or shift lead responsible for overseeing this employee during the assigned shift. References the employee master record."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_shift_supervisor_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisor Employee Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_tertiary_shift_supervisor_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ShiftAssignment.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the work order or maintenance task that this shift assignment supports. Nullable for general operational shifts. Enables labor cost allocation to specific asset maintenance activities."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_shift_assignment_work_order_id" ;
    cmm:cimAssociation "Assignment.Work" .
cmm:ShiftAssignment.actualClockInTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual clock in timestamp"@en ;
    rdfs:comment "The actual date and time when the employee clocked in or reported for duty at the start of the shift. Used for time and attendance tracking and variance analysis against scheduled start time."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_clock_in_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Clock-In Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.actualClockOutTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual clock out timestamp"@en ;
    rdfs:comment "The actual date and time when the employee clocked out or completed duty at the end of the shift. Used for time and attendance tracking and variance analysis against scheduled end time."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_clock_out_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Clock-Out Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.actualHoursWorked a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual hours worked"@en ;
    rdfs:comment "The actual number of hours the employee worked during this shift, calculated from clock-in and clock-out timestamps. Used for payroll processing and labor cost allocation."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_hours_worked" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Hours Worked" ;
    cmm:cimDatatype "Decimal" .
cmm:ShiftAssignment.assignmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment date"@en ;
    rdfs:comment "The calendar date for which this shift assignment is scheduled. Represents the business day of the shift, not necessarily the clock start time (night shifts may start on prior calendar day)."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Assignment Date" ;
    cmm:cimDatatype "Date" .
cmm:ShiftAssignment.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Current lifecycle status of the shift assignment. Tracks progression from initial scheduling through completion or cancellation."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Shift Assignment Status" ;
    cmm:validValues "scheduled|confirmed|in_progress|completed|cancelled|no_show" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.status .
cmm:ShiftAssignment.assignmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment type"@en ;
    rdfs:comment "Classification of the shift assignment indicating whether it is a regular scheduled shift, overtime, emergency callout, standby duty, or a shift swap/coverage arrangement. Critical for labor cost allocation and union agreement compliance. Reference-value candidates: regular|overtime|emergency_callout|standby|on_call|shift_swap|coverage."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Shift Assignment Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.type .
cmm:ShiftAssignment.breakDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "break duration minutes"@en ;
    rdfs:comment "The total duration of unpaid break time during the shift, in minutes. Used to calculate net working hours and ensure compliance with labor regulations."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "break_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Break Duration in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ShiftAssignment.calloutTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "callout timestamp"@en ;
    rdfs:comment "The date and time when the employee was called out for emergency duty. Nullable for non-emergency assignments. Used to calculate response time and premium pay eligibility."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "callout_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Callout Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text explanation of why the shift assignment was cancelled, if applicable. Nullable for non-cancelled assignments. Used for workforce planning analysis."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:ShiftAssignment.cancelledTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancelled timestamp"@en ;
    rdfs:comment "The date and time when this shift assignment was cancelled. Nullable for non-cancelled assignments. Used for audit trail and schedule change tracking."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cancelled_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.confirmedByEmployeeTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confirmed by employee timestamp"@en ;
    rdfs:comment "The date and time when the employee acknowledged and confirmed acceptance of this shift assignment. Nullable if confirmation is not required or not yet received."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "confirmed_by_employee_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Employee Confirmation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this shift assignment record was first created in the system. Audit field for data lineage and compliance reporting."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Assignment.createdDateTime .
cmm:ShiftAssignment.isEmergencyCallout a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is emergency callout"@en ;
    rdfs:comment "Indicates whether this shift assignment was triggered by an emergency callout (e.g., storm response, unplanned outage, critical equipment failure). Emergency callouts typically carry premium pay rates."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_emergency_callout" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Callout Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ShiftAssignment.isOvertimeEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is overtime eligible"@en ;
    rdfs:comment "Indicates whether this shift assignment qualifies for overtime compensation based on hours worked, employee classification, and union agreement rules."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_overtime_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ShiftAssignment.laborCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor cost amount"@en ;
    rdfs:comment "The total labor cost for this shift assignment, including base pay, overtime premium, and any shift differentials. Used for work order costing and financial analysis."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_cost_amount" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Cost Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ShiftAssignment.laborCostCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the labor cost amount (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "labor_cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Labor Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ShiftAssignment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this shift assignment record was last updated. Audit field for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ShiftAssignment.nercCipRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip required"@en ;
    rdfs:comment "Indicates whether this shift assignment requires NERC CIP personnel risk assessment and background check compliance due to access to critical cyber assets or bulk electric system facilities."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP (Critical Infrastructure Protection) Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ShiftAssignment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments about this shift assignment, such as special instructions, equipment requirements, or schedule deviations. Used for operational communication."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Shift Assignment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ShiftAssignment.responseTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response timestamp"@en ;
    rdfs:comment "The date and time when the employee responded to the emergency callout and reported for duty. Used to measure callout response time compliance."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "response_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Callout Response Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.safetyCertificationVerified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety certification verified"@en ;
    rdfs:comment "Indicates whether the employee's required safety certifications (e.g., OSHA training, arc flash, confined space, high voltage) have been verified as current and valid for this shift assignment."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_certification_verified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Certification Verified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ShiftAssignment.scheduledTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled timestamp"@en ;
    rdfs:comment "The date and time when this shift assignment was created in the scheduling system. Audit field for tracking when the assignment was made."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.shiftDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift duration hours"@en ;
    rdfs:comment "The total scheduled duration of the shift in hours, including any built-in break periods. Supports labor cost allocation and OSHA compliance for maximum shift length."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shift_duration_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Duration in Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:ShiftAssignment.shiftEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift end timestamp"@en ;
    rdfs:comment "The actual date and time when the employee's shift is scheduled to end, including time zone. Used to calculate shift duration and ensure minimum staffing coverage."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "shift_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.shiftRoleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift role code"@en ;
    rdfs:comment "Code representing the functional role the employee performs during this shift (e.g., LINEMAN, OPERATOR, DISPATCHER, ENGINEER, METER_READER, SUPERVISOR). Used for skill-based scheduling and NERC CIP personnel risk assessment compliance."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_role_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Role Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,20}$" ;
    cmm:cimDatatype "String" .
cmm:ShiftAssignment.shiftRoleDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift role description"@en ;
    rdfs:comment "Human-readable description of the shift role, providing context for the functional responsibilities during this assignment."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_role_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Role Description" ;
    cmm:cimDatatype "String" .
cmm:ShiftAssignment.shiftStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift start timestamp"@en ;
    rdfs:comment "The actual date and time when the employee's shift is scheduled to begin, including time zone. Used for precise crew scheduling and control room staffing compliance."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "shift_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.shiftSwapApprovalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift swap approval timestamp"@en ;
    rdfs:comment "The date and time when the shift swap was approved by the supervisor or scheduling system. Nullable if no swap occurred."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "shift_swap_approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Swap Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ShiftAssignment.unionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union code"@en ;
    rdfs:comment "Code representing the labor union to which the employee belongs, if applicable. Used to ensure shift assignment complies with union collective bargaining agreement rules (e.g., seniority, overtime rotation, shift bidding)."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:ShiftAssignment.workLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location code"@en ;
    rdfs:comment "Identifier of the physical work location where the employee is assigned for this shift (e.g., power plant, substation, service center, control room, field territory). References the location master."@en ;
    rdfs:domain cmm:ShiftAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_location_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Location Identifier (ID)" ;
    cmm:cimDatatype "Integer" .

cmm:TimeEntry a owl:Class ;
    rdfs:label "Time Entry"@en ;
    rdfs:comment "SSOT for employee and contractor time, attendance, and labor cost allocation records. Captures actual hours worked per day including regular, overtime, double-time, on-call, storm duty, leave, and travel time. Records work date, employee or contractor worker, cost object (work order, cost center, project, WBS element), activity type, pay type, labor rate, total cost, capitalization vs O&M expense classification, approval status, and payroll period. Supports labor cost allocation to asset maintenance work orders, capital construction projects, outage restoration events, demand response program delivery, and overhead cost centers. Feeds SAP S/4HANA plant maintenance and project accounting for CAPEX/OPEX reporting. Also supports FMLA leave tracking, leave balance management, DOT hours-of-service compliance for CDL positions, and union overtime compliance verification."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpTimeEntry ;
    cmm:cimExactMatch cim:ErpTimeEntry ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.cost_allocation ;
    cmm:physicalTable "utility_cmm_silver.workforce.time_entry" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP S/4HANA HCM CATS (Cross-Application Time Sheet)" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.time_entry" ;
    owl:hasKey ( cmm:TimeEntry.timeEntryId ) .

cmm:TimeEntry.timeEntryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time entry id"@en ;
    rdfs:comment "Unique identifier for the time entry record. Primary key for the time entry data product."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:long ;
    cmm:physicalColumn "time_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Time Entry ID" ;
    cmm:cimDatatype "Integer" .
cmm:TimeEntry.contractorWorker a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor worker"@en ;
    rdfs:comment "FK to workforce.contractor_worker.contractor_worker_id — Time entries also capture contractor hours. Required for contractor labor cost allocation and invoice reconciliation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:ContractorWorker ;
    cmm:physicalColumn "contractor_worker_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_contractor_worker_id" ;
    cmm:cimAssociation "ErpTimeEntry.Person" .
cmm:TimeEntry.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "The organizational cost center to which this labor time is charged. Used for overhead and indirect labor cost allocation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_cost_center_id" ;
    cmm:cimAssociation "ErpTimeEntry.Organisation" .
cmm:TimeEntry.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Identifier for the field crew or work team to which the employee was assigned during this time entry. Used for crew-based scheduling and dispatch."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_crew_id" ;
    cmm:cimAssociation "ErpTimeEntry.Crew" .
cmm:TimeEntry.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Time entries must reference the employee who worked the hours. Core FK for payroll, labor cost allocation, and overtime compliance."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_employee_id" ;
    cmm:cimAssociation "ErpTimeEntry.ErpPersonnel" .
cmm:TimeEntry.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Identifier for the grid outage or storm restoration event to which this labor time is allocated. Used for outage cost tracking and SAIDI/SAIFI reporting."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_event_id" ;
    cmm:cimAssociation "ErpTimeEntry.Outage" .
cmm:TimeEntry.payrollPeriod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payroll period"@en ;
    rdfs:comment "Identifier for the payroll period to which this time entry belongs. Links to payroll processing cycle."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:PayrollPeriod ;
    cmm:physicalColumn "payroll_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payroll Period ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_payroll_period_id" ;
    cmm:cimAssociation "ErpTimeEntry.TimeSchedule" .
cmm:TimeEntry.payrollRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payroll run"@en ;
    rdfs:comment "Identifier for the specific payroll run that processed this time entry. Used for payroll reconciliation and audit."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:PayrollRun ;
    cmm:physicalColumn "payroll_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payroll Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_payroll_run_id" ;
    cmm:cimAssociation "ErpTimeEntry.ActivityRecord" .
cmm:TimeEntry.primaryTimeEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary time employee"@en ;
    rdfs:comment "Unique identifier for the employee or contractor worker who recorded this time entry. Links to workforce employee registry."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_time_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_primary_time_employee_id" ;
    cmm:cimAssociation "ErpTimeEntry.ErpPersonnel" .
cmm:TimeEntry.project a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "project"@en ;
    rdfs:comment "Identifier for the capital construction project or program to which this labor time is allocated. Used for capital project cost tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project ID" ;
    cmm:sourceColumn "capital_project_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_project_id" ;
    cmm:cimAssociation "ErpTimeEntry.Project" .
cmm:TimeEntry.tertiaryTimeModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary time modified by user employee"@en ;
    rdfs:comment "User identifier of the person who last modified this time entry record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_time_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_tertiary_time_modified_by_user_employee_id" ;
    cmm:cimAssociation "ErpTimeEntry.ErpPersonnel" .
cmm:TimeEntry.timeEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "time employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Every time entry belongs to an employee. This is the fundamental payroll and cost allocation relationship. Without it, labor costs cannot be allocated and paychecks cannot be generated."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "time_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_time_employee_id" ;
    cmm:cimAssociation "ErpTimeEntry.ErpPersonnel" .
cmm:TimeEntry.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier for the asset maintenance or construction work order to which this labor time is allocated. Used for CAPEX/OPEX cost allocation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_time_entry_work_order_id" ;
    cmm:cimAssociation "ErpTimeEntry.Work" .
cmm:TimeEntry.activityDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "activity description"@en ;
    rdfs:comment "Detailed narrative description of the work activity performed during this time entry. Provides context for labor allocation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "activity_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Activity Description" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.activityTypeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "activity type code"@en ;
    rdfs:comment "Classification code for the type of work activity performed (e.g., installation, repair, inspection, patrol, engineering, administrative)."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "activity_type_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Activity Type Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current approval workflow status of the time entry. Tracks progression from draft through supervisor approval to payroll posting."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "draft|submitted|approved|rejected|posted" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the time entry was approved by the supervisor. Used for audit trail and compliance reporting."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TimeEntry.capitalizationIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization indicator"@en ;
    rdfs:comment "Flag indicating whether this labor cost is capitalized (CAPEX) or expensed (OPEX). True for capital projects, false for O&M work."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "capitalization_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Free-text comments or notes entered by the employee or supervisor regarding this time entry. Provides additional context for time allocation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:TimeEntry.contractorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor flag"@en ;
    rdfs:comment "Indicates whether this time entry is for a contractor worker rather than a direct employee. Used for contractor labor cost tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contractor_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contractor Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this time entry record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpTimeEntry.createdDateTime .
cmm:TimeEntry.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for labor cost amount (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:TimeEntry.dotRegulatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dot regulated flag"@en ;
    rdfs:comment "Indicates whether this time entry is subject to DOT hours-of-service regulations for commercial driver license (CDL) positions. Used for compliance tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dot_regulated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Transportation (DOT) Regulated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.expenseType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expense type"@en ;
    rdfs:comment "Classification of the expense type for financial reporting. Distinguishes between capital expenditure, operational expenditure, overhead, and indirect costs."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "expense_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expense Type" ;
    cmm:validValues "capex|opex|overhead|indirect" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.fmlaQualifyingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fmla qualifying flag"@en ;
    rdfs:comment "Indicates whether this leave time entry qualifies under FMLA regulations. Used for FMLA leave tracking and compliance reporting."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "fmla_qualifying_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Family and Medical Leave Act (FMLA) Qualifying Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.hoursWorked a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hours worked"@en ;
    rdfs:comment "Total number of hours worked or leave hours taken for this time entry. Supports fractional hours (e.g., 7.5 hours)."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hours_worked" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hours Worked" ;
    cmm:cimDatatype "Decimal" .
cmm:TimeEntry.jobClassificationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "job classification code"@en ;
    rdfs:comment "Code identifying the job classification or craft for this time entry (e.g., lineman, electrician, engineer, dispatcher). Used for labor rate determination."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "job_classification_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Job Classification Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.laborCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor cost amount"@en ;
    rdfs:comment "Total labor cost for this time entry, calculated as hours worked multiplied by labor rate. Includes burden and overhead allocation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_cost_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Cost Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TimeEntry.laborRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor rate"@en ;
    rdfs:comment "The hourly labor rate applied to this time entry, including any overtime or premium multipliers. Used for labor cost calculation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_rate" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Rate" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:TimeEntry.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this time entry record was last updated. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:TimeEntry.leaveBalanceImpact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "leave balance impact"@en ;
    rdfs:comment "The number of leave hours deducted from or accrued to the employee's leave balance as a result of this time entry. Negative for leave taken, positive for accrual."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "leave_balance_impact" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Leave Balance Impact" ;
    cmm:cimDatatype "Decimal" .
cmm:TimeEntry.locationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location code"@en ;
    rdfs:comment "Code identifying the work location or facility where the work was performed. Used for geographic labor cost analysis."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Location Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.nercCipWorkFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip work flag"@en ;
    rdfs:comment "Indicates whether this time entry involves work on NERC CIP-designated critical cyber assets or bulk electric system facilities. Used for personnel risk assessment compliance."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_work_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Critical Infrastructure Protection (CIP) Work Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.oshaRecordableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha recordable flag"@en ;
    rdfs:comment "Indicates whether this time entry is associated with an OSHA recordable injury or illness event. Used for safety compliance reporting."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_recordable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Occupational Safety and Health Administration (OSHA) Recordable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.overtimeEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overtime eligible flag"@en ;
    rdfs:comment "Indicates whether the employee is eligible for overtime pay under FLSA or union contract rules. True for non-exempt employees, false for exempt."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "overtime_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.payTypeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pay type code"@en ;
    rdfs:comment "Classification of the pay type for this time entry. Determines wage rate multiplier and leave balance impact. Supports union overtime compliance and DOT hours-of-service tracking. Reference-value candidates: regular|overtime|double_time|on_call|storm_duty|holiday|sick_leave|vacation|fmla|bereavement|jury_duty|training|travel."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "pay_type_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pay Type Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.shiftCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift code"@en ;
    rdfs:comment "Code identifying the work shift during which this time was worked (e.g., day shift, night shift, rotating shift). Used for shift differential pay calculation."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the source system from which this time entry was captured (e.g., SAP Time Management, mobile time entry app, badge reader)."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.timeEntryNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time entry number"@en ;
    rdfs:comment "Human-readable business identifier for the time entry record, typically generated by the time and attendance system."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "time_entry_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time Entry Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TimeEntry.timeForEmployee a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time for employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Time entries record hours worked by an employee. This FK is essential for payroll processing, labor cost allocation, and overtime compliance verification."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:long ;
    cmm:physicalColumn "time_for_employee" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:TimeEntry.travelTimeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "travel time flag"@en ;
    rdfs:comment "Indicates whether this time entry represents travel time rather than direct work time. Used for travel time pay policy compliance."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "travel_time_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Travel Time Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TimeEntry.unionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union code"@en ;
    rdfs:comment "Code identifying the labor union to which the employee belongs. Used for union contract compliance and overtime rule enforcement."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Code" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "The specific WBS element within a project hierarchy to which this labor time is allocated. Enables detailed project cost tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .
cmm:TimeEntry.workDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work date"@en ;
    rdfs:comment "The calendar date on which the work was performed. Principal business event timestamp for labor time tracking."@en ;
    rdfs:domain cmm:TimeEntry ; rdfs:range xsd:date ;
    cmm:physicalColumn "work_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Date" ;
    cmm:cimDatatype "Date" .

cmm:LeaveRequest a owl:Class ;
    rdfs:label "Leave Request"@en ;
    rdfs:comment "Employee leave requests and approved absences including vacation, sick leave, FMLA, military leave, bereavement, and union-negotiated personal days. Captures leave type, requested start/end dates, approved dates, approving supervisor, leave balance consumed, FMLA eligibility flag, and impact on minimum staffing levels. Integrates with shift scheduling to flag coverage gaps for critical operational roles (control room operators, plant operators)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Request ;
    cmm:cimExtends cim:Request ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.leave_request" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "SAP S/4HANA HCM Absence Management; FMLA 29 CFR Part 825" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.leave_request" ;
    owl:hasKey ( cmm:LeaveRequest.leaveRequestId ) .

cmm:LeaveRequest.leaveRequestId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "leave request id"@en ;
    rdfs:comment "Unique identifier for the leave request record. Primary key."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:long ;
    cmm:physicalColumn "leave_request_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Leave Request ID" ;
    cmm:cimDatatype "Integer" .
cmm:LeaveRequest.leaveEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "leave employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Leave requests are per-employee. FK required for leave balance management, FMLA tracking, and staffing gap analysis."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "leave_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_leave_request_leave_employee_id" ;
    cmm:cimAssociation "Request.ErpPersonnel" .
cmm:LeaveRequest.primaryLeaveEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary leave employee"@en ;
    rdfs:comment "Identifier of the employee submitting the leave request. Links to the employee master record in the workforce domain."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_leave_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_leave_request_primary_leave_employee_id" ;
    cmm:cimAssociation "Request.ErpPersonnel" .
cmm:LeaveRequest.tertiaryLeaveCoverageEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary leave coverage employee"@en ;
    rdfs:comment "Identifier of the employee assigned to cover the absent employee duties during the leave period. Links to employee master record."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_leave_coverage_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Coverage Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_leave_request_tertiary_leave_coverage_employee_id" ;
    cmm:cimAssociation "Request.ErpPersonnel" .
cmm:LeaveRequest.workSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work schedule"@en ;
    rdfs:comment "Identifier of the shift schedule affected by this leave request. Used to flag coverage gaps for shift-based operational roles."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range cmm:WorkSchedule ;
    cmm:physicalColumn "work_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Shift Schedule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_leave_request_work_schedule_id" ;
    cmm:cimAssociation "Request.WorkTimeSchedule" .
cmm:LeaveRequest.approvalComments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval comments"@en ;
    rdfs:comment "Free-text comments entered by the approving supervisor explaining the approval decision, conditions, or denial reason."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Approval Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:LeaveRequest.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the leave request was approved or denied by the supervisor."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LeaveRequest.approvedDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved duration hours"@en ;
    rdfs:comment "Total number of work hours approved for absence, calculated from approved start and end dates. Used to decrement leave balance."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_duration_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Duration Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LeaveRequest.approvedEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved end date"@en ;
    rdfs:comment "The last calendar date of absence as approved by the supervisor. May differ from requested end date if partial approval granted."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "approved_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved End Date" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.approvedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved start date"@en ;
    rdfs:comment "The first calendar date of absence as approved by the supervisor. May differ from requested start date if partial approval granted."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "approved_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Start Date" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.coveragePlanRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "coverage plan required"@en ;
    rdfs:comment "Flag indicating whether a formal coverage plan must be documented before this leave can be approved, typically for critical roles or extended absences."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "coverage_plan_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Coverage Plan Required Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the leave request record was first created in the system, typically when the employee began drafting the request."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Request.createdDateTime .
cmm:LeaveRequest.criticalRoleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical role flag"@en ;
    rdfs:comment "Indicates whether the employee requesting leave holds a critical operational role (control room operator, plant operator, dispatcher, NERC CIP personnel) requiring special staffing considerations and coverage planning."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_role_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Role Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.denialReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "denial reason code"@en ;
    rdfs:comment "Standardized code indicating why the leave request was denied: insufficient_staffing (minimum crew requirements not met), insufficient_balance (employee lacks accrued leave), business_need (critical operational period), policy_violation (does not meet policy requirements), documentation_missing (required medical certification not provided), other (see comments)."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "denial_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Denial Reason Code" ;
    cmm:validValues "insufficient_staffing|insufficient_balance|business_need|policy_violation|documentation_missing|other" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.fmlaCaseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fmla case number"@en ;
    rdfs:comment "Unique case identifier assigned to track FMLA-protected leave for compliance reporting. Populated only when is_fmla_eligible is true."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "fmla_case_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "FMLA (Family and Medical Leave Act) Case Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:LeaveRequest.impactsMinimumStaffing a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impacts minimum staffing"@en ;
    rdfs:comment "Flag indicating whether approving this leave would cause staffing levels to fall below the minimum required for safe operations in critical roles such as control room operators, plant operators, or NERC CIP-designated positions."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "impacts_minimum_staffing" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impacts Minimum Staffing Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.intermittentLeaveFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intermittent leave flag"@en ;
    rdfs:comment "Indicates whether this is intermittent leave (true) taken in separate blocks of time rather than one continuous period (false). Common for FMLA medical treatment schedules."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "intermittent_leave_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Intermittent Leave Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.isFmlaEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is fmla eligible"@en ;
    rdfs:comment "Flag indicating whether this leave qualifies for FMLA protection (true) or not (false). FMLA provides job-protected unpaid leave for qualifying medical and family reasons."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_fmla_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FMLA (Family and Medical Leave Act) Eligible Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.isPaidLeave a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is paid leave"@en ;
    rdfs:comment "Flag indicating whether this leave is paid (true) or unpaid (false). Determines payroll processing and leave balance consumption."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_paid_leave" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Paid Leave Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the leave request record was last updated, capturing any changes to dates, status, or approval information."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:LeaveRequest.leaveBalanceConsumedHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "leave balance consumed hours"@en ;
    rdfs:comment "Number of hours deducted from the employee leave balance accrual for this approved absence. May differ from approved duration if unpaid leave or partial pay applies."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "leave_balance_consumed_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Leave Balance Consumed Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LeaveRequest.leaveSubtype a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "leave subtype"@en ;
    rdfs:comment "Detailed classification within the leave type, such as FMLA continuous vs intermittent, sick personal vs sick family care, or military active duty vs reserve training."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "leave_subtype" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Leave Subtype" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.leaveType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "leave type"@en ;
    rdfs:comment "Category of leave being requested: vacation (paid time off), sick (illness or medical appointments), FMLA (Family and Medical Leave Act protected leave), military (active duty or reserve training), bereavement (death of family member), personal (union-negotiated personal days)."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "leave_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Leave Type" ;
    cmm:validValues "vacation|sick|fmla|military|bereavement|personal" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.type .
cmm:LeaveRequest.medicalCertificationReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical certification received date"@en ;
    rdfs:comment "Date when required medical certification documentation was received by HR, if applicable."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "medical_certification_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Certification Received Date" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.medicalCertificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical certification required"@en ;
    rdfs:comment "Flag indicating whether medical certification documentation is required to support this leave request, typically for FMLA or extended sick leave."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "medical_certification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Certification Required Indicator" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.oshaRecordableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha recordable flag"@en ;
    rdfs:comment "Indicates whether this leave is related to an OSHA recordable workplace injury or illness requiring compliance reporting."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_recordable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSHA (Occupational Safety and Health Administration) Recordable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.payrollIntegrationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payroll integration status"@en ;
    rdfs:comment "Status of integration with payroll system to process leave pay or unpaid time: pending (awaiting transmission), sent (transmitted to payroll), confirmed (acknowledged by payroll), error (integration failure requiring manual intervention)."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "payroll_integration_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payroll Integration Status" ;
    cmm:validValues "pending|sent|confirmed|error" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.reasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason description"@en ;
    rdfs:comment "Free-text explanation provided by the employee describing the reason for the leave request. May contain sensitive medical or personal information."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Leave Reason Description" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.requestNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request number"@en ;
    rdfs:comment "Human-readable business identifier for the leave request, typically system-generated in format LR-YYYYNNNN."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Leave Request Number" ;
    cmm:valuePattern "^LR-[0-9]{8}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:LeaveRequest.requestStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request status"@en ;
    rdfs:comment "Current lifecycle state of the leave request: draft (employee is composing), submitted (sent to supervisor), pending_approval (awaiting manager decision), approved (authorized for absence), denied (rejected by supervisor), cancelled (system-cancelled due to business rule), withdrawn (employee retracted before approval). Reference-value candidates: draft|submitted|pending_approval|approved|denied|cancelled|withdrawn."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Leave Request Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.status .
cmm:LeaveRequest.requestedDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested duration hours"@en ;
    rdfs:comment "Total number of work hours the employee is requesting to be absent, calculated from requested start and end dates based on employee work schedule."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_duration_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Duration Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LeaveRequest.requestedEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested end date"@en ;
    rdfs:comment "The last calendar date the employee intends to be absent, as originally requested. Inclusive end date."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "requested_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested End Date" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.requestedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested start date"@en ;
    rdfs:comment "The first calendar date the employee intends to be absent, as originally requested."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "requested_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Start Date" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.returnToWorkCertificationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return to work certification flag"@en ;
    rdfs:comment "Indicates whether a return-to-work medical clearance is required before the employee can resume duties, typically for extended medical leave or OSHA recordable injuries."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "return_to_work_certification_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return to Work Certification Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.returnToWorkDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return to work date"@en ;
    rdfs:comment "Actual date the employee returned to work following the leave period. Used for attendance tracking and leave reconciliation."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "return_to_work_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return to Work Date" ;
    cmm:cimDatatype "Date" .
cmm:LeaveRequest.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the operational system from which this leave request record originated, typically SAP S/4HANA HCM or a self-service portal."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Unique identifier of this leave request in the source operational system, used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System ID" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.submittedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "submitted timestamp"@en ;
    rdfs:comment "Date and time when the employee submitted the leave request for supervisor approval."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "submitted_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Submitted Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LeaveRequest.unionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union code"@en ;
    rdfs:comment "Code identifying the labor union to which the employee belongs, if applicable. Union membership may affect leave entitlements, approval rules, and personal day allocations per collective bargaining agreement."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Code" ;
    cmm:cimDatatype "String" .
cmm:LeaveRequest.workOrderImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order impact flag"@en ;
    rdfs:comment "Indicates whether this leave affects scheduled work orders or maintenance activities assigned to the employee, requiring crew reassignment."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "work_order_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Order Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LeaveRequest.workersCompClaimNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "workers comp claim number"@en ;
    rdfs:comment "Workers compensation insurance claim number if this leave is related to a workplace injury or occupational illness."@en ;
    rdfs:domain cmm:LeaveRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "workers_comp_claim_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Workers Compensation Claim Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:ContractorWorker a owl:Class ;
    rdfs:label "Contractor Worker"@en ;
    rdfs:comment "Master records for contractor and contingent workforce personnel engaged by the utility for capital construction projects, storm restoration mutual aid, specialized maintenance (e.g., turbine overhauls, relay testing), and supplemental operations staffing. Captures contractor company name, worker identity, trade classification, contract reference, daily rate or hourly rate, site access authorization status, NERC CIP PRA status for CIP-applicable contractors, background check completion, safety orientation date, required PPE certifications, and active engagement period. Distinct from employees — contractor workers are not on utility payroll but are subject to the same safety, access, and certification requirements on utility property."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Person ;
    cmm:cimCloseMatch cim:Person ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.contractor_worker" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC CIP-004 R3 Contractor Personnel Risk Assessment; Ventyx Asset Suite Contractor Management" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.contractor_worker" ;
    owl:hasKey ( cmm:ContractorWorker.contractorWorkerId ) .

cmm:ContractorWorker.contractorWorkerId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor worker id"@en ;
    rdfs:comment "Unique identifier for the contractor worker record. Primary key for the contractor_worker product."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:long ;
    cmm:physicalColumn "contractor_worker_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contractor Worker ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContractorWorker.contractorCompany a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor company"@en ;
    rdfs:comment "Reference to the contractor company that employs or dispatches this worker. Links to the contractor company master record."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:ContractorCompany ;
    cmm:physicalColumn "contractor_company_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contractor Company ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_contractor_company_id" ;
    cmm:cimAssociation "Person.Organisation" .
cmm:ContractorWorker.contractorCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor crew"@en ;
    rdfs:comment "Foreign key linking to workforce.crew. Business justification: Contractor workers assigned to utility crews for storm response and mutual aid. Linking enables mixed crew composition tracking, labor cost allocation, and contractor safety oversight."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "contractor_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Id (Foreign Key)" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_contractor_crew_id" ;
    cmm:cimAssociation "Person.Crew" .
cmm:ContractorWorker.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Contractor labor costs must be allocated to cost centers for financial tracking, budget management, and rate case support. New FK needed as no existing cost_center reference exists."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_cost_center_id" ;
    cmm:cimAssociation "Person.Organisation" .
cmm:ContractorWorker.nercCipAccess a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip access"@en ;
    rdfs:comment "FK to workforce.nerc_cip_access.nerc_cip_access_id — Contractors working at CIP facilities require NERC CIP access authorization. FK needed for CIP-004 compliance — contractors are subject to same PRA and access control requirements."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:NercCipAccess ;
    cmm:physicalColumn "nerc_cip_access_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_nerc_cip_access_id" ;
    cmm:cimAssociation "Person.Agreement" .
cmm:ContractorWorker.primaryCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary crew"@en ;
    rdfs:comment "FK to workforce.crew.crew_id — Contractor workers are often assigned to crews for storm restoration and capital construction. This link enables mixed crew composition tracking (utility employees + contractors) which is critical for"@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "primary_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_primary_crew_id" ;
    cmm:cimAssociation "Person.Crew" .
cmm:ContractorWorker.supervisorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "supervisor employee"@en ;
    rdfs:comment "Employee ID of the utility employee who supervises or coordinates the work of this contractor worker. Links to the employee master record."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "supervisor_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisor Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_contractor_worker_supervisor_employee_id" ;
    cmm:cimAssociation "Person.ErpPersonnel" .
cmm:ContractorWorker.arcFlashTrainingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arc flash training date"@en ;
    rdfs:comment "Date on which the contractor worker completed arc flash hazard awareness and PPE training required for work on energized electrical equipment."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "arc_flash_training_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arc Flash Training Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.backgroundCheckCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "background check completion date"@en ;
    rdfs:comment "Date on which the background check was completed for this contractor worker. Null if not required or not yet completed."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "background_check_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Background Check Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.backgroundCheckStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "background check status"@en ;
    rdfs:comment "Status of criminal and employment background check for the contractor worker (cleared, pending, failed, not_required, expired)."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "background_check_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Background Check Status" ;
    cmm:validValues "cleared|pending|failed|not_required|expired" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.cdlExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cdl expiration date"@en ;
    rdfs:comment "Expiration date of the contractor worker's Commercial Driver License. Null if CDL not held."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "cdl_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Driver License (CDL) Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.cdlLicenseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cdl license number"@en ;
    rdfs:comment "Commercial Driver License number for contractor workers authorized to operate utility vehicles and heavy equipment. Null if CDL not required for role."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "cdl_license_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commercial Driver License (CDL) Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ContractorWorker.confinedSpaceCertificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confined space certification date"@en ;
    rdfs:comment "Date on which the contractor worker completed confined space entry training and certification required for work in vaults, manholes, and other permit-required confined spaces."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "confined_space_certification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confined Space Entry Certification Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.contractReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract reference number"@en ;
    rdfs:comment "Reference number of the master service agreement or purchase order under which this contractor worker is engaged by the utility."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ContractorWorker.cprFirstAidCertificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpr first aid certification date"@en ;
    rdfs:comment "Date on which the contractor worker completed CPR and first aid certification. Required for field crew members working in remote locations."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "cpr_first_aid_certification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CPR and First Aid Certification Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this contractor worker record was first created in the system."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Person.createdDateTime .
cmm:ContractorWorker.dailyRateUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "daily rate usd"@en ;
    rdfs:comment "Daily billing rate in US Dollars for the contractor worker if compensated on a per-diem basis. Null if hourly rate applies."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "daily_rate_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Daily Rate (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ContractorWorker.drugTestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drug test date"@en ;
    rdfs:comment "Date on which the most recent drug and alcohol test was administered to the contractor worker."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:date ;
    cmm:physicalColumn "drug_test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Drug Test Date" ;
    cmm:cimDatatype "Date" .
cmm:ContractorWorker.drugTestStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "drug test status"@en ;
    rdfs:comment "Status of pre-employment or random drug and alcohol screening for the contractor worker (passed, failed, pending, not_required, expired)."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "drug_test_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Drug Test Status" ;
    cmm:validValues "passed|failed|pending|not_required|expired" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.emergencyContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency contact name"@en ;
    rdfs:comment "Full name of the emergency contact person for the contractor worker in case of workplace injury or incident."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Contact Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_name" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.emergencyContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency contact phone"@en ;
    rdfs:comment "Phone number of the emergency contact person for the contractor worker."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emergency Contact Phone Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:ContractorWorker.emergencyContactRelationship a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency contact relationship"@en ;
    rdfs:comment "Relationship of the emergency contact person to the contractor worker (e.g., spouse, parent, sibling, friend)."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_contact_relationship" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
