    cmm:cimDatatype "CurrentFlow" .
cmm:SectionalizingDevice.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent preventive or corrective maintenance activity. Used for maintenance interval tracking and compliance reporting."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:SectionalizingDevice.lastOperationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last operation timestamp"@en ;
    rdfs:comment "Date and time of the most recent switching operation. Used for operational history tracking and maintenance planning."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_operation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Operation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SectionalizingDevice.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this device record was most recently modified. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SectionalizingDevice.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the device location in decimal degrees. Used for GIS mapping, outage visualization, and crew dispatch optimization."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:SectionalizingDevice.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the device location in decimal degrees. Used for GIS mapping, outage visualization, and crew dispatch optimization."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:SectionalizingDevice.nextMaintenanceDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next maintenance due date"@en ;
    rdfs:comment "Scheduled date for the next preventive maintenance activity. Calculated based on manufacturer recommendations and utility maintenance standards."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_maintenance_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Maintenance Due Date" ;
    cmm:cimDatatype "Date" .
cmm:SectionalizingDevice.normalPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal position"@en ;
    rdfs:comment "Normal operating position of the switching device under standard network configuration. Used for network restoration and switching order generation."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "normal_position" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Position" ;
    cmm:validValues "open|closed|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional operational notes, special instructions, or historical information about the device."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:SectionalizingDevice.numberOfOperations a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of operations"@en ;
    rdfs:comment "Cumulative count of switching operations performed by the device. Used for maintenance scheduling and end-of-life prediction."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_operations" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Operations" ;
    cmm:cimDatatype "Integer" .
cmm:SectionalizingDevice.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the device in the distribution network. Determines whether device is available for protection and switching operations."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|testing|maintenance|retired|planned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ProtectedSwitch.status .
cmm:SectionalizingDevice.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Legal ownership classification of the device. Determines maintenance responsibility and cost allocation."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|third_party_owned|joint_owned" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration of the device. Determines which phases are controlled or protected by this device. Reference-value candidates: three_phase|single_phase_a|single_phase_b|single_phase_c|two_phase_ab|two_phase_bc|two_phase_ac."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.poleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pole code"@en ;
    rdfs:comment "Identifier of the utility pole where the device is mounted, if applicable. Used for pole loading analysis and joint-use coordination."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "pole_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pole ID" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.protectionZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection zone"@en ;
    rdfs:comment "Protection coordination zone designation. Used for relay coordination studies and fault isolation logic."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Zone" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.ratedContinuousCurrentAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated continuous current amps"@en ;
    rdfs:comment "Maximum continuous current rating of the device in amperes. Determines load-carrying capacity and thermal limits."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_continuous_current_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Continuous Current (Amps)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:SectionalizingDevice.ratedVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated voltage kv"@en ;
    rdfs:comment "Maximum system voltage rating of the device in kilovolts. Must match or exceed the nominal voltage of the distribution circuit where installed."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rated Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:SectionalizingDevice.regulatoryAssetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset flag"@en ;
    rdfs:comment "Indicates whether this device is included in the Regulatory Asset Base (RAB) for rate recovery purposes. Used for regulatory reporting and rate case preparation."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_asset_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SectionalizingDevice.scadaPointReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada point reference"@en ;
    rdfs:comment "Reference identifier linking this device to its SCADA point in the Energy Management System or Distribution Management System. Used for real-time monitoring and remote control."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_point_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Point Reference" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by manufacturer. Used for warranty claims, recall tracking, and individual device history."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:SectionalizingDevice.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when manufacturer warranty coverage expires. Used for warranty claim eligibility and replacement cost planning."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:ServiceDrop a owl:Class ;
    rdfs:label "Service Drop"@en ;
    rdfs:comment "Master record for the last-mile service connection from the distribution secondary network to a customer premises. Captures service drop identifier, conductor type and size, service voltage (120/240V single-phase or 120/208V three-phase), meter point reference, pole or transformer association, GIS coordinates, installation date, service class (residential/commercial/industrial), and connection status. SSOT for the physical last-mile connection linking the distribution network to the customer metering point. Essential for outage impact assessment and service restoration prioritization."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ACLineSegment ;
    cmm:cimCloseMatch cim:ACLineSegment ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.service_drop" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13; IEC CIM EnergyConsumer / Esri ArcGIS Utility Network ServicePoint" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.service_drop" ;
    owl:hasKey ( cmm:ServiceDrop.serviceDropId ) .

cmm:ServiceDrop.serviceDropId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service drop id"@en ;
    rdfs:comment "Unique identifier for the service drop connection. Primary key for the service drop master record."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_drop_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Service Drop Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceDrop.conductorMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "conductor material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Service drops use standardized conductor materials requiring material master linkage for new service installation planning, emergency restoration inventory, and conductor standardization programs. Rol"@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "conductor_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Conductor Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_conductor_material_master_id" ;
    cmm:cimAssociation "ACLineSegment.ErpItemMaster" .
cmm:ServiceDrop.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Reference to the active customer service agreement governing this service drop connection."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_customer_service_agreement_id" ;
    cmm:cimAssociation "ACLineSegment.CustomerAgreement" .
cmm:ServiceDrop.fromTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "from transformer"@en ;
    rdfs:comment "FK to distribution.transformer.transformer_id — Service drops connect to distribution transformers. This FK is essential for outage impact assessment (transformer outage → which service drops/customers affected) and voltage complaint investigation."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "from_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_from_transformer_id" ;
    cmm:cimAssociation "ACLineSegment.PowerTransformer" .
cmm:ServiceDrop.installerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "installer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Service drops track the installing technician for quality assurance, warranty claims, safety compliance verification, and accountability. Standard field practice for new construction, service upgrades"@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "installer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_installer_employee_id" ;
    cmm:cimAssociation "ACLineSegment.ErpPersonnel" .
cmm:ServiceDrop.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Reference to the metering point where this service drop terminates at the customer premise."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_meter_point_id" ;
    cmm:cimAssociation "ACLineSegment.UsagePoint" .
cmm:ServiceDrop.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "Reference to the secondary distribution network segment from which this service drop is fed."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Secondary Network Segment Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_network_segment_id" ;
    cmm:cimAssociation "ACLineSegment.EquipmentContainer" .
cmm:ServiceDrop.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the customer premise served by this service drop."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_premise_id" ;
    cmm:cimAssociation "ACLineSegment.ServiceLocation" .
cmm:ServiceDrop.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "FK to distribution.service_territory"@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_service_territory_id" ;
    cmm:cimAssociation "ACLineSegment.SubGeographicalRegion" .
cmm:ServiceDrop.serviceTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service transformer"@en ;
    rdfs:comment "Reference to the distribution transformer from which this service drop originates. Null for services fed directly from secondary mains."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "service_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_service_transformer_id" ;
    cmm:cimAssociation "ACLineSegment.PowerTransformer" .
cmm:ServiceDrop.transformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transformer"@en ;
    rdfs:comment "FK to distribution.transformer.transformer_id — Service drops connect to distribution transformers. This link is critical for tracing customer service back to the network — used in outage impact assessment, voltage complaint investigation, and tran"@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_drop_transformer_id" ;
    cmm:cimAssociation "ACLineSegment.PowerTransformer" .
cmm:ServiceDrop.assetConditionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset condition code"@en ;
    rdfs:comment "Current physical condition assessment of the service drop infrastructure based on most recent inspection."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_condition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Code" ;
    cmm:validValues "excellent|good|fair|poor|critical" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.attachmentHeightFt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "attachment height ft"@en ;
    rdfs:comment "Height above ground level in feet where the service drop is attached to the utility pole or structure. Critical for safety clearance compliance."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "attachment_height_ft" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Attachment Height (Feet)" ;
    cmm:unitSymbol "ft" ;
    cmm:cimDatatype "Length" .
cmm:ServiceDrop.conductorLengthFt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "conductor length ft"@en ;
    rdfs:comment "Physical length of the service drop conductor from the distribution network attachment point to the customer meter point, measured in feet."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "conductor_length_ft" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Conductor Length (Feet)" ;
    cmm:unitSymbol "ft" ;
    cmm:cimDatatype "Length" ;
    cmm:cimCloseMatch cim:Conductor.length .
cmm:ServiceDrop.conductorSizeAwg a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "conductor size awg"@en ;
    rdfs:comment "American Wire Gauge size of the service drop conductor. Examples: #2, #4, 4/0, 2/0. Determines current-carrying capacity."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "conductor_size_awg" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conductor Size (AWG)" ;
    cmm:valuePattern "^(#[0-9]{1,3}|[0-9]{1,3}/[0-9]{1,3})$" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.connectionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection status"@en ;
    rdfs:comment "Current operational status of the service drop connection. Indicates whether the service is energized and delivering power."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "connection_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Status" ;
    cmm:validValues "active|inactive|disconnected|pending_connection|temporary|abandoned" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this service drop record was first created in the system."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ACLineSegment.createdDateTime .
cmm:ServiceDrop.derInterconnectionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection flag"@en ;
    rdfs:comment "Indicates whether this service drop has an approved Distributed Energy Resource (solar, wind, battery) interconnection. True if DER is present, False otherwise."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_interconnection_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER Interconnection Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ServiceDrop.disconnectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnection date"@en ;
    rdfs:comment "Date when the service drop was disconnected or de-energized. Null if currently active."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:date ;
    cmm:physicalColumn "disconnection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnection Date" ;
    cmm:cimDatatype "Date" .
cmm:ServiceDrop.disconnectionReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnection reason"@en ;
    rdfs:comment "Reason code for service drop disconnection. Null if service is active."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "disconnection_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnection Reason" ;
    cmm:validValues "non_payment|customer_request|safety_hazard|permanent_disconnect|temporary_disconnect|meter_change" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.estimatedRemainingLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated remaining life years"@en ;
    rdfs:comment "Estimated remaining useful life of the service drop in years based on condition assessment and typical asset lifecycle."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_remaining_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Remaining Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceDrop.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique identifier for the service drop feature in the utility Geographic Information System for spatial analysis and mapping."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "GIS Feature Identifier" ;
    cmm:valuePattern "^[A-Z0-9-]{10,36}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:ServiceDrop.groundingType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grounding type"@en ;
    rdfs:comment "Type of grounding electrode system used at the service entrance for electrical safety."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "grounding_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grounding Type" ;
    cmm:validValues "rod|plate|water_pipe|building_steel|ufer|none" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the service drop was originally installed and commissioned for service."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:ServiceDrop.installationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation type"@en ;
    rdfs:comment "Physical installation method of the service drop connection."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Type" ;
    cmm:validValues "overhead|underground|aerial_to_underground|riser" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent physical inspection of the service drop for safety and condition assessment."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:ServiceDrop.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent maintenance activity performed on the service drop."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:ServiceDrop.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the service drop connection point at the customer premise in decimal degrees."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude Coordinate" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:ServiceDrop.loadManagementDeviceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load management device flag"@en ;
    rdfs:comment "Indicates whether a demand response or load management device is installed on this service drop. True if device present, False otherwise."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "load_management_device_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Management Device Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ServiceDrop.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the service drop connection point at the customer premise in decimal degrees."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude Coordinate" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:ServiceDrop.netMeteringEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering eligible flag"@en ;
    rdfs:comment "Indicates whether this service drop is eligible for net energy metering programs. True if eligible, False otherwise."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "net_metering_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Metering Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ServiceDrop.neutralConductorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "neutral conductor flag"@en ;
    rdfs:comment "Indicates whether the service drop includes a dedicated neutral conductor. True if neutral is present, False if neutral is shared or absent."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "neutral_conductor_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Neutral Conductor Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ServiceDrop.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next required inspection of the service drop based on regulatory and utility maintenance standards."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ServiceDrop.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Ownership classification of the service drop infrastructure. Determines maintenance responsibility and asset accounting."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|shared|third_party" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration of the service drop connection."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase_wye|three_phase_delta|split_phase" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.poleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pole code"@en ;
    rdfs:comment "Reference to the utility pole where the service drop attachment point is located."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:long ;
    cmm:physicalColumn "pole_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pole Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceDrop.replacementCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replacement cost usd"@en ;
    rdfs:comment "Estimated cost in US dollars to replace the service drop with equivalent new infrastructure. Used for capital planning and asset valuation."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "replacement_cost_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Replacement Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ServiceDrop.serviceAmperageRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service amperage rating"@en ;
    rdfs:comment "Maximum continuous current rating of the service drop in amperes. Typical residential values: 100A, 200A, 400A."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:int ;
    cmm:physicalColumn "service_amperage_rating" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Amperage Rating" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceDrop.serviceClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service class"@en ;
    rdfs:comment "Classification of the service drop based on customer type and usage pattern. Determines service standards and restoration priority."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|street_lighting|temporary" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.serviceDropNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service drop number"@en ;
    rdfs:comment "Business identifier for the service drop connection, typically assigned by the utility for external reference and field operations."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_drop_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Drop Number" ;
    cmm:valuePattern "^SD-[A-Z0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ServiceDrop.serviceEntranceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service entrance type"@en ;
    rdfs:comment "Type of service entrance equipment at the customer premise where the service drop terminates."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_entrance_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Entrance Type" ;
    cmm:validValues "mast|conduit|weatherhead|meter_socket|panel_direct" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.servicePriorityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service priority code"@en ;
    rdfs:comment "Restoration priority classification for outage management. Critical services (hospitals, emergency facilities) receive highest priority during restoration."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_priority_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Priority Code" ;
    cmm:validValues "critical|high|standard|low" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.serviceVoltageNominalV a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage nominal v"@en ;
    rdfs:comment "Nominal service voltage in volts delivered at the customer meter point. Typical values: 120, 240, 208, 277, 480."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:int ;
    cmm:physicalColumn "service_voltage_nominal_v" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Nominal (Volts)" ;
    cmm:unitSymbol "V" ;
    cmm:cimDatatype "Voltage" .
cmm:ServiceDrop.serviceVoltageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage type"@en ;
    rdfs:comment "Voltage configuration delivered to the customer premise. Defines the electrical service characteristics."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_voltage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Type" ;
    cmm:validValues "single_phase_120_240|three_phase_120_208|three_phase_277_480|single_phase_120|single_phase_240" ;
    cmm:cimDatatype "String" .
cmm:ServiceDrop.smartMeterCompatibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "smart meter compatible flag"@en ;
    rdfs:comment "Indicates whether the service drop infrastructure supports Advanced Metering Infrastructure (AMI) smart meter installation. True if compatible, False otherwise."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "smart_meter_compatible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Smart Meter Compatible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ServiceDrop.toTransformer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to transformer"@en ;
    rdfs:comment "FK to distribution.distribution_transformer.distribution_transformer_id — Service drops connect to distribution transformers (or secondary network). The description mentions 'pole or transformer association'. This FK is critical for customer-to-network tracing and outage im"@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_transformer" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceDrop.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this service drop record was last modified in the system."@en ;
    rdfs:domain cmm:ServiceDrop ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:NetworkSegment a owl:Class ;
    rdfs:label "Network Segment"@en ;
    rdfs:comment "Master record representing a topologically distinct section of the distribution network between two sectionalizing points. Captures segment identifier, upstream and downstream boundary devices, conductor type and size, length (km), rated ampacity, nominal voltage, phase configuration, feeder association, GIS polyline reference, and load zone classification. SSOT for distribution network topology between switching points. Used for load flow analysis, fault location, FLISR switching logic, and hosting capacity analysis in GE PowerOn ADMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:EquipmentContainer ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.network_segment" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13; IEC CIM ACLineSegment / GE PowerOn ADMS Network Model" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.network_segment" ;
    owl:hasKey ( cmm:NetworkSegment.networkSegmentId ) .

cmm:NetworkSegment.networkSegmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network segment id"@en ;
    rdfs:comment "Unique identifier for the distribution network segment. Primary key representing a topologically distinct section between two sectionalizing points."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:long ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Network Segment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkSegment.conductorMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "conductor material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Network segments (overhead/underground conductors) are material assets requiring material master linkage for replacement planning, emergency stock management, and conductor standardization. Critical f"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "conductor_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Conductor Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_conductor_material_master_id" ;
    cmm:cimAssociation "EquipmentContainer.ErpItemMaster" .
cmm:NetworkSegment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Network segments (conductor runs) have associated O&M costs for maintenance, vegetation management, and reliability improvements tracked by cost center. Required for feeder-level cost allocation in ra"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_cost_center_id" ;
    cmm:cimAssociation "EquipmentContainer.Organisation" .
cmm:NetworkSegment.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the distribution substation that serves as the electrical source for this segment. Used for tracing power flow and outage impact analysis."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Source Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_distribution_substation_id" ;
    cmm:cimAssociation "EquipmentContainer.Substation" .
cmm:NetworkSegment.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Every network segment belongs to a feeder. The segment description mentions 'feeder association'. Critical for fault location and load flow analysis."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_feeder_id" ;
    cmm:cimAssociation "EquipmentContainer.Feeder" .
cmm:NetworkSegment.loadZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load zone"@en ;
    rdfs:comment "Foreign key linking to distribution.load_zone. Business justification: Network segments belong to load zones for load balancing and voltage regulation purposes. Currently network_segment has load_zone_code as STRING, but this should be a proper FK to load_zone.load_zone_"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "load_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Zone Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_load_zone_id" ;
    cmm:cimAssociation "EquipmentContainer.SubLoadArea" .
cmm:NetworkSegment.maintenanceCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance crew"@en ;
    rdfs:comment "Foreign key linking to workforce.crew. Business justification: Network segments are assigned to specific crews for routine maintenance, vegetation management, and emergency response. Essential for territory management, crew dispatch optimization, storm restoratio"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "maintenance_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Maintenance Crew Id (Foreign Key)" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_maintenance_crew_id" ;
    cmm:cimAssociation "EquipmentContainer.Crew" .
cmm:NetworkSegment.networkFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network feeder"@en ;
    rdfs:comment "Reference to the parent distribution feeder that this segment belongs to. Links segment to the primary circuit originating from a substation."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "network_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_network_feeder_id" ;
    cmm:cimAssociation "EquipmentContainer.Feeder" .
cmm:NetworkSegment.networkSegmentBelongsToFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network_segment_belongs_to_feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Network segments are sections of a feeder between sectionalizing points. Feeder assignment is required for load flow analysis, fault location, and FLISR switching logic. Without this FK, segments are"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "network_segment_belongs_to_feeder" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_network_segment_belongs_to_feeder" ;
    cmm:cimAssociation "EquipmentContainer.Feeder" .
cmm:NetworkSegment.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Network segments have specific vegetation management obligations (NERC FAC-003), inspection frequency requirements, and maintenance standards. Tracking which obligations apply to which segments enable"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_obligation_id" ;
    cmm:cimAssociation "EquipmentContainer.Document" .
cmm:NetworkSegment.sectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device"@en ;
    rdfs:comment "FK to distribution.sectionalizing_device.sectionalizing_device_id — Each network segment is bounded by upstream and downstream sectionalizing devices. This FK defines the topological connectivity that FLISR uses to determine isolation boundaries. Critical for automate"@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_network_segment_sectionalizing_device_id" ;
    cmm:cimAssociation "EquipmentContainer.ProtectedSwitch" .
cmm:NetworkSegment.averageLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average load kw"@en ;
    rdfs:comment "Typical average load carried by this segment under normal operating conditions. Used for load flow analysis and loss calculations."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_load_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Load in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:NetworkSegment.conditionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition score"@en ;
    rdfs:comment "Numerical assessment of the physical condition of the segment on a standardized scale (typically 0-100). Based on inspection findings, age, failure history, and predictive analytics. Used for prioritizing capital investments."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "condition_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Score" ;
    cmm:cimDatatype "Decimal" .
cmm:NetworkSegment.conductorSizeAwg a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "conductor size awg"@en ;
    rdfs:comment "Cross-sectional size of the conductor expressed in AWG or kcmil (thousand circular mils). Determines current-carrying capacity and voltage drop characteristics. Common sizes: 4/0, 336.4 kcmil, 477 kcmil."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "conductor_size_awg" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conductor Size American Wire Gauge (AWG)" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this network segment record was first created in the system. Used for data lineage and audit trail purposes."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:EquipmentContainer.createdDateTime .
cmm:NetworkSegment.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
    rdfs:comment "Business criticality classification based on customer count, load served, presence of critical facilities (hospitals, emergency services), and redundancy availability. Critical segments receive priority during restoration and maintenance planning."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Rating" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.customerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer count"@en ;
    rdfs:comment "Number of customer premises served by this network segment. Used for outage impact assessment and SAIDI/SAIFI/CAIDI reliability index calculations for PUC reporting."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkSegment.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the operational system that is the authoritative source for this segment record (e.g., GE PowerOn ADMS, Esri ArcGIS Utility Network). Used for data lineage and integration troubleshooting."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.downstreamDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "downstream device id"@en ;
    rdfs:comment "Reference to the downstream boundary sectionalizing device that defines the end of this network segment. Used in automated switching sequences during fault restoration."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:long ;
    cmm:physicalColumn "downstream_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Downstream Sectionalizing Device Identifier (ID)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkSegment.emergencyAmpacityAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency ampacity amps"@en ;
    rdfs:comment "Short-term current-carrying capacity allowed during emergency conditions or contingency operations. Typically 120-150% of rated ampacity for limited duration."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emergency_ampacity_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Ampacity in Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:NetworkSegment.flisrEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr enabled flag"@en ;
    rdfs:comment "Indicates whether this segment is included in automated FLISR switching logic. FLISR-enabled segments can be automatically isolated and restored during fault conditions to minimize outage duration and customer impact."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NetworkSegment.gisPolylineReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis polyline reference"@en ;
    rdfs:comment "Reference identifier to the corresponding polyline feature in the GIS system (Esri ArcGIS Utility Network). Links operational data to geographic representation for mapping and spatial analysis."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_polyline_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Polyline Reference" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:NetworkSegment.hostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hosting capacity kw"@en ;
    rdfs:comment "Maximum amount of distributed generation (solar, wind, storage) that can be interconnected to this segment without causing voltage, thermal, or protection violations. Critical for DER interconnection studies and renewable integration planning."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Hosting Capacity in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:NetworkSegment.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the network segment was originally installed and energized. Used for asset age analysis and replacement planning."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:NetworkSegment.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent physical inspection of the segment. Used for compliance with maintenance schedules and condition assessment programs."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:NetworkSegment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this network segment record. Tracks data currency and change history for operational and compliance purposes."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:NetworkSegment.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "Identifier of the user or system process that last modified this record. Supports audit trail and data governance requirements."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User Identifier" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.neutralConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "neutral configuration"@en ;
    rdfs:comment "Method of neutral conductor grounding. Multi-grounded neutrals are grounded at multiple points for safety, unigrounded at one point, ungrounded systems have no neutral ground, impedance-grounded use resistors or reactors."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "neutral_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Neutral Grounding Configuration" ;
    cmm:validValues "multi_grounded|unigrounded|ungrounded|impedance_grounded" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next required inspection based on regulatory requirements and utility maintenance policies."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:NetworkSegment.nominalVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal voltage kv"@en ;
    rdfs:comment "Design voltage level of the distribution segment in kilovolts. Common distribution voltages: 4.16 kV, 12.47 kV, 13.2 kV, 13.8 kV, 23 kV, 34.5 kV."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nominal_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Nominal Voltage in Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:NetworkSegment.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the network segment in the distribution grid. Determines whether the segment is actively carrying load, isolated for maintenance, or permanently retired."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|under_construction|decommissioned|temporarily_isolated|maintenance" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EquipmentContainer.status .
cmm:NetworkSegment.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Legal ownership classification of the segment. Most distribution segments are utility-owned, but some may be customer-owned (behind-the-meter), jointly owned with municipalities, or owned by third parties."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|joint_ownership|third_party" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.peakLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak load kw"@en ;
    rdfs:comment "Historical maximum load observed on this segment in kilowatts. Used for capacity planning, load balancing, and identifying overloaded segments requiring reinforcement."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_load_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Load in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:NetworkSegment.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase arrangement of the segment. Three-phase segments serve large loads and industrial customers, two-phase serve medium loads, single-phase serve residential areas. Phase rotation (ABC vs ACB) affects motor operation. Reference-value candidates: three_phase_abc|three_phase_acb|two_phase_ab|two_phase_bc|two_phase_ac|single_phase_a|single_phase_b|single_phase_c."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.positiveSequenceReactanceOhmsPerKm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "positive sequence reactance ohms per km"@en ;
    rdfs:comment "Positive sequence inductive reactance of the conductor per unit length. Critical for power flow modeling and voltage regulation analysis."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "positive_sequence_reactance_ohms_per_km" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Positive Sequence Reactance in Ohms per Kilometer" ;
    cmm:unitSymbol "m" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Length" .
cmm:NetworkSegment.positiveSequenceResistanceOhmsPerKm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "positive sequence resistance ohms per km"@en ;
    rdfs:comment "Positive sequence resistance of the conductor per unit length. Used in load flow analysis, voltage drop calculations, and short circuit studies in GE PowerOn ADMS."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "positive_sequence_resistance_ohms_per_km" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Positive Sequence Resistance in Ohms per Kilometer" ;
    cmm:unitSymbol "m" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Length" .
cmm:NetworkSegment.ratedAmpacityAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated ampacity amps"@en ;
    rdfs:comment "Maximum continuous current-carrying capacity of the conductor in amperes under normal operating conditions. Determined by conductor size, material, installation method, and ambient temperature."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_ampacity_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Ampacity in Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:NetworkSegment.recordEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record effective date"@en ;
    rdfs:comment "Date from which this version of the segment record is effective. Supports temporal data management and historical analysis of network topology changes."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "record_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:NetworkSegment.recordExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record expiration date"@en ;
    rdfs:comment "Date when this version of the segment record expires and is superseded by a new version. Null for current active records. Enables tracking of network topology evolution over time."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "record_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:NetworkSegment.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "State or provincial Public Utility Commission (PUC) that has regulatory authority over this segment. Determines applicable reliability standards, reporting requirements, and rate recovery mechanisms."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.scadaMonitoredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada monitored flag"@en ;
    rdfs:comment "Indicates whether this segment has real-time SCADA telemetry for current, voltage, and power flow monitoring. SCADA-monitored segments provide operational visibility for grid operators."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_monitored_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Monitored Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NetworkSegment.segmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment code"@en ;
    rdfs:comment "Externally-known business identifier for the network segment used in operational systems and field communications. Typically derived from GIS naming conventions."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Segment Business Code" ;
    cmm:valuePattern "^[A-Z0-9]{6,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:NetworkSegment.segmentLengthKm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment length km"@en ;
    rdfs:comment "Physical length of the network segment measured in kilometers. Used for impedance calculations, voltage drop analysis, and hosting capacity studies."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "segment_length_km" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Segment Length in Kilometers (km)" ;
    cmm:unitSymbol "m" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Length" ;
    cmm:cimCloseMatch cim:Conductor.length .
cmm:NetworkSegment.segmentName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment name"@en ;
    rdfs:comment "Human-readable descriptive name for the network segment, often including geographic or operational context (e.g., 'Main St Feeder 12A Section 3')."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Network Segment Name" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:IdentifiedObject.name .
cmm:NetworkSegment.segmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment type"@en ;
    rdfs:comment "Classification of the segment based on its role in the distribution network hierarchy. Primary feeders carry bulk power from substations, laterals branch from primaries, sub-laterals branch from laterals, service backbones serve multiple service drops, express feeders bypass load areas, and tie lines connect feeders."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Segment Type Classification" ;
    cmm:validValues "primary_feeder|lateral|sub_lateral|service_backbone|express_feeder|tie_line" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EquipmentContainer.kind .
cmm:NetworkSegment.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Geographic service territory classification for regulatory and operational reporting. Segments are grouped by franchise area or service district."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.upstreamDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upstream device id"@en ;
    rdfs:comment "Reference to the upstream boundary sectionalizing device (recloser, breaker, switch) that defines the beginning of this network segment. Critical for FLISR automation and fault isolation logic."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:long ;
    cmm:physicalColumn "upstream_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Upstream Sectionalizing Device Identifier (ID)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkSegment.voltVarOptimizationZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var optimization zone"@en ;
    rdfs:comment "Identifier for the voltage optimization zone this segment belongs to. VVO zones are coordinated groups of segments and voltage control devices managed together to reduce losses and maintain voltage within acceptable limits."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "volt_var_optimization_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization (VVO) Zone" ;
    cmm:cimDatatype "String" .
cmm:NetworkSegment.zeroSequenceReactanceOhmsPerKm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zero sequence reactance ohms per km"@en ;
    rdfs:comment "Zero sequence inductive reactance per unit length. Essential for fault current calculations and protection system design."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "zero_sequence_reactance_ohms_per_km" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Zero Sequence Reactance in Ohms per Kilometer" ;
    cmm:unitSymbol "m" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Length" .
cmm:NetworkSegment.zeroSequenceResistanceOhmsPerKm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zero sequence resistance ohms per km"@en ;
    rdfs:comment "Zero sequence resistance per unit length. Used in ground fault analysis and protective relay coordination studies."@en ;
    rdfs:domain cmm:NetworkSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "zero_sequence_resistance_ohms_per_km" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Zero Sequence Resistance in Ohms per Kilometer" ;
    cmm:unitSymbol "m" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Length" .

cmm:LoadZone a owl:Class ;
    rdfs:label "Load Zone"@en ;
    rdfs:comment "Master record for distribution load zones — logical groupings of network segments used for load balancing, volt-VAR optimization dispatch, demand forecasting, and capacity planning. Captures zone identifier, zone name, geographic boundary (GIS polygon), nominal load (MW/MVAr), peak demand (MW), associated feeders, voltage regulation targets, power factor targets, and DMS zone classification. Serves as the control zone for VVO dispatch actions and the planning unit for distribution capacity studies. SSOT for load zone definition in GE PowerOn ADMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SubLoadArea ;
    cmm:cimCloseMatch cim:SubLoadArea ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::LoadModel" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.load_zone" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "GE PowerOn ADMS Load Zone / IEC CIM LoadArea" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.load_zone" ;
    owl:hasKey ( cmm:LoadZone.loadZoneId ) .

cmm:LoadZone.loadZoneId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load zone id"@en ;
    rdfs:comment "Unique identifier for the distribution load zone. Primary key. This is the SSOT identifier used across GE PowerOn ADMS and Esri ArcGIS Utility Network for zone-level control and planning."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:long ;
    cmm:physicalColumn "load_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Load Zone Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:LoadZone.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Foreign key reference to the parent substation that supplies this load zone. Links the zone to its source substation in the transmission-distribution interface."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_distribution_substation_id" ;
    cmm:cimAssociation "SubLoadArea.Substation" .
cmm:LoadZone.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Load zones are logical groupings that include one or more feeders. This many-to-many relationship (or zone FK on feeder) is needed for VVO dispatch, demand forecasting, and capacity planning at the zo"@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_feeder_id" ;
    cmm:cimAssociation "SubLoadArea.Feeder" .
cmm:LoadZone.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Distribution load zones are operational constructs that directly map to forecast zones for planning. Essential for integrated distribution planning, voltage optimization planning, and capacity studies"@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_forecast_zone_id" ;
    cmm:cimAssociation "SubLoadArea.LoadArea" .
cmm:LoadZone.loadFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Load zones are associated with feeders. The description mentions 'associated feeders'. This is a many-to-many but the primary association is critical for load balancing operations."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "load_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_load_feeder_id" ;
    cmm:cimAssociation "SubLoadArea.Feeder" .
cmm:LoadZone.loadZoneIncludesFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load_zone_includes_feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Load zones are logical groupings that include one or more feeders. This FK supports VVO dispatch zone definition and capacity planning by zone."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "load_zone_includes_feeder" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_load_zone_includes_feeder" ;
    cmm:cimAssociation "SubLoadArea.Feeder" .
cmm:LoadZone.planningEngineerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "planning engineer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Load zones require planning engineers for capacity analysis, load forecasting, DER hosting capacity studies, and capital investment planning. Essential for distribution planning processes, capacity st"@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "planning_engineer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Planning Engineer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_planning_engineer_employee_id" ;
    cmm:cimAssociation "SubLoadArea.ErpPersonnel" .
cmm:LoadZone.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Load zones represent service territories or planning areas that align with profit center structures for revenue and cost tracking by geographic/functional area. Essential for territorial profitability"@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_load_zone_profit_center_id" ;
    cmm:cimAssociation "SubLoadArea.Organisation" .
cmm:LoadZone.capacityMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity mva"@en ;
    rdfs:comment "Total installed capacity of the load zone in megavolt-amperes, representing the maximum apparent power the zone infrastructure can support. Used for capacity planning and load transfer studies."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Megavolt-Amperes (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:LoadZone.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this load zone record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SubLoadArea.createdDateTime .
cmm:LoadZone.customerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer count"@en ;
    rdfs:comment "Total number of customer premises served by this load zone. Used for reliability index calculations (SAIDI, SAIFI, CAIDI) and outage impact assessment."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:LoadZone.derPenetrationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der penetration mw"@en ;
    rdfs:comment "Total installed capacity of distributed energy resources (solar PV, wind, storage, etc.) within the load zone, measured in megawatts. Used for DER hosting capacity analysis and grid integration planning."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "der_penetration_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Penetration Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:LoadZone.dmsZoneClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dms zone classification"@en ;
    rdfs:comment "Classification of the zone within the DMS/ADMS for automation capabilities. VVO-enabled zones support Volt-VAR Optimization, FLISR-enabled zones support Fault Location Isolation and Service Restoration, manual zones require operator intervention, hybrid zones have partial automation, and advanced zones support full ADMS integration."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "dms_zone_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distribution Management System (DMS) Zone Classification" ;
    cmm:validValues "vvo_enabled|flisr_enabled|manual|hybrid|advanced" ;
    cmm:cimDatatype "String" .
cmm:LoadZone.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date when the load zone configuration became or will become effective. Used for tracking zone boundary changes, capacity upgrades, and operational transitions."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:LoadZone.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date when the load zone configuration expires or is scheduled for decommissioning. Null for active zones with no planned end date."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:LoadZone.feederCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder count"@en ;
    rdfs:comment "Number of distribution feeders associated with this load zone. Used for network topology analysis and load balancing."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:int ;
    cmm:physicalColumn "feeder_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feeder Count" ;
    cmm:cimDatatype "Integer" .
cmm:LoadZone.flisrEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr enabled flag"@en ;
    rdfs:comment "Indicates whether FLISR automation is enabled for this load zone. True means automated fault detection, isolation, and restoration; false means manual switching operations."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LoadZone.geographicBoundaryWkt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic boundary wkt"@en ;
    rdfs:comment "Geographic boundary of the load zone represented as a WKT (Well-Known Text) polygon. Used for spatial analysis, outage mapping, and GIS integration with Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_boundary_wkt" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Boundary Well-Known Text (WKT)" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.PositionPoints .
cmm:LoadZone.hostingCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hosting capacity mw"@en ;
    rdfs:comment "Maximum amount of additional DER capacity the zone can accommodate without infrastructure upgrades or operational issues, measured in megawatts. Used for interconnection screening and DER integration planning."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hosting_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hosting Capacity Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:LoadZone.lastCapacityStudyDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last capacity study date"@en ;
    rdfs:comment "Date of the most recent distribution capacity study performed for this load zone. Used to track planning cycle compliance and identify zones requiring updated analysis."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_capacity_study_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Capacity Study Date" ;
    cmm:cimDatatype "Date" .
cmm:LoadZone.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this load zone record was last updated. Used for audit trail, change tracking, and data synchronization across systems."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:LoadZone.loadProfileType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile type"@en ;
    rdfs:comment "Dominant customer class or load profile characteristic of the zone. Residential zones peak in evening, commercial zones peak mid-day, industrial zones have steady load, mixed zones have diverse profiles, and agricultural zones have seasonal patterns."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Profile Type" ;
    cmm:validValues "residential|commercial|industrial|mixed|agricultural" ;
    cmm:cimDatatype "String" .
cmm:LoadZone.nextCapacityStudyDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next capacity study date"@en ;
    rdfs:comment "Scheduled date for the next distribution capacity study for this load zone. Used for planning resource allocation and ensuring regulatory compliance with capacity planning cycles."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_capacity_study_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Capacity Study Date" ;
    cmm:cimDatatype "Date" .
cmm:LoadZone.nominalLoadMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal load mvar"@en ;
    rdfs:comment "Typical or average reactive power load of the zone under normal operating conditions, measured in megavolt-amperes reactive. Used for Volt-VAR optimization and power factor management."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nominal_load_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nominal Load Megavolt-Amperes Reactive (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:LoadZone.nominalLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal load mw"@en ;
    rdfs:comment "Typical or average real power load of the zone under normal operating conditions, measured in megawatts. Used for load balancing and capacity planning."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nominal_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nominal Load Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:LoadZone.nominalVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal voltage kv"@en ;
    rdfs:comment "Nominal operating voltage of the load zone in kilovolts. Typical distribution voltages range from 4.16 kV to 34.5 kV."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nominal_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Nominal Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:LoadZone.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special considerations, or additional context about the load zone. May include information about unique load characteristics, planned projects, or operational constraints."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:LoadZone.peakDemandMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand mw"@en ;
    rdfs:comment "Historical or forecasted peak real power demand for the zone, measured in megawatts. Critical for capacity planning and infrastructure investment decisions."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_demand_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:LoadZone.peakDemandTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand timestamp"@en ;
    rdfs:comment "Date and time when the peak demand was recorded or is forecasted to occur. Used for load profile analysis and demand response planning."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "peak_demand_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LoadZone.planningAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning area code"@en ;
    rdfs:comment "Foreign key reference to the broader distribution planning area or service territory that contains this load zone. Used for regional capacity planning and resource allocation."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:long ;
    cmm:physicalColumn "planning_area_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Area Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:LoadZone.powerFactorTarget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor target"@en ;
    rdfs:comment "Target power factor for the load zone, typically between 0.95 and 1.00. Used for Volt-VAR optimization dispatch and capacitor bank control to minimize reactive power losses."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_target" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor Target" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadZone.reliabilityCaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability caidi minutes"@en ;
    rdfs:comment "Customer Average Interruption Duration Index for the load zone, measured in minutes per interruption. Calculated as SAIDI/SAIFI. Indicates average restoration time. Key reliability metric reported to PUC."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_caidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Average Interruption Duration Index (CAIDI) Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:LoadZone.reliabilitySaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability saidi minutes"@en ;
    rdfs:comment "System Average Interruption Duration Index for the load zone, measured in minutes per customer per year. Key reliability metric reported to PUC. Lower values indicate better reliability."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_saidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:LoadZone.reliabilitySaifiCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability saifi count"@en ;
    rdfs:comment "System Average Interruption Frequency Index for the load zone, measured as number of interruptions per customer per year. Key reliability metric reported to PUC. Lower values indicate better reliability."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_saifi_count" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Count" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadZone.scadaIntegrationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada integration status"@en ;
    rdfs:comment "Level of SCADA system integration for real-time monitoring and control of the load zone. Fully integrated zones have complete telemetry and control, partially integrated zones have limited coverage, not integrated zones rely on manual operations, and planned zones are scheduled for integration."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_integration_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Integration Status" ;
    cmm:validValues "fully_integrated|partially_integrated|not_integrated|planned" ;
    cmm:cimDatatype "String" .
cmm:LoadZone.utilizationFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utilization factor"@en ;
    rdfs:comment "Ratio of peak demand to installed capacity, indicating how heavily the zone infrastructure is utilized. Values approaching 1.0 indicate need for capacity expansion."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utilization_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utilization Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadZone.voltageRegulationTargetMaxPu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage regulation target max pu"@en ;
    rdfs:comment "Maximum acceptable voltage level for the zone expressed in per-unit (pu) of nominal voltage. Typically 1.05 pu per ANSI C84.1 Range A. Used by VVO algorithms to maintain voltage within acceptable limits."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_regulation_target_max_pu" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Regulation Target Maximum Per Unit (pu)" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadZone.voltageRegulationTargetMinPu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage regulation target min pu"@en ;
    rdfs:comment "Minimum acceptable voltage level for the zone expressed in per-unit (pu) of nominal voltage. Typically 0.95 pu per ANSI C84.1 Range A. Used by VVO algorithms to maintain voltage within acceptable limits."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_regulation_target_min_pu" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Regulation Target Minimum Per Unit (pu)" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadZone.vvoEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vvo enabled flag"@en ;
    rdfs:comment "Indicates whether Volt-VAR Optimization is enabled for this load zone. True means VVO algorithms actively control voltage and reactive power devices; false means manual or legacy control."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vvo_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization (VVO) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LoadZone.zoneCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zone code"@en ;
    rdfs:comment "Business identifier for the load zone, typically a human-readable alphanumeric code used in operational systems and dispatch communications. Externally known identifier for the zone."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "zone_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Load Zone Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:LoadZone.zoneName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zone name"@en ;
    rdfs:comment "Descriptive name of the load zone, often reflecting geographic area or substation association (e.g., 'Downtown West Zone', 'Substation 5 North')."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "zone_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Load Zone Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:LoadZone.zoneStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zone status"@en ;
    rdfs:comment "Current operational status of the load zone. Active zones are in service, inactive zones are temporarily out of service, planned zones are under construction, decommissioned zones are retired, and maintenance zones are undergoing scheduled work."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "zone_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Load Zone Status" ;
    cmm:validValues "active|inactive|planned|decommissioned|maintenance" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SubLoadArea.status .
cmm:LoadZone.zoneType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zone type"@en ;
    rdfs:comment "Classification of the load zone based on its role in the distribution network hierarchy. Primary zones serve major load centers, secondary zones serve neighborhood clusters, tertiary zones serve smaller segments, and special zones serve unique loads (industrial parks, critical infrastructure)."@en ;
    rdfs:domain cmm:LoadZone ; rdfs:range xsd:string ;
    cmm:physicalColumn "zone_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Load Zone Type" ;
    cmm:validValues "primary|secondary|tertiary|special" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SubLoadArea.kind .

cmm:DistributionSwitchingOrder a owl:Class ;
    rdfs:label "Distribution Switching Order"@en ;
    rdfs:comment "Transactional record capturing planned and emergency switching operations on the distribution network, including the full sequence of individual switching steps. Captures switching order number, order type (planned/emergency/FLISR-automated/load-transfer), initiating event reference, crew assignment, authorization approvals, safety clearances, and completion status. Each order contains an ordered sequence of switching steps, each with: step sequence number, target device, operation type (open/close/tag/untag), required pre/post device state, execution timestamp, operator ID, confirmed device state, and step completion status. Records pre-switch and post-switch network topology for each order. SSOT for all distribution switching operations including FLISR-automated sequences, load transfer operations, and step-level audit trail. Sourced from GE PowerOn ADMS switching management module."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingPlan ;
    cmm:cimExactMatch cim:SwitchingPlan ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.distribution_switching_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; GE PowerOn ADMS Switching Management / IEEE 1547" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.distribution_switching_order" ;
    owl:hasKey ( cmm:DistributionSwitchingOrder.distributionSwitchingOrderId ) .

cmm:DistributionSwitchingOrder.distributionSwitchingOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution switching order id"@en ;
    rdfs:comment "Unique identifier for the distribution switching order. Primary key for this entity."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "distribution_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distribution Switching Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingOrder.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Switching orders are standard audit scope items for NERC compliance audits examining switching procedures, clearance protocols, and operational safety. Linking orders to audits enables evidence sampli"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_audit_id" ;
    cmm:cimAssociation "SwitchingPlan.ActivityRecord" .
cmm:DistributionSwitchingOrder.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Switching orders incur labor, equipment, and overhead costs that must be allocated to cost centers for O&M expense tracking, budget variance analysis, and regulatory cost reporting. Core to work order"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_cost_center_id" ;
    cmm:cimAssociation "SwitchingPlan.Organisation" .
cmm:DistributionSwitchingOrder.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Foreign key reference to the field crew assigned to execute this switching order. Links to workforce management system for crew tracking and dispatch."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_crew_id" ;
    cmm:cimAssociation "SwitchingPlan.Crew" .
cmm:DistributionSwitchingOrder.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Emergency switching operations during major storms trigger emergency stock deployment. Links switching orders to emergency material events for cost tracking, FEMA reimbursement documentation, and post"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_emergency_stock_event_id" ;
    cmm:cimAssociation "SwitchingPlan.ActivityRecord" .
cmm:DistributionSwitchingOrder.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key reference to the outage event that necessitated this switching order. Populated for emergency and restoration switching operations."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_event_id" ;
    cmm:cimAssociation "SwitchingPlan.Outage" .
cmm:DistributionSwitchingOrder.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Planned switching work for maintenance or capital projects is tracked via internal orders for cost collection before settlement to fixed assets or expense accounts. Essential for capital vs. expense w"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_internal_order_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpProjectAccounting" .
cmm:DistributionSwitchingOrder.notificationAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "notification account"@en ;
    rdfs:comment "Foreign key linking to customer.account. Business justification: Planned outage notifications for switching orders require direct account links for customer communication workflows. Critical customers, medical baseline accounts, and large commercial accounts need p"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "notification_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Notification Account Id (Foreign Key)" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_notification_account_id" ;
    cmm:cimAssociation "SwitchingPlan.CustomerAccount" .
cmm:DistributionSwitchingOrder.primaryDistributionEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary distribution employee"@en ;
    rdfs:comment "User identifier of the system operator or supervisor who authorized the switching order for execution. Critical for audit trail and compliance with NERC CIP standards."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_distribution_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Authorized By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_primary_distribution_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:DistributionSwitchingOrder.quaternaryDistributionCreatedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "quaternary distribution created by user employee"@en ;
    rdfs:comment "User identifier of the system operator or automated process that created this switching order record. Part of the audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "quaternary_distribution_created_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_quaternary_distribution_created_by_user_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:DistributionSwitchingOrder.quinaryDistributionLastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "quinary distribution last modified by user employee"@en ;
    rdfs:comment "User identifier of the person who last modified this switching order record. Part of the audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "quinary_distribution_last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_quinary_distribution_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:DistributionSwitchingOrder.safetyClearance a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance"@en ;
    rdfs:comment "Foreign key reference to the safety clearance record that authorizes work on de-energized equipment. Required for all switching orders that create safe work zones."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:SafetyClearance ;
    cmm:physicalColumn "safety_clearance_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Safety Clearance ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_safety_clearance_id" ;
    cmm:cimAssociation "SwitchingPlan.ClearanceDocument" .
cmm:DistributionSwitchingOrder.stagingWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "staging warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Planned switching orders requiring equipment installation/replacement need material staging from specific warehouses. Tracks where materials are pulled from for work execution, supports logistics plan"@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "staging_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Staging Warehouse Id (Foreign Key)" ;
    cmm:sourceColumn "warehouse_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_staging_warehouse_id" ;
    cmm:cimAssociation "SwitchingPlan.WorkLocation" .
cmm:DistributionSwitchingOrder.tertiaryDistributionCancelledByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary distribution cancelled by user employee"@en ;
    rdfs:comment "User identifier of the person who cancelled the switching order. Part of the cancellation audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_distribution_cancelled_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cancelled By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_tertiary_distribution_cancelled_by_user_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:DistributionSwitchingOrder.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Foreign key reference to the maintenance or construction work order that requires this switching operation. Populated for planned maintenance switching."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_switching_order_work_order_id" ;
    cmm:cimAssociation "SwitchingPlan.Work" .
cmm:DistributionSwitchingOrder.actualEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end timestamp"@en ;
    rdfs:comment "Actual date and time when the switching operation was completed. Captured when the final switching step is confirmed and the order is closed."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time when the switching operation began execution. Captured when the first switching step is initiated."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.affectedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer count"@en ;
    rdfs:comment "Estimated number of customers whose service may be interrupted or affected by this switching operation. Used for customer notification and impact analysis."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingOrder.affectedFeederCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected feeder count"@en ;
    rdfs:comment "Number of distribution feeders impacted by this switching operation. Used for impact assessment and planning."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_feeder_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Feeder Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingOrder.approvalRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required"@en ;
    rdfs:comment "Indicates whether this switching order requires supervisory or management approval before execution. Typically true for high-impact or high-risk operations."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Required" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionSwitchingOrder.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current approval status of the switching order. Tracks whether the order is awaiting approval, has been approved, or has been rejected."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "not_required|pending|approved|rejected" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the switching order was approved. Part of the approval workflow audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.authorizationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization timestamp"@en ;
    rdfs:comment "Date and time when the switching order was authorized for execution. Part of the approval workflow audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "authorization_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text explanation of why the switching order was cancelled. Populated only when order_status is cancelled."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.cancellationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation timestamp"@en ;
    rdfs:comment "Date and time when the switching order was cancelled. Part of the cancellation audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cancellation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.completedSwitchingSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completed switching steps"@en ;
    rdfs:comment "Number of switching steps that have been successfully completed. Used to track progress and calculate completion percentage."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "completed_switching_steps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Completed Switching Steps" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this switching order record was first created in the system. Part of the audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingPlan.createdDateTime .
cmm:DistributionSwitchingOrder.crewAssignmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew assignment timestamp"@en ;
    rdfs:comment "Date and time when the crew was assigned to this switching order. Used for crew utilization tracking and dispatch analytics."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_assignment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Assignment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.failedSwitchingSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failed switching steps"@en ;
    rdfs:comment "Number of switching steps that failed during execution. Indicates operational issues or equipment failures that require attention."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "failed_switching_steps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failed Switching Steps" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingOrder.flisrAutomationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr automation enabled"@en ;
    rdfs:comment "Indicates whether this switching order was executed automatically by FLISR automation logic. True for automated fault isolation and restoration sequences, false for manual operations."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_automation_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Automation Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionSwitchingOrder.flisrSequenceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr sequence code"@en ;
    rdfs:comment "Unique identifier for the FLISR automation sequence that generated this switching order. Populated only for FLISR-automated orders."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_sequence_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Sequence ID" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.initiatingEventReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating event reference"@en ;
    rdfs:comment "Reference identifier to the event that triggered this switching order, such as an outage event ID, maintenance work order number, or FLISR automation event. Links the switching order to its business context."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_event_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initiating Event Reference" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this switching order record was last modified. Part of the audit trail."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DistributionSwitchingOrder.loadTransferMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transfer mw"@en ;
    rdfs:comment "Amount of load in megawatts being transferred between feeders or circuits as a result of this switching operation. Populated for load-transfer type orders."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_transfer_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transfer Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DistributionSwitchingOrder.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or comments related to the switching order. Used by operators and crews to communicate important context."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DistributionSwitchingOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle state of the switching order. Tracks progression from draft through approval, execution, and completion or cancellation. Reference-value candidates: draft|pending_approval|approved|in_progress|completed|cancelled|failed."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.status .
cmm:DistributionSwitchingOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classification of the switching order based on the operational context and urgency. Planned orders are scheduled in advance, emergency orders respond to unplanned events, FLISR-automated orders are executed by Fault Location Isolation and Service Restoration automation, and load-transfer orders redistribute load across feeders."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Type" ;
    cmm:validValues "planned|emergency|flisr_automated|load_transfer|maintenance|storm_restoration" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.kind .
cmm:DistributionSwitchingOrder.postSwitchNetworkTopologySnapshot a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post switch network topology snapshot"@en ;
    rdfs:comment "Serialized representation of the distribution network topology state after the switching operation. Captures the new device states, connectivity, and energization status for validation and record-keeping."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "post_switch_network_topology_snapshot" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Switch Network Topology Snapshot" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.preSwitchNetworkTopologySnapshot a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre switch network topology snapshot"@en ;
    rdfs:comment "Serialized representation of the distribution network topology state before the switching operation. Captures device states, connectivity, and energization status for rollback and analysis purposes."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "pre_switch_network_topology_snapshot" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Switch Network Topology Snapshot" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Operational priority assigned to this switching order. Critical priority is assigned to emergency restoration and public safety situations, high to major outages, medium to planned maintenance, and low to routine operations."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:DistributionSwitchingOrder.safetyClearanceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance status"@en ;
    rdfs:comment "Current status of the safety clearance associated with this switching order. Tracks whether the clearance has been issued, is active, or has been released after work completion."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Clearance Status" ;
    cmm:validValues "not_required|pending|issued|released|expired" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.scheduledEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled end timestamp"@en ;
    rdfs:comment "Planned date and time when the switching operation is expected to be completed. Used for resource planning and customer communication."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "Planned date and time when the switching operation is scheduled to begin. For planned orders, this is set during scheduling; for emergency orders, this may be set at order creation."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionSwitchingOrder.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the operational system that originated this switching order record. Typically GE PowerOn ADMS for distribution switching operations."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.sourceSystemRecordCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record code"@en ;
    rdfs:comment "Unique identifier of this switching order in the source operational system. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record ID" ;
    cmm:cimDatatype "String" .
cmm:DistributionSwitchingOrder.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Externally-known business identifier for the switching order, typically formatted with prefix and sequence number for tracking and reference."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:valuePattern "^[A-Z]{2,4}-[0-9]{6,10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DistributionSwitchingOrder.totalSwitchingSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total switching steps"@en ;
    rdfs:comment "Total number of individual switching steps defined in this switching order. Each step represents a discrete device operation (open, close, tag, untag)."@en ;
    rdfs:domain cmm:DistributionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_switching_steps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Switching Steps" ;
    cmm:cimDatatype "Integer" .

cmm:DistributionSwitchingStep a owl:Class ;
    rdfs:label "Distribution Switching Step"@en ;
    rdfs:comment "Transactional record for each individual switching action within a switching order. Captures step sequence number, device to be operated, operation type (open/close/tag/untag), required state before and after, execution timestamp, operator ID, actual device state confirmed, and step completion status. Provides granular audit trail for switching operations and supports FLISR automated switching sequences."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingAction ;
    cmm:cimExactMatch cim:SwitchingAction ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.distribution_switching_step" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; GE PowerOn ADMS Switching Step" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.distribution_switching_step" ;
    owl:hasKey ( cmm:DistributionSwitchingStep.distributionSwitchingStepId ) .

cmm:DistributionSwitchingStep.distributionSwitchingStepId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution switching step id"@en ;
    rdfs:comment "Unique identifier for the distribution switching step record. Primary key for this transactional line entity."@en ;
    rdfs:domain cmm:DistributionSwitchingStep ; rdfs:range xsd:long ;
    cmm:physicalColumn "distribution_switching_step_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distribution Switching Step ID" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSwitchingStep.distributionSectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution sectionalizing device"@en ;
    rdfs:comment "Identifier of the distribution device (breaker, recloser, switch, sectionalizer) to be operated in this step."@en ;
    rdfs:domain cmm:DistributionSwitchingStep ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "distribution_sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
