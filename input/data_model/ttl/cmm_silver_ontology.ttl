cmm:DunningSchedule.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to the dunning schedule record."@en ;
    rdfs:domain cmm:DunningSchedule ; rdfs:range xsd:dateTime ;
