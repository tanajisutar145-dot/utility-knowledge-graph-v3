    rdfs:comment "Date when the violation was resolved or closed."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:date ;
    cmm:physicalColumn "resolution_date" ;
    cmm:sqlDataType "DATE" ;
