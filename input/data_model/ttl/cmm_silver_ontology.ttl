    cmm:businessTerm "Installation State" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:DerSystem.inverterBasedResourceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
