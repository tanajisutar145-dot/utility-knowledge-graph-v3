cmm:ContingencyMonitoredElement a owl:Class ;
    rdfs:label "Contingency Monitored Element"@en ;
    rdfs:comment "This association product represents the operational relationship between transmission lines and contingency scenarios in NERC-compliant security analysis. Each record captures a specific transmission line's behavior under a defined contingency case, including whether the line is a monitored element, a limiting element, post-contingency loading levels, violation types, and severity indices. This data is essential for real-time EMS contingency analysis, NERC TPL compliance evidence, and operator situational awareness during N-1 and N-2 security assessments.. Existence Justification: In NERC-compliant transmission operations, each contingency scenario (N-1, N-2) must be analyzed against multiple transmission lines to identify thermal overloads, voltage violations, and stability issues. Conversely, each transmission line must be evaluated under multiple contingency scenarios to determine its vulnerability and limiting conditions. The EMS contingency analysis function actively manages this many-to-many relationship, tracking which lines are monitored vs. limiting elements per contingency, post-contingency loading levels, violation types, and severity indices."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.contingency_monitored_element" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.grid.contingency_monitored_element" ;
    owl:hasKey ( cmm:ContingencyMonitoredElement.contingencyMonitoredElementId ) .

cmm:ContingencyMonitoredElement.contingencyMonitoredElementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency monitored element id"@en ;
    rdfs:comment "Unique surrogate identifier for this contingency-line monitoring relationship record. Primary key."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:long ;
    cmm:physicalColumn "contingency_monitored_element_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contingency Monitored Element ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyMonitoredElement.analysisRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "analysis run"@en ;
    rdfs:comment "Reference to the specific EMS contingency analysis execution run that produced this monitored element record. Links to the parent state estimation and analysis timestamp."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range cmm:ContingencyAnalysisRun ;
    cmm:physicalColumn "analysis_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Analysis Run ID" ;
    cmm:sourceColumn "contingency_analysis_run_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_monitored_element_analysis_run_id" ;
    cmm:cimAssociation "IdentifiedObject.ActivityRecord" .
cmm:ContingencyMonitoredElement.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to the contingency case definition under which this line is being evaluated"@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Monitored Element - Contingency Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_monitored_element_contingency_id" ;
    cmm:cimAssociation "IdentifiedObject.Contingency" .
cmm:ContingencyMonitoredElement.transmissionLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission line"@en ;
    rdfs:comment "Foreign key linking to the transmission line master record being analyzed in this contingency scenario"@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range cmm:TransmissionLine ;
    cmm:physicalColumn "transmission_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Monitored Element - Transmission Line Id" ;
    cmm:sourceColumn "line_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_monitored_element_transmission_line_id" ;
    cmm:cimAssociation "IdentifiedObject.Line" .
cmm:ContingencyMonitoredElement.applicableRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable rating mva"@en ;
    rdfs:comment "The thermal rating in MVA used to evaluate this line under this contingency scenario. May be normal, emergency, or load-dump rating depending on the contingency duration and severity classification."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicable_rating_mva" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Rating MVA" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:ContingencyMonitoredElement.contingencySeverityIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency severity index"@en ;
    rdfs:comment "Numerical severity index quantifying the impact of this contingency on this specific transmission line. Calculated based on post-contingency loading, voltage deviation, and other performance metrics. Higher values indicate more severe impacts requiring operator attention or corrective action."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contingency_severity_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Severity Index" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyMonitoredElement.correctiveActionRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action required flag"@en ;
    rdfs:comment "Boolean flag indicating whether operator corrective action or remedial action scheme (RAS) activation is required to mitigate violations on this line under this contingency."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "corrective_action_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyMonitoredElement.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this contingency monitored element record, typically corresponding to the latest EMS contingency analysis execution."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ContingencyMonitoredElement.limitingElementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limiting element flag"@en ;
    rdfs:comment "Boolean flag indicating whether this transmission line is the limiting element (most severely impacted) for this contingency scenario. The limiting element determines the severity classification of the contingency."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "limiting_element_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limiting Element Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyMonitoredElement.monitoredElementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monitored element flag"@en ;
    rdfs:comment "Boolean flag indicating whether this transmission line is designated as a monitored element in this specific contingency scenario. Monitored elements are tracked for violations during contingency analysis execution."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "monitored_element_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monitored Element Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyMonitoredElement.operatorAcknowledgedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator acknowledged flag"@en ;
    rdfs:comment "Boolean flag indicating whether the system operator has acknowledged the violation or alarm associated with this contingency-line combination in the EMS interface."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_acknowledged_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Acknowledged Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyMonitoredElement.postContingencyFlowMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post contingency flow mw"@en ;
    rdfs:comment "Active power flow in megawatts (MW) on this transmission line immediately following the contingency event, calculated by the EMS contingency analysis function."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_contingency_flow_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Contingency Flow MW" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ContingencyMonitoredElement.postContingencyLoadingPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post contingency loading percent"@en ;
    rdfs:comment "Calculated loading percentage of the transmission line immediately following the contingency event, expressed as a percentage of the applicable thermal rating (normal, emergency, or load-dump). Used to identify thermal overload violations."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_contingency_loading_percent" ;
    cmm:sqlDataType "DECIMAL(7,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Contingency Loading Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ContingencyMonitoredElement.preContingencyFlowMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre contingency flow mw"@en ;
    rdfs:comment "Active power flow in megawatts (MW) on this transmission line in the base case (pre-contingency) state, derived from the parent state estimation run."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_contingency_flow_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Contingency Flow MW" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ContingencyMonitoredElement.violationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation type"@en ;
    rdfs:comment "Classification of the violation detected on this transmission line under this contingency scenario. Values include NONE (no violation), THERMAL_OVERLOAD (exceeds thermal rating), VOLTAGE_HIGH (voltage exceeds upper limit), VOLTAGE_LOW (voltage below lower limit), or STABILITY (transient or voltage stability issue)."@en ;
    rdfs:domain cmm:ContingencyMonitoredElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Type" ;
    cmm:cimDatatype "String" .

cmm:ControlCenter a owl:Class ;
    rdfs:label "Control Center"@en ;
    rdfs:comment "Master reference table for control_center. Referenced by control_center_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.control_center" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 60870-6 ICCP" ;
    cmm:sourceObject "energy_utilities_ecm.grid.control_center" ;
    owl:hasKey ( cmm:ControlCenter.controlCenterId ) .

cmm:ControlCenter.controlCenterId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control center id"@en ;
    rdfs:comment "Primary key for control_center"@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:long ;
    cmm:physicalColumn "control_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Control Center Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ControlCenter.backupControlCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "backup control center"@en ;
    rdfs:comment "Identifier of an alternate control center used for redundancy."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range cmm:ControlCenter ;
    cmm:physicalColumn "backup_control_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_center_backup_control_center_id" ;
    cmm:cimAssociation "IdentifiedObject.IdentifiedObject" .
cmm:ControlCenter.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Control centers are organizational entities that belong to a specific control area; adding control_center.control_area_id creates the necessary parent relationship and eliminates the silo."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_center_control_area_id" ;
    cmm:cimAssociation "IdentifiedObject.ControlArea" .
cmm:ControlCenter.address a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "Street address of the control center facility."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:ControlCenter.auditStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit status"@en ;
    rdfs:comment "Result of the most recent audit."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "audit_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ControlCenter.capacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity mw"@en ;
    rdfs:comment "Maximum electrical power capacity the control center can manage, expressed in megawatts."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlCenter.city a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "city"@en ;
    rdfs:comment "City where the control center is located."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.name .
cmm:ControlCenter.code a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "code"@en ;
    rdfs:comment "External business code or tag used to reference the control center in operational systems."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "control_center_code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ControlCenter.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date the control center became operational and entered service."@en ;
    rdfs:domain cmm:ControlCenter ; rdfs:range xsd:date ;
