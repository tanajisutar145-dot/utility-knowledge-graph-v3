cmm:CustomerInvoice.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Bilateral wholesale energy trades delivered outside ISO markets generate direct customer invoices requiring trade reference for settlement reconciliation, revenue recognition, and regulatory audit tra"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
