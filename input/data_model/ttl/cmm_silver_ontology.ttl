cmm:RateSchedule.hasSeasonalRates a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has seasonal rates"@en ;
    rdfs:comment "Indicates whether this rate schedule includes seasonal rate variations for summer and winter periods."@en ;
