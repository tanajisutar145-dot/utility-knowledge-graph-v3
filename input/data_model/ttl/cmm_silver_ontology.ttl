    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ResourceBid.createdDateTime .
cmm:AncillaryServiceOffer.isoRtoMarket a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto market"@en ;
    rdfs:comment "The ISO or RTO market to which this ancillary service offer was submitted (PJM, MISO, CAISO, ERCOT, NYISO, ISO-NE, SPP). Reference-value candidates: PJM|MISO|CAISO|ERCOT|NYISO|ISONE|SPP."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_market" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Market" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceOffer.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this ancillary service offer record was last updated or modified. Audit trail field for record lifecycle tracking."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AncillaryServiceOffer.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "The type of market for which the ancillary service offer was submitted: day-ahead market (DAM), real-time market (RTM), or hour-ahead market."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Type" ;
    cmm:validValues "day_ahead|real_time|hour_ahead" ;
