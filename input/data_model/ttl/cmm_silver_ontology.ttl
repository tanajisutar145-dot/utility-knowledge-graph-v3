cmm:Grievance.managementResponse a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "management response"@en ;
    rdfs:comment "Written response from management to the grievance, including rationale for the decision and interpretation of CBA provisions."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
