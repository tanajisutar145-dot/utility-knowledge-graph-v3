cmm:ApplicationDocument.confidentialFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidential flag"@en ;
    rdfs:comment "Indicates whether the document contains confidential or proprietary information that requires restricted access. True if confidential, False if public or internal."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "confidential_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidential Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationDocument.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the document record was first created in the interconnection application system."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
