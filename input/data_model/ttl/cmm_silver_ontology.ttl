cmm:DrAggregator.performanceBondAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance bond amount"@en ;
    rdfs:comment "Dollar value of the performance bond or financial guarantee posted by the aggregator to ensure compliance with contractual capacity commitments and performance obligations."@en ;
