cmm:BillingServiceAgreement.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when the billing service agreement terminates and billing ceases. Nullable for open-ended agreements. Aligns with service disconnection or move-out date."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:date ;
