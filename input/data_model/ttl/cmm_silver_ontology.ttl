cmm:CrewAssignment.shiftPattern a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift pattern"@en ;
    rdfs:comment "Work shift pattern or schedule applicable to this crew assignment, such as day shift, night shift, rotating shift, on-call, or 24/7 coverage pattern."@en ;
