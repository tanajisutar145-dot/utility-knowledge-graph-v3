    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pollutant Type" ;
    cmm:validValues "SO2|NOx|CO2|Mercury|PM2.5|PM10" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.qaQcCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qa qc completion date"@en ;
    rdfs:comment "The date when quality assurance and quality control procedures were completed for the emissions data."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "qa_qc_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
