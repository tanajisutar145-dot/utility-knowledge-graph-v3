cmm:SelfReport.closureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure date"@en ;
    rdfs:comment "Date when the self-report case was formally closed by the regulatory authority with no further action required."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "closure_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closure Date" ;
    cmm:cimDatatype "Date" .
cmm:SelfReport.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Additional notes, context, or supplementary information relevant to this self-report record."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:SelfReport.complianceOfficerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance officer name"@en ;
    rdfs:comment "Name of the compliance officer who prepared or reviewed the self-report submission."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_officer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Officer Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:SelfReport.cooperationCreditAppliedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cooperation credit applied flag"@en ;
    rdfs:comment "Indicates whether additional credit was granted for exceptional cooperation during the regulatory review process."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cooperation_credit_applied_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cooperation Credit Applied Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SelfReport.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this self-report record was first created in the system."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:SelfReport.creditAppliedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit applied flag"@en ;
    rdfs:comment "Indicates whether the regulatory authority granted credit or penalty reduction for proactive self-reporting."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "credit_applied_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
