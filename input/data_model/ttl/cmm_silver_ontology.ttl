    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deployment Plant Code" ;
    cmm:cimDatatype "String" .
cmm:EmergencyStockEvent.emergencyPoNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency po number"@en ;
    rdfs:comment "Purchase order number created for emergency procurement if sourcing method is emergency PO."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_po_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emergency Purchase Order (PO) Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EmergencyStockEvent.eventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event number"@en ;
    rdfs:comment "Business identifier for the emergency stock event, externally known reference number used in communications and reporting."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emergency Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EmergencyStockEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the emergency stock event from declaration through closure and post-event review."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emergency Event Status" ;
    cmm:validValues "declared|active|materials_deployed|restoration_complete|closed|under_review" ;
    cmm:cimDatatype "String" ;
