cmm:TaxProvision a owl:Class ;
    rdfs:label "Tax Provision"@en ;
    rdfs:comment "Corporate income tax provision record capturing current and deferred tax components per legal entity and fiscal period. Records pre-tax income, statutory tax rate, effective tax rate, current tax expense, deferred tax asset and liability movements (ADIT), uncertain tax positions (FIN 48), and regulatory flow-through vs. normalized accounting treatment per FERC/PUC requirements. Includes excess deferred income tax (EDIT) tracking per Tax Cuts and Jobs Act provisions. Supports SOX tax controls, FERC Form 1 tax schedules, and rate case tax normalization filings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.finance.tax_provision" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ASC 740; ASC 740 Income Tax Provision / FERC Tax Normalization" ;
    cmm:sourceObject "energy_utilities_ecm.finance.tax_provision" ;
    owl:hasKey ( cmm:TaxProvision.taxProvisionId ) .

cmm:TaxProvision.taxProvisionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax provision id"@en ;
    rdfs:comment "Unique identifier for the corporate income tax provision record. Primary key for the tax provision entity."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:long ;
    cmm:physicalColumn "tax_provision_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Tax Provision Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:TaxProvision.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the user who last modified this tax provision record."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TaxProvision.legalEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "legal entity"@en ;
    rdfs:comment "Reference to the legal entity for which this tax provision is recorded. Supports multi-entity consolidated financial reporting."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:FinanceLegalEntity ;
    cmm:physicalColumn "legal_entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Legal Entity Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_legal_entity_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:TaxProvision.primaryTaxEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary tax employee"@en ;
    rdfs:comment "Reference to the user or employee who prepared this tax provision record."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_tax_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_primary_tax_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TaxProvision.reviewerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer employee"@en ;
    rdfs:comment "Reference to the user or employee who reviewed and approved this tax provision record."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "reviewer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reviewer Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_reviewer_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TaxProvision.soxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sox control"@en ;
    rdfs:comment "The SOX control identifier associated with this tax provision record for internal control testing and audit trail purposes."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "sox_control_id" ;
