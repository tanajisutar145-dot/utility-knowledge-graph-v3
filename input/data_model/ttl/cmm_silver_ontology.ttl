cmm:Crew.unionJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union jurisdiction"@en ;
    rdfs:comment "Labor union local or jurisdiction governing crew members. Determines work rules, overtime provisions, and mutual aid deployment eligibility per collective bargaining agreement."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Jurisdiction" ;
    cmm:cimDatatype "String" .

cmm:CrewAssignment a owl:Class ;
    rdfs:label "Crew Assignment"@en ;
    rdfs:comment "Transactional records linking individual employees to crews for specific operational periods, capturing role within the crew (crew lead, journeyman lineman, apprentice, equipment operator), assignment start/end dates, and whether the assignment is a standing assignment or a temporary storm/emergency augmentation. Supports crew composition tracking and labor cost allocation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CrewMember ;
    cmm:cimCloseMatch cim:CrewMember ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.crew_assignment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-11 Common; GE PowerOn ADMS Crew Roster" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.crew_assignment" ;
    owl:hasKey ( cmm:CrewAssignment.crewAssignmentId ) .

cmm:CrewAssignment.crewAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew assignment id"@en ;
    rdfs:comment "Unique identifier for the crew assignment record. Primary key for the crew assignment entity."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "crew_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Crew Assignment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CrewAssignment.crewEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Each crew assignment record identifies which employee is assigned. Without this FK, crew composition is unknown and labor cost allocation to crew work is impossible."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "crew_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_assignment_crew_employee_id" ;
    cmm:cimAssociation "CrewMember.ErpPersonnel" .
cmm:CrewAssignment.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — crew_assignment links an employee to a crew. Without FK to employee, you cannot determine crew composition for dispatch, safety compliance, or labor costing."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_assignment_employee_id" ;
    cmm:cimAssociation "CrewMember.ErpPersonnel" .
cmm:CrewAssignment.primaryCrewEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary crew employee"@en ;
    rdfs:comment "Unique identifier for the employee being assigned to the crew. Links to the employee master record in the workforce domain."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_crew_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_assignment_primary_crew_employee_id" ;
    cmm:cimAssociation "CrewMember.ErpPersonnel" .
cmm:CrewAssignment.primaryCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary crew"@en ;
    rdfs:comment "Unique identifier for the crew to which the employee is assigned. Links to the crew master record."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "primary_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Identifier (ID)" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_assignment_primary_crew_id" ;
    cmm:cimAssociation "CrewMember.Crew" .
cmm:CrewAssignment.workLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work location"@en ;
    rdfs:comment "Identifier for the primary work location or service center where the crew is based and from which the employee operates during this assignment."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range cmm:WorkLocation ;
    cmm:physicalColumn "work_location_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Location Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_assignment_work_location_id" ;
    cmm:cimAssociation "CrewMember.WorkLocation" .
cmm:CrewAssignment.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the crew assignment was approved by the authorized supervisor or workforce manager."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CrewAssignment.assignmentApprovalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment approval status"@en ;
    rdfs:comment "Approval workflow status for the crew assignment. Indicates whether the assignment has been approved by the appropriate supervisor or workforce manager."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Approval Status" ;
    cmm:validValues "pending|approved|rejected|cancelled" ;
    cmm:cimDatatype "String" .
cmm:CrewAssignment.assignmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment end date"@en ;
    rdfs:comment "The date on which the employee's assignment to the crew ends or is scheduled to end. Null for open-ended standing assignments."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment End Date" ;
    cmm:cimDatatype "Date" .
cmm:CrewAssignment.assignmentEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment end timestamp"@en ;
    rdfs:comment "Precise date and time when the crew assignment ends, used for shift-level and emergency response tracking where exact timing is critical."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "assignment_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CrewAssignment.assignmentNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment notes"@en ;
    rdfs:comment "Free-text notes or comments related to the crew assignment, capturing special instructions, restrictions, accommodation requirements, or other relevant information."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CrewAssignment.assignmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment number"@en ;
    rdfs:comment "Business-facing unique identifier for the crew assignment, used for tracking and reporting purposes. Format: CA-NNNNNNNN."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Assignment Number" ;
    cmm:valuePattern "^CA-[0-9]{8}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CrewAssignment.assignmentPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment priority"@en ;
    rdfs:comment "Priority level of the crew assignment indicating urgency and importance. Critical for emergency response, high for storm restoration, normal for routine operations, low for training or development assignments."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Priority" ;
    cmm:validValues "critical|high|normal|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:CrewAssignment.assignmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment reason"@en ;
    rdfs:comment "Business reason or justification for the crew assignment, such as regular staffing, skill gap coverage, storm response, mutual aid request, training rotation, or backfill for absence."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Reason" ;
    cmm:cimDatatype "String" .
cmm:CrewAssignment.assignmentSourceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment source code"@en ;
    rdfs:comment "Unique identifier of this crew assignment record in the source system, used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_source_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Source Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CrewAssignment.assignmentSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment source system"@en ;
    rdfs:comment "Name or code of the source system from which this crew assignment record originated, such as SAP HCM, workforce management system, or emergency response system."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Source System" ;
    cmm:cimDatatype "String" .
cmm:CrewAssignment.assignmentStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment start date"@en ;
    rdfs:comment "The date on which the employee's assignment to the crew becomes effective. Represents the beginning of the assignment period."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CrewAssignment.assignmentStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment start timestamp"@en ;
    rdfs:comment "Precise date and time when the crew assignment becomes effective, used for shift-level and emergency response tracking where exact timing is critical."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "assignment_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CrewAssignment.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Current lifecycle status of the crew assignment indicating whether the assignment is currently active, inactive, temporarily suspended, pending approval, or completed."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Assignment Status" ;
