cmm:TopologySnapshot.topologyProcessorRunReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology processor run reference"@en ;
    rdfs:comment "Unique reference identifier or sequence number assigned by the EMS topology processor for this specific run. Used for traceability and audit purposes."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:string ;
