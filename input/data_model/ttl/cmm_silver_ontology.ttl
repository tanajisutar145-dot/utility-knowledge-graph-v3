    cmm:cimCloseMatch cim:Document.status .
cmm:EnvironmentalPermit.permitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permit type"@en ;
    rdfs:comment "Classification of the environmental permit based on the regulatory program and environmental media regulated. Determines applicable compliance requirements and reporting obligations."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
