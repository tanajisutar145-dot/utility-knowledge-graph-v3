    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "Name of the major North American interconnection to which this control area belongs (Eastern, Western, Texas, or Quebec)."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
