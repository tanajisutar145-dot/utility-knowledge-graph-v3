cmm:TechnicalReview.fastTrackScreen1Result a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fast track screen 1 result"@en ;
    rdfs:comment "Result of Fast Track Screen 1 evaluation (Distributed Energy Resource (DER) capacity vs feeder minimum load). Pass indicates the DER meets the 15% rule threshold."@en ;
