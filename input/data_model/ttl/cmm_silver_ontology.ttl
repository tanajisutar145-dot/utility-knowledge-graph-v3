cmm:CostResponsibility.refundAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund amount"@en ;
    rdfs:comment "Dollar amount eligible for refund to the applicant in USD. Applicable when actual costs are lower than estimated or when refund provisions are triggered."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "refund_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CostResponsibility.refundEligibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund eligibility flag"@en ;
    rdfs:comment "Indicates whether the applicant is eligible for a refund of any portion of their cost share. True if refund provisions exist per agreement or tariff."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "refund_eligibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Eligibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostResponsibility.regulatoryDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory docket number"@en ;
    rdfs:comment "PUC or FERC docket number associated with cost allocation approval or dispute. Links cost responsibility to regulatory proceedings."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CostResponsibility.sgipEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip eligible flag"@en ;
    rdfs:comment "Indicates whether this cost is eligible for SGIP incentive reimbursement (California-specific program). True if costs qualify for SGIP offset."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_eligible_flag" ;
