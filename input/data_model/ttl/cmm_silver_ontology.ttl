cmm:ControlArea.stateEstimatorEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimator enabled"@en ;
    rdfs:comment "Indicates whether the EMS state estimator function is active for real-time network model solving and contingency analysis."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "state_estimator_enabled" ;
