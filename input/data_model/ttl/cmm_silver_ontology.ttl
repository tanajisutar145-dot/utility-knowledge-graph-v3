cmm:Crew a owl:Class ;
    rdfs:label "Crew"@en ;
    rdfs:comment "Field crew master records and deployment tracking for transmission and distribution construction, storm restoration, substation maintenance, and generation plant outage work. Captures crew type (line crew, cable crew, substation crew, generation maintenance crew, vegetation management crew), home base/service center location, crew size, crew lead employee reference, union jurisdiction, vehicle/equipment assignment, and operational readiness status. Includes mutual aid deployment records for crews mobilized under EEI/EATON mutual aid agreements during major storm events or grid emergencies — capturing requesting/providing utility, deployment dates, work location, restoration tasks performed, number of personnel, and reimbursable cost for FEMA reimbursement and post-storm after-action reporting. SSOT for crew identity, composition, and deployment lifecycle. Crews are the primary dispatch unit in OMS and ADMS and the cost collection unit for field labor."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Crew ;
    cmm:cimExactMatch cim:Crew ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.crew" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-11 Common; GE PowerOn ADMS Crew Management" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.crew" ;
    owl:hasKey ( cmm:Crew.crewId ) .

cmm:Crew.crewId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew id"@en ;
    rdfs:comment "Unique identifier for the field crew. Primary key for crew master records."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:long ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Crew Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:Crew.contractorCompany a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor company"@en ;
    rdfs:comment "FK to supply.contractor_company"@en ;
    rdfs:domain cmm:Crew ; rdfs:range cmm:ContractorCompany ;
    cmm:physicalColumn "contractor_company_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_contractor_company_id" ;
    cmm:cimAssociation "Crew.Organisation" .
cmm:Crew.crewEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Each crew has a crew lead who is an employee. Required for crew dispatch, accountability, and labor cost allocation."@en ;
    rdfs:domain cmm:Crew ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "crew_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_crew_employee_id" ;
    cmm:cimAssociation "Crew.ErpPersonnel" .
cmm:Crew.crewLeadEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew lead employee"@en ;
    rdfs:comment "Reference to the employee serving as crew lead or foreman. Responsible for crew safety, work quality, and coordination with dispatch."@en ;
    rdfs:domain cmm:Crew ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "crew_lead_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Lead Employee Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_crew_lead_employee_id" ;
    cmm:cimAssociation "Crew.ErpPersonnel" .
cmm:Crew.crewOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew org unit"@en ;
    rdfs:comment "Reference to the service center or operations base where the crew is permanently assigned. Determines jurisdiction, dispatch priority, and resource allocation."@en ;
    rdfs:domain cmm:Crew ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "crew_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Home Service Center Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_crew_org_unit_id" ;
    cmm:cimAssociation "Crew.Organisation" .
cmm:Crew.orgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "org unit"@en ;
    rdfs:comment "FK to workforce.org_unit.org_unit_id — Crews belong to organizational units (e.g., Distribution Field Services, Transmission Operations). FK required for cost center allocation and management reporting."@en ;
    rdfs:domain cmm:Crew ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_crew_org_unit_id" ;
    cmm:cimAssociation "Crew.Organisation" .
cmm:Crew.averageResponseTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average response time minutes"@en ;
    rdfs:comment "Historical average time in minutes from dispatch to arrival at work site. Used for dispatch planning and System Average Interruption Duration Index (SAIDI) / System Average Interruption Frequency Index (SAIFI) performance analysis."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:int ;
    cmm:physicalColumn "average_response_time_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Response Time Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:Crew.certificationLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification level"@en ;
    rdfs:comment "Highest certification or skill level represented in the crew. Determines work authorization scope (e.g., voltage class, confined space, energized work)."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Certification Level" ;
    cmm:validValues "apprentice|journeyman|master|specialized" ;
    cmm:cimDatatype "String" .
cmm:Crew.contractorCrewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor crew flag"@en ;
    rdfs:comment "Indicates whether this is a contractor crew (true) or utility employee crew (false). Affects cost allocation, insurance requirements, and work authorization rules."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contractor_crew_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contractor Crew Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Crew.costAllocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation code"@en ;
    rdfs:comment "General Ledger (GL) or work management system code for allocating crew labor costs to work orders, capital projects, or Operations and Maintenance (O&M) accounts. Critical for regulatory cost recovery."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Code" ;
    cmm:valuePattern "^[A-Z0-9]{6,12}$" ;
    cmm:cimDatatype "String" .
cmm:Crew.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the crew record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Crew.createdDateTime .
cmm:Crew.crewCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew code"@en ;
    rdfs:comment "Business identifier for the crew used in operational systems, work orders, and dispatch communications. Typically alphanumeric code assigned by service center or region."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Crew.crewName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew name"@en ;
    rdfs:comment "Human-readable name or designation of the crew, often including service center and crew number (e.g., 'Metro East Line Crew 3', 'Substation Maintenance Team A')."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Crew Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:Crew.crewStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew status"@en ;
    rdfs:comment "Current operational status of the crew. Active crews are available for dispatch; deployed crews are on assignment; standby crews are on-call; inactive crews are not available for work."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Operational Status" ;
    cmm:validValues "active|inactive|deployed|standby|training|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Crew.status .
cmm:Crew.crewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type"@en ;
    rdfs:comment "Classification of crew by primary function and skill set. Determines work order assignment eligibility, equipment requirements, and safety protocols. Reference-value candidates: line_crew|cable_crew|substation_crew|generation_maintenance_crew|vegetation_management_crew|meter_crew|emergency_response_crew|construction_crew|inspection_crew."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Crew.kind .
cmm:Crew.deploymentPersonnelCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deployment personnel count"@en ;
    rdfs:comment "Number of crew members deployed on mutual aid assignment. May differ from standard crew size due to augmentation or splitting for deployment."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:int ;
    cmm:physicalColumn "deployment_personnel_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deployment Personnel Count" ;
    cmm:cimDatatype "Integer" .
cmm:Crew.dispatchPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority"@en ;
    rdfs:comment "Numeric priority ranking for crew dispatch in Outage Management System (OMS) and Advanced Distribution Management System (ADMS). Lower numbers indicate higher priority (1=highest). Based on crew capability, location, and availability."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:int ;
    cmm:physicalColumn "dispatch_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Priority" ;
    cmm:cimDatatype "Integer" .
cmm:Crew.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date the crew was disbanded or deactivated. Null for active crews. Used for historical reporting and workforce planning analysis."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:Crew.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date the crew was formed or became operational. Used for crew history tracking and performance trend analysis."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:Crew.equipmentAssignment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment assignment"@en ;
    rdfs:comment "List or description of specialized equipment assigned to the crew (e.g., bucket truck, digger derrick, cable splicer, hot stick kit). Determines work capability and safety compliance."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_assignment" ;
