    cmm:cimDatatype "Date" .
cmm:EmissionsReport.reportingPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting period start date"@en ;
    rdfs:comment "The start date of the emissions reporting period covered by this report."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "reporting_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
