cmm:TransmissionOutage.outageStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage status"@en ;
    rdfs:comment "Current lifecycle state of the transmission outage event. Tracks progression from scheduling through restoration."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Status" ;
    cmm:validValues "scheduled|active|restored|cancelled|extended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.status .
cmm:TransmissionOutage.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event indicating whether it was scheduled in advance (planned/maintenance) or occurred unexpectedly (forced/emergency). Critical for reliability metrics calculation."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "planned|forced|maintenance|emergency|testing|regulatory" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.type .
cmm:TransmissionOutage.restorationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration method"@en ;
    rdfs:comment "Description of the method used to restore the facility (e.g., repair, replacement, temporary bypass, switching operation)."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Method" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.restorationPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration priority"@en ;
    rdfs:comment "Priority level assigned to the restoration effort based on system impact, customer criticality, and reliability considerations."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.rtoIsoNotificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso notification status"@en ;
    rdfs:comment "Status of notification to the RTO/ISO. Tracks compliance with coordination timelines and communication protocols."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_notification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Notification Status" ;
    cmm:validValues "notified|pending|not_required|delayed" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.rtoIsoNotificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso notification timestamp"@en ;
    rdfs:comment "Date and time when the RTO/ISO was notified of the outage event. Required for compliance with outage coordination procedures."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rto_iso_notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
