    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PlantVendorAgreement.contractType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract type"@en ;
    rdfs:comment "Classification of the primary service or product category covered by this plant-vendor agreement."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Type" ;
