    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recommended Upgrades" ;
    cmm:cimDatatype "String" .
cmm:StudyPathAnalysis.stabilityIssuesCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stability issues count"@en ;
    rdfs:comment "Number of transient or dynamic stability issues identified on this specific path during this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:int ;
    cmm:physicalColumn "stability_issues_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
