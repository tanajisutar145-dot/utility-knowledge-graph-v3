cmm:TopologySnapshot.snapshotTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "snapshot timestamp"@en ;
    rdfs:comment "The precise date and time when the topology snapshot was captured by the EMS topology processor. Represents the real-world moment of the network connectivity state."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "snapshot_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Snapshot Timestamp" ;
