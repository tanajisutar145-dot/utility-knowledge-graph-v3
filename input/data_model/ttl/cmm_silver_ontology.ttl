    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violated Standard Code" ;
    cmm:cimDatatype "String" .
cmm:SelfReport.violationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation description"@en ;
    rdfs:comment "Detailed narrative description of the alleged violation, non-compliance condition, or compliance exception being self-reported."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Description" ;
    cmm:cimDatatype "String" .
cmm:SelfReport.violationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
