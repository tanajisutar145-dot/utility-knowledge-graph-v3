cmm:Certification a owl:Class ;
    rdfs:label "Certification"@en ;
    rdfs:comment "Master catalog of all required certifications, licenses, qualifications, and training programs applicable to utility workforce roles, including safety training curricula and session delivery records. Covers externally-issued certifications (NERC CIP PRA clearance, OSHA 10/30, CDL, state electrical contractor license, first aid/CPR), internally-assessed qualifications (journeyman lineman, substation operator, generation unit operator, SCADA operator authorization), and mandatory safety and compliance training programs (lockout/tagout, confined space entry, arc flash safety, fall protection, hazmat, NERC CIP security awareness). Defines credential name, credential category (certification, qualification, training), issuing body or internal program owner, validity period, renewal cycle, delivery method options (classroom, online, field), pass/fail criteria, instructor requirements, and whether it is mandatory for specific job classifications or NERC CIP access roles. Training session delivery records capture session date, instructor, delivery method, attendees, completion status, and next required date. SSOT for all credential definitions and training program delivery in the utility workforce."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Skill ;
    cmm:cimCloseMatch cim:Skill ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfCommon" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.certification" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "NERC CIP-004 Personnel Risk Assessment; OSHA 1910/1926" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.certification" ;
    owl:hasKey ( cmm:Certification.certificationId ) .

cmm:Certification.certificationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification id"@en ;
    rdfs:comment "Unique identifier for the certification, qualification, or training program record. Primary key for the certification master catalog."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:long ;
    cmm:physicalColumn "certification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Certification ID" ;
    cmm:cimDatatype "Integer" .
cmm:Certification.applicableJobClassifications a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable job classifications"@en ;
    rdfs:comment "Comma-separated list of job classification codes or titles for which this certification or training is mandatory or recommended (e.g., Lineman, Substation Operator, Generation Unit Operator, SCADA Operator, Meter Reader, Field Service Technician). Used for workforce compliance tracking and training assignment."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_job_classifications" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Job Classifications" ;
    cmm:cimDatatype "String" .
cmm:Certification.applicableNercCipRoles a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable nerc cip roles"@en ;
    rdfs:comment "Comma-separated list of NERC CIP access roles or cyber security positions for which this certification is required (e.g., CIP Senior Manager, CIP Authorized User, Physical Security Perimeter Access, Electronic Security Perimeter Access). Null if not applicable to NERC CIP roles."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_nerc_cip_roles" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable NERC CIP (North American Electric Reliability Corporation Critical Infrastructure Protection) Roles" ;
    cmm:cimDatatype "String" .
cmm:Certification.certificationCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification category"@en ;
    rdfs:comment "High-level classification of the credential type. External certifications are issued by third-party bodies (NERC, OSHA, state licensing boards). Internal qualifications are assessed by utility subject matter experts. Training programs are mandatory or elective learning curricula."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Category" ;
    cmm:validValues "external_certification|internal_qualification|safety_training|compliance_training|technical_training|leadership_training" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Skill.kind .
cmm:Certification.certificationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification code"@en ;
    rdfs:comment "Unique business identifier code for the certification, qualification, or training program. Used for external reference and system integration (e.g., NERC-CIP-PRA, OSHA-30, CDL-A, LINEMAN-JOURNEYMAN)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{3,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Certification.certificationLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification level"@en ;
    rdfs:comment "Hierarchical level or grade of the certification within a progression path (e.g., Apprentice, Journeyman, Master; Level 1, Level 2, Level 3; Basic, Intermediate, Advanced). Used for career development planning and pay grade determination. Null if not part of a leveled progression."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Certification Level" ;
    cmm:cimDatatype "String" .
cmm:Certification.certificationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification name"@en ;
    rdfs:comment "Full official name of the certification, qualification, or training program (e.g., NERC CIP Personnel Risk Assessment Clearance, OSHA 30-Hour Construction Safety, Commercial Driver License Class A, Journeyman Lineman Qualification)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Certification Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:Certification.certificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification status"@en ;
    rdfs:comment "Current lifecycle status of the certification or training program in the utility workforce management system. Active programs are available for assignment and tracking. Inactive programs are temporarily suspended. Retired programs are no longer offered but historical records are retained."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Status" ;
    cmm:validValues "active|inactive|retired|under_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Skill.status .
cmm:Certification.certificationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification type"@en ;
    rdfs:comment "Detailed sub-classification of the certification within its category (e.g., NERC CIP Security Clearance, OSHA Safety Training, State Electrical License, CDL Endorsement, Operator Authorization, Safety Qualification, Technical Skill Assessment)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Skill.type .
cmm:Certification.continuingEducationHoursRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "continuing education hours required"@en ;
    rdfs:comment "Number of continuing education hours or CEUs required per renewal cycle to maintain the certification. Null if continuing education is not required."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "continuing_education_hours_required" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Continuing Education Hours Required" ;
    cmm:cimDatatype "Decimal" .
cmm:Certification.continuingEducationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "continuing education required flag"@en ;
    rdfs:comment "Indicates whether this certification requires continuing education units (CEUs) or professional development hours to maintain active status. True if ongoing learning is mandated by the issuing body or utility policy."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "continuing_education_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Continuing Education Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Certification.costPerParticipant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost per participant"@en ;
    rdfs:comment "Average cost in USD to train or certify one employee, including instructor fees, materials, facility costs, external exam fees, and travel expenses. Used for workforce training budget planning and labor cost allocation to capital projects and work orders."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_per_participant" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Per Participant" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:Certification.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this certification record was first created in the workforce management system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
