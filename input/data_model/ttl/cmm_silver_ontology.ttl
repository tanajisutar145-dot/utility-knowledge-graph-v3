cmm:IncentiveApplication.projectLocationPostalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project location postal code"@en ;
    rdfs:comment "ZIP or postal code for the renewable energy project location."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:string ;
