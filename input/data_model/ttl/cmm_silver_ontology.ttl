cmm:Certification.issuingBody a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing body"@en ;
    rdfs:comment "Name of the external organization or internal department that issues, assesses, or administers the certification or training program (e.g., NERC, OSHA, State Department of Motor Vehicles, State Electrical Licensing Board, Internal Training Department, Operations Department)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_body" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Body" ;
