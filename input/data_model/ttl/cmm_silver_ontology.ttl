cmm:CustomerInvoice.toCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to cycle"@en ;
    rdfs:comment "FK to billing.billing_cycle.billing_cycle_id — Every invoice is generated within a billing cycle run. This FK supports billing operations monitoring and revenue cycle timing."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_cycle" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInvoice.toSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Every invoice is generated for a specific service agreement. This FK is essential for tracing billed amounts back to the contractual billing relationship."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInvoice.totalAmountDue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total amount due"@en ;
    rdfs:comment "Net total amount the customer must pay, calculated as previous balance plus current charges plus taxes plus adjustments."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_amount_due" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Amount Due" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerInvoice.writeOffAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off amount"@en ;
    rdfs:comment "Amount of this invoice written off as uncollectible bad debt, subject to SOX financial controls and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "write_off_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line"@en ;
    rdfs:comment "Line-item detail for each charge component on a utility invoice, including energy charges, demand charges, customer charges, fuel adjustment clauses, distribution riders, taxes, and credits. Stores rate component reference, quantity, unit rate, calculated amount, and applicable billing determinant. Enables granular revenue recognition and rate component-level analysis. Sourced from SAP IS-U FICA and Oracle CC&B billing line detail."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpInvoiceLineItem ;
    cmm:cimCloseMatch cim:ErpInvoiceLineItem ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.invoice_processing ;
    cmm:physicalTable "utility_cmm_silver.billing.invoice_line" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; Bill Line Item / Charge Detail" ;
    cmm:sourceObject "energy_utilities_ecm.billing.invoice_line" ;
    owl:hasKey ( cmm:InvoiceLine.invoiceLineId ) .

cmm:InvoiceLine.invoiceLineId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice line id"@en ;
    rdfs:comment "Unique identifier for the invoice line item. Primary key for the invoice line detail record."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:long ;
    cmm:physicalColumn "invoice_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Invoice Line ID" ;
    cmm:cimDatatype "Integer" .
cmm:InvoiceLine.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Revenue allocation to cost centers enables internal performance reporting, cost-of-service studies for rate cases, and regulatory reporting by functional area. Essential for FERC Form 1 preparation an"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_cost_center_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Organisation" .
cmm:InvoiceLine.drIncentivePayment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr incentive payment"@en ;
    rdfs:comment "Foreign key linking to demand.dr_incentive_payment. Business justification: Individual invoice line items represent specific DR incentive credits at granular level. Detailed billing reconciliation, audit trails, dispute resolution, and regulatory reporting require line-level"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:DrIncentivePayment ;
    cmm:physicalColumn "dr_incentive_payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Incentive Payment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_dr_incentive_payment_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Transaction" .
cmm:InvoiceLine.fromRateComponent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "from rate component"@en ;
    rdfs:comment "FK to billing.rate_component.rate_component_id — Each invoice line item is calculated from a specific rate component. This FK enables rate-component-level revenue analysis and bill audit trails. Critical for regulatory rate case support."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:RateComponent ;
    cmm:physicalColumn "from_rate_component_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "rate_component_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_from_rate_component_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Charge" .
cmm:InvoiceLine.invoiceRateComponent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice rate component"@en ;
    rdfs:comment "Foreign key linking to billing.rate_component. Business justification: Each invoice line item is calculated using a specific rate component definition from the rate schedule. Currently invoice_line has rate_component_code (STRING) which is a denormalized reference. Addin"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:RateComponent ;
    cmm:physicalColumn "invoice_rate_component_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Component Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_invoice_rate_component_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Charge" .
cmm:InvoiceLine.originalLineInvoiceLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original line invoice line"@en ;
    rdfs:comment "Reference to the original invoice line item being reversed or corrected. Null for original charges. Maintains audit trail for billing adjustments."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:InvoiceLine ;
    cmm:physicalColumn "original_line_invoice_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Line ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_original_line_invoice_line_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.ErpInvoiceLineItem" .
cmm:InvoiceLine.primaryInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary invoice"@en ;
    rdfs:comment "Reference to the parent invoice header. Links this line item to the billing document."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "primary_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice ID" ;
    cmm:sourceColumn "invoice_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_primary_invoice_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.CustomerBillingInfo" .
cmm:InvoiceLine.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Revenue attribution to profit centers supports segment reporting, FERC functional classification (generation/transmission/distribution), and business unit profitability analysis. Required for regulato"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_profit_center_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Organisation" .
cmm:InvoiceLine.soxControlTest a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sox control test"@en ;
    rdfs:comment "Foreign key linking to compliance.sox_control_test. Business justification: SOX control testing samples specific invoice line items to verify billing accuracy controls and revenue recognition. Links the tested line item to the control test for audit evidence, sample documenta"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:SoxControlTest ;
    cmm:physicalColumn "sox_control_test_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Sox Control Test Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_sox_control_test_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.ActivityRecord" .
cmm:InvoiceLine.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Individual invoice line items may represent specific wholesale trade settlements, particularly for bilateral contracts with retail pass-through pricing where each trade leg generates a separate billin"@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_line_trade_id" ;
    cmm:cimAssociation "ErpInvoiceLineItem.Trade" .
cmm:InvoiceLine.adjustmentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment description"@en ;
    rdfs:comment "Human-readable description of the adjustment reason for customer communication and audit trail. Null for standard charges."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Description" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.adjustmentReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment reason code"@en ;
    rdfs:comment "Code identifying the reason for any adjustment applied to this line item (e.g., REBILL, CREDIT, DISPUTE, CORRECTION). Null for standard charges."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.billingDeterminantQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing determinant quantity"@en ;
    rdfs:comment "Quantity of the billing determinant used in the rate calculation (e.g., kWh consumed, peak kW demand, number of days). Precision supports interval meter data."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "billing_determinant_quantity" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Determinant Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:InvoiceLine.billingDeterminantType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing determinant type"@en ;
    rdfs:comment "Type of billing determinant used to calculate this charge (e.g., kWh for energy consumption, kW for demand, days for fixed charges, percentage for adjustments). Reference-value candidates: kwh|kw|mwh|mw|days|units|flat|percentage."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_determinant_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Determinant Type" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.chargeCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "charge category"@en ;
    rdfs:comment "High-level classification of the charge type for revenue recognition and financial reporting. Groups rate components into standard categories. Reference-value candidates: energy|demand|customer|distribution|transmission|generation|tax|fee|adjustment|credit|rebate|penalty."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "charge_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Charge Category" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.consumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consumption kwh"@en ;
    rdfs:comment "Energy consumption in kilowatt-hours for this line item. Primary billing determinant for energy charges. Null for non-energy charges."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consumption Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:InvoiceLine.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this invoice line item record was first created in the billing system. Supports audit trail and data lineage for SOX compliance."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpInvoiceLineItem.createdDateTime .
cmm:InvoiceLine.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for the line item amounts. Supports multi-currency billing for international operations."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:validValues "USD|CAD|MXN|EUR|GBP" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:InvoiceLine.demandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand kw"@en ;
    rdfs:comment "Peak demand in kilowatts for this line item. Primary billing determinant for demand charges. Null for non-demand charges."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:InvoiceLine.disputeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute flag"@en ;
    rdfs:comment "Indicates whether this line item is under customer dispute. True if disputed, false otherwise. Supports dispute resolution and collections workflows."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispute_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InvoiceLine.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code for revenue recognition posting. Maps line item to chart of accounts for financial reporting and SOX compliance."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:valuePattern "^[0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.lineAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line amount"@en ;
    rdfs:comment "Calculated charge amount for this line item before taxes and adjustments. Result of billing determinant quantity multiplied by unit rate, or flat charge amount."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "line_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Line Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InvoiceLine.lineSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line sequence number"@en ;
    rdfs:comment "Sequential ordering of line items within the invoice. Determines display order on customer bill."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:int ;
    cmm:physicalColumn "line_sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Line Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:InvoiceLine.meterReadEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read end date"@en ;
    rdfs:comment "Date of the ending meter read used to calculate consumption for this charge. May differ from service period end for estimated or prorated bills."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "meter_read_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read End Date" ;
    cmm:cimDatatype "Date" .
cmm:InvoiceLine.meterReadStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read start date"@en ;
    rdfs:comment "Date of the beginning meter read used to calculate consumption for this charge. May differ from service period start for estimated or prorated bills."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "meter_read_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Start Date" ;
    cmm:cimDatatype "Date" .
cmm:InvoiceLine.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this invoice line item record was last modified. Supports audit trail and change tracking for SOX compliance."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InvoiceLine.printSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "print sequence"@en ;
    rdfs:comment "Display order for this line item on the printed or electronic customer bill. Controls presentation layout for customer readability."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:int ;
    cmm:physicalColumn "print_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Print Sequence" ;
    cmm:cimDatatype "Integer" .
cmm:InvoiceLine.printSuppressFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "print suppress flag"@en ;
    rdfs:comment "Indicates whether this line item should be suppressed from customer bill presentation. True if suppressed (internal accounting only), false if displayed to customer."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "print_suppress_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Print Suppress Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InvoiceLine.prorationFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "proration factor"@en ;
    rdfs:comment "Proration multiplier applied to this charge for partial billing periods (e.g., 0.5 for half-month service). Value of 1.0 indicates full period charge."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "proration_factor" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Proration Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:InvoiceLine.rateComponentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate component description"@en ;
    rdfs:comment "Human-readable description of the rate component or charge type for customer bill presentation (e.g., 'Energy Charge', 'Demand Charge', 'Customer Charge', 'Fuel Adjustment Clause')."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_component_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Component Description" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Code identifying the tariff rate schedule applied to this line item (e.g., RES-1, COM-2, IND-3). Links to approved tariff structure."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{2,20}$" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.rateVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate version"@en ;
    rdfs:comment "Effective date version of the rate schedule applied to this line item. Supports rate change tracking and historical billing accuracy."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Version" ;
    cmm:valuePattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Customer class for revenue reporting and regulatory compliance. Aligns with FERC and state PUC revenue classification requirements."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|public_authority|street_lighting" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this line item is a reversal of a previous charge. True for reversal entries, false for original charges. Supports rebilling and correction workflows."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InvoiceLine.servicePeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service period end date"@en ;
    rdfs:comment "End date of the service period covered by this line item charge. Defines the end of the consumption or service window."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:InvoiceLine.servicePeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service period start date"@en ;
    rdfs:comment "Start date of the service period covered by this line item charge. Defines the beginning of the consumption or service window."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:InvoiceLine.sourceLineReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source line reference"@en ;
    rdfs:comment "Original line item identifier from the source billing system. Maintains traceability to operational system of record for reconciliation and troubleshooting."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_line_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Line Reference" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the source billing system that generated this invoice line item. Supports multi-system integration and data lineage tracking."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "SAP_ISU|ORACLE_CCB|LEGACY_CIS" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "Tax amount applied to this line item. May include sales tax, utility tax, franchise fees, or other jurisdiction-specific taxes."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InvoiceLine.taxJurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax jurisdiction code"@en ;
    rdfs:comment "Code identifying the tax jurisdiction for this line item. Determines applicable tax rates and rules. Null for non-taxable items."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Jurisdiction Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.taxableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "taxable flag"@en ;
    rdfs:comment "Indicates whether this line item is subject to sales tax or utility tax. True if taxable, false if exempt."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "taxable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Taxable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InvoiceLine.tierLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tier level"@en ;
    rdfs:comment "Tier number for tiered rate structures (e.g., 1 for baseline, 2 for tier 2, 3 for tier 3). Null for non-tiered charges. Supports inclining block and declining block rate designs."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:int ;
    cmm:physicalColumn "tier_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tier Level" ;
    cmm:cimDatatype "Integer" .
cmm:InvoiceLine.totalLineAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total line amount"@en ;
    rdfs:comment "Total amount for this line item including taxes and adjustments. Sum of line amount and tax amount."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_line_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Line Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InvoiceLine.touPeriodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period code"@en ;
    rdfs:comment "Time-of-use period classification for this charge. Identifies whether consumption occurred during on-peak, off-peak, or other TOU periods. Null for non-TOU charges."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_period_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time of Use (TOU) Period Code" ;
    cmm:validValues "on_peak|off_peak|mid_peak|super_off_peak|critical_peak|standard" ;
    cmm:cimDatatype "String" .
cmm:InvoiceLine.unitRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit rate"@en ;
    rdfs:comment "Rate per unit applied to the billing determinant (e.g., dollars per kWh, dollars per kW, daily charge). High precision supports complex tariff calculations including TOU and CPP rates."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_rate" ;
    cmm:sqlDataType "DECIMAL(18,8)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:InvoiceLine.writeOffFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off flag"@en ;
    rdfs:comment "Indicates whether this line item has been written off as uncollectible. True if written off, false otherwise. Supports bad debt accounting and SOX controls."@en ;
    rdfs:domain cmm:InvoiceLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "write_off_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:CustomerPayment a owl:Class ;
    rdfs:label "Customer Payment"@en ;
    rdfs:comment "Transactional record of all customer payment activity including inbound payments received and outbound refunds disbursed against outstanding invoices or account balances. For inbound payments: captures payment date, amount, method (check, ACH, credit card, cash, online, auto-pay), channel (IVR, web, walk-in, mail), reference number, bank routing details, and application status. For outbound refunds: captures refund date, amount, disbursement method (check, ACH, account credit), reason code (overpayment, deposit return, credit balance, billing error), originating credit source, approval status, and disbursement confirmation. Sourced from SAP IS-U FICA and Oracle CC&B payment processing. SSOT for all cash receipts and disbursements in the revenue cycle. Supports cash application controls and SOX compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Transaction ;
    cmm:cimCloseMatch cim:Transaction ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.payment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; Payment / Cash Receipt" ;
    cmm:sourceObject "energy_utilities_ecm.billing.payment" ;
    owl:hasKey ( cmm:CustomerPayment.paymentId ) .

cmm:CustomerPayment.paymentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment id"@en ;
    rdfs:comment "Unique identifier for the payment transaction record. Primary key for the payment entity."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Payment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account against which this payment or refund is applied. Links to the customer account master record in the billing system."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:CustomerPayment.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Payments are applied against invoices (or account balances). This FK is essential for AR clearing, cash application, and payment status tracking. Note: in open-item accounting (SAP FICA), payments may"@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:CustomerPayment.paymentArrangement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement"@en ;
    rdfs:comment "Reference to the payment arrangement or installment plan if this payment is part of a structured payment agreement. Null for standard payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range cmm:PaymentArrangement ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Arrangement Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_payment_arrangement_id" ;
    cmm:cimAssociation "Transaction.AuxiliaryAgreement" .
cmm:CustomerPayment.paymentInvoiceRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment invoice"@en ;
    rdfs:comment "Reference to the specific invoice being paid. Null for account-level payments or refunds not tied to a specific invoice."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "payment_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_payment_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:CustomerPayment.toInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Payments are applied against specific invoices (or account balances). This FK is critical for cash application and AR reconciliation."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "to_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_to_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:CustomerPayment.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "Monetary value of the payment or refund transaction in the billing currency. Positive values for inbound payments, may be positive or negative depending on system convention for refunds."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Transaction Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerPayment.applicationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application status"@en ;
    rdfs:comment "Status indicating whether and how the payment has been applied to outstanding invoices or account balance. Tracks cash application workflow completion."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Application Status" ;
    cmm:validValues "unapplied|partially_applied|fully_applied|suspended|reversed" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.appliedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applied amount"@en ;
    rdfs:comment "Portion of the payment amount that has been successfully applied to invoices or account balance. May differ from payment_amount if payment is partially applied or includes unapplied credit."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applied_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applied Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerPayment.authorizationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization code"@en ;
    rdfs:comment "Authorization or approval code returned by the payment processor or card network confirming the transaction was approved. Used for reconciliation and dispute resolution."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Authorization Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.autoPayEnrollmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto pay enrollment flag"@en ;
    rdfs:comment "Indicates whether this payment was processed as part of an automatic payment enrollment. True for auto-pay transactions, false for manual payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_pay_enrollment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Pay Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerPayment.bankAccountNumberMasked a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank account number masked"@en ;
    rdfs:comment "Masked or tokenized bank account number for ACH payments. Only last 4 digits visible for PCI compliance and fraud prevention. Full account number stored in secure vault."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_account_number_masked" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Account Number (Masked)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.bankRoutingNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank routing number"@en ;
    rdfs:comment "Nine-digit American Bankers Association routing transit number identifying the financial institution for ACH or check payments. Confidential financial data."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_routing_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Bank Routing Number (ABA RTN)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:valuePattern "^[0-9]{9}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerPayment.batchReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "batch reference"@en ;
    rdfs:comment "Identifier for the payment processing batch if this payment was processed as part of a batch run. Used for lockbox processing, bulk ACH imports, and batch reconciliation."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "batch_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Batch Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.cardExpirationMonth a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card expiration month"@en ;
    rdfs:comment "Month component of the payment card expiration date (1-12). Used for recurring payment validation and auto-pay processing."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:int ;
    cmm:physicalColumn "card_expiration_month" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Card Expiration Month" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.cardExpirationYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card expiration year"@en ;
    rdfs:comment "Four-digit year component of the payment card expiration date. Used for recurring payment validation and auto-pay processing."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:int ;
    cmm:physicalColumn "card_expiration_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Card Expiration Year" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.cardLastFourDigits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card last four digits"@en ;
    rdfs:comment "Last four digits of the payment card number for customer reference and dispute resolution. Full card number never stored per PCI DSS requirements."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "card_last_four_digits" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Card Last Four Digits" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:valuePattern "^[0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.cardType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "card type"@en ;
    rdfs:comment "Credit or debit card network brand for card-based payments. Null for non-card payment methods."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "card_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Card Type" ;
    cmm:validValues "visa|mastercard|amex|discover|other" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.channel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel"@en ;
    rdfs:comment "Customer interface or channel through which the payment was submitted. Distinguishes self-service digital channels from assisted or physical channels. Reference-value candidates: web_portal|mobile_app|ivr|walk_in|mail|bank_draft|third_party_agent."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Channel" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when this payment record was first created in the billing system. Part of the audit trail for data lineage and SOX compliance."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Transaction.createdDateTime .
cmm:CustomerPayment.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the payment transaction. Typically USD for US-based utilities but may vary for international operations."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code (ISO 4217)" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CustomerPayment.disbursementConfirmationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disbursement confirmation number"@en ;
    rdfs:comment "Confirmation or tracking number for the refund disbursement. May be check number, ACH trace number, or wire transfer confirmation. Null for inbound payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "disbursement_confirmation_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Refund Disbursement Confirmation Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerPayment.disbursementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disbursement date"@en ;
    rdfs:comment "Date when the refund check was issued or electronic refund was transmitted. Null for inbound payments or pending refunds."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "disbursement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Disbursement Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerPayment.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code to which this payment transaction is posted. Typically a cash or accounts receivable account per the utility chart of accounts."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or system identifier that last modified this payment record. Part of the audit trail for SOX compliance and change management."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "System timestamp when this payment record was last updated. Tracks all modifications for audit trail and change tracking."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CustomerPayment.lockboxNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lockbox number"@en ;
    rdfs:comment "Bank lockbox identifier for payments received via lockbox processing service. Null for non-lockbox payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "lockbox_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Lockbox Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerPayment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments related to the payment transaction. May include customer instructions, dispute details, or special handling notes entered by customer service representatives."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Transaction Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CustomerPayment.nsfFeeAssessed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nsf fee assessed"@en ;
    rdfs:comment "Fee amount charged to the customer account for returned payment due to insufficient funds. Null if no NSF fee applies."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nsf_fee_assessed" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Sufficient Funds (NSF) Fee Assessed" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerPayment.paymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment date"@en ;
    rdfs:comment "Business date when the payment was received or the refund was issued. For inbound payments, this is the date the payment was tendered by the customer. For outbound refunds, this is the disbursement date."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Transaction Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerPayment.paymentInvoice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Payments are applied against specific invoices. Critical for AR balance calculation and cash application."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "payment_invoice" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "Financial instrument or mechanism used to tender the payment. Identifies whether payment was made via check, electronic funds transfer, card payment, or cash. Reference-value candidates: check|ach|credit_card|debit_card|cash|money_order|wire_transfer|online|auto_pay."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "Current lifecycle status of the payment transaction. Tracks progression from initial receipt through clearing and application to customer account balance."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Processing Status" ;
    cmm:validValues "pending|applied|cleared|reversed|failed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.status .
cmm:CustomerPayment.paymentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment timestamp"@en ;
    rdfs:comment "Precise date and time when the payment transaction was recorded in the billing system. Used for audit trail and transaction sequencing."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "payment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Transaction Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerPayment.paymentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment type"@en ;
    rdfs:comment "Classification of the payment transaction direction and purpose. Inbound payments represent cash receipts from customers; outbound refunds represent disbursements to customers."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Transaction Type" ;
    cmm:validValues "inbound_payment|outbound_refund|credit_memo|debit_memo|adjustment" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.kind .
cmm:CustomerPayment.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "Accounting date when the payment transaction was posted to the general ledger. May differ from payment_date due to batch processing timing or period-end cutoffs."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerPayment.referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference number"@en ;
    rdfs:comment "External reference number or confirmation code for the payment transaction. May include check number, ACH trace number, credit card authorization code, or online payment confirmation ID."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerPayment.refundApprovalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund approval status"@en ;
    rdfs:comment "Workflow status for refund approval process. Tracks management review and authorization for outbound refund disbursements. Null for inbound payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "refund_approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Approval Status" ;
    cmm:validValues "pending_approval|approved|rejected|disbursed" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.refundApprovalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund approval timestamp"@en ;
    rdfs:comment "Date and time when the refund was approved for disbursement. Part of the audit trail for financial controls. Null for inbound payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "refund_approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerPayment.refundApprovedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund approved by"@en ;
    rdfs:comment "User ID or name of the employee who authorized the refund disbursement. Required for SOX compliance and audit trail. Null for inbound payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "refund_approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Approved By User" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.refundMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund method"@en ;
    rdfs:comment "Method by which the refund is disbursed to the customer. May be check, ACH transfer, account credit, or reversal to original payment method. Null for inbound payments."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "refund_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Disbursement Method" ;
    cmm:validValues "check|ach|account_credit|original_payment_method" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.refundReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund reason code"@en ;
    rdfs:comment "Standardized code indicating the business reason for issuing a refund to the customer. Null for inbound payments. Used for refund analytics and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "refund_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Reason Code" ;
    cmm:validValues "overpayment|deposit_return|credit_balance|billing_error|service_cancellation|duplicate_payment" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.reversalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal date"@en ;
    rdfs:comment "Date when the payment was reversed. Null if payment has not been reversed."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "reversal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Reversal Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerPayment.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this payment transaction has been reversed due to NSF (non-sufficient funds), chargeback, or administrative correction. True if reversed, false otherwise."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerPayment.reversalReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason code"@en ;
    rdfs:comment "Standardized code indicating the reason for payment reversal. Includes NSF returns, chargebacks, disputes, and administrative corrections. Null if payment has not been reversed."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Reversal Reason Code" ;
    cmm:validValues "nsf|chargeback|customer_dispute|bank_return|administrative_error|fraud" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Payments may be applied at the account/service agreement level when not tied to a specific invoice (e.g., prepayments, deposits)."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifier of the source system or module that originated the payment transaction record. Examples include SAP IS-U FICA, Oracle CC&B, payment gateway integration, or third-party payment processor."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Source System" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.toSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Payments are received for a customer service agreement. Needed when payments are applied at account level rather than invoice level."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerPayment.transactionReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction reference"@en ;
    rdfs:comment "Unique transaction identifier assigned by the payment gateway or processor. Used for reconciliation, chargebacks, and technical support inquiries."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Processor Transaction Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CustomerPayment.unappliedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unapplied amount"@en ;
    rdfs:comment "Portion of the payment amount that remains unapplied and held as account credit. Occurs when payment exceeds outstanding balance or when application is suspended pending dispute resolution."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unapplied_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unapplied Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerPayment.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or system identifier that created this payment record. May be a customer service representative, automated batch process, or payment gateway integration."@en ;
    rdfs:domain cmm:CustomerPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:PaymentArrangement a owl:Class ;
    rdfs:label "Payment Arrangement"@en ;
    rdfs:comment "Master entity representing a formal installment or deferred payment plan negotiated with a customer to resolve past-due balances. Captures arrangement type, total amount owed, number of installments, installment amounts, scheduled payment dates, down payment, arrangement status, breach conditions, and associated collections case. Managed within SAP IS-U FICA and Oracle CC&B collections modules."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AuxiliaryAgreement ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.payment_arrangement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; Payment Plan / Installment Agreement" ;
    cmm:sourceObject "energy_utilities_ecm.billing.payment_arrangement" ;
    owl:hasKey ( cmm:PaymentArrangement.paymentArrangementId ) .

cmm:PaymentArrangement.paymentArrangementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement id"@en ;
    rdfs:comment "Unique identifier for the payment arrangement. Primary key for this entity."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:long ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Payment Arrangement Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account for which this payment arrangement was established."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_arrangement_account_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.CustomerAccount" .
cmm:PaymentArrangement.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the customer service representative or collections agent who approved the payment arrangement terms."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_arrangement_employee_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.ErpPersonnel" .
cmm:PaymentArrangement.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: High interconnection costs (impact studies, network upgrades, inspection fees) often require payment arrangements. Business process: Customers unable to pay upfront interconnection fees negotiate inst"@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_payment_arrangement_interconnection_application_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.Request" .
cmm:PaymentArrangement.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when the payment arrangement was formally approved and became binding."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.arrangementEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement end date"@en ;
    rdfs:comment "Scheduled date when the final installment is due and the arrangement is expected to be completed. Nullable for open-ended arrangements."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "arrangement_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement End Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.arrangementForCollectionsCase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement for collections case"@en ;
    rdfs:comment "FK to billing.collections_case.collections_case_id — Payment arrangements are negotiated to resolve a collections case. This FK links the installment plan to the delinquent balance being resolved."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:long ;
    cmm:physicalColumn "arrangement_for_collections_case" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.arrangementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement number"@en ;
    rdfs:comment "Business-facing unique identifier for the payment arrangement, typically displayed on customer correspondence and used in collections workflows."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "arrangement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Arrangement Number" ;
    cmm:valuePattern "^PA[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PaymentArrangement.arrangementStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement start date"@en ;
    rdfs:comment "Effective date when the payment arrangement becomes binding and the first installment schedule begins."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "arrangement_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.arrangementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement status"@en ;
    rdfs:comment "Current lifecycle state of the payment arrangement. Draft indicates pending approval; active means in effect and customer is making payments; completed when all obligations fulfilled; breached when customer missed payment(s) per terms; cancelled when voided before completion; suspended when temporarily paused by mutual agreement."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "arrangement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Arrangement Status" ;
    cmm:validValues "draft|active|completed|breached|cancelled|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.status .
cmm:PaymentArrangement.arrangementToSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Payment arrangements are established for a specific service agreement with past-due balances."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:long ;
    cmm:physicalColumn "arrangement_to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.arrangementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrangement type"@en ;
    rdfs:comment "Classification of the payment arrangement structure. Installment plan spreads balance over fixed payments; deferred payment postpones full payment to future date; settlement agreement resolves disputed balance; budget billing equalizes monthly payments; hardship plan offers reduced terms for financial distress; promise to pay is short-term commitment."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "arrangement_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Arrangement Type" ;
    cmm:validValues "installment_plan|deferred_payment|settlement_agreement|budget_billing|hardship_plan|promise_to_pay" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.type .
cmm:PaymentArrangement.autoPayEnrolledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto pay enrolled flag"@en ;
    rdfs:comment "Indicates whether customer enrolled in automatic payment processing for installments, reducing risk of missed payments."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_pay_enrolled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto Pay Enrolled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PaymentArrangement.breachDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "breach date"@en ;
    rdfs:comment "Date when the payment arrangement was breached due to missed payments exceeding the threshold. Nullable if arrangement has not been breached."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "breach_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Breach Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.breachReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "breach reason"@en ;
    rdfs:comment "Explanation of why the arrangement was breached, typically referencing specific missed payments or violation of terms. Nullable if not breached."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "breach_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Breach Reason" ;
    cmm:cimDatatype "String" .
cmm:PaymentArrangement.breachThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "breach threshold"@en ;
    rdfs:comment "Maximum number of missed installments allowed before the arrangement is automatically breached and collections actions resume. Typically 1 or 2 missed payments."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:int ;
    cmm:physicalColumn "breach_threshold" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Breach Threshold" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.cancellationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation date"@en ;
    rdfs:comment "Date when the payment arrangement was cancelled before completion. Nullable if arrangement was not cancelled."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "cancellation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Explanation of why the arrangement was cancelled, such as customer request, account closure, or administrative error. Nullable if not cancelled."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:PaymentArrangement.completionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion date"@en ;
    rdfs:comment "Date when all installment obligations were fulfilled and the arrangement was successfully completed. Nullable if not yet completed."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the payment arrangement record was first created in the system."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.createdDateTime .
cmm:PaymentArrangement.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this arrangement. Typically USD for US utilities."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code (ISO 4217)" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:PaymentArrangement.customerSignatureReceivedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer signature received flag"@en ;
    rdfs:comment "Indicates whether customer signature or electronic acceptance was obtained for the arrangement terms, required for enforceability."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_signature_received_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Signature Received Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PaymentArrangement.downPaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "down payment amount"@en ;
    rdfs:comment "Initial payment required at arrangement establishment to demonstrate good faith and reduce the principal balance before installments begin. Zero if no down payment required."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "down_payment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Down Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PaymentArrangement.downPaymentReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "down payment received date"@en ;
    rdfs:comment "Date when the down payment was actually received and posted to the account. Nullable if down payment not yet received or not required."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "down_payment_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Down Payment Received Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.firstInstallmentDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "first installment due date"@en ;
    rdfs:comment "Date when the first scheduled installment payment is due, typically 30 days after arrangement start date or aligned with customer billing cycle."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "first_installment_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "First Installment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.installmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installment amount"@en ;
    rdfs:comment "Fixed amount due for each regular installment payment. Calculated by dividing remaining balance after down payment by number of installments."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "installment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PaymentArrangement.installmentFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installment frequency"@en ;
    rdfs:comment "Cadence at which installment payments are scheduled. Monthly is most common for utility payment arrangements."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "installment_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installment Frequency" ;
    cmm:validValues "weekly|biweekly|monthly|quarterly" ;
    cmm:cimDatatype "String" .
cmm:PaymentArrangement.installmentsMissedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installments missed count"@en ;
    rdfs:comment "Number of scheduled installment payments that were not received by their due date. Exceeding the allowed threshold triggers breach status."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:int ;
    cmm:physicalColumn "installments_missed_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installments Missed Count" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.installmentsPaidCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installments paid count"@en ;
    rdfs:comment "Number of installment payments successfully received and posted to date. Used to track customer compliance with arrangement terms."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:int ;
    cmm:physicalColumn "installments_paid_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installments Paid Count" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.interestAccruedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest accrued amount"@en ;
    rdfs:comment "Total interest charges accumulated on the outstanding balance since arrangement start. Updated periodically based on interest calculation schedule."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interest_accrued_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Accrued Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PaymentArrangement.interestRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest rate"@en ;
    rdfs:comment "Annual interest rate applied to the outstanding balance, expressed as a percentage. Zero if arrangement is interest-free per utility policy or regulatory requirement."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interest_rate" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Rate Percentage" ;
    cmm:cimDatatype "Decimal" .
cmm:PaymentArrangement.lastInstallmentDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last installment due date"@en ;
    rdfs:comment "Date when the final installment payment is due, marking the scheduled completion of the arrangement."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_installment_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Installment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:PaymentArrangement.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when the payment arrangement record was most recently updated, reflecting status changes, payment postings, or term modifications."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PaymentArrangement.lateFeeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "late fee amount"@en ;
    rdfs:comment "Total late payment fees assessed for missed or delayed installments. May be waived under hardship arrangements."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "late_fee_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Late Fee Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PaymentArrangement.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for customer service representatives to document special circumstances, negotiation details, or customer commitments related to the arrangement."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Arrangement Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:PaymentArrangement.notificationPreference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification preference"@en ;
    rdfs:comment "Customer preferred channel for receiving payment reminders and arrangement status updates."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_preference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Preference" ;
    cmm:validValues "email|sms|mail|phone|none" ;
    cmm:cimDatatype "String" .
cmm:PaymentArrangement.numberOfInstallments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of installments"@en ;
    rdfs:comment "Total count of scheduled installment payments in the arrangement. Typically ranges from 3 to 24 months depending on utility policy and customer circumstances."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_installments" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Installments" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.paymentMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method code"@en ;
    rdfs:comment "Primary payment instrument the customer will use for installment payments."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method Code" ;
    cmm:validValues "bank_draft|credit_card|debit_card|check|cash|electronic_funds_transfer" ;
    cmm:cimDatatype "String" .
cmm:PaymentArrangement.remainingBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remaining balance"@en ;
    rdfs:comment "Current outstanding balance under the payment arrangement after subtracting down payment and any installments paid to date. Updated as payments are received."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "remaining_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remaining Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PaymentArrangement.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Payment arrangements are established for a specific service agreement/account."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PaymentArrangement.totalAmountOwed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total amount owed"@en ;
    rdfs:comment "Total outstanding balance at the time the payment arrangement was established, representing the principal amount to be repaid through the arrangement."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_amount_owed" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Amount Owed" ;
    cmm:cimDatatype "Decimal" .
cmm:PaymentArrangement.waivedFeesAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "waived fees amount"@en ;
    rdfs:comment "Total amount of late fees, interest, or other charges waived as part of the arrangement negotiation or hardship consideration."@en ;
    rdfs:domain cmm:PaymentArrangement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "waived_fees_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Waived Fees Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:BillingDeterminant a owl:Class ;
    rdfs:label "Billing Determinant"@en ;
    rdfs:comment "Calculated billing determinant records derived from validated meter interval data for a specific service agreement and billing period. Stores total kWh, on-peak/off-peak kWh, peak demand (kW), reactive demand (kVAR), power factor, billing multiplier, and TOU period breakdowns. Bridges metering domain MDM output to the billing engine for rate calculation. Critical for TOU, CPP, and demand-based rate schedules."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:Reading ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.determinant" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; Billing Determinant / Usage Summary" ;
    cmm:sourceObject "energy_utilities_ecm.billing.determinant" ;
    owl:hasKey ( cmm:BillingDeterminant.determinantId ) .

cmm:BillingDeterminant.determinantId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "determinant id"@en ;
    rdfs:comment "Unique identifier for the billing determinant record. Primary key for this entity."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:long ;
    cmm:physicalColumn "determinant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Billing Determinant ID" ;
    cmm:cimDatatype "Integer" .
cmm:BillingDeterminant.billingPeriod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing period"@en ;
    rdfs:comment "Reference to the billing period for which these determinants apply. Defines the start and end dates of the consumption window used for rate calculation."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:BillingPeriod ;
    cmm:physicalColumn "billing_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Period ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_billing_period_id" ;
    cmm:cimAssociation "Reading.TimeSchedule" .
cmm:BillingDeterminant.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Reference to the service agreement for which this billing determinant was calculated. Links to the customer service agreement that defines the rate schedule and billing terms."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_billing_service_agreement_id" ;
    cmm:cimAssociation "Reading.CustomerAgreement" .
cmm:BillingDeterminant.cycle a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle"@en ;
    rdfs:comment "Foreign key linking to billing.billing_cycle. Business justification: Billing determinants are calculated for a specific billing cycle execution. Currently billing_determinant has billing_cycle_code (STRING) but no FK to billing_cycle. This FK enables joining to retriev"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:BillingCycle ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Cycle Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_cycle_id" ;
    cmm:cimAssociation "Reading.TimeSchedule" .
cmm:BillingDeterminant.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Billing determinants calculate net metering export/import quantities from specific DER installations. Required to attribute generation, apply correct export rates, calculate demand charges with DER of"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_der_registry_id" ;
    cmm:cimAssociation "Reading.PowerElectronicsConnection" .
cmm:BillingDeterminant.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Billing determinants for DER customers must account for system-specific characteristics (nameplate capacity, export capability, inverter type) to calculate net metering correctly. Business process: Mo"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_der_system_id" ;
    cmm:cimAssociation "Reading.PowerElectronicsConnection" .
cmm:BillingDeterminant.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Foreign key linking to demand.dr_event. Business justification: Billing determinants (peak demand, TOU consumption) may be affected by DR events that alter normal consumption patterns. Baseline calculations, billing validation, and dispute resolution require under"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_dr_event_id" ;
    cmm:cimAssociation "Reading.EndDeviceControl" .
cmm:BillingDeterminant.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Advanced metering analytics aggregate consumption by feeder for load forecasting, capacity planning, demand response program design, and feeder-level revenue analysis. Supports distribution planning a"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_feeder_id" ;
    cmm:cimAssociation "Reading.Feeder" .
cmm:BillingDeterminant.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Foreign key linking to billing.invoice. Business justification: Billing determinants are consumed during invoice generation to calculate charges. This FK links determinants to the invoice they contributed to, enabling traceability from invoice back to source deter"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_invoice_id" ;
    cmm:cimAssociation "Reading.CustomerBillingInfo" .
cmm:BillingDeterminant.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Real-time pricing tariffs calculate interval-specific charges using LMP data matched to customer consumption intervals; critical for TOU programs, dynamic pricing pilots, and regulatory cost-of-servic"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_lmp_price_id" ;
    cmm:cimAssociation "Reading.PnodeResults" .
cmm:BillingDeterminant.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the meter from which the interval data was sourced. Links to the physical or virtual meter device in the Advanced Metering Infrastructure (AMI)."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_meter_id" ;
    cmm:cimAssociation "Reading.Meter" .
cmm:BillingDeterminant.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Billing determinants calculate usage for service points, incorporating network topology (feeder, transformer) and rate schedule context. Service point is the fundamental unit for TOU period assignment"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_meter_point_id" ;
    cmm:cimAssociation "Reading.UsagePoint" .
cmm:BillingDeterminant.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Foreign key linking to billing.rate_schedule. Business justification: Billing determinants are calculated according to a specific rate schedule's rules and structure. Currently billing_determinant has rate_schedule_code (STRING) but no FK to the rate_schedule master ent"@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_determinant_rate_schedule_id" ;
    cmm:cimAssociation "Reading.Tariff" .
cmm:BillingDeterminant.adjustmentReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment reason code"@en ;
    rdfs:comment "Code indicating why the billing determinants were manually adjusted after initial calculation. Used for audit trail and to track common data quality issues requiring manual intervention. Examples include meter malfunction, CT/PT ratio correction, or billing dispute resolution."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason Code" ;
    cmm:cimDatatype "String" .
cmm:BillingDeterminant.billingCycleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle code"@en ;
    rdfs:comment "Code identifying the billing cycle schedule to which this service agreement belongs. Used to group customers for batch billing processing and to coordinate meter reading, determinant calculation, and invoice generation schedules."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_cycle_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Cycle Code" ;
    cmm:cimDatatype "String" .
cmm:BillingDeterminant.billingDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing days"@en ;
    rdfs:comment "Number of calendar days in the billing period. Used for pro-ration calculations, average daily usage metrics, and normalization of consumption data for year-over-year comparisons."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:int ;
    cmm:physicalColumn "billing_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:BillingDeterminant.billingMultiplier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing multiplier"@en ;
    rdfs:comment "Multiplier applied to meter readings to account for Current Transformer (CT) and Potential Transformer (PT) ratios in high-voltage metering installations. Converts secondary meter readings to primary consumption values. Typically greater than 1 for commercial and industrial customers."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "billing_multiplier" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Multiplier" ;
    cmm:cimDatatype "Decimal" .
cmm:BillingDeterminant.calculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation method"@en ;
    rdfs:comment "Method used to derive the billing determinants from meter data. Indicates whether values were calculated from actual interval data, estimated due to missing data, or derived using special algorithms for net metering or demand windowing."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Calculation Method" ;
    cmm:validValues "interval_sum|demand_window|tou_allocation|net_metering|estimated" ;
    cmm:cimDatatype "String" .
cmm:BillingDeterminant.calculationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation timestamp"@en ;
    rdfs:comment "The date and time when the billing determinants were calculated from validated meter interval data. Represents the business event time when MDM output was transformed into billing inputs."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "calculation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Determinant Calculation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingDeterminant.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Free-text field for billing analysts to document special circumstances, data quality issues, manual adjustments, or other notes relevant to this billing determinant record. Used for audit trail and knowledge transfer."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:BillingDeterminant.contractDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract demand kw"@en ;
    rdfs:comment "The contracted maximum demand level agreed upon between the utility and customer. Used for rate schedules where customers commit to a minimum demand level in exchange for favorable pricing. Excess demand above this level may incur penalty charges."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contract_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Demand Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingDeterminant.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this billing determinant record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Reading.createdDateTime .
cmm:BillingDeterminant.criticalPeakKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical peak kwh"@en ;
    rdfs:comment "Energy consumption during Critical Peak Pricing (CPP) event hours. Used for CPP rate schedules where utilities invoke premium pricing during grid stress events (typically 10-15 days per year)."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "critical_peak_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Critical Peak Kilowatt-Hour (kWh) Consumption" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.dataQualityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "Composite score (0-100) representing the quality of the underlying meter interval data used to calculate these determinants. Considers factors such as percentage of actual vs estimated readings, validation rule pass rate, and data completeness. Used to flag determinants requiring manual review."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Score" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:BillingDeterminant.estimatedIntervalCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated interval count"@en ;
    rdfs:comment "Number of meter intervals that were estimated rather than actual readings. Used for data quality assessment and to flag billing determinants that may require review due to missing or invalid meter data."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_interval_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Interval Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingDeterminant.intervalCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval count"@en ;
    rdfs:comment "Number of meter interval readings used to calculate these billing determinants. Typically 2,880 intervals for 15-minute data over a 30-day period, or 1,440 intervals for 30-minute data. Used for data quality validation."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingDeterminant.isFinalDeterminant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is final determinant"@en ;
    rdfs:comment "Flag indicating whether this is the final, validated billing determinant record for the billing period (true) or a preliminary/estimated version (false). Used to prevent duplicate billing and ensure only validated determinants are passed to the billing engine."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_final_determinant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Final Determinant" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingDeterminant.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this billing determinant record was last updated. Used for audit trail, change tracking, and identifying records that have been manually adjusted after initial calculation."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BillingDeterminant.loadFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load factor"@en ;
    rdfs:comment "Ratio of average load to peak load during the billing period, calculated as (total_kwh / (peak_demand_kw * billing_hours)). Indicates how efficiently the customer uses their peak capacity. Values range from 0 to 1, with higher values indicating more consistent usage patterns."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:BillingDeterminant.midPeakKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mid peak kwh"@en ;
    rdfs:comment "Energy consumption during mid-peak TOU periods (shoulder hours between on-peak and off-peak). Used for TOU rate schedules with three-tier time-based pricing."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mid_peak_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mid-Peak Kilowatt-Hour (kWh) Consumption" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or system identifier of the person or process that last modified this billing determinant record. Used for audit trail and accountability in SOX compliance reporting."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:BillingDeterminant.netMeteringExportKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering export kwh"@en ;
    rdfs:comment "Energy exported to the grid from customer-owned Distributed Energy Resources (DER) such as rooftop solar. Used for Net Energy Metering (NEM) rate schedules where exported energy is credited against consumption or compensated at a specified rate."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_metering_export_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Energy Metering (NEM) Export Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.netMeteringImportKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering import kwh"@en ;
    rdfs:comment "Energy imported from the grid by customers with Distributed Energy Resources (DER). Used for Net Energy Metering (NEM) rate schedules to calculate net consumption after accounting for on-site generation."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_metering_import_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Energy Metering (NEM) Import Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.offPeakDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "off peak demand kw"@en ;
    rdfs:comment "Maximum power demand during off-peak TOU periods. Used for rate schedules that apply separate demand charges for off-peak periods."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "off_peak_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Off-Peak Demand Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingDeterminant.offPeakKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "off peak kwh"@en ;
    rdfs:comment "Energy consumption during off-peak TOU periods (typically nights and weekends when grid demand is lower). Used for TOU rate calculations with discounted pricing."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "off_peak_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Off-Peak Kilowatt-Hour (kWh) Consumption" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.onPeakDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on peak demand kw"@en ;
    rdfs:comment "Maximum power demand during on-peak TOU periods. Used for rate schedules that apply separate demand charges for on-peak versus off-peak periods."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "on_peak_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "On-Peak Demand Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingDeterminant.onPeakKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on peak kwh"@en ;
    rdfs:comment "Energy consumption during on-peak TOU periods (typically weekday afternoons when grid demand is highest). Used for TOU and CPP rate calculations with premium pricing."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "on_peak_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "On-Peak Kilowatt-Hour (kWh) Consumption" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.peakDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand kw"@en ;
    rdfs:comment "Maximum instantaneous power demand in kilowatts recorded during the billing period. Used for demand-based rate schedules common in commercial and industrial tariffs. Typically measured as the highest 15-minute or 30-minute interval average."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingDeterminant.peakDemandTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand timestamp"@en ;
    rdfs:comment "Date and time when the peak demand (kW) occurred during the billing period. Used for demand response analysis, load profiling, and customer engagement regarding demand management opportunities."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "peak_demand_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingDeterminant.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "Ratio of real power (kW) to apparent power (kVA) during the billing period, typically calculated at the time of peak demand. Used to assess power quality and apply power factor adjustment charges. Values range from 0 to 1, with 1.0 representing ideal unity power factor."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:BillingDeterminant.ratchetDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ratchet demand kw"@en ;
    rdfs:comment "Demand value used for ratchet clause billing, typically a percentage (e.g., 80%) of the highest demand recorded in the previous 11 months. Used in commercial and industrial rate schedules to ensure minimum demand charges even during low-usage months."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ratchet_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ratchet Demand Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingDeterminant.reactiveDemandKvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive demand kvar"@en ;
    rdfs:comment "Maximum reactive power demand in kilovolt-amperes reactive during the billing period. Used for power factor penalties or reactive power charges in industrial and large commercial rate schedules."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_demand_kvar" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Demand Kilovolt-Ampere Reactive (kVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ReactivePower" .
cmm:BillingDeterminant.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "System of record from which the meter interval data originated. Indicates whether data came from Meter Data Management (MDM), Advanced Metering Infrastructure (AMI), manual meter reading, estimation algorithms, or SCADA systems."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "mdm|ami|manual_entry|estimated|scada" ;
    cmm:cimDatatype "String" .
cmm:BillingDeterminant.temperatureNormalizedKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature normalized kwh"@en ;
    rdfs:comment "Energy consumption adjusted for weather variations using heating degree days (HDD) and cooling degree days (CDD). Used for load forecasting, energy efficiency program evaluation, and customer usage comparisons across different weather conditions."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_normalized_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Temperature Normalized Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.totalKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total kwh"@en ;
    rdfs:comment "Total energy consumption in kilowatt-hours for the billing period. Sum of all interval data across all Time-of-Use (TOU) periods. Primary determinant for energy charges."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Total Kilowatt-Hour (kWh) Consumption" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.touPeriod1Kwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period 1 kwh"@en ;
    rdfs:comment "Energy consumption for TOU period 1 as defined in the rate schedule. Supports rate schedules with custom TOU period definitions beyond standard on-peak/off-peak/mid-peak classifications."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tou_period_1_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time-of-Use (TOU) Period 1 Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.touPeriod2Kwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period 2 kwh"@en ;
    rdfs:comment "Energy consumption for TOU period 2 as defined in the rate schedule. Supports rate schedules with custom TOU period definitions beyond standard on-peak/off-peak/mid-peak classifications."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tou_period_2_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time-of-Use (TOU) Period 2 Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.touPeriod3Kwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period 3 kwh"@en ;
    rdfs:comment "Energy consumption for TOU period 3 as defined in the rate schedule. Supports rate schedules with custom TOU period definitions beyond standard on-peak/off-peak/mid-peak classifications."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tou_period_3_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time-of-Use (TOU) Period 3 Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.touPeriod4Kwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period 4 kwh"@en ;
    rdfs:comment "Energy consumption for TOU period 4 as defined in the rate schedule. Supports rate schedules with custom TOU period definitions beyond standard on-peak/off-peak/mid-peak classifications."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tou_period_4_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Time-of-Use (TOU) Period 4 Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:BillingDeterminant.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Current validation state of the billing determinants. Indicates whether the calculated values have passed automated validation rules, require manual review, or have been adjusted by billing analysts."@en ;
    rdfs:domain cmm:BillingDeterminant ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Status" ;
    cmm:validValues "validated|pending_review|failed_validation|manually_adjusted|estimated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .

cmm:BillingAdjustment a owl:Class ;
    rdfs:label "Billing Adjustment"@en ;
    rdfs:comment "Transactional record of a financial adjustment applied to a customer account or invoice, including credits, debits, rebates, rate corrections, estimated-to-actual true-ups, regulatory surcharge adjustments, and NEM (Net Energy Metering) credits for behind-the-meter generation. Captures adjustment type, reason code, amount, affected billing period, approval status, authorizing user, and source invoice reference. For NEM credit adjustments: stores exported kWh, credit rate ($/kWh), credit amount, cumulative credit balance, credit expiration date, and applicable NEM tariff version. Sourced from SAP IS-U FICA, Oracle CC&B adjustment processing, and NEM billing modules. SSOT for all financial adjustments including NEM credits. Supports SOX financial controls, revenue recognition, and state NEM/RPS regulatory compliance reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Transaction ;
    cmm:cimCloseMatch cim:Transaction ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.adjustment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; Billing Adjustment / Credit-Debit Memo" ;
    cmm:sourceObject "energy_utilities_ecm.billing.adjustment" ;
    owl:hasKey ( cmm:BillingAdjustment.adjustmentId ) .

cmm:BillingAdjustment.adjustmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment id"@en ;
    rdfs:comment "Unique identifier for the financial adjustment transaction. Primary key."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:long ;
    cmm:physicalColumn "adjustment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Adjustment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:BillingAdjustment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account to which this adjustment is applied."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:BillingAdjustment.adjustmentCreatedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment created by user employee"@en ;
    rdfs:comment "User ID of the person or system process that initiated the adjustment transaction. Required for audit trails and segregation of duties controls."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "adjustment_created_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_adjustment_created_by_user_employee_id" ;
    cmm:cimAssociation "Transaction.ErpPersonnel" .
cmm:BillingAdjustment.adjustmentEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment employee"@en ;
    rdfs:comment "User ID of the person who approved the adjustment. Required for SOX audit trails and segregation of duties controls."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "adjustment_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_adjustment_employee_id" ;
    cmm:cimAssociation "Transaction.ErpPersonnel" .
cmm:BillingAdjustment.adjustmentInvoiceRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment invoice"@en ;
    rdfs:comment "Reference to the source invoice affected by this adjustment. Nullable for account-level adjustments not tied to a specific invoice."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "adjustment_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_adjustment_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:BillingAdjustment.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: Billing adjustments frequently result from audit findings requiring correction of billing errors, rate misapplication, or compliance violations. Links adjustment to the specific finding that triggered"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_audit_finding_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:BillingAdjustment.billDispute a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bill dispute"@en ;
    rdfs:comment "Reference to the customer dispute or complaint case that resulted in this adjustment. Null if not dispute-related. Links to customer service case management system."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:BillDispute ;
    cmm:physicalColumn "bill_dispute_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispute Case Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_bill_dispute_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:BillingAdjustment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Adjustments allocated to cost centers for variance analysis, budget tracking, and regulatory cost recovery. Essential for identifying systematic billing errors by department and supporting rate case c"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Adjustment Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_cost_center_id" ;
    cmm:cimAssociation "Transaction.Organisation" .
cmm:BillingAdjustment.drIncentivePayment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr incentive payment"@en ;
    rdfs:comment "Foreign key linking to demand.dr_incentive_payment. Business justification: DR incentive payments are frequently posted as billing adjustments when credited after initial invoice generation. GL reconciliation, audit trails, and financial reporting require linking adjustments"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:DrIncentivePayment ;
    cmm:physicalColumn "dr_incentive_payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Incentive Payment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_dr_incentive_payment_id" ;
    cmm:cimAssociation "Transaction.Transaction" .
cmm:BillingAdjustment.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Billing adjustments (credits, rebates, corrections) post to specific GL accounts for accurate financial statements and audit trails. Reusing existing unlinked gl_account_code as denormalized reference"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Adjustment Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_gl_account_id" ;
    cmm:cimAssociation "Transaction.ErpChartOfAccounts" .
cmm:BillingAdjustment.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: When grid reliability events (outages, voltage issues) impact customers, utilities issue billing adjustments as service credits. Real business process: customer compensation for reliability events. Ad"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_grid_reliability_event_id" ;
    cmm:cimAssociation "Transaction.PSREvent" .
cmm:BillingAdjustment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Billing adjustments frequently result from interconnection process errors: wrong meter configuration during commissioning, delayed PTO affecting rate effective dates, or disputed export credit calcula"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_interconnection_application_id" ;
    cmm:cimAssociation "Transaction.Request" .
cmm:BillingAdjustment.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Adjustments are typically applied against a specific invoice or billing period. This FK enables audit trail from adjustment back to the original billed amount. Critical for SOX controls."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:BillingAdjustment.marketSettlement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "market settlement"@en ;
    rdfs:comment "Foreign key linking to trading.market_settlement. Business justification: ISO settlement re-runs and true-ups trigger billing adjustments for retail customers on pass-through rates; direct settlement linkage enables automated correction posting, variance analysis, and regul"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:MarketSettlement ;
    cmm:physicalColumn "market_settlement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Market Settlement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_market_settlement_id" ;
    cmm:cimAssociation "Transaction.Settlement" .
cmm:BillingAdjustment.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Adjustments frequently result from meter test failures, VEE corrections, or service point configuration errors. This link identifies which service point triggered the adjustment, supports regulatory a"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_meter_point_id" ;
    cmm:cimAssociation "Transaction.UsagePoint" .
cmm:BillingAdjustment.outageEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage event"@en ;
    rdfs:comment "Foreign key linking to generation.generation_outage_event. Business justification: Utilities issue billing adjustments (credits/refunds) to customers affected by generation outages. Regulatory and audit requirements mandate traceability from customer billing adjustment to the causal"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:GenerationOutageEvent ;
    cmm:physicalColumn "outage_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_outage_event_id" ;
    cmm:cimAssociation "Transaction.Outage" .
cmm:BillingAdjustment.reversedAdjustment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reversed adjustment"@en ;
    rdfs:comment "Reference to the original adjustment_id that this transaction reverses. Null if this is not a reversal. Used to maintain audit trail of adjustment corrections."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:BillingAdjustment ;
    cmm:physicalColumn "reversed_adjustment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reversed Adjustment Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_reversed_adjustment_id" ;
    cmm:cimAssociation "Transaction.Transaction" .
cmm:BillingAdjustment.toInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Adjustments are frequently applied against a specific invoice (rate correction, estimated-to-actual true-up). This FK supports audit trail and SOX controls."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "to_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_to_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:BillingAdjustment.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Billing adjustments for wholesale trade settlement discrepancies require trade reference for complete audit trail, dispute resolution with counterparties, and regulatory compliance documentation when"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_trade_id" ;
    cmm:cimAssociation "Transaction.Trade" .
cmm:BillingAdjustment.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Foreign key linking to asset.work_order. Business justification: Billing adjustments frequently result from field work: meter test failures, equipment malfunctions, service quality issues. Customer service representatives and auditors require traceability from adju"@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_adjustment_work_order_id" ;
    cmm:cimAssociation "Transaction.Work" .
cmm:BillingAdjustment.adjustmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment date"@en ;
    rdfs:comment "The business date when the adjustment transaction was created and recorded in the billing system. This is the principal business event timestamp for the adjustment."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "adjustment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Transaction Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.adjustmentInvoice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Adjustments are applied against specific invoices or billing periods. Critical for AR reconciliation and SOX controls."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:long ;
    cmm:physicalColumn "adjustment_invoice" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillingAdjustment.adjustmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment number"@en ;
    rdfs:comment "Human-readable business identifier for the adjustment transaction, often displayed on customer correspondence and used for customer service reference."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Adjustment Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingAdjustment.adjustmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment type"@en ;
    rdfs:comment "Classification of the adjustment transaction indicating the nature of the financial change applied to the account or invoice. Reference-value candidates: credit|debit|rebate|rate_correction|estimated_to_actual_trueup|regulatory_surcharge|nem_credit|write_off|late_fee_reversal|deposit_refund|billing_error_correction."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Adjustment Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.kind .
cmm:BillingAdjustment.affectedBillingPeriodEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected billing period end"@en ;
    rdfs:comment "End date of the billing period to which this adjustment applies. Used for period-specific rate corrections and estimated-to-actual true-ups."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "affected_billing_period_end" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Billing Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.affectedBillingPeriodStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected billing period start"@en ;
    rdfs:comment "Start date of the billing period to which this adjustment applies. Used for period-specific rate corrections and estimated-to-actual true-ups."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "affected_billing_period_start" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Billing Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "The monetary value of the adjustment. Positive values represent debits (charges to customer), negative values represent credits (refunds or reductions). Expressed in the account's billing currency."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:BillingAdjustment.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when the adjustment was approved by an authorized user or system process. Null if still pending approval."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current approval state of the adjustment in the workflow. Supports SOX financial controls requiring segregation of duties for material adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Approval Status" ;
    cmm:validValues "pending|approved|rejected|auto_approved|escalated|cancelled" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code indicating the currency in which the adjustment amount is denominated."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BillingAdjustment.disputeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute flag"@en ;
    rdfs:comment "Indicates whether this adjustment is related to a customer dispute or complaint resolution. True if dispute-related, False otherwise."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispute_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingAdjustment.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "The date from which the adjustment becomes effective for accounting and revenue recognition purposes. May differ from adjustment_date for backdated corrections."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Adjustment Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:BillingAdjustment.glPostingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl posting date"@en ;
    rdfs:comment "The date when this adjustment was posted to the general ledger. Null if not yet posted. Used for financial period reconciliation and revenue recognition."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "gl_posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.nemCreditAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem credit amount"@en ;
    rdfs:comment "For NEM credit adjustments: the total monetary credit amount calculated as nem_exported_kwh multiplied by nem_credit_rate. This amount is applied as a credit to the customer account. Null for non-NEM adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nem_credit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Credit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingAdjustment.nemCreditExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem credit expiration date"@en ;
    rdfs:comment "For NEM credit adjustments: the date when unused NEM credits expire per the applicable NEM tariff rules (typically 12 months from generation). Null for non-NEM adjustments or jurisdictions without credit expiration."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:date ;
    cmm:physicalColumn "nem_credit_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Credit Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingAdjustment.nemCreditRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem credit rate"@en ;
    rdfs:comment "For NEM credit adjustments: the per-kWh credit rate applied to exported energy, expressed in currency per kWh. Rate is determined by the applicable NEM tariff and may vary by time-of-use period. Null for non-NEM adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nem_credit_rate" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Credit Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:BillingAdjustment.nemCumulativeCreditBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem cumulative credit balance"@en ;
    rdfs:comment "For NEM credit adjustments: the cumulative balance of NEM credits on the customer account after this adjustment is applied. Used to track credit carryover across billing periods. Null for non-NEM adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nem_cumulative_credit_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Cumulative Credit Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingAdjustment.nemExportedKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem exported kwh"@en ;
    rdfs:comment "For NEM credit adjustments: the quantity of energy in kilowatt-hours exported by the customer's behind-the-meter generation system to the grid during the billing period. Null for non-NEM adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nem_exported_kwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Exported Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:BillingAdjustment.nemTariffVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem tariff version"@en ;
    rdfs:comment "For NEM credit adjustments: the version identifier of the NEM tariff applied to this adjustment (e.g., NEM 1.0, NEM 2.0, NEM 3.0). Different tariff versions have different credit calculation rules. Null for non-NEM adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_tariff_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Tariff Version" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional notes, comments, or context about the adjustment. Used by customer service representatives and billing analysts for documentation."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Adjustment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:BillingAdjustment.postedToGlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posted to gl flag"@en ;
    rdfs:comment "Indicates whether this adjustment has been posted to the general ledger for financial reporting. True if posted, False if pending. Supports SOX financial controls and month-end close processes."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "posted_to_gl_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posted to General Ledger (GL) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingAdjustment.reasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason code"@en ;
    rdfs:comment "Standardized code indicating the business reason for the adjustment (e.g., meter read correction, customer complaint resolution, regulatory mandate, billing system error)."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason Code" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.reasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason description"@en ;
    rdfs:comment "Free-text explanation providing additional context and details about why the adjustment was made, often used for audit trails and customer communication."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason Description" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this adjustment record was first created in the source system. Used for audit trails and data lineage."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingAdjustment.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Timestamp when this adjustment record was last modified in the source system. Used for audit trails and change tracking."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingAdjustment.regulatoryReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting flag"@en ;
    rdfs:comment "Indicates whether this adjustment must be included in regulatory compliance reporting to state PUC, FERC, or other governing bodies. True if reportable, False otherwise."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingAdjustment.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Classification of the adjustment by revenue category for regulatory reporting and financial analysis. Aligns with FERC Uniform System of Accounts and state PUC reporting requirements. Reference-value candidates: energy_sales|distribution_charges|transmission_charges|regulatory_surcharges|ancillary_services|nem_credits|other."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this adjustment is a reversal of a previous adjustment transaction. True if this is a reversal, False otherwise."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingAdjustment.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Adjustments are posted to a service agreement. Required for account-level balance tracking."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillingAdjustment.sourceDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source document reference"@en ;
    rdfs:comment "Reference identifier to the originating document or transaction in the source system (e.g., work order number, service request ID, regulatory filing reference). Used for audit trails and root cause analysis."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Document Reference" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The operational system or process that originated this adjustment transaction. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_ISU|Oracle_CCB|MDM|Manual_Entry|Automated_Process|Customer_Portal" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.tariffCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff code"@en ;
    rdfs:comment "Rate schedule or tariff code applicable to this adjustment, particularly for rate corrections and regulatory surcharge adjustments. References the approved tariff on file with the regulatory authority."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Code" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "The tax component of the adjustment amount, if applicable. Null for non-taxable adjustments. Used for sales tax, utility tax, and other applicable taxes."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingAdjustment.taxJurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax jurisdiction code"@en ;
    rdfs:comment "Code identifying the tax jurisdiction applicable to this adjustment. Used for multi-jurisdictional tax compliance and reporting."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Jurisdiction Code" ;
    cmm:cimDatatype "String" .
cmm:BillingAdjustment.toSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Adjustments are applied to a service agreement when not tied to a specific invoice (e.g., account-level credits, NEM credits)."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillingAdjustment.writeOffFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off flag"@en ;
    rdfs:comment "Indicates whether this adjustment represents a bad debt write-off. True if this is a write-off, False otherwise. Used for accounts receivable aging and collections reporting."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "write_off_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingAdjustment.writeOffReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off reason code"@en ;
    rdfs:comment "Standardized code indicating the reason for write-off (e.g., bankruptcy, uncollectible, deceased customer, small balance). Null for non-write-off adjustments."@en ;
    rdfs:domain cmm:BillingAdjustment ; rdfs:range xsd:string ;
    cmm:physicalColumn "write_off_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Reason Code" ;
    cmm:cimDatatype "String" .

cmm:SecurityDeposit a owl:Class ;
    rdfs:label "Security Deposit"@en ;
    rdfs:comment "Master entity tracking customer security deposits held by the utility, including deposit amount, deposit type (cash, surety bond, letter of credit), collection date, interest accrual, refund eligibility date, refund status, and regulatory basis for deposit requirement. Managed within SAP IS-U FICA and Oracle CC&B deposit management. Supports PUC-mandated deposit rules and customer financial risk management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AuxiliaryAccount ;
    cmm:cimCloseMatch cim:AuxiliaryAccount ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.deposit" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; Customer Deposit / Security Deposit" ;
    cmm:sourceObject "energy_utilities_ecm.billing.deposit" ;
    owl:hasKey ( cmm:SecurityDeposit.depositId ) .

cmm:SecurityDeposit.depositId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit id"@en ;
    rdfs:comment "Unique identifier for the customer security deposit record. Primary key."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:long ;
    cmm:physicalColumn "deposit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Deposit Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:SecurityDeposit.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account for which this deposit is held. Links to the customer billing account in CIS."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_deposit_account_id" ;
    cmm:cimAssociation "AuxiliaryAccount.CustomerAccount" .
cmm:SecurityDeposit.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "FK to billing.billing_service_agreement.billing_service_agreement_id — Security deposits are collected against a specific service agreement. This FK enables deposit tracking, refund eligibility, and regulatory compliance for deposit rules."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_deposit_billing_service_agreement_id" ;
    cmm:cimAssociation "AuxiliaryAccount.CustomerAgreement" .
cmm:SecurityDeposit.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User ID of the system user or CSR who last modified the deposit record. Supports SOX audit requirements and internal control documentation for financial transactions."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_deposit_employee_id" ;
    cmm:cimAssociation "AuxiliaryAccount.ErpPersonnel" .
cmm:SecurityDeposit.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Customer deposits held in specific liability GL accounts per regulatory requirements and GAAP. Link enables proper balance sheet classification, interest accrual tracking, and regulatory reporting of"@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Deposit Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_deposit_gl_account_id" ;
    cmm:cimAssociation "AuxiliaryAccount.ErpChartOfAccounts" .
cmm:SecurityDeposit.accruedInterestAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accrued interest amount"@en ;
    rdfs:comment "Total interest earned on the deposit from collection date to current date, calculated per regulatory interest rate requirements. Many PUCs mandate interest payment on customer deposits held beyond specified periods."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accrued_interest_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accrued Interest Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SecurityDeposit.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "Original principal amount of the deposit collected from or guaranteed by the customer, in the utility's functional currency. Does not include accrued interest."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:SecurityDeposit.collectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection date"@en ;
    rdfs:comment "Date the deposit was collected from the customer or the guarantee instrument became effective. Serves as the start date for interest accrual and regulatory holding period calculations."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "collection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.collectionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection method"@en ;
    rdfs:comment "Payment method or mechanism used to collect the cash deposit from the customer. Does not apply to surety bonds or letters of credit which are third-party guarantees."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "collection_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Method" ;
    cmm:validValues "cash|check|credit_card|bank_transfer|payroll_deduction|installment_plan" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when the deposit record was first created in the CIS or FICA system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AuxiliaryAccount.createdDateTime .
cmm:SecurityDeposit.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the deposit amount. Supports multi-currency operations for utilities operating across jurisdictions."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:SecurityDeposit.depositNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit number"@en ;
    rdfs:comment "Business-facing unique identifier for the deposit, used in customer communications and financial reporting. Externally visible deposit reference number."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Deposit Number" ;
    cmm:valuePattern "^DEP-[0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SecurityDeposit.depositStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit status"@en ;
    rdfs:comment "Current lifecycle state of the deposit. Active deposits are held and earning interest, refunded deposits have been returned to customer, forfeited deposits applied to outstanding balances, transferred deposits moved to new account, expired deposits past regulatory holding period, and pending refund deposits awaiting disbursement approval."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Deposit Status" ;
    cmm:validValues "active|refunded|forfeited|transferred|expired|pending_refund" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAccount.status .
cmm:SecurityDeposit.depositType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit type"@en ;
    rdfs:comment "Classification of the deposit instrument held by the utility. Cash deposits are held in utility accounts, surety bonds and letters of credit are third-party guarantees, bank guarantees are financial institution commitments, and escrow deposits are held by third-party trustees."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Deposit Type" ;
    cmm:validValues "cash|surety_bond|letter_of_credit|bank_guarantee|escrow" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAccount.type .
cmm:SecurityDeposit.forfeitureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forfeiture amount"@en ;
    rdfs:comment "Amount of deposit (including accrued interest) applied to customer account balance upon forfeiture. May be partial if deposit exceeds outstanding balance. Null for deposits not forfeited."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forfeiture_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forfeiture Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SecurityDeposit.forfeitureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forfeiture date"@en ;
    rdfs:comment "Date the deposit was forfeited and applied to outstanding customer account balance due to payment default, service disconnection, or final bill settlement. Null for deposits not forfeited."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "forfeiture_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forfeiture Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.forfeitureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forfeiture reason"@en ;
    rdfs:comment "Business reason for forfeiting the deposit and applying it to customer account balance. Payment default and service disconnection are most common triggers per PUC tariff rules."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "forfeiture_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forfeiture Reason" ;
    cmm:validValues "payment_default|service_disconnection|final_bill_settlement|account_closure|regulatory_violation" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.guaranteeExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "guarantee expiration date"@en ;
    rdfs:comment "Expiration date of the surety bond, letter of credit, or bank guarantee. Utility must ensure renewal or replacement before expiration to maintain deposit coverage. Null for cash deposits and perpetual guarantees."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "guarantee_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Guarantee Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.guaranteeInstrumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "guarantee instrument number"@en ;
    rdfs:comment "Reference number or policy number of the surety bond, letter of credit, or bank guarantee instrument. Used for verification and claim processing. Null for cash deposits."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "guarantee_instrument_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Guarantee Instrument Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SecurityDeposit.guaranteeProviderName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "guarantee provider name"@en ;
    rdfs:comment "Name of the financial institution or surety company providing the letter of credit, surety bond, or bank guarantee. Applicable only for non-cash deposit types. Null for cash deposits."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "guarantee_provider_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Guarantee Provider Name" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.interestCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest calculation method"@en ;
    rdfs:comment "Method used to calculate interest accrual on the deposit. Simple interest calculates on principal only, compound methods add accrued interest to principal at specified intervals. Method is typically mandated by PUC tariff rules."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "interest_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Calculation Method" ;
    cmm:validValues "simple|compound_monthly|compound_quarterly|compound_annually|none" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.interestRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest rate percent"@en ;
    rdfs:comment "Annual interest rate applied to the deposit balance, expressed as a percentage. Rate is typically set by state PUC regulations and may be tied to treasury rates or fixed by tariff."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interest_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:SecurityDeposit.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "System timestamp when the deposit record was last updated. Tracks changes to deposit status, interest accrual, or refund processing for audit and compliance purposes."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SecurityDeposit.lastReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last review date"@en ;
    rdfs:comment "Date the deposit record was last reviewed for refund eligibility, interest accrual accuracy, or regulatory compliance. Utilities typically perform periodic deposit reviews per PUC requirements."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Review Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.nextReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next review date"@en ;
    rdfs:comment "Scheduled date for the next deposit review cycle. Used for workflow management and compliance tracking to ensure timely refund processing and interest payment."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Review Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for recording special circumstances, customer disputes, regulatory exceptions, or other relevant information about the deposit. Used for audit trail and customer service reference."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Deposit Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:SecurityDeposit.reasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason code"@en ;
    rdfs:comment "Business reason for requiring or collecting the deposit. Regulatory requirements mandate deposits for certain customer risk profiles, payment defaults trigger deposit collection, and voluntary deposits may be offered for budget management."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Reason Code" ;
    cmm:validValues "new_service|poor_credit|payment_default|high_usage|regulatory_requirement|voluntary" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.refundAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund amount"@en ;
    rdfs:comment "Total amount refunded to customer, including original deposit principal plus accrued interest, minus any forfeitures or adjustments. Null for deposits not yet refunded."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "refund_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SecurityDeposit.refundDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund date"@en ;
    rdfs:comment "Actual date the deposit (plus accrued interest) was refunded to the customer or applied to their account balance. Null for deposits not yet refunded."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "refund_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.refundEligibilityDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund eligibility date"@en ;
    rdfs:comment "Date on which the deposit becomes eligible for refund to the customer, calculated based on PUC-mandated holding periods and customer payment history criteria. Typically 12-24 months of on-time payment history."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:date ;
    cmm:physicalColumn "refund_eligibility_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Eligibility Date" ;
    cmm:cimDatatype "Date" .
cmm:SecurityDeposit.refundMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund method"@en ;
    rdfs:comment "Method used to return the deposit to the customer. Account credit applies deposit to outstanding balance, check and direct deposit return funds directly to customer, wire transfer used for large amounts."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:string ;
    cmm:physicalColumn "refund_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Method" ;
    cmm:validValues "check|direct_deposit|account_credit|wire_transfer" ;
    cmm:cimDatatype "String" .
cmm:SecurityDeposit.regulatoryHoldingPeriodMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory holding period months"@en ;
    rdfs:comment "Minimum number of months the utility must hold the deposit before refund eligibility, as mandated by state PUC regulations. Typically 12 or 24 months depending on jurisdiction and customer class."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:int ;
    cmm:physicalColumn "regulatory_holding_period_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Holding Period (Months)" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:SecurityDeposit.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Security deposits are held against a specific service agreement. Required for deposit refund eligibility tracking."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:SecurityDeposit.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this deposit record is subject to SOX financial controls and audit requirements. True for publicly traded utilities with material deposit balances requiring internal control documentation."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SecurityDeposit.toSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Security deposits are collected for a specific service agreement, often at service initiation or after credit events."@en ;
    rdfs:domain cmm:SecurityDeposit ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .

cmm:DunningNotice a owl:Class ;
    rdfs:label "Dunning Notice"@en ;
    rdfs:comment "Transactional record of a dunning or collections notice issued to a customer with a past-due balance. Captures dunning level (first notice, final notice, disconnect warning, disconnect order), issue date, past-due amount, response deadline, delivery channel (mail, email, SMS, door hanger), and resulting action taken. Sourced from SAP IS-U FICA dunning program and Oracle CC&B collections workflow. Tracks the full collections escalation lifecycle."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.dunning_notice" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Dunning Notice / Collections Notice" ;
    cmm:sourceObject "energy_utilities_ecm.billing.dunning_notice" ;
    owl:hasKey ( cmm:DunningNotice.dunningNoticeId ) .

cmm:DunningNotice.dunningNoticeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dunning notice id"@en ;
    rdfs:comment "Unique identifier for the dunning or collections notice record. Primary key."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range xsd:long ;
    cmm:physicalColumn "dunning_notice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Dunning Notice ID" ;
    cmm:cimDatatype "Integer" .
cmm:DunningNotice.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account that received this dunning notice."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_dunning_notice_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:DunningNotice.billDispute a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bill dispute"@en ;
    rdfs:comment "Reference to a billing dispute or complaint case opened by the customer in response to this dunning notice."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range cmm:BillDispute ;
    cmm:physicalColumn "bill_dispute_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispute Case ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_dunning_notice_bill_dispute_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:DunningNotice.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Reference to the active service agreement or utility contract under which the past due charges were incurred."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_dunning_notice_billing_service_agreement_id" ;
    cmm:cimAssociation "Document.CustomerAgreement" .
cmm:DunningNotice.disconnectOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "disconnect order"@en ;
    rdfs:comment "Reference to the service disconnection work order issued as a result of this dunning notice, if escalated to disconnect."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range cmm:DisconnectOrder ;
    cmm:physicalColumn "disconnect_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Disconnect Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_dunning_notice_disconnect_order_id" ;
    cmm:cimAssociation "Document.MeterServiceWork" .
cmm:DunningNotice.dunningRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dunning run"@en ;
    rdfs:comment "Identifier for the batch dunning process or collections run that generated this notice. Used for audit and reconciliation."@en ;
    rdfs:domain cmm:DunningNotice ; rdfs:range cmm:DunningRun ;
    cmm:physicalColumn "dunning_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
