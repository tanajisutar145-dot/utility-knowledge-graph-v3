cmm:DeliveryPoint a owl:Class ;
    rdfs:label "Delivery Point"@en ;
    rdfs:comment "Master reference table for delivery_point. Referenced by delivery_point_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ServicePoint ;
    cmm:cimCloseMatch cim:ServicePoint ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::InfEnergyScheduling" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.market_operations ;
    cmm:physicalTable "utility_cmm_silver.trading.delivery_point" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 62325-301" ;
    cmm:sourceObject "energy_utilities_ecm.trading.delivery_point" ;
    owl:hasKey ( cmm:DeliveryPoint.deliveryPointId ) .

