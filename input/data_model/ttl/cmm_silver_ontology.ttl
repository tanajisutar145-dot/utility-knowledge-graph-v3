cmm:ContractorWorker.workerPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "worker phone"@en ;
    rdfs:comment "Primary contact phone number for the contractor worker for emergency contact and crew dispatch coordination."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
