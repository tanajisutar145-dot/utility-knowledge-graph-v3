    cmm:businessTerm "Transmission Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_transmission_substation_id" ;
    cmm:cimAssociation "InspectionDataSet.Substation" .
cmm:AssetInspection.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the work order in Ventyx Asset Suite that authorized or scheduled this inspection activity."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_work_order_id" ;
    cmm:cimAssociation "InspectionDataSet.Work" .
cmm:AssetInspection.ambientTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature c"@en ;
    rdfs:comment "Ambient temperature in degrees Celsius at the time of inspection, relevant for temperature-sensitive diagnostic tests (e.g., thermography, oil analysis)."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_c" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature in Celsius" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetInspection.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the inspection record was reviewed and approved by a supervisor or engineer."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AssetInspection.assetLoadPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset load percent"@en ;
    rdfs:comment "Percentage of rated capacity at which the asset was operating during the inspection, relevant for load-dependent diagnostic tests."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_load_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Load Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:AssetInspection.conditionRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition rating"@en ;
    rdfs:comment "Qualitative condition rating corresponding to the overall condition score."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "condition_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Rating" ;
    cmm:validValues "excellent|good|fair|poor|critical" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the inspection record was first created in the system."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:InspectionDataSet.createdDateTime .
cmm:AssetInspection.defectDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "defect description"@en ;
    rdfs:comment "Detailed narrative description of the defects, anomalies, or conditions observed during the inspection."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "defect_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Defect Description" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.defectSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "defect severity"@en ;
    rdfs:comment "Highest severity classification of defects identified: critical (immediate safety/reliability risk), major (near-term failure risk), minor (long-term degradation), or informational (observation only)."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "defect_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Defect Severity Classification" ;
    cmm:validValues "critical|major|minor|informational" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.defectsIdentifiedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "defects identified count"@en ;
    rdfs:comment "Number of defects, anomalies, or non-conformances identified during the inspection."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:int ;
    cmm:physicalColumn "defects_identified_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Defects Identified Count" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.documentAttachmentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document attachment count"@en ;
    rdfs:comment "Number of supporting documents (test reports, certificates, checklists) attached to the inspection record."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:int ;
    cmm:physicalColumn "document_attachment_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Attachment Count" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.durationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration hours"@en ;
    rdfs:comment "Total time in hours required to complete the inspection, including travel, setup, testing, and documentation."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "duration_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Duration in Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:AssetInspection.estimatedRemediationCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated remediation cost"@en ;
    rdfs:comment "Estimated cost in USD to remediate identified defects or perform recommended actions. Used for CAPEX/OPEX planning and maintenance budget forecasting."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_remediation_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Remediation Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AssetInspection.frequencyMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency months"@en ;
    rdfs:comment "Interval in months between scheduled inspections for this asset, based on regulatory mandates, asset criticality, or condition-based maintenance strategy."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:int ;
    cmm:physicalColumn "frequency_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Frequency in Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.healthIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "health index"@en ;
    rdfs:comment "Composite health index score (0-100 scale) calculated from inspection results, test data, and condition indicators. Feeds asset health analytics and predictive maintenance models."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "health_index" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Health Index" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetInspection.inspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection date"@en ;
    rdfs:comment "The date on which the inspection or condition assessment was performed."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:date ;
    cmm:physicalColumn "inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetInspection.inspectionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection method"@en ;
    rdfs:comment "The technical method or technology used to perform the inspection or diagnostic test. Reference-value candidates: visual|infrared_thermography|ultrasonic|vibration|oil_analysis|electrical_test|drone_aerial|manual_measurement|scada_online_monitoring."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Method" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.inspectionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection number"@en ;
    rdfs:comment "Business identifier for the inspection, typically generated by the work management system or field inspection application."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Number" ;
    cmm:valuePattern "^[A-Z0-9-]{6,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AssetInspection.inspectionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection status"@en ;
    rdfs:comment "Current lifecycle status of the inspection record in the work management system."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Status" ;
    cmm:validValues "scheduled|in_progress|completed|cancelled|pending_review|approved" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:InspectionDataSet.status .
cmm:AssetInspection.inspectionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection type"@en ;
    rdfs:comment "Classification of the inspection activity: routine patrol (visual), post-storm assessment, vegetation management inspection, scheduled condition assessment, or advanced diagnostic test type. Reference-value candidates: routine_patrol|post_storm|vegetation_management|scheduled_condition_assessment|thermographic_survey|dissolved_gas_analysis|partial_discharge_test|oil_sampling|vibration_analysis|ultrasonic_testing."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:InspectionDataSet.kind .
cmm:AssetInspection.inspectorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspector name"@en ;
    rdfs:comment "Full name of the inspector or assessor who conducted the inspection."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspector_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspector Name" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the inspection record was last updated or modified."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AssetInspection.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next inspection or condition assessment based on regulatory requirements, manufacturer recommendations, or condition-based maintenance triggers."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetInspection.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional observations, context, or comments recorded by the inspector during the inspection."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Notes" ;
