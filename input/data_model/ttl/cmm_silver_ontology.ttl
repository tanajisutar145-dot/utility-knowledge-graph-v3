cmm:FuelPriceAssumption.scenarioName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario name"@en ;
    rdfs:comment "Name of the planning scenario to which this fuel price assumption belongs (e.g., Base Case, High Gas Price, Low Gas Price, Renewable Acceleration). Used in IRP scenario modeling and sensitivity analysis."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:string ;
