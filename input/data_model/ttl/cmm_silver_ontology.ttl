    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.nercCipRelevantFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip relevant flag"@en ;
    rdfs:comment "Indicates whether this qualification authorizes access to Bulk Electric System (BES) Cyber Systems or other NERC CIP-regulated assets. True triggers additional personnel risk assessment and training requirements per NERC CIP-004."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_relevant_flag" ;
