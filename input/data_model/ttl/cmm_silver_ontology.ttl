cmm:TransmissionCustomer.primaryContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact name"@en ;
    rdfs:comment "Full name of the primary business contact for transmission service administration and operational coordination."@en ;
    rdfs:domain cmm:TransmissionCustomer ; rdfs:range xsd:string ;
