    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trade Classification" ;
    cmm:validValues "lineman|electrician|welder|heavy_equipment_operator|relay_technician|turbine_technician" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.unionAffiliation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union affiliation"@en ;
    rdfs:comment "Labor union or trade association to which the contractor worker belongs (e.g., IBEW Local 1245, Operating Engineers Local 3). Null if non-union."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_affiliation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Affiliation" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
