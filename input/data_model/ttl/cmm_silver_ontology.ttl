    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_IS_U|ORACLE_CCB|LEGACY_CIS" ;
    cmm:cimDatatype "String" .
cmm:RateSchedule.tariffBookReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff book reference"@en ;
    rdfs:comment "Reference to the section and page number in the official tariff book where this rate schedule is published."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_book_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Book Reference" ;
    cmm:cimDatatype "String" .
cmm:RateSchedule.taxInclusive a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax inclusive"@en ;
    rdfs:comment "Indicates whether the published rates include applicable taxes or if taxes are added separately during billing."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "tax_inclusive" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Inclusive" ;
    cmm:cimDatatype "Boolean" .
cmm:RateSchedule.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Voltage level at which service is delivered under this rate schedule. Determines applicable transmission and distribution charges."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level" ;
    cmm:validValues "primary|secondary|transmission|sub_transmission|distribution" ;
    cmm:cimDatatype "String" .

cmm:RateComponent a owl:Class ;
    rdfs:label "Rate Component"@en ;
    rdfs:comment "Granular rate component definitions within a rate schedule, capturing individual charge elements such as energy charges ($/kWh), demand charges ($/kW), customer charges, fuel adjustment clauses, distribution charges, transmission charges, and riders. Stores component type, unit of measure, tier thresholds, seasonal applicability, and calculation formula. Enables precise bill calculation for all rate structures including tiered and TOU."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Charge ;
    cmm:cimCloseMatch cim:Charge ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.rate_management ;
    cmm:physicalTable "utility_cmm_silver.billing.rate_component" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "IEC 61968-10; Rate Component / Tariff Element" ;
    cmm:sourceObject "energy_utilities_ecm.billing.rate_component" ;
    owl:hasKey ( cmm:RateComponent.rateComponentId ) .

cmm:RateComponent.rateComponentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate component id"@en ;
    rdfs:comment "Unique identifier for the rate component. Primary key."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:long ;
    cmm:physicalColumn "rate_component_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Rate Component ID" ;
    cmm:cimDatatype "Integer" .
cmm:RateComponent.capacityRequirement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity requirement"@en ;
    rdfs:comment "Foreign key linking to forecast.capacity_requirement. Business justification: Capacity-related rate components (demand charges, capacity riders, PJM/ISO capacity cost recovery riders) are calculated to recover costs from capacity requirement forecasts. Tariff filings must refer"@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "capacity_requirement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Requirement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_capacity_requirement_id" ;
    cmm:cimAssociation "Charge.Document" .
cmm:RateComponent.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to demand.dr_program. Business justification: Specific rate components (demand charges, TOU energy charges) may be waived, modified, or have special calculation rules for DR program participants. Tariff administration, billing system configuratio"@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_dr_program_id" ;
    cmm:cimAssociation "Charge.DemandResponseProgram" .
cmm:RateComponent.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: Energy charge rate components often include fuel adjustment clauses indexed to forecasted energy/fuel prices. Tariff sheets reference specific price forecast scenarios for automatic rate adjustments."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_energy_price_id" ;
    cmm:cimAssociation "Charge.RegularIntervalSchedule" .
cmm:RateComponent.fuelPriceAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel price assumption"@en ;
    rdfs:comment "Foreign key linking to forecast.fuel_price_assumption. Business justification: Fuel adjustment clause rate components are calculated using specific fuel price assumptions filed with regulators. Utilities must track which fuel price forecast version was used for each rate compone"@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:FuelPriceAssumption ;
    cmm:physicalColumn "fuel_price_assumption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fuel Price Assumption Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_fuel_price_assumption_id" ;
    cmm:cimAssociation "Charge.Document" .
cmm:RateComponent.primaryRateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary rate schedule"@en ;
    rdfs:comment "Foreign key reference to the parent rate schedule that contains this component."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "primary_rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule ID" ;
    cmm:sourceColumn "rate_schedule_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_primary_rate_schedule_id" ;
    cmm:cimAssociation "Charge.Tariff" .
cmm:RateComponent.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Rate components must be documented in regulatory filings when utilities propose tariff changes or rate case adjustments. Links the rate component to the specific filing (rate case, tariff amendment) w"@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_component_regulatory_filing_id" ;
    cmm:cimAssociation "Charge.Document" .
cmm:RateComponent.adjustmentFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment frequency"@en ;
    rdfs:comment "Frequency at which this rate component value is adjusted or recalculated. Fixed components never change, monthly adjustments are common for fuel clauses, quarterly for purchased power adjustments, annually for base rate reviews, event-driven for critical peak pricing."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Frequency" ;
    cmm:validValues "fixed|monthly|quarterly|annually|event_driven" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.applicableDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable days"@en ;
    rdfs:comment "Indicates which days of the week or calendar this rate component applies to. TOU rates often differ between weekdays and weekends."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_days" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Days" ;
    cmm:validValues "all_days|weekdays|weekends|holidays|non_holidays" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current regulatory approval status of the rate component. Draft components are under development, pending_approval are submitted to PUC, approved are authorized for billing, rejected were denied, superseded were replaced by newer versions, retired are no longer in use."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "draft|pending_approval|approved|rejected|superseded|retired" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.billPrintSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill print sequence"@en ;
    rdfs:comment "Sequence number controlling the order in which rate components appear on printed customer bills. Lower numbers print first. Null if print_on_bill_flag is False."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:int ;
    cmm:physicalColumn "bill_print_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bill Print Sequence" ;
    cmm:cimDatatype "Integer" .
cmm:RateComponent.billingDeterminant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing determinant"@en ;
    rdfs:comment "The measured or calculated value that this rate component is applied to. Actual usage comes from meter reads, estimated usage from profiling, contracted demand from service agreements, metered demand from interval data, billing demand from demand ratchets."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_determinant" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Determinant" ;
    cmm:validValues "actual_usage|estimated_usage|contracted_demand|metered_demand|billing_demand|customer_count" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.calculationFormula a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation formula"@en ;
    rdfs:comment "Mathematical formula or expression used to calculate the charge when calculation_method is 'formula'. May reference other rate components, meter data, or external indices."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_formula" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Calculation Formula" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.calculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation method"@en ;
    rdfs:comment "Method used to calculate charges for this component. Flat applies a single rate, tiered uses progressive rate steps, block uses declining block rates, TOU (time-of-use) varies by time period, CPP (critical peak pricing) applies premium rates during peak events, real-time uses dynamic pricing, formula uses a custom calculation expression. Reference-value candidates: flat|tiered|block|tou|cpp|real_time|formula."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Calculation Method" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.chargeCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "charge category"@en ;
    rdfs:comment "Billing category classification indicating whether this is a base tariff charge, a rider (supplemental charge), surcharge, credit (reduction), adjustment clause, or tax component."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "charge_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Charge Category" ;
    cmm:validValues "base|rider|surcharge|credit|adjustment|tax" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.componentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "component code"@en ;
    rdfs:comment "Unique business identifier code for the rate component used in billing systems and tariff filings."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "component_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Component Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RateComponent.componentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "component description"@en ;
    rdfs:comment "Detailed business description of the rate component, its purpose, and how it is calculated. Used for customer communications, tariff documentation, and internal training."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "component_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Component Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:RateComponent.componentName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "component name"@en ;
    rdfs:comment "Human-readable name of the rate component as it appears on customer bills and tariff documents."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "component_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Component Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:RateComponent.componentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "component type"@en ;
    rdfs:comment "Classification of the rate component indicating the nature of the charge. Energy charges are based on kWh consumption, demand charges on peak kW usage, customer charges are fixed monthly fees, fuel adjustment clauses recover fuel cost variations, distribution charges cover local delivery infrastructure, and transmission charges cover high-voltage grid costs."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "component_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Component Type" ;
    cmm:validValues "energy_charge|demand_charge|customer_charge|fuel_adjustment|distribution_charge|transmission_charge" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Charge.kind .
cmm:RateComponent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this rate component record was first created in the system."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Charge.createdDateTime .
cmm:RateComponent.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the rate value (e.g., USD, CAD, MXN)."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RateComponent.customerClassApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer class applicability"@en ;
    rdfs:comment "Indicates which customer classes this rate component applies to. Rate components may be specific to residential, commercial, industrial, or other customer segments."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_class_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Class Applicability" ;
    cmm:validValues "residential|commercial|industrial|agricultural|street_lighting|all_classes" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.decimalPrecision a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decimal precision"@en ;
    rdfs:comment "Number of decimal places to retain in charge calculations for this component. Typically 2 for dollar amounts, but may be higher for per-unit rates or regulatory calculations."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:int ;
    cmm:physicalColumn "decimal_precision" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Decimal Precision" ;
    cmm:cimDatatype "Integer" .
cmm:RateComponent.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this rate component expires and is no longer applied to customer bills. Null indicates the component is currently active with no planned end date."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:RateComponent.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this rate component becomes effective and can be applied to customer bills. Aligns with PUC rate case approval dates."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:RateComponent.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code in the ERP system (SAP S/4HANA) where revenue from this rate component is posted for financial accounting."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:valuePattern "^[0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.indexReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "index reference"@en ;
    rdfs:comment "External market index or benchmark used to calculate this component if it is formula-based or indexed (e.g., Henry Hub natural gas price, PJM LMP, CPI). Null for fixed-rate components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "index_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Index Reference" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this rate component record was last updated in the system."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RateComponent.maximumCharge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum charge"@en ;
    rdfs:comment "Maximum charge cap for this component. Used to limit exposure for certain rate components or to comply with regulatory caps."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_charge" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Charge Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RateComponent.minimumCharge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum charge"@en ;
    rdfs:comment "Minimum charge amount that must be applied for this component regardless of usage. Common for customer charges and demand charges with minimum billing requirements."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_charge" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Charge Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RateComponent.printOnBillFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "print on bill flag"@en ;
    rdfs:comment "Indicates whether this rate component should appear as a separate line item on customer bills. True for customer-visible charges, False for internal calculation components that roll up into other line items."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "print_on_bill_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Print on Bill Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RateComponent.prorationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "proration method"@en ;
    rdfs:comment "Method used to prorate charges for partial billing periods (e.g., when a customer starts or stops service mid-cycle). Daily proration divides by days in period, calendar uses actual calendar days, billing uses billing cycle days."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "proration_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Proration Method" ;
    cmm:validValues "daily|calendar_days|billing_days|none" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.pucDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc docket number"@en ;
    rdfs:comment "Public Utility Commission docket or case number associated with the rate case that approved this component. Used for regulatory compliance tracking and audit trails."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Public Utility Commission (PUC) Docket Number" ;
    cmm:valuePattern "^[A-Z0-9-]{5,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RateComponent.rateValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate value"@en ;
    rdfs:comment "The numeric rate or price applied per unit of measure. For example, $0.085 per kWh for energy charges, $15.00 per kW for demand charges, or $12.00 per account for customer charges."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rate_value" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Value" ;
    cmm:cimDatatype "Decimal" .
cmm:RateComponent.regulatoryAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code or state regulatory accounting code used for revenue recognition and regulatory reporting of charges from this component."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Account Code" ;
    cmm:valuePattern "^[0-9]{3,6}$" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Classification of revenue type for financial and regulatory reporting. Aligns with FERC revenue categories and state regulatory reporting requirements."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:validValues "base_revenue|fuel_revenue|distribution_revenue|transmission_revenue|other_revenue" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.riderCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rider code"@en ;
    rdfs:comment "Short code identifying the rider or surcharge if this component is a supplemental charge (e.g., FAC for Fuel Adjustment Clause, EEC for Energy Efficiency Charge, REC for Renewable Energy Charge). Null for base rate components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "rider_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rider Code" ;
    cmm:valuePattern "^[A-Z]{1,5}$" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.roundingRule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rounding rule"@en ;
    rdfs:comment "Rounding method applied to calculated charges for this component. Round_half_up is standard commercial rounding, round_down always rounds down, round_up always rounds up, truncate drops decimals."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "rounding_rule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rounding Rule" ;
    cmm:validValues "none|round_half_up|round_down|round_up|truncate" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.seasonalApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seasonal applicability"@en ;
    rdfs:comment "Indicates which season or time period this rate component applies to. Many utilities have different rates for summer (high cooling demand) versus winter periods. Reference-value candidates: year_round|summer|winter|spring|fall|peak_season|off_peak_season."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "seasonal_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Seasonal Applicability" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.tariffSheetReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff sheet reference"@en ;
    rdfs:comment "Reference to the specific tariff sheet number or section in the official tariff book where this rate component is documented. Used for regulatory compliance and customer inquiries."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_sheet_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Sheet Reference" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.taxExemptFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax exempt flag"@en ;
    rdfs:comment "Indicates whether this rate component is exempt from sales tax or other taxes. True if exempt, False if taxable."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "tax_exempt_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Exempt Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RateComponent.tierSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tier sequence"@en ;
    rdfs:comment "Sequence number for tiered or block rate structures, indicating the order of rate tiers (1 for first tier, 2 for second tier, etc.). Null for non-tiered components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:int ;
    cmm:physicalColumn "tier_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tier Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:RateComponent.tierThresholdMax a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tier threshold max"@en ;
    rdfs:comment "Maximum usage threshold for this tier in the specified unit of measure. Null indicates no upper limit (open-ended tier). Null for non-tiered components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tier_threshold_max" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tier Threshold Maximum" ;
    cmm:cimDatatype "Decimal" .
cmm:RateComponent.tierThresholdMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tier threshold min"@en ;
    rdfs:comment "Minimum usage threshold for this tier in the specified unit of measure. For example, tier 1 might be 0 kWh, tier 2 might be 500 kWh. Null for non-tiered components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tier_threshold_min" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tier Threshold Minimum" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:RateComponent.touEndTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou end time"@en ;
    rdfs:comment "End time for the TOU period in HH:MM format (24-hour clock). For example, on-peak might end at 21:00. Null for non-TOU components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "tou_end_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) End Time" ;
    cmm:cimDatatype "DateTime" .
cmm:RateComponent.touPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period"@en ;
    rdfs:comment "Time-of-use period classification for TOU rate structures. On-peak represents highest demand periods, off-peak represents lowest demand periods, critical-peak represents emergency high-demand events."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Period" ;
    cmm:validValues "on_peak|mid_peak|off_peak|super_off_peak|critical_peak|all_hours" ;
    cmm:cimDatatype "String" .
cmm:RateComponent.touStartTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou start time"@en ;
    rdfs:comment "Start time for the TOU period in HH:MM format (24-hour clock). For example, on-peak might start at 14:00. Null for non-TOU components."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "tou_start_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Start Time" ;
    cmm:cimDatatype "DateTime" .
cmm:RateComponent.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "The unit of measure for this rate component. Common values include kWh (kilowatt-hour) for energy consumption, kW (kilowatt) for demand, account for fixed customer charges, day/month for time-based charges. Reference-value candidates: kWh|kW|MWh|MW|account|day|month|therm|ccf."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:RateComponent.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Voltage level at which service is delivered, affecting rate component applicability. Secondary is typical residential (120/240V), primary is distribution (4-35kV), sub-transmission (35-138kV), transmission (>138kV)."@en ;
    rdfs:domain cmm:RateComponent ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level" ;
    cmm:validValues "secondary|primary|sub_transmission|transmission|all_levels" ;
    cmm:cimDatatype "String" .

cmm:BillingServiceAgreement a owl:Class ;
    rdfs:label "Billing Service Agreement"@en ;
    rdfs:comment "Master entity representing the contractual billing relationship between the utility and a customer account for energy delivery at a specific service point. Captures agreement type (residential, commercial, industrial, NEM), assigned rate schedule, effective and end dates, deposit requirements, budget billing enrollment status, special contract terms, and service point reference. SSOT for the active billing relationship that drives invoice generation, payment application, collections, and all downstream billing activity. Sourced from SAP IS-U contract account and Oracle CC&B service agreement modules."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CustomerAgreement ;
    cmm:cimCloseMatch cim:CustomerAgreement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.invoice_processing ;
    cmm:physicalTable "utility_cmm_silver.billing.billing_service_agreement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-8; Service Agreement / Contract Account" ;
    cmm:sourceObject "energy_utilities_ecm.billing.billing_service_agreement" ;
    owl:hasKey ( cmm:BillingServiceAgreement.billingServiceAgreementId ) .

cmm:BillingServiceAgreement.billingServiceAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement id"@en ;
    rdfs:comment "Unique identifier for the billing service agreement. Primary key for this entity representing the contractual billing relationship between the utility and customer."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Billing Service Agreement ID" ;
    cmm:cimDatatype "Integer" .
cmm:BillingServiceAgreement.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account that owns this billing service agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_account_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAccount" .
cmm:BillingServiceAgreement.billingRateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing rate schedule"@en ;
    rdfs:comment "FK to billing.rate_schedule"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "billing_rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "rate_schedule_id" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_billing_rate_schedule_id" ;
    cmm:cimAssociation "CustomerAgreement.Tariff" .
cmm:BillingServiceAgreement.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Service agreements track DER installations at customer premises for net metering billing, export compensation, and demand response programs. Essential for calculating NEM credits, managing export limi"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_der_registry_id" ;
    cmm:cimAssociation "CustomerAgreement.PowerElectronicsConnection" .
cmm:BillingServiceAgreement.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Service agreements govern specific service points (the contract-to-location binding). Rate schedules, service voltage, and billing cycles are service-point-specific. This link is essential for service"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_meter_point_id" ;
    cmm:cimAssociation "CustomerAgreement.UsagePoint" .
cmm:BillingServiceAgreement.nemAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nem account"@en ;
    rdfs:comment "Foreign key linking to renewable.nem_account. Business justification: Service agreements have 1:1 relationship with NEM accounts for net metering customers. Required to link billing terms, rate schedules, and payment arrangements to specific NEM credit tracking, true-up"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:NemAccount ;
    cmm:physicalColumn "nem_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nem Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_nem_account_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAccount" .
cmm:BillingServiceAgreement.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the premise (service location) where energy is delivered under this agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_premise_id" ;
    cmm:cimAssociation "CustomerAgreement.ServiceLocation" .
cmm:BillingServiceAgreement.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Special contract service agreements and non-standard tariff arrangements require regulatory approval and disclosure in filings. Links agreements to the filing where they were approved or reported for"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_regulatory_filing_id" ;
    cmm:cimAssociation "CustomerAgreement.Document" .
cmm:BillingServiceAgreement.serviceConnectionAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service connection asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Service agreements reference the specific delivery asset (transformer, service lateral, connection point) serving the premise. Field operations use this for capacity planning, service upgrades, and ou"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "service_connection_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Connection Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_service_agreement_service_connection_asset_registry_id" ;
    cmm:cimAssociation "CustomerAgreement.Asset" .
cmm:BillingServiceAgreement.agreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement number"@en ;
    rdfs:comment "Externally visible business identifier for the service agreement, used in customer communications and billing statements."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Agreement Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingServiceAgreement.agreementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement type"@en ;
    rdfs:comment "Classification of the billing service agreement based on customer class and service characteristics. Determines applicable rate structures and regulatory treatment."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Agreement Type" ;
    cmm:validValues "residential|commercial|industrial|nem|municipal|agricultural" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CustomerAgreement.type .
cmm:BillingServiceAgreement.autopayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "autopay flag"@en ;
    rdfs:comment "Indicates whether the customer is enrolled in automatic payment program where invoices are paid automatically on due date."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "autopay_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Payment Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.billingAgreementUsesRateSchedule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing agreement uses rate schedule"@en ;
    rdfs:comment "FK to billing.rate_schedule.rate_schedule_id — Each service agreement is assigned a rate schedule that governs how the account is billed. This is a fundamental billing relationship — without it, the billing engine cannot determine which rates to a"@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "billing_agreement_uses_rate_schedule" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillingServiceAgreement.billingCycleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle code"@en ;
    rdfs:comment "Code identifying the billing cycle schedule that determines invoice generation frequency and due dates for this agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_cycle_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Cycle Code" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.billingFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing frequency"@en ;
    rdfs:comment "Frequency at which invoices are generated for this service agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Frequency" ;
    cmm:validValues "monthly|bimonthly|quarterly|annual" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.billingServiceAgreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement status"@en ;
    rdfs:comment "Current lifecycle status of the billing service agreement indicating whether it is actively generating invoices and accepting payments."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_service_agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Status" ;
    cmm:validValues "active|pending|suspended|terminated|cancelled|inactive" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CustomerAgreement.status .
cmm:BillingServiceAgreement.budgetBillingAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing amount"@en ;
    rdfs:comment "Fixed monthly payment amount for customers enrolled in budget billing program. Recalculated periodically based on usage history."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "budget_billing_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Monthly Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingServiceAgreement.budgetBillingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing flag"@en ;
    rdfs:comment "Indicates whether the customer is enrolled in budget billing program that spreads annual energy costs into equal monthly payments."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "budget_billing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.contractCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract capacity kw"@en ;
    rdfs:comment "Contracted maximum demand capacity in kilowatts for large commercial or industrial customers. Basis for capacity charges and penalties for exceeding contracted demand."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contract_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Capacity Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:BillingServiceAgreement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this billing service agreement record was first created in the system."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CustomerAgreement.createdDateTime .
cmm:BillingServiceAgreement.creditHoldFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit hold flag"@en ;
    rdfs:comment "Indicates whether this service agreement is on credit hold due to payment delinquency or credit risk, potentially restricting service or requiring prepayment."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "credit_hold_flag" ;
