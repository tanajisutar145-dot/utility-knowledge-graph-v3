cmm:UtilityCompany a owl:Class ;
    rdfs:label "Utility Company"@en ;
    rdfs:comment "Master reference table for utility_company. Referenced by requesting_utility_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimCloseMatch cim:Organisation ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
