cmm:Feeder.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current lifecycle status of the feeder indicating its availability and operational state within the distribution network."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
