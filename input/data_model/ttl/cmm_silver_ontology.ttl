cmm:PlanningPeriod.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date-time when the planning period record was first created in the system."@en ;
    rdfs:domain cmm:PlanningPeriod ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:TimeSchedule.createdDateTime .
cmm:PlanningPeriod.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Free-form text describing the purpose, assumptions, or special notes for the period."@en ;
    rdfs:domain cmm:PlanningPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "planning_period_description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:PlanningPeriod.endDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end date"@en ;
    rdfs:comment "Last calendar date of the planning period."@en ;
    rdfs:domain cmm:PlanningPeriod ; rdfs:range xsd:date ;
    cmm:physicalColumn "end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:PlanningPeriod.forecastHorizonDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast horizon days"@en ;
    rdfs:comment "Number of days ahead for which forecasts are generated within this period."@en ;
    rdfs:domain cmm:PlanningPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "forecast_horizon_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:PlanningPeriod.horizonDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "horizon days"@en ;
