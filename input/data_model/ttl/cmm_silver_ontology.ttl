cmm:MeterRoute a owl:Class ;
    rdfs:label "Meter Route"@en ;
    rdfs:comment "Master reference table for meter_route. Referenced by route_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TimeSchedule ;
    cmm:cimExtends cim:TimeSchedule ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.ami_operations ;
    cmm:physicalTable "utility_cmm_silver.metering.meter_route" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.metering.meter_route" ;
    owl:hasKey ( cmm:MeterRoute.meterRouteId ) .

cmm:MeterRoute.meterRouteId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter route id"@en ;
    rdfs:comment "Primary key for meter_route"@en ;
    rdfs:domain cmm:MeterRoute ; rdfs:range xsd:long ;
    cmm:physicalColumn "meter_route_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Meter Route Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:MeterRoute.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Identifier of the service area to which the route belongs."@en ;
    rdfs:domain cmm:MeterRoute ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_route_service_territory_id" ;
    cmm:cimAssociation "TimeSchedule.SubGeographicalRegion" .
cmm:MeterRoute.parentMeterRoute a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent meter route"@en ;
    rdfs:comment "Self-referencing FK on meter_route (parent_meter_route_id)"@en ;
    rdfs:domain cmm:MeterRoute ; rdfs:range cmm:MeterRoute ;
    cmm:physicalColumn "parent_meter_route_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_route_parent_meter_route_id" ;
    cmm:cimAssociation "TimeSchedule.TimeSchedule" .
