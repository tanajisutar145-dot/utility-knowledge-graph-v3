cmm:SparePartsInventory.materialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material number"@en ;
    rdfs:comment "Unique material master identifier assigned to the spare part or consumable item in the enterprise asset management system. This is the externally-known business identifier used across procurement, inventory, and maintenance operations."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
