cmm:AncillaryServiceOffer.maximumRunTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum run time minutes"@en ;
    rdfs:comment "The maximum continuous operating time in minutes that the generating unit can sustain the offered ancillary service capacity."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_run_time_minutes" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Run Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:AncillaryServiceOffer.minimumRunTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum run time minutes"@en ;
    rdfs:comment "The minimum continuous operating time in minutes that the generating unit must maintain once dispatched for the ancillary service."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_run_time_minutes" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Run Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:AncillaryServiceOffer.mustOfferObligationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "must offer obligation flag"@en ;
    rdfs:comment "Boolean flag indicating whether the generating unit is under a must-offer obligation to provide ancillary services as part of its capacity commitment or interconnection agreement."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "must_offer_obligation_flag" ;
