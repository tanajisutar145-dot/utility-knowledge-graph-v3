cmm:EmissionsReport.heatInputMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat input mmbtu"@en ;
    rdfs:comment "The total heat input to the generation unit during the reporting period, measured in million British thermal units (MMBtu)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
