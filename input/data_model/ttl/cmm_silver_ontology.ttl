cmm:RequestForQuotation a owl:Class ;
    rdfs:label "Request For Quotation"@en ;
    rdfs:comment "Request for quotation and vendor response records for competitive bidding on utility materials, equipment, and services. Captures RFQ header: RFQ number, date, submission deadline, material or service description, quantity, required delivery date, and status. Captures vendor quotation responses: vendor, quoted price, price unit, currency, delivery lead time, validity period, payment terms, incoterms, technical compliance notes, and quotation ranking. Supports strategic sourcing for high-value utility equipment (power transformers, circuit breakers, generation spare parts) and fuel supply tenders. Enables price comparison, award decisions, and competitive procurement documentation across the utility portfolio."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpQuote ;
    cmm:cimCloseMatch cim:ErpQuote ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:supply , cmmsa:supply.procurement_operations ;
    cmm:physicalTable "utility_cmm_silver.supply.request_for_quotation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP MM Request for Quotation (ME41/EKKO)" ;
    cmm:sourceObject "energy_utilities_ecm.supply.request_for_quotation" ;
    owl:hasKey ( cmm:RequestForQuotation.requestForQuotationId ) .

cmm:RequestForQuotation.requestForQuotationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request for quotation id"@en ;
    rdfs:comment "Primary key for request_for_quotation"@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range xsd:long ;
    cmm:physicalColumn "request_for_quotation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Request For Quotation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:RequestForQuotation.buyerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "buyer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: RFQ process requires tracking the purchasing employee responsible for vendor solicitation, evaluation, and award decisions. Buyer_name is denormalized text; FK enables workload balancing, procurement"@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "buyer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Buyer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_request_for_quotation_buyer_employee_id" ;
    cmm:cimAssociation "ErpQuote.ErpPersonnel" .
cmm:RequestForQuotation.purchaseRequisition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "purchase requisition"@en ;
    rdfs:comment "Foreign key linking to supply.purchase_requisition. Business justification: RFQs are often generated from purchase requisitions to obtain competitive quotes. N:1 relationship - one RFQ typically originates from one requisition (though multiple RFQs could be issued for complex"@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range cmm:PurchaseRequisition ;
    cmm:physicalColumn "purchase_requisition_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Purchase Requisition Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_request_for_quotation_purchase_requisition_id" ;
    cmm:cimAssociation "ErpQuote.ErpRequisition" .
cmm:RequestForQuotation.requestAwardedVendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "request awarded vendor"@en ;
    rdfs:comment "Identifier of the vendor selected to receive the purchase order based on quotation evaluation."@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "request_awarded_vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Awarded Vendor ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_request_for_quotation_request_awarded_vendor_id" ;
    cmm:cimAssociation "ErpQuote.Organisation" .
cmm:RequestForQuotation.requestVendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "request vendor"@en ;
    rdfs:comment "FK to supply.vendor.vendor_id — RFQs are issued to specific vendors for competitive bidding. Required for sourcing event tracking."@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "request_vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_request_for_quotation_request_vendor_id" ;
    cmm:cimAssociation "ErpQuote.Organisation" .
cmm:RequestForQuotation.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "FK to supply.vendor.vendor_id — RFQs are sent to vendors and quotation responses come from vendors. Required for competitive bidding tracking and award decisions."@en ;
    rdfs:domain cmm:RequestForQuotation ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_request_for_quotation_vendor_id" ;
    cmm:cimAssociation "ErpQuote.Organisation" .
cmm:RequestForQuotation.assetNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
