cmm:ComplianceViolation.severity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "severity"@en ;
    rdfs:comment "Severity rating assigned to the violation reflecting potential impact."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
