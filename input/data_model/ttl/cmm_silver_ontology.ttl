cmm:RateSchedule.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this rate schedule record was last modified in the billing system."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
