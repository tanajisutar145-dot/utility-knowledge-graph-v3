    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certificate of Public Convenience and Necessity (CPCN) Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PowerPlant.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this power plant record was first created in the system."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:dateTime ;
