cmm:RegulatoryCorrespondence.boardNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board notification date"@en ;
    rdfs:comment "Date the Board of Directors or executive leadership was notified of the correspondence. Format: yyyy-MM-dd."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_notification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
