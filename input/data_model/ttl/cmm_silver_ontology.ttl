    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Input Million British Thermal Units (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
