cmm:RateSchedule.rateScheduleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule status"@en ;
    rdfs:comment "Current lifecycle status of the rate schedule in the billing system."@en ;
