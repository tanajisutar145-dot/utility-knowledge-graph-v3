cmm:ClusterStudyGroup.applicationCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application count"@en ;
    rdfs:comment "Total number of interconnection applications included in this cluster study group cohort. Reflects the volume of DER projects being evaluated simultaneously."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:int ;
    cmm:physicalColumn "application_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Count" ;
