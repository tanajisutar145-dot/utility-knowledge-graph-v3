cmm:NemCredit.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this credit transaction (typically USD)."@en ;
