    rdfs:label "severity classification"@en ;
    rdfs:comment "Severity level of the incident: fatality (death), lost_time (days away from work), restricted_duty (job transfer or restriction), medical_treatment (beyond first aid), first_aid (minor treatment), near_miss (no injury)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "severity_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
