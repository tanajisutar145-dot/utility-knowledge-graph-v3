    rdfs:comment "Annual or one-time fee paid to the regulatory agency for permit issuance, renewal, or maintenance. Fee structure varies by permit type and jurisdiction."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "permit_fee_amount" ;
