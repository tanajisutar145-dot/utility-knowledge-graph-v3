    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code in SAP S/4HANA to which this labor cost is posted."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.hoursWorked a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hours worked"@en ;
    rdfs:comment "Total number of hours worked by the employee or contractor for this allocation. Includes regular, overtime, and double-time hours."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hours_worked" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hours Worked" ;
    cmm:cimDatatype "Decimal" .
cmm:LaborCostAllocation.jobClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "job classification"@en ;
    rdfs:comment "Job classification or title of the employee or contractor performing the work (e.g., Journeyman Lineman, Substation Technician, Plant Operator, Engineer)."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "job_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Job Classification" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.laborRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor rate"@en ;
    rdfs:comment "The blended hourly labor rate applied to this allocation, including base wage, benefits, and burden. Expressed in USD per hour."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_rate" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Rate" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:LaborCostAllocation.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or name of the person who last modified this labor cost allocation record."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this labor cost allocation record was last modified."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:LaborCostAllocation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments about this labor cost allocation, including special circumstances, exceptions, or clarifications."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:LaborCostAllocation.overtimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overtime hours"@en ;
    rdfs:comment "Number of overtime hours worked for this allocation, typically at 1.5x regular rate per union agreements or labor law."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "overtime_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overtime (OT) Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LaborCostAllocation.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "Date on which the labor cost allocation was posted to SAP S/4HANA general ledger. Null if not yet posted."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:LaborCostAllocation.regularHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regular hours"@en ;
    rdfs:comment "Number of regular hours worked (non-overtime) for this allocation."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regular_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regular Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LaborCostAllocation.reversalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal date"@en ;
    rdfs:comment "Date on which this labor cost allocation was reversed. Null if not reversed."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "reversal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Date" ;
    cmm:cimDatatype "Date" .
cmm:LaborCostAllocation.reversalIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal indicator"@en ;
    rdfs:comment "Flag indicating whether this labor cost allocation has been reversed due to error correction or reallocation. True if reversed, False otherwise."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:LaborCostAllocation.reversalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason"@en ;
    rdfs:comment "Free-text explanation of why this labor cost allocation was reversed. Null if not reversed."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Reason" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.sapDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap document number"@en ;
    rdfs:comment "SAP S/4HANA financial document number generated when this labor cost allocation was posted to the general ledger. Null if not yet posted."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "sap_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "SAP Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:LaborCostAllocation.shiftType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift type"@en ;
    rdfs:comment "Type of work shift during which the labor was performed. Affects labor rate multipliers and union agreement compliance."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Type" ;
    cmm:validValues "day|night|swing|on_call|emergency" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.timeEntrySource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time entry source"@en ;
    rdfs:comment "Source system or method by which the labor hours were originally captured (e.g., mobile field app, web timesheet, biometric time clock)."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "time_entry_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Entry Source" ;
    cmm:validValues "mobile_app|web_portal|time_clock|supervisor_entry|payroll_import" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.totalLaborCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total labor cost"@en ;
    rdfs:comment "Total labor cost for this allocation, calculated as hours_worked multiplied by labor_rate. Expressed in USD."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_labor_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Labor Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:LaborCostAllocation.unionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union code"@en ;
    rdfs:comment "Code identifying the labor union to which the employee belongs. Null for non-union employees and contractors. Used for union agreement compliance and labor cost reporting."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Code" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.workDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work date"@en ;
    rdfs:comment "The date on which the labor was actually performed. May differ from allocation_date if allocation is recorded retrospectively."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "work_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Date" ;
    cmm:cimDatatype "Date" .
cmm:LaborCostAllocation.workLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location code"@en ;
    rdfs:comment "Code identifying the geographic location or facility where the work was performed. Used for regional cost analysis and labor mobility tracking."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Location Code" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or name of the person who created this labor cost allocation record."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:NercCipAccess a owl:Class ;
    rdfs:label "Nerc Cip Access"@en ;
    rdfs:comment "NERC CIP-004 and CIP-006 access authorization records for employees and contractors with logical or physical access to Critical Cyber Assets (CCAs) and Critical Infrastructure Protection (CIP) facilities including control rooms, generation plants, and transmission substations. Captures access type (physical/logical), CIP facility or system, authorization date, revocation date, PRA completion reference, and seven-year retention flag. Mandatory evidence for NERC CIP compliance audits."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.nerc_cip_access" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC CIP-004; NERC CIP-004 R4 Access Management; NERC CIP-006 Physical Security" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.nerc_cip_access" ;
    owl:hasKey ( cmm:NercCipAccess.nercCipAccessId ) .

cmm:NercCipAccess.nercCipAccessId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip access id"@en ;
    rdfs:comment "Unique identifier for the NERC CIP access authorization record. Primary key for the access authorization entity."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range xsd:long ;
    cmm:physicalColumn "nerc_cip_access_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Critical Infrastructure Protection (CIP) Access ID" ;
    cmm:cimDatatype "Integer" .
cmm:NercCipAccess.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: NERC CIP access authorizations are control-area-specific (CCA boundaries). Linking enables CIP-002 BES Cyber System access audits and personnel risk assessments by operational jurisdiction."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_control_area_id" ;
    cmm:cimAssociation "Agreement.ControlArea" .
cmm:NercCipAccess.logicalAccessAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "logical access account"@en ;
    rdfs:comment "User account identifier or login credential for logical access to Critical Cyber Assets. Applicable for logical access authorizations."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "logical_access_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Logical Access Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_logical_access_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:NercCipAccess.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Identifier for the CIP-designated facility to which access is granted, such as control centers, generation plants, or transmission substations."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Critical Infrastructure Protection (CIP) Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_nerc_cip_asset_id" ;
    cmm:cimAssociation "Agreement.Asset" .
cmm:NercCipAccess.nercEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — NERC CIP access records must link to the specific employee or contractor granted access. This is mandatory audit evidence for NERC CIP-004 and CIP-006 compliance. Without this FK, access authorization"@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "nerc_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_nerc_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:NercCipAccess.primaryNercEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary nerc employee"@en ;
    rdfs:comment "Unique identifier for the employee or contractor being granted access. Links to the workforce employee master record."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_nerc_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_primary_nerc_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:NercCipAccess.tertiaryNercModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary nerc modified by user employee"@en ;
    rdfs:comment "Identifier of the user who last modified this access authorization record, required for accountability and audit trail."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_nerc_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_nerc_cip_access_tertiary_nerc_modified_by_user_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:NercCipAccess.accessAuthorizationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "access authorization number"@en ;
    rdfs:comment "Business identifier for the access authorization record, typically used in audit documentation and compliance reporting."@en ;
    rdfs:domain cmm:NercCipAccess ; rdfs:range xsd:string ;
