    cmm:validValues "USD_per_kW|USD_per_MWh|USD_per_REC|percent|USD" ;
    cmm:cimDatatype "String" .
cmm:IncentiveProgram.incentiveRateValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate value"@en ;
    rdfs:comment "Numeric value of the incentive rate corresponding to the rate structure (e.g., 0.25 for $0.25/kW, 30.0000 for 30% of cost)."@en ;
