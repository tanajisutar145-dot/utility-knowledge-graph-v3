cmm:CustomerInvoice.billingCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle"@en ;
    rdfs:comment "FK to billing.billing_cycle.billing_cycle_id — Every invoice is generated within a billing cycle run. Critical for billing operations monitoring and batch reconciliation."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:long ;
