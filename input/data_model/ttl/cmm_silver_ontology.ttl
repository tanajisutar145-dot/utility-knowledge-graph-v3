cmm:RegulatoryCorrespondence.closureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure date"@en ;
    rdfs:comment "Date the correspondence matter was closed or resolved, indicating no further action is required. Format: yyyy-MM-dd."@en ;
