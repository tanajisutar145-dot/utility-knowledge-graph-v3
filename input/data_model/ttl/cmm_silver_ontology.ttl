cmm:ControlArea.nercRegisteredEntityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc registered entity code"@en ;
    rdfs:comment "Official NERC registry identifier for the balancing authority entity responsible for this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_registered_entity_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
