cmm:ClusterStudyGroup a owl:Class ;
    rdfs:label "Cluster Study Group"@en ;
    rdfs:comment "Record of a cluster or group study cohort formed under FERC Order 2023 cluster interconnection study rules, grouping multiple DER applications in the same geographic area for simultaneous impact study processing. Captures study group identifier, geographic study area (feeder, substation zone, planning area), study group formation date, number of applications in group, study type (cluster feasibility, cluster system impact, cluster facilities), study contractor, study start date, estimated completion date, and group study cost allocation methodology. Enables efficient processing of high-volume DER interconnection queues."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.cluster_study_group" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC Order 2023; FERC Order 2023 Cluster Study Group" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.cluster_study_group" ;
    owl:hasKey ( cmm:ClusterStudyGroup.clusterStudyGroupId ) .

cmm:ClusterStudyGroup.clusterStudyGroupId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster study group id"@en ;
    rdfs:comment "Unique identifier for the cluster study group cohort formed under FERC Order 2023 cluster interconnection study rules. Primary key for the cluster study group entity."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:long ;
    cmm:physicalColumn "cluster_study_group_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Cluster Study Group Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ClusterStudyGroup.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Cluster studies group multiple DER applications by control area to assess cumulative impact on balancing authority operations, reserve requirements, and frequency response capability. Required for eff"@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:ClusterStudyGroup.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Primary substation serving the geographic area of this cluster study group. Reference to the substation asset where multiple DER interconnections are proposed."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_distribution_substation_id" ;
    cmm:cimAssociation "Document.Substation" .
cmm:ClusterStudyGroup.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User identifier of the system user who created the cluster study group record. Audit trail for accountability and data governance."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:ClusterStudyGroup.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Primary distribution feeder circuit serving the cluster study group area. Reference to the feeder where DER applications are concentrated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_feeder_id" ;
    cmm:cimAssociation "Document.Feeder" .
cmm:ClusterStudyGroup.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Cluster study results feed IRP scenario development for DER penetration assumptions, grid investment planning, and capacity expansion decisions. Regulatory requirement - utilities must incorporate int"@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ClusterStudyGroup.studyManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "study manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Cluster studies require internal utility engineer coordination for multi-application analysis, stakeholder communication, regulatory milestone tracking, and cost allocation oversight. Essential for st"@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "study_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Study Manager Employee Id (Foreign Key)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cluster_study_group_study_manager_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:ClusterStudyGroup.actualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion date"@en ;
    rdfs:comment "Actual date when the cluster study was completed and final study report was issued to all participating applicants."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_completion_date" ;
