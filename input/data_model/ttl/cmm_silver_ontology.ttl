cmm:PenaltyAssessment.violatedStandardCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violated standard code"@en ;
    rdfs:comment "The specific regulatory standard, rule, or requirement that was violated (e.g., NERC CIP-007-6, 40 CFR Part 60, PUC Rule 25.95)."@en ;
