cmm:StudyPathAnalysis.voltageViolationsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violations count"@en ;
    rdfs:comment "Number of voltage limit violations identified on this specific path during this study's contingency analysis"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:int ;
    cmm:physicalColumn "voltage_violations_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Violations Count" ;
