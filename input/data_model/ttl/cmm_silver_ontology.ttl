    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.reserveRequirementMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reserve requirement mw"@en ;
    rdfs:comment "Minimum operating reserve requirement in megawatts that must be maintained for reliability and contingency response."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reserve_requirement_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reserve Requirement (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.rtoIsoAffiliation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso affiliation"@en ;
    rdfs:comment "Name of the RTO or ISO market operator with which this control area is affiliated, if applicable (e.g., PJM, CAISO, MISO, SPP, NYISO, ISO-NE, ERCOT)."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_affiliation" ;
