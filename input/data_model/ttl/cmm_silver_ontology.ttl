    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Invoice Number" ;
    cmm:cimDatatype "String" ;
