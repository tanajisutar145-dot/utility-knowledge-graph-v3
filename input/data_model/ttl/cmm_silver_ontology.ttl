    rdfs:label "affiliate transaction flag"@en ;
    rdfs:comment "Indicates whether the reported transaction involved an affiliated entity, requiring additional disclosure under FERC affiliate transaction rules."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:boolean ;
