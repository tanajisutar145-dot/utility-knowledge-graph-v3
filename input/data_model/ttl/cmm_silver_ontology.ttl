    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "message_template_name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:MessageTemplate.placeholderVariables a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "placeholder variables"@en ;
    rdfs:comment "Comma-separated list of variable names (e.g., {customer_name},{outage_start}) that the template expects."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:string ;
    cmm:physicalColumn "placeholder_variables" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:MessageTemplate.priority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Numeric priority (1 = highest) used for routing and escalation."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority" ;
