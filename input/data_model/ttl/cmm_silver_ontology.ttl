    cmm:cimCloseMatch cim:Document.status .
cmm:ApplicationDocument.documentToApplication a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document to application"@en ;
    rdfs:comment "FK to interconnection.interconnection_application.interconnection_application_id — Documents are submitted as part of a specific application package. This FK links documents to their parent application — essential for completeness determination and document management."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:long ;
    cmm:physicalColumn "document_to_application" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationDocument.documentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "Classification of the document submitted or issued as part of the interconnection application. Identifies the nature and purpose of the document in the application package. Reference-value candidates: single_line_diagram|site_plan|equipment_specification_sheet|inverter_datasheet|ul_1741_certification|load_calculation|executed_agreement|insurance_certificate|permit|as_built_drawing|nem_agreement|sgip_application|electrical_permit|building_permit|utility_interconnection_agreement|proof_of_ownership|authorization_letter|technical_review_report|impact_study_report|commissioning_report|other."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Document Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:ApplicationDocument.documentVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document version"@en ;
    rdfs:comment "Version number or identifier of the document to track revisions and superseded versions throughout the application lifecycle."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Version" ;
    cmm:cimDatatype "String" .
cmm:ApplicationDocument.fileFormat a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "file format"@en ;
    rdfs:comment "Format or file type of the document (e.g., PDF, DOCX, DWG, image formats) to support proper rendering and compatibility checks. Reference-value candidates: pdf|docx|xlsx|dwg|jpg|png|tiff|xml|csv|other."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:string ;
    cmm:physicalColumn "file_format" ;
