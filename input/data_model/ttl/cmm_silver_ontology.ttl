cmm:ComplianceRiskAssessment a owl:Class ;
    rdfs:label "Compliance Risk Assessment"@en ;
    rdfs:comment "Periodic compliance risk assessment record capturing risk scoring of each regulatory obligation or compliance program area. Records risk likelihood, impact severity, residual risk after controls, risk trend direction, assessment methodology, assessor, and assessment date. Used to prioritize compliance monitoring resources, inform audit planning, and support Board-level risk heat maps. Covers NERC CIP risk assessments, environmental compliance risk reviews, and enterprise compliance risk rankings required by most utility compliance frameworks."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:RiskScore ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.security_controls ;
    cmm:physicalTable "utility_cmm_silver.compliance.compliance_risk_assessment" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "ISO 31000" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.compliance_risk_assessment" ;
    owl:hasKey ( cmm:ComplianceRiskAssessment.complianceRiskAssessmentId ) .

cmm:ComplianceRiskAssessment.complianceRiskAssessmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance risk assessment id"@en ;
    rdfs:comment "Unique identifier for the compliance risk assessment record. Primary key."@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "compliance_risk_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Compliance Risk Assessment ID" ;
    cmm:cimDatatype "Integer" .
cmm:ComplianceRiskAssessment.assessorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assessor employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Risk assessments require employee assessor accountability for risk evaluation quality. Replaces text field with FK to enable assessor workload tracking, assessment quality analysis, and risk assessmen"@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "assessor_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assessor Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_assessor_employee_id" ;
    cmm:cimAssociation "RiskScore.ErpPersonnel" .
cmm:ComplianceRiskAssessment.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: A compliance risk assessment may be conducted following an audit to evaluate residual risk and control effectiveness. Many risk assessments can be triggered by one audit (1:N). Adding audit_id FK link"@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_audit_id" ;
    cmm:cimAssociation "RiskScore.ActivityRecord" .
cmm:ComplianceRiskAssessment.correctiveActionPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Reference to the formal corrective action plan addressing the identified compliance risk, if one has been initiated."@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Corrective Action Plan (CAP) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_corrective_action_plan_id" ;
    cmm:cimAssociation "RiskScore.Document" .
cmm:ComplianceRiskAssessment.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Reference to the specific regulatory obligation or compliance program area being assessed for risk."@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_obligation_id" ;
    cmm:cimAssociation "RiskScore.Document" .
cmm:ComplianceRiskAssessment.program a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "program"@en ;
    rdfs:comment "Reference to the compliance program under which this risk assessment is conducted."@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Program ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_program_id" ;
    cmm:cimAssociation "RiskScore.Document" .
cmm:ComplianceRiskAssessment.previousComplianceRiskAssessment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "previous compliance risk assessment"@en ;
    rdfs:comment "Self-referencing FK on compliance_risk_assessment (previous_compliance_risk_assessment_id)"@en ;
    rdfs:domain cmm:ComplianceRiskAssessment ; rdfs:range cmm:ComplianceRiskAssessment ;
    cmm:physicalColumn "previous_compliance_risk_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_compliance_risk_assessment_previous_compliance_risk_assessment_id" ;
    cmm:cimAssociation "RiskScore.RiskScore" .
cmm:ComplianceRiskAssessment.assessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment date"@en ;
    rdfs:comment "Date when the risk assessment was performed or completed. Used to track assessment currency and inform audit planning cycles."@en ;
