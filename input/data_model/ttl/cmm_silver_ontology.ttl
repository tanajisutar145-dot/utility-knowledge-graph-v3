    rdfs:comment "Total budget allocated for the incentive program in USD. Used for tracking program expenditures and remaining capacity."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "program_budget_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Budget Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IncentiveProgram.programCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program code"@en ;
    rdfs:comment "Externally-known unique code or identifier for the incentive program used in regulatory filings and customer communications."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
