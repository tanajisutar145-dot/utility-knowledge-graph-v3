cmm:CapexExpenditure.expenditureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expenditure amount"@en ;
    rdfs:comment "The gross monetary value of this capital expenditure transaction before any adjustments or allocations. Represents the invoice or payment amount."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:decimal ;
