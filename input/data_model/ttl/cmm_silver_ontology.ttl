cmm:TransmissionServiceAgreement.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "Actual date when this transmission service agreement was terminated, if applicable."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
