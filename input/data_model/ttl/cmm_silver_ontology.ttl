cmm:ApplicationDocument.issuingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing authority"@en ;
    rdfs:comment "Name of the organization, agency, or authority that issued the document, certification, or permit (e.g., UL, local building department, state PUC)."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Authority" ;
    cmm:cimDatatype "String" .
cmm:ApplicationDocument.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when the document record was last modified or updated in the interconnection application system."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:dateTime ;
