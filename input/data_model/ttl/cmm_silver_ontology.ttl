cmm:BillingRun.glPostingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl posting status"@en ;
    rdfs:comment "Status of the financial posting to the general ledger, indicating whether accounts receivable and revenue entries have been successfully recorded."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_posting_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Posting Status" ;
    cmm:validValues "not_posted|posted|posting_failed|reversed" ;
