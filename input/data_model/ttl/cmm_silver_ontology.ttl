cmm:RegulatoryCorrespondence.correspondenceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "correspondence type"@en ;
    rdfs:comment "Indicates whether the correspondence is inbound (received from regulator) or outbound (sent to regulator)."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
