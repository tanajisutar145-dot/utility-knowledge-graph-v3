cmm:Terminal a owl:Class ;
    rdfs:label "Terminal"@en ;
    rdfs:comment "CIM Terminal: AC electrical connection point of a piece of conducting equipment to a ConnectivityNode, with phases. Equipment is referenced polymorphically by canonical table, id and mRID."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Terminal ;
