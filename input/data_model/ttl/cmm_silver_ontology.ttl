cmm:RateSchedule.jurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jurisdiction"@en ;
    rdfs:comment "State or regulatory jurisdiction code where this rate schedule is approved and applicable. Uses standard state abbreviations or jurisdiction codes."@en ;
