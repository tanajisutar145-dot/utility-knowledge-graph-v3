cmm:TransmissionConstraint.congestionPriceUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion price usd per mwh"@en ;
    rdfs:comment "Congestion price associated with the constraint in US dollars per megawatt-hour."@en ;
    rdfs:domain cmm:TransmissionConstraint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "congestion_price_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
