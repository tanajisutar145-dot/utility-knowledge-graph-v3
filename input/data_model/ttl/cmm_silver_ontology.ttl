    rdfs:domain cmm:SelfReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_penalty_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
