    cmm:cimDatatype "Money" .
cmm:ContractorCompany.bondCompany a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bond company"@en ;
    rdfs:comment "Name of the surety company providing a performance bond for the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "bond_company" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.certifications a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certifications"@en ;
    rdfs:comment "Comma-separated list of professional certifications held by the contractor (e.g., ISO 9001, ISO 14001)."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "certifications" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.city a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "city"@en ;
    rdfs:comment "City of the contractor's primary address."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
