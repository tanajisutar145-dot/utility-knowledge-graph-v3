cmm:Crew.insuranceCertificateExpiryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance certificate expiry date"@en ;
    rdfs:comment "Expiration date of contractor liability insurance certificate. Crews cannot be dispatched if insurance is expired. Null for utility employee crews."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:date ;
    cmm:physicalColumn "insurance_certificate_expiry_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Certificate Expiry Date" ;
    cmm:cimDatatype "Date" .
cmm:Crew.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when the crew record was last updated. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
