    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DunningSchedule.scheduleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule type"@en ;
    rdfs:comment "Classification of the schedule indicating whether it follows a standard, custom, or regulatory pattern."@en ;
    rdfs:domain cmm:DunningSchedule ; rdfs:range xsd:string ;
