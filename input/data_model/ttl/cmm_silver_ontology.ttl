cmm:RateSchedule.minimumUsageKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum usage kwh"@en ;
    rdfs:comment "Minimum monthly energy usage in kilowatt-hours required for customer eligibility. Null if no minimum applies."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_usage_kwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Usage (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RateSchedule.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or system identifier of the person or process that last modified this rate schedule record."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
