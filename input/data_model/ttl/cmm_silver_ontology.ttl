    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Analysis Date" ;
    cmm:cimDatatype "Date" .
cmm:StudyPathAnalysis.analysisStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis status"@en ;
    rdfs:comment "Current status of this path analysis within the study: pending, in_progress, completed, under_review"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
    cmm:physicalColumn "analysis_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Analysis Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:StudyPathAnalysis.atcImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc impact mw"@en ;
    rdfs:comment "Estimated impact on Available Transfer Capability (ATC) in megawatts for this specific path resulting from this study's findings"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "atc_impact_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ATC Impact Megawatts" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StudyPathAnalysis.contingencyScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency scenario"@en ;
    rdfs:comment "Description of contingency scenarios analyzed for this path in this study (e.g., N-1, N-2, generator outage)"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
    cmm:physicalColumn "contingency_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Scenario" ;
    cmm:cimDatatype "String" .
cmm:StudyPathAnalysis.estimatedUpgradeCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated upgrade cost usd"@en ;
    rdfs:comment "Estimated capital expenditure in USD for recommended upgrades to this specific path identified in this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_upgrade_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Upgrade Cost USD" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:StudyPathAnalysis.identifiedDeficiencies a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "identified deficiencies"@en ;
    rdfs:comment "Summary of transmission system deficiencies, violations, or reliability issues identified on this specific path during this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
    cmm:physicalColumn "identified_deficiencies" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Identified Deficiencies" ;
    cmm:cimDatatype "String" .
cmm:StudyPathAnalysis.limitingContingency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limiting contingency"@en ;
    rdfs:comment "Description of the most limiting contingency scenario that constrains this path's transfer capability in this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
    cmm:physicalColumn "limiting_contingency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limiting Contingency" ;
    cmm:cimDatatype "String" .
cmm:StudyPathAnalysis.limitingFacility a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limiting facility"@en ;
    rdfs:comment "Identification of the specific transmission facility (line, transformer, etc.) that is the limiting element on this path in this study"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
    cmm:physicalColumn "limiting_facility" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limiting Facility" ;
    cmm:cimDatatype "String" .
cmm:StudyPathAnalysis.recommendedUpgrades a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recommended upgrades"@en ;
    rdfs:comment "Summary of recommended transmission upgrades or mitigation measures for this specific path based on this study's findings"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:string ;
