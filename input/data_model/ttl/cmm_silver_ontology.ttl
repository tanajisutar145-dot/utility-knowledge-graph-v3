cmm:SparePartsInventory.manufacturerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer name"@en ;
    rdfs:comment "Name of the original equipment manufacturer (OEM) or supplier who produces the spare part. Used for warranty tracking, quality management, and supplier performance analysis."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
