cmm:SafetyIncident.rootCauseAnalysis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause analysis"@en ;
    rdfs:comment "Findings from the root cause investigation identifying underlying factors that contributed to the incident (e.g., inadequate training, equipment failure, procedural gap, environmental hazard)."@en ;
