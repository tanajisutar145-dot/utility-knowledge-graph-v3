cmm:ServiceAgreementIncentiveEnrollment a owl:Class ;
    rdfs:label "Service Agreement Incentive Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment relationship between a billing service agreement and a renewable incentive program. It captures the operational enrollment of a specific service agreement into a specific incentive program, tracking approval, payment, and compliance status. Each record links one billing service agreement to one incentive program with attributes that exist only in the context of this enrollment relationship.. Existence Justification: In energy utilities operations, a single billing service agreement can simultaneously participate in multiple renewable incentive programs (e.g., a residential solar customer enrolled in both a solar rebate program and a green tariff program and a low-income assistance program). Conversely, each incentive program serves many service agreements across the utility's customer base. The business actively manages these enrollments as operational entities, tracking approval amounts, payment schedules, compliance status, and payment history for each program-agreement combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.service_agreement_incentive_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.billing.service_agreement_incentive_enrollment" ;
    owl:hasKey ( cmm:ServiceAgreementIncentiveEnrollment.serviceAgreementIncentiveEnrollmentId ) .

cmm:ServiceAgreementIncentiveEnrollment.serviceAgreementIncentiveEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement incentive enrollment id"@en ;
    rdfs:comment "Unique identifier for this enrollment record. Primary key for the association."@en ;
    rdfs:domain cmm:ServiceAgreementIncentiveEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement_incentive_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Service Agreement Incentive Enrollment ID" ;
    cmm:cimDatatype "Integer" .
