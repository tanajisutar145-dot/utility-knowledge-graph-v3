    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "error_message" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:PayrollRun.isManual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is manual"@en ;
    rdfs:comment "Flag indicating whether the payroll run was executed manually (true) or automatically (false)."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_manual" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Boolean" .
cmm:PayrollRun.isRetroactive a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is retroactive"@en ;
    rdfs:comment "Indicates whether the run includes retroactive adjustments (true) or not (false)."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_retroactive" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Boolean" .
cmm:PayrollRun.payrollCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payroll cycle"@en ;
    rdfs:comment "Frequency with which payroll is processed for the organization."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "payroll_cycle" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:PayrollRun.payrollVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payroll version"@en ;
    rdfs:comment "Version identifier of the payroll processing logic or software used."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "payroll_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:PayrollRun.pensionContributionsAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pension contributions amount"@en ;
    rdfs:comment "Total employer pension contributions for the payroll period."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pension_contributions_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PayrollRun.periodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "period end date"@en ;
    rdfs:comment "Last day of the pay period covered by this run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:PayrollRun.periodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "period start date"@en ;
    rdfs:comment "First day of the pay period covered by this run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:PayrollRun.processingTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "processing time seconds"@en ;
    rdfs:comment "Total elapsed time, in seconds, to compute and finalize the payroll run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "processing_time_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:PayrollRun.runDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run date"@en ;
    rdfs:comment "Date on which the payroll processing was executed."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:PayrollRun.runNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run number"@en ;
    rdfs:comment "Human-readable business identifier for the payroll run, often used in reports and communications."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PayrollRun.runType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run type"@en ;
    rdfs:comment "Category of payroll processing (e.g., regular payroll, supplemental, bonus, termination, or adjustment)."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:PayrollRun.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Originating HR/Payroll system that supplied the data for this run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:PayrollRun.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current lifecycle status of the payroll run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "payroll_run_status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:PayrollRun.taxPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax period"@en ;
    rdfs:comment "Quarterly tax reporting period for the payroll run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:PayrollRun.taxWithheldAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax withheld amount"@en ;
    rdfs:comment "Total federal, state, and local taxes withheld from employee pay."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_withheld_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PayrollRun.taxYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax year"@en ;
    rdfs:comment "Fiscal year to which the payroll taxes apply."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "tax_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PayrollRun.totalDeductionsAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total deductions amount"@en ;
    rdfs:comment "Aggregate amount of all payroll deductions (taxes, benefits, garnishments) for the run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_deductions_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PayrollRun.totalGrossAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total gross amount"@en ;
    rdfs:comment "Sum of all gross earnings before deductions for the payroll run."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_gross_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PayrollRun.totalHoursWorked a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total hours worked"@en ;
    rdfs:comment "Cumulative regular hours worked by all employees for the period."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_hours_worked" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:PayrollRun.totalNetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total net amount"@en ;
    rdfs:comment "Net amount payable to employees after all deductions."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_net_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PayrollRun.totalOvertimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total overtime hours"@en ;
    rdfs:comment "Cumulative overtime hours worked by all employees for the period."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_overtime_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:PayrollRun.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to the payroll run record."@en ;
    rdfs:domain cmm:PayrollRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .


#################################################################
# Subject area: gis
#################################################################

cmm:CoordinateSystem a owl:Class ;
    rdfs:label "Coordinate System"@en ;
    rdfs:comment "Coordinate reference system (CRS) catalogue. Every geometry in the canonical model references a CRS by URN. CMM default is WGS84 geographic (urn:ogc:def:crs:EPSG::4326); projected CRS (e.g. State Plane, UTM) are registered here for GIS-native geometries."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CoordinateSystem ;
    cmm:cimExactMatch cim:CoordinateSystem ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.coordinate_system" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "IEC 61968-11 Common; OGC GeoSPARQL 1.1; ISO 19125; ISO 19111 (EPSG)" ;
    owl:hasKey ( cmm:CoordinateSystem.coordinateSystemId ) .

cmm:CoordinateSystem.coordinateSystemId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "coordinate system id"@en ;
    rdfs:comment "Surrogate primary key of CoordinateSystem."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:long ;
    cmm:physicalColumn "coordinate_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "CoordinateSystem Id" ;
    cmm:cimDatatype "Integer" .
cmm:CoordinateSystem.name a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "CRS name (e.g. WGS 84, NAD83 / UTM zone 15N)."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CoordinateSystem.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "CRS description."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CoordinateSystem.crsUrn a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crs urn"@en ;
    rdfs:comment "OGC CRS URN, e.g. urn:ogc:def:crs:EPSG::4326."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "crs_urn" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Crs Urn" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:CoordinateSystem.crsUrn .
cmm:CoordinateSystem.epsgCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "epsg code"@en ;
    rdfs:comment "EPSG registry code (ISO 19111)."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:int ;
    cmm:physicalColumn "epsg_code" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Epsg Code" ;
    cmm:cimDatatype "Integer" .
cmm:CoordinateSystem.crsKind a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crs kind"@en ;
    rdfs:comment "Kind of CRS."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "crs_kind" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crs Kind" ;
    cmm:validValues "geographic|projected|geocentric|vertical|compound|engineering" ;
    cmm:cimDatatype "String" .
cmm:CoordinateSystem.horizontalDatum a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "horizontal datum"@en ;
    rdfs:comment "Horizontal datum (e.g. WGS84, NAD83(2011))."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "horizontal_datum" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Horizontal Datum" ;
    cmm:cimDatatype "String" .
cmm:CoordinateSystem.verticalDatum a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vertical datum"@en ;
    rdfs:comment "Vertical datum for z values (e.g. NAVD88, EGM2008)."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "vertical_datum" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vertical Datum" ;
    cmm:cimDatatype "String" .
cmm:CoordinateSystem.axisOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "axis order"@en ;
    rdfs:comment "Axis order of x/y positions."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "axis_order" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Axis Order" ;
    cmm:validValues "lon_lat|lat_lon|easting_northing" ;
    cmm:cimDatatype "String" .
cmm:CoordinateSystem.linearUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "linear unit"@en ;
    rdfs:comment "Unit of measure of coordinates."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "linear_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Linear Unit" ;
    cmm:validValues "degree|metre|us_survey_foot|foot" ;
    cmm:cimDatatype "String" .
cmm:CoordinateSystem.isDefaultFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is default flag"@en ;
    rdfs:comment "TRUE for the enterprise default CRS (EPSG:4326)."@en ;
    rdfs:domain cmm:CoordinateSystem ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_default_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Default Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:GisLocation a owl:Class ;
    rdfs:label "Gis Location"@en ;
    rdfs:comment "Canonical CIM Location: the place where a power system resource, asset, usage point, work, outage or organisation is, has been or will be. Holds the geometry (WKT/WKB/GeoJSON, OGC Simple Features), its CRS, a representative WGS84 point, H3 spatial index and the postal address. Ordered vertices are in gis.position_point."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Location ;
    cmm:cimExactMatch cim:Location ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.location" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-11 Common; OGC GeoSPARQL 1.1; ISO 19125; ISO 19111 (EPSG)" ;
    owl:hasKey ( cmm:GisLocation.locationId ) .

cmm:GisLocation.locationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location id"@en ;
    rdfs:comment "Surrogate primary key of GisLocation."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:long ;
    cmm:physicalColumn "location_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "GisLocation Id" ;
    cmm:cimDatatype "Integer" .
cmm:GisLocation.name a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Location name."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:GisLocation.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Location description (e.g. pole number, vault, bay)."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:GisLocation.locationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location type"@en ;
    rdfs:comment "Classification by utility's corporate standards (e.g. pole, pad, vault, substation_yard, premise, right_of_way, region)."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Location Type" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:Location.type .
cmm:GisLocation.direction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "Directions for reaching the location."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Direction" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:Location.direction .
cmm:GisLocation.geoInfoReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geo info reference"@en ;
    rdfs:comment "Reference to the GIS system feature (e.g. Esri GlobalID, Smallworld id)."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "geo_info_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geo Info Reference" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:Location.geoInfoReference .
cmm:GisLocation.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Status of the location record."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Status" ;
    cmm:validValues "proposed|active|inactive|removed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.status .
cmm:GisLocation.coordinateSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "coordinate system"@en ;
    rdfs:comment "CRS in which geometry and position points are expressed."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range cmm:CoordinateSystem ;
    cmm:physicalColumn "coordinate_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Coordinate System Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_gis_location_coordinate_system_id" ;
    cmm:cimAssociation "Location.CoordinateSystem" .
cmm:GisLocation.mainAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "main address"@en ;
    rdfs:comment "Main postal address of the location (customer.address)."@en ;
    rdfs:domain cmm:GisLocation ; rdfs:range cmm:PostalAddress ;
    cmm:physicalColumn "main_address_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Main Address Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_gis_location_main_address_id" ;
    cmm:cimAssociation "Location.mainAddress" .
cmm:GisLocation.geometryType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geometry type"@en ;
    rdfs:comment "OGC Simple Features geometry type."@en ;
