cmm:SettlementRule a owl:Class ;
    rdfs:label "Settlement Rule"@en ;
    rdfs:comment "Master reference table for settlement_rule. Referenced by settlement_rule_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.settlement_rule" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.finance.settlement_rule" ;
    owl:hasKey ( cmm:SettlementRule.settlementRuleId ) .

cmm:SettlementRule.settlementRuleId a owl:DatatypeProperty , owl:FunctionalProperty ;
