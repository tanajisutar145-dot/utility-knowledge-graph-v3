    cmm:validValues "per_watt|per_kwh|percentage_of_cost|fixed_amount|tiered_capacity" ;
    cmm:cimDatatype "String" .
cmm:IncentiveApplication.installerContractorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installer contractor name"@en ;
    rdfs:comment "Name of the certified contractor or company performing the renewable energy system installation."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "installer_contractor_name" ;
