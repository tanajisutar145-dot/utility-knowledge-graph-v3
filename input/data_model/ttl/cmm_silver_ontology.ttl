cmm:RegulatoryCorrespondence.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Priority level assigned to the correspondence based on urgency, regulatory impact, and potential enforcement risk. Critical priority indicates immediate action required."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Correspondence Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:RegulatoryCorrespondence.proceedingName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "proceeding name"@en ;
    rdfs:comment "Name or title of the regulatory proceeding, case, or investigation to which this correspondence relates."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "proceeding_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Proceeding Name" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.regulatoryAgency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory agency"@en ;
    rdfs:comment "The regulatory body or agency involved in the correspondence. Includes NERC (North American Electric Reliability Corporation), FERC (Federal Energy Regulatory Commission), PUC (Public Utility Commission), EPA (Environmental Protection Agency), DOE (Department of Energy), and OSHA (Occupational Safety and Health Administration)."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_agency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Agency Name" ;
    cmm:validValues "NERC|FERC|PUC|EPA|DOE|OSHA" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.respondingDepartment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responding department"@en ;
    rdfs:comment "Name of the internal department or business unit responsible for preparing the response. Examples include Legal, Regulatory Affairs, Compliance, Environmental, Operations, or Finance."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "responding_department" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responding Department Name" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.responseAcknowledgmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response acknowledgment date"@en ;
    rdfs:comment "Date the regulatory agency acknowledged receipt of the utility's response. Format: yyyy-MM-dd."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_acknowledgment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Acknowledgment Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryCorrespondence.responseDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response due date"@en ;
    rdfs:comment "Date by which a response is required or expected. Critical for tracking compliance with regulatory deadlines and avoiding enforcement actions. Format: yyyy-MM-dd."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Due Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryCorrespondence.responseStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response status"@en ;
    rdfs:comment "Current status of the response to the correspondence. Tracks whether a response is pending, in progress, completed, overdue, or not required."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "response_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Status" ;
    cmm:validValues "pending|in_progress|completed|overdue|not_required" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.responseSubmittedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response submitted date"@en ;
    rdfs:comment "Date the utility's response was submitted to the regulatory agency. Format: yyyy-MM-dd."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_submitted_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Submitted Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryCorrespondence.subjectMatter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subject matter"@en ;
    rdfs:comment "Brief description of the subject matter or topic of the correspondence. Includes topics such as NERC CIP (Critical Infrastructure Protection) audits, FERC data requests, PUC rate case interrogatories, EPA emissions reporting, or DOE energy data submissions."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "subject_matter" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Correspondence Subject Matter" ;
    cmm:cimDatatype "String" .

cmm:NercCipAsset a owl:Class ;
    rdfs:label "Nerc Cip Asset"@en ;
    rdfs:comment "Registry of utility assets subject to NERC CIP (Critical Infrastructure Protection) standards, including bulk electric system (BES) cyber systems, electronic access points (EAPs), electronic security perimeters (ESPs), physical security perimeters (PSPs), control centers, and high/medium/low impact BES cyber systems. Captures CIP impact classification per CIP-002, associated BES facility, cyber system categorization, responsible senior manager, applicable CIP standard versions, last assessment date, and next reassessment due date. SSOT for CIP asset inventory required under CIP-002 and drives CIP obligation applicability mapping."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Asset ;
    cmm:cimExtends cim:Asset ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.security_controls ;
    cmm:physicalTable "utility_cmm_silver.compliance.nerc_cip_asset" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Asset.Location" ;
    cmm:standardReference "NERC CIP-002; NERC CIP-002-5.1a BES Cyber System Categorization" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.nerc_cip_asset" ;
    owl:hasKey ( cmm:NercCipAsset.nercCipAssetId ) .

cmm:NercCipAsset.nercCipAssetId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset id"@en ;
    rdfs:comment "Unique identifier for the NERC CIP asset record. Primary key for the asset registry subject to NERC CIP standards."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:long ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "NERC CIP (Critical Infrastructure Protection) Asset ID" ;
    cmm:cimDatatype "Integer" .
cmm:NercCipAsset.baselineConfiguration a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "baseline configuration"@en ;
    rdfs:comment "Reference to the CIP-010 baseline configuration record for this asset. Required for configuration change management and monitoring."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:BaselineConfiguration ;
    cmm:physicalColumn "baseline_configuration_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Baseline Configuration ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_baseline_configuration_id" ;
    cmm:cimAssociation "Asset.Document" .
cmm:NercCipAsset.besFacility a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bes facility"@en ;
    rdfs:comment "Reference to the BES facility (substation, control center, generation plant) where this asset is located or to which it is logically associated."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:BesFacility ;
    cmm:physicalColumn "bes_facility_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "BES (Bulk Electric System) Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_bes_facility_id" ;
    cmm:cimAssociation "Asset.PowerSystemResource" .
cmm:NercCipAsset.controlCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control center"@en ;
    rdfs:comment "Reference to the control center (EMS, SCADA control room, DMS) responsible for operating or monitoring this asset."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:ControlCenter ;
    cmm:physicalColumn "control_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Center ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_control_center_id" ;
    cmm:cimAssociation "Asset.IdentifiedObject" .
cmm:NercCipAsset.cyberSecurityIncidentResponsePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cyber security incident response plan"@en ;
    rdfs:comment "Reference to the CIP-008 Cyber Security Incident Response Plan that covers this asset."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:CyberSecurityIncidentResponsePlan ;
    cmm:physicalColumn "cyber_security_incident_response_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cyber Security Incident Response Plan ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_cyber_security_incident_response_plan_id" ;
    cmm:cimAssociation "Asset.Document" .
cmm:NercCipAsset.electronicSecurityPerimeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "electronic security perimeter"@en ;
    rdfs:comment "Reference to the Electronic Security Perimeter (ESP) that logically contains this cyber asset. Required for CIP-005 compliance."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:ElectronicSecurityPerimeter ;
    cmm:physicalColumn "electronic_security_perimeter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "ESP (Electronic Security Perimeter) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_electronic_security_perimeter_id" ;
    cmm:cimAssociation "Asset.IdentifiedObject" .
cmm:NercCipAsset.nercObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each NERC CIP asset is subject to specific CIP obligations (e.g., CIP-002 BES Cyber System Categorization, CIP-005 Electronic Security Perimeter). Many assets can be subject to one obligation (1:N). A"@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "nerc_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_nerc_obligation_id" ;
    cmm:cimAssociation "Asset.Document" .
cmm:NercCipAsset.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "FK to compliance.obligation.obligation_id — NERC CIP assets are subject to specific CIP standard obligations. Linking assets to obligations enables per-asset compliance tracking required by CIP-002."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_obligation_id" ;
    cmm:cimAssociation "Asset.Document" .
cmm:NercCipAsset.physicalSecurityPerimeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "physical security perimeter"@en ;
    rdfs:comment "Reference to the Physical Security Perimeter (PSP) that physically contains this asset. Required for CIP-006 compliance."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:PhysicalSecurityPerimeter ;
    cmm:physicalColumn "physical_security_perimeter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "PSP (Physical Security Perimeter) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_physical_security_perimeter_id" ;
    cmm:cimAssociation "Asset.IdentifiedObject" .
cmm:NercCipAsset.primaryNercRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary nerc registry"@en ;
    rdfs:comment "Reference to the physical or logical asset in the enterprise asset registry. Links this CIP-classified asset to the broader asset management system."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "primary_nerc_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_primary_nerc_registry_id" ;
    cmm:cimAssociation "Asset.Asset" .
cmm:NercCipAsset.recoveryPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recovery plan"@en ;
    rdfs:comment "Reference to the CIP-009 Recovery Plan (disaster recovery, business continuity) that includes this asset."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:RecoveryPlan ;
    cmm:physicalColumn "recovery_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Recovery Plan ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_recovery_plan_id" ;
    cmm:cimAssociation "Asset.Document" .
cmm:NercCipAsset.responsibleSeniorManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible senior manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: NERC CIP-003 requires senior manager accountability for BES Cyber Systems. Replaces text field with FK to enable delegation chain verification, CIP accountability reporting, and audit evidence collect"@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "responsible_senior_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Senior Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_nerc_cip_asset_responsible_senior_manager_employee_id" ;
    cmm:cimAssociation "Asset.ErpPersonnel" .
cmm:NercCipAsset.assetFunction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset function"@en ;
    rdfs:comment "Operational function or role of the asset within the BES (e.g., real-time monitoring, automatic generation control, protective relaying, energy management)."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_function" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Function" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.assetIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset identifier"@en ;
    rdfs:comment "Externally-known unique identifier or tag for the asset (e.g., serial number, asset tag, equipment ID). Used for audit and compliance tracking."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Identifier" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.assetLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset location"@en ;
    rdfs:comment "Physical or logical location of the asset (e.g., Substation 42, Control Center Building A, Data Center Rack 12). Organizational location data classified as confidential."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Location" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.assetOwnerOrganization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset owner organization"@en ;
    rdfs:comment "Business unit, division, or legal entity that owns this CIP asset. Used for accountability and audit trail."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_owner_organization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Owner Organization" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.assetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset type"@en ;
    rdfs:comment "Type or category of the asset (e.g., SCADA Server, EMS Workstation, Relay, RTU, Firewall, Router, Database Server)."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.type .
cmm:NercCipAsset.auditTrailRetentionDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit trail retention days"@en ;
    rdfs:comment "Number of days audit logs and event records for this asset must be retained per CIP-007. Typically 90 calendar days minimum."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:int ;
    cmm:physicalColumn "audit_trail_retention_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Audit Trail Retention Days" ;
