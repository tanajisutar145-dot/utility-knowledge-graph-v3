    rdfs:label "rec transfer confirmed flag"@en ;
    rdfs:comment "Boolean flag indicating whether REC transfer has been confirmed in the applicable REC tracking system (e.g., WREGIS, M-RETS, NEPOOL GIS)."@en ;
