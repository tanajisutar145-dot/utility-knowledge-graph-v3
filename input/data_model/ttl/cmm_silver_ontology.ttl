    rdfs:comment "Indicates whether a service disconnection order is pending for this agreement due to non-payment or other reasons."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disconnect_pending_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnect Pending Flag" ;
