cmm:PostalAddress.postalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "Postal or ZIP code for the address. Supports 5-digit, ZIP+4, and international postal code formats."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
