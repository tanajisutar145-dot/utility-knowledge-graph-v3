    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:LocationAssignment.effectiveEndTs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end ts"@en ;
    rdfs:comment "End of validity (NULL = current)."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_end_ts" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Ts" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .

cmm:GeographicalRegion a owl:Class ;
    rdfs:label "Geographical Region"@en ;
    rdfs:comment "CIM GeographicalRegion / SubGeographicalRegion hierarchy and other polygonal areas (service territory, franchise area, load area, control area, forecast zone, outage area, storm zone). Geometry via gis.location."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:GeographicalRegion ;
    cmm:cimExactMatch cim:GeographicalRegion ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.geographical_region" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-11 Common; OGC GeoSPARQL 1.1; ISO 19125; ISO 19111 (EPSG)" ;
    owl:hasKey ( cmm:GeographicalRegion.geographicalRegionId ) .

cmm:GeographicalRegion.geographicalRegionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographical region id"@en ;
    rdfs:comment "Surrogate primary key of GeographicalRegion."@en ;
