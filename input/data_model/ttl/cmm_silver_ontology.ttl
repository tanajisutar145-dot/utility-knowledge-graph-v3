cmm:RateSchedule.demandChargeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand charge rate"@en ;
    rdfs:comment "Demand charge rate in dollars per kilowatt of peak demand. Null for rate schedules without demand charges."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_charge_rate" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Charge Rate ($/kW)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateSchedule.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date on which this rate schedule ceases to be effective. Null for currently active rate schedules with no planned end date."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
