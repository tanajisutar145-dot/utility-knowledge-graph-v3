    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrIncentivePayment.capacityRatePerKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity rate per kw"@en ;
    rdfs:comment "The contracted capacity payment rate in dollars per kilowatt for the enrolled demand response capacity. Basis for capacity payment calculations."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_rate_per_kw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
