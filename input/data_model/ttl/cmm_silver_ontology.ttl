    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:EmergencyStockEvent.femaDeclarationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fema declaration number"@en ;
    rdfs:comment "Federal disaster declaration number if this event qualifies for FEMA reimbursement, used for documentation and claims."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
