cmm:Certification.instructorQualificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "instructor qualification required"@en ;
    rdfs:comment "Description of the qualifications or certifications required for instructors who deliver this training program (e.g., Certified OSHA Trainer, Master Electrician with 10+ years experience, NERC-approved instructor, Internal Subject Matter Expert with Instructor Certification). Null if not applicable."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "instructor_qualification_required" ;
