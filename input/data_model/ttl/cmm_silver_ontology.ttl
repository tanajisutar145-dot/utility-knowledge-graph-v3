cmm:CostCenter.costCenterType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center type"@en ;
    rdfs:comment "Type of cost center indicating its role in cost allocation. Standard cost centers collect direct costs; auxiliary and overhead centers allocate costs to other cost centers."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cost Center Type" ;
    cmm:validValues "standard|auxiliary|overhead|project|service" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Organisation.kind .
cmm:CostCenter.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User ID of the person who created the cost center master record in the system."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
