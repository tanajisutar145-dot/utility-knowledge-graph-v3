    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:CapexExpenditure.goodsReceiptDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "goods receipt date"@en ;
    rdfs:comment "The date on which goods or services were received and confirmed in the system. Triggers the capitalization eligibility for the expenditure."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
