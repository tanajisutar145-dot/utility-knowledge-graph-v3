cmm:SelfReport.evidenceCollectionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "evidence collection method"@en ;
    rdfs:comment "Description of how supporting evidence and documentation for this self-report was collected and preserved."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "evidence_collection_method" ;
