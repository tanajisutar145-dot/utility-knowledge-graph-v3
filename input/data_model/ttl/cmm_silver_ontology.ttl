    cmm:cimDatatype "String" .
cmm:JobRequisition.fullTimeEquivalent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "full time equivalent"@en ;
    rdfs:comment "Numeric representation of the position workload as a fraction of full-time hours. 1.0 for full-time, 0.5 for half-time. Used for headcount budgeting and capacity planning."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "full_time_equivalent" ;
