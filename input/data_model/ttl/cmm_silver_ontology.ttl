cmm:PowerPlant.startupTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup time hours"@en ;
    rdfs:comment "Typical time in hours required to bring the plant from offline to minimum load (cold start)."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:PowerPlant.stateProvince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state province"@en ;
    rdfs:comment "Two-letter state or province code where the facility is located (ISO 3166-2 subdivision code)."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
