cmm:ApplicationDocument.documentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document status"@en ;
    rdfs:comment "Current lifecycle status of the document in the interconnection application review process. Tracks progression from submission through acceptance or rejection. Reference-value candidates: received|under_review|accepted|rejected|superseded|pending_resubmission|archived."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_status" ;
