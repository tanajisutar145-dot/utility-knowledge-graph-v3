cmm:TaxProvision.statutoryTaxRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statutory tax rate"@en ;
    rdfs:comment "The statutory federal and state combined income tax rate applicable to the legal entity for the fiscal period, expressed as a decimal (e.g., 0.2100 for 21%)."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "statutory_tax_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Statutory Tax Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:TaxProvision.taxCreditAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax credit amount"@en ;
    rdfs:comment "The total tax credits claimed during the fiscal period, including renewable energy credits, research credits, and other federal and state credits."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_credit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Credit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TaxProvision.temporaryDifferenceAdjustment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temporary difference adjustment"@en ;
    rdfs:comment "The net adjustment to deferred tax expense for temporary book-tax differences that will reverse in future periods (e.g., depreciation timing differences)."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temporary_difference_adjustment" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
