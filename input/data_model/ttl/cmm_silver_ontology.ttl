cmm:TaxProvision.uncertainTaxPositionReserve a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "uncertain tax position reserve"@en ;
    rdfs:comment "The reserve for uncertain tax positions per FIN 48 (ASC 740-10) representing tax benefits that may not be sustained upon examination by tax authorities."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "uncertain_tax_position_reserve" ;
