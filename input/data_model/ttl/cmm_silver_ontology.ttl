cmm:SafetyIncident.testResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test result"@en ;
    rdfs:comment "Outcome of the drug or alcohol test: negative (no substances detected), positive (prohibited substance detected), refused (employee declined test), invalid (specimen issue), cancelled (procedural error). Confidential per DOT regulations."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
