    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason Code" ;
    cmm:cimDatatype "String" .
cmm:NemCredit.billingCycleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle code"@en ;
