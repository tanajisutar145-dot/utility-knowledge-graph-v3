cmm:WriteOff a owl:Class ;
    rdfs:label "Write Off"@en ;
    rdfs:comment "Transactional record of an accounts receivable write-off for an uncollectable customer balance. Captures write-off date, amount, reason (bankruptcy, skip, hardship, deceased), approval authority, associated collections case, bad debt GL account, and recovery tracking. Sourced from SAP IS-U FICA and Oracle CC&B. Critical for SOX bad debt reserve management and PUC uncollectable expense reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Transaction ;
    cmm:cimCloseMatch cim:Transaction ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.write_off" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; AR Write-Off / Bad Debt Write-Off" ;
    cmm:sourceObject "energy_utilities_ecm.billing.write_off" ;
    owl:hasKey ( cmm:WriteOff.writeOffId ) .

cmm:WriteOff.writeOffId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off id"@en ;
    rdfs:comment "Unique identifier for the accounts receivable write-off transaction. Primary key."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:long ;
    cmm:physicalColumn "write_off_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Write-Off ID" ;
    cmm:cimDatatype "Integer" .
cmm:WriteOff.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account for which the balance is being written off."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_write_off_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:WriteOff.approvedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approved by employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Write-off approval requires explicit employee authorization tracking for SOX compliance, audit trail, and segregation of duties. Energy utilities must document approval authority per FERC/PUC requirem"@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approved_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_write_off_approved_by_employee_id" ;
    cmm:cimAssociation "Transaction.ErpPersonnel" .
cmm:WriteOff.collections a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "collections"@en ;
    rdfs:comment "Reference to the collections case that led to this write-off decision, if applicable."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range cmm:CollectionsCase ;
    cmm:physicalColumn "collections_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Collections Case ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_write_off_collections_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:WriteOff.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Write-offs allocated to cost centers for performance tracking, collections effectiveness analysis, and regulatory cost recovery. Supports identification of high-risk customer segments and justificatio"@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Write Off Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_write_off_cost_center_id" ;
    cmm:cimAssociation "Transaction.Organisation" .
cmm:WriteOff.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Bad debt write-offs post to specific expense GL accounts for financial reporting and regulatory cost recovery. Link supports allowance for doubtful accounts reconciliation, FERC reporting, and rate ca"@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Write Off Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_write_off_gl_account_id" ;
    cmm:cimAssociation "Transaction.ErpChartOfAccounts" .
cmm:WriteOff.agingBucket a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aging bucket"@en ;
    rdfs:comment "The accounts receivable aging category at the time of write-off: 0-30 days, 31-60 days, 61-90 days, 91-120 days, 121-180 days, over_180 days."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "aging_bucket" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Aging Bucket" ;
    cmm:validValues "0-30|31-60|61-90|91-120|121-180|over_180" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "The total dollar amount of the accounts receivable balance being written off as uncollectable."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:WriteOff.approvalAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval authority"@en ;
    rdfs:comment "Name or identifier of the manager, director, or executive who authorized the write-off transaction per SOX approval hierarchy."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Authority" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which the write-off was formally approved by the designated authority."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.approvalLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval level"@en ;
    rdfs:comment "Hierarchical approval level required for this write-off based on dollar threshold: supervisor (under $500), manager ($500-$2,500), director ($2,500-$10,000), vp ($10,000-$50,000), cfo (over $50,000)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Level" ;
    cmm:validValues "supervisor|manager|director|vp|cfo" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.bankruptcyCaseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy case number"@en ;
    rdfs:comment "The court-assigned bankruptcy case number if the write-off reason is bankruptcy, used for tracking potential distributions."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "bankruptcy_case_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Bankruptcy Case Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WriteOff.bankruptcyChapter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy chapter"@en ;
    rdfs:comment "The chapter of bankruptcy filed by the customer: chapter_7 (liquidation), chapter_11 (reorganization), chapter_13 (individual debt adjustment)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "bankruptcy_chapter" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bankruptcy Chapter" ;
    cmm:validValues "chapter_7|chapter_11|chapter_13" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.collectionAgencyReferralDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection agency referral date"@en ;
    rdfs:comment "The date on which the account was referred to an external collection agency for recovery efforts."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "collection_agency_referral_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Agency Referral Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this write-off record was first created in the system."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Transaction.createdDateTime .
cmm:WriteOff.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the write-off amount (e.g., USD, CAD, MXN)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:WriteOff.daysPastDue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "days past due"@en ;
    rdfs:comment "The number of days the account balance was past due at the time of write-off, calculated from the original due date to the write-off date."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:int ;
    cmm:physicalColumn "days_past_due" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Days Past Due" ;
    cmm:cimDatatype "Integer" .
cmm:WriteOff.externalCollectionAgency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "external collection agency"@en ;
    rdfs:comment "Name of the third-party collection agency to which the account was referred before write-off, if applicable."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "external_collection_agency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "External Collection Agency" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal year and period (YYYY-MM format) in which the write-off was recognized for financial reporting purposes."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:valuePattern "^[0-9]{4}-(0[1-9]|1[0-2])$" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.fromCollectionsCase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "from collections case"@en ;
    rdfs:comment "FK to billing.collections_case.collections_case_id — Write-offs are the terminal outcome of a collections case. This FK is required for bad debt tracking, recovery management, and SOX AR aging controls."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:long ;
    cmm:physicalColumn "from_collections_case" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:WriteOff.interestAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest amount"@en ;
    rdfs:comment "The portion of the write-off amount representing accrued interest or late payment charges."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interest_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WriteOff.lastPaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last payment amount"@en ;
    rdfs:comment "The dollar amount of the last payment received from the customer before the account was written off."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "last_payment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WriteOff.lastPaymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last payment date"@en ;
    rdfs:comment "The date of the last payment received from the customer before the account was written off."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Payment Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "User ID or system identifier of the person or process that last modified the write-off record."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "The date and time when this write-off record was last modified."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:WriteOff.penaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty amount"@en ;
    rdfs:comment "The portion of the write-off amount representing penalties, fees, or other charges assessed to the account."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "penalty_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WriteOff.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which the write-off transaction was posted to the general ledger and accounts receivable subledger."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.principalAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "principal amount"@en ;
    rdfs:comment "The portion of the write-off amount representing the original principal balance owed by the customer."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "principal_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Principal Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WriteOff.pucReportingCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reporting category"@en ;
    rdfs:comment "The regulatory reporting category for this write-off as required by state Public Utility Commission uncollectable expense reporting."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_reporting_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reporting Category" ;
    cmm:validValues "residential_uncollectable|commercial_uncollectable|industrial_uncollectable|other_uncollectable" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.rateClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate class"@en ;
    rdfs:comment "The customer rate classification for the account at the time of write-off: residential, commercial, industrial, municipal, or agricultural."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Class" ;
    cmm:validValues "residential|commercial|industrial|municipal|agricultural" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.reasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason code"@en ;
    rdfs:comment "Categorical code indicating the primary reason for the write-off: bankruptcy (customer filed for bankruptcy protection), deceased (customer is deceased with no estate recovery), skip (customer location unknown), hardship (financial hardship waiver), uncollectable (exhausted collection efforts), fraud (fraudulent account)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Reason Code" ;
    cmm:validValues "bankruptcy|deceased|skip|hardship|uncollectable|fraud" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.reasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason description"@en ;
    rdfs:comment "Detailed narrative explanation of the circumstances leading to the write-off decision, including supporting documentation references."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Reason Description" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.recoveryAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery amount"@en ;
    rdfs:comment "The cumulative dollar amount recovered from this write-off through subsequent collection efforts, bankruptcy distributions, or estate settlements."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recovery_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WriteOff.recoveryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery date"@en ;
    rdfs:comment "The date of the most recent recovery payment or distribution applied against this written-off balance."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "recovery_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.recoveryEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery eligible flag"@en ;
    rdfs:comment "Indicates whether the written-off balance is eligible for future recovery efforts (true) or permanently closed (false)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "recovery_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WriteOff.reversalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal date"@en ;
    rdfs:comment "The date on which the write-off was reversed, if applicable (e.g., due to error correction or subsequent payment arrangement)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "reversal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.reversalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason"@en ;
    rdfs:comment "Explanation of why the write-off was reversed, including reference to correcting documentation or payment arrangement."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Reason" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "The geographic service territory or operating district in which the customer account was located."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,6}$" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.serviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service type"@en ;
    rdfs:comment "The type of utility service for which the written-off balance was incurred: electric, gas, water, steam, or combined services."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Type" ;
    cmm:validValues "electric|gas|water|steam|combined" ;
    cmm:cimDatatype "String" .
cmm:WriteOff.taxReportingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax reporting year"@en ;
    rdfs:comment "The calendar year in which the write-off is reported for income tax purposes (may differ from fiscal period for tax accounting)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:int ;
    cmm:physicalColumn "tax_reporting_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Reporting Year" ;
    cmm:cimDatatype "Integer" .
cmm:WriteOff.writeOffDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off date"@en ;
    rdfs:comment "The date on which the accounts receivable balance was officially written off. This is the principal business event timestamp for the transaction."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:date ;
    cmm:physicalColumn "write_off_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Date" ;
    cmm:cimDatatype "Date" .
cmm:WriteOff.writeOffNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off number"@en ;
    rdfs:comment "Business-facing unique identifier for the write-off transaction, used in financial reporting and audit trails."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "write_off_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Write-Off Number" ;
    cmm:valuePattern "^WO-[0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WriteOff.writeOffStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off status"@en ;
    rdfs:comment "Current lifecycle status of the write-off transaction: pending (awaiting approval), approved (authorized but not yet posted), posted (recorded to GL), reversed (write-off reversed), recovered (partial or full recovery after write-off)."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "write_off_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Write-Off Status" ;
    cmm:validValues "pending|approved|posted|reversed|recovered" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.status .
cmm:WriteOff.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or system identifier of the person or process that created the write-off record."@en ;
    rdfs:domain cmm:WriteOff ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:BudgetPlan a owl:Class ;
    rdfs:label "Budget Plan"@en ;
    rdfs:comment "Master entity representing a customer enrollment in a budget billing (levelized billing) program, where monthly charges are averaged over a 12-month period to smooth seasonal bill variability. Captures enrolled amount, plan start date, true-up month, cumulative actual vs. budget variance, annual true-up amount, and plan status. Managed within Oracle CC&B and SAP IS-U. Supports customer affordability programs and revenue smoothing."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:AuxiliaryAgreement ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.budget_plan" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; Budget Billing Plan / Levelized Billing" ;
    cmm:sourceObject "energy_utilities_ecm.billing.budget_plan" ;
    owl:hasKey ( cmm:BudgetPlan.budgetPlanId ) .

cmm:BudgetPlan.budgetPlanId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget plan id"@en ;
    rdfs:comment "Primary key for budget_plan"@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "budget_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Budget Plan Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:BudgetPlan.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account enrolled in this budget billing plan."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_budget_plan_account_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.CustomerAccount" .
cmm:BudgetPlan.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Foreign key linking to billing.billing_service_agreement. Business justification: Budget billing plans are configured at the service agreement level, not just the account level. A customer account may have multiple service agreements (e.g., residential and commercial), each with di"@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_budget_plan_billing_service_agreement_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.CustomerAgreement" .
cmm:BudgetPlan.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Budget billing plans calculate levelized monthly payments based on forecasted annual usage for each customer class. Customer service systems reference specific load forecasts (by rate class and season"@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_budget_plan_load_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.ConformLoadSchedule" .
cmm:BudgetPlan.paymentArrangement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement"@en ;
    rdfs:comment "Reference to an associated payment arrangement if the budget plan is part of a broader affordability or collections program."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range cmm:PaymentArrangement ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Arrangement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_budget_plan_payment_arrangement_id" ;
    cmm:cimAssociation "AuxiliaryAgreement.AuxiliaryAgreement" .
cmm:BudgetPlan.affordabilityProgramCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affordability program code"@en ;
    rdfs:comment "Code identifying the customer affordability or assistance program under which this budget plan is offered (low-income, senior, medical baseline, etc.)."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "affordability_program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affordability Program Code" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.annualBudgetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual budget amount"@en ;
    rdfs:comment "Total estimated annual energy cost used as the basis for calculating monthly installments, typically based on historical usage and current rates."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_budget_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Budget Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BudgetPlan.autoRenewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto renew flag"@en ;
    rdfs:comment "Indicates whether the budget billing plan automatically renews at the end of the term or requires customer re-enrollment."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_renew_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Renew Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BudgetPlan.budgetPlanStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget plan status"@en ;
    rdfs:comment "Current lifecycle status of the budget billing plan enrollment."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_plan_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Plan Status" ;
    cmm:validValues "active|pending|suspended|cancelled|completed|true_up_pending" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.status .
cmm:BudgetPlan.budgetToSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Budget billing plans are enrolled for a specific service agreement to smooth seasonal bill variability."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "budget_to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BudgetPlan.cancellationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation date"@en ;
    rdfs:comment "Date when the budget billing plan was cancelled by the customer or utility. Null if plan is active or completed normally."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "cancellation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Date" ;
    cmm:cimDatatype "Date" .
cmm:BudgetPlan.cancellationReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason code"@en ;
    rdfs:comment "Code indicating the reason for plan cancellation (customer request, payment default, account closure, service disconnection, etc.)."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason Code" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this budget billing plan record was first created in the system."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.createdDateTime .
cmm:BudgetPlan.cumulativeActualAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative actual amount"@en ;
    rdfs:comment "Total actual energy charges incurred by the customer since enrollment, based on actual consumption and applicable rates."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_actual_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Actual Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BudgetPlan.cumulativeBilledAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative billed amount"@en ;
    rdfs:comment "Total amount billed to the customer under the budget plan since enrollment, representing the sum of all monthly installments charged."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_billed_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Billed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BudgetPlan.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for all monetary amounts in this budget plan."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:validValues "USD|CAD|EUR|GBP|AUD|MXN" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BudgetPlan.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when the budget billing plan ends or is scheduled to end. Null for open-ended plans."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:BudgetPlan.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when the budget billing plan becomes effective and monthly installment billing begins."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:BudgetPlan.eligibilityVerifiedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verified date"@en ;
    rdfs:comment "Date when customer eligibility for the budget billing plan or associated affordability program was last verified."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "eligibility_verified_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verified Date" ;
    cmm:cimDatatype "Date" .
cmm:BudgetPlan.enrollmentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment channel"@en ;
    rdfs:comment "Channel through which the customer enrolled in the budget billing plan."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:validValues "web|mobile_app|call_center|in_person|mail|auto_enrolled" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date when the customer was enrolled into the budget billing plan."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:BudgetPlan.historicalUsageKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "historical usage kwh"@en ;
    rdfs:comment "Total historical annual energy consumption in kilowatt-hours used as the basis for calculating the budget amount, typically from the prior 12-month period."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "historical_usage_kwh" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Historical Usage Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:BudgetPlan.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this budget billing plan record was last updated."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BudgetPlan.lastTrueUpAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last true up amount"@en ;
    rdfs:comment "Amount settled at the most recent true-up. Positive values represent credits issued to customer; negative values represent additional charges."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "last_true_up_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last True-Up Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BudgetPlan.lastTrueUpDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last true up date"@en ;
    rdfs:comment "Date of the most recent annual true-up reconciliation when variance was settled and plan was recalculated."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_true_up_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last True-Up Date" ;
    cmm:cimDatatype "Date" .
cmm:BudgetPlan.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or system identifier of the person or process that last modified this budget billing plan record."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.monthlyInstallmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monthly installment amount"@en ;
    rdfs:comment "Fixed monthly payment amount charged to the customer under the budget billing plan, calculated to smooth seasonal bill variability."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "monthly_installment_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monthly Installment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BudgetPlan.nextReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next review date"@en ;
    rdfs:comment "Scheduled date for the next plan review or recalculation, typically mid-cycle or at true-up to adjust installments based on actual usage trends."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Review Date" ;
    cmm:cimDatatype "Date" .
cmm:BudgetPlan.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments regarding the budget billing plan, including special arrangements, customer requests, or operational remarks."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Plan Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:BudgetPlan.planNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan number"@en ;
    rdfs:comment "Externally visible unique identifier for the budget billing plan, used in customer communications and billing statements."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Plan Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BudgetPlan.planTermMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan term months"@en ;
    rdfs:comment "Duration of the budget billing plan cycle in months, typically 12 months for annual levelized billing."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "plan_term_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Plan Term Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:BudgetPlan.planType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan type"@en ;
    rdfs:comment "Classification of the budget billing methodology used to calculate monthly installments (levelized over 12 months, rolling average, fixed amount, seasonal adjustment, or custom calculation)."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Plan Type" ;
    cmm:validValues "levelized|equal_payment|rolling_average|fixed_amount|seasonal_adjustment|custom" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AuxiliaryAgreement.type .
cmm:BudgetPlan.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Tariff rate schedule code applied to calculate the budget amount and actual charges for this plan."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.recalculationFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recalculation frequency"@en ;
    rdfs:comment "Frequency at which the monthly installment amount is recalculated based on updated usage patterns and rate changes."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "recalculation_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recalculation Frequency" ;
    cmm:validValues "annual|semi_annual|quarterly|monthly|on_demand" ;
    cmm:cimDatatype "String" .
cmm:BudgetPlan.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Budget billing plans are enrolled for a specific service agreement. Required for levelized billing calculation."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BudgetPlan.trueUpMonth a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "true up month"@en ;
    rdfs:comment "Month number (1-12) when the annual true-up reconciliation occurs, settling the variance between budget installments and actual charges."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "true_up_month" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "True-Up Month" ;
    cmm:cimDatatype "Integer" .
cmm:BudgetPlan.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "Current difference between cumulative billed amount and cumulative actual amount. Positive variance indicates customer has been overbilled (credit due at true-up); negative variance indicates underbilled (balance due at true-up)."@en ;
    rdfs:domain cmm:BudgetPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:BillingCycle a owl:Class ;
    rdfs:label "Billing Cycle"@en ;
    rdfs:comment "Reference and operational entity defining billing cycle configurations and their execution history. At the cycle level: stores cycle code, read frequency (monthly, bi-monthly), scheduled read and bill generation dates, due date offset, and assigned account count. At the run level: captures batch billing run execution records including run date, billing cycle reference, accounts processed, invoices generated, total billed amount, run status (pending, in-progress, completed, error), exception count, and operator. Drives billing run scheduling, workload distribution, and revenue cycle timing. Sourced from SAP IS-U and Oracle CC&B billing engine. SSOT for billing cycle definitions and all batch billing run execution records."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TimeSchedule ;
    cmm:cimExtends cim:TimeSchedule ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.invoice_processing ;
    cmm:physicalTable "utility_cmm_silver.billing.cycle" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "Billing Cycle / Read Cycle" ;
    cmm:sourceObject "energy_utilities_ecm.billing.cycle" ;
    owl:hasKey ( cmm:BillingCycle.cycleId ) .

cmm:BillingCycle.cycleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle id"@en ;
    rdfs:comment "Unique identifier for the billing cycle configuration and execution record. Primary key."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:long ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Billing Cycle Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.billingRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing run"@en ;
    rdfs:comment "Unique identifier for the specific batch billing run execution instance (e.g., BR2024011501). Generated when billing engine executes the cycle."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range cmm:BillingRun ;
    cmm:physicalColumn "billing_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_cycle_billing_run_id" ;
    cmm:cimAssociation "TimeSchedule.ActivityRecord" .
cmm:BillingCycle.cycleApprovedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle approved by employee"@en ;
    rdfs:comment "User ID of the supervisor who approved the billing run for invoice release. Null if approval not required or not yet approved."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "cycle_approved_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_cycle_cycle_approved_by_employee_id" ;
    cmm:cimAssociation "TimeSchedule.ErpPersonnel" .
cmm:BillingCycle.cycleEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle employee"@en ;
    rdfs:comment "User ID or system account that initiated or executed the billing run. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "cycle_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Operator Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_cycle_cycle_employee_id" ;
    cmm:cimAssociation "TimeSchedule.ErpPersonnel" .
cmm:BillingCycle.accountsProcessedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounts processed count"@en ;
    rdfs:comment "Total number of customer accounts successfully processed during this billing run execution."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "accounts_processed_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounts Processed Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.approvalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required flag"@en ;
    rdfs:comment "Indicates whether this billing cycle run requires supervisory approval before invoice release (True) or can be automatically released (False). Typically True for high-value commercial/industrial cycles."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingCycle.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Timestamp when the billing run was approved for invoice release. Null if approval not required or not yet approved."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingCycle.assignedAccountCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned account count"@en ;
    rdfs:comment "Total number of customer accounts assigned to this billing cycle for workload distribution and capacity planning."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "assigned_account_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assigned Account Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.billDueDateOffsetDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill due date offset days"@en ;
    rdfs:comment "Number of days after bill generation date to set the payment due date (e.g., 21 days for residential, 30 days for commercial)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "bill_due_date_offset_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bill Due Date Offset in Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.billingPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing period end date"@en ;
    rdfs:comment "The last date of the consumption period covered by this billing cycle run (inclusive)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.billingPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing period start date"@en ;
    rdfs:comment "The first date of the consumption period covered by this billing cycle run (inclusive)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.billingRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing run date"@en ;
    rdfs:comment "The actual date when the billing batch processing was executed for this cycle. May differ from scheduled date due to operational adjustments."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Run Execution Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this billing cycle record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:TimeSchedule.createdDateTime .
cmm:BillingCycle.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this billing cycle (e.g., USD, CAD, MXN)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BillingCycle.cycleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle code"@en ;
    rdfs:comment "Business identifier for the billing cycle configuration (e.g., RES01, COM15, IND30). Used for scheduling and grouping accounts into billing batches."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingCycle.cycleName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle name"@en ;
    rdfs:comment "Human-readable name describing the billing cycle (e.g., Residential Monthly Cycle 1, Commercial Bi-Monthly East)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Billing Cycle Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:BillingCycle.cycleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle status"@en ;
    rdfs:comment "Current lifecycle status of the billing cycle configuration. Active: in use for billing operations. Inactive: temporarily disabled. Suspended: on hold pending review. Archived: retired from active use."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Configuration Status" ;
    cmm:validValues "active|inactive|suspended|archived" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TimeSchedule.status .
cmm:BillingCycle.cycleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle type"@en ;
    rdfs:comment "Classification of the billing cycle frequency and purpose. Monthly for standard monthly billing, bi-monthly for every-other-month, quarterly for seasonal, on-demand for ad-hoc billing, final for account closure billing."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Type" ;
    cmm:validValues "monthly|bi-monthly|quarterly|on-demand|final" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TimeSchedule.type .
cmm:BillingCycle.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date when this billing cycle configuration was retired or superseded. Null for currently active cycles."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:BillingCycle.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date when this billing cycle configuration became active and available for use in billing operations."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:BillingCycle.exceptionCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception count"@en ;
    rdfs:comment "Number of accounts that encountered errors or exceptions during billing run processing (e.g., missing meter reads, rate errors, validation failures). Requires manual review."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "exception_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.exceptionSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception summary"@en ;
    rdfs:comment "Brief summary of the types of exceptions encountered during the billing run (e.g., 15 missing reads, 3 rate lookup failures, 2 validation errors)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Summary" ;
    cmm:cimDatatype "String" .
cmm:BillingCycle.invoiceDeliveryMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice delivery method"@en ;
    rdfs:comment "Primary method used to deliver invoices to customers in this billing cycle. Paper: postal mail. Email: electronic delivery. Portal: customer self-service. SMS: text message notification. Suppressed: no delivery (e.g., zero-balance accounts)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_delivery_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoice Delivery Method" ;
    cmm:validValues "paper|email|portal|sms|suppressed" ;
    cmm:cimDatatype "String" .
cmm:BillingCycle.invoicePrintDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice print date"@en ;
    rdfs:comment "The date when physical invoices were printed or electronic bills were released to customers. May differ from billing run date due to approval workflows."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "invoice_print_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoice Print Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.invoicesGeneratedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoices generated count"@en ;
    rdfs:comment "Total number of invoices (bills) generated during this billing run execution. May differ from accounts processed if some accounts had zero consumption or credits."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "invoices_generated_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoices Generated Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this billing cycle record was last updated. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BillingCycle.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or comments about this billing cycle or run (e.g., holiday adjustments, system issues, rate changes)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Cycle Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:BillingCycle.rateClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate class"@en ;
    rdfs:comment "Customer rate classification this billing cycle primarily serves. Determines applicable tariff schedules and rate structures."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|municipal" ;
    cmm:cimDatatype "String" .
cmm:BillingCycle.readFrequencyDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read frequency days"@en ;
    rdfs:comment "Number of days between scheduled meter reads for this billing cycle (e.g., 30 for monthly, 60 for bi-monthly)."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "read_frequency_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Frequency in Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:BillingCycle.runDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run duration minutes"@en ;
    rdfs:comment "Total elapsed time in minutes for the billing run execution. Used for capacity planning and performance optimization."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:int ;
    cmm:physicalColumn "run_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Run Duration in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:BillingCycle.runEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run end timestamp"@en ;
    rdfs:comment "Timestamp when the billing batch processing completed or terminated. Used for performance monitoring and SLA tracking."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "run_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Run End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingCycle.runStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run start timestamp"@en ;
    rdfs:comment "Timestamp when the billing batch processing began execution. Used for performance monitoring and SLA tracking."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "run_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Run Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingCycle.runStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run status"@en ;
    rdfs:comment "Current execution status of the billing run. Pending: scheduled but not started. In-progress: actively processing. Completed: finished successfully. Completed-with-exceptions: finished but some accounts had errors. Error: run failed. Cancelled: run was aborted."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Run Status" ;
    cmm:validValues "pending|in-progress|completed|completed-with-exceptions|error|cancelled" ;
    cmm:cimDatatype "String" .
cmm:BillingCycle.scheduledBillGenerationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled bill generation date"@en ;
    rdfs:comment "The date when invoice generation batch processing is scheduled to execute for this billing cycle."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_bill_generation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Bill Generation Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.scheduledReadEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled read end date"@en ;
    rdfs:comment "The date by which all meter reading activities should be completed for this billing cycle period."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_read_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Meter Read End Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.scheduledReadStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled read start date"@en ;
    rdfs:comment "The date when meter reading activities are scheduled to begin for this billing cycle period."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_read_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Meter Read Start Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingCycle.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Geographic service territory identifier this billing cycle serves (e.g., EAST, WEST, METRO1). Used for regional billing operations."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,6}$" ;
    cmm:cimDatatype "String" .
cmm:BillingCycle.totalBilledAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total billed amount"@en ;
    rdfs:comment "Sum of all invoice amounts generated during this billing run execution, before payments and adjustments. Represents gross revenue for the cycle."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_billed_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Billed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingCycle.totalKwhBilled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total kwh billed"@en ;
    rdfs:comment "Sum of all energy consumption in kilowatt-hours billed across all accounts in this billing run. Key operational metric for load forecasting and revenue analysis."@en ;
    rdfs:domain cmm:BillingCycle ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_kwh_billed" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Kilowatt-Hours (kWh) Billed" ;
    cmm:cimDatatype "Decimal" .

cmm:BillingRun a owl:Class ;
    rdfs:label "Billing Run"@en ;
    rdfs:comment "Transactional record of a batch billing run execution that generates invoices for a set of service agreements within a billing cycle. Captures run date, billing cycle, number of accounts processed, number of invoices generated, total billed amount, run status (pending, in-progress, completed, error), exception count, and operator. Sourced from SAP IS-U and Oracle CC&B billing engine execution logs. Supports billing operations monitoring and revenue cycle management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.invoice_processing ;
    cmm:physicalTable "utility_cmm_silver.billing.billing_run" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Billing Run / Bill Generation Run" ;
    cmm:sourceObject "energy_utilities_ecm.billing.billing_run" ;
    owl:hasKey ( cmm:BillingRun.billingRunId ) .

cmm:BillingRun.billingRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing run id"@en ;
    rdfs:comment "Unique identifier for the billing run execution. Primary key for the billing run entity."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "billing_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Billing Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User identifier or system account that initiated or executed the billing run, used for audit trail and accountability in billing operations."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_run_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:BillingRun.reversedRunBillingRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reversed run billing run"@en ;
    rdfs:comment "Reference to the original billing run that is being reversed by this run, establishing audit trail for billing corrections and dispute resolution."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range cmm:BillingRun ;
    cmm:physicalColumn "reversed_run_billing_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reversed Billing Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_billing_run_reversed_run_billing_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:BillingRun.accountsFailed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounts failed"@en ;
    rdfs:comment "Number of customer accounts or service agreements that failed to complete billing due to data errors, validation failures, or system exceptions."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "accounts_failed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounts Failed Processing" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.accountsProcessed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounts processed"@en ;
    rdfs:comment "Number of customer accounts or service agreements that were successfully processed and completed billing calculations without errors."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "accounts_processed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounts Successfully Processed" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.accountsTargeted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounts targeted"@en ;
    rdfs:comment "Total number of customer accounts or service agreements that were selected and targeted for billing in this run based on billing cycle criteria."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "accounts_targeted" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounts Targeted for Billing" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.actualEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end timestamp"@en ;
    rdfs:comment "Actual date and time when the billing run execution completed or terminated, used to calculate run duration and identify performance issues."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingRun.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time when the billing run execution began, capturing the real-world event time for performance monitoring and audit purposes."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingRun.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Approval state of the billing run results, indicating whether the run output has been reviewed and approved for invoice release and accounts receivable posting."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "pending_approval|approved|rejected|not_required" ;
    cmm:cimDatatype "String" .
cmm:BillingRun.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the billing run was approved for invoice release, establishing the audit trail for revenue recognition timing."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingRun.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "User identifier of the supervisor or manager who approved the billing run results for release, supporting SOX segregation of duties requirements."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By User" ;
    cmm:cimDatatype "String" .
cmm:BillingRun.batchJobReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "batch job reference"@en ;
    rdfs:comment "Technical identifier of the underlying batch job or process execution in the billing system, used for technical troubleshooting and system integration."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "batch_job_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Batch Job Identifier (ID)" ;
