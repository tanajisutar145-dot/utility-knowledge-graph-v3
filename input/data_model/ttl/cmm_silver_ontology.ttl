    cmm:businessTerm "Cost Estimate Valid Until Date" ;
    cmm:cimDatatype "Date" .
cmm:CostResponsibility.costVarianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost variance amount"@en ;
    rdfs:comment "Difference between estimated and final settled cost in USD (final minus estimated). Positive values indicate cost overruns, negative values indicate cost savings."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CostResponsibility.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this cost responsibility record was first created in the system. Audit trail for record creation."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
