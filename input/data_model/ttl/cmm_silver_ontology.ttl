cmm:TopologySnapshot.snapshotStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "snapshot status"@en ;
    rdfs:comment "Current status of the topology snapshot indicating its validity and usability for analysis and compliance reporting."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:string ;
