    cmm:businessTerm "Rate Schedule Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:RateSchedule.rateName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate name"@en ;
    rdfs:comment "Human-readable name of the rate schedule displayed on customer bills and tariff documents."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Rate Schedule Name" ;
