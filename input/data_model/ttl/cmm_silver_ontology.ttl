    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Case Year" ;
    cmm:cimDatatype "Integer" .
cmm:TaxProvision.sourceDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source document reference"@en ;
    rdfs:comment "The unique document identifier in the source system that generated this tax provision record for audit trail and reconciliation purposes."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:string ;
