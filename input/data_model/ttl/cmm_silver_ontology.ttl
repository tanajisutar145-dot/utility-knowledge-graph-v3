cmm:TransmissionOutage.updatedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated by user"@en ;
    rdfs:comment "User identifier or system account that last modified the outage record. Supports accountability and change tracking."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
