cmm:SwitchingOrderFeederImpact a owl:Class ;
    rdfs:label "Switching Order Feeder Impact"@en ;
    rdfs:comment "This association product represents the operational impact relationship between distribution switching orders and feeders. It captures the specific role, sequence, and operational parameters for each feeder involved in a multi-feeder switching operation. Each record links one distribution switching order to one feeder with attributes that exist only in the context of this switching operation, including load transfer amounts, customer impact counts, isolation status, and restoration priority.. Existence Justification: In utility distribution operations, switching orders routinely coordinate actions across multiple feeders to perform load transfers, isolations, and network reconfigurations. A single switching order can impact 3-5 feeders simultaneously (e.g., isolating one feeder, transferring load to two backup feeders, and energizing a fourth). Conversely, each feeder participates in dozens of switching orders over its operational lifetime for maintenance, emergency response, and load balancing. The relationship carries substantial operational data including load transfer amounts, customer impacts, sequence coordination, and feeder-specific roles."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.switching_order_feeder_impact" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.switching_order_feeder_impact" ;
    owl:hasKey ( cmm:SwitchingOrderFeederImpact.switchingOrderFeederImpactId ) .

cmm:SwitchingOrderFeederImpact.switchingOrderFeederImpactId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order feeder impact id"@en ;
    rdfs:comment "Unique identifier for this switching order feeder impact record. Primary key."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:long ;
    cmm:physicalColumn "switching_order_feeder_impact_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Switching Order Feeder Impact ID" ;
    cmm:cimDatatype "Integer" .
cmm:SwitchingOrderFeederImpact.distributionSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution switching order"@en ;
    rdfs:comment "Foreign key linking to the distribution switching order that impacts this feeder"@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range cmm:DistributionSwitchingOrder ;
    cmm:physicalColumn "distribution_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order Feeder Impact - Distribution Switching Order Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_feeder_impact_distribution_switching_order_id" ;
    cmm:cimAssociation "IdentifiedObject.SwitchingPlan" .
cmm:SwitchingOrderFeederImpact.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to the feeder impacted by this switching order"@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order Feeder Impact - Feeder Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_switching_order_feeder_impact_feeder_id" ;
    cmm:cimAssociation "IdentifiedObject.Feeder" .
cmm:SwitchingOrderFeederImpact.affectedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer count"@en ;
    rdfs:comment "Number of customers on this specific feeder who are impacted by the switching operation. Used for customer notification and impact assessment per feeder."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:SwitchingOrderFeederImpact.feederImpactTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder impact timestamp"@en ;
    rdfs:comment "Date and time when this specific feeder was impacted during the switching operation execution. Used for precise sequencing and audit trail."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "feeder_impact_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feeder Impact Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SwitchingOrderFeederImpact.feederRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder role"@en ;
    rdfs:comment "The operational role this feeder plays in the switching operation (e.g., SOURCE feeder losing load, TARGET feeder receiving load, ISOLATION feeder being isolated, BACKUP feeder providing alternate path)."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "feeder_role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feeder Role" ;
    cmm:cimDatatype "String" .
cmm:SwitchingOrderFeederImpact.isolationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation status"@en ;
    rdfs:comment "Current isolation state of this feeder within the context of this switching order. Tracks whether the feeder is isolated, energized, or in transition."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "isolation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Status" ;
    cmm:cimDatatype "String" .
cmm:SwitchingOrderFeederImpact.loadTransferredMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transferred mw"@en ;
    rdfs:comment "Amount of load in megawatts transferred to or from this specific feeder as part of the switching operation. This is feeder-specific and differs from the total load_transfer_mw on the switching order."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_transferred_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transferred (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:SwitchingOrderFeederImpact.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Duration in minutes that this feeder experienced outage as part of the switching operation. Zero if switching was performed without interruption. Used for reliability metrics (SAIDI/SAIFI)."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:SwitchingOrderFeederImpact.postSwitchLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post switch load mw"@en ;
    rdfs:comment "Load on this feeder after the switching operation completed. Used to verify successful load transfer and network rebalancing."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_switch_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Switch Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:SwitchingOrderFeederImpact.preSwitchLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre switch load mw"@en ;
    rdfs:comment "Load on this feeder immediately before the switching operation began. Used for operational planning and post-operation analysis."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_switch_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Switch Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:SwitchingOrderFeederImpact.restorationPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration priority"@en ;
    rdfs:comment "Priority ranking for restoring this feeder if the switching operation involves outage restoration. Lower numbers indicate higher priority based on customer criticality and load importance."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "restoration_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Priority" ;
    cmm:cimDatatype "Integer" .
cmm:SwitchingOrderFeederImpact.switchingSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching sequence number"@en ;
    rdfs:comment "The order in which this feeder is addressed within the multi-feeder switching operation. Critical for coordinating the sequence of switching steps across multiple feeders."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "switching_sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:SwitchingOrderFeederImpact.switchingStepsForFeeder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching steps for feeder"@en ;
    rdfs:comment "Number of individual switching steps in the overall order that specifically target devices on this feeder. Subset of total_switching_steps on the order."@en ;
    rdfs:domain cmm:SwitchingOrderFeederImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "switching_steps_for_feeder" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Steps for Feeder" ;
    cmm:cimDatatype "Integer" .

cmm:FeederZoneAssignment a owl:Class ;
    rdfs:label "Feeder Zone Assignment"@en ;
    rdfs:comment "This association product represents the operational assignment between distribution feeders and load zones. It captures the many-to-many relationship where a single feeder can serve multiple load zones (feeder branches across zone boundaries) and a single load zone can be served by multiple feeders (for redundancy, load balancing, and reliability). Each record represents an active or historical assignment with load allocation percentages, circuit topology data, and customer distribution metrics used by DMS/ADMS for volt-VAR optimization dispatch and FLISR automation decisions.. Existence Justification: In utility distribution operations, feeders routinely serve multiple load zones as their circuits branch across geographic boundaries, and load zones are deliberately served by multiple feeders for redundancy, load balancing, and reliability. Distribution planners actively manage these assignments through switching operations, network reconfigurations, and seasonal load transfers. This is a core operational relationship tracked in DMS/ADMS systems for real-time control decisions."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.feeder_zone_assignment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.feeder_zone_assignment" ;
    owl:hasKey ( cmm:FeederZoneAssignment.feederZoneAssignmentId ) .

cmm:FeederZoneAssignment.feederZoneAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder zone assignment id"@en ;
    rdfs:comment "Unique identifier for this feeder-zone assignment record. Primary key."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "feeder_zone_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Feeder Zone Assignment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FeederZoneAssignment.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to the distribution feeder that serves this load zone assignment."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Zone Assignment - Feeder Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_zone_assignment_feeder_id" ;
    cmm:cimAssociation "IdentifiedObject.Feeder" .
cmm:FeederZoneAssignment.loadZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load zone"@en ;
    rdfs:comment "Foreign key linking to the load zone served by this feeder assignment."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "load_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Zone Assignment - Load Zone Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_zone_assignment_load_zone_id" ;
    cmm:cimAssociation "IdentifiedObject.SubLoadArea" .
cmm:FeederZoneAssignment.switchingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "switching device"@en ;
    rdfs:comment "Identifier of the sectionalizing switch, recloser, or breaker that controls this feeder-zone connection. Used by ADMS for automated switching operations during FLISR and VVO dispatch."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "switching_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Device Identifier" ;
    cmm:sourceColumn "sectionalizing_device_id" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_zone_assignment_switching_device_id" ;
    cmm:cimAssociation "IdentifiedObject.ProtectedSwitch" .
cmm:FeederZoneAssignment.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Current operational status of this feeder-zone assignment. Active assignments are in service, Planned assignments are scheduled for future network reconfigurations, Temporary assignments are used during maintenance or emergency switching operations."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:FeederZoneAssignment.assignmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment type"@en ;
    rdfs:comment "Classification of the assignment role. Primary indicates normal serving configuration, Backup indicates redundancy path, Emergency indicates temporary restoration configuration, Seasonal indicates load-dependent switching schemes."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:FeederZoneAssignment.circuitMilesInZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "circuit miles in zone"@en ;
    rdfs:comment "Total length of feeder circuit infrastructure (mainline and laterals) physically located within this load zone boundary, measured in miles. Used for maintenance planning and reliability analysis."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "circuit_miles_in_zone" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Circuit Miles in Zone" ;
    cmm:cimDatatype "Decimal" .
cmm:FeederZoneAssignment.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this assignment record was created in the system."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:FeederZoneAssignment.customerCountInZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer count in zone"@en ;
    rdfs:comment "Number of customer premises served by this specific feeder within this load zone. Used for reliability metrics (SAIDI/SAIFI) calculation and outage impact assessment."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_count_in_zone" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Count in Zone" ;
    cmm:cimDatatype "Integer" .
cmm:FeederZoneAssignment.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date when this feeder-zone assignment became active in the distribution network topology. Used for historical tracking of network reconfigurations."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:FeederZoneAssignment.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date when this feeder-zone assignment was deactivated or reconfigured. Null for currently active assignments. Used for historical analysis of network topology changes."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:FeederZoneAssignment.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User or system identifier that last modified this assignment record."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By" ;
    cmm:cimDatatype "String" .
cmm:FeederZoneAssignment.lastModifiedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified date"@en ;
    rdfs:comment "Timestamp of the most recent modification to this assignment record."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FeederZoneAssignment.loadAllocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load allocation percentage"@en ;
    rdfs:comment "Percentage of the feeder's total load capacity allocated to serving this specific load zone. Used for load balancing calculations and capacity planning. Sum of all allocations for a feeder across zones should approach 100%."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:FeederZoneAssignment.normallyOpenFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normally open flag"@en ;
    rdfs:comment "Indicates whether the switching device controlling this assignment is normally open (tie point) or normally closed (radial feed). Used for network topology analysis and switching sequence planning."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "normally_open_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normally Open Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FeederZoneAssignment.priorityRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority rank"@en ;
    rdfs:comment "Priority ranking of this feeder for serving the load zone, used during outage restoration and FLISR automation. Rank 1 indicates primary feeder, higher numbers indicate backup feeders for redundancy."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_rank" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Priority Rank" ;
    cmm:cimDatatype "Integer" .
cmm:FeederZoneAssignment.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User or system identifier that created this assignment record."@en ;
    rdfs:domain cmm:FeederZoneAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created By" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:SubstationAuditCoverage a owl:Class ;
    rdfs:label "Substation Audit Coverage"@en ;
    rdfs:comment "This association product represents the audit coverage relationship between distribution substations and compliance audits. It captures which substations were included in which audits, the scope of examination for each substation, findings specific to that substation within the audit, and corrective action status. Each record links one distribution substation to one audit with attributes that exist only in the context of this specific substation-audit examination.. Existence Justification: In energy utilities compliance operations, a single audit (NERC CIP, PUC, EPA) routinely examines multiple distribution substations across the service territory, and each substation is subject to multiple audits over time from different regulatory bodies covering different compliance domains. The business actively manages audit coverage planning, tracks findings per substation per audit, and monitors corrective action status for each substation-audit combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.reliability_planning ;
    cmm:physicalTable "utility_cmm_silver.distribution.substation_audit_coverage" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.substation_audit_coverage" ;
    owl:hasKey ( cmm:SubstationAuditCoverage.substationAuditCoverageId ) .

cmm:SubstationAuditCoverage.substationAuditCoverageId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation audit coverage id"@en ;
    rdfs:comment "Unique identifier for this substation audit coverage record. Primary key."@en ;
    rdfs:domain cmm:SubstationAuditCoverage ; rdfs:range xsd:long ;
    cmm:physicalColumn "substation_audit_coverage_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Substation Audit Coverage Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SubstationAuditCoverage.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to the compliance audit that examined this substation"@en ;
    rdfs:domain cmm:SubstationAuditCoverage ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Audit Coverage - Audit Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_substation_audit_coverage_audit_id" ;
    cmm:cimAssociation "IdentifiedObject.ActivityRecord" .
cmm:SubstationAuditCoverage.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Foreign key to the distribution substation examined in this audit"@en ;
    rdfs:domain cmm:SubstationAuditCoverage ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Substation Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_substation_audit_coverage_distribution_substation_id" ;
    cmm:cimAssociation "IdentifiedObject.Substation" .
cmm:SubstationAuditCoverage.substationDistributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "substation distribution substation"@en ;
    rdfs:comment "Foreign key linking to the distribution substation that was examined in this audit"@en ;
    rdfs:domain cmm:SubstationAuditCoverage ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "substation_distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Audit Coverage - Distribution Substation Id" ;
    cmm:cimDatatype "Integer" ;
