    cmm:fkConstraint "fk_compliance_regulatory_filing_regulatory_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RegulatoryFiling.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
