cmm:ContractorWorker.workerEmail a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "worker email"@en ;
    rdfs:comment "Primary email address for the contractor worker used for safety notifications, training assignments, and site access communications."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "worker_email" ;
    cmm:sqlDataType "STRING" ;
