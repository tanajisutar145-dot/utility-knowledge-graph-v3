cmm:DunningRun a owl:Class ;
    rdfs:label "Dunning Run"@en ;
    rdfs:comment "Master reference table for dunning_run. Referenced by dunning_run_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.dunning_run" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.billing.dunning_run" ;
    owl:hasKey ( cmm:DunningRun.dunningRunId ) .

