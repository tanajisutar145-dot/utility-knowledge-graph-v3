cmm:CustomerCase.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Identifier of the utility meter associated with the case, if applicable."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_case_meter_id" ;
    cmm:cimAssociation "TroubleTicket.Meter" .
cmm:CustomerCase.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Identifier of the customer who owns the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_case_profile_id" ;
    cmm:cimAssociation "TroubleTicket.Customer" .
cmm:CustomerCase.parentCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent case"@en ;
    rdfs:comment "Self-referencing FK on case (parent_case_id)"@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range cmm:CustomerCase ;
    cmm:physicalColumn "parent_case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_case_parent_case_id" ;
    cmm:cimAssociation "TroubleTicket.TroubleTicket" .
cmm:CustomerCase.amountGross a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount gross"@en ;
    rdfs:comment "Total gross monetary amount associated with the case (e.g., fees before taxes)."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount_gross" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerCase.amountNet a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount net"@en ;
    rdfs:comment "Net monetary amount after taxes and adjustments."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount_net" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerCase.amountTax a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount tax"@en ;
    rdfs:comment "Tax component applied to the case monetary amount."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount_tax" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerCase.assignedGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned group"@en ;
    rdfs:comment "Internal support group or department responsible for handling the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "assigned_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:CustomerCase.attachmentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "attachment count"@en ;
    rdfs:comment "Number of files or documents attached to the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:int ;
    cmm:physicalColumn "attachment_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerCase.caseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "case number"@en ;
    rdfs:comment "Business-visible alphanumeric case number assigned at creation."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "case_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerCase.caseType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "case type"@en ;
    rdfs:comment "Category describing the nature of the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "case_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TroubleTicket.type .
cmm:CustomerCase.closedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closed date"@en ;
    rdfs:comment "Date on which the case was officially closed."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:date ;
    cmm:physicalColumn "closed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:CustomerCase.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance state of the case with relevant regulations."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:CustomerCase.costActual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost actual"@en ;
    rdfs:comment "Final cost incurred to resolve the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_actual" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerCase.costEstimate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost estimate"@en ;
    rdfs:comment "Estimated cost associated with resolving the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_estimate" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerCase.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for monetary values."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CustomerCase.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Detailed narrative provided by the customer describing the issue or request."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "case_description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CustomerCase.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
