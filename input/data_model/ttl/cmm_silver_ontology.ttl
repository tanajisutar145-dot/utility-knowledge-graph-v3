    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:SubstationScenarioPlan.scenarioYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario year"@en ;
    rdfs:comment "Planning year within the IRP scenario horizon for which this substation plan applies (e.g., 2025, 2030, 2035). Allows year-by-year capacity planning."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:int ;
