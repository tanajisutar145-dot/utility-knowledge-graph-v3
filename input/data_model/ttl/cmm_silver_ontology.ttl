cmm:PowerPlant.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this power plant record was last modified."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:UnitCommitment a owl:Class ;
    rdfs:label "Unit Commitment"@en ;
    rdfs:comment "Transactional record of the day-ahead and intra-day unit commitment decisions for each generating unit. Captures commitment period (start/end timestamp), committed capacity (MW), minimum run time, minimum down time, startup type (hot/warm/cold), commitment source (ISO/RTO security-constrained unit commitment or self-schedule), associated DAM or RTM market interval, and commitment status. Feeds AGC and dispatch scheduling workflows. Supports NERC TOP (Transmission Operations) and IRO (Interconnection Reliability Operations) standard compliance for reliability-must-run commitments and FERC market monitoring of self-scheduled vs market-committed units."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:GenUnitOpSchedule ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.unit_commitment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC MOD / ISO-RTO Unit Commitment Protocol" ;
    cmm:sourceObject "energy_utilities_ecm.generation.unit_commitment" ;
    owl:hasKey ( cmm:UnitCommitment.unitCommitmentId ) .

cmm:UnitCommitment.unitCommitmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit commitment id"@en ;
    rdfs:comment "Unique identifier for the unit commitment record. Primary key for this transactional record of day-ahead and intra-day unit commitment decisions."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:long ;
    cmm:physicalColumn "unit_commitment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Unit Commitment ID" ;
    cmm:cimDatatype "Integer" .
cmm:UnitCommitment.commitmentObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "commitment obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Unit commitment decisions governed by ISO/RTO market rules including must-offer obligations and capacity performance requirements. Essential for market rule compliance, offer validation, and regulator"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "commitment_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Commitment Obligation Id (Foreign Key)" ;
    cmm:sourceColumn "obligation_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_commitment_obligation_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Document" .
cmm:UnitCommitment.contingencyAnalysisRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis run"@en ;
    rdfs:comment "Foreign key linking to grid.contingency_analysis_run. Business justification: Unit commitments define available generation for day-ahead contingency analysis. Required for NERC TPL standards and next-day reliability assessment."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:ContingencyAnalysisRun ;
    cmm:physicalColumn "contingency_analysis_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Analysis Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_contingency_analysis_run_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ActivityRecord" .
cmm:UnitCommitment.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Unit commitments are control-area-specific for reserve requirements, capacity obligations, and day-ahead scheduling. Required for CPS1/CPS2 compliance and reserve adequacy tracking."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_control_area_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:UnitCommitment.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Foreign key linking to demand.dr_event. Business justification: ISO/RTO operators coordinate generation unit commitments with demand response events for real-time grid balancing. Market settlement and reliability reporting require tracking which DR events influenc"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_dr_event_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.EndDeviceControl" .
cmm:UnitCommitment.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "Reference to the air quality permit or emissions allowance under which this commitment operates. Links to EPA and state environmental compliance tracking."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emissions Permit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_environmental_permit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Document" .
cmm:UnitCommitment.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: ISO/RTO real-time market operations adjust unit commitments in response to major grid outages affecting transmission constraints or load pockets. Emergency dispatch protocols require linking commitmen"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_event_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Outage" .
cmm:UnitCommitment.interchangeSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interchange schedule"@en ;
    rdfs:comment "Foreign key linking to grid.interchange_schedule. Business justification: Unit commitments enable firm interchange transactions (capacity backing for e-Tags). Required for NERC INT standards and transmission reservation coordination."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:InterchangeSchedule ;
    cmm:physicalColumn "interchange_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interchange Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_interchange_schedule_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.EnergyTransaction" .
cmm:UnitCommitment.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Market commitments trigger internal orders for fuel procurement, maintenance deferrals, and startup cost tracking. Essential for commitment cost settlement and variance analysis."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_internal_order_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ErpProjectAccounting" .
cmm:UnitCommitment.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Unit commitments are scheduled based on specific load forecasts for day-ahead and real-time markets. ISO/RTO dispatch instructions reference load forecasts to determine economic commitment. Essential"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_load_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ConformLoadSchedule" .
cmm:UnitCommitment.operatorLog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator log"@en ;
    rdfs:comment "Foreign key linking to grid.operator_log. Business justification: Unit commitments are logged for day-ahead planning and real-time coordination. Required for NERC reliability standards and market operations audit."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:OperatorLog ;
    cmm:physicalColumn "operator_log_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Log Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_operator_log_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Document" .
cmm:UnitCommitment.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "Reference to the specific generating unit (turbine, generator, or plant unit) for which this commitment decision applies. Links to the generation asset registry."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:sourceColumn "generating_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_primary_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:UnitCommitment.tertiaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every commitment decision is made for a specific generating unit. Without this FK, commitment records cannot be associated with the unit they authorize, breaking day-ahead scheduling and AGC workflows"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "tertiary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_tertiary_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:UnitCommitment.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Unit commitments often originate from bilateral trades or self-schedules recorded as trade records. Essential for linking trade execution to physical unit commitment in ISO markets."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_trade_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Trade" .
cmm:UnitCommitment.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Foreign key linking to transmission.path. Business justification: ISO/RTO unit commitment decisions must consider transmission path constraints and available transfer capability. Security-constrained unit commitment (SCUC) algorithms evaluate generation commitments"@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Path Id (Foreign Key)" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_unit_commitment_transmission_path_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.TransmissionPath" .
cmm:UnitCommitment.agcParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc participation flag"@en ;
    rdfs:comment "Indicates whether the unit is participating in Automatic Generation Control during this commitment period, allowing real-time dispatch adjustments for frequency regulation."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:UnitCommitment.ancillaryServiceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service flag"@en ;
    rdfs:comment "Indicates whether this commitment includes provision of ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) in addition to energy."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ancillary_service_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Service Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:UnitCommitment.commitmentNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment notes"@en ;
    rdfs:comment "Free-text notes providing additional context about the commitment decision, special operating instructions, or coordination requirements with transmission operators."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "commitment_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commitment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:UnitCommitment.commitmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment number"@en ;
    rdfs:comment "Business identifier for the commitment decision. Externally-known reference number used in market submissions, dispatch communications, and regulatory reporting."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "commitment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commitment Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:UnitCommitment.commitmentPeriodEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment period end"@en ;
    rdfs:comment "End date and time of the operating period for which the unit is committed. Defines the conclusion of the commitment window."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "commitment_period_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Period End" ;
    cmm:cimDatatype "DateTime" .
cmm:UnitCommitment.commitmentPeriodStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment period start"@en ;
    rdfs:comment "Start date and time of the operating period for which the unit is committed. Defines the beginning of the commitment window."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "commitment_period_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Period Start" ;
    cmm:cimDatatype "DateTime" .
cmm:UnitCommitment.commitmentReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment reason code"@en ;
    rdfs:comment "Code indicating the business reason for this commitment decision. Examples: economic dispatch, reliability requirement, voltage support, black start capability, renewable integration support."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "commitment_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Reason Code" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.commitmentRevisionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment revision number"@en ;
    rdfs:comment "Sequential revision number for this commitment. Increments when commitment parameters are updated due to market re-runs, unit availability changes, or dispatch adjustments."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:int ;
    cmm:physicalColumn "commitment_revision_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Revision Number" ;
    cmm:cimDatatype "Integer" .
cmm:UnitCommitment.commitmentSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment source"@en ;
    rdfs:comment "Origin of the commitment decision. Indicates whether commitment resulted from ISO/RTO Security-Constrained Unit Commitment (SCUC), self-schedule, reliability requirement, or other source."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "commitment_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Source" ;
    cmm:validValues "scuc|self_schedule|reliability_must_run|manual_dispatch|emergency_dispatch|ancillary_service" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.commitmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment status"@en ;
    rdfs:comment "Current lifecycle status of the unit commitment. Tracks progression from initial commitment decision through dispatch execution to unit synchronization and operation. Reference-value candidates: pending|confirmed|dispatched|synchronized|operating|ramping_down|offline|cancelled|failed."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "commitment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commitment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.status .
cmm:UnitCommitment.commitmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment timestamp"@en ;
    rdfs:comment "Date and time when the commitment decision was made by the ISO/RTO or internal scheduling system. Principal business event timestamp for this transaction."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "commitment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:UnitCommitment.committedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "committed capacity mw"@en ;
    rdfs:comment "The committed generation capacity in megawatts (MW) for the commitment period. Represents the output level the unit is scheduled to provide."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "committed_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Committed Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:UnitCommitment.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User ID or system identifier that created this commitment record. Supports audit trail and accountability for commitment decisions."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this commitment record was first created in the system. Audit trail for record creation."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.createdDateTime .
cmm:UnitCommitment.dispatchPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority"@en ;
    rdfs:comment "Numeric priority ranking for dispatch order. Lower numbers indicate higher priority. Used in economic dispatch and Automatic Generation Control (AGC) sequencing."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:int ;
    cmm:physicalColumn "dispatch_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Priority" ;
    cmm:cimDatatype "Integer" .
cmm:UnitCommitment.economicMaximumMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "economic maximum mw"@en ;
    rdfs:comment "Maximum generation level in megawatts at which the unit can operate economically under normal conditions. Represents the upper bound of the economic operating range."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "economic_maximum_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Economic Maximum (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:UnitCommitment.economicMinimumMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "economic minimum mw"@en ;
    rdfs:comment "Minimum stable generation level in megawatts at which the unit can operate economically. Below this level, unit efficiency degrades significantly."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "economic_minimum_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Economic Minimum (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:UnitCommitment.estimatedCo2EmissionsTons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated co2 emissions tons"@en ;
    rdfs:comment "Estimated carbon dioxide emissions in tons for the commitment period, calculated from fuel type, heat rate, and generation output."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_co2_emissions_tons" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Carbon Dioxide (CO2) Emissions (Tons)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:UnitCommitment.estimatedFuelCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated fuel cost usd"@en ;
    rdfs:comment "Estimated total fuel cost in US dollars for the commitment period, based on committed capacity, expected heat rate, and fuel price."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_fuel_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Fuel Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:UnitCommitment.estimatedNoxEmissionsLbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated nox emissions lbs"@en ;
    rdfs:comment "Estimated nitrogen oxides emissions in pounds for the commitment period. Critical for compliance with EPA NOx Budget Trading Program and regional air quality standards."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_nox_emissions_lbs" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Nitrogen Oxides (NOx) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:UnitCommitment.estimatedSo2EmissionsLbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated so2 emissions lbs"@en ;
    rdfs:comment "Estimated sulfur dioxide emissions in pounds for the commitment period. Required for EPA Acid Rain Program compliance and SO2 allowance tracking."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_so2_emissions_lbs" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Sulfur Dioxide (SO2) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:UnitCommitment.estimatedStartupCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated startup cost usd"@en ;
    rdfs:comment "Estimated cost in US dollars to start the unit for this commitment, including fuel, maintenance wear, and auxiliary power. Varies by startup type."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_startup_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Startup Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:UnitCommitment.estimatedVariableOmCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated variable om cost usd"@en ;
    rdfs:comment "Estimated variable operations and maintenance cost in US dollars for the commitment period, based on generation output and unit-specific O&M rates."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_variable_om_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Variable Operations and Maintenance (O&M) Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:UnitCommitment.expectedHeatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expected heat rate btu per kwh"@en ;
    rdfs:comment "Expected thermal efficiency of the unit during this commitment, measured in British Thermal Units (BTU) per kilowatt-hour. Lower values indicate higher efficiency."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "expected_heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expected Heat Rate (BTU per kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:UnitCommitment.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "Primary fuel source for this commitment period. Examples: natural gas, coal, nuclear, hydro, wind, solar, biomass, oil, dual-fuel. Impacts emissions and cost calculations."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "Code identifying the Independent System Operator (ISO) or Regional Transmission Organization (RTO) that issued or cleared this commitment. Examples: CAISO, PJM, ERCOT, MISO, NYISO, ISO-NE, SPP."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ISO/RTO Code" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.lmpForecastUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp forecast usd per mwh"@en ;
    rdfs:comment "Forecasted Locational Marginal Price in US dollars per megawatt-hour at the unit's pricing node (PNode) for the commitment period. Used in economic dispatch decisions."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lmp_forecast_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) Forecast (USD per MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:UnitCommitment.marketIntervalEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market interval end"@en ;
    rdfs:comment "End timestamp of the market interval or trading period associated with this commitment. Defines the market settlement window."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "market_interval_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Interval End" ;
    cmm:cimDatatype "DateTime" .
cmm:UnitCommitment.marketIntervalStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market interval start"@en ;
    rdfs:comment "Start timestamp of the market interval or trading period associated with this commitment. Aligns commitment with specific market clearing results."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "market_interval_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Interval Start" ;
    cmm:cimDatatype "DateTime" .
cmm:UnitCommitment.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "Type of energy market associated with this commitment. Distinguishes Day-Ahead Market (DAM), Real-Time Market (RTM), hour-ahead, intra-hour, or bilateral arrangements."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Type" ;
    cmm:validValues "dam|rtm|hour_ahead|intra_hour|bilateral" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.minimumDownTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum down time hours"@en ;
    rdfs:comment "Minimum offline time in hours required before the unit can be restarted. Technical constraint based on cooling requirements and equipment protection."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_down_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Down Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:UnitCommitment.minimumRunTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum run time hours"@en ;
    rdfs:comment "Minimum continuous operating time in hours required once the unit is started. Technical constraint based on unit design and thermal stress limits."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_run_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Run Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:UnitCommitment.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or system identifier that last modified this commitment record. Supports audit trail for commitment revisions."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:UnitCommitment.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when this commitment record was last modified. Audit trail for record updates and revisions."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:UnitCommitment.mustRunFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "must run flag"@en ;
    rdfs:comment "Indicates whether this is a reliability-must-run (RMR) commitment required for transmission system reliability, voltage support, or local capacity requirements regardless of economics."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "must_run_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Must-Run Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:UnitCommitment.rampRateDownMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate down mw per min"@en ;
    rdfs:comment "Maximum rate at which the unit can decrease generation output, measured in megawatts per minute. Important for load-following and emergency response."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_down_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Down (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:UnitCommitment.rampRateUpMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate up mw per min"@en ;
    rdfs:comment "Maximum rate at which the unit can increase generation output, measured in megawatts per minute. Critical for AGC response and frequency regulation."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_up_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Up (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:UnitCommitment.shutdownTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shutdown time hours"@en ;
    rdfs:comment "Expected time in hours from shutdown initiation to complete unit offline status, including controlled ramp-down and equipment securing."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shutdown_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shutdown Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:UnitCommitment.startupTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup time hours"@en ;
    rdfs:comment "Expected time in hours from startup initiation to unit synchronization and minimum load, based on the startup type (hot/warm/cold)."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:UnitCommitment.startupType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup type"@en ;
    rdfs:comment "Classification of the unit startup based on time offline and equipment temperature. Determines startup time, fuel consumption, and emissions profile."@en ;
    rdfs:domain cmm:UnitCommitment ; rdfs:range xsd:string ;
    cmm:physicalColumn "startup_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Type" ;
    cmm:validValues "hot|warm|cold|emergency" ;
    cmm:cimDatatype "String" .

cmm:DispatchSchedule a owl:Class ;
    rdfs:label "Dispatch Schedule"@en ;
    rdfs:comment "Hourly and sub-hourly generation dispatch instructions for each generating unit, produced by the EMS/SCADA dispatch engine or received as ISO/RTO dispatch instructions per FERC Order 764 (15-minute scheduling intervals). Captures schedule interval timestamp, scheduled output (MW), economic dispatch order, incremental cost curve reference, curtailment flag, must-run flag, AGC setpoint, and source system (ABB Symphony Plus / EMS). Links to unit commitment decisions that authorize the dispatch. Supports real-time generation control, NERC BAL standard compliance (balancing authority ACE), AGC performance scoring, and settlement reconciliation against actual output telemetry."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:GenUnitOpSchedule ;
    cmm:cimExactMatch cim:GenUnitOpSchedule ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.dispatch_schedule" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC BAL / EMS Dispatch Instruction" ;
    cmm:sourceObject "energy_utilities_ecm.generation.dispatch_schedule" ;
    owl:hasKey ( cmm:DispatchSchedule.dispatchScheduleId ) .

cmm:DispatchSchedule.dispatchScheduleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch schedule id"@en ;
    rdfs:comment "Unique identifier for the dispatch schedule record. Primary key for the dispatch schedule entity."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "dispatch_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Dispatch Schedule ID" ;
    cmm:cimDatatype "Integer" .
cmm:DispatchSchedule.congestionEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "congestion event"@en ;
    rdfs:comment "Foreign key linking to transmission.congestion_event. Business justification: Real-time dispatch schedules are adjusted in response to transmission congestion events. When binding constraints occur, ISO/RTO operators redispatch generation to relieve congestion. Links dispatch i"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:CongestionEvent ;
    cmm:physicalColumn "congestion_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Congestion Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_congestion_event_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.PSREvent" .
cmm:DispatchSchedule.contingencyAnalysisRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis run"@en ;
    rdfs:comment "Foreign key linking to grid.contingency_analysis_run. Business justification: Dispatch setpoints are inputs to real-time contingency analysis for thermal and voltage limit checking. Required for NERC TPL-001 and real-time operations."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:ContingencyAnalysisRun ;
    cmm:physicalColumn "contingency_analysis_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Analysis Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_contingency_analysis_run_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ActivityRecord" .
cmm:DispatchSchedule.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Dispatch instructions are issued by control area operators for AGC and economic dispatch. Essential for ACE calculation and real-time balancing operations."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_control_area_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:DispatchSchedule.dispatchGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch generating unit"@en ;
    rdfs:comment "Foreign key reference to the generating unit receiving this dispatch instruction. Links to the specific turbine, generator, or generation asset being dispatched."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "dispatch_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_dispatch_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:DispatchSchedule.dispatchUnitCommitment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch unit commitment"@en ;
    rdfs:comment "Foreign key reference to the unit commitment decision that authorized this dispatch schedule. Links to the day-ahead or real-time commitment that placed the unit online."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:UnitCommitment ;
    cmm:physicalColumn "dispatch_unit_commitment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Unit Commitment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_dispatch_unit_commitment_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GenUnitOpSchedule" .
cmm:DispatchSchedule.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Foreign key linking to demand.dr_event. Business justification: Real-time dispatch schedules are adjusted based on active DR events. Operators need to track which DR events caused dispatch modifications for settlement, performance analysis, and regulatory reportin"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_dr_event_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.EndDeviceControl" .
cmm:DispatchSchedule.energySchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy schedule"@en ;
    rdfs:comment "Foreign key linking to trading.energy_schedule. Business justification: Dispatch instructions are matched to energy schedules (e-Tags) for settlement reconciliation and variance analysis. Core process in ISO market operations for physical vs. financial schedule alignment."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:EnergySchedule ;
    cmm:physicalColumn "energy_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_energy_schedule_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.EnergyTransaction" .
cmm:DispatchSchedule.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Major distribution or transmission outages trigger emergency dispatch schedule revisions, load shedding, and black-start procedures. Linking dispatch changes to causative outage events supports NERC e"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_event_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Outage" .
cmm:DispatchSchedule.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every dispatch instruction targets a specific generating unit. Without this FK, dispatch records float without unit context, breaking real-time generation control and settlement reconciliation."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:DispatchSchedule.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Dispatch schedules execute against specific load forecasts in real-time operations. AGC setpoints and economic dispatch orders reference load forecast intervals. Required for dispatch variance analysi"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_load_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ConformLoadSchedule" .
cmm:DispatchSchedule.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Dispatch operations must comply with ISO/RTO market rules and NERC standards (BAL-001, INT-006). Required for market compliance validation, settlement dispute resolution, and demonstrating adherence t"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_obligation_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Document" .
cmm:DispatchSchedule.operatorLog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator log"@en ;
    rdfs:comment "Foreign key linking to grid.operator_log. Business justification: Dispatch instructions are logged for audit trail and compliance verification. Required for NERC BAL standards and market settlement disputes."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:OperatorLog ;
    cmm:physicalColumn "operator_log_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Log Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_operator_log_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.Document" .
cmm:DispatchSchedule.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Dispatch schedules are issued per generating unit. This FK is essential for real-time generation control — the EMS/SCADA system must know which unit to dispatch. generating_unit_id is required on disp"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_primary_generating_unit_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GeneratingUnit" .
cmm:DispatchSchedule.primaryUnitCommitment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary unit commitment"@en ;
    rdfs:comment "FK to generation.unit_commitment.unit_commitment_id — Dispatch schedules are derived from unit commitment decisions. unit_commitment_id links the dispatch instruction back to the commitment that authorized it, enabling settlement reconciliation."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:UnitCommitment ;
    cmm:physicalColumn "primary_unit_commitment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_primary_unit_commitment_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GenUnitOpSchedule" .
cmm:DispatchSchedule.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Foreign key linking to grid.state_estimation_run. Business justification: Dispatch schedules provide generation setpoints for state estimator base case. Required for real-time network analysis and contingency screening."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimation Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_state_estimation_run_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ActivityRecord" .
cmm:DispatchSchedule.unitCommitment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "unit commitment"@en ;
    rdfs:comment "FK to generation.unit_commitment.unit_commitment_id — Dispatch instructions are authorized by unit commitment decisions. This link enables traceability from real-time dispatch back to the commitment that authorized it — critical for market settlement and"@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range cmm:UnitCommitment ;
    cmm:physicalColumn "unit_commitment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_dispatch_schedule_unit_commitment_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.GenUnitOpSchedule" .
cmm:DispatchSchedule.actualOutputMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual output mw"@en ;
    rdfs:comment "The actual measured generation output in MW during this dispatch interval as reported by SCADA telemetry. Used for settlement reconciliation, AGC performance scoring, and dispatch compliance analysis. Compared against scheduled_output_mw to calculate dispatch variance."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_output_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Output Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.agcSetpointMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc setpoint mw"@en ;
    rdfs:comment "The AGC setpoint in megawatts sent to the generating unit's automatic generation control system. This is the real-time control signal that adjusts unit output to maintain system frequency and balance generation with load. May differ slightly from scheduled_output_mw due to real-time balancing requirements."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "agc_setpoint_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Setpoint Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this dispatch schedule record was first created in the system. Audit trail field for data lineage and compliance reporting."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.createdDateTime .
cmm:DispatchSchedule.curtailmentReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment reason code"@en ;
    rdfs:comment "Categorical code indicating the reason for curtailment if the is_curtailed flag is true. Supports root cause analysis of generation curtailment events and regulatory reporting. Reference-value candidates: transmission_constraint|over_generation|market_condition|environmental_limit|fuel_limitation|equipment_derate|none."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "curtailment_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Reason Code" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.dispatchAcknowledgementTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch acknowledgement timestamp"@en ;
    rdfs:comment "The timestamp when the generating unit operator or control system acknowledged receipt of this dispatch instruction. Used to measure response time and operator compliance."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_acknowledgement_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Acknowledgement Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DispatchSchedule.dispatchComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch compliance flag"@en ;
    rdfs:comment "Boolean flag indicating whether the generating unit's actual output was within acceptable tolerance of the scheduled output for this dispatch interval. True if compliant, false if variance exceeded threshold. Used for operator performance evaluation and NERC compliance reporting."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispatch_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DispatchSchedule.dispatchInstructionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch instruction timestamp"@en ;
    rdfs:comment "The timestamp when this dispatch instruction was issued by the EMS/SCADA system or received from the ISO/RTO. Represents when the instruction was communicated to plant operators or control systems. Used for performance analysis and compliance verification."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_instruction_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Instruction Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DispatchSchedule.dispatchPriorityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority code"@en ;
    rdfs:comment "Categorical code indicating the dispatch priority classification of this generating unit for this interval. Baseload units run continuously, intermediate units cycle daily, peaking units run during high-demand periods, renewable units dispatch when available, emergency units are last resort, and test dispatches are for commissioning or maintenance verification."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_priority_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Priority Code" ;
    cmm:validValues "baseload|intermediate|peaking|renewable|emergency|test" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.dispatchScheduleNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch schedule number"@en ;
    rdfs:comment "Business identifier for the dispatch schedule. Human-readable reference number used in operational communications and SCADA displays."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_schedule_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Schedule Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DispatchSchedule.dispatchSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch source system"@en ;
    rdfs:comment "The source system that generated this dispatch instruction. Identifies whether the dispatch came from the internal EMS/SCADA dispatch engine (ABB Symphony Plus), an external ISO/RTO market dispatch, or manual operator entry."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Source System" ;
    cmm:validValues "ems|scada|iso_rto|manual|abb_symphony_plus" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.dispatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch status"@en ;
    rdfs:comment "Current lifecycle status of the dispatch schedule. Tracks whether the dispatch instruction is pending execution, actively being followed, completed, or cancelled."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Status" ;
    cmm:validValues "scheduled|active|completed|cancelled|superseded|failed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GenUnitOpSchedule.status .
cmm:DispatchSchedule.dispatchVarianceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch variance mw"@en ;
    rdfs:comment "The difference between actual output and scheduled output in MW (actual_output_mw minus scheduled_output_mw). Positive values indicate over-generation; negative values indicate under-generation. Used for AGC performance scoring and NERC BAL compliance reporting."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "dispatch_variance_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Variance Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.economicDispatchOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "economic dispatch order"@en ;
    rdfs:comment "The merit order ranking of this generating unit in the economic dispatch stack for this interval. Lower numbers indicate lower incremental cost and higher dispatch priority. Used for economic optimization of generation fleet."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "economic_dispatch_order" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Economic Dispatch Order" ;
    cmm:cimDatatype "Integer" .
cmm:DispatchSchedule.emissionsRateCo2LbsPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate co2 lbs per mwh"@en ;
    rdfs:comment "The carbon dioxide emissions rate in pounds per MWh for this generating unit at the scheduled output level during this dispatch interval. Used for environmental compliance reporting, carbon accounting, and emissions trading programs."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_rate_co2_lbs_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Rate Carbon Dioxide (CO2) Pounds (lbs) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DispatchSchedule.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "The primary fuel type used by the generating unit for this dispatch interval. Supports fuel-specific dispatch optimization, emissions tracking, and renewable portfolio standard (RPS) compliance reporting. Reference-value candidates: natural_gas|coal|nuclear|hydro|wind|solar|biomass|oil|geothermal."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.heatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate btu per kwh"@en ;
    rdfs:comment "The heat rate in BTU per kWh for this generating unit at the scheduled output level during this dispatch interval. Represents the thermal efficiency of the unit. Lower heat rates indicate higher efficiency. Used for fuel cost calculation and LCOE analysis."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Rate British Thermal Units (BTU) per Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DispatchSchedule.incrementalCostCurveReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incremental cost curve reference"@en ;
    rdfs:comment "Foreign key reference to the incremental cost curve (heat rate curve) used to calculate the economic dispatch order for this unit during this interval. Links to the cost function that defines the relationship between output level and marginal cost."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "incremental_cost_curve_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incremental Cost Curve ID" ;
    cmm:cimDatatype "Integer" .
cmm:DispatchSchedule.isCurtailed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is curtailed"@en ;
    rdfs:comment "Boolean flag indicating whether this dispatch schedule represents a curtailment instruction (reduction from maximum available output). True if the unit is being dispatched below its available capacity due to transmission constraints, over-generation conditions, or market conditions."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_curtailed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Curtailed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DispatchSchedule.isMustRun a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is must run"@en ;
    rdfs:comment "Boolean flag indicating whether this generating unit is operating under a must-run designation for this interval. Must-run units are required to operate for reliability, voltage support, or contractual reasons regardless of economic dispatch order."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_must_run" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Must-Run Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DispatchSchedule.isoRtoDispatchReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto dispatch reference"@en ;
    rdfs:comment "External dispatch instruction identifier from the ISO or RTO if this dispatch schedule originated from a wholesale market dispatch signal. Used for settlement reconciliation and market compliance verification."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_dispatch_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Dispatch ID" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.locationalMarginalPriceUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "locational marginal price usd per mwh"@en ;
    rdfs:comment "The locational marginal price in USD per MWh at the generating unit's pricing node (PNode) for this dispatch interval. Represents the marginal cost of serving the next increment of load at this location. Used for settlement and economic analysis."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "locational_marginal_price_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) United States Dollars (USD) per Megawatt-Hour (MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DispatchSchedule.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "The type of energy market or scheduling process that produced this dispatch instruction. Distinguishes between day-ahead market (DAM), real-time market (RTM), ancillary service dispatch, capacity market obligations, bilateral contracts, or internal economic dispatch."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Type" ;
    cmm:validValues "day_ahead|real_time|ancillary_service|capacity|bilateral|internal" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.maximumGenerationLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum generation limit mw"@en ;
    rdfs:comment "The maximum available generation capacity in MW for this generating unit during this dispatch interval. Represents the technical upper bound considering current equipment status, ambient conditions, and operational constraints. Used to validate dispatch feasibility."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_generation_limit_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Generation Limit Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.minimumGenerationLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum generation limit mw"@en ;
    rdfs:comment "The minimum stable generation level in MW for this generating unit during this dispatch interval. Represents the technical lower bound below which the unit cannot operate reliably. Used to validate dispatch feasibility."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_generation_limit_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Generation Limit Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "The timestamp when this dispatch schedule record was last modified. Audit trail field for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DispatchSchedule.mustRunReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "must run reason code"@en ;
    rdfs:comment "Categorical code indicating the reason for must-run designation if the is_must_run flag is true. Documents the reliability or contractual basis for out-of-merit dispatch."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "must_run_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Must-Run Reason Code" ;
    cmm:validValues "reliability|voltage_support|black_start|contractual|local_capacity|none" ;
    cmm:cimDatatype "String" .
cmm:DispatchSchedule.operatorNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator notes"@en ;
    rdfs:comment "Free-text field for plant operators or dispatch coordinators to record notes, observations, or special instructions related to this dispatch schedule. Supports operational knowledge capture and incident investigation."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operator Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DispatchSchedule.rampRateMwPerMinute a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per minute"@en ;
    rdfs:comment "The maximum allowable rate of change in generation output in MW per minute for this dispatch interval. Constrains how quickly the unit can increase or decrease output to protect equipment and maintain grid stability."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_mw_per_minute" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Megawatts (MW) per Minute" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:DispatchSchedule.regulationDownMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation down mw"@en ;
    rdfs:comment "The amount of downward regulation capacity in MW that this generating unit is providing during this dispatch interval. Regulation down is the ability to decrease output below the scheduled setpoint to provide frequency regulation ancillary service."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulation_down_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulation Down Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.regulationUpMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation up mw"@en ;
    rdfs:comment "The amount of upward regulation capacity in MW that this generating unit is providing during this dispatch interval. Regulation up is the ability to increase output above the scheduled setpoint to provide frequency regulation ancillary service."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulation_up_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulation Up Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.scheduleIntervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule interval end timestamp"@en ;
    rdfs:comment "The timestamp marking the end of the dispatch interval. Defines the duration for which this dispatch instruction is valid."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "schedule_interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Schedule Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DispatchSchedule.scheduleIntervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule interval start timestamp"@en ;
    rdfs:comment "The timestamp marking the beginning of the dispatch interval. Represents the real-world time when this dispatch instruction becomes effective. Aligns with FERC Order 764 15-minute scheduling intervals or ISO/RTO market intervals."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "schedule_interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Schedule Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DispatchSchedule.scheduledOutputMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled output mw"@en ;
    rdfs:comment "The target generation output in megawatts (MW) that the generating unit is instructed to produce during this dispatch interval. Core dispatch setpoint used by plant operators and AGC systems."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "scheduled_output_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Output Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DispatchSchedule.settlementAmountUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement amount usd"@en ;
    rdfs:comment "The financial settlement amount in USD for this dispatch interval. Calculated as actual output (MWh) multiplied by the applicable LMP or contract price. Used for revenue recognition and market settlement reconciliation."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "settlement_amount_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Amount United States Dollars (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DispatchSchedule.spinningReserveMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "spinning reserve mw"@en ;
    rdfs:comment "The amount of spinning reserve capacity in MW that this generating unit is providing during this dispatch interval. Spinning reserve is synchronized generation capacity that can respond within 10 minutes to replace lost generation."@en ;
    rdfs:domain cmm:DispatchSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "spinning_reserve_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Spinning Reserve Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .

cmm:OutputTelemetry a owl:Class ;
    rdfs:label "Output Telemetry"@en ;
    rdfs:comment "Interval-level actual generation output telemetry for each generating unit, sourced from OSIsoft PI historian via ABB Ability Symphony Plus DCS integration. Captures interval timestamp (5-min, 15-min, hourly), gross generation (MWh), net generation (MWh), auxiliary load (MWh), reactive power (MVAr), power factor, frequency deviation, and data quality flag. Primary source for settlement metering, NERC compliance, and LCOE calculations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AnalogValue ;
    cmm:cimCloseMatch cim:AnalogValue ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.output_telemetry" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OSIsoft PI Historian / NERC MOD-025 / EIA Form 923" ;
    cmm:sourceObject "energy_utilities_ecm.generation.output_telemetry" ;
    owl:hasKey ( cmm:OutputTelemetry.outputTelemetryId ) .

cmm:OutputTelemetry.outputTelemetryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "output telemetry id"@en ;
    rdfs:comment "Primary key for output_telemetry"@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:long ;
    cmm:physicalColumn "output_telemetry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Output Telemetry Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:OutputTelemetry.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Generation telemetry aggregates to control area for ACE calculation, CPS1/CPS2 compliance, and real-time balancing. Required for NERC BAL standards reporting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_control_area_id" ;
    cmm:cimAssociation "AnalogValue.ControlArea" .
cmm:OutputTelemetry.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Actual generation output telemetry is measured at the generating unit level. Without this FK, telemetry data cannot be attributed to the unit that produced it. Critical for settlement metering and per"@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_generating_unit_id" ;
    cmm:cimAssociation "AnalogValue.GeneratingUnit" .
cmm:OutputTelemetry.marketSettlement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "market settlement"@en ;
    rdfs:comment "Foreign key linking to trading.market_settlement. Business justification: Actual generation telemetry is the basis for market settlement calculations and invoice reconciliation. Fundamental meter-to-cash process linking physical generation to financial settlement."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:MarketSettlement ;
    cmm:physicalColumn "market_settlement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Market Settlement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_market_settlement_id" ;
    cmm:cimAssociation "AnalogValue.Settlement" .
cmm:OutputTelemetry.outputForGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "output_for_generating_unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every telemetry reading comes from a specific generating unit. Without this FK, actual generation data cannot be attributed to units, breaking settlement metering, NERC compliance, and LCOE calculatio"@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "output_for_generating_unit" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_output_for_generating_unit" ;
    cmm:cimAssociation "AnalogValue.GeneratingUnit" .
cmm:OutputTelemetry.outputGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "output generating unit"@en ;
    rdfs:comment "Foreign key reference to the specific generating unit (turbine, generator, or plant unit) that produced this telemetry reading. Links to the asset registry for unit-level attribution."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "output_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_output_generating_unit_id" ;
    cmm:cimAssociation "AnalogValue.GeneratingUnit" .
cmm:OutputTelemetry.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Generation output telemetry is measured per generating unit via SCADA/DCS. This FK is critical for settlement metering, NERC compliance, and LCOE calculations. generating_unit_id is required on output"@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_primary_generating_unit_id" ;
    cmm:cimAssociation "AnalogValue.GeneratingUnit" .
cmm:OutputTelemetry.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Foreign key linking to grid.state_estimation_run. Business justification: Generation telemetry measurements feed state estimator for real-time power flow solution. Required for EMS observability and bad data detection."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimation Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_output_telemetry_state_estimation_run_id" ;
    cmm:cimAssociation "AnalogValue.ActivityRecord" .
cmm:OutputTelemetry.ambientTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature c"@en ;
    rdfs:comment "Ambient air temperature at the generating unit location during the interval, measured in degrees Celsius. Impacts heat rate, efficiency calculations, and capacity derating for thermal units."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature (°C)" ;
    cmm:cimDatatype "Decimal" .
cmm:OutputTelemetry.ancillaryServiceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether the generating unit was providing ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) during this interval."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ancillary_service_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Service Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutputTelemetry.auxiliaryLoadMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auxiliary load mwh"@en ;
    rdfs:comment "Electrical energy consumed by the generating unit's auxiliary equipment and station service during the interval, measured in megawatt-hours (MWh). Represents the difference between gross and net generation."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "auxiliary_load_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auxiliary Load (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:OutputTelemetry.availabilityStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "availability status"@en ;
    rdfs:comment "Operational availability status of the generating unit during the interval. Indicates whether the unit was available for dispatch, unavailable due to outage, operating at reduced capacity, or in a transitional state."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "availability_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Availability Status" ;
    cmm:validValues "available|unavailable|derated|testing|startup|shutdown" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.capacityFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity factor percent"@en ;
    rdfs:comment "Ratio of actual generation to maximum possible generation during the interval, expressed as a percentage. Indicates unit utilization and performance relative to nameplate capacity. Range: 0.00 to 100.00."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Factor (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:OutputTelemetry.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Quality indicator for the telemetry reading. Flags whether the data point is validated, estimated due to sensor failure, missing, suspect and requiring review, or manually overridden by operations staff."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "valid|estimated|missing|suspect|manual_override" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:OutputTelemetry.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the upstream operational system that provided this telemetry record to the lakehouse. Typically OSIsoft PI, ABB Ability Symphony Plus, or GE PowerOn. Used for data lineage and integration monitoring."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.dispatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch status"@en ;
    rdfs:comment "Dispatch instruction status for the generating unit during the interval. Indicates whether the unit was actively dispatched by the ISO/RTO, committed for reliability, operating economically, or offline."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Status" ;
    cmm:validValues "dispatched|committed|economic|must_run|curtailed|offline" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.emissionsCo2Tons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions co2 tons"@en ;
    rdfs:comment "Estimated carbon dioxide emissions produced during the interval, measured in metric tons. Calculated from fuel consumption and emission factors. Used for environmental compliance reporting and carbon accounting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_co2_tons" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Dioxide (CO2) Emissions (Tons)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:OutputTelemetry.emissionsNoxLbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions nox lbs"@en ;
    rdfs:comment "Estimated nitrogen oxides emissions produced during the interval, measured in pounds. Critical for air quality compliance and emissions trading programs."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_nox_lbs" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nitrogen Oxides (NOx) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:OutputTelemetry.emissionsSo2Lbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions so2 lbs"@en ;
    rdfs:comment "Estimated sulfur dioxide emissions produced during the interval, measured in pounds. Used for environmental compliance and emissions allowance tracking."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_so2_lbs" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sulfur Dioxide (SO2) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:OutputTelemetry.forcedOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forced outage flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether the generating unit experienced a forced outage or unplanned derate during this interval. Used for reliability reporting and NERC GADS compliance."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "forced_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forced Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutputTelemetry.frequencyDeviationHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency deviation hz"@en ;
    rdfs:comment "Deviation from nominal grid frequency (typically 60 Hz in North America or 50 Hz elsewhere) during the interval, measured in hertz. Used for grid stability monitoring and NERC compliance reporting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_deviation_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Deviation (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:OutputTelemetry.fuelConsumptionMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel consumption mmbtu"@en ;
    rdfs:comment "Total fuel consumed by the generating unit during the interval, measured in million British Thermal Units (MMBtu). Used for fuel inventory management, cost allocation, and emissions calculations."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fuel_consumption_mmbtu" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Consumption (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:OutputTelemetry.grossGenerationMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gross generation mwh"@en ;
    rdfs:comment "Total electrical energy generated by the unit during the interval, measured in megawatt-hours (MWh), before deducting auxiliary load or station service. Primary metric for generation capacity and output tracking."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gross_generation_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Gross Generation (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:OutputTelemetry.heatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate btu per kwh"@en ;
    rdfs:comment "Thermal efficiency of the generating unit during the interval, expressed as British Thermal Units (BTU) of fuel input per kilowatt-hour of electrical output. Lower values indicate higher efficiency. Critical for LCOE analysis and fuel cost optimization."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Rate (BTU per kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:OutputTelemetry.historianTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "historian tag name"@en ;
    rdfs:comment "The specific tag name or point identifier in the OSIsoft PI historian or equivalent time-series database that stores this telemetry reading. Used for data lineage, audit trails, and integration with real-time monitoring systems."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "historian_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.intervalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval duration minutes"@en ;
    rdfs:comment "The duration of the measurement interval in minutes. Common values include 5, 15, or 60 minutes. Used to normalize interval data for aggregation and settlement calculations."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutputTelemetry.intervalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval timestamp"@en ;
    rdfs:comment "The precise timestamp marking the end of the measurement interval for this telemetry reading. Represents the real-world event time when the generation output was recorded by the DCS or SCADA system. Typically aligned to 5-minute, 15-minute, or hourly intervals depending on settlement and reporting requirements."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interval Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:OutputTelemetry.lmpPricingNode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp pricing node"@en ;
    rdfs:comment "The pricing node (PNode) identifier at which this generation output is settled in the wholesale market. Used to associate generation with locational marginal pricing for revenue settlement."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "lmp_pricing_node" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) Pricing Node" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.marketSettlementAmountUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market settlement amount usd"@en ;
    rdfs:comment "Financial settlement amount for this generation interval in US dollars, calculated based on net generation and applicable LMP or contract rates. Used for revenue recognition and financial reporting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "market_settlement_amount_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Settlement Amount (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:OutputTelemetry.netGenerationMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net generation mwh"@en ;
    rdfs:comment "Net electrical energy delivered to the grid during the interval, measured in megawatt-hours (MWh), after deducting auxiliary load and station service consumption. Used for settlement metering, revenue calculations, and LCOE analysis."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_generation_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Generation (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:OutputTelemetry.plannedOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether the generating unit was on a scheduled planned outage or maintenance during this interval. Used for capacity planning and reliability reporting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "planned_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutputTelemetry.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "Ratio of real power to apparent power during the interval, expressed as a decimal between 0 and 1. Indicates the efficiency of power delivery and compliance with grid interconnection standards. Typical range: 0.85 to 1.00."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:OutputTelemetry.rampRateMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per min"@en ;
    rdfs:comment "Rate of change in generation output during the interval, measured in megawatts per minute. Indicates the unit's ability to respond to dispatch signals and grid frequency changes. Critical for AGC and frequency response compliance."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:OutputTelemetry.reactivePowerMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power mvar"@en ;
    rdfs:comment "Reactive power output during the interval, measured in megavolt-amperes reactive (MVAr). Critical for voltage support, grid stability, and compliance with interconnection agreements."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_mvar" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:OutputTelemetry.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this telemetry record was first inserted into the lakehouse silver layer. Used for data lineage, audit trails, and ETL troubleshooting. Distinct from interval_timestamp which represents the business event time."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:OutputTelemetry.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Timestamp when this telemetry record was last modified in the lakehouse silver layer. Used for change tracking, audit trails, and data quality monitoring. Updated whenever VEE processes or manual corrections are applied."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:OutputTelemetry.scadaSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada source system"@en ;
    rdfs:comment "Identifier of the SCADA or DCS system that originated this telemetry reading. Typically references ABB Ability Symphony Plus, OSIsoft PI, or other plant control systems. Used for data lineage and troubleshooting."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Source System" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.settlementMeterFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement meter flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this telemetry reading is used for financial settlement with the ISO/RTO or wholesale market. True indicates the reading is settlement-quality and used for revenue calculations."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "settlement_meter_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Meter Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutputTelemetry.validationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation method"@en ;
    rdfs:comment "Method used to validate or estimate the telemetry reading. Indicates whether the data was automatically validated, manually reviewed, processed through Validation Estimation and Editing (VEE) algorithms, or verified by SCADA/historian systems."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Method" ;
    cmm:validValues "automated|manual|vee|scada_verified|historian_validated" ;
    cmm:cimDatatype "String" .
cmm:OutputTelemetry.voltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage kv"@en ;
    rdfs:comment "Terminal voltage at the generator output during the interval, measured in kilovolts (kV). Used for voltage regulation monitoring and compliance with interconnection requirements."@en ;
    rdfs:domain cmm:OutputTelemetry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:HeatRateTest a owl:Class ;
    rdfs:label "Heat Rate Test"@en ;
    rdfs:comment "Records of periodic performance and capability tests conducted on generating units. For heat rate tests: captures test date, test type (acceptance, periodic, diagnostic), measured net heat rate (BTU/kWh), design heat rate, ambient temperature, load level tested (MW), fuel type and HHV used, test duration, and deviation from design. For capacity tests: captures demonstrated net capability (MW), net dependable capability (MW), test type (summer peak, winter peak, seasonal), ambient conditions, test duration, and ISO/RTO submission status. Used for LCOE analysis, IRP modeling, NERC MOD-025 compliance, and capacity market accreditation. SSOT for all generating unit performance and capability test results."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:HeatRateCurve ;
    cmm:cimCloseMatch cim:HeatRateCurve ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.heat_rate_test" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ASME PTC 46; NERC MOD-027 / ASME PTC 46 Performance Test" ;
    cmm:sourceObject "energy_utilities_ecm.generation.heat_rate_test" ;
    owl:hasKey ( cmm:HeatRateTest.heatRateTestId ) .

cmm:HeatRateTest.heatRateTestId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate test id"@en ;
    rdfs:comment "Unique identifier for the heat rate test record. Primary key for the heat_rate_test product."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:long ;
    cmm:physicalColumn "heat_rate_test_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Heat Rate Test ID" ;
    cmm:unitSymbol "Btu/kWh" ;
    cmm:cimDatatype "Float" .
cmm:HeatRateTest.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Performance tests (heat rate and capacity) are conducted on specific generating units. generating_unit_id is required for NERC MOD compliance tracking and IRP modeling."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_heat_rate_test_generating_unit_id" ;
    cmm:cimAssociation "HeatRateCurve.GeneratingUnit" .
cmm:HeatRateTest.heatForGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "heat_for_generating_unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every performance/capability test is conducted on a specific generating unit. Without this FK, test results cannot be linked to the unit they measure, breaking NERC MOD-025 compliance and capacity acc"@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "heat_for_generating_unit" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_heat_rate_test_heat_for_generating_unit" ;
    cmm:cimAssociation "HeatRateCurve.GeneratingUnit" .
cmm:HeatRateTest.heatGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "heat generating unit"@en ;
    rdfs:comment "Reference to the generating unit on which the heat rate test was conducted. Links to the generating unit asset registry."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "heat_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_heat_rate_test_heat_generating_unit_id" ;
    cmm:cimAssociation "HeatRateCurve.GeneratingUnit" .
cmm:HeatRateTest.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Heat rate tests satisfy ISO/RTO market qualification rules and FERC requirements for market-based rate authority. Essential for market participation compliance, rate case support, and regulatory submi"@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_heat_rate_test_obligation_id" ;
    cmm:cimAssociation "HeatRateCurve.Document" .
cmm:HeatRateTest.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Foreign key linking to asset.work_order. Business justification: Heat rate tests are performed as part of commissioning work orders, post-maintenance validation, or ISO/RTO performance verification requirements. Linking tests to work orders tracks labor costs, sche"@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_heat_rate_test_work_order_id" ;
    cmm:cimAssociation "HeatRateCurve.Work" .
cmm:HeatRateTest.acceptanceCriteriaDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acceptance criteria description"@en ;
    rdfs:comment "Textual description of the acceptance criteria applied to this test, including tolerance bands, correction factors, and contractual requirements. Provides context for the test acceptance flag."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "acceptance_criteria_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acceptance Criteria Description" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.ambientPressurePsia a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient pressure psia"@en ;
    rdfs:comment "Ambient barometric pressure in pounds per square inch absolute during the test. Affects air density and combustion turbine performance."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_pressure_psia" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Pressure (psia)" ;
    cmm:cimDatatype "Decimal" .
cmm:HeatRateTest.ambientTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature f"@en ;
    rdfs:comment "Ambient air temperature in degrees Fahrenheit during the test. Ambient conditions significantly affect gas turbine and combined cycle performance, so temperature correction factors are applied to normalize results."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_f" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature (°F)" ;
    cmm:cimDatatype "Decimal" .
cmm:HeatRateTest.auxiliaryLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auxiliary load mw"@en ;
    rdfs:comment "Station auxiliary electrical load in megawatts during the test period. Includes cooling water pumps, fans, fuel handling equipment, and other plant auxiliary systems."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "auxiliary_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auxiliary Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:HeatRateTest.correctedNetHeatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrected net heat rate btu per kwh"@en ;
    rdfs:comment "Net heat rate corrected to ISO base conditions (59°F, 14.7 psia, 60% RH) or other contractual reference conditions. Allows apples-to-apples comparison across tests conducted under different ambient conditions."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "corrected_net_heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrected Net Heat Rate (BTU/kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:HeatRateTest.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this heat rate test record was first created in the system. Audit trail for data lineage."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:HeatRateCurve.createdDateTime .
cmm:HeatRateTest.designNetHeatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "design net heat rate btu per kwh"@en ;
    rdfs:comment "The design or guaranteed net heat rate for the generating unit at the tested load level and ambient conditions, expressed in BTU/kWh. Used as the baseline for performance comparison."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "design_net_heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Design Net Heat Rate (BTU/kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:HeatRateTest.fuelConsumptionRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel consumption rate"@en ;
    rdfs:comment "Rate of fuel consumption during the test period. Units vary by fuel type (e.g., scf/hr for natural gas, lb/hr for coal, gallons/hr for oil). Used to calculate total heat input."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fuel_consumption_rate" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Consumption Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:HeatRateTest.fuelConsumptionUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel consumption unit"@en ;
    rdfs:comment "Unit of measure for the fuel consumption rate. Must align with the fuel type and HHV units for accurate heat rate calculation."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_consumption_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Consumption Unit" ;
    cmm:validValues "scf_per_hr|lb_per_hr|gallon_per_hr|mmbtu_per_hr|kg_per_hr" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.fuelHhvBtuPerUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel hhv btu per unit"@en ;
    rdfs:comment "Higher heating value of the fuel used during the test, expressed in BTU per unit (e.g., BTU/scf for natural gas, BTU/lb for coal). HHV is used in heat rate calculations to determine thermal efficiency."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fuel_hhv_btu_per_unit" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Higher Heating Value (HHV) (BTU per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:HeatRateTest.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "Type of fuel consumed during the heat rate test. Heat rate calculations require accurate fuel heating value and composition data specific to the fuel type."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:validValues "natural_gas|coal|nuclear|oil|biomass|waste_heat" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.grossOutputMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gross output mw"@en ;
    rdfs:comment "Gross electrical output of the generating unit during the test in megawatts, measured at the generator terminals before auxiliary load deduction."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gross_output_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Gross Output (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:HeatRateTest.heatRateDeviationPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate deviation percent"@en ;
    rdfs:comment "Percentage deviation of measured heat rate from design heat rate. Positive values indicate performance degradation (higher heat rate than design). Negative values indicate better-than-design performance. Calculated as ((measured - design) / design) * 100."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_rate_deviation_percent" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Rate Deviation Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HeatRateTest.isoRtoSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto submission date"@en ;
    rdfs:comment "Date on which the test results were submitted to the ISO or RTO. Null if not submitted."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "iso_rto_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ISO/RTO (Independent System Operator/Regional Transmission Organization) Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:HeatRateTest.isoRtoSubmissionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto submission flag"@en ;
    rdfs:comment "Indicates whether this test result was submitted to the ISO or RTO for capacity market accreditation or resource adequacy purposes. True if submitted, False if not."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "iso_rto_submission_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ISO/RTO (Independent System Operator/Regional Transmission Organization) Submission Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HeatRateTest.loadLevelPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load level percent"@en ;
    rdfs:comment "The load level at which the test was conducted, expressed as a percentage of the unit's rated net capacity. Heat rate varies with load level, so this context is critical for performance analysis."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_level_percent" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Level Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HeatRateTest.measuredNetHeatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measured net heat rate btu per kwh"@en ;
    rdfs:comment "The actual net heat rate measured during the test, expressed in British Thermal Units per kilowatt-hour. Lower values indicate better thermal efficiency. This is the primary performance metric for generating unit efficiency and is used for LCOE analysis and IRP modeling."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "measured_net_heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measured Net Heat Rate (BTU/kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:HeatRateTest.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Indicates whether this test was conducted to satisfy NERC MOD-025 generator verification requirements. True if conducted for NERC compliance, False otherwise."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HeatRateTest.netOutputMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net output mw"@en ;
    rdfs:comment "Net electrical output of the generating unit during the test in megawatts, measured at the point of interconnection after deducting station auxiliary load. This is the load level at which the heat rate was tested."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_output_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Output (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:HeatRateTest.relativeHumidityPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relative humidity percent"@en ;
    rdfs:comment "Relative humidity as a percentage during the test. Humidity affects combustion turbine performance and is used in correction factor calculations."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "relative_humidity_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relative Humidity Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HeatRateTest.scadaDataSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada data source"@en ;
    rdfs:comment "Identifier of the SCADA or DCS system from which real-time telemetry data was collected during the test. Typically references OSIsoft PI tags or ABB Ability Symphony Plus data points."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_data_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Data Source" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.testAcceptanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test acceptance flag"@en ;
    rdfs:comment "Indicates whether the test results met acceptance criteria. True if the measured heat rate was within contractual tolerance of design heat rate, False if performance was out of tolerance."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "test_acceptance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Acceptance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HeatRateTest.testDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test date"@en ;
    rdfs:comment "The date on which the heat rate test was conducted. Primary business event timestamp for the test."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Date" ;
    cmm:cimDatatype "Date" .
cmm:HeatRateTest.testDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test duration minutes"@en ;
    rdfs:comment "Total duration of the heat rate test in minutes. ASME PTC 46 typically requires minimum 2-4 hours of steady-state operation for valid heat rate tests."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "test_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:HeatRateTest.testEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test end timestamp"@en ;
    rdfs:comment "Precise timestamp when the heat rate test data collection concluded. Used to calculate test duration and validate steady-state conditions."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "test_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:HeatRateTest.testEngineerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test engineer name"@en ;
    rdfs:comment "Name of the lead engineer responsible for conducting and supervising the heat rate test. Provides accountability and contact for test methodology questions."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_engineer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Engineer Name" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.testNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test notes"@en ;
    rdfs:comment "Free-form notes documenting test conditions, anomalies, equipment issues, or other contextual information relevant to interpreting the test results."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:HeatRateTest.testNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test number"@en ;
    rdfs:comment "Business identifier for the heat rate test. Externally-known unique code used for tracking and reporting purposes."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:HeatRateTest.testReportDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test report document reference"@en ;
    rdfs:comment "Reference identifier for the formal test report document stored in the document management system. Links to detailed test methodology, data sheets, and analysis."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_report_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Report Document ID" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.testStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test start timestamp"@en ;
    rdfs:comment "Precise timestamp when the heat rate test data collection began. Used for correlating with SCADA telemetry and operational logs."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "test_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:HeatRateTest.testStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test status"@en ;
    rdfs:comment "Current lifecycle status of the heat rate test. Scheduled tests are planned but not started. In-progress tests are actively being conducted. Completed tests have finished data collection. Validated tests have passed quality review. Rejected tests failed validation criteria. Cancelled tests were aborted before completion."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Status" ;
    cmm:validValues "scheduled|in_progress|completed|validated|rejected|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:HeatRateCurve.status .
cmm:HeatRateTest.testType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test type"@en ;
    rdfs:comment "Classification of the heat rate test. Acceptance tests validate new or refurbished units against design specifications. Periodic tests are routine performance assessments. Diagnostic tests investigate performance degradation. Baseline tests establish reference performance. Warranty tests verify vendor guarantees. Performance verification tests support capacity market accreditation."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Test Type" ;
    cmm:validValues "acceptance|periodic|diagnostic|baseline|warranty|performance_verification" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:HeatRateCurve.kind .
cmm:HeatRateTest.testWitnessOrganization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test witness organization"@en ;
    rdfs:comment "Name of the independent third-party organization that witnessed the test, if applicable. Common for acceptance tests, warranty tests, and ISO/RTO capacity accreditation tests."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_witness_organization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Witness Organization" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.totalHeatInputMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total heat input mmbtu"@en ;
    rdfs:comment "Total heat input to the generating unit during the test period in million BTU. Calculated as fuel consumption rate multiplied by fuel HHV and test duration. Used as the numerator in heat rate calculation."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_heat_input_mmbtu" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Heat Input (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:HeatRateTest.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this heat rate test record was last modified. Audit trail for data lineage and change tracking."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:HeatRateTest.validatedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validated by"@en ;
    rdfs:comment "Name of the engineer or manager who validated and approved the test results. Provides accountability for data quality."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "validated_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validated By" ;
    cmm:cimDatatype "String" .
cmm:HeatRateTest.validationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation date"@en ;
    rdfs:comment "Date on which the test results were validated and approved. Null if validation is pending or rejected."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:date ;
    cmm:physicalColumn "validation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Date" ;
    cmm:cimDatatype "Date" .
cmm:HeatRateTest.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of the engineering validation review for the test results. Pending indicates awaiting review. Approved indicates results passed quality checks. Rejected indicates results failed validation. Under review indicates active engineering analysis."@en ;
    rdfs:domain cmm:HeatRateTest ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Status" ;
    cmm:validValues "pending|approved|rejected|under_review" ;
    cmm:cimDatatype "String" .

cmm:FuelInventory a owl:Class ;
    rdfs:label "Fuel Inventory"@en ;
    rdfs:comment "Current and historical fuel inventory positions and receipt transactions for thermal generation facilities. For inventory positions: tracks fuel type (natural gas, coal, nuclear fuel, oil, biomass), inventory quantity (tons, MMBtu, or fuel assemblies), storage location, minimum operating reserve level, days-of-supply, and unit cost ($/MMBtu). For receipt transactions: captures receipt date, quantity received, supplier name, contract reference, invoice number, as-received heat content (BTU/lb or BTU/SCF), sulfur content, moisture content, transportation mode, and unit cost. Supports fuel supply planning, O&M cost tracking, generation availability forecasting, EIA Form 923 reporting, and emissions calculations. SSOT for fuel stock position, receipt transactions, and fuel quality data at generation facilities."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:FossilFuel ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.fuel_management ;
    cmm:physicalTable "utility_cmm_silver.generation.fuel_inventory" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "EIA Form 923 Fuel Receipts / SAP MM Material Stock" ;
    cmm:sourceObject "energy_utilities_ecm.generation.fuel_inventory" ;
    owl:hasKey ( cmm:FuelInventory.fuelInventoryId ) .

cmm:FuelInventory.fuelInventoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel inventory id"@en ;
    rdfs:comment "Unique identifier for the fuel inventory record. Primary key for fuel inventory positions and receipt transactions at thermal generation facilities."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:long ;
    cmm:physicalColumn "fuel_inventory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Fuel Inventory ID" ;
    cmm:cimDatatype "Integer" .
cmm:FuelInventory.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Fuel inventory is charged to specific cost centers for expense allocation, fuel cost recovery filings, and inventory valuation. Standard in utility accounting."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_cost_center_id" ;
    cmm:cimAssociation "FossilFuel.Organisation" .
cmm:FuelInventory.fuelContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel contract"@en ;
    rdfs:comment "FK to generation.fuel_contract.fuel_contract_id — Fuel receipts (now merged into fuel_inventory) reference the supply contract under which fuel was delivered. fuel_contract_id is needed for contract compliance monitoring and cost allocation."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:FuelContract ;
    cmm:physicalColumn "fuel_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_fuel_contract_id" ;
    cmm:cimAssociation "FossilFuel.Agreement" .
cmm:FuelInventory.fuelPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel power plant"@en ;
    rdfs:comment "Identifier of the thermal generation facility where the fuel inventory is held. Links to the generation plant master data."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "fuel_power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Plant ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_fuel_power_plant_id" ;
    cmm:cimAssociation "FossilFuel.Plant" .
cmm:FuelInventory.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Identifier of the specific generation unit consuming or storing this fuel. Links to the generation unit master data."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_generating_unit_id" ;
    cmm:cimAssociation "FossilFuel.GeneratingUnit" .
cmm:FuelInventory.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Fuel inventory must post to specific GL accounts (FERC 151, 152) for monthly close, balance sheet reconciliation, and regulatory reporting."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_gl_account_id" ;
    cmm:cimAssociation "FossilFuel.ErpChartOfAccounts" .
cmm:FuelInventory.goodsReceipt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "goods receipt"@en ;
    rdfs:comment "Foreign key linking to supply.goods_receipt. Business justification: Fuel receipts create inventory records in fuel_inventory. Standard materials management flow requires linking inventory transactions to goods receipts for traceability, quality certification tracking,"@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:GoodsReceipt ;
    cmm:physicalColumn "goods_receipt_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Goods Receipt Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_goods_receipt_id" ;
    cmm:cimAssociation "FossilFuel.ErpReceiveDelivery" .
cmm:FuelInventory.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Fuel inventory items are materials with master data (specifications, procurement type, valuation class). Standard ERP integration where fuel_inventory extends material_master with generation-specific"@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_material_master_id" ;
    cmm:cimAssociation "FossilFuel.ErpItemMaster" .
cmm:FuelInventory.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — Fuel inventory is tracked at the plant/facility level (coal piles, gas storage, fuel oil tanks are plant-level assets). Without this FK, fuel positions cannot be associated with the plant they supply."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_power_plant_id" ;
    cmm:cimAssociation "FossilFuel.Plant" .
cmm:FuelInventory.primaryPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary power plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — Fuel inventory is tracked at the plant/facility level (coal piles, gas interconnects, oil tanks are plant-level assets). power_plant_id is required on fuel_inventory for fuel supply planning and gener"@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "primary_power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_primary_power_plant_id" ;
    cmm:cimAssociation "FossilFuel.Plant" .
cmm:FuelInventory.warehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Fuel stored in specific warehouse locations (coal yards, oil tanks, gas storage). Physical inventory management requires linking fuel records to warehouse for stock tracking, cycle counts, and days-of"@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Warehouse Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_fuel_inventory_warehouse_id" ;
    cmm:cimAssociation "FossilFuel.WorkLocation" .
cmm:FuelInventory.adjustmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment reason"@en ;
    rdfs:comment "Explanation for inventory adjustments or corrections. Examples include physical inventory count variance, measurement error correction, fuel quality degradation, evaporation loss, or system reconciliation. Required for SOX audit trail and internal controls."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inventory Adjustment Reason" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.carbonContentPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "carbon content percent"@en ;
    rdfs:comment "Carbon content of the fuel as a percentage by weight. Used to calculate carbon dioxide (CO2) emissions for EPA greenhouse gas reporting, carbon pricing programs, and Renewable Portfolio Standard (RPS) compliance. Higher carbon content increases CO2 emissions per unit of energy."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "carbon_content_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Content (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:FuelInventory.chlorineContentPpm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "chlorine content ppm"@en ;
    rdfs:comment "Chlorine content of the fuel measured in parts per million (ppm). Contributes to boiler corrosion and hydrochloric acid (HCl) emissions. Monitored for EPA air toxics compliance and boiler materials integrity management."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "chlorine_content_ppm" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Chlorine Content (Parts Per Million)" ;
    cmm:cimDatatype "Decimal" .
cmm:FuelInventory.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Free-text comments or notes regarding this fuel inventory record. Captures operational context, special handling instructions, quality issues, delivery exceptions, or other relevant information for fuel management and audit purposes."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inventory Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:FuelInventory.contractReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract reference"@en ;
    rdfs:comment "Reference number or identifier of the fuel supply contract or Power Purchase Agreement (PPA) governing this receipt. Links fuel deliveries to contractual terms, pricing agreements, and procurement commitments. Business-confidential contract data."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Contract Reference Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this fuel inventory record was first created in the system. Supports data lineage, audit trail, and SOX compliance for financial controls. Distinct from inventory date or receipt timestamp which represent business event times."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FossilFuel.createdDateTime .
cmm:FuelInventory.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Indicator of data quality status for this fuel inventory record. Verified indicates quality-assured data, estimated for calculated or interpolated values, pending verification for preliminary data awaiting confirmation, failed validation for records with quality issues requiring correction."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "verified|estimated|pending_verification|failed_validation" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.daysOfSupply a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "days of supply"@en ;
    rdfs:comment "Calculated number of days the current fuel inventory can support generation operations at average burn rate. Critical metric for fuel supply planning, generation availability forecasting, and risk management during supply disruptions."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "days_of_supply" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Days of Supply" ;
    cmm:cimDatatype "Decimal" .
cmm:FuelInventory.eiaPlantCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eia plant code"@en ;
    rdfs:comment "Federal Energy Information Administration (EIA) unique plant identifier. Required for EIA Form 923 monthly fuel receipt and cost reporting. Links internal fuel inventory data to federal regulatory reporting requirements."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "eia_plant_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Information Administration (EIA) Plant Code" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "Federal Energy Regulatory Commission (FERC) Uniform System of Accounts code for fuel inventory accounting. Typically account 151 for fuel stock. Required for FERC Form 1 financial reporting and rate case filings."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.fixedCarbonPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fixed carbon percent"@en ;
    rdfs:comment "Fixed carbon content of coal as a percentage by weight. Represents the solid combustible residue after volatile matter is driven off. Higher fixed carbon indicates higher energy content and coal rank. Critical for coal quality classification and heat rate calculations."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fixed_carbon_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fixed Carbon (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:FuelInventory.inventoryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inventory date"@en ;
    rdfs:comment "Date of the inventory position snapshot or receipt transaction. For positions, represents the as-of date for stock levels. For receipts, represents the date fuel was received at the facility."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:date ;
    cmm:physicalColumn "inventory_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inventory Date" ;
    cmm:cimDatatype "Date" .
cmm:FuelInventory.inventoryStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inventory status"@en ;
    rdfs:comment "Current status of the fuel inventory. Available for generation use, reserved for specific unit commitment, in transit from supplier, quarantined pending quality verification, or consumed (historical record). Supports inventory allocation and generation scheduling."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "inventory_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inventory Status" ;
    cmm:validValues "available|reserved|in_transit|quarantined|consumed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FossilFuel.status .
cmm:FuelInventory.invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice number"@en ;
    rdfs:comment "Supplier invoice number for the fuel receipt transaction. Links fuel deliveries to accounts payable, supports invoice reconciliation, and provides audit trail for financial controls per Sarbanes-Oxley Act (SOX) requirements."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Supplier Invoice Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FuelInventory.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this fuel inventory record was last modified. Tracks data changes for audit purposes, supports change data capture for downstream analytics, and provides data freshness indicator for operational dashboards."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FuelInventory.mercuryContentPpm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mercury content ppm"@en ;
    rdfs:comment "Mercury content of coal fuel measured in parts per million (ppm). Required for EPA Mercury and Air Toxics Standards (MATS) compliance. High mercury content requires additional emissions controls such as activated carbon injection or scrubber upgrades."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mercury_content_ppm" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mercury Content (Parts Per Million)" ;
    cmm:cimDatatype "Decimal" .
cmm:FuelInventory.minimumOperatingReserve a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum operating reserve"@en ;
    rdfs:comment "Minimum fuel quantity required to maintain safe and reliable plant operations. Expressed in same unit of measure as quantity. Used for fuel supply planning and procurement trigger points to ensure generation availability."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_operating_reserve" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Operating Reserve Level" ;
    cmm:cimDatatype "Decimal" .
cmm:FuelInventory.nitrogenContentPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nitrogen content percent"@en ;
    rdfs:comment "Nitrogen content of the fuel as a percentage by weight. Affects nitrogen oxide (NOx) emissions formation during combustion. Critical for EPA air quality compliance, NOx emissions calculations, and selective catalytic reduction (SCR) system design."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nitrogen_content_percent" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nitrogen Content (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:FuelInventory.originLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "origin location"@en ;
    rdfs:comment "Geographic origin or source location of the fuel. Examples include coal mine name and state, natural gas production basin, nuclear fuel fabrication facility, or biomass harvest region. Supports supply chain tracking and sourcing analysis."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "origin_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Origin Location" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.qualityCertificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quality certification number"@en ;
    rdfs:comment "Certificate or lab analysis number documenting fuel quality test results. Links to third-party laboratory reports for heat content, sulfur, moisture, and ash analysis. Provides audit trail for fuel quality assurance and contract compliance."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "quality_certification_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Quality Certification Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FuelInventory.quantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Quantity of fuel in inventory or received. Measured in tons for coal and biomass, Million British Thermal Units (MMBtu) for natural gas and oil, or fuel assemblies for nuclear fuel. Precision supports accurate fuel accounting and EIA reporting."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:FuelInventory.receiptTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "receipt timestamp"@en ;
    rdfs:comment "Precise date and time when fuel was received at the generation facility. Captured from weigh station, pipeline meter, or receiving dock systems. Supports just-in-time inventory management and delivery performance tracking."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "receipt_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Receipt Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FuelInventory.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifier of the operational system that originated this fuel inventory record. Examples include SAP Materials Management (MM), OSIsoft PI historian, plant fuel management system, or manual entry. Supports data lineage and system-of-record tracking."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Identifier" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.supplierName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "supplier name"@en ;
    rdfs:comment "Name of the fuel supplier or vendor for receipt transactions. Tracks fuel procurement sources for contract management, supplier performance evaluation, and supply chain risk assessment. Business-confidential supplier relationship data."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "supplier_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Supplier Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.totalCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total cost"@en ;
    rdfs:comment "Total cost of the fuel inventory position or receipt transaction in US dollars. Calculated as quantity multiplied by unit cost, adjusted for energy content. Used for financial reporting, Capital Expenditure (CAPEX) and Operational Expenditure (OPEX) tracking, and regulatory rate case filings."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FuelInventory.transactionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction type"@en ;
    rdfs:comment "Type of fuel inventory transaction. Position represents current stock level, receipt captures incoming fuel deliveries, consumption tracks fuel burned for generation, adjustment handles inventory corrections, and transfer records inter-facility movements."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Type" ;
    cmm:validValues "position|receipt|consumption|adjustment|transfer" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.transportationMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transportation mode"@en ;
    rdfs:comment "Method of fuel transportation for receipt transactions. Rail for coal unit trains, truck for short-haul deliveries, pipeline for natural gas, barge for waterway transport, or ship for international coal imports. Affects delivery costs and supply chain logistics."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "transportation_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transportation Mode" ;
    cmm:validValues "rail|truck|pipeline|barge|ship" ;
    cmm:cimDatatype "String" .
cmm:FuelInventory.unitCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit cost"@en ;
    rdfs:comment "Cost per unit of fuel expressed in dollars per Million British Thermal Units ($/MMBtu). Supports Operations and Maintenance (O&M) cost tracking, Levelized Cost of Energy (LCOE) analysis, and generation dispatch economics. Business-confidential pricing data."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_cost" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Cost ($/MMBtu)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FuelInventory.volatileMatterPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volatile matter percent"@en ;
    rdfs:comment "Volatile matter content of coal as a percentage by weight. Indicates the portion of coal that vaporizes when heated. Affects ignition characteristics, flame stability, and combustion efficiency. Higher volatile matter improves combustion but may increase emissions."@en ;
    rdfs:domain cmm:FuelInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "volatile_matter_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volatile Matter (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .

cmm:EmissionsReading a owl:Class ;
    rdfs:label "Emissions Reading"@en ;
    rdfs:comment "Continuous Emissions Monitoring System (CEMS) data and emissions allowance registry records for generating units subject to environmental compliance programs. For CEMS data: captures measurement timestamp, pollutant type (SO2, NOx, CO2, Hg, PM), measured emission rate (lbs/MMBtu or lbs/hr), gross load, operating hour flag, CEMS monitor status, substitute data flag, and QA/QC certification status. For allowances: captures allowance type, vintage year, quantity (tons), program (EPA ARP, RGGI, California Cap-and-Trade), acquisition date/cost, account balance, and transfer history. Required for EPA Part 75 compliance, cap-and-trade program compliance, and carbon cost accounting. SSOT for generation emissions monitoring and allowance management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:EmissionAccount ;
    cmm:cimCloseMatch cim:EmissionAccount ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.fuel_management ;
    cmm:physicalTable "utility_cmm_silver.generation.emissions_reading" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EPA 40 CFR Part 75 (CEMS); EPA 40 CFR Part 75 CEMS / Clean Air Act Title IV" ;
    cmm:sourceObject "energy_utilities_ecm.generation.emissions_reading" ;
    owl:hasKey ( cmm:EmissionsReading.emissionsReadingId ) .

cmm:EmissionsReading.emissionsReadingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions reading id"@en ;
    rdfs:comment "Unique identifier for the emissions reading record. Primary key for the emissions_reading product."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "emissions_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Emissions Reading ID" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReading.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Emissions reporting often aggregates by control area for regional air quality compliance (e.g., RGGI, CAIR). Required for EPA and state environmental reporting."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_control_area_id" ;
    cmm:cimAssociation "EmissionAccount.ControlArea" .
cmm:EmissionsReading.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Emissions compliance costs (allowances, penalties, monitoring) are allocated to cost centers for environmental cost tracking and rate recovery filings."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_cost_center_id" ;
    cmm:cimAssociation "EmissionAccount.Organisation" .
cmm:EmissionsReading.emissionsGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emissions generating unit"@en ;
    rdfs:comment "Foreign key reference to the generating unit that produced this emissions reading. Links to the generation asset registry."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "emissions_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_emissions_generating_unit_id" ;
    cmm:cimAssociation "EmissionAccount.GeneratingUnit" .
cmm:EmissionsReading.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — CEMS monitors are installed on specific generating units (stacks). Without this FK, emissions data cannot be attributed to the unit that produced them, breaking EPA Part 75 compliance reporting."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_generating_unit_id" ;
    cmm:cimAssociation "EmissionAccount.GeneratingUnit" .
cmm:EmissionsReading.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each emissions measurement ties to specific regulatory obligations (Clean Air Act, state SIPs, emissions trading programs) for compliance demonstration, allowance tracking, and violation detection. Cr"@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_obligation_id" ;
    cmm:cimAssociation "EmissionAccount.Document" .
cmm:EmissionsReading.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key reference to the generation facility where this emissions reading was recorded. A facility may contain multiple generating units."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_power_plant_id" ;
    cmm:cimAssociation "EmissionAccount.Plant" .
cmm:EmissionsReading.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — CEMS data is monitored per generating unit (each unit has its own CEMS stack). generating_unit_id is required for EPA Part 75 compliance reporting which is unit-level."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_emissions_reading_primary_generating_unit_id" ;
    cmm:cimAssociation "EmissionAccount.GeneratingUnit" .
cmm:EmissionsReading.allowanceDeductionRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowance deduction required"@en ;
    rdfs:comment "Boolean flag indicating whether emissions allowances must be surrendered for this reading under cap-and-trade compliance programs. True if allowance deduction is required, False if not required or if the unit is exempt."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "allowance_deduction_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowance Deduction Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmissionsReading.allowanceQuantityDeducted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowance quantity deducted"@en ;
    rdfs:comment "The quantity of emissions allowances (in tons) deducted from the facility's allowance account to cover the emissions recorded in this reading. Only populated for cap-and-trade compliance programs."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allowance_quantity_deducted" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowance Quantity Deducted" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.allowanceVintageYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowance vintage year"@en ;
    rdfs:comment "The vintage year of the emissions allowances used to cover this reading. Allowances are typically issued for specific compliance years and may be banked or borrowed across years subject to program rules."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "allowance_vintage_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowance Vintage Year" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReading.ambientTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature f"@en ;
    rdfs:comment "The ambient air temperature in degrees Fahrenheit at the time of the emissions measurement. Used for temperature correction factors in emissions calculations."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_f" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature (Fahrenheit)" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.barometricPressureInhg a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "barometric pressure inhg"@en ;
    rdfs:comment "The barometric pressure in inches of mercury (inHg) at the time of the emissions measurement. Used for pressure correction factors in emissions calculations."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "barometric_pressure_inhg" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Barometric Pressure (Inches of Mercury)" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.carbonCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "carbon cost usd"@en ;
    rdfs:comment "The calculated carbon cost in US dollars associated with this emissions reading, based on allowance market prices or internal carbon pricing. Used for carbon cost accounting and financial planning."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "carbon_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:EmissionsReading.cemsMonitorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cems monitor code"@en ;
    rdfs:comment "The unique identifier for the specific CEMS monitor that recorded this reading. Links to the physical monitoring equipment installed on the generating unit."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "cems_monitor_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CEMS (Continuous Emissions Monitoring System) Monitor ID" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.complianceProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance program"@en ;
    rdfs:comment "The environmental compliance program under which this emissions reading is reported. EPA_ARP (Acid Rain Program), RGGI (Regional Greenhouse Gas Initiative), California_Cap_and_Trade, CSAPR (Cross-State Air Pollution Rule), MATS (Mercury and Air Toxics Standards), State_SIP (State Implementation Plan)."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Program" ;
    cmm:validValues "EPA_ARP|RGGI|California_Cap_and_Trade|CSAPR|MATS|State_SIP" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.dataQualityIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality indicator"@en ;
    rdfs:comment "Overall data quality indicator for this emissions reading based on QA/QC test results and validation rules. Passed indicates the reading meets all quality standards, failed indicates quality issues, not_available indicates quality assessment is incomplete, conditionally_valid indicates the reading is usable subject to documented conditions."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Indicator" ;
    cmm:validValues "passed|failed|not_available|conditionally_valid" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "The name of the source system that provided this emissions reading data. Typically ABB Ability Symphony Plus DCS, OSIsoft PI Historian, or direct CEMS data acquisition system."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.emissionRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emission rate"@en ;
    rdfs:comment "The measured emission rate for the pollutant. Units depend on pollutant type and are specified in emission_rate_unit field."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emission_rate" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emission Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.emissionRateUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emission rate unit"@en ;
    rdfs:comment "The unit of measure for the emission rate. Common units include lbs/MMBtu (pounds per million British thermal units), lbs/hr (pounds per hour), tons/hr, kg/MWh (kilograms per megawatt-hour), g/kWh (grams per kilowatt-hour)."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "emission_rate_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emission Rate Unit of Measure (UOM)" ;
    cmm:validValues "lbs/MMBtu|lbs/hr|tons/hr|kg/MWh|g/kWh" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.epaSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "epa submission date"@en ;
    rdfs:comment "The date when this emissions reading was submitted to the EPA through ECMPS. Only populated when submitted_to_epa_flag is True."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:date ;
    cmm:physicalColumn "epa_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "EPA Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:EmissionsReading.flowRateScfh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flow rate scfh"@en ;
    rdfs:comment "The volumetric flow rate of exhaust gas in standard cubic feet per hour (SCFH) at the time of the emissions measurement. Used for total mass emissions calculations."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "flow_rate_scfh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Flow Rate (SCFH - Standard Cubic Feet per Hour)" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "The primary fuel type being consumed by the generating unit during this emissions measurement. Used for emissions factor calculations and compliance program categorization. Reference-value candidates: coal|natural_gas|oil|biomass|nuclear|hydro|wind|solar."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.grossLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gross load mw"@en ;
    rdfs:comment "The gross electrical load output of the generating unit in megawatts (MW) at the time of the emissions measurement. Used for emissions rate calculations and compliance verification."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gross_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Gross Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmissionsReading.heatInputMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat input mmbtu"@en ;
    rdfs:comment "The total heat input to the generating unit in millions of British thermal units (MMBtu) during the measurement period. Used for emissions rate calculations and fuel consumption analysis."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_input_mmbtu" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Input (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:EmissionsReading.measurementTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement timestamp"@en ;
    rdfs:comment "The precise date and time when the emissions measurement was recorded by the CEMS (Continuous Emissions Monitoring System). This is the principal business event timestamp for the reading."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "measurement_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmissionsReading.moistureContentPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "moisture content percent"@en ;
    rdfs:comment "The moisture content percentage in the exhaust gas stream at the time of the emissions measurement. Used for dry-basis emissions rate calculations."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "moisture_content_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Moisture Content Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmissionsReading.monitorStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monitor status"@en ;
    rdfs:comment "The operational status of the CEMS monitor at the time of the reading. Operational indicates normal functioning, calibration indicates the monitor was being calibrated, maintenance indicates scheduled maintenance, failed indicates equipment failure, out_of_service indicates the monitor was not in service."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "monitor_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monitor Status" ;
    cmm:validValues "operational|calibration|maintenance|failed|out_of_service" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.operatingHourFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating hour flag"@en ;
    rdfs:comment "Boolean flag indicating whether the generating unit was in operation during this measurement hour. True if operating, False if not operating. Used for compliance hour calculations."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operating_hour_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Hour Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmissionsReading.operatingMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating mode"@en ;
    rdfs:comment "The operating mode of the generating unit at the time of the emissions measurement. Baseload indicates continuous operation, cycling indicates variable operation, peaking indicates high-demand operation, startup/shutdown indicate transitional states, standby indicates ready but not generating."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "operating_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Mode" ;
    cmm:validValues "baseload|cycling|peaking|startup|shutdown|standby" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.orisplCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "orispl code"@en ;
    rdfs:comment "The unique EPA-assigned ORISPL code identifying the power plant facility. This is the standard identifier used in all EPA emissions reporting systems."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "orispl_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ORISPL (Office of Regulatory Information Systems Plant Location) Code" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.oxygenConcentrationPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oxygen concentration percent"@en ;
    rdfs:comment "The oxygen concentration percentage in the exhaust gas stream at the time of the emissions measurement. Used for combustion efficiency calculations and emissions rate corrections."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "oxygen_concentration_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Oxygen Concentration Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:EmissionsReading.pollutantType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pollutant type"@en ;
    rdfs:comment "The type of pollutant measured in this reading. SO2 (Sulfur Dioxide), NOx (Nitrogen Oxides), CO2 (Carbon Dioxide), Hg (Mercury), PM (Particulate Matter), CO (Carbon Monoxide)."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "pollutant_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pollutant Type" ;
    cmm:validValues "SO2|NOx|CO2|Hg|PM|CO" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.qaCertificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qa certification status"@en ;
    rdfs:comment "The quality assurance and quality control (QA/QC) certification status of this emissions reading. Certified indicates the reading passed all QA/QC tests, provisional indicates temporary certification pending full testing, conditionally_valid indicates the reading is valid subject to conditions, invalid indicates the reading failed QA/QC, pending_certification indicates certification testing is in progress."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "qa_certification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quality Assurance (QA) Certification Status" ;
    cmm:validValues "certified|provisional|conditionally_valid|invalid|pending_certification" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.qaTestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qa test date"@en ;
    rdfs:comment "The date when the most recent QA/QC certification test was performed on the CEMS monitor that recorded this reading. Used to verify data quality and compliance with EPA testing requirements."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:date ;
    cmm:physicalColumn "qa_test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quality Assurance (QA) Test Date" ;
    cmm:cimDatatype "Date" .
cmm:EmissionsReading.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "The timestamp when this emissions reading record was first created in the system. Used for data lineage and audit trail purposes."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmissionsReading.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "The timestamp when this emissions reading record was last updated in the system. Used for data lineage and audit trail purposes."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmissionsReading.reportingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting period"@en ;
    rdfs:comment "The time period granularity for which this emissions reading is aggregated and reported to regulatory agencies. Hourly is the most granular level required by EPA Part 75."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Period" ;
    cmm:validValues "hourly|daily|monthly|quarterly|annual" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.reportingQuarter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting quarter"@en ;
    rdfs:comment "The calendar quarter (1-4) in which this emissions reading occurred. Used for quarterly compliance reporting aggregation."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "reporting_quarter" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Quarter" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReading.reportingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting year"@en ;
    rdfs:comment "The calendar year in which this emissions reading occurred. Used for annual compliance reporting and allowance reconciliation."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "reporting_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Year" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReading.stackCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stack code"@en ;
    rdfs:comment "The unique identifier for the exhaust stack or flue where the CEMS monitor is installed and from which emissions are measured. A single stack may serve multiple generating units."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "stack_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stack ID" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.submittedToEpaFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "submitted to epa flag"@en ;
    rdfs:comment "Boolean flag indicating whether this emissions reading has been submitted to the EPA through the Emissions Collection and Monitoring Plan System (ECMPS). True if submitted, False if not yet submitted."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "submitted_to_epa_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Submitted to EPA Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmissionsReading.substituteDataFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substitute data flag"@en ;
    rdfs:comment "Boolean flag indicating whether this reading is substitute data rather than actual measured data. True if substitute data was used due to monitor downtime or failure, False if actual measured data. Substitute data is calculated using EPA-approved methodologies."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "substitute_data_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substitute Data Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmissionsReading.substituteDataMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substitute data method"@en ;
    rdfs:comment "The EPA-approved methodology used to calculate substitute data when actual CEMS measurements are unavailable. Only populated when substitute_data_flag is True."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "substitute_data_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substitute Data Method" ;
    cmm:validValues "maximum_potential_concentration|maximum_potential_flow_rate|fuel_sampling|default_high_range|missing_data_procedure" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.totalMassEmissions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total mass emissions"@en ;
    rdfs:comment "The total mass of pollutant emitted during the measurement period, calculated from emission rate and operating time. Units are typically pounds (lbs) or tons depending on pollutant type and reporting requirements."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_mass_emissions" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Mass Emissions" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReading.totalMassEmissionsUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total mass emissions unit"@en ;
    rdfs:comment "The unit of measure for total mass emissions. Common units include lbs (pounds), tons (short tons), kg (kilograms), metric_tons."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "total_mass_emissions_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Mass Emissions Unit of Measure (UOM)" ;
    cmm:validValues "lbs|tons|kg|metric_tons" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReading.unitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit type"@en ;
    rdfs:comment "The type of generating unit technology that produced this emissions reading. Used for emissions factor selection and compliance program applicability determination."@en ;
    rdfs:domain cmm:EmissionsReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Type" ;
    cmm:validValues "boiler|combustion_turbine|combined_cycle|reciprocating_engine|fuel_cell" ;
    cmm:cimDatatype "String" .

cmm:GenerationOutageEvent a owl:Class ;
    rdfs:label "Generation Outage Event"@en ;
    rdfs:comment "Records of planned and unplanned generation outage events at the unit level. Captures outage start and end timestamps, outage type (forced, planned, maintenance, derating), capacity lost (MW), cause code (NERC GADS cause code), equipment component affected, responsible crew, estimated return-to-service date, actual return-to-service date, and NERC GADS reporting flag. Feeds NERC GADS submissions, generation availability analysis (EAF, EFOR), and IRP capacity planning. SSOT for generation unit outage history."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Outage ;
    cmm:cimCloseMatch cim:Outage ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.outage_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC GADS; NERC GADS (Generating Availability Data System) / IEEE 762" ;
    cmm:sourceObject "energy_utilities_ecm.generation.outage_event" ;
    owl:hasKey ( cmm:GenerationOutageEvent.outageEventId ) .

cmm:GenerationOutageEvent.outageEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage event id"@en ;
    rdfs:comment "Unique identifier for the generation outage event record. Primary key for the generation outage event entity."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Generation Outage Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:GenerationOutageEvent.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Major outages often tie to capital projects (turbine overhauls, emissions upgrades). Critical for capitalization decisions, AFUDC calculations, and distinguishing capital vs expense."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_capex_project_id" ;
    cmm:cimAssociation "Outage.Project" .
cmm:GenerationOutageEvent.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Forced outages are modeled as N-1 contingencies in reliability analysis. Required for NERC TPL standards and real-time contingency analysis."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_contingency_id" ;
    cmm:cimAssociation "Outage.Contingency" .
cmm:GenerationOutageEvent.contingencyViolation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency violation"@en ;
    rdfs:comment "Foreign key linking to grid.contingency_violation. Business justification: Generation outages cause contingency violations (loss of largest unit). Required for NERC TPL standards and operating reserve adequacy assessment."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:ContingencyViolation ;
    cmm:physicalColumn "contingency_violation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Violation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_contingency_violation_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:GenerationOutageEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Outages impact control area reserve margins and must be reported to balancing authority for resource adequacy assessment and contingency reserve deployment."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_control_area_id" ;
    cmm:cimAssociation "Outage.ControlArea" .
cmm:GenerationOutageEvent.correctiveActionPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Identifier of the corrective action plan developed to prevent recurrence of similar outages. Links to the quality management or asset management system. Null if no corrective action plan is required."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Corrective Action Plan ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_corrective_action_plan_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:GenerationOutageEvent.emergencyPurchaseOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency purchase order"@en ;
    rdfs:comment "Foreign key linking to supply.purchase_order. Business justification: Forced outages trigger expedited material purchases (replacement parts, contractor services). Outage cost tracking requires linking to emergency POs for financial reconciliation and NERC GADS reportin"@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:PurchaseOrder ;
    cmm:physicalColumn "emergency_purchase_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Purchase Order Id (Foreign Key)" ;
    cmm:sourceColumn "purchase_order_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_emergency_purchase_order_id" ;
    cmm:cimAssociation "Outage.ErpPurchaseOrder" .
cmm:GenerationOutageEvent.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Major forced outages trigger emergency stock mobilization (mutual aid, expedited procurement). Storm restoration and NERC event reporting require linking outage events to emergency stock events for co"@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_emergency_stock_event_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:GenerationOutageEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Generation outages trigger EMS alarms for operator notification. Required for real-time situational awareness and reserve deployment."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_ems_alarm_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:GenerationOutageEvent.energySchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy schedule"@en ;
    rdfs:comment "Foreign key linking to trading.energy_schedule. Business justification: Forced outages trigger schedule curtailments and re-tagging. Critical operational workflow linking outage notifications to schedule adjustments and ISO curtailment instructions."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:EnergySchedule ;
    cmm:physicalColumn "energy_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_energy_schedule_id" ;
    cmm:cimAssociation "Outage.EnergyTransaction" .
cmm:GenerationOutageEvent.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every outage event occurs on a specific generating unit. Without this FK, outage records cannot be linked to units, breaking NERC GADS reporting and availability analysis (EAF, EFOR)."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_generating_unit_id" ;
    cmm:cimAssociation "Outage.GeneratingUnit" .
cmm:GenerationOutageEvent.goodsIssue a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "goods issue"@en ;
    rdfs:comment "Foreign key linking to supply.goods_issue. Business justification: Materials issued from inventory for outage repairs are documented via goods issues. Work order material tracking requires linking outage events to goods issues for cost accounting and inventory reconc"@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GoodsIssue ;
    cmm:physicalColumn "goods_issue_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Goods Issue Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_goods_issue_id" ;
    cmm:cimAssociation "Outage.ErpIssueInventory" .
cmm:GenerationOutageEvent.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: Forced generation outages can trigger or constitute NERC reportable reliability events (EOP-004). Required for NERC OE-417 reporting and root cause analysis."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_grid_reliability_event_id" ;
    cmm:cimAssociation "Outage.PSREvent" .
cmm:GenerationOutageEvent.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Planned outages require switching orders for isolation. Required for outage coordination and safe work clearance."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_grid_switching_order_id" ;
    cmm:cimAssociation "Outage.SwitchingPlan" .
cmm:GenerationOutageEvent.operatorLog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator log"@en ;
    rdfs:comment "Foreign key linking to grid.operator_log. Business justification: Generation outages are logged by operators for real-time situational awareness and NERC reporting. Required for EOP-004 and shift handoff documentation."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:OperatorLog ;
    cmm:physicalColumn "operator_log_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Log Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_operator_log_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:GenerationOutageEvent.outageGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage generating unit"@en ;
    rdfs:comment "Identifier of the generation unit (turbine, boiler, generator set) affected by the outage event. Links to the generation unit asset registry."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "outage_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_outage_generating_unit_id" ;
    cmm:cimAssociation "Outage.GeneratingUnit" .
cmm:GenerationOutageEvent.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Identifier of the generation plant or facility where the outage occurred. Links to the plant asset registry."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_power_plant_id" ;
    cmm:cimAssociation "Outage.Plant" .
cmm:GenerationOutageEvent.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Outage events occur at the generating unit level. generating_unit_id is required for NERC GADS reporting, capacity planning, and EFOR calculations."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_primary_generating_unit_id" ;
    cmm:cimAssociation "Outage.GeneratingUnit" .
cmm:GenerationOutageEvent.primaryOutageEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary outage employee"@en ;
    rdfs:comment "User identifier of the person or system that created the outage event record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_outage_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_primary_outage_employee_id" ;
    cmm:cimAssociation "Outage.ErpPersonnel" .
cmm:GenerationOutageEvent.protectionEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "protection event"@en ;
    rdfs:comment "Foreign key linking to grid.protection_event. Business justification: Generation outages often result from protection relay operations. Required for NERC PRC-004 compliance and root cause determination."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:ProtectionEvent ;
    cmm:physicalColumn "protection_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Protection Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_protection_event_id" ;
    cmm:cimAssociation "Outage.PSREvent" .
cmm:GenerationOutageEvent.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Major outages require regulatory notification per NERC EOP standards and state PUC reporting requirements. Essential for reliability reporting, prudence demonstration in rate cases, and regulatory com"@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_regulatory_filing_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:GenerationOutageEvent.responsibleCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible crew"@en ;
    rdfs:comment "Identifier of the maintenance crew or team responsible for outage work and unit restoration. Links to workforce management system."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "responsible_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Crew ID" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_responsible_crew_id" ;
    cmm:cimAssociation "Outage.Crew" .
cmm:GenerationOutageEvent.transmissionOutage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission outage"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_outage. Business justification: Generation outages often cause or correlate with transmission outages (equipment failures, protection system operations, cascading events). NERC reliability coordination and root cause analysis requir"@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:TransmissionOutage ;
    cmm:physicalColumn "transmission_outage_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Transmission Outage Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_transmission_outage_id" ;
    cmm:cimAssociation "Outage.Outage" .
cmm:GenerationOutageEvent.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the maintenance work order associated with the outage event. Links to the asset management work order system for tracking repair activities, labor, and materials."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_outage_event_work_order_id" ;
    cmm:cimAssociation "Outage.Work" .
cmm:GenerationOutageEvent.capacityLostMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity lost mw"@en ;
    rdfs:comment "Amount of generation capacity (in Megawatts) unavailable due to the outage. For full outages, this equals the unit nameplate capacity. For deratings, this is the reduction amount. Critical for NERC GADS EAF and EFOR calculations."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_lost_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Lost (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationOutageEvent.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Detailed narrative description of the outage root cause, failure mode, and contributing factors. Supplements the NERC GADS cause code with plant-specific context."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cause Description" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the outage event record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Outage.createdDateTime .
cmm:GenerationOutageEvent.environmentalIncidentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental incident flag"@en ;
    rdfs:comment "Indicates whether the outage resulted in or was caused by an environmental incident (emissions exceedance, spill, discharge violation). True if environmental incident occurred. False otherwise. Triggers EPA reporting workflow."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "environmental_incident_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Incident Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.equipmentComponentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment component code"@en ;
    rdfs:comment "Code identifying the specific equipment component or system that failed or required maintenance. Examples: turbine blade, boiler tube, generator exciter, condenser, cooling tower. Aligns with plant equipment hierarchy."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_component_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Component Code" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.equipmentComponentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment component description"@en ;
    rdfs:comment "Detailed description of the equipment component affected by the outage, including location within the unit and technical specifications."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_component_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Component Description" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.estimatedRepairCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated repair cost usd"@en ;
    rdfs:comment "Estimated cost in US Dollars for outage-related repairs, parts replacement, and labor. Includes direct maintenance costs but excludes revenue loss. Used for O&M budget tracking."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_repair_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Repair Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:GenerationOutageEvent.estimatedReturnToServiceTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated return to service timestamp"@en ;
    rdfs:comment "Projected date and time when the unit is expected to return to service. Updated as outage work progresses. Used for generation scheduling and market commitment planning."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_return_to_service_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Return to Service Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GenerationOutageEvent.estimatedRevenueLossUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated revenue loss usd"@en ;
    rdfs:comment "Estimated revenue loss in US Dollars due to the outage, calculated based on lost generation capacity, market prices, and outage duration. Used for financial impact analysis and IRP planning."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_revenue_loss_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Revenue Loss (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:GenerationOutageEvent.forcedOutageRateImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forced outage rate impact flag"@en ;
    rdfs:comment "Indicates whether this outage event impacts the unit Equivalent Forced Outage Rate (EFOR) calculation. True for forced outages and unplanned deratings. False for planned maintenance."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "forced_outage_rate_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forced Outage Rate Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "Primary fuel type of the generation unit affected by the outage. Used for fuel-specific outage analysis and generation fleet planning. Reference-value candidates: coal|natural_gas|nuclear|hydro|wind|solar|biomass|oil."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.gridImpactSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid impact severity"@en ;
    rdfs:comment "Assessment of the outage impact on grid reliability and system operations. Critical: caused or contributed to grid emergency. Major: significant capacity loss during peak demand. Moderate: noticeable but manageable. Minor: minimal impact. None: no grid impact."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "grid_impact_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grid Impact Severity" ;
    cmm:validValues "none|minor|moderate|major|critical" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the outage event record was last updated. Used for audit trail and change tracking. Updated whenever any attribute is modified."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GenerationOutageEvent.marketCommitmentImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market commitment impact flag"@en ;
    rdfs:comment "Indicates whether the outage caused the unit to fail to meet day-ahead or real-time market commitments. True if the outage resulted in market penalties or buy-back costs. False if no market impact."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "market_commitment_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Commitment Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.nercGadsCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc gads cause code"@en ;
    rdfs:comment "Standardized NERC GADS cause code identifying the root cause of the outage. Four-character alphanumeric code from the NERC GADS cause code taxonomy. Mandatory for NERC GADS reporting submissions."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_gads_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC GADS (Generating Availability Data System) Cause Code" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.nercGadsReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc gads reportable flag"@en ;
    rdfs:comment "Indicates whether this outage event must be reported to NERC GADS. True if the outage meets NERC GADS reporting thresholds (duration, capacity, or cause criteria). False for minor events below reporting thresholds."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_gads_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC GADS (Generating Availability Data System) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.nercGadsSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc gads submission date"@en ;
    rdfs:comment "Date when the outage event data was submitted to NERC GADS. Null if not yet submitted or not reportable. Used for regulatory compliance tracking."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:date ;
    cmm:physicalColumn "nerc_gads_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC GADS (Generating Availability Data System) Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:GenerationOutageEvent.outageDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration hours"@en ;
    rdfs:comment "Total duration of the outage in hours, calculated as the difference between outage end and start timestamps. Null if outage is still active. Used for NERC GADS availability metrics and maintenance planning."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outage_duration_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:GenerationOutageEvent.outageEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage end timestamp"@en ;
    rdfs:comment "Date and time when the generation unit returned to service and was synchronized to the grid. Null if outage is still active. Used to calculate outage duration and unit availability metrics."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GenerationOutageEvent.outageEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage event number"@en ;
    rdfs:comment "Business identifier for the outage event, typically assigned by the plant operations or outage management system. Used for external reporting and cross-system reference."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GenerationOutageEvent.outageNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage notes"@en ;
    rdfs:comment "Free-text field for additional outage details, operational context, lessons learned, and cross-functional coordination notes. Used for knowledge capture and future reference."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:GenerationOutageEvent.outagePriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage priority"@en ;
    rdfs:comment "Business priority level for outage resolution. Critical: immediate grid reliability impact. High: significant capacity loss. Medium: moderate impact. Low: minimal impact or planned maintenance."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:GenerationOutageEvent.outageSeason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage season"@en ;
    rdfs:comment "Season during which the outage occurred. Used for seasonal outage pattern analysis and maintenance planning optimization."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_season" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Season" ;
    cmm:validValues "winter|spring|summer|fall" ;
    cmm:cimDatatype "String" .
cmm:GenerationOutageEvent.outageStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage start timestamp"@en ;
    rdfs:comment "Date and time when the generation unit outage began. For forced outages, this is the trip or shutdown time. For planned outages, this is the scheduled start time. Critical for NERC GADS reporting and availability calculations."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GenerationOutageEvent.outageStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage status"@en ;
    rdfs:comment "Current lifecycle status of the outage event. Active: outage is ongoing. Completed: unit returned to service. Cancelled: planned outage was cancelled. Extended: outage duration was extended beyond original estimate."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Status" ;
    cmm:validValues "active|completed|cancelled|extended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.status .
cmm:GenerationOutageEvent.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event. Forced: unplanned immediate shutdown. Planned: scheduled in advance. Maintenance: scheduled preventive or corrective work. Derating: partial capacity reduction. Seasonal: planned seasonal shutdown."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "forced|planned|maintenance|derating|seasonal" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.type .
cmm:GenerationOutageEvent.rootCauseAnalysisCompletedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause analysis completed flag"@en ;
    rdfs:comment "Indicates whether a formal root cause analysis (RCA) has been completed for the outage event. True if RCA is complete. False if pending or not required. Used for continuous improvement tracking."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "root_cause_analysis_completed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Analysis Completed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.rtoIsoNotificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso notification timestamp"@en ;
    rdfs:comment "Date and time when the RTO or ISO was notified of the outage event. Required for forced outages and deratings per market rules. Used for compliance verification."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rto_iso_notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO (Regional Transmission Organization) / ISO (Independent System Operator) Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GenerationOutageEvent.safetyIncidentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident flag"@en ;
    rdfs:comment "Indicates whether the outage involved a worker safety incident (injury, near-miss, OSHA recordable event). True if safety incident occurred. False otherwise. Triggers OSHA reporting workflow."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_incident_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Incident Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GenerationOutageEvent.unitNameplateCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit nameplate capacity mw"@en ;
    rdfs:comment "Maximum rated generation capacity of the unit in Megawatts. Denormalized from unit master data for outage analysis and capacity planning calculations."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_nameplate_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Nameplate Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GenerationOutageEvent.weatherRelatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather related flag"@en ;
    rdfs:comment "Indicates whether the outage was caused or exacerbated by weather conditions (extreme temperature, lightning, wind, ice, flooding). True if weather was a contributing factor. False otherwise."@en ;
    rdfs:domain cmm:GenerationOutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "weather_related_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Related Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:StartupEvent a owl:Class ;
    rdfs:label "Startup Event"@en ;
    rdfs:comment "Transactional record of each generating unit startup event, capturing startup type (hot/warm/cold), initiation timestamp, synchronization timestamp, full-load timestamp, startup fuel consumed (MMBtu), startup cost ($), startup duration (minutes), reason for startup (economic dispatch, reliability, test), and success/failure outcome. Feeds NERC GADS event reporting (cause code linkage to outage_event), O&M cost tracking, heat rate degradation analysis, and unit commitment optimization models. Supports startup cost curve calibration for day-ahead market offers."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:StartupModel ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.startup_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ABB Ability Symphony Plus DCS Event Log / NERC GADS" ;
    cmm:sourceObject "energy_utilities_ecm.generation.startup_event" ;
    owl:hasKey ( cmm:StartupEvent.startupEventId ) .

cmm:StartupEvent.startupEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup event id"@en ;
    rdfs:comment "Unique identifier for the generating unit startup event. Primary key for the startup_event product."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "startup_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Startup Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:StartupEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Startups affect control area generation availability and reserve margins. Required for real-time unit status tracking and reserve adequacy monitoring."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_control_area_id" ;
    cmm:cimAssociation "StartupModel.ControlArea" .
cmm:StartupEvent.dispatchSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch schedule"@en ;
    rdfs:comment "Reference to the specific dispatch instruction or unit commitment order that initiated the startup. Links to energy management system (EMS) dispatch records."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:DispatchSchedule ;
    cmm:physicalColumn "dispatch_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispatch Instruction ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_dispatch_schedule_id" ;
    cmm:cimAssociation "StartupModel.GenUnitOpSchedule" .
cmm:StartupEvent.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the control room operator or automated system that initiated the startup sequence. Used for training analysis and human factors review."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_employee_id" ;
    cmm:cimAssociation "StartupModel.ErpPersonnel" .
cmm:StartupEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Startup failures trigger EMS alarms for operator intervention. Required for unit availability tracking and commitment compliance."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_ems_alarm_id" ;
    cmm:cimAssociation "StartupModel.ActivityRecord" .
cmm:StartupEvent.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: Startups trigger specific permit conditions including startup emissions limits, notification requirements, and excess emissions reporting. Critical for permit compliance tracking, exceedance detection"@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Environmental Permit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_environmental_permit_id" ;
    cmm:cimAssociation "StartupModel.Document" .
cmm:StartupEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the preceding outage event that this startup terminates. Links to NERC GADS outage reporting for cause code correlation and availability analysis."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_event_id" ;
    cmm:cimAssociation "StartupModel.Outage" .
cmm:StartupEvent.frequencyEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "frequency event"@en ;
    rdfs:comment "Foreign key linking to grid.frequency_event. Business justification: Startups can trigger or respond to frequency events (black start capability, primary frequency response). Required for NERC BAL-003 and EOP-005 compliance."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:FrequencyEvent ;
    cmm:physicalColumn "frequency_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Frequency Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_frequency_event_id" ;
    cmm:cimAssociation "StartupModel.PSREvent" .
cmm:StartupEvent.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Every startup event occurs on a specific generating unit. Without this FK, startup cost tracking and hot/warm/cold analysis cannot be attributed to units."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_generating_unit_id" ;
    cmm:cimAssociation "StartupModel.GeneratingUnit" .
cmm:StartupEvent.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: Generator startups during system restoration are part of reliability event response (black start). Required for NERC EOP-005 compliance and restoration reporting."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_grid_reliability_event_id" ;
    cmm:cimAssociation "StartupModel.PSREvent" .
cmm:StartupEvent.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Generator startups require switching orders for synchronization. Required for safe energization and breaker coordination."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_grid_switching_order_id" ;
    cmm:cimAssociation "StartupModel.SwitchingPlan" .
cmm:StartupEvent.marketCommitment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "market commitment"@en ;
    rdfs:comment "Reference to the day-ahead market (DAM) or real-time market (RTM) commitment that triggered this startup. Links to energy trading system for settlement reconciliation."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:UnitCommitment ;
    cmm:physicalColumn "market_commitment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Market Commitment ID" ;
    cmm:sourceColumn "unit_commitment_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_market_commitment_id" ;
    cmm:cimAssociation "StartupModel.GenUnitOpSchedule" .
cmm:StartupEvent.operatorLog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator log"@en ;
    rdfs:comment "Foreign key linking to grid.operator_log. Business justification: Generator startups are logged by control room operators for shift turnover and event reconstruction. Required for NERC compliance evidence and operational audits."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:OperatorLog ;
    cmm:physicalColumn "operator_log_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Log Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_operator_log_id" ;
    cmm:cimAssociation "StartupModel.Document" .
cmm:StartupEvent.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Reference to the generation facility where the startup event occurred. Links to the plant master registry."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_power_plant_id" ;
    cmm:cimAssociation "StartupModel.Plant" .
cmm:StartupEvent.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Startup events occur on specific generating units. Without this FK, startup cost and performance data cannot be attributed to the unit. Critical for O&M cost tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_primary_generating_unit_id" ;
    cmm:cimAssociation "StartupModel.GeneratingUnit" .
cmm:StartupEvent.startupConsumablesMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "startup consumables material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Startups consume specific materials (startup fuel, chemicals, lubricants) tracked in material master. Startup cost accounting requires linking material consumption to events for accurate cost-per-star"@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "startup_consumables_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Startup Consumables Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_startup_consumables_material_master_id" ;
    cmm:cimAssociation "StartupModel.ErpItemMaster" .
cmm:StartupEvent.startupGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "startup generating unit"@en ;
    rdfs:comment "Reference to the specific generating unit (turbine, boiler, generator set) that underwent the startup event. Links to the generation asset registry."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "startup_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_startup_event_startup_generating_unit_id" ;
    cmm:cimAssociation "StartupModel.GeneratingUnit" .
cmm:StartupEvent.actualLoadAchievedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual load achieved mw"@en ;
    rdfs:comment "Actual generation output in megawatts (MW) achieved at the end of the startup ramp phase. Used to assess startup performance against target and market commitment."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_load_achieved_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Load Achieved (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StartupEvent.ambientTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature f"@en ;
    rdfs:comment "Ambient air temperature in degrees Fahrenheit at startup initiation. Impacts startup duration, fuel consumption, and unit performance for combustion turbines and combined cycle units."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_f" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature (Fahrenheit)" ;
    cmm:cimDatatype "Decimal" .
cmm:StartupEvent.auxiliaryPowerConsumptionMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auxiliary power consumption mwh"@en ;
    rdfs:comment "Station service and auxiliary equipment power consumption during startup measured in megawatt-hours (MWh). Includes boiler feed pumps, fans, cooling systems, and control systems."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "auxiliary_power_consumption_mwh" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auxiliary Power Consumption (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:StartupEvent.completionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion timestamp"@en ;
    rdfs:comment "Timestamp when the startup event was formally closed in the operational system. May differ from full_load_timestamp if post-startup validation or stabilization is required."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StartupEvent.controlMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Operating mode during startup: automatic (DCS-controlled sequence), manual (operator-driven), remote (dispatch center control), or test (commissioning mode)."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Mode" ;
    cmm:validValues "automatic|manual|remote|test" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this startup event record was first created in the system. Audit trail for data lineage and regulatory compliance."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:StartupModel.createdDateTime .
cmm:StartupEvent.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Identifier of the source system that provided this startup event data. Typically ABB Ability Symphony Plus (DCS), OSIsoft PI (historian), or manual entry system. Supports data lineage and reconciliation."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.emissionsCo2Tons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions co2 tons"@en ;
    rdfs:comment "Total carbon dioxide emissions during the startup event measured in short tons. Required for EPA greenhouse gas reporting and carbon compliance tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_co2_tons" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Dioxide (CO2) Emissions (Tons)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:StartupEvent.emissionsNoxLbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions nox lbs"@en ;
    rdfs:comment "Total nitrogen oxides emissions during the startup event measured in pounds. Critical for air quality permit compliance and emissions allowance tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_nox_lbs" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nitrogen Oxides (NOx) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:StartupEvent.emissionsSo2Lbs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions so2 lbs"@en ;
    rdfs:comment "Total sulfur dioxide emissions during the startup event measured in pounds. Required for acid rain program compliance and state implementation plan (SIP) reporting."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_so2_lbs" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sulfur Dioxide (SO2) Emissions (Pounds)" ;
    cmm:unitSymbol "lb" ;
    cmm:cimDatatype "Mass" .
cmm:StartupEvent.failureDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure description"@en ;
    rdfs:comment "Detailed narrative description of the failure or abort condition for unsuccessful startup events. Supports root cause analysis and corrective action tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Description" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.failureReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason code"@en ;
    rdfs:comment "Primary cause code for failed or aborted startup events. Maps to NERC GADS cause codes for reliability reporting. Set to 'none' for successful startups. Reference-value candidates: equipment_malfunction|fuel_supply_issue|grid_constraint|operator_error|environmental_limit|control_system_fault|none."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Reason Code" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "Primary fuel type used during the startup event. May differ from unit's primary fuel for dual-fuel units that use oil or gas for startup. Reference-value candidates: natural_gas|coal|nuclear|hydro|wind|solar|biomass|oil|dual_fuel."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.fullLoadTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "full load timestamp"@en ;
    rdfs:comment "Timestamp when the generating unit reached its committed or maximum continuous rating (MCR). Marks completion of the startup ramp phase."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "full_load_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Full Load Achievement Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StartupEvent.initiationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiation timestamp"@en ;
    rdfs:comment "Timestamp when the startup sequence was initiated (first ignition or turbine roll command issued). Marks the beginning of the startup event for duration and cost tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "initiation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Initiation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StartupEvent.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this startup event record was last updated. Tracks data changes for audit trail and data quality monitoring."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:StartupEvent.nercGadsReportedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc gads reported flag"@en ;
    rdfs:comment "Boolean indicator of whether this startup event has been reported to NERC Generating Availability Data System (GADS). Required for failed startups and startups following forced outages."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_gads_reported_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC GADS Reported Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StartupEvent.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text operational notes and observations recorded by control room operators during the startup event. Captures non-standard conditions, equipment behavior, and operational context."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Startup Event Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:StartupEvent.previousShutdownTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "previous shutdown timestamp"@en ;
    rdfs:comment "Timestamp of the preceding unit shutdown event. Used to calculate unit_offline_hours and determine thermal state for startup type classification."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "previous_shutdown_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Previous Shutdown Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StartupEvent.rampDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp duration minutes"@en ;
    rdfs:comment "Elapsed time in minutes from synchronization to full load. Measures the load ramping phase performance and flexibility capability."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:StartupEvent.scadaDataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada data quality flag"@en ;
    rdfs:comment "Quality indicator for SCADA telemetry data captured during the startup event. Good indicates validated real-time data, estimated indicates gap-filled data, manual indicates operator-entered values, missing indicates data loss."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA Data Quality Flag" ;
    cmm:validValues "good|estimated|manual|missing" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.startupCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup cost usd"@en ;
    rdfs:comment "Total direct cost of the startup event in US dollars, including fuel cost, auxiliary power, consumables, and incremental wear. Used for market offer development, unit commitment optimization, and O&M cost tracking."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_cost_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:StartupEvent.startupDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup duration minutes"@en ;
    rdfs:comment "Total elapsed time in minutes from initiation to synchronization. Used for heat rate degradation analysis, unit commitment optimization, and startup cost curve calibration."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:StartupEvent.startupEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup event number"@en ;
    rdfs:comment "Business identifier for the startup event, typically formatted as PLANT-YYYYMMDD-SEQN. Used for operational tracking and NERC GADS reporting."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "startup_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Startup Event Number" ;
    cmm:valuePattern "^[A-Z0-9]{3,4}-[0-9]{8}-[0-9]{4}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:StartupEvent.startupFuelConsumedMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup fuel consumed mmbtu"@en ;
    rdfs:comment "Total fuel energy consumed during the startup event measured in million British thermal units (MMBtu). Includes ignition fuel, warm-up fuel, and ramp fuel. Critical for startup cost calculation and heat rate analysis."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_fuel_consumed_mmbtu" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Fuel Consumed (MMBtu)" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:StartupEvent.startupFuelCostPerMmbtu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup fuel cost per mmbtu"@en ;
    rdfs:comment "Unit fuel cost in USD per MMBtu applied to the startup fuel consumption. May differ from normal operating fuel cost if startup uses premium fuel (e.g., distillate oil)."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_fuel_cost_per_mmbtu" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Fuel Cost per MMBtu (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Btu" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "Float" .
cmm:StartupEvent.startupHeatRateBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup heat rate btu per kwh"@en ;
    rdfs:comment "Effective heat rate during the startup event calculated as total fuel consumed (Btu) divided by net energy generated (kWh). Significantly higher than normal operating heat rate; used for startup cost curve calibration."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_heat_rate_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Heat Rate (Btu per kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:StartupEvent.startupReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup reason code"@en ;
    rdfs:comment "Primary business reason for initiating the startup event. Economic dispatch indicates market-driven startup, reliability indicates grid stability requirement, test indicates commissioning or post-maintenance validation."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "startup_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Reason Code" ;
    cmm:validValues "economic_dispatch|reliability_must_run|scheduled_maintenance_return|test_startup|market_commitment|reserve_activation" ;
    cmm:cimDatatype "String" .
cmm:StartupEvent.startupStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup status"@en ;
    rdfs:comment "Current lifecycle status of the startup event. Tracks progression from initiation through synchronization, load ramping, to completion or failure."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "startup_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Startup Status" ;
    cmm:validValues "initiated|synchronizing|ramping|completed|failed|aborted" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StartupModel.status .
cmm:StartupEvent.startupSuccessFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup success flag"@en ;
    rdfs:comment "Boolean indicator of whether the startup event completed successfully (true) or failed/aborted (false). Failed startups trigger root cause analysis and NERC GADS event reporting."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "startup_success_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Success Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StartupEvent.startupType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup type"@en ;
    rdfs:comment "Classification of startup based on unit offline duration and temperature: hot (< 8 hours offline), warm (8-72 hours), cold (> 72 hours), emergency (unplanned reliability startup). Determines startup cost curve and duration expectations."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "startup_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Startup Type" ;
    cmm:validValues "hot|warm|cold|emergency" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StartupModel.kind .
cmm:StartupEvent.synchronizationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "synchronization timestamp"@en ;
    rdfs:comment "Timestamp when the generating unit was synchronized to the grid (breaker closed, unit online). Critical milestone for market settlement and reliability reporting."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "synchronization_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grid Synchronization Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StartupEvent.targetLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target load mw"@en ;
    rdfs:comment "Committed or target generation output in megawatts (MW) for this startup event. Represents the dispatch instruction or market commitment level."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StartupEvent.unitOfflineHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit offline hours"@en ;
    rdfs:comment "Total hours the generating unit was offline prior to this startup event. Primary determinant of startup type classification (hot/warm/cold) and expected startup duration."@en ;
    rdfs:domain cmm:StartupEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_offline_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Offline Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .

cmm:CapacityPlan a owl:Class ;
    rdfs:label "Capacity Plan"@en ;
    rdfs:comment "Long-range generation capacity planning records supporting the Integrated Resource Plan (IRP). Captures planning horizon year, scenario name, projected peak demand (MW), required reserve margin (%), planned new capacity additions (MW by technology), planned retirements (MW), capacity shortfall or surplus (MW), CAPEX estimate ($M), LCOE by technology ($/MWh), and regulatory submission status (PUC/FERC). Supports resource adequacy analysis, technology selection, and regulatory rate case filings. SSOT for IRP capacity modeling and generation fleet planning."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.generation_assets ;
    cmm:physicalTable "utility_cmm_silver.generation.capacity_plan" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IRP (Integrated Resource Plan) / FERC Form 715" ;
    cmm:sourceObject "energy_utilities_ecm.generation.capacity_plan" ;
    owl:hasKey ( cmm:CapacityPlan.capacityPlanId ) .

cmm:CapacityPlan.capacityPlanId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity plan id"@en ;
    rdfs:comment "Unique identifier for the generation capacity plan record. Primary key for the capacity planning entity supporting Integrated Resource Plan (IRP) analysis and regulatory submissions."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "capacity_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capacity Plan ID" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityPlan.capacityObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity obligation"@en ;
    rdfs:comment "Foreign key linking to trading.capacity_obligation. Business justification: Capacity expansion plans are driven by ISO capacity obligations and must demonstrate how they satisfy them. Essential for IRP filings and capacity procurement planning."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:CapacityObligation ;
    cmm:physicalColumn "capacity_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_capacity_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityPlan.capacityPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity power plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — Capacity plans reference existing and planned generation facilities for IRP modeling. power_plant_id links planned additions/retirements to specific facilities."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "capacity_power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_capacity_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:CapacityPlan.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Capacity plans drive capital project portfolios (new builds, retirements). Essential for IRP-to-budget alignment, CPCN filings, and multi-year capital planning."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:CapacityPlan.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Foreign key linking to asset.capital_project. Business justification: Capacity plans (IRP filings) identify specific capital projects for new generation capacity, retirements, or upgrades. Linking plans to projects enables tracking of planned vs. actual capex, regulator"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_capital_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:CapacityPlan.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Capacity planning scenarios model control area peak demand, reserve margins, and resource adequacy. Required for IRP filings and NERC long-term reliability assessments."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:CapacityPlan.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to demand.dr_program. Business justification: Integrated resource plans explicitly model demand response programs as capacity resources. IRP filings to PUCs require quantifying DR contributions to reserve margins and peak demand reduction. Essent"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_dr_program_id" ;
    cmm:cimAssociation "Document.DemandResponseProgram" .
cmm:CapacityPlan.irpFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp filing"@en ;
    rdfs:comment "Reference to the parent Integrated Resource Plan document under which this capacity plan was developed. Links to the overarching IRP submission cycle."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:IrpFiling ;
    cmm:physicalColumn "irp_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_irp_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityPlan.peakDemand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand"@en ;
    rdfs:comment "Foreign key linking to forecast.peak_demand. Business justification: Capacity plans are driven by peak demand forecasts to determine required capacity additions and reserve margins. Core input for IRP filings, capacity market participation, and generation investment de"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:PeakDemand ;
    cmm:physicalColumn "peak_demand_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Peak Demand Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_peak_demand_id" ;
    cmm:cimAssociation "Document.RegularIntervalSchedule" .
cmm:CapacityPlan.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — IRP capacity plans reference existing and planned generation facilities. This link enables traceability from planning scenarios to the physical fleet. Medium confidence because capacity plans may also"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:CapacityPlan.renewableInterconnectionQueue a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable interconnection queue"@en ;
    rdfs:comment "Foreign key linking to renewable.interconnection_queue. Business justification: Capacity planning incorporates projects in the interconnection queue to forecast future renewable supply and assess transmission upgrade needs. IRP teams track queue positions to model realistic comme"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:InterconnectionQueue ;
    cmm:physicalColumn "renewable_interconnection_queue_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Interconnection Queue Id (Foreign Key)" ;
    cmm:sourceColumn "interconnection_queue_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_renewable_interconnection_queue_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityPlan.rpsObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rps obligation"@en ;
    rdfs:comment "Foreign key linking to renewable.rps_obligation. Business justification: Integrated resource planning (IRP) must model renewable capacity additions to meet state RPS mandates. Planners link capacity plans to specific RPS obligations to demonstrate compliance pathways, opti"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:RpsObligation ;
    cmm:physicalColumn "rps_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rps Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_rps_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityPlan.transmissionPlanningStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission planning study"@en ;
    rdfs:comment "Foreign key linking to transmission.planning_study. Business justification: Generation capacity expansion plans must reference transmission planning studies to demonstrate deliverability and grid adequacy. IRP filings cite transmission studies showing new generation can be re"@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range cmm:PlanningStudy ;
    cmm:physicalColumn "transmission_planning_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Planning Study Id (Foreign Key)" ;
    cmm:sourceColumn "planning_study_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_plan_transmission_planning_study_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CapacityPlan.capacityShortfallSurplusMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity shortfall surplus mw"@en ;
    rdfs:comment "Projected capacity shortfall (negative value) or surplus (positive value) in megawatts (MW) after accounting for demand, reserve margin requirements, additions, and retirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_shortfall_surplus_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Shortfall or Surplus (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.carbonIntensityKgPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "carbon intensity kg per mwh"@en ;
    rdfs:comment "Projected carbon intensity in kilograms of carbon dioxide equivalent per megawatt-hour (kg CO2e/MWh), representing emissions per unit of energy generated."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "carbon_intensity_kg_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Intensity (kg CO2e/MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CapacityPlan.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User identifier or name of the person who created this capacity plan record, supporting accountability and audit requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created By User" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this capacity plan record was first created in the system, supporting audit trail and data lineage requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:CapacityPlan.derCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der capacity additions mw"@en ;
    rdfs:comment "Subset of planned capacity additions in megawatts (MW) from Distributed Energy Resources (DER) including rooftop solar, community solar, and Behind the Meter (BTM) generation."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "der_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.existingCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "existing capacity mw"@en ;
    rdfs:comment "Total installed generation capacity in megawatts (MW) from existing generation fleet at the start of the planning horizon, before planned additions or retirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "existing_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Existing Generation Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.fercSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc submission date"@en ;
    rdfs:comment "Date when this capacity plan was submitted to the Federal Energy Regulatory Commission (FERC) for review and approval, if applicable for interstate transmission planning."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "ferc_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityPlan.fossilCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fossil capacity additions mw"@en ;
    rdfs:comment "Subset of planned capacity additions in megawatts (MW) from conventional fossil fuel sources including Combined Cycle Gas Turbine (CCGT), coal, and simple cycle gas turbines."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fossil_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fossil Fuel Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.fossilCapexEstimateMillion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fossil capex estimate million"@en ;
    rdfs:comment "Subset of total CAPEX in millions of dollars allocated to conventional fossil fuel capacity additions for the planning horizon year."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fossil_capex_estimate_million" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fossil Fuel Capital Expenditure (CAPEX) Estimate ($M)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityPlan.fossilLcoePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fossil lcoe per mwh"@en ;
    rdfs:comment "Average Levelized Cost of Energy (LCOE) in dollars per megawatt-hour ($/MWh) for conventional fossil fuel capacity additions in the planning horizon year."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fossil_lcoe_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fossil Fuel Levelized Cost of Energy (LCOE) ($/MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CapacityPlan.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "User identifier or name of the person who last modified this capacity plan record, supporting accountability and audit requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this capacity plan record was last updated or modified, supporting audit trail and change tracking requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CapacityPlan.netCapacityChangeMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net capacity change mw"@en ;
    rdfs:comment "Net change in generation capacity in megawatts (MW) for the planning horizon year, calculated as planned additions minus planned retirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_capacity_change_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Capacity Change (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.nuclearCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nuclear capacity additions mw"@en ;
    rdfs:comment "Subset of planned capacity additions in megawatts (MW) from nuclear generation facilities, including new builds and uprates of existing plants."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nuclear_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nuclear Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.planName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan name"@en ;
    rdfs:comment "Business-friendly name or title for this capacity plan scenario, used for identification in regulatory filings and internal planning documents."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Capacity Plan Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CapacityPlan.planStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan status"@en ;
    rdfs:comment "Current lifecycle status of the capacity plan within the regulatory approval and internal governance process. Reference-value candidates: draft|under_review|approved|submitted_to_puc|submitted_to_ferc|final|superseded."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Plan Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CapacityPlan.planVersionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan version number"@en ;
    rdfs:comment "Version number of this capacity plan, incremented with each revision or update to track changes over the planning and approval lifecycle."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "plan_version_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Plan Version Number" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityPlan.plannedCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned capacity additions mw"@en ;
    rdfs:comment "Total new generation capacity in megawatts (MW) planned to be added during the planning horizon year across all generation technologies."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.plannedCapacityRetirementsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned capacity retirements mw"@en ;
    rdfs:comment "Total generation capacity in megawatts (MW) planned to be retired or decommissioned during the planning horizon year due to age, economics, or environmental regulations."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_capacity_retirements_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Capacity Retirements (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.planningAssumptionsSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning assumptions summary"@en ;
    rdfs:comment "Summary of key planning assumptions used in developing this capacity plan, including demand growth rates, fuel price forecasts, technology cost assumptions, and policy scenarios."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "planning_assumptions_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Assumptions Summary" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.planningHorizonYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning horizon year"@en ;
    rdfs:comment "Target year for which this capacity plan projects generation resource needs, typically ranging from 1 to 20 years into the future."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "planning_horizon_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Horizon Year" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityPlan.projectedCarbonEmissionsTons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "projected carbon emissions tons"@en ;
    rdfs:comment "Projected annual carbon dioxide equivalent emissions in metric tons (CO2e) from the generation fleet for the planning horizon year, used for environmental compliance and carbon reduction planning."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "projected_carbon_emissions_tons" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Projected Carbon Emissions (Tons CO2e)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:CapacityPlan.projectedEnergyDemandGwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "projected energy demand gwh"@en ;
    rdfs:comment "Forecasted annual energy consumption in gigawatt-hours (GWh) for the planning horizon year, representing total electricity usage over the year."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "projected_energy_demand_gwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Projected Energy Demand (GWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "G" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CapacityPlan.projectedPeakDemandMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "projected peak demand mw"@en ;
    rdfs:comment "Forecasted peak electricity demand in megawatts (MW) for the planning horizon year, representing the maximum instantaneous load the system must serve."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "projected_peak_demand_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Projected Peak Demand (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.pucSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc submission date"@en ;
    rdfs:comment "Date when this capacity plan was submitted to the state Public Utility Commission (PUC) for review and approval as part of the IRP filing process."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "puc_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityPlan.regulatoryApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory approval date"@en ;
    rdfs:comment "Date when this capacity plan received formal approval from the relevant regulatory authority (PUC or FERC), authorizing execution of the planned capacity changes."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "regulatory_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityPlan.reliabilityIndexTarget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index target"@en ;
    rdfs:comment "Target reliability index metric (e.g., Loss of Load Expectation - LOLE, Loss of Load Probability - LOLP) for the planning horizon year, representing acceptable risk of capacity shortfall."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_index_target" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reliability Index Target" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityPlan.renewableCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable capacity additions mw"@en ;
    rdfs:comment "Subset of planned capacity additions in megawatts (MW) from renewable energy sources including wind, solar, hydro, and biomass to meet Renewable Portfolio Standard (RPS) requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.renewableCapexEstimateMillion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable capex estimate million"@en ;
    rdfs:comment "Subset of total CAPEX in millions of dollars allocated to renewable energy capacity additions for the planning horizon year."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_capex_estimate_million" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Capital Expenditure (CAPEX) Estimate ($M)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityPlan.renewableLcoePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable lcoe per mwh"@en ;
    rdfs:comment "Average Levelized Cost of Energy (LCOE) in dollars per megawatt-hour ($/MWh) for renewable capacity additions in the planning horizon year."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_lcoe_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Levelized Cost of Energy (LCOE) ($/MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CapacityPlan.renewablePortfolioPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable portfolio percent"@en ;
    rdfs:comment "Projected percentage of total generation capacity from renewable energy sources for the planning horizon year, used to track compliance with Renewable Portfolio Standard (RPS) requirements."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_portfolio_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Percentage (%)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CapacityPlan.requiredReserveMarginPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required reserve margin percent"@en ;
    rdfs:comment "Minimum planning reserve margin percentage required to maintain system reliability, calculated as excess capacity above peak demand divided by peak demand."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "required_reserve_margin_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Reserve Margin (%)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CapacityPlan.riskAssessmentSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk assessment summary"@en ;
    rdfs:comment "Summary of identified risks and uncertainties associated with this capacity plan, including demand forecast risk, technology performance risk, regulatory risk, and market risk."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "risk_assessment_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Assessment Summary" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.scenarioName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario name"@en ;
    rdfs:comment "Name of the planning scenario or case (e.g., Base Case, High Growth, Low Carbon, Accelerated Renewables) representing different demand and policy assumptions."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "scenario_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Scenario Name" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.scenarioType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario type"@en ;
    rdfs:comment "Classification of the planning scenario type used for capacity modeling and resource adequacy analysis. Reference-value candidates: base_case|high_growth|low_growth|high_renewable|low_carbon|regulatory_compliance|sensitivity."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "scenario_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scenario Type" ;
    cmm:cimDatatype "String" .
cmm:CapacityPlan.storageCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage capacity additions mw"@en ;
    rdfs:comment "Subset of planned capacity additions in megawatts (MW) from energy storage systems including battery storage, pumped hydro, and other storage technologies."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "storage_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Storage Capacity Additions (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapacityPlan.totalCapexEstimateMillion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total capex estimate million"@en ;
    rdfs:comment "Total estimated capital expenditure in millions of dollars for all planned capacity additions in the planning horizon year, including construction, interconnection, and Balance of System (BOS) costs."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_capex_estimate_million" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Capital Expenditure (CAPEX) Estimate ($M)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacityPlan.weightedAverageLcoePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weighted average lcoe per mwh"@en ;
    rdfs:comment "Weighted average Levelized Cost of Energy (LCOE) in dollars per megawatt-hour ($/MWh) across all planned capacity additions, representing the lifetime cost per unit of energy produced."@en ;
    rdfs:domain cmm:CapacityPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weighted_average_lcoe_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weighted Average Levelized Cost of Energy (LCOE) ($/MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .

cmm:AncillaryServiceOffer a owl:Class ;
    rdfs:label "Ancillary Service Offer"@en ;
    rdfs:comment "Records of ancillary service capability offers submitted by generating units to ISO/RTO markets, including regulation up/down, spinning reserve, non-spinning reserve, and reactive power. Captures offer interval, service type, offered capacity (MW), offer price ($/MW or $/MWh), ramp rate capability, response time, ISO/RTO market (PJM, MISO, CAISO, ERCOT), and award status. Supports market revenue optimization and NERC reliability standard compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ResourceBid ;
    cmm:cimCloseMatch cim:ResourceBid ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::ParticipantInterfaces" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.ancillary_service_offer" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 62325-301; FERC Order 755 / ISO-RTO Ancillary Services Market" ;
    cmm:sourceObject "energy_utilities_ecm.generation.ancillary_service_offer" ;
    owl:hasKey ( cmm:AncillaryServiceOffer.ancillaryServiceOfferId ) .

cmm:AncillaryServiceOffer.ancillaryServiceOfferId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service offer id"@en ;
    rdfs:comment "Unique identifier for the ancillary service offer record. Primary key for this entity."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:long ;
    cmm:physicalColumn "ancillary_service_offer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Ancillary Service Offer ID" ;
    cmm:cimDatatype "Integer" .
cmm:AncillaryServiceOffer.ancillaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary generating unit"@en ;
    rdfs:comment "Identifier of the generating unit submitting the ancillary service offer. Links to the generation asset registry."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "ancillary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_ancillary_generating_unit_id" ;
    cmm:cimAssociation "ResourceBid.GeneratingUnit" .
cmm:AncillaryServiceOffer.ancillaryServiceAward a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service award"@en ;
    rdfs:comment "Foreign key linking to trading.ancillary_service_award. Business justification: Ancillary service offers submitted to ISO markets result in awards. Core market participation workflow linking offer submission to award receipt and settlement."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:AncillaryServiceAward ;
    cmm:physicalColumn "ancillary_service_award_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ancillary Procurement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_ancillary_service_award_id" ;
    cmm:cimAssociation "ResourceBid.AncillaryServiceClearing" .
cmm:AncillaryServiceOffer.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Ancillary services (regulation, spinning reserve) are procured and dispatched by control area operators for real-time balancing and frequency control."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_control_area_id" ;
    cmm:cimAssociation "ResourceBid.ControlArea" .
cmm:AncillaryServiceOffer.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the individual trader or scheduler who submitted the ancillary service offer on behalf of the utility."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trader ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_employee_id" ;
    cmm:cimAssociation "ResourceBid.ErpPersonnel" .
cmm:AncillaryServiceOffer.fromGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "from generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Ancillary service offers are submitted based on a specific generating unit's physical capability (ramp rate, response time). Without this FK, offers cannot be traced to the unit providing the service."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "from_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_from_generating_unit_id" ;
    cmm:cimAssociation "ResourceBid.GeneratingUnit" .
cmm:AncillaryServiceOffer.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Ancillary service offers are submitted per generating unit to ISO/RTO markets. generating_unit_id is required for market revenue tracking and NERC reliability compliance."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_generating_unit_id" ;
    cmm:cimAssociation "ResourceBid.GeneratingUnit" .
cmm:AncillaryServiceOffer.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Ancillary service participation governed by ISO/RTO market rules and NERC standards (frequency response, voltage support). Required for market compliance validation, settlement dispute resolution, and"@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_obligation_id" ;
    cmm:cimAssociation "ResourceBid.Document" .
cmm:AncillaryServiceOffer.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Ancillary service offers are submitted for specific generating units based on their capability. Without this FK, offers cannot be traced to the offering unit. Critical for market revenue tracking."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_ancillary_service_offer_primary_generating_unit_id" ;
    cmm:cimAssociation "ResourceBid.GeneratingUnit" .
cmm:AncillaryServiceOffer.awardTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "award timestamp"@en ;
    rdfs:comment "Date and time when the ISO/RTO awarded the ancillary service offer or published the market clearing results."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "award_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Award Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AncillaryServiceOffer.awardedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "awarded capacity mw"@en ;
    rdfs:comment "The capacity in megawatts (MW) that was actually awarded by the ISO/RTO for this ancillary service offer. May be less than or equal to offered capacity."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "awarded_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Awarded Capacity (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceOffer.clearingPricePerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing price per mw"@en ;
    rdfs:comment "The market clearing price in dollars per megawatt ($/MW) at which the ancillary service capacity was awarded."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "clearing_price_per_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Price per Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceOffer.clearingPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing price per mwh"@en ;
    rdfs:comment "The market clearing price in dollars per megawatt-hour ($/MWh) at which the energy-based ancillary service was awarded."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "clearing_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Price per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:AncillaryServiceOffer.complianceNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance notes"@en ;
    rdfs:comment "Free-text field for recording compliance-related notes, regulatory reporting requirements, or NERC reliability standard adherence details related to this ancillary service offer."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Compliance Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:AncillaryServiceOffer.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this ancillary service offer record was first created in the system. Audit trail field for record lifecycle tracking."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
