    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overall Condition Score" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.passFailStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pass fail status"@en ;
    rdfs:comment "Indicates whether the test result meets acceptance criteria or threshold limits defined by manufacturer specifications or industry standards."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "pass_fail_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pass/Fail Status" ;
    cmm:validValues "pass|fail|marginal|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.photoAttachmentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "photo attachment count"@en ;
    rdfs:comment "Number of photos or images attached to the inspection record for documentation purposes."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:int ;
    cmm:physicalColumn "photo_attachment_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Photo Attachment Count" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.recommendedAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recommended action"@en ;
    rdfs:comment "Recommended follow-up action based on inspection findings: repair, replace, continue monitoring, no action required, further investigation needed, or emergency repair."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:string ;
    cmm:physicalColumn "recommended_action" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recommended Follow-Up Action" ;
    cmm:validValues "repair|replace|monitor|no_action|further_investigation|emergency_repair" ;
    cmm:cimDatatype "String" .
cmm:AssetInspection.regulatoryComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory compliance flag"@en ;
    rdfs:comment "Indicates whether this inspection is mandated by regulatory requirements (e.g., NERC FAC-003 vegetation management, OSHA confined space entry, state PUC inspection mandates)."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_compliance_flag" ;
