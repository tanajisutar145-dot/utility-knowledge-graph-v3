cmm:ContractorCompany.primaryContactEmail a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact email"@en ;
    rdfs:comment "Email address of the primary contact person."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_email" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_email" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "ElectronicAddress.email1" .
cmm:ContractorCompany.primaryContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact name"@en ;
    rdfs:comment "Name of the primary business contact for the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_name" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.primaryContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact phone"@en ;
    rdfs:comment "Phone number of the primary contact person."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:ContractorCompany.rating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating"@en ;
    rdfs:comment "Aggregated rating (e.g., 0-5) based on performance, safety, and compliance."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rating" ;
    cmm:sqlDataType "DECIMAL(3,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:ContractorCompany.riskLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk level"@en ;
    rdfs:comment "Risk classification for the contractor based on financial and operational factors."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "risk_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.safetyScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety score"@en ;
    rdfs:comment "Numeric score representing the contractor's safety performance (e.g., based on incident rates)."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "safety_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:ContractorCompany.stateProvince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state province"@en ;
    rdfs:comment "State or province of the contractor's primary address."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "state_province" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:ContractorCompany.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current lifecycle status of the contractor company."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "contractor_company_status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Organisation.status .
cmm:ContractorCompany.sustainabilityCertifications a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sustainability certifications"@en ;
    rdfs:comment "Comma-separated list of sustainability or environmental certifications held by the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "sustainability_certifications" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.taxIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax identifier"@en ;
    rdfs:comment "Government-issued tax identifier for the contractor company."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time of the most recent update to the contractor record."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
