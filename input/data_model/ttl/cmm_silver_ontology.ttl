cmm:ClusterStudyGroup.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the cluster study group record was first created in the system. Audit trail for data lineage and record creation tracking."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:ClusterStudyGroup.formationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "formation date"@en ;
    rdfs:comment "Date when the cluster study group cohort was officially formed and applications were grouped together for simultaneous study processing under FERC Order 2023 rules."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "formation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Formation Date" ;
