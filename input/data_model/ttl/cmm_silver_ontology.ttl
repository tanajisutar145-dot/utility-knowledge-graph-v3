cmm:RateSchedule.powerFactorPenaltyApplicable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor penalty applicable"@en ;
    rdfs:comment "Indicates whether power factor penalties or adjustments apply to customers on this rate schedule for poor power factor performance."@en ;
