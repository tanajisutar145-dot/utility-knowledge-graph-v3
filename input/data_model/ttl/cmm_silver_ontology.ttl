    cmm:cimDatatype "Decimal" .
cmm:DerSystem.nameplateCapacityKwDc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity kw dc"@en ;
    rdfs:comment "Maximum DC power rating of the DER system in kilowatts, applicable primarily to solar PV arrays before inverter conversion."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_kw_dc" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nameplate Capacity Kilowatt (kW) Direct Current (DC)" ;
