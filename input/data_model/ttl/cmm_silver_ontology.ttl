cmm:ComplianceViolation.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the source application or system that originated the violation record."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:string ;
