    cmm:sourceObject "energy_utilities_ecm.supply.contractor_company" ;
    owl:hasKey ( cmm:ContractorCompany.contractorCompanyId ) .

cmm:ContractorCompany.contractorCompanyId a owl:DatatypeProperty , owl:FunctionalProperty ;
