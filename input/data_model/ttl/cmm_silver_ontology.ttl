cmm:TradingLegalEntity a owl:Class ;
    rdfs:label "Trading Legal Entity"@en ;
    rdfs:comment "Master reference table for legal_entity. Referenced by legal_entity_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimCloseMatch cim:Organisation ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.asset_holdings ;
    cmm:physicalTable "utility_cmm_silver.trading.legal_entity" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "ISO 17442 (LEI)" ;
    cmm:sourceObject "energy_utilities_ecm.trading.legal_entity" ;
    owl:hasKey ( cmm:TradingLegalEntity.legalEntity ) .

cmm:TradingLegalEntity.legalEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "legal entity"@en ;
    rdfs:comment "Primary key for legal_entity"@en ;
    rdfs:domain cmm:TradingLegalEntity ; rdfs:range cmm:FinanceLegalEntity ;
    cmm:physicalColumn "legal_entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Legal Entity Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_legal_entity_legal_entity_id" .
cmm:TradingLegalEntity.parentLegalEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent legal entity"@en ;
    rdfs:comment "Identifier of the immediate parent entity in corporate hierarchy."@en ;
    rdfs:domain cmm:TradingLegalEntity ; rdfs:range cmm:TradingLegalEntity ;
    cmm:physicalColumn "parent_legal_entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_legal_entity_parent_legal_entity_id" ;
    cmm:cimAssociation "Organisation.Organisation" .
cmm:TradingLegalEntity.ultimateParent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ultimate parent"@en ;
    rdfs:comment "Identifier of the top-most parent entity in the corporate structure."@en ;
    rdfs:domain cmm:TradingLegalEntity ; rdfs:range cmm:TradingLegalEntity ;
    cmm:physicalColumn "ultimate_parent_id" ;
    cmm:sqlDataType "BIGINT" ;
