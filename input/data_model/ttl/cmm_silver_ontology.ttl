    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:MessageTemplate.subject a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Subject line or headline displayed to the recipient."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:string ;
    cmm:physicalColumn "subject" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.subject .
cmm:MessageTemplate.templateType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "template type"@en ;
    rdfs:comment "Category of communication the template supports, e.g., outage notification or maintenance notice."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:string ;
    cmm:physicalColumn "template_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
