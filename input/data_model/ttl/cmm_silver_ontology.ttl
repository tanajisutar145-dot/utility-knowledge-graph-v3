cmm:EnforcementAction.violationSeverityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation severity level"@en ;
    rdfs:comment "Severity classification of the alleged violation as determined by the regulator (e.g., NERC Violation Severity Level: minimal, lower, moderate, high, severe)."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_severity_level" ;
