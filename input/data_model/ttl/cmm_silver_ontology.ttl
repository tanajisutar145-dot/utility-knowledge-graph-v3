    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installer Contractor Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" .
cmm:IncentiveApplication.installerLicenseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installer license number"@en ;
    rdfs:comment "Professional license or certification number of the contractor performing the installation."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "installer_license_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installer License Number" ;
    cmm:cimDatatype "String" ;
