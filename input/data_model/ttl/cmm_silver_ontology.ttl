cmm:ClusterStudyGroup.planningAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning area code"@en ;
    rdfs:comment "Utility planning area or zone code where the cluster study group applications are located. Used for resource planning and grid impact analysis."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "planning_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
