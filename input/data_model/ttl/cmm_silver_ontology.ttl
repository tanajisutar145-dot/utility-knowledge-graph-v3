cmm:SelfReport.penaltyReductionPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty reduction percentage"@en ;
    rdfs:comment "Percentage reduction in penalty granted due to self-reporting, cooperation, and mitigation factors."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:decimal ;
