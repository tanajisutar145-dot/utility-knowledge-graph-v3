    cmm:validValues "eia_aeo|internal_forecast|third_party_consultant|market_forward_curve|historical_average|regulatory_guidance" ;
    cmm:cimDatatype "String" .
cmm:FuelPriceAssumption.assumptionSourceDetail a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assumption source detail"@en ;
    rdfs:comment "Additional detail about the assumption source, such as specific EIA AEO edition, consultant name, or market data provider. Supports audit trail and assumption validation."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:string ;
    cmm:physicalColumn "assumption_source_detail" ;
