cmm:MutualAidDeployment.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Mutual aid deployments are triggered by specific major outage events (storms, disasters). Utilities track which outage event necessitated external crew deployment for cost recovery, NERC/FEMA reportin"@en ;
    rdfs:domain cmm:MutualAidDeployment ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
