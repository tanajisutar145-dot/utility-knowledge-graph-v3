    rdfs:comment "Assumed fuel cost equivalent for renewable generation in US dollars per MWh. Typically zero for wind and solar; may reflect biomass or biogas fuel costs for renewable thermal generation."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_fuel_cost_per_mwh" ;
