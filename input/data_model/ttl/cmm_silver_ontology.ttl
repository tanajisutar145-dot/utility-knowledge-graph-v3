    cmm:cimDatatype "String" .
cmm:CostCenter.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the cost center master record was last modified."@en ;
