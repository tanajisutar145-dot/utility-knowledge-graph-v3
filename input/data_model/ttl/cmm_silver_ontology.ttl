    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affiliate Transaction Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FercMarketReport.amendmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amendment flag"@en ;
    rdfs:comment "Indicates whether this report is an amendment to a previously submitted FERC market report, correcting or updating prior information."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "amendment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amendment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FercMarketReport.authorizedRepresentativeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized representative name"@en ;
    rdfs:comment "Name of the authorized company representative who certified and submitted the FERC market report on behalf of the utility."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_representative_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Representative Name" ;
    cmm:cimDatatype "String" .
cmm:FercMarketReport.averagePricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average price per mwh"@en ;
    rdfs:comment "Weighted average price per megawatt-hour for the reported transactions, calculated as total transaction value divided by total volume."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Price per Megawatt-Hour (MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:FercMarketReport.certificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification date"@en ;
    rdfs:comment "Date on which the authorized representative certified the accuracy and completeness of the FERC market report data."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "certification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Certification Date" ;
    cmm:cimDatatype "Date" .
cmm:FercMarketReport.confirmationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confirmation number"@en ;
    rdfs:comment "Unique confirmation number issued by the FERC eFiling system upon successful submission of the market report, serving as proof of filing."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "confirmation_number" ;
    cmm:sqlDataType "STRING" ;
