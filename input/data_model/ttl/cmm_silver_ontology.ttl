cmm:BillingRun.invoiceDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice due date"@en ;
    rdfs:comment "Standard payment due date applied to invoices generated in this billing run, used for accounts receivable management and collections planning."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "invoice_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoice Due Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingRun.invoicesGenerated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoices generated"@en ;
    rdfs:comment "Total number of billing invoices or statements successfully generated and created during this billing run execution."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "invoices_generated" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoices Generated Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this billing run record was last updated, supporting change tracking and audit compliance for billing operations."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BillingRun.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text operational notes or comments about the billing run execution, capturing special circumstances, manual interventions, or issues requiring follow-up."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Run Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:BillingRun.printBatchReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "print batch reference"@en ;
    rdfs:comment "Identifier of the print or output batch associated with this billing run, linking invoices to physical or electronic delivery processes."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "print_batch_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Print Batch Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:BillingRun.rateScheduleVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule version"@en ;
    rdfs:comment "Version identifier of the rate schedules and tariff structures applied during this billing run, ensuring regulatory compliance and audit traceability."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Version" ;
    cmm:cimDatatype "String" .
cmm:BillingRun.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicator of whether this billing run is a reversal run intended to cancel or reverse invoices from a previous billing run due to errors or corrections."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingRun.runNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run number"@en ;
    rdfs:comment "Business-facing identifier for the billing run, typically formatted as a sequential or date-based code used for operational tracking and reference in billing operations."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Run Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillingRun.runStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run status"@en ;
    rdfs:comment "Current lifecycle status of the billing run execution indicating whether the batch process is pending, actively running, successfully completed, completed with exceptions, failed, or cancelled."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Run Status" ;
    cmm:validValues "pending|in_progress|completed|completed_with_errors|failed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:BillingRun.runType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run type"@en ;
    rdfs:comment "Classification of the billing run indicating whether it is a regular scheduled run, interim billing, final billing, correction run, reversal run, or special ad-hoc billing event."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Run Type" ;
    cmm:validValues "regular|interim|final|correction|reversal|special" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:BillingRun.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "Planned date and time when the billing run was scheduled to begin execution, used for operational planning and SLA tracking."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillingRun.totalAdjustmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total adjustment amount"@en ;
    rdfs:comment "Aggregate sum of all billing adjustments, credits, and corrections applied during this billing run, including late fees, discounts, and dispute resolutions."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_adjustment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Adjustment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingRun.totalBilledAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total billed amount"@en ;
    rdfs:comment "Aggregate sum of all invoice amounts generated in this billing run before adjustments, representing the gross revenue recognized for the billing period."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_billed_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Billed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingRun.totalNetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total net amount"@en ;
    rdfs:comment "Final aggregate net amount due across all invoices after applying taxes and adjustments, representing the total accounts receivable created by this billing run."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_net_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Net Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillingRun.totalTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total tax amount"@en ;
    rdfs:comment "Aggregate sum of all tax charges calculated and applied across invoices in this billing run, supporting tax reporting and remittance."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:RevenueRecognition a owl:Class ;
    rdfs:label "Revenue Recognition"@en ;
    rdfs:comment "Transactional record capturing revenue recognition entries derived from billed and unbilled revenue for a service agreement and accounting period. Stores recognized revenue amount, deferred revenue amount, unbilled revenue accrual, revenue category (energy, demand, customer charge, rider), accounting period, GL account code, and recognition method. Supports SOX-compliant revenue recognition under ASC 606 and regulatory accounting requirements. Sourced from SAP IS-U FICA and SAP S/4HANA FI integration."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpLedgerEntry ;
    cmm:cimCloseMatch cim:ErpLedgerEntry ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.revenue_recognition" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ASC 606; Revenue Recognition Entry / Unbilled Revenue Accrual" ;
    cmm:sourceObject "energy_utilities_ecm.billing.revenue_recognition" ;
    owl:hasKey ( cmm:RevenueRecognition.revenueRecognitionId ) .

cmm:RevenueRecognition.revenueRecognitionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue recognition id"@en ;
    rdfs:comment "Primary key for revenue_recognition"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:long ;
    cmm:physicalColumn "revenue_recognition_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Revenue Recognition Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:RevenueRecognition.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: External and internal audits test revenue recognition entries for compliance with accounting standards and regulatory requirements. Links revenue entries to the audit engagement where they were tested"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_audit_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ActivityRecord" .
cmm:RevenueRecognition.billingAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing account"@en ;
    rdfs:comment "Reference to the billing account associated with this revenue recognition entry. Supports multi-account revenue tracking."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "billing_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_billing_account_id" ;
    cmm:cimAssociation "ErpLedgerEntry.CustomerAccount" .
cmm:RevenueRecognition.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Reference to the customer service agreement for which revenue is being recognized. Links this revenue recognition entry to the underlying customer contract."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_billing_service_agreement_id" ;
    cmm:cimAssociation "ErpLedgerEntry.CustomerAgreement" .
cmm:RevenueRecognition.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Revenue recognition entries may reference the source invoice for billed revenue. Supports ASC 606 compliance and audit trail."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_invoice_id" ;
    cmm:cimAssociation "ErpLedgerEntry.CustomerBillingInfo" .
cmm:RevenueRecognition.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "Foreign key linking to finance.journal_entry. Business justification: Revenue recognition entries create or reference journal entries for GL posting. Direct linkage ensures audit trail from billing subledger to general ledger, required for SOX compliance, external audit"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Journal Entry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_journal_entry_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpJournal" .
cmm:RevenueRecognition.originalEntryRevenueRecognition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original entry revenue recognition"@en ;
    rdfs:comment "Reference to the original revenue recognition entry being reversed. Populated only when reversal_flag is True. Maintains audit trail for reversals."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:RevenueRecognition ;
    cmm:physicalColumn "original_entry_revenue_recognition_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Revenue Recognition Entry ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_original_entry_revenue_recognition_id" ;
    cmm:cimAssociation "ErpLedgerEntry.ErpLedgerEntry" .
cmm:RevenueRecognition.ppa a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa"@en ;
    rdfs:comment "Foreign key linking to trading.ppa. Business justification: PPA revenue recognition requires contract-specific treatment for bundled energy and RECs under GAAP; direct PPA reference enables proper allocation between energy and environmental attribute revenue s"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:TradingPpa ;
    cmm:physicalColumn "ppa_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ppa Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_ppa_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Agreement" .
cmm:RevenueRecognition.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Foreign key linking to billing.rate_schedule. Business justification: Revenue recognition entries are calculated according to rate schedule rules and must be traceable to the rate schedule version in effect. Currently revenue_recognition has rate_schedule_code (STRING)"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_rate_schedule_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Tariff" .
cmm:RevenueRecognition.renewablePpaSettlement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable ppa settlement"@en ;
    rdfs:comment "Foreign key linking to renewable.ppa_settlement. Business justification: Revenue from PPA settlements must be recognized in correct accounting periods per ASC 606. Financial reporting requires linking settlement amounts to revenue recognition entries for matching generatio"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:PpaSettlement ;
    cmm:physicalColumn "renewable_ppa_settlement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Ppa Settlement Id (Foreign Key)" ;
    cmm:sourceColumn "ppa_settlement_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_renewable_ppa_settlement_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Settlement" .
cmm:RevenueRecognition.revenueInvoiceRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "revenue invoice"@en ;
    rdfs:comment "Reference to the invoice document from which this revenue recognition entry was derived. Null for unbilled revenue accruals."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "revenue_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_revenue_invoice_id" ;
    cmm:cimAssociation "ErpLedgerEntry.CustomerBillingInfo" .
cmm:RevenueRecognition.soxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sox control"@en ;
    rdfs:comment "Foreign key linking to compliance.sox_control. Business justification: Revenue recognition is a key SOX control area for financial statement accuracy. Links specific revenue entries to the SOX control they satisfy, enabling control testing, evidence collection, and audit"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "sox_control_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Sox Control Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_sox_control_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Document" .
cmm:RevenueRecognition.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Revenue from wholesale bilateral trades must be recognized per ASC 606 performance obligations; direct trade linkage enables proper revenue timing, contract modification tracking, and GAAP-compliant f"@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_revenue_recognition_trade_id" ;
    cmm:cimAssociation "ErpLedgerEntry.Trade" .
cmm:RevenueRecognition.accountingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounting period"@en ;
    rdfs:comment "The fiscal accounting period (YYYY-MM format) for which revenue is being recognized. Aligns with financial close calendar and regulatory reporting periods."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "accounting_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounting Period" ;
    cmm:valuePattern "^\\d{4}-(0[1-9]|1[0-2])$" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.adjustmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment amount"@en ;
    rdfs:comment "Any adjustments applied to revenue recognition for corrections, disputes, write-offs, or regulatory true-ups. Positive or negative value."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjustment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Adjustment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "The approval workflow status of this revenue recognition entry. Ensures SOX-compliant segregation of duties for revenue posting."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "draft|pending_approval|approved|rejected|posted" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "The user ID or name of the person who approved this revenue recognition entry for posting to the general ledger."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By User" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "The date and time when this revenue recognition entry was approved for posting. Part of SOX audit trail."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RevenueRecognition.billedRevenueAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billed revenue amount"@en ;
    rdfs:comment "The portion of recognized revenue that has been invoiced to the customer. Sourced from SAP IS-U billing documents."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "billed_revenue_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billed Revenue Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "The business area classification for this revenue (e.g., generation, transmission, distribution, retail). Supports segment reporting under GAAP."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.consumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consumption kwh"@en ;
    rdfs:comment "The kilowatt-hours of energy consumption for which revenue is being recognized. Sourced from meter data management system."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Consumption (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RevenueRecognition.costCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "The organizational cost center responsible for this revenue stream. Supports internal management accounting and profitability analysis."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this revenue recognition entry record was first created in the system. Part of audit trail for record lifecycle."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpLedgerEntry.createdDateTime .
cmm:RevenueRecognition.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this revenue recognition entry. Typically USD for US utilities."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RevenueRecognition.deferredRevenueAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deferred revenue amount"@en ;
    rdfs:comment "The portion of billed revenue that has been collected but not yet earned. Represents liability for future service delivery under ASC 606."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deferred_revenue_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deferred Revenue Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.demandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand kw"@en ;
    rdfs:comment "The peak kilowatt demand for which demand charges are being recognized. Applicable to commercial and industrial rate schedules."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:RevenueRecognition.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "The general ledger account code to which this revenue recognition entry is posted in SAP S/4HANA FI. Maps to FERC account structure."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "The user ID or name of the person or system process that last modified this revenue recognition entry record."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this revenue recognition entry record was last modified. Supports change tracking and audit compliance."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RevenueRecognition.meterReadDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read date"@en ;
    rdfs:comment "The date of the meter reading that forms the basis for billed revenue in this entry. Null for unbilled accruals or non-metered charges."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:date ;
    cmm:physicalColumn "meter_read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Date" ;
    cmm:cimDatatype "Date" .
cmm:RevenueRecognition.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes providing additional context for this revenue recognition entry, including explanations for adjustments or special circumstances."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Revenue Recognition Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:RevenueRecognition.performanceObligation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance obligation"@en ;
    rdfs:comment "Description of the performance obligation satisfied by this revenue recognition entry under ASC 606 (e.g., electricity delivery, capacity reservation)."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_obligation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Obligation" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date this revenue recognition entry was posted to the general ledger in SAP S/4HANA FI. May differ from recognition_date due to period-end adjustments."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:RevenueRecognition.profitCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "The profit center to which this revenue is allocated for segment reporting and profitability analysis."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "profit_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Profit Center" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.recognitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recognition date"@en ;
    rdfs:comment "The specific date on which revenue was recognized in the general ledger. Represents the business event timestamp for this revenue recognition transaction."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:date ;
    cmm:physicalColumn "recognition_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Recognition Date" ;
    cmm:cimDatatype "Date" .
cmm:RevenueRecognition.recognitionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recognition method"@en ;
    rdfs:comment "The accounting method used to recognize this revenue under ASC 606. Indicates whether revenue is recognized at a point in time or over time."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "recognition_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Recognition Method" ;
    cmm:validValues "point_in_time|over_time|accrual|deferral|straight_line" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.recognizedRevenueAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recognized revenue amount"@en ;
    rdfs:comment "The total revenue amount recognized in this accounting period for this service agreement and revenue category. Represents earned revenue under ASC 606."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recognized_revenue_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recognized Revenue Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.regulatoryAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory account code"@en ;
    rdfs:comment "The regulatory accounting code as defined by FERC or state PUC for revenue classification and reporting. Supports regulatory financial statements."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Account Code" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.revenueCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue category"@en ;
    rdfs:comment "Classification of the revenue type being recognized. Distinguishes between energy consumption charges, demand charges, fixed customer charges, regulatory riders, and ancillary services."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Revenue Category" ;
    cmm:validValues "energy|demand|customer_charge|rider|ancillary_service|late_fee" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpLedgerEntry.kind .
cmm:RevenueRecognition.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Customer class for which revenue is being recognized. Aligns with rate class segmentation and regulatory reporting requirements."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:validValues "residential|commercial|industrial|wholesale|municipal|agricultural" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.revenueInvoice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Revenue recognition entries may reference specific invoices for billed revenue. Supports GL reconciliation."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:long ;
    cmm:physicalColumn "revenue_invoice" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RevenueRecognition.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this revenue recognition entry is a reversal of a previous entry. True for reversals, False for original entries."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RevenueRecognition.reversalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason"@en ;
    rdfs:comment "The business reason for reversing this revenue recognition entry (e.g., billing error, customer dispute, regulatory adjustment). Populated only when reversal_flag is True."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Reason" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.revrecToSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revrec to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Revenue recognition entries are derived from billed/unbilled revenue for a specific service agreement and accounting period."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:long ;
    cmm:physicalColumn "revrec_to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RevenueRecognition.riderCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rider code"@en ;
    rdfs:comment "The regulatory rider or surcharge code applied to this revenue recognition entry (e.g., fuel adjustment clause, renewable energy surcharge)."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "rider_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rider Code" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Revenue recognition entries are derived from billed/unbilled revenue for a specific service agreement. Required for ASC 606 compliance."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RevenueRecognition.servicePeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service period end date"@en ;
    rdfs:comment "The end date of the service period for which revenue is being recognized. Defines the end of the consumption or service delivery window."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:RevenueRecognition.servicePeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service period start date"@en ;
    rdfs:comment "The start date of the service period for which revenue is being recognized. Defines the beginning of the consumption or service delivery window."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RevenueRecognition.sourceDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source document number"@en ;
    rdfs:comment "The document number in the source system that originated this revenue recognition entry (e.g., SAP IS-U billing document number, FI document number)."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Source Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RevenueRecognition.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The operational system from which this revenue recognition entry was sourced (SAP IS-U FICA, Oracle CC&B, SAP S/4HANA FI, or manual entry)."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_IS-U|Oracle_CC&B|SAP_S4HANA|Manual_Entry" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.tariffVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff version"@en ;
    rdfs:comment "The version of the tariff rate schedule applied for this revenue recognition entry. Ensures auditability of rate changes."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Version" ;
    cmm:cimDatatype "String" .
cmm:RevenueRecognition.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "The total tax amount included in recognized revenue (sales tax, utility tax, franchise fees). Excluded from net revenue for regulatory reporting."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.unbilledRevenueAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unbilled revenue amount"@en ;
    rdfs:comment "The portion of recognized revenue that has been earned but not yet invoiced. Represents accrued revenue for consumption between last meter read and period end."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unbilled_revenue_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unbilled Revenue Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RevenueRecognition.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "The user ID or name of the person or system process that created this revenue recognition entry record."@en ;
    rdfs:domain cmm:RevenueRecognition ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:BillDispute a owl:Class ;
    rdfs:label "Bill Dispute"@en ;
    rdfs:comment "Master entity representing a customer-initiated dispute against a billed amount or charge on an invoice. Captures dispute open date, disputed invoice, disputed amount, dispute reason (estimated read, rate error, meter malfunction, unauthorized charge), investigation status, resolution type (credit issued, bill upheld, partial adjustment), resolution date, and regulatory escalation flag. Managed within Oracle CC&B and SAP IS-U. Supports PUC complaint tracking and customer service SLAs."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.bill_dispute" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "Bill Dispute / Billing Complaint" ;
    cmm:sourceObject "energy_utilities_ecm.billing.bill_dispute" ;
    owl:hasKey ( cmm:BillDispute.billDisputeId ) .

cmm:BillDispute.billDisputeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill dispute id"@en ;
    rdfs:comment "Unique identifier for the bill dispute record. Primary key."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:long ;
    cmm:physicalColumn "bill_dispute_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Bill Dispute Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account that initiated the dispute."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:BillDispute.billInvoiceRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bill invoice"@en ;
    rdfs:comment "Reference to the invoice being disputed by the customer."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "bill_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_bill_invoice_id" ;
    cmm:cimAssociation "Document.CustomerBillingInfo" .
cmm:BillDispute.creditMemo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "credit memo"@en ;
    rdfs:comment "Reference to the credit memo document issued to the customer account if a credit was granted as part of the resolution."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:CreditMemo ;
    cmm:physicalColumn "credit_memo_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Credit Memo Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_credit_memo_id" ;
    cmm:cimAssociation "Document.ErpReceivable" .
cmm:BillDispute.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User ID of the customer service representative or analyst currently assigned to investigate and resolve the dispute."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned To User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:BillDispute.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: Customers dispute bills due to outages or voltage issues caused by grid reliability events. Real business process: dispute investigation requires referencing the causal grid event to validate customer"@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_grid_reliability_event_id" ;
    cmm:cimAssociation "Document.PSREvent" .
cmm:BillDispute.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Bill disputes reference a specific invoice being contested. This FK is essential for dispute resolution workflow and PUC complaint tracking."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_invoice_id" ;
    cmm:cimAssociation "Document.CustomerBillingInfo" .
cmm:BillDispute.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Disputes often involve meter accuracy, AMI communication failures, or service point configuration issues. This link identifies the physical metering location for field investigation, meter test schedu"@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_bill_dispute_meter_point_id" ;
    cmm:cimAssociation "Document.UsagePoint" .
cmm:BillDispute.adjustmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment amount"@en ;
    rdfs:comment "Monetary amount credited or debited to the customer account as a result of the dispute resolution. Positive values represent credits to customer; negative values represent additional charges."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjustment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillDispute.assignedToTeam a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to team"@en ;
    rdfs:comment "Name or code of the team or department responsible for handling the dispute (e.g., Billing Operations, Meter Services, Revenue Protection)."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "assigned_to_team" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assigned To Team" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.billDisputeToInvoice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill dispute to invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Bill disputes are filed against a specific invoice or charge. This FK is essential for dispute investigation and resolution tracking."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:long ;
    cmm:physicalColumn "bill_dispute_to_invoice" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.billInvoice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill invoice"@en ;
    rdfs:comment "FK to billing.invoice.invoice_id — Bill disputes are raised against a specific invoice. Critical for dispute resolution workflow and PUC complaint tracking."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:long ;
    cmm:physicalColumn "bill_invoice" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User ID of the system user or customer service representative who created the dispute record."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this dispute record was first created in the system."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:BillDispute.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the disputed amount."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BillDispute.customerSatisfactionRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer satisfaction rating"@en ;
    rdfs:comment "Customer-provided satisfaction score for the dispute resolution process, typically on a scale of 1-5 or 1-10."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_satisfaction_rating" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Satisfaction Rating" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.disputeNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute number"@en ;
    rdfs:comment "Externally visible unique dispute case number assigned by the Customer Information System (CIS) for tracking and customer communication."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispute Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillDispute.disputeOpenDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute open date"@en ;
    rdfs:comment "Date when the dispute was formally opened and logged in the system. Represents the business event timestamp for dispute initiation."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "dispute_open_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Open Date" ;
    cmm:cimDatatype "Date" .
cmm:BillDispute.disputeOpenTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute open timestamp"@en ;
    rdfs:comment "Precise timestamp when the dispute record was created in the CIS, including time-of-day for SLA tracking."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispute_open_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Open Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillDispute.disputeReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute reason code"@en ;
    rdfs:comment "Standardized code categorizing the primary reason for the dispute as reported by the customer or identified during investigation. Reference-value candidates: estimated_read|meter_malfunction|rate_error|billing_calculation_error|unauthorized_charge|duplicate_charge|service_quality|high_bill_complaint|tariff_misapplication|proration_error|other."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Reason Code" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.disputeReasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute reason description"@en ;
    rdfs:comment "Detailed free-text explanation of the dispute reason provided by the customer or customer service representative."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Reason Description" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.disputeSourceChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute source channel"@en ;
    rdfs:comment "Channel through which the customer initiated the dispute. Reference-value candidates: call_center|web_portal|mobile_app|email|mail|in_person|field_service|automated_system."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_source_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Source Channel" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.disputeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute status"@en ;
    rdfs:comment "Current lifecycle status of the dispute case in the resolution workflow. Reference-value candidates: open|under_investigation|pending_customer_response|pending_meter_test|pending_field_inspection|resolved|closed|escalated_to_puc|withdrawn."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispute Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:BillDispute.disputeToSa a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute to sa"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Bill disputes are associated with a service agreement for customer service tracking and PUC complaint reporting."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:long ;
    cmm:physicalColumn "dispute_to_sa" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.disputedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disputed amount"@en ;
    rdfs:comment "Total monetary amount in dispute as claimed by the customer. Represents the portion of the invoice the customer contests."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disputed_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disputed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BillDispute.fieldInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field inspection date"@en ;
    rdfs:comment "Date when the field inspection was conducted at the customer premise."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "field_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Field Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:BillDispute.fieldInspectionRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field inspection required flag"@en ;
    rdfs:comment "Indicates whether a field technician visit to the premise is required to investigate the dispute."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "field_inspection_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Field Inspection Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillDispute.investigationNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation notes"@en ;
    rdfs:comment "Detailed notes and findings documented during the dispute investigation process, including meter test results, field inspection outcomes, and billing recalculations."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "investigation_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Investigation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:BillDispute.investigationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation start date"@en ;
    rdfs:comment "Date when formal investigation of the dispute began."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "investigation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:BillDispute.meterTestRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter test required flag"@en ;
    rdfs:comment "Indicates whether a physical meter accuracy test is required as part of the dispute investigation."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "meter_test_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Test Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillDispute.meterTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter test result"@en ;
    rdfs:comment "Outcome of the meter accuracy test if performed, indicating whether the meter was found to be within acceptable tolerance."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Test Result" ;
    cmm:validValues "passed|failed|inconclusive|not_performed" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID of the system user who last modified the dispute record."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this dispute record was last updated."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:BillDispute.preventableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preventable flag"@en ;
    rdfs:comment "Indicates whether the dispute was caused by a preventable error or process failure on the utility's part, used for quality metrics and process improvement."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "preventable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preventable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillDispute.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Priority classification assigned to the dispute based on factors such as disputed amount, customer segment, regulatory risk, or service impact."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:BillDispute.pucComplaintNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc complaint number"@en ;
    rdfs:comment "Official complaint case number assigned by the Public Utility Commission if the dispute was escalated to regulatory review."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_complaint_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Public Utility Commission (PUC) Complaint Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:BillDispute.pucEscalationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc escalation date"@en ;
    rdfs:comment "Date when the dispute was formally escalated to the Public Utility Commission."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "puc_escalation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Escalation Date" ;
    cmm:cimDatatype "Date" .
cmm:BillDispute.regulatoryEscalationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory escalation flag"@en ;
    rdfs:comment "Indicates whether the dispute has been escalated to the Public Utility Commission (PUC) or other regulatory body for formal complaint review."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_escalation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Escalation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillDispute.resolutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution date"@en ;
    rdfs:comment "Date when the dispute was formally resolved and closed."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "resolution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Date" ;
    cmm:cimDatatype "Date" .
cmm:BillDispute.resolutionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution notes"@en ;
    rdfs:comment "Detailed explanation of the resolution decision, including justification for credit issuance, bill upholding, or other actions taken."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Resolution Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:BillDispute.resolutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution timestamp"@en ;
    rdfs:comment "Precise timestamp when the dispute status was changed to resolved or closed."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "resolution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BillDispute.resolutionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution type"@en ;
    rdfs:comment "Classification of how the dispute was resolved, indicating the action taken to close the case. Reference-value candidates: credit_issued|bill_upheld|partial_adjustment|rebill_issued|payment_plan_offered|service_correction|meter_replaced|dispute_withdrawn."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Type" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.rootCauseCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause category"@en ;
    rdfs:comment "Classification of the underlying root cause identified during investigation, used for process improvement and quality tracking. Reference-value candidates: meter_issue|billing_system_error|rate_application_error|customer_misunderstanding|data_entry_error|estimation_error|system_integration_issue|process_failure|other."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:string ;
    cmm:physicalColumn "root_cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Category" ;
    cmm:cimDatatype "String" .
cmm:BillDispute.serviceAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service agreement"@en ;
    rdfs:comment "FK to billing.service_agreement.service_agreement_id — Bill disputes are associated with a service agreement/account. Required for customer service case management."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:BillDispute.slaBreachFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla breach flag"@en ;
    rdfs:comment "Indicates whether the dispute resolution exceeded the target SLA timeframe."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_breach_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Breach Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillDispute.slaTargetResolutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla target resolution date"@en ;
    rdfs:comment "Target date by which the dispute must be resolved according to internal service level agreements or regulatory requirements."@en ;
    rdfs:domain cmm:BillDispute ; rdfs:range xsd:date ;
    cmm:physicalColumn "sla_target_resolution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Target Resolution Date" ;
    cmm:cimDatatype "Date" .

cmm:NemCredit a owl:Class ;
    rdfs:label "Nem Credit"@en ;
    rdfs:comment "Transactional record of NEM (Net Energy Metering) credits earned by a customer with behind-the-meter generation (rooftop solar, battery storage) for excess energy exported to the grid. Captures credit period, exported kWh, credit rate ($/kWh), credit amount, cumulative credit balance, credit expiration date, and applicable NEM tariff version. Sourced from Oracle CC&B NEM billing module. Supports state RPS and NEM regulatory compliance reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:Transaction ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.nem_credit" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NEM tariff; NEM Credit / Net Metering Credit" ;
    cmm:sourceObject "energy_utilities_ecm.billing.nem_credit" ;
    owl:hasKey ( cmm:NemCredit.nemCreditId ) .

cmm:NemCredit.nemCreditId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem credit id"@en ;
    rdfs:comment "Primary key for nem_credit"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:long ;
    cmm:physicalColumn "nem_credit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Nem Credit Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:NemCredit.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account that earned this NEM credit. Links to the customer billing account with behind-the-meter generation."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:NemCredit.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Foreign key linking to billing.billing_service_agreement. Business justification: NEM credits are earned under a specific service agreement that has NEM tariff terms and interconnection agreement details. Currently nem_credit has account_id and premise_id but no direct link to the"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_billing_service_agreement_id" ;
    cmm:cimAssociation "Transaction.CustomerAgreement" .
cmm:NemCredit.complianceRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance rec certificate"@en ;
    rdfs:comment "Foreign key linking to compliance.rec_certificate. Business justification: Net energy metering credits for customer-sited generation are often tied to renewable energy certificates for RPS compliance tracking. Links NEM export credits to the REC issued for that generation fo"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:ComplianceRecCertificate ;
    cmm:physicalColumn "compliance_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Rec Certificate Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_compliance_rec_certificate_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:NemCredit.derInterconnectionPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection point"@en ;
    rdfs:comment "Foreign key linking to distribution.der_interconnection_point. Business justification: NEM credits must reference the specific DER interconnection point for export metering validation, tariff rate application (location-specific export rates), interconnection agreement compliance, and IE"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:DerInterconnectionPoint ;
    cmm:physicalColumn "der_interconnection_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Interconnection Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_der_interconnection_point_id" ;
    cmm:cimAssociation "Transaction.ConnectivityNode" .
cmm:NemCredit.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: NEM credits originate from specific DER installations and must track source system for generation verification, capacity validation, and program eligibility. Required for REC tracking, interconnection"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_der_registry_id" ;
    cmm:cimAssociation "Transaction.PowerElectronicsConnection" .
cmm:NemCredit.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to demand.dr_program. Business justification: Emerging VPP programs allow DR participation for NEM customers with battery storage or controllable DER. Billing systems must track both NEM export credits and DR incentive payments for same customer."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_dr_program_id" ;
    cmm:cimAssociation "Transaction.DemandResponseProgram" .
cmm:NemCredit.generationAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generation asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Net metering credits are generated by specific distributed generation assets (solar, wind) registered in asset_registry. Interconnection compliance, regulatory reporting, credit validation, and capaci"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "generation_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_generation_asset_registry_id" ;
    cmm:cimAssociation "Transaction.Asset" .
cmm:NemCredit.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Reference to the billing invoice on which this NEM credit was applied or carried forward."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_invoice_id" ;
    cmm:cimAssociation "Transaction.CustomerBillingInfo" .
cmm:NemCredit.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: NEM export compensation rates in market-based programs reference real-time or day-ahead LMP at premise location for avoided cost valuation; required for tariff compliance, customer bill calculation, a"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_lmp_price_id" ;
    cmm:cimAssociation "Transaction.PnodeResults" .
cmm:NemCredit.nemForAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nem_for_agreement"@en ;
    rdfs:comment "FK to billing.billing_service_agreement.billing_service_agreement_id — NEM credits are earned by a specific service agreement with behind-the-meter generation. This FK links credits to the customer's NEM billing arrangement."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "nem_for_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_nem_for_agreement" ;
    cmm:cimAssociation "Transaction.CustomerAgreement" .
cmm:NemCredit.netEnergyMetering a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "net energy metering"@en ;
    rdfs:comment "Foreign key linking to metering.net_energy_metering. Business justification: NEM credits are generated from specific DER installations (net_energy_metering records). This link tracks which solar/storage system produced the export, supports RPS compliance reporting, interconnec"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:NetEnergyMetering ;
    cmm:physicalColumn "net_energy_metering_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Net Energy Metering Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_net_energy_metering_id" ;
    cmm:cimAssociation "Transaction.CustomerAgreement" .
cmm:NemCredit.originalCreditNemCredit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original credit nem credit"@en ;
    rdfs:comment "Reference to the original NEM credit transaction that this record adjusts or corrects, establishing audit trail for credit modifications."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:NemCredit ;
    cmm:physicalColumn "original_credit_nem_credit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Credit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_original_credit_nem_credit_id" ;
    cmm:cimAssociation "Transaction.Transaction" .
cmm:NemCredit.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise where the behind-the-meter generation equipment (solar, battery storage) is installed."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_premise_id" ;
    cmm:cimAssociation "Transaction.ServiceLocation" .
cmm:NemCredit.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Reference to the underlying retail rate schedule that determines the credit valuation methodology for exported energy."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_rate_schedule_id" ;
    cmm:cimAssociation "Transaction.Tariff" .
cmm:NemCredit.recHolding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rec holding"@en ;
    rdfs:comment "Foreign key linking to trading.rec_holding. Business justification: Net metering programs bundling RECs with energy credits require tracking which REC inventory supports customer credits for RPS compliance verification, renewable portfolio standard reporting, and envi"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:RecHolding ;
    cmm:physicalColumn "rec_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rec Holding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_rec_holding_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:NemCredit.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: NEM credits and distributed generation exports must be reported in RPS compliance filings and renewable energy program reports. Links NEM credits to the regulatory filing where they were reported for"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_regulatory_filing_id" ;
    cmm:cimAssociation "Transaction.Document" .
cmm:NemCredit.renewablePpaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable ppa contract"@en ;
    rdfs:comment "Foreign key linking to renewable.ppa_contract. Business justification: Some NEM arrangements involve PPA contracts for pricing export compensation above standard tariff rates. Business model for community solar, virtual net metering, and third-party owned systems where P"@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "renewable_ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Ppa Contract Id (Foreign Key)" ;
    cmm:sourceColumn "ppa_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_nem_credit_renewable_ppa_contract_id" ;
    cmm:cimAssociation "Transaction.Agreement" .
cmm:NemCredit.adjustmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment flag"@en ;
    rdfs:comment "Indicates whether this credit transaction is an adjustment or correction to a previously posted NEM credit."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "adjustment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NemCredit.adjustmentReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment reason code"@en ;
    rdfs:comment "Code identifying the reason for adjustment to the NEM credit (e.g., meter read correction, tariff change, billing error correction)."@en ;
