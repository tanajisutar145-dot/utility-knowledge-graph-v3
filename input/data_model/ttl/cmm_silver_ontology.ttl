cmm:IncentiveProgram.paymentFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment frequency"@en ;
    rdfs:comment "Frequency at which incentive payments are issued to participants: one_time = single upfront payment, monthly/quarterly/annual = recurring payments, per_mwh = payment per unit of generation."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_frequency" ;
