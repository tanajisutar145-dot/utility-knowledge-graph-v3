cmm:SelfReport.boardNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board notification date"@en ;
    rdfs:comment "Date when the Board of Directors was notified of this self-reported violation and potential financial exposure."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_notification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Notification Date" ;
