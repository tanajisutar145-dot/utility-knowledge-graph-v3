cmm:CapexExpenditure.netAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net amount"@en ;
    rdfs:comment "The net monetary value of this capital expenditure after deducting taxes and other adjustments. Represents the capitalizable base amount."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
