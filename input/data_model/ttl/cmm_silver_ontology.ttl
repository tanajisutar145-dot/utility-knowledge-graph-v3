    rdfs:label "sgip incentive amount"@en ;
    rdfs:comment "Dollar amount of SGIP incentive applied to offset applicant cost share in USD. Reduces net applicant financial obligation."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "sgip_incentive_amount" ;
