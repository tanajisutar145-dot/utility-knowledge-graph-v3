    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Training Course ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_training_record_training_course_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:TrainingRecord.trainingProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "training program"@en ;
    rdfs:comment "Foreign key linking to compliance.program. Business justification: Training records are delivered as part of a compliance program (e.g., NERC CIP training program, SOX training program). Many training records can be part of one program (1:N). Adding program_id FK lin"@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "training_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_training_record_training_program_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:TrainingRecord.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
