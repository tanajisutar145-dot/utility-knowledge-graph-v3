cmm:Certification.issuingBodyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing body type"@en ;
    rdfs:comment "Classification of the issuing body as external regulatory authority (NERC, FERC), external industry association, external government agency (OSHA, state DMV), or internal utility department."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_body_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Body Type" ;
    cmm:validValues "external_regulatory|external_industry|external_government|internal_utility" ;
    cmm:cimDatatype "String" .
cmm:Certification.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this certification record was last updated in the workforce management system. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:Certification.lastReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last review date"@en ;
    rdfs:comment "Date on which the certification or training program content, requirements, and delivery methods were last reviewed and validated by subject matter experts or regulatory compliance team. Used for quality assurance and continuous improvement."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Review Date" ;
    cmm:cimDatatype "Date" .
cmm:Certification.mandatoryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mandatory flag"@en ;
    rdfs:comment "Indicates whether this certification or training is mandatory for specific job classifications, NERC CIP access roles, or regulatory compliance. True if required by regulation, union agreement, or internal safety policy; False if elective or role-specific."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mandatory_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mandatory Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Certification.minimumPassingScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum passing score"@en ;
    rdfs:comment "Minimum score or percentage required to pass the certification exam or assessment. Null if pass/fail is not score-based (e.g., competency-based assessments, background checks)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_passing_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Passing Score" ;
    cmm:cimDatatype "Decimal" .
cmm:Certification.nercCipRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip required flag"@en ;
    rdfs:comment "Indicates whether this certification is required for personnel with NERC CIP access roles (e.g., NERC CIP Personnel Risk Assessment clearance, NERC CIP security awareness training). True if mandated by NERC CIP-004 personnel risk assessment and training standards."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP (North American Electric Reliability Corporation Critical Infrastructure Protection) Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Certification.nextReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next review date"@en ;
    rdfs:comment "Scheduled date for the next periodic review of the certification or training program content, requirements, and delivery methods. Used for training program governance and compliance assurance."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Review Date" ;
    cmm:cimDatatype "Date" .
cmm:Certification.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional information about the certification or training program, including special requirements, exceptions, historical context, or implementation guidance for workforce administrators."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:Certification.oshaComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha compliance flag"@en ;
    rdfs:comment "Indicates whether this certification or training is required for OSHA workplace safety compliance (e.g., OSHA 10/30-hour training, lockout/tagout, confined space entry, fall protection, arc flash safety). True if mandated by OSHA regulations for utility field and plant operations."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSHA (Occupational Safety and Health Administration) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Certification.passFailCriteria a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pass fail criteria"@en ;
    rdfs:comment "Description of the criteria used to determine successful completion of the certification or training program (e.g., minimum exam score of 80%, successful completion of field practical assessment, supervisor sign-off on competency checklist, background check clearance)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "pass_fail_criteria" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pass/Fail Criteria" ;
    cmm:cimDatatype "String" .
cmm:Certification.prerequisiteCertifications a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prerequisite certifications"@en ;
    rdfs:comment "Comma-separated list of certification codes that must be held before an employee can pursue this certification or training program (e.g., OSHA-10 required before OSHA-30, Apprentice Lineman required before Journeyman Lineman). Null if no prerequisites."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "prerequisite_certifications" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prerequisite Certifications" ;
    cmm:cimDatatype "String" .
cmm:Certification.programOwner a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program owner"@en ;
    rdfs:comment "Name or title of the internal department, manager, or subject matter expert responsible for maintaining the certification or training program content, delivery, and compliance tracking (e.g., Training Manager, Safety Director, Operations Manager, HR Learning and Development)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_owner" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Owner" ;
    cmm:cimDatatype "String" .
cmm:Certification.regulatoryAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory authority"@en ;
    rdfs:comment "Name of the regulatory body or government agency that mandates this certification or training for utility workforce compliance (e.g., NERC, FERC, OSHA, State Public Utility Commission, State Department of Labor, EPA). Null if not mandated by external regulation."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Authority" ;
    cmm:cimDatatype "String" .
cmm:Certification.regulatoryCitation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory citation"@en ;
    rdfs:comment "Specific regulation, standard, or code section that mandates this certification or training (e.g., NERC CIP-004-6 R3, OSHA 29 CFR 1910.147, State Electrical Code Section 123.45). Used for compliance audit trails and regulatory reporting."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_citation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Citation" ;
    cmm:cimDatatype "String" .
cmm:Certification.renewalCycleMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal cycle months"@en ;
    rdfs:comment "Number of months between required renewals or recertifications. Used for workforce planning and compliance tracking. Null if the certification does not require periodic renewal."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:int ;
    cmm:physicalColumn "renewal_cycle_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Cycle Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:Certification.renewalGracePeriodDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal grace period days"@en ;
    rdfs:comment "Number of days after expiration during which the certification holder may continue working while renewal is in progress, per utility policy or union agreement. Null if no grace period is allowed."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:int ;
    cmm:physicalColumn "renewal_grace_period_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Grace Period Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:Certification.trainingDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training duration hours"@en ;
    rdfs:comment "Total number of instructional hours required to complete the training program or qualification assessment. Used for workforce scheduling and labor cost allocation. Null if not applicable (e.g., external certifications obtained outside utility training programs)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "training_duration_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Duration Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:Certification.trainingMaterialsUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training materials url"@en ;
    rdfs:comment "URL or file path to the training curriculum, course materials, study guides, or certification requirements documentation stored in the utility document management system or learning management system (LMS). Null if not available."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "training_materials_url" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Materials URL (Uniform Resource Locator)" ;
    cmm:cimDatatype "String" .
cmm:Certification.trainingVendor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training vendor"@en ;
    rdfs:comment "Name of the external training vendor or provider contracted to deliver this training program, if applicable. Null if training is delivered internally by utility staff."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "training_vendor" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Vendor" ;
    cmm:cimDatatype "String" .
cmm:Certification.unionAgreementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union agreement reference"@en ;
    rdfs:comment "Reference to the collective bargaining agreement article or section that governs this certification or training requirement, including provisions for training time compensation, certification pay differentials, and apprenticeship progression. Null if not covered by union agreement."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_agreement_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Agreement Reference" ;
    cmm:cimDatatype "String" .
cmm:Certification.validityPeriodDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validity period days"@en ;
    rdfs:comment "Number of days the certification or qualification remains valid from the date of issuance or completion before renewal is required. Null if the certification does not expire (e.g., some internal qualifications are valid indefinitely unless revoked)."@en ;
    rdfs:domain cmm:Certification ; rdfs:range xsd:int ;
    cmm:physicalColumn "validity_period_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validity Period Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .

cmm:EmployeeCertification a owl:Class ;
    rdfs:label "Employee Certification"@en ;
    rdfs:comment "SSOT for all individual employee and contractor credential records — covering externally-issued certifications (NERC CIP PRA clearance, OSHA 10/30, CDL, state electrical contractor license, first aid/CPR), internally-assessed qualifications (journeyman lineman, substation operator, generation unit operator, SCADA operator authorization, apprenticeship completions), and training completion records. Captures credential source type (external_certification, internal_qualification, training_completion), issue date, expiration date, issuing authority or internal assessor, certificate number, competency level achieved, assessment date, renewal status, and compliance flag. Drives compliance alerts for expiring credentials, NERC CIP-004 audit evidence, OSHA training compliance, DOT certification tracking, and qualification-based crew dispatch eligibility."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpCompetency ;
    cmm:cimCloseMatch cim:ErpCompetency ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.employee_certification" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; NERC CIP-004 R3 Personnel Risk Assessment Records" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.employee_certification" ;
    owl:hasKey ( cmm:EmployeeCertification.employeeCertificationId ) .

cmm:EmployeeCertification.employeeCertificationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee certification id"@en ;
    rdfs:comment "Unique identifier for the employee certification record. Primary key for the employee certification entity."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:long ;
    cmm:physicalColumn "employee_certification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Employee Certification ID" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeCertification.certification a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "certification"@en ;
    rdfs:comment "Foreign key linking to workforce.certification. Business justification: employee_certification should reference the master certification catalog to normalize certification details. Currently stores certification_name, certification_type, certification_category, issuing_au"@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range cmm:Certification ;
    cmm:physicalColumn "certification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Certification Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_employee_certification_certification_id" ;
    cmm:cimAssociation "ErpCompetency.Skill" .
cmm:EmployeeCertification.primaryEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary employee"@en ;
    rdfs:comment "Identifier of the employee or contractor who holds this certification or qualification. Links to the employee master record in the workforce domain."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_employee_certification_primary_employee_id" ;
    cmm:cimAssociation "ErpCompetency.ErpPersonnel" .
cmm:EmployeeCertification.tertiaryEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — employee_certification is a transactional child of employee. FK required for credential expiration alerts, NERC CIP-004 audit evidence, and qualification-based crew dispatch."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_employee_certification_tertiary_employee_id" ;
    cmm:cimAssociation "ErpCompetency.ErpPersonnel" .
cmm:EmployeeCertification.assessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment date"@en ;
    rdfs:comment "The date on which the employee was assessed or tested for the qualification or competency. Applicable primarily to internal qualifications and skills assessments."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeCertification.assessmentScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment score"@en ;
    rdfs:comment "The numerical score or percentage achieved by the employee on the certification exam or competency assessment. Null if no scored assessment was required."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "assessment_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Score" ;
    cmm:cimDatatype "Decimal" .
cmm:EmployeeCertification.attachmentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "attachment reference"@en ;
    rdfs:comment "Reference identifier or file path to the scanned certificate, training completion document, or other supporting documentation stored in the document management system."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "attachment_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Attachment Reference" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.certificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification status"@en ;
    rdfs:comment "Current lifecycle status of the certification: active (valid and current), expired (past expiration date), suspended (temporarily invalid), revoked (permanently invalid), pending_renewal (renewal in process), in_progress (training/assessment underway)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Status" ;
    cmm:validValues "active|expired|suspended|revoked|pending_renewal|in_progress" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpCompetency.status .
cmm:EmployeeCertification.competencyLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "competency level"@en ;
    rdfs:comment "The level of competency or proficiency achieved by the employee for this certification or qualification (e.g., apprentice, journeyman, master for trades; operator levels for plant/SCADA operators). Reference-value candidates: apprentice|journeyman|master|operator_level_1|operator_level_2|operator_level_3|certified|qualified."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "competency_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Competency Level" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.complianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is currently in compliance with regulatory or internal requirements. True if active and not expired; False if expired, suspended, or revoked."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.costAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost amount"@en ;
    rdfs:comment "The total cost incurred by the utility to obtain or renew this certification for the employee, including training fees, exam fees, travel, and materials. Used for workforce development cost tracking."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_amount" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:EmployeeCertification.costCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the certification cost amount (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:EmployeeCertification.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this certification record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpCompetency.createdDateTime .
cmm:EmployeeCertification.crewDispatchEligibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatch eligibility flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification qualifies the employee for field crew dispatch assignments. True if the certification enables dispatch eligibility (e.g., journeyman lineman, CDL, OSHA training current)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "crew_dispatch_eligibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Dispatch Eligibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.dotComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dot compliance flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is required for DOT compliance (e.g., Commercial Drivers License CDL, DOT medical certification, hazardous materials endorsement). True if DOT-mandated."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dot_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DOT (Department of Transportation) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.employeeCertificationInstanceOfCatalog a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee certification instance of catalog"@en ;
    rdfs:comment "FK to workforce.certification.certification_id — employee_certification references the certification catalog to identify which credential was earned. Required for renewal cycle management and compliance reporting by credential type."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:long ;
    cmm:physicalColumn "employee_certification_instance_of_catalog" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeCertification.employeeCertificationInstanceOfType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employee certification instance of type"@en ;
    rdfs:comment "FK to workforce.certification.certification_id — Each employee certification instance references a certification type from the catalog. This drives renewal requirements, validity periods, and mandatory-for-job-classification rules."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:long ;
    cmm:physicalColumn "employee_certification_instance_of_type" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeCertification.equipmentAuthorization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment authorization"@en ;
    rdfs:comment "Specific equipment, tools, or systems the employee is authorized to operate or maintain based on this certification (e.g., bucket truck, aerial lift, high-voltage switchgear, DMS/SCADA console)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_authorization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Authorization" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "The date on which the certification or qualification expires and requires renewal. Null for certifications with no expiration (e.g., some apprenticeship completions)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:EmployeeCertification.instructorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "instructor name"@en ;
    rdfs:comment "The name of the instructor or assessor who conducted the training or competency assessment. Used for internal quality assurance and audit trails."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "instructor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Instructor Name" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.issueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue date"@en ;
    rdfs:comment "The date on which the certification, qualification, or training completion was officially issued or awarded to the employee."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:date ;
    cmm:physicalColumn "issue_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issue Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeCertification.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this certification record was last updated in the system. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmployeeCertification.lastVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last verification date"@en ;
    rdfs:comment "The date on which the certification was last verified with the issuing authority or through internal audit. Used for NERC CIP audit evidence and compliance validation."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeCertification.nercCipFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is required for NERC CIP compliance, specifically for personnel with access to critical cyber assets or bulk electric system facilities. True if NERC CIP-004 Personnel Risk Assessment or related training."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP (Critical Infrastructure Protection) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, special conditions, restrictions, or context related to the certification (e.g., conditional approval, specific limitations, renewal in progress details)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EmployeeCertification.oshaComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha compliance flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is required for OSHA safety compliance (e.g., OSHA 10/30-hour training, confined space, lockout/tagout, fall protection). True if OSHA-mandated."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSHA (Occupational Safety and Health Administration) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.passingScoreThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "passing score threshold"@en ;
    rdfs:comment "The minimum score or percentage required to pass the certification exam or competency assessment. Used to determine qualification status."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "passing_score_threshold" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Passing Score Threshold" ;
    cmm:cimDatatype "Decimal" .
cmm:EmployeeCertification.qualificationArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualification area"@en ;
    rdfs:comment "The specific technical or operational area for which the employee is qualified (e.g., transmission line work, substation maintenance, generation unit operation, SCADA system operation, meter installation)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "qualification_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Qualification Area" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.regulatoryRequirementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory requirement flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is mandated by external regulatory bodies (NERC, OSHA, DOT, EPA, state licensing boards). True if regulatory-required; False if internal or voluntary."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_requirement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Requirement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.renewalReminderDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal reminder days"@en ;
    rdfs:comment "Number of days before expiration that renewal reminder notifications should be triggered. Used by compliance alert systems to notify employees and managers of upcoming expirations."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:int ;
    cmm:physicalColumn "renewal_reminder_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Reminder Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeCertification.renewalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal status"@en ;
    rdfs:comment "Status of the certification renewal process: not_required (no expiration), upcoming (renewal due soon), overdue (past expiration), in_progress (renewal underway), completed (renewal finished)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "renewal_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Status" ;
    cmm:validValues "not_required|upcoming|overdue|in_progress|completed" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.trainingHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training hours"@en ;
    rdfs:comment "Total number of training hours completed to achieve this certification or qualification. Used for OSHA compliance reporting and internal training tracking."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "training_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:EmployeeCertification.trainingProvider a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training provider"@en ;
    rdfs:comment "The name of the organization or vendor that delivered the training program (e.g., internal training department, external training vendor, community college, trade association)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "training_provider" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Provider" ;
    cmm:cimDatatype "String" .
cmm:EmployeeCertification.unionRequirementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union requirement flag"@en ;
    rdfs:comment "Boolean indicator of whether this certification is required by collective bargaining agreements or union contracts. True if union-mandated."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "union_requirement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Requirement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeCertification.verificationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification method"@en ;
    rdfs:comment "The method used to verify the authenticity and validity of the certification: issuer_database (checked with issuing authority), physical_certificate (physical document reviewed), employee_attestation (employee self-certification), manager_verification (manager confirmed), third_party_audit (external auditor verified)."@en ;
    rdfs:domain cmm:EmployeeCertification ; rdfs:range xsd:string ;
    cmm:physicalColumn "verification_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Verification Method" ;
    cmm:validValues "issuer_database|physical_certificate|employee_attestation|manager_verification|third_party_audit" ;
    cmm:cimDatatype "String" .

cmm:SafetyIncident a owl:Class ;
    rdfs:label "Safety Incident"@en ;
    rdfs:comment "OSHA-recordable and non-recordable safety events, compliance incidents, and DOT/utility-mandated drug and alcohol test results for utility workforce. Captures event category (injury, near_miss, vehicle_accident, hazmat_exposure, drug_alcohol_test, fitness_for_duty), event date/time, location, employee(s) involved, severity classification, OSHA recordability flag, days away/restricted/transferred, root cause analysis, corrective actions, OSHA 300 log reference, and follow-up actions. For drug/alcohol test events: captures DOT 49 CFR Part 40 test type (pre-employment, random, post-accident, reasonable suspicion, return-to-duty), testing provider, result (negative/positive/refused), MRO review status, SAP referral, and chain-of-custody documentation. SSOT for all safety events and DOT compliance testing. Supports OSHA 300/300A annual reporting, TRIR/DART rate calculation, DOT 49 CFR Part 40 compliance, and safety performance trending."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Incident ;
    cmm:cimExtends cim:Incident ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.safety_incident" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "OSHA 300; OSHA 29 CFR 1904 Recordkeeping; OSHA 300 Log" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.safety_incident" ;
    owl:hasKey ( cmm:SafetyIncident.safetyIncidentId ) .

cmm:SafetyIncident.safetyIncidentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident id"@en ;
    rdfs:comment "Unique identifier for the safety incident record. Primary key for the safety incident entity."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:long ;
    cmm:physicalColumn "safety_incident_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Safety Incident ID" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyIncident.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Identifier of the utility facility where the incident occurred (generation plant, substation, service center, warehouse). Links to asset facility master data."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_power_plant_id" ;
    cmm:cimAssociation "Incident.Plant" .
cmm:SafetyIncident.primarySafetyEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary safety employee"@en ;
    rdfs:comment "Identifier of the primary employee involved in the safety incident. Links to workforce employee master data."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_safety_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_primary_safety_employee_id" ;
    cmm:cimAssociation "Incident.ErpPersonnel" .
cmm:SafetyIncident.quaternarySafetyModifiedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "quaternary safety modified by employee"@en ;
    rdfs:comment "Identifier of the employee who last modified the safety incident record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "quaternary_safety_modified_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_quaternary_safety_modified_by_employee_id" ;
    cmm:cimAssociation "Incident.ErpPersonnel" .
cmm:SafetyIncident.safetyEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety employee"@en ;
    rdfs:comment "FK to workforce.employee.employee_id — Safety incidents involve specific employees. OSHA 300 log reporting requires employee identification. Note: may need a junction for multi-employee incidents, but the primary FK is essential."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "safety_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_safety_employee_id" ;
    cmm:cimAssociation "Incident.ErpPersonnel" .
cmm:SafetyIncident.tertiarySafetyReportedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary safety reported by employee"@en ;
    rdfs:comment "Identifier of the employee who reported the incident. May differ from the injured employee in cases of witness reporting or near-miss observations."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_safety_reported_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reported By Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_tertiary_safety_reported_by_employee_id" ;
    cmm:cimAssociation "Incident.ErpPersonnel" .
cmm:SafetyIncident.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the work order being executed when the incident occurred. Links incident to maintenance or construction activity for root cause analysis."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_incident_work_order_id" ;
    cmm:cimAssociation "Incident.Work" .
cmm:SafetyIncident.bodyPartAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "body part affected"@en ;
    rdfs:comment "Body part(s) injured in the incident (e.g., hand, back, eyes, head, multiple). Used for injury trend analysis and PPE effectiveness evaluation."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "body_part_affected" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Body Part Affected" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.chainOfCustodyNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "chain of custody number"@en ;
    rdfs:comment "Unique identifier for the drug/alcohol test specimen chain-of-custody documentation. Links to laboratory records and ensures specimen integrity per DOT requirements."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "chain_of_custody_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Chain of Custody Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SafetyIncident.correctiveActions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective actions"@en ;
    rdfs:comment "Documented corrective and preventive actions taken or planned to prevent recurrence of similar incidents (e.g., procedure revision, additional training, equipment modification, PPE upgrade)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_actions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Actions" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the safety incident record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Incident.createdDateTime .
cmm:SafetyIncident.daysAwayFromWork a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "days away from work"@en ;
    rdfs:comment "Number of calendar days the employee was unable to work as a result of the incident. Used to calculate DART (Days Away, Restricted, or Transferred) rate."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:int ;
    cmm:physicalColumn "days_away_from_work" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Days Away From Work" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyIncident.daysOnRestrictedDuty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "days on restricted duty"@en ;
    rdfs:comment "Number of calendar days the employee was on restricted work activity or job transfer due to the incident. Used to calculate DART rate."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:int ;
    cmm:physicalColumn "days_on_restricted_duty" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Days on Restricted Duty" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyIncident.dotTestType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dot test type"@en ;
    rdfs:comment "For drug/alcohol test incidents: type of DOT-mandated test per 49 CFR Part 40. Pre-employment (before hire), random (unannounced selection), post-accident (after qualifying incident), reasonable suspicion (supervisor-initiated), return-to-duty (after violation), follow-up (ongoing monitoring)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "dot_test_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DOT (Department of Transportation) Test Type" ;
    cmm:validValues "pre_employment|random|post_accident|reasonable_suspicion|return_to_duty|follow_up" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.environmentalConditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental conditions"@en ;
    rdfs:comment "Description of environmental factors at the time of the incident (e.g., weather, lighting, temperature, noise level, confined space). Used for root cause analysis."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "environmental_conditions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Conditions" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.equipmentInvolved a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment involved"@en ;
    rdfs:comment "Description or identifier of equipment, tools, or vehicles involved in the incident. Used to identify equipment-related hazards and maintenance needs."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_involved" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Involved" ;
    cmm:cimDatatype "String" .
cmm:SafetyIncident.incidentCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident category"@en ;
    rdfs:comment "Classification of the safety event type: injury (physical harm), near_miss (potential incident avoided), vehicle_accident (fleet collision), hazmat_exposure (hazardous material contact), drug_alcohol_test (DOT compliance testing), fitness_for_duty (medical clearance event)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "incident_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Incident Category" ;
    cmm:validValues "injury|near_miss|vehicle_accident|hazmat_exposure|drug_alcohol_test|fitness_for_duty" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Incident.kind .
cmm:SafetyIncident.incidentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident date"@en ;
    rdfs:comment "Calendar date when the safety incident occurred. Critical for OSHA 300 log chronological recording and regulatory reporting timelines."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:date ;
    cmm:physicalColumn "incident_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incident Date" ;
    cmm:cimDatatype "Date" .
cmm:SafetyIncident.incidentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident description"@en ;
    rdfs:comment "Detailed narrative description of how the incident occurred, what the employee was doing, and the sequence of events leading to the incident."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "incident_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Incident Description" ;
    cmm:cimDatatype "String" ;
