cmm:SparePartsInventory.manufacturerPartNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer part number"@en ;
    rdfs:comment "Original equipment manufacturer's part number or catalog number for the spare part. Used for cross-referencing, procurement, and ensuring correct part substitution."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer_part_number" ;
