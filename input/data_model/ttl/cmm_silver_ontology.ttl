    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Incentive Enrollment - Renewable Incentive Program Id" ;
    cmm:sourceColumn "incentive_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_service_agreement_incentive_enrollment_renewable_incentive_program_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ServiceAgreementIncentiveEnrollment.serviceAgreementBillingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
