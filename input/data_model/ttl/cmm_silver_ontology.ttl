cmm:EmissionsReport.submissionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "submission status"@en ;
    rdfs:comment "The current status of the emissions report submission to the regulatory agency."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "submission_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
