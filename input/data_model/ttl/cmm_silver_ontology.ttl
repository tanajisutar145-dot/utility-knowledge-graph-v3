    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "NetworkAssociation Id" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkAssociation.associationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "association type"@en ;
