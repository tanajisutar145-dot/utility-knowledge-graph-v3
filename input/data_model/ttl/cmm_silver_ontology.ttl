cmm:SparePartsInventory.reorderPoint a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reorder point"@en ;
    rdfs:comment "Inventory level at which a purchase requisition or replenishment order should be automatically generated. Calculated based on lead time demand plus safety stock."@en ;
