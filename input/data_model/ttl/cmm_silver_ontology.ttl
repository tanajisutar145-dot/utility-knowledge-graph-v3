cmm:SafetyIncident.incidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident number"@en ;
    rdfs:comment "Business identifier for the safety incident, typically formatted as SI-YYYYMMDD-sequence for external reference and reporting."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Incident Number" ;
    cmm:valuePattern "^SI-[0-9]{8}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SafetyIncident.incidentTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident time"@en ;
    rdfs:comment "Precise timestamp when the safety incident occurred, including time zone. Used for shift analysis, response time calculation, and detailed incident reconstruction."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "incident_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
