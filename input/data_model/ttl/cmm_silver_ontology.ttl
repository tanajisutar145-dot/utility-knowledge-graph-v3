    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "contest_resolution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contest Resolution Date" ;
    cmm:cimDatatype "Date" .
cmm:PenaltyAssessment.contestedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contested flag"@en ;
    rdfs:comment "Indicates whether the utility formally contested or appealed the penalty assessment."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contested_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Contested Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PenaltyAssessment.cooperationCreditFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
