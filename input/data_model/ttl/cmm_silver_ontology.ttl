    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Speed Miles Per Hour (MPH)" ;
    cmm:unitSymbol "mph" ;
    cmm:cimDatatype "Speed" .
cmm:TransmissionOutage.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Work order or job number associated with the outage event, linking to asset management and maintenance systems."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
