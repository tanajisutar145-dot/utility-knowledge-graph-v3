    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:UnitCertificationRequirement.unitTypeApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit type applicability"@en ;
    rdfs:comment "The generating unit technology types for which this certification is required. Comma-separated list (e.g., 'CCGT,COAL,NUCLEAR' or 'ALL'). Different unit types require different operator qualifications and safety certifications."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:string ;
