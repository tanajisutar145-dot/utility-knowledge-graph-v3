cmm:NercCipAsset.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this CIP asset record was first created in the registry. Used for audit trail and compliance documentation."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
