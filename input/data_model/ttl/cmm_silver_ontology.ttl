cmm:ControlArea.tieLineCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tie line count"@en ;
    rdfs:comment "Number of transmission tie lines connecting this control area to adjacent control areas for interchange scheduling and metering."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:int ;
