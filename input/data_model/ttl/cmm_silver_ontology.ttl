    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.phone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phone"@en ;
    rdfs:comment "General telephone number for the contractor company."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
