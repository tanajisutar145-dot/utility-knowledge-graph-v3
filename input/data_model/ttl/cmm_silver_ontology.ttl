    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_specification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Specification" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.protectionComplianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection compliance status"@en ;
    rdfs:comment "Current verification status of the DER systems compliance with all required protection system functions and settings."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Compliance Status" ;
    cmm:validValues "pending|verified|non_compliant|waived" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.protectionRelayModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection relay model"@en ;
    rdfs:comment "Specific model number of the protective relay equipment installed or required for the DER system."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_relay_model" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Relay Model" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.protectionRelayRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection relay required flag"@en ;
    rdfs:comment "Indicates whether utility-grade protective relaying equipment is required for this DER system interconnection based on capacity and grid impact."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "protection_relay_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Relay Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerSystem.resourceClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resource classification"@en ;
    rdfs:comment "Functional classification of the DER system indicating whether it primarily generates energy, stores energy, or serves as a controllable load."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "resource_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resource Classification" ;
    cmm:validValues "generation|storage|hybrid|load" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.sgipEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip eligible flag"@en ;
    rdfs:comment "Indicates whether the DER system qualifies for SGIP incentives for distributed energy storage and generation technologies."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerSystem.systemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system name"@en ;
    rdfs:comment "Business name or identifier assigned to the distributed energy resource system by the applicant or utility."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "DER System Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DerSystem.systemStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system status"@en ;
    rdfs:comment "Current lifecycle status of the DER system in the interconnection and operational process."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "system_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "DER System Status" ;
    cmm:validValues "proposed|approved|installed|commissioned|operational|decommissioned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PowerElectronicsConnection.status .
cmm:DerSystem.utilityAdditionalProtectionRequirements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility additional protection requirements"@en ;
    rdfs:comment "Description of any additional protection system requirements imposed by the utility beyond IEEE 1547 mandatory functions."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "utility_additional_protection_requirements" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utility Additional Protection Requirements" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer warranty coverage for the DER system equipment expires."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:PoiSpecification a owl:Class ;
    rdfs:label "Poi Specification"@en ;
    rdfs:comment "Technical specification record defining the Point of Interconnection (POI) on the utility distribution network where a DER system will connect. Captures POI location (GIS coordinates, feeder ID, transformer ID, circuit segment), voltage level (120V/240V/480V/12kV), phase configuration (single-phase/three-phase), available hosting capacity (kW) at the POI at time of application, maximum export limit (kW), anti-islanding protection requirements, interconnection equipment requirements (disconnect switch, meter socket, protective relay), and utility-assigned POI identifier. Links to the distribution network topology managed in the distribution domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ConnectivityNode ;
    cmm:cimCloseMatch cim:ConnectivityNode ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.poi_specification" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEEE 1547; POI (Point of Interconnection) Technical Specification" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.poi_specification" ;
    owl:hasKey ( cmm:PoiSpecification.poiSpecificationId ) .

cmm:PoiSpecification.poiSpecificationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi specification id"@en ;
    rdfs:comment "Unique identifier for the POI specification record. Primary key."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:long ;
    cmm:physicalColumn "poi_specification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Point of Interconnection (POI) Specification ID" ;
    cmm:cimDatatype "Integer" .
cmm:PoiSpecification.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Foreign key linking to grid.ems_node. Business justification: Point of interconnection specifications must reference the specific EMS bus/node where DER connects for state estimation modeling, power flow analysis, and contingency analysis. Required for accurate"@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Node Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_ems_node_id" ;
    cmm:cimAssociation "ConnectivityNode.TopologicalNode" .
cmm:PoiSpecification.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit where the POI is located. Links to the distribution network topology managed in the distribution domain."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_feeder_id" ;
    cmm:cimAssociation "ConnectivityNode.Feeder" .
cmm:PoiSpecification.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Point of interconnection specifications are evaluated within forecast zone context for available hosting capacity, voltage regulation requirements, and grid impact studies. Engineering standard - POI"@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_forecast_zone_id" ;
    cmm:cimAssociation "ConnectivityNode.LoadArea" .
cmm:PoiSpecification.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Point of interconnection specifications define the exact service point for metering configuration, CT/PT ratios, and interval data collection requirements. Engineering design depends on this link."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_meter_point_id" ;
    cmm:cimAssociation "ConnectivityNode.UsagePoint" .
cmm:PoiSpecification.poiApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "poi application"@en ;
    rdfs:comment "FK to interconnection.interconnection_application.interconnection_application_id — Each POI specification is defined for a specific interconnection application. The POI is where the applicant's DER connects to the grid. Without this FK, you cannot associate the technical POI details"@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "poi_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_poi_application_id" ;
    cmm:cimAssociation "ConnectivityNode.Request" .
cmm:PoiSpecification.poiInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "poi interconnection application"@en ;
    rdfs:comment "Reference to the parent interconnection application that this POI specification supports."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "poi_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_poi_interconnection_application_id" ;
    cmm:cimAssociation "ConnectivityNode.Request" .
cmm:PoiSpecification.primaryPoiEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary poi employee"@en ;
    rdfs:comment "User identifier of the utility engineer who created the POI specification."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_poi_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_primary_poi_employee_id" ;
    cmm:cimAssociation "ConnectivityNode.ErpPersonnel" .
cmm:PoiSpecification.transformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transformer"@en ;
    rdfs:comment "Identifier of the distribution transformer serving the POI location. Used for hosting capacity analysis and voltage impact studies."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_poi_specification_transformer_id" ;
    cmm:cimAssociation "ConnectivityNode.PowerTransformer" .
cmm:PoiSpecification.antiIslandingProtectionRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "anti islanding protection required"@en ;
    rdfs:comment "Indicates whether anti-islanding protection is required at this POI to prevent the DER from energizing a de-energized portion of the utility grid."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "anti_islanding_protection_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Anti-Islanding Protection Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.approvedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved date"@en ;
    rdfs:comment "Date when the POI specification was formally approved by utility engineering for interconnection."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:date ;
    cmm:physicalColumn "approved_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "POI Specification Approved Date" ;
    cmm:cimDatatype "Date" .
cmm:PoiSpecification.availableHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "available hosting capacity kw"@en ;
    rdfs:comment "Available hosting capacity in kilowatts at the POI at the time of application. Represents the maximum DER generation that can be accommodated without distribution system upgrades."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "available_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:PoiSpecification.circuitSegmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "circuit segment code"@en ;
    rdfs:comment "Identifier of the specific circuit segment or span where the POI is located on the distribution network."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "circuit_segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Circuit Segment ID" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "Communication protocol required for DER monitoring and control at the POI. Used for DERMS integration and demand response programs."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:validValues "modbus|dnp3|ieee_2030_5|sunspec|none" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the POI specification record was first created in the system."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ConnectivityNode.createdDateTime .
cmm:PoiSpecification.disconnectSwitchRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnect switch required"@en ;
    rdfs:comment "Indicates whether a visible, lockable disconnect switch is required at the POI for utility access and safety."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disconnect_switch_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnect Switch Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.distributionUpgradesRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution upgrades required"@en ;
    rdfs:comment "Indicates whether distribution system upgrades (transformer replacement, conductor upgrades, voltage regulator additions) are required to accommodate the DER interconnection at this POI."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "distribution_upgrades_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distribution Upgrades Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.engineeringNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engineering notes"@en ;
    rdfs:comment "Free-text engineering notes and special considerations for the POI specification. Captures site-specific constraints and technical requirements."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "engineering_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Engineering Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:PoiSpecification.estimatedUpgradeCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated upgrade cost usd"@en ;
    rdfs:comment "Estimated cost in US dollars for any required distribution system upgrades to enable interconnection at this POI. May be allocated to the interconnection customer."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_upgrade_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Upgrade Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PoiSpecification.faultCurrentContributionLimitA a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault current contribution limit a"@en ;
    rdfs:comment "Maximum allowable fault current contribution in amperes from the DER system to the utility grid during fault conditions. Used to ensure protective device coordination."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_current_contribution_limit_a" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Current Contribution Limit (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:PoiSpecification.frequencyResponseCapabilityRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency response capability required"@en ;
    rdfs:comment "Indicates whether the DER system must provide frequency-watt droop response capability to support grid frequency stability."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "frequency_response_capability_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Response Capability Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.gisLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the POI location in decimal degrees. Used for spatial analysis and network modeling."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gis_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Information System (GIS) Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:PoiSpecification.gisLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the POI location in decimal degrees. Used for spatial analysis and network modeling."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gis_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Information System (GIS) Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:PoiSpecification.groundingRequirements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grounding requirements"@en ;
    rdfs:comment "Grounding and bonding requirements at the POI to ensure electrical safety and proper fault current paths."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "grounding_requirements" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grounding Requirements" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.interconnectionEquipmentRequirements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection equipment requirements"@en ;
    rdfs:comment "Detailed description of all interconnection equipment required at the POI including disconnect switches, protective relays, meters, and communication devices."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_equipment_requirements" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Equipment Requirements" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.interconnectionStudyRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection study required"@en ;
    rdfs:comment "Type of interconnection impact study required for this POI based on DER size and hosting capacity. Determines review process and timeline."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_study_required" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Study Required" ;
    cmm:validValues "none|screening|supplemental|facilities" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.maximumExportLimitKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum export limit kw"@en ;
    rdfs:comment "Maximum allowable export power in kilowatts from the DER system to the utility grid at this POI. May be less than the DER nameplate capacity."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_export_limit_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Export Limit (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:PoiSpecification.maximumImportLimitKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum import limit kw"@en ;
    rdfs:comment "Maximum allowable import power in kilowatts from the utility grid to the customer premises at this POI. Relevant for battery storage and EV charging applications."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_import_limit_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Import Limit (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:PoiSpecification.meterSocketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter socket type"@en ;
    rdfs:comment "Type of meter socket required at the POI for bidirectional metering of DER generation and consumption. Specifies form factor and AMI compatibility."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_socket_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Socket Type" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when the POI specification record was last modified."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PoiSpecification.nemEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem eligible"@en ;
    rdfs:comment "Indicates whether this POI is eligible for Net Energy Metering tariff enrollment based on location, voltage level, and hosting capacity."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Eligible" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration at the POI (single-phase or three-phase). Critical for inverter selection and protection coordination."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase_wye|three_phase_delta|split_phase" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.poiIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi identifier"@en ;
    rdfs:comment "Utility-assigned unique identifier for the POI location on the distribution network. This is the externally-known business identifier used in engineering documents and interconnection agreements."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Identifier" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.powerQualityMonitoringRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power quality monitoring required"@en ;
    rdfs:comment "Indicates whether power quality monitoring equipment is required at the POI to track voltage, frequency, harmonics, and power factor."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "power_quality_monitoring_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Quality Monitoring Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.protectiveRelayRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protective relay required"@en ;
    rdfs:comment "Indicates whether a protective relay is required at the POI for over/under voltage, over/under frequency, and fault protection."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "protective_relay_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protective Relay Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.rideThroughCapabilityRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ride through capability required"@en ;
    rdfs:comment "Indicates whether the DER system must remain connected during voltage and frequency disturbances (low/high voltage ride-through and low/high frequency ride-through)."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ride_through_capability_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ride-Through Capability Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.serviceVoltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage level"@en ;
    rdfs:comment "Nominal voltage level at the POI where the DER system will interconnect. Determines equipment requirements and protection schemes."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Level" ;
    cmm:validValues "120V|240V|208V|277V|480V|12kV|13.2kV|13.8kV|25kV|34.5kV" ;
    cmm:cimDatatype "String" .
cmm:PoiSpecification.sgipEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip eligible"@en ;
    rdfs:comment "Indicates whether this POI location is eligible for SGIP incentives for battery storage and other distributed energy resources."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Eligible" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.specificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "specification date"@en ;
    rdfs:comment "Date when the POI specification was created or last revised by utility engineering."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:date ;
    cmm:physicalColumn "specification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "POI Specification Date" ;
    cmm:cimDatatype "Date" .
cmm:PoiSpecification.specificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "specification status"@en ;
    rdfs:comment "Current lifecycle status of the POI specification in the technical review and approval process."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:string ;
    cmm:physicalColumn "specification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "POI Specification Status" ;
    cmm:validValues "draft|under_review|approved|rejected|superseded|archived" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ConnectivityNode.status .
cmm:PoiSpecification.telemetryRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "telemetry required"@en ;
    rdfs:comment "Indicates whether real-time telemetry data from the POI must be transmitted to utility SCADA or DERMS systems."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "telemetry_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Telemetry Required" ;
    cmm:cimDatatype "Boolean" .
cmm:PoiSpecification.voltageRegulationCapabilityRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage regulation capability required"@en ;
    rdfs:comment "Indicates whether the DER inverter must provide voltage regulation capability (volt-VAR or volt-watt control) at the POI."@en ;
    rdfs:domain cmm:PoiSpecification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "voltage_regulation_capability_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Regulation Capability Required" ;
    cmm:cimDatatype "Boolean" .

cmm:TechnicalReview a owl:Class ;
    rdfs:label "Technical Review"@en ;
    rdfs:comment "Record of the utility engineering technical review conducted for an interconnection application. Captures review type (initial completeness check, supplemental review, independent study), assigned engineer, review start and completion dates, screening criteria applied (15% rule, 100% rule, Fast Track screens per FERC Order 2023), screening pass/fail result, identified technical issues (voltage violations, thermal overloads, protection coordination conflicts, power quality concerns), required mitigation measures, and review disposition (approved, conditionally approved, requires impact study). One application may have multiple sequential technical reviews."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.technical_review" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEEE 1547 / FERC Order 2023 Technical Screening" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.technical_review" ;
    owl:hasKey ( cmm:TechnicalReview.technicalReviewId ) .

cmm:TechnicalReview.technicalReviewId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technical review id"@en ;
    rdfs:comment "Unique identifier for the technical review record. Primary key."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:long ;
    cmm:physicalColumn "technical_review_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Technical Review Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:TechnicalReview.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Technical reviews are conducted FOR a specific application. One application may have multiple sequential reviews. This FK is essential for tracking review outcomes back to the application."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:TechnicalReview.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Technical reviews assess DER impact on control area operations including reserve requirements, regulation capacity, CPS1/CPS2 performance, and frequency response obligations. Determines whether DER ca"@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:TechnicalReview.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation serving the interconnection point. Used for system impact analysis and capacity planning."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_distribution_substation_id" ;
    cmm:cimAssociation "Document.Substation" .
cmm:TechnicalReview.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder or circuit where the Distributed Energy Resource (DER) will interconnect. Used for load flow analysis and capacity assessment."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_feeder_id" ;
    cmm:cimAssociation "Document.Feeder" .
cmm:TechnicalReview.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Technical reviews reference specific load forecasts to assess feeder capacity and hosting capacity. IEEE 1547 fast-track screening criteria explicitly compare DER capacity to feeder minimum load from"@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_load_id" ;
    cmm:cimAssociation "Document.ConformLoadSchedule" .
cmm:TechnicalReview.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Technical reviews verify compliance with specific regulatory standards (IEEE 1547-2018, UL 1741-SA, state technical requirements). Each review validates adherence to applicable obligations. Essential"@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:TechnicalReview.primaryTechnicalEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary technical employee"@en ;
    rdfs:comment "Reference to the utility engineer responsible for conducting this technical review. Links to the workforce or employee registry."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_technical_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned Engineer Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_primary_technical_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TechnicalReview.technicalApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "technical application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Technical reviews are performed FOR a specific interconnection application. One application may have multiple sequential reviews. This is the core workflow link."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "technical_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_technical_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:TechnicalReview.technicalInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "technical interconnection application"@en ;
    rdfs:comment "Reference to the interconnection application being reviewed. Links this technical review to the parent application record."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "technical_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_technical_review_technical_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:TechnicalReview.aggregateDerCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregate der capacity kw"@en ;
    rdfs:comment "Total aggregate capacity in kilowatts of all Distributed Energy Resources (DERs) on the line section including the proposed DER. Used for Fast Track Screen 2 evaluation (100% rule)."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "aggregate_der_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
