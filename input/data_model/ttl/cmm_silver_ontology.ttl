cmm:AssetInspection.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Regular inspections of DER installations for safety compliance, performance verification, and interconnection agreement requirements. Mandated by most jurisdictions for NEM programs, feed-in tariffs,"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
