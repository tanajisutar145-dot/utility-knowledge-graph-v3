cmm:RateSchedule.minimumDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum demand kw"@en ;
    rdfs:comment "Minimum demand threshold in kilowatts required for customer eligibility under this rate schedule. Null if no minimum applies."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_demand_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Demand (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:RateSchedule.minimumPowerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum power factor"@en ;
    rdfs:comment "Minimum power factor threshold required to avoid penalties. Expressed as a decimal between 0 and 1. Null if power factor penalties do not apply."@en ;
