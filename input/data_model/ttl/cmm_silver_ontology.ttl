cmm:AssetInspection.transmissionLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission line"@en ;
    rdfs:comment "Foreign key linking to transmission.line. Business justification: Transmission line inspections (aerial patrols, ground inspections, LiDAR surveys, drone inspections) are line-specific and required for NERC FAC standards compliance, vegetation management, and struct"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:TransmissionLine ;
    cmm:physicalColumn "transmission_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Line Id (Foreign Key)" ;
    cmm:sourceColumn "line_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_transmission_line_id" ;
    cmm:cimAssociation "InspectionDataSet.Line" .
cmm:AssetInspection.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Substation inspections (thermographic surveys, equipment condition assessments, oil sampling, visual inspections) are performed at specific substations and must be tracked for NERC compliance, mainten"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
