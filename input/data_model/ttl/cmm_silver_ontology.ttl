    cmm:cimCloseMatch cim:Name.name .
cmm:EmergencyStockEvent.femaReimbursementEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fema reimbursement eligible flag"@en ;
