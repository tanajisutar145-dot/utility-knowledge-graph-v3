cmm:Contingency.thermalOverloadThresholdPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal overload threshold percent"@en ;
    rdfs:comment "Percentage of rated capacity that defines a thermal overload violation for transmission elements in this contingency (e.g., 100.0 for normal rating, 120.0 for emergency rating)."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "thermal_overload_threshold_percent" ;
