    cmm:cimDatatype "Date" .
cmm:TechnicalReview.reviewNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review number"@en ;
    rdfs:comment "Business identifier for the technical review. Human-readable unique number assigned to this review for tracking and reference purposes."@en ;
