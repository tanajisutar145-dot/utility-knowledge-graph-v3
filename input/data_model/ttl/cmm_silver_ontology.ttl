cmm:PostalAddress.isSeasonalAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is seasonal address"@en ;
    rdfs:comment "Indicates whether this address is used seasonally (e.g., vacation homes, seasonal businesses). True if seasonal, False otherwise."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_seasonal_address" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Seasonal Address Flag" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Boolean" .
cmm:PostalAddress.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this address record was last updated or modified."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
