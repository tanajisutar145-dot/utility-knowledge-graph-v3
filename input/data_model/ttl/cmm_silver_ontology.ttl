cmm:SparePartsInventory.leadTimeDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lead time days"@en ;
    rdfs:comment "Expected number of calendar days from purchase order placement to material receipt at the stocking location. Used for reorder point calculation and emergency procurement planning."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:int ;
    cmm:physicalColumn "lead_time_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lead Time (Days)" ;
