cmm:NetworkUpgrade.upgradeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade status"@en ;
    rdfs:comment "Current lifecycle status of the network upgrade project. Tracks progression from initial identification through design, permitting, construction, and completion phases. Reference-value candidates: identified|designed|permitted|contracted|in_progress|completed|cancelled."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Upgrade Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.status .
cmm:NetworkUpgrade.upgradeType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade type"@en ;
    rdfs:comment "Classification of the type of network upgrade required to accommodate DER interconnection. Defines the nature of the physical grid improvement needed for safe integration. Reference-value candidates: transformer_upsizing|line_reconductoring|protection_relay_replacement|protection_relay_addition|voltage_regulator_addition|capacitor_bank_addition|communication_infrastructure|transfer_trip|substation_expansion|feeder_extension|other."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Upgrade Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.type .
cmm:NetworkUpgrade.utilityFundedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility funded amount"@en ;
    rdfs:comment "Portion of the upgrade cost to be funded by the utility through rate base or other utility funding mechanisms, in USD. Represents utility's share of network improvement costs."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_funded_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utility Funded Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:NetworkUpgrade.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Operating voltage level in kilovolts (kV) of the grid infrastructure being upgraded. Defines the electrical system tier (distribution vs transmission) affected by the upgrade."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:InterconnectionAgreement a owl:Class ;
    rdfs:label "Interconnection Agreement"@en ;
    rdfs:comment "Executed legal agreement between the utility and the DER applicant governing the terms and conditions of grid interconnection. Captures agreement type (Small Generator Interconnection Agreement — SGIA, Large Generator Interconnection Agreement — LGIA, Simplified Interconnection Agreement), execution date, effective date, expiration date, maximum export capacity (kW), metering configuration (net metering, gross metering, bi-directional), NEM program enrollment flag, applicable tariff schedule, indemnification terms, insurance requirements, and termination conditions. This is the SSOT for the contractual interconnection relationship — distinct from the application (pre-approval) and the NEM agreement (billing program enrollment)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.interconnection_agreement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC pro forma LGIA/SGIA; SGIA / LGIA — FERC Pro Forma Interconnection Agreement" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.interconnection_agreement" ;
    owl:hasKey ( cmm:InterconnectionAgreement.interconnectionAgreementId ) .

cmm:InterconnectionAgreement.interconnectionAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement id"@en ;
    rdfs:comment "Unique identifier for the interconnection agreement record. Primary key."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "interconnection_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Interconnection Agreement ID" ;
    cmm:cimDatatype "Integer" .
cmm:InterconnectionAgreement.administratorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "administrator employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Interconnection agreements require utility staff oversight for contract administration, compliance monitoring, amendment processing, and customer communication. Essential for operational accountabilit"@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "administrator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Agreement Administrator Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_administrator_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:InterconnectionAgreement.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "Reference to the interconnection application that resulted in this agreement."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Application ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_application_id" ;
    cmm:cimAssociation "Agreement.Request" .
cmm:InterconnectionAgreement.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Executed interconnection agreements specify the metered service point for export/import measurement, billing reconciliation, and compliance verification. Legal contract enforcement requires this link."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_meter_point_id" ;
    cmm:cimAssociation "Agreement.UsagePoint" .
cmm:InterconnectionAgreement.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Interconnection agreements incorporate specific regulatory obligations as binding contractual terms (protection requirements, operating restrictions, reporting duties, IEEE 1547 mandatory functions)."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_obligation_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:InterconnectionAgreement.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to customer.premise. Business justification: Interconnection agreements specify the physical point of interconnection at a premise for metering configuration, service territory validation, and operational dispatch authorization. No existing prem"@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_premise_id" ;
    cmm:cimAssociation "Agreement.ServiceLocation" .
cmm:InterconnectionAgreement.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer or third-party applicant who is the counterparty to this interconnection agreement."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_interconnection_agreement_profile_id" ;
    cmm:cimAssociation "Agreement.Customer" .
cmm:InterconnectionAgreement.agreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement number"@en ;
    rdfs:comment "Externally-known unique business identifier for the interconnection agreement, used in correspondence and regulatory filings."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterconnectionAgreement.agreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement status"@en ;
    rdfs:comment "Current lifecycle status of the interconnection agreement. Draft = under negotiation, Pending Execution = awaiting signatures, Executed = signed but not yet effective, Active = in force, Suspended = temporarily inactive, Terminated = ended by mutual consent or breach, Expired = reached end date. Reference-value candidates: Draft|Pending."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:InterconnectionAgreement.agreementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement type"@en ;
    rdfs:comment "Classification of the interconnection agreement based on capacity, complexity, and regulatory framework. SGIA = Small Generator Interconnection Agreement (typically <20 MW), LGIA = Large Generator Interconnection Agreement (typically >=20 MW), Simplified for expedited low-impact projects, NEM for net metering programs, Rule 21 for California-specific interconnection, Wholesale for RTO/ISO market participation."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Type" ;
    cmm:validValues "SGIA|LGIA|Simplified Interconnection Agreement|Net Energy Metering Agreement|Rule 21 Agreement|Wholesale Market Interconnection Agreement" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.type .
cmm:InterconnectionAgreement.applicableTariffSchedule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable tariff schedule"@en ;
    rdfs:comment "Utility rate schedule or tariff code that governs billing and compensation for the interconnected DER. This determines the rates for energy import, export credits, and any standby or interconnection charges."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_tariff_schedule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Tariff Schedule" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date on which the DER was commissioned and began commercial operation under this interconnection agreement. This is the actual in-service date, which may differ from the effective date of the agreement."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:InterconnectionAgreement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this interconnection agreement record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:InterconnectionAgreement.customerFundedUpgradeCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer funded upgrade cost usd"@en ;
    rdfs:comment "Portion of network upgrade costs in US dollars that the DER applicant is responsible for funding under the terms of the interconnection agreement. Null if all upgrades are utility-funded."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "customer_funded_upgrade_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer-Funded Upgrade Cost (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionAgreement.derTechnologyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der technology type"@en ;
    rdfs:comment "Primary technology type of the distributed energy resource covered by this interconnection agreement. Used for portfolio analysis, renewable energy tracking, and compliance reporting. Reference-value candidates: Solar."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_technology_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Technology Type" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.documentUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document url"@en ;
    rdfs:comment "URL or file path to the executed interconnection agreement document stored in the enterprise document management system. Used for audit, compliance, and customer service reference."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_url" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agreement Document URL" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date on which the interconnection agreement terms become binding and the DER is authorized to interconnect to the grid, subject to all technical and safety requirements being met."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:InterconnectionAgreement.executionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution date"@en ;
    rdfs:comment "Date on which the interconnection agreement was signed by all parties. This is the legal signature date, distinct from the effective date when terms become binding."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "execution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionAgreement.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date on which the interconnection agreement terminates by its own terms. Nullable for agreements with indefinite term or subject to renewal provisions."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:InterconnectionAgreement.exportLimitationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export limitation required flag"@en ;
    rdfs:comment "Indicates whether the DER is required to limit or prevent export of power to the grid due to local system constraints, safety concerns, or tariff restrictions. Export limitation may be enforced through inverter settings or physical controls."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "export_limitation_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Limitation Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.indemnificationTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "indemnification terms"@en ;
    rdfs:comment "Summary of the contractual indemnification provisions, specifying which party bears liability for damages, injuries, or losses arising from the operation of the DER or interconnection facilities."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "indemnification_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Indemnification Terms" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.insuranceCertificateExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance certificate expiration date"@en ;
    rdfs:comment "Expiration date of the current insurance certificate on file for this interconnection agreement. Used to track compliance with ongoing insurance requirements."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "insurance_certificate_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Certificate Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionAgreement.insuranceMinimumCoverageUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance minimum coverage usd"@en ;
    rdfs:comment "Minimum liability insurance coverage amount in US dollars that the DER owner must maintain under the terms of the interconnection agreement. Null if no insurance is required."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "insurance_minimum_coverage_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Minimum Coverage (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionAgreement.insuranceRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance required flag"@en ;
    rdfs:comment "Indicates whether the interconnection agreement requires the DER owner to maintain liability insurance coverage as a condition of interconnection."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "insurance_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.interconnectionStudyCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection study cost usd"@en ;
    rdfs:comment "Total cost in US dollars charged to the applicant for interconnection studies (feasibility, system impact, facilities studies). Null if no study was required or cost was waived."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interconnection_study_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Study Cost (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionAgreement.interconnectionStudyRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection study required flag"@en ;
    rdfs:comment "Indicates whether a formal interconnection impact study (feasibility, system impact, or facilities study) was required as part of the agreement approval process. Typically required for larger or more complex DER projects."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "interconnection_study_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Study Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.inverterCertificationStandard a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter certification standard"@en ;
    rdfs:comment "Technical standard to which the DER inverter or interconnection equipment is certified, ensuring compliance with grid safety and power quality requirements. Common standards include IEEE 1547-2018, UL 1741, IEC 62109."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "inverter_certification_standard" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inverter Certification Standard" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this interconnection agreement record was last updated in the system. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InterconnectionAgreement.maximumExportCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum export capacity kw"@en ;
    rdfs:comment "Maximum electrical power in kilowatts that the DER is authorized to export to the utility grid under this interconnection agreement. This is the contractual limit, which may differ from the nameplate capacity of the generation equipment."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_export_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Export Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:InterconnectionAgreement.maximumImportCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum import capacity kw"@en ;
    rdfs:comment "Maximum electrical power in kilowatts that the customer site is authorized to import from the utility grid under this interconnection agreement. Relevant for sites with bi-directional flow such as battery storage or EV charging facilities."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_import_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Import Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:InterconnectionAgreement.meteringConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metering configuration"@en ;
    rdfs:comment "Type of metering arrangement specified in the interconnection agreement. Net Metering = single meter measuring net flow, Gross Metering = separate meters for import and export, Bi-Directional = single meter capable of measuring both directions, Import Only = consumption only, Export Only = generation only."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "metering_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Metering Configuration" ;
    cmm:validValues "Net Metering|Gross Metering|Bi-Directional|Import Only|Export Only" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or name of the person who last modified this interconnection agreement record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.nameplateCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity kw"@en ;
    rdfs:comment "Manufacturer-rated maximum continuous output capacity of the DER equipment in kilowatts. This is the equipment rating, which may differ from the contractual maximum export capacity."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nameplate Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:InterconnectionAgreement.nemProgramEnrolledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem program enrolled flag"@en ;
    rdfs:comment "Indicates whether the interconnection agreement includes enrollment in a Net Energy Metering program, allowing the customer to receive bill credits for excess generation exported to the grid."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_program_enrolled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Enrolled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.nemProgramVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem program version"@en ;
    rdfs:comment "Specific version or tariff schedule of the NEM program under which the customer is enrolled (e.g., NEM 2.0, NEM 3.0, grandfathered NEM 1.0). Different versions have different compensation rates and rules."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_program_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Version" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.networkUpgradeCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrade cost usd"@en ;
    rdfs:comment "Estimated or actual cost in US dollars of utility system upgrades required for this interconnection. Cost allocation (customer-funded vs. utility-funded) depends on regulatory framework and agreement type."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "network_upgrade_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Upgrade Cost (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionAgreement.networkUpgradeRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrade required flag"@en ;
    rdfs:comment "Indicates whether utility distribution or transmission system upgrades are required to accommodate the interconnection of this DER. Upgrades may include transformer replacements, line reconductoring, or protection system enhancements."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "network_upgrade_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Upgrade Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.parallelOperationAllowedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "parallel operation allowed flag"@en ;
    rdfs:comment "Indicates whether the DER is authorized to operate in parallel with the utility grid (exporting power) or is restricted to islanded/backup operation only. Most modern interconnection agreements allow parallel operation."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "parallel_operation_allowed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Parallel Operation Allowed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.poiLocationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi location description"@en ;
    rdfs:comment "Textual description of the physical location where the DER interconnects to the utility distribution or transmission system. Includes substation name, feeder ID, transformer location, or other technical reference points."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Location Description" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.poiVoltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi voltage level kv"@en ;
    rdfs:comment "Nominal voltage in kilovolts at the point where the DER interconnects to the utility system. Common values include 0.12, 0.24, 0.48, 4.16, 12.47, 13.8, 34.5, 69, 115, 138, 230, 345, 500 kV."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "poi_voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:InterconnectionAgreement.sgipApplicationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip application number"@en ;
    rdfs:comment "Unique identifier for the SGIP or other incentive program application associated with this interconnection agreement. Null if no incentive application exists."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "sgip_application_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Application Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterconnectionAgreement.sgipEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip eligible flag"@en ;
    rdfs:comment "Indicates whether the DER project is eligible for California Self-Generation Incentive Program rebates or other state/federal incentive programs. Used for customer incentive tracking and regulatory compliance."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionAgreement.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "Actual date on which the interconnection agreement was terminated prior to its natural expiration, due to breach, mutual consent, or other contractual provisions. Null if agreement has not been terminated."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:InterconnectionAgreement.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "Business reason or contractual clause under which the interconnection agreement was terminated. Examples include breach of terms, failure to maintain insurance, decommissioning of DER, customer request, or utility system changes."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Reason" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionAgreement.witnessTestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "witness test date"@en ;
    rdfs:comment "Date on which the utility conducted a witness test or commissioning inspection to verify that the DER installation meets all technical and safety requirements specified in the interconnection agreement."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "witness_test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Witness Test Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionAgreement.witnessTestResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "witness test result"@en ;
    rdfs:comment "Outcome of the utility witness test or commissioning inspection. Passed = DER meets all requirements, Failed = deficiencies identified, Conditional Pass = minor issues to be resolved, Not Required = test waived for low-impact projects, Pending = test scheduled but not yet completed."@en ;
    rdfs:domain cmm:InterconnectionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "witness_test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Witness Test Result" ;
    cmm:validValues "Passed|Failed|Conditional Pass|Not Required|Pending" ;
    cmm:cimDatatype "String" .

cmm:NemAgreement a owl:Class ;
    rdfs:label "Nem Agreement"@en ;
    rdfs:comment "Net Energy Metering (NEM) program enrollment agreement for a customer with an approved DER interconnection. Captures NEM program type (NEM 1.0, NEM 2.0, NEM 3.0 / NEM-ST, VNEM for virtual NEM, NEMA for NEM aggregation), enrollment date, true-up period (monthly, annual), export compensation rate (retail rate, avoided cost, NEM tariff rate), banking credits policy, maximum system size eligibility, applicable PUC tariff schedule, and program expiration date. Distinct from the interconnection agreement (technical/legal) — the NEM agreement governs the billing and compensation mechanism for exported energy."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CustomerAgreement ;
    cmm:cimCloseMatch cim:CustomerAgreement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.nem_agreement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NEM (Net Energy Metering) Enrollment Agreement — PUC Tariff" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.nem_agreement" ;
    owl:hasKey ( cmm:NemAgreement.nemAgreementId ) .

cmm:NemAgreement.nemAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem agreement id"@en ;
    rdfs:comment "Primary key for nem_agreement"@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "nem_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Nem Agreement Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:NemAgreement.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Foreign key linking to customer.account. Business justification: NEM billing credits, export compensation, and annual true-up calculations are account-level financial transactions requiring direct account linkage for billing system integration and credit reconcilia"@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_account_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAccount" .
cmm:NemAgreement.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Reference to the billing service agreement under which NEM credits and charges are applied."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_customer_service_agreement_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAgreement" .
cmm:NemAgreement.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the utility employee or system user who approved the NEM agreement."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_employee_id" ;
    cmm:cimAssociation "CustomerAgreement.ErpPersonnel" .
cmm:NemAgreement.interconnectionAgreementRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement"@en ;
    rdfs:comment "Reference to the technical interconnection agreement that governs the physical connection of the DER to the utility grid. The NEM agreement governs billing and compensation; the interconnection agreement governs technical and safety requirements."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:InterconnectionAgreement ;
    cmm:physicalColumn "interconnection_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_interconnection_agreement_id" ;
    cmm:cimAssociation "CustomerAgreement.Agreement" .
cmm:NemAgreement.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Reference to the parent interconnection application that this NEM agreement is associated with."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_interconnection_application_id" ;
    cmm:cimAssociation "CustomerAgreement.Request" .
cmm:NemAgreement.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the bi-directional meter installed at the customer premises to measure both energy consumption and generation for NEM billing purposes."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_meter_id" ;
    cmm:cimAssociation "CustomerAgreement.Meter" .
cmm:NemAgreement.nemAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nem account"@en ;
    rdfs:comment "Foreign key linking to renewable.nem_account. Business justification: Billing and settlement systems must link the formal NEM interconnection agreement to the operational NEM account for export credit calculations, banking policy application, and annual true-up reconcil"@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:NemAccount ;
    cmm:physicalColumn "nem_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nem Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_nem_account_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAccount" .
cmm:NemAgreement.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: NEM agreements implement specific regulatory obligations from state NEM programs (tariff compliance, metering requirements, reporting rules, RPS credit eligibility). Essential for tracking program com"@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_obligation_id" ;
    cmm:cimAssociation "CustomerAgreement.Document" .
cmm:NemAgreement.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer who owns the Distributed Energy Resource (DER) and is enrolled in the NEM program."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_profile_id" ;
    cmm:cimAssociation "CustomerAgreement.Customer" .
cmm:NemAgreement.sgipApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sgip application"@en ;
    rdfs:comment "The SGIP application identifier if the customer has applied for or received SGIP incentives for the DER system. Null if not applicable."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "sgip_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Application ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_nem_agreement_sgip_application_id" ;
    cmm:cimAssociation "CustomerAgreement.Request" .
cmm:NemAgreement.agreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement number"@en ;
    rdfs:comment "Externally visible unique identifier for the NEM agreement, used in customer communications and regulatory filings."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Energy Metering (NEM) Agreement Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:NemAgreement.annualTrueUpMonth a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual true up month"@en ;
    rdfs:comment "The calendar month (1-12) in which the annual NEM true-up reconciliation occurs for customers on annual true-up billing. Null for monthly true-up customers."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:int ;
    cmm:physicalColumn "annual_true_up_month" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual True-Up Month" ;
    cmm:cimDatatype "Integer" .
cmm:NemAgreement.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which the utility approved the customer's NEM agreement application."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:NemAgreement.bankingCreditsPolicy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "banking credits policy"@en ;
    rdfs:comment "The policy governing how excess NEM credits are carried forward. Indefinite (credits roll over indefinitely until used), Annual Expiration (credits expire at annual true-up), Monthly Expiration (credits expire at end of each billing cycle), No Banking (no credit carryover, excess generation compensated at lower rate)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "banking_credits_policy" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Banking Credits Policy" ;
    cmm:validValues "indefinite|annual_expiration|monthly_expiration|no_banking" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this NEM agreement record was first created in the system."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CustomerAgreement.createdDateTime .
cmm:NemAgreement.cumulativeCreditBalanceKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative credit balance kwh"@en ;
    rdfs:comment "The current cumulative balance of NEM energy credits in kilowatt-hours (kWh) that the customer has banked and not yet consumed. Updated after each billing cycle."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_credit_balance_kwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Credit Balance (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:NemAgreement.cumulativeCreditBalanceUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative credit balance usd"@en ;
    rdfs:comment "The current cumulative monetary value in US dollars of NEM credits that the customer has banked and not yet applied to billing charges. Updated after each billing cycle."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_credit_balance_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Credit Balance (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:NemAgreement.derTechnologyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der technology type"@en ;
    rdfs:comment "The primary technology type of the DER system covered by this NEM agreement. Solar PV (photovoltaic solar panels), Wind (small wind turbine), Battery Storage (standalone or paired with generation), Fuel Cell (hydrogen or natural gas fuel cell), Combined Heat and Power (CHP cogeneration), Micro Hydro (small-scale hydroelectric)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_technology_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Technology Type" ;
    cmm:validValues "solar_pv|wind|battery_storage|fuel_cell|combined_heat_power|micro_hydro" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date on which the NEM agreement expires or is terminated. Null for open-ended agreements or active agreements without a defined end date."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Energy Metering (NEM) Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:NemAgreement.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date from which NEM billing and credit calculations begin. May differ from enrollment date if retroactive application is approved."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Energy Metering (NEM) Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:NemAgreement.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "The date the customer was officially enrolled in the NEM program and the agreement became effective."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:NemAgreement.exportCompensationRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export compensation rate"@en ;
    rdfs:comment "The per-kilowatt-hour (kWh) rate at which the customer is compensated for energy exported to the grid, expressed in dollars per kWh."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "export_compensation_rate" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Compensation Rate" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "Decimal" .
cmm:NemAgreement.exportCompensationRateType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export compensation rate type"@en ;
    rdfs:comment "The methodology used to compensate the customer for energy exported to the grid. Retail Rate (full retail electricity rate, typical for NEM 1.0), Avoided Cost (utility's avoided cost of generation, typical for NEM 3.0), NEM Tariff Rate (specific tariff rate defined by PUC for NEM program), Wholesale Rate (market-based wholesale energy price)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "export_compensation_rate_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Compensation Rate Type" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:validValues "retail_rate|avoided_cost|nem_tariff_rate|wholesale_rate" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.grandfatheredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grandfathered flag"@en ;
    rdfs:comment "Indicates whether this NEM agreement is grandfathered under a previous program version's terms and conditions, protecting the customer from changes in subsequent tariff revisions. True if grandfathered, False otherwise."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "grandfathered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grandfathered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NemAgreement.grandfatheredUntilDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grandfathered until date"@en ;
    rdfs:comment "The date until which the grandfathered status is valid. After this date, the customer may be transitioned to the current NEM program terms. Null if not grandfathered or if grandfathering is indefinite."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "grandfathered_until_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grandfathered Until Date" ;
    cmm:cimDatatype "Date" .
cmm:NemAgreement.installedSystemSizeKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installed system size kw"@en ;
    rdfs:comment "The actual nameplate capacity in kilowatts (kW) of the customer's installed DER system as verified during interconnection inspection."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "installed_system_size_kw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installed System Size (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:NemAgreement.interconnectionAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement"@en ;
    rdfs:comment "FK to interconnection.agreement.agreement_id — NEM enrollment requires an executed interconnection agreement. The NEM agreement references the underlying interconnection agreement for the same DER system."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "interconnection_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:NemAgreement.lastTrueUpDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last true up date"@en ;
    rdfs:comment "The date of the most recent NEM true-up reconciliation for this agreement."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_true_up_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last True-Up Date" ;
    cmm:cimDatatype "Date" .
cmm:NemAgreement.maximumSystemSizeKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum system size kw"@en ;
    rdfs:comment "The maximum nameplate capacity in kilowatts (kW) of the customer's Distributed Energy Resource (DER) system that is eligible for NEM under this agreement. Typically based on customer's historical peak demand or regulatory cap."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_system_size_kw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum System Size (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:NemAgreement.nemProgramType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem program type"@en ;
    rdfs:comment "The specific NEM program version under which the customer is enrolled. NEM 1.0 (legacy retail rate compensation), NEM 2.0 (retail rate minus non-bypassable charges), NEM 3.0 / NEM-ST (successor tariff with export compensation based on avoided cost), VNEM (Virtual Net Energy Metering for multi-tenant or community solar), NEMA (NEM Aggregation for multiple meters under single customer)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Type" ;
    cmm:validValues "NEM 1.0|NEM 2.0|NEM 3.0|NEM-ST|VNEM|NEMA" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.nemaAggregationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nema aggregation type"@en ;
    rdfs:comment "For NEM Aggregation (NEMA) agreements, the type of meter aggregation allowed. On Site (multiple meters on same parcel), Adjacent Parcels (meters on contiguous parcels owned by same customer), Same Customer (meters under same customer account within service territory). Null for non-NEMA agreements."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "nema_aggregation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering Aggregation (NEMA) Type" ;
    cmm:validValues "on_site|adjacent_parcels|same_customer" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.nextTrueUpDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next true up date"@en ;
    rdfs:comment "The scheduled date of the next NEM true-up reconciliation for this agreement."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_true_up_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next True-Up Date" ;
    cmm:cimDatatype "Date" .
cmm:NemAgreement.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional notes, comments, or special conditions related to the NEM agreement."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:NemAgreement.poiLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi location"@en ;
    rdfs:comment "The physical location description of the Point of Interconnection where the customer's DER system connects to the utility distribution grid."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Location" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.programStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program status"@en ;
    rdfs:comment "Current lifecycle status of the NEM agreement. Pending (application submitted, awaiting approval), Active (agreement in force, customer receiving NEM credits), Suspended (temporarily inactive due to non-compliance or system outage), Terminated (customer or utility ended agreement), Expired (agreement reached end of term)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Status" ;
    cmm:validValues "pending|active|suspended|terminated|expired" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.sgipIncentiveEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip incentive eligible flag"@en ;
    rdfs:comment "Indicates whether the DER system under this NEM agreement is eligible for Self-Generation Incentive Program (SGIP) incentives. True if eligible, False otherwise."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_incentive_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Incentive Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NemAgreement.tariffScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff schedule code"@en ;
    rdfs:comment "The Public Utility Commission (PUC) approved tariff schedule code that governs the rates, terms, and conditions of this NEM agreement."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.tariffScheduleName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff schedule name"@en ;
    rdfs:comment "The human-readable name of the tariff schedule applicable to this NEM agreement (e.g., 'Residential NEM 2.0', 'Commercial NEM-ST')."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_schedule_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Schedule Name" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "The date on which the NEM agreement was terminated by the customer or utility. Null if agreement is still active."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:NemAgreement.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "The reason for termination of the NEM agreement (e.g., customer request, system decommissioned, non-compliance, property sale). Null if agreement is still active."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Reason" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.toAgreement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to agreement"@en ;
    rdfs:comment "FK to interconnection.agreement.agreement_id — NEM enrollment is contingent on having an executed interconnection agreement. The NEM agreement governs billing/compensation while the interconnection agreement governs technical/legal terms. They are"@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:NemAgreement.trueUpPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "true up period"@en ;
    rdfs:comment "The billing cycle frequency at which net energy consumption and generation are reconciled and excess credits are settled. Monthly (credits reconciled each billing cycle), Annual (credits accumulated over 12 months and reconciled at year-end)."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "true_up_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) True-Up Period" ;
    cmm:validValues "monthly|annual" ;
    cmm:cimDatatype "String" .
cmm:NemAgreement.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "The timestamp when this NEM agreement record was last modified in the system."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:NemAgreement.vnemAllocationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vnem allocation method"@en ;
    rdfs:comment "For Virtual NEM (VNEM) agreements, the method by which generation credits are allocated among multiple beneficiary accounts. Proportional (based on each account's usage), Fixed Percentage (predefined allocation percentages), Custom (customer-defined allocation rules). Null for non-VNEM agreements."@en ;
    rdfs:domain cmm:NemAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "vnem_allocation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Net Energy Metering (VNEM) Allocation Method" ;
    cmm:validValues "proportional|fixed_percentage|custom" ;
    cmm:cimDatatype "String" .

cmm:ApplicationStatusHistory a owl:Class ;
    rdfs:label "Application Status History"@en ;
    rdfs:comment "Audit trail record capturing each lifecycle state transition and formal regulatory communication for an interconnection application from submission through final disposition. Captures prior status, new status, transition timestamp, triggering event (applicant action, utility action, regulatory deadline, formal communication sent/received), responsible party, communication type (deficiency notice, completeness determination, study offer letter, cost estimate letter, agreement offer, PTO notification, withdrawal notice), communication channel, response deadline, response received flag, comments, and days elapsed in each status. Enables queue management SLA tracking, FERC Order 2023 milestone compliance reporting (completeness determination within 10 business days, study offer within 30 days, etc.), regulatory communication audit trail, and identification of bottlenecks in the interconnection review process."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.application_management ;
    cmm:physicalTable "utility_cmm_silver.interconnection.application_status_history" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Interconnection Queue Status Tracking" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.application_status_history" ;
    owl:hasKey ( cmm:ApplicationStatusHistory.applicationStatusHistoryId ) .

cmm:ApplicationStatusHistory.applicationStatusHistoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application status history id"@en ;
    rdfs:comment "Unique identifier for each status transition record in the interconnection application lifecycle audit trail."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:long ;
    cmm:physicalColumn "application_status_history_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Application Status History ID" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.primaryApplicationEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary application employee"@en ;
    rdfs:comment "Identifier of the system user or automated process that created this status transition record, supporting audit trail and accountability requirements."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_application_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_status_history_primary_application_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ApplicationStatusHistory.primaryInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary interconnection application"@en ;
    rdfs:comment "Reference to the parent interconnection application for which this status transition occurred."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "primary_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_status_history_primary_interconnection_application_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:ApplicationStatusHistory.tertiaryApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Status history records are audit trail entries FOR a specific application. This is the most obvious parent-child FK in the domain."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "tertiary_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_status_history_tertiary_application_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:ApplicationStatusHistory.businessDaysInPriorStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business days in prior status"@en ;
    rdfs:comment "Number of business days (excluding weekends and holidays) the application remained in the prior status, used for regulatory compliance milestone tracking per FERC Order 2023."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "business_days_in_prior_status" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Days in Prior Status" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.communicationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication channel"@en ;
    rdfs:comment "The medium or channel through which the formal communication was sent or received during this status transition."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Channel" ;
    cmm:validValues "email|postal_mail|portal|phone|in_person|fax" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.communicationReceivedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication received timestamp"@en ;
    rdfs:comment "Date and time when a response or acknowledgment communication was received from the applicant or other party, recorded in ISO 8601 format."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "communication_received_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Received Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ApplicationStatusHistory.communicationReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication reference number"@en ;
    rdfs:comment "Unique tracking number or identifier assigned to the formal communication document associated with this status transition, enabling audit trail linkage."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Communication Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApplicationStatusHistory.communicationSentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication sent timestamp"@en ;
    rdfs:comment "Date and time when the formal communication was sent to the applicant or other party, recorded in ISO 8601 format."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "communication_sent_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ApplicationStatusHistory.communicationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication type"@en ;
    rdfs:comment "Type of formal regulatory or business communication associated with this status transition. Reference-value candidates: deficiency_notice|completeness_determination|study_offer_letter|cost_estimate_letter|agreement_offer|pto_notification|withdrawal_notice|information_request|technical_review_report|impact_study_report|feasibility_study_report|system_impact_study|facilities_study."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Type" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this status transition record was first created in the system, recorded in ISO 8601 format for audit trail purposes."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:ApplicationStatusHistory.daysInPriorStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "days in prior status"@en ;
    rdfs:comment "Number of calendar days the application remained in the prior status before this transition occurred, used for SLA tracking and bottleneck analysis."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "days_in_prior_status" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Days in Prior Status" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.internalNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal notes"@en ;
    rdfs:comment "Confidential internal notes recorded by utility staff regarding this status transition, not shared with the applicant, used for internal coordination and decision documentation."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "internal_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Notes" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ApplicationStatusHistory.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this status transition record was last modified in the system, recorded in ISO 8601 format for audit trail purposes."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ApplicationStatusHistory.newStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "new status"@en ;
    rdfs:comment "The status of the interconnection application after this transition, representing the current state following the triggering event. Reference-value candidates: submitted|under_review|incomplete|study_in_progress|study_complete|agreement_pending|approved."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "new_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "New Application Status" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Boolean indicator of whether an automated notification was sent to the applicant or other stakeholders regarding this status transition."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationStatusHistory.notificationSentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent timestamp"@en ;
    rdfs:comment "Date and time when the automated notification was sent to stakeholders regarding this status transition, recorded in ISO 8601 format."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_sent_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ApplicationStatusHistory.priorStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prior status"@en ;
    rdfs:comment "The status of the interconnection application immediately before this transition occurred. Reference-value candidates: submitted|under_review|incomplete|study_in_progress|study_complete|agreement_pending|approved."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "prior_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prior Application Status" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.queuePosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue position"@en ;
    rdfs:comment "The position of the interconnection application in the utility interconnection queue at the time of this status transition, used for queue management and priority tracking."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "queue_position" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Position" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.regulatoryMilestoneMetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory milestone met flag"@en ;
    rdfs:comment "Boolean indicator of whether the regulatory milestone timing requirement was met for this status transition, supporting FERC Order 2023 compliance reporting."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_milestone_met_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Milestone Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationStatusHistory.regulatoryMilestoneType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory milestone type"@en ;
    rdfs:comment "Classification of the regulatory milestone associated with this status transition, aligned with FERC Order 2023 interconnection process requirements."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_milestone_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Milestone Type" ;
    cmm:validValues "completeness_determination|study_offer|cost_estimate|agreement_execution|pto_authorization" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.responseDeadlineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response deadline date"@en ;
    rdfs:comment "The date by which the applicant or responsible party must respond to the communication or complete required actions to maintain application progress."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_deadline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Deadline Date" ;
    cmm:cimDatatype "Date" .
cmm:ApplicationStatusHistory.responseReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response received date"@en ;
    rdfs:comment "The actual date on which the required response was received from the applicant or responsible party."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Received Date" ;
    cmm:cimDatatype "Date" .
cmm:ApplicationStatusHistory.responseReceivedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response received flag"@en ;
    rdfs:comment "Boolean indicator of whether a required response was received from the applicant or responsible party by the deadline date."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "response_received_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Received Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationStatusHistory.responsiblePartyName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible party name"@en ;
    rdfs:comment "Name of the individual, organization, or system entity that initiated or was responsible for this status transition."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_party_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Party Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.responsiblePartyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible party type"@en ;
    rdfs:comment "Classification of the party responsible for initiating or causing this status transition."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_party_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Party Type" ;
    cmm:validValues "applicant|utility|regulator|third_party|system" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.slaComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla compliance flag"@en ;
    rdfs:comment "Boolean indicator of whether this status transition occurred within the defined SLA timeframe for the prior status, supporting queue management and regulatory reporting."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationStatusHistory.slaTargetDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla target days"@en ;
    rdfs:comment "The target number of business days defined in the SLA for completing the prior status phase, used as the benchmark for compliance measurement."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "sla_target_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Target Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.slaVarianceDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla variance days"@en ;
    rdfs:comment "The difference between actual business days in prior status and the SLA target days, with positive values indicating delays and negative values indicating early completion."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "sla_variance_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Variance Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationStatusHistory.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name or identifier of the operational system that originated this status transition record, supporting data lineage and integration tracking."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.sourceSystemRecordReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record reference"@en ;
    rdfs:comment "Unique identifier of this status transition record in the source operational system, enabling traceability and reconciliation across systems."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record ID" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.systemGeneratedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system generated flag"@en ;
    rdfs:comment "Boolean indicator of whether this status transition record was automatically generated by the system based on business rules or manually created by a user."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "system_generated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Generated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ApplicationStatusHistory.transitionComments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transition comments"@en ;
    rdfs:comment "Free-text comments or notes recorded by utility staff or system administrators regarding this status transition, providing additional context for audit and operational review."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "transition_comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Status Transition Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ApplicationStatusHistory.transitionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transition timestamp"@en ;
    rdfs:comment "Precise date and time when the application status changed from the prior status to the new status, recorded in ISO 8601 format."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "transition_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Status Transition Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ApplicationStatusHistory.triggeringEventDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering event description"@en ;
    rdfs:comment "Detailed narrative description of the specific event or action that triggered this status transition, providing context for audit and compliance purposes."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_event_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Event Description" ;
    cmm:cimDatatype "String" .
cmm:ApplicationStatusHistory.triggeringEventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering event type"@en ;
    rdfs:comment "Classification of the event that caused this status transition, such as applicant submission, utility review completion, regulatory deadline expiration, or formal communication exchange."@en ;
    rdfs:domain cmm:ApplicationStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Event Type" ;
    cmm:validValues "applicant_action|utility_action|regulatory_deadline|communication_sent|communication_received|system_update" ;
    cmm:cimDatatype "String" .

cmm:QueuePosition a owl:Class ;
    rdfs:label "Queue Position"@en ;
    rdfs:comment "Queue management record tracking the position and priority of pending interconnection applications in the utility's interconnection queue. Captures queue number (utility-assigned sequential identifier), queue entry date, queue position, study group assignment (for cluster/group study processes), queue withdrawal date (if applicable), withdrawal reason, queue hold status, and estimated study completion date. Manages the orderly processing of DER interconnection requests per FERC Order 2023 cluster study rules and state PUC interconnection procedures. One queue record per application."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.application_management ;
    cmm:physicalTable "utility_cmm_silver.interconnection.queue_position" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC Order 2023; FERC Order 2023 Interconnection Queue / Cluster Study Group" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.queue_position" ;
    owl:hasKey ( cmm:QueuePosition.queuePositionId ) .

cmm:QueuePosition.queuePositionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue position id"@en ;
    rdfs:comment "Primary key for queue_position"@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:long ;
    cmm:physicalColumn "queue_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Queue Position Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:QueuePosition.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Queue position tracks where a specific application sits in the interconnection queue. One queue record per application as stated in the description."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_queue_position_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:QueuePosition.clusterStudyGroup a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cluster study group"@en ;
    rdfs:comment "Identifier for the cluster or group study cohort to which this application has been assigned. Used for FERC Order 2023 cluster study processes where multiple applications are studied together."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range cmm:ClusterStudyGroup ;
    cmm:physicalColumn "cluster_study_group_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Study Group ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_queue_position_cluster_study_group_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:QueuePosition.queueApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "queue application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Each queue position record tracks exactly one application's position in the interconnection queue. One-to-one relationship — the queue record is the application's place in line."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "queue_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_queue_position_queue_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:QueuePosition.queueInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "queue interconnection application"@en ;
    rdfs:comment "Reference to the interconnection application that this queue position represents. Links to the parent application record."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "queue_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_queue_position_queue_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:QueuePosition.queueManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "queue manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Interconnection queue management requires dedicated utility staff for application processing, milestone tracking, study coordination, and regulatory compliance. FK enables workload balancing, performa"@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "queue_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Queue Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_queue_position_queue_manager_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:QueuePosition.affectedSystemOperator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected system operator"@en ;
    rdfs:comment "Name of any neighboring transmission or distribution system operator whose system may be impacted by this interconnection. Null if no affected systems identified."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_system_operator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected System Operator" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.affectedSystemStudyRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected system study required"@en ;
    rdfs:comment "Indicates whether an affected system study is required due to potential impacts on neighboring utility systems."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "affected_system_study_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected System Study Required" ;
    cmm:cimDatatype "Boolean" .
cmm:QueuePosition.commercialReadinessDepositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commercial readiness deposit amount"@en ;
    rdfs:comment "Dollar amount of the commercial readiness deposit paid by the applicant. Typically calculated as dollars per kilowatt of proposed capacity."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "commercial_readiness_deposit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Readiness Deposit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:QueuePosition.commercialReadinessDepositDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commercial readiness deposit date"@en ;
    rdfs:comment "Date when the commercial readiness deposit was received by the utility."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "commercial_readiness_deposit_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Readiness Deposit Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.commercialReadinessDepositPaid a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commercial readiness deposit paid"@en ;
    rdfs:comment "Indicates whether the applicant has paid the required commercial readiness deposit to maintain queue position. Required under FERC Order 2023 financial security provisions."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "commercial_readiness_deposit_paid" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Readiness Deposit Paid" ;
    cmm:cimDatatype "Boolean" .
cmm:QueuePosition.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this queue position record was first created in the system."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:QueuePosition.estimatedStudyCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated study completion date"@en ;
    rdfs:comment "Projected date for completion of all required interconnection studies (feasibility, system impact, facilities study). Updated as studies progress."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "estimated_study_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Study Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.facilitiesStudyCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facilities study completion date"@en ;
    rdfs:comment "Date when the facilities study was completed. Null if study is not yet complete."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "facilities_study_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facilities Study Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.facilitiesStudyStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facilities study start date"@en ;
    rdfs:comment "Date when the facilities study phase began for this queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "facilities_study_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facilities Study Start Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.feasibilityStudyCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feasibility study completion date"@en ;
    rdfs:comment "Date when the feasibility study was completed. Null if study is not yet complete."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "feasibility_study_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feasibility Study Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.feasibilityStudyStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feasibility study start date"@en ;
    rdfs:comment "Date when the feasibility study phase began for this queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "feasibility_study_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feasibility Study Start Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this queue position record was last updated. Tracks the most recent change to any field in the record."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:QueuePosition.nextMilestoneDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next milestone description"@en ;
    rdfs:comment "Description of the next required milestone action for this queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "next_milestone_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Milestone Description" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.nextMilestoneDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next milestone due date"@en ;
    rdfs:comment "Date by which the next required milestone (payment, study agreement execution, information submission) must be completed to maintain queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_milestone_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Milestone Due Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes capturing additional context, special circumstances, or coordination requirements for this queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Queue Position Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:QueuePosition.queueEntryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue entry date"@en ;
    rdfs:comment "Date when the interconnection application was formally entered into the utility interconnection queue. Establishes priority for processing."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "queue_entry_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Entry Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.queueHoldReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue hold reason"@en ;
    rdfs:comment "Explanation for why the queue position was placed on hold. May include pending information, payment issues, or technical review requirements."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "queue_hold_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Hold Reason" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.queueHoldStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue hold start date"@en ;
    rdfs:comment "Date when the queue position was placed on hold. Null if never placed on hold or currently active."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "queue_hold_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Hold Start Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.queueHoldStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue hold status"@en ;
    rdfs:comment "Indicates whether the queue position is currently on hold. True if processing is temporarily suspended pending resolution of issues or additional information."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "queue_hold_status" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Hold Status" ;
    cmm:cimDatatype "Boolean" .
cmm:QueuePosition.queueManagerAssigned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue manager assigned"@en ;
    rdfs:comment "Name or identifier of the utility staff member assigned to manage this queue position and coordinate study activities."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "queue_manager_assigned" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Manager Assigned" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.queueNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue number"@en ;
    rdfs:comment "Utility-assigned sequential identifier for the position in the interconnection queue. Typically formatted as year-sequence (e.g., 2024-001)."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "queue_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Queue Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:QueuePosition.queuePosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue position"@en ;
    rdfs:comment "Numeric position of this application in the interconnection queue. Lower numbers indicate higher priority for study and processing."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:int ;
    cmm:physicalColumn "queue_position" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Position" ;
    cmm:cimDatatype "Integer" .
cmm:QueuePosition.queuePriorityPoints a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue priority points"@en ;
    rdfs:comment "Numeric score used to determine queue priority under FERC Order 2023 scoring criteria. Higher scores may receive priority processing."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "queue_priority_points" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Priority Points" ;
    cmm:cimDatatype "Decimal" .
cmm:QueuePosition.queueStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue status"@en ;
    rdfs:comment "Current lifecycle status of the queue position. Indicates whether the application is actively progressing, on hold, withdrawn, or completed through the interconnection process."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "queue_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Queue Status" ;
    cmm:validValues "active|on_hold|withdrawn|completed|suspended|under_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:QueuePosition.queueTransitionCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue transition cycle"@en ;
    rdfs:comment "Identifier for the transition cycle or window during which this application entered the queue. Used for FERC Order 2023 transition from serial to cluster study processes."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "queue_transition_cycle" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Transition Cycle" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.queueWithdrawalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue withdrawal date"@en ;
    rdfs:comment "Date when the application was withdrawn from the interconnection queue. Null if the application remains active."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "queue_withdrawal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queue Withdrawal Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.siteControlDemonstrated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "site control demonstrated"@en ;
    rdfs:comment "Indicates whether the applicant has demonstrated site control (ownership, lease, or option) for the proposed interconnection location. Required milestone under FERC Order 2023."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "site_control_demonstrated" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Site Control Demonstrated" ;
    cmm:cimDatatype "Boolean" .
cmm:QueuePosition.siteControlDemonstrationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "site control demonstration date"@en ;
    rdfs:comment "Date when site control documentation was submitted and verified by the utility."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "site_control_demonstration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Site Control Demonstration Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.studyGroupAssignmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study group assignment date"@en ;
    rdfs:comment "Date when the application was assigned to a specific cluster or group study cohort."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_group_assignment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Group Assignment Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.systemImpactStudyCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system impact study completion date"@en ;
    rdfs:comment "Date when the system impact study was completed. Null if study is not yet complete."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "system_impact_study_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Impact Study Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.systemImpactStudyStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system impact study start date"@en ;
    rdfs:comment "Date when the system impact study phase began for this queue position."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "system_impact_study_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Impact Study Start Date" ;
    cmm:cimDatatype "Date" .
cmm:QueuePosition.withdrawalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withdrawal reason"@en ;
    rdfs:comment "Categorized reason for withdrawal from the interconnection queue. Captures whether withdrawal was due to applicant request, non-payment of fees, failure to meet milestones, or other factors."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "withdrawal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withdrawal Reason" ;
    cmm:validValues "applicant_request|non_payment|failed_milestone|site_unavailable|project_cancelled|other" ;
    cmm:cimDatatype "String" .
cmm:QueuePosition.withdrawalReasonNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withdrawal reason notes"@en ;
    rdfs:comment "Additional free-text details explaining the circumstances of the queue withdrawal."@en ;
    rdfs:domain cmm:QueuePosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "withdrawal_reason_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Withdrawal Reason Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .

cmm:HostingCapacity a owl:Class ;
    rdfs:label "Hosting Capacity"@en ;
    rdfs:comment "Hosting capacity assessment record for a distribution circuit, feeder segment, or substation load area, capturing the maximum additional DER capacity (kW) that can be interconnected at that location without triggering network upgrades. Captures feeder/circuit identifier, node or segment location, assessment date, thermal hosting capacity (kW), voltage hosting capacity (kW), protection hosting capacity (kW), binding constraint type (thermal, voltage, protection coordination, power quality), assessment methodology (deterministic, stochastic, time-series), daytime minimum load assumption, confidence level, data vintage, next scheduled reassessment date, and publication status for public hosting capacity maps per CPUC Rule 21 / ICA or equivalent state requirements. Updated after major network reconfigurations, DER additions, or load changes. Enables applicant self-screening and utility pre-screening of POI feasibility before formal application submission."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.hosting_capacity" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "EPRI DRIVE; Distribution Hosting Capacity Analysis (CPUC Rule 21 / IEEE 1547)" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.hosting_capacity" ;
    owl:hasKey ( cmm:HostingCapacity.hostingCapacityId ) .

cmm:HostingCapacity.hostingCapacityId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hosting capacity id"@en ;
    rdfs:comment "Unique identifier for the hosting capacity assessment record. Primary key for this entity."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:long ;
    cmm:physicalColumn "hosting_capacity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Hosting Capacity Assessment ID" ;
    cmm:cimDatatype "Integer" .
cmm:HostingCapacity.assessmentAnalystEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assessment analyst employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Hosting capacity assessments are performed by utility distribution engineers. FK enables technical accountability, quality assurance, workload tracking, and regulatory reporting for ICA compliance. Re"@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "assessment_analyst_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assessment Analyst Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_assessment_analyst_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:HostingCapacity.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation load area associated with this hosting capacity assessment."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_distribution_substation_id" ;
    cmm:cimAssociation "Document.Substation" .
cmm:HostingCapacity.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Foreign key linking to grid.ems_node. Business justification: Hosting capacity assessments calculate available DER capacity at specific EMS node locations before thermal, voltage, or protection violations occur. Required for Integration Capacity Analysis (ICA) m"@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Node Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_ems_node_id" ;
    cmm:cimAssociation "Document.TopologicalNode" .
cmm:HostingCapacity.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Hosting capacity assessments are published and tracked by forecast zone for transparency, customer planning, and regulatory compliance. California Rule 21 and similar regulations require zone-level ho"@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_forecast_zone_id" ;
    cmm:cimAssociation "Document.LoadArea" .
cmm:HostingCapacity.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Hosting capacity calculations use load forecasts (specifically daytime_minimum_load_kw) as primary input for thermal and voltage constraint analysis. Direct operational dependency - hosting capacity c"@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_load_id" ;
    cmm:cimAssociation "Document.ConformLoadSchedule" .
cmm:HostingCapacity.poiSpecification a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "poi specification"@en ;
    rdfs:comment "FK to interconnection.poi_specification.poi_specification_id — Hosting capacity assessments are for specific distribution circuit locations that correspond to potential POIs. This FK enables applicants and reviewers to cross-reference hosting capacity at a propos"@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range cmm:PoiSpecification ;
    cmm:physicalColumn "poi_specification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_hosting_capacity_poi_specification_id" ;
    cmm:cimAssociation "Document.ConnectivityNode" .
cmm:HostingCapacity.assessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment date"@en ;
    rdfs:comment "Date when the hosting capacity assessment was performed or published."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:HostingCapacity.assessmentMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment methodology"@en ;
    rdfs:comment "The analytical methodology used to calculate hosting capacity: deterministic (worst-case snapshot), stochastic (probabilistic scenarios), time-series (chronological simulation), or hybrid approach."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Methodology" ;
    cmm:validValues "deterministic|stochastic|time_series|hybrid" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.assessmentSoftwareTool a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment software tool"@en ;
    rdfs:comment "Name and version of the software tool or platform used to perform the hosting capacity analysis (e.g., EPRI DRIVE, OpenDSS, CYME, Synergi Electric)."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_software_tool" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Software Tool" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.availableHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "available hosting capacity kw"@en ;
    rdfs:comment "Net available hosting capacity in kilowatts (kW) after accounting for existing and queued DER capacity. This is the capacity available for new interconnection applications without triggering network upgrades."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "available_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.bindingConstraintType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "binding constraint type"@en ;
    rdfs:comment "The type of network constraint that limits the hosting capacity at this location. Identifies which technical factor (thermal, voltage, protection coordination, power quality, stability) is the bottleneck."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "binding_constraint_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Binding Constraint Type" ;
    cmm:validValues "thermal|voltage|protection_coordination|power_quality|stability|other" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.circuitCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "circuit code"@en ;
    rdfs:comment "Reference to the distribution circuit or feeder for which this hosting capacity assessment was performed."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:long ;
    cmm:physicalColumn "circuit_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distribution Circuit ID" ;
    cmm:cimDatatype "Integer" .
cmm:HostingCapacity.confidenceLevelPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level percent"@en ;
    rdfs:comment "Statistical confidence level (as a percentage) associated with the hosting capacity estimate, particularly relevant for stochastic or probabilistic assessments. For example, 95% confidence means the capacity is available 95% of the time under modeled conditions."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_level_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidence Level (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:HostingCapacity.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this hosting capacity assessment record was first created in the system."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:HostingCapacity.dataVintageDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data vintage date"@en ;
    rdfs:comment "Date of the network model, load data, and DER penetration data used as inputs to the hosting capacity assessment. Indicates the currency of the underlying data."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:date ;
    cmm:physicalColumn "data_vintage_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Vintage Date" ;
    cmm:cimDatatype "Date" .
cmm:HostingCapacity.daytimeMinimumLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "daytime minimum load kw"@en ;
    rdfs:comment "The assumed daytime minimum load in kilowatts (kW) used in the hosting capacity calculation. Critical for assessing reverse power flow and overvoltage risk from solar generation during low-load periods."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "daytime_minimum_load_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Daytime Minimum Load (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.derTypeScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der type scope"@en ;
    rdfs:comment "The type(s) of Distributed Energy Resource (DER) for which this hosting capacity assessment applies. May be specific to solar PV, battery storage, EV chargers, or applicable to all DER types."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_type_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Type Scope" ;
    cmm:validValues "solar_pv|battery_storage|ev_charger|wind|combined_heat_power|all_der_types" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.existingDerCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "existing der capacity kw"@en ;
    rdfs:comment "Total existing DER capacity in kilowatts (kW) already interconnected at this location or on this circuit segment at the time of assessment. Used to calculate remaining available capacity."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "existing_der_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Existing Distributed Energy Resource (DER) Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.feederSegmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder segment code"@en ;
    rdfs:comment "Identifier for the specific feeder segment or node location where the hosting capacity was assessed. May reference a GIS node, pole, or transformer location."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "feeder_segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Feeder Segment Identifier" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.icaComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ica compliance flag"@en ;
    rdfs:comment "Boolean flag indicating whether this hosting capacity assessment complies with CPUC Integration Capacity Analysis (ICA) requirements or equivalent state-level interconnection transparency mandates."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ica_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Integration Capacity Analysis (ICA) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HostingCapacity.interconnectionVoltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection voltage level"@en ;
    rdfs:comment "The voltage level of the distribution network at the assessed location: low voltage (secondary, typically <1 kV), medium voltage (primary distribution, typically 4-35 kV), or high voltage (sub-transmission, typically >35 kV)."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Voltage Level" ;
    cmm:validValues "low_voltage|medium_voltage|high_voltage" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this hosting capacity assessment record was last modified or updated."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:HostingCapacity.minimumHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum hosting capacity kw"@en ;
    rdfs:comment "The binding (minimum) hosting capacity in kilowatts (kW) across all constraint types (thermal, voltage, protection). This is the effective maximum DER capacity that can be interconnected without network upgrades."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.nemAgreementApplicableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem agreement applicable flag"@en ;
    rdfs:comment "Boolean flag indicating whether Net Energy Metering (NEM) agreements are applicable for DER interconnections at this location, based on hosting capacity and tariff rules."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_agreement_applicable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Agreement Applicable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HostingCapacity.nextReassessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next reassessment date"@en ;
    rdfs:comment "Scheduled date for the next hosting capacity reassessment at this location. Reassessments are triggered by major network reconfigurations, significant DER additions, or load changes."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_reassessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Reassessment Date" ;
    cmm:cimDatatype "Date" .
cmm:HostingCapacity.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes capturing additional context, assumptions, limitations, or special conditions related to the hosting capacity assessment."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assessment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:HostingCapacity.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "The electrical phase configuration at the assessed location: single-phase, three-phase, or split-phase. Impacts the hosting capacity calculation and interconnection requirements."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase|split_phase" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.poiLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi location code"@en ;
    rdfs:comment "Geographic or network location code identifying the Point of Interconnection (POI) where DER capacity is being assessed."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Location Code" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.protectionHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection hosting capacity kw"@en ;
    rdfs:comment "Maximum additional DER capacity in kilowatts (kW) that can be interconnected at this location without requiring protection coordination upgrades (relay settings, fuse coordination, or fault current impacts)."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "protection_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.publicMapUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "public map url"@en ;
    rdfs:comment "URL link to the public-facing hosting capacity map where this assessment is displayed, enabling applicant self-screening and pre-screening of POI feasibility."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "public_map_url" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Map URL" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.publicationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "publication status"@en ;
    rdfs:comment "Current publication status of the hosting capacity assessment. Indicates whether the assessment is available on public hosting capacity maps per CPUC Rule 21 or equivalent state requirements."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "publication_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Publication Status" ;
    cmm:validValues "draft|published|archived|under_review" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.queuedDerCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queued der capacity kw"@en ;
    rdfs:comment "Total DER capacity in kilowatts (kW) currently in the interconnection queue (pending applications) for this location or circuit segment. Reduces the available hosting capacity for new applicants."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "queued_der_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Queued Distributed Energy Resource (DER) Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.sgipEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip eligible flag"@en ;
    rdfs:comment "Boolean flag indicating whether DER projects at this location are eligible for Self-Generation Incentive Program (SGIP) incentives based on hosting capacity availability and program rules."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:HostingCapacity.thermalHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal hosting capacity kw"@en ;
    rdfs:comment "Maximum additional Distributed Energy Resource (DER) capacity in kilowatts (kW) that can be interconnected at this location without exceeding thermal (conductor or transformer) limits."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "thermal_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Thermal Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:HostingCapacity.upgradeCostEstimateUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade cost estimate usd"@en ;
    rdfs:comment "Estimated cost in US dollars (USD) for network upgrades required to increase hosting capacity beyond the current binding constraint. Provided for applicant planning purposes."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "upgrade_cost_estimate_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Upgrade Cost Estimate (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:HostingCapacity.upgradeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade description"@en ;
    rdfs:comment "Textual description of the network upgrades (e.g., conductor reconductoring, transformer replacement, voltage regulator installation, protection relay upgrades) that would be required to increase hosting capacity."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Upgrade Description" ;
    cmm:cimDatatype "String" .
cmm:HostingCapacity.voltageHostingCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage hosting capacity kw"@en ;
    rdfs:comment "Maximum additional DER capacity in kilowatts (kW) that can be interconnected at this location without causing voltage regulation violations (overvoltage or undervoltage conditions)."@en ;
    rdfs:domain cmm:HostingCapacity ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_hosting_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Hosting Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .

cmm:InspectionMilestone a owl:Class ;
    rdfs:label "Inspection Milestone"@en ;
    rdfs:comment "Record of a required inspection, field verification, or authorization milestone in the DER interconnection process. Captures milestone type (utility pre-installation site visit, electrical rough-in inspection, final interconnection inspection, witness test, meter installation verification, Permission to Operate — PTO authorization), scheduled date, actual completion date, inspector identity, inspection result (pass, fail, conditional pass), deficiencies identified, corrective actions required, re-inspection date, and PTO-specific attributes when milestone type is PTO (authorized export capacity kW, operating mode restrictions, metering configuration confirmed, protective relay settings verified, as-built drawing accepted). This entity now also serves as the SSOT for PTO issuance — the PTO milestone record marks the definitive transition from the interconnection application process to active DER operation and triggers NEM enrollment activation and SGIP incentive payment."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.inspection_milestone" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "DER Interconnection Inspection / Permission to Operate (PTO)" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.inspection_milestone" ;
    owl:hasKey ( cmm:InspectionMilestone.inspectionMilestoneId ) .

cmm:InspectionMilestone.inspectionMilestoneId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection milestone id"@en ;
    rdfs:comment "Unique identifier for the inspection milestone record in the DER interconnection process."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:long ;
    cmm:physicalColumn "inspection_milestone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Inspection Milestone Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:InspectionMilestone.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Inspections and PTO milestones are conducted for a specific application. The PTO milestone marks the transition from application to active operation."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_application_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:InspectionMilestone.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: Failed inspections revealing non-compliance with interconnection standards (protection settings, equipment certification, safety violations) generate audit findings requiring corrective action plans a"@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_audit_finding_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:InspectionMilestone.createdByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "created by user employee"@en ;
    rdfs:comment "Reference to the system user who created this inspection milestone record."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "created_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_created_by_user_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:InspectionMilestone.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the utility employee or contractor who performed the inspection or milestone verification."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Inspector Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:InspectionMilestone.inspectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inspection application"@en ;
    rdfs:comment "FK to interconnection.interconnection_application.interconnection_application_id — Inspections and milestones (including PTO) are performed for a specific application. This FK links field verification steps back to the application, enabling milestone tracking and PTO issuance."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "inspection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_inspection_application_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:InspectionMilestone.inspectionInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inspection interconnection application"@en ;
    rdfs:comment "Reference to the parent DER interconnection application that this inspection milestone belongs to."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "inspection_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_inspection_interconnection_application_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:InspectionMilestone.lastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user employee"@en ;
    rdfs:comment "Reference to the system user who last modified this inspection milestone record."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:InspectionMilestone.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to customer.premise. Business justification: Field inspections for permission-to-operate occur at physical premises; inspectors require premise address, access instructions, site characteristics, and service territory for scheduling and safety c"@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_inspection_milestone_premise_id" ;
    cmm:cimAssociation "ActivityRecord.ServiceLocation" .
cmm:InspectionMilestone.actualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion date"@en ;
    rdfs:comment "The actual date on which the inspection or milestone was completed."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_completion_date" ;
