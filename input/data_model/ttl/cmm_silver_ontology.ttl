cmm:IncentiveProgram.programName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program name"@en ;
    rdfs:comment "Official name of the renewable energy incentive program as published by the administering agency or utility."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Program Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:IncentiveProgram.programNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program notes"@en ;
    rdfs:comment "Additional notes, comments, or special conditions related to the incentive program administration or policy changes."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Notes" ;
