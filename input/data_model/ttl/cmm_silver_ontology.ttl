cmm:DrIncentivePayment.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Timestamp when the incentive payment was approved for disbursement by authorized personnel."@en ;
