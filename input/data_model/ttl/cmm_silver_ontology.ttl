cmm:TradingDesk a owl:Class ;
    rdfs:label "Trading Desk"@en ;
    rdfs:comment "Master reference table for trading_desk. Referenced by trading_desk_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimExtends cim:Organisation ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.asset_holdings ;
    cmm:physicalTable "utility_cmm_silver.trading.trading_desk" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.trading.trading_desk" ;
    owl:hasKey ( cmm:TradingDesk.tradingDeskId ) .

cmm:TradingDesk.tradingDeskId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading desk id"@en ;
    rdfs:comment "Primary key for trading_desk"@en ;
    rdfs:domain cmm:TradingDesk ; rdfs:range xsd:long ;
    cmm:physicalColumn "trading_desk_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Trading Desk Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:TradingDesk.parentTradingDesk a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent trading desk"@en ;
    rdfs:comment "Self-referencing FK on trading_desk (parent_trading_desk_id)"@en ;
    rdfs:domain cmm:TradingDesk ; rdfs:range cmm:TradingDesk ;
    cmm:physicalColumn "parent_trading_desk_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_trading_desk_parent_trading_desk_id" ;
    cmm:cimAssociation "Organisation.Organisation" .
cmm:TradingDesk.capacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity mw"@en ;
    rdfs:comment "Maximum megawatt capacity the desk is authorized to trade."@en ;
    rdfs:domain cmm:TradingDesk ; rdfs:range xsd:decimal ;
