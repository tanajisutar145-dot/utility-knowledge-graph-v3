    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Closure Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:RegulatoryCorrespondence.complianceObligationReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance obligation reference"@en ;
    rdfs:comment "Reference to the specific compliance obligation, regulatory requirement, or standard that the correspondence addresses. Examples include NERC CIP standards, FERC reporting requirements, or EPA emissions limits."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_obligation_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Obligation Reference" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.confidentialityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidentiality flag"@en ;
    rdfs:comment "Indicates whether the correspondence contains confidential, proprietary, or commercially sensitive information that requires special handling or redaction before public disclosure."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "confidentiality_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidentiality Flag" ;
