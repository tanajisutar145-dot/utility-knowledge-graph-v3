cmm:SubstationScenarioPlan.planningNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning notes"@en ;
    rdfs:comment "Free-text notes from planning engineers regarding assumptions, constraints, or alternatives considered for this substation in this scenario."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:string ;
