    cmm:physicalColumn "tertiary_power_water_permit_environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Water Discharge Permit Identifier" ;
