cmm:CostResponsibility.costEstimateValidUntilDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost estimate valid until date"@en ;
    rdfs:comment "Date until which the cost estimate remains valid. After this date, costs may be re-estimated due to market changes or project delays."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:date ;
    cmm:physicalColumn "cost_estimate_valid_until_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
