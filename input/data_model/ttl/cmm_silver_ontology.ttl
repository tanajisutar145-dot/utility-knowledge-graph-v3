cmm:ControlArea.spinningReserveMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "spinning reserve mw"@en ;
    rdfs:comment "Amount of spinning (synchronized) reserve in megawatts available for immediate deployment in response to contingencies."@en ;
