cmm:EmployeeQualification.prerequisiteQualifications a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prerequisite qualifications"@en ;
    rdfs:comment "Comma-separated list of qualification types or certification codes that were required before the employee could pursue this qualification. Used for career path validation and succession planning."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "prerequisite_qualifications" ;
