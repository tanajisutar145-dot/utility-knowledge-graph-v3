    rdfs:label "sink point of delivery"@en ;
    rdfs:comment "Designated point of delivery (POD) or sink location where power exits the transmission system under this agreement."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
