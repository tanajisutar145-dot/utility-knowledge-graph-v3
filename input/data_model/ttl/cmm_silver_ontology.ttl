    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Plant.createdDateTime .
cmm:PowerPlant.dcsSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dcs system code"@en ;
    rdfs:comment "Plant identifier in the Distributed Control System used for process control and automation."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "dcs_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Control System (DCS) Identifier" ;
