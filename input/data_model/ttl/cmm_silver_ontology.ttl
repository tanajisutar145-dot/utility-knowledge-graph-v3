cmm:EmissionsReport.exceedanceReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exceedance reason"@en ;
    rdfs:comment "Explanation or reason code for any emission limit exceedance, if applicable. Null if no exceedance occurred."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "exceedance_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
