cmm:MdmUsageTransaction.reversalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal flag"@en ;
    rdfs:comment "Indicates whether this usage transaction is a reversal of a previously posted transaction. Used for billing corrections and reprocessing scenarios."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MdmUsageTransaction.shoulderKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shoulder kwh"@en ;
    rdfs:comment "Energy consumption during shoulder (mid-peak) hours as defined by the Time of Use (TOU) rate schedule. Mid-tier pricing period between on-peak and off-peak."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shoulder_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Shoulder Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MdmUsageTransaction.temperatureNormalizedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature normalized flag"@en ;
    rdfs:comment "Indicates whether this usage transaction has been adjusted for weather normalization to account for temperature variations. Used for load forecasting and customer comparisons."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "temperature_normalized_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature Normalized Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MdmUsageTransaction.totalIntervalCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total interval count"@en ;
    rdfs:comment "Total number of interval data records aggregated to produce this usage transaction. Used for data quality assessment and completeness validation."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_interval_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Interval Count" ;
    cmm:cimDatatype "Integer" .
cmm:MdmUsageTransaction.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "The unit of measure for the primary usage value in this transaction. Standardizes measurement units across different rate components and meter types."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure" ;
    cmm:validValues "kWh|kW|kVAR|MWh|MW|MVAR" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingType.unit .
cmm:MdmUsageTransaction.usageCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usage calculation method"@en ;
    rdfs:comment "The method used by MDM to calculate this usage transaction. Indicates whether the value was derived from interval data aggregation, register reads, estimation algorithms, proration, or manual adjustment."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "usage_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Usage Calculation Method" ;
    cmm:validValues "interval_aggregation|register_read|estimated|prorated|adjusted" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MdmUsageTransaction.usageQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usage quality code"@en ;
    rdfs:comment "Data quality indicator code assigned by MDM to this usage transaction. Reflects confidence level in the calculated usage based on source data quality and VEE results."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "usage_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Usage Quality Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MdmUsageTransaction.usageTransactionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usage transaction number"@en ;
    rdfs:comment "Business identifier for the usage transaction. Human-readable reference number used in billing and customer service interactions."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "usage_transaction_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Usage Transaction Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MdmUsageTransaction.veeCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee completion timestamp"@en ;
    rdfs:comment "Timestamp when the VEE processing was completed for this usage transaction. Marks when the data became billing-ready."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "vee_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MdmUsageTransaction.veeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee status"@en ;
    rdfs:comment "Overall status of the Validation, Estimation, and Editing (VEE) process for the interval data underlying this usage transaction. Indicates data quality and readiness for billing."@en ;
    rdfs:domain cmm:MdmUsageTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "vee_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Status" ;
    cmm:validValues "validated|estimated|edited|failed|pending" ;
    cmm:cimDatatype "String" .

cmm:MeteringDrEnrollment a owl:Class ;
    rdfs:label "Metering Dr Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment relationship between a meter and a demand response program. It captures the operational enrollment lifecycle, participation tracking, and settlement data for each meter enrolled in each DR program. Each record links one meter to one DR program with enrollment-specific attributes including enrollment dates, status, enrolled capacity commitment, baseline calculation method override, participation performance metrics, opt-out history, and cumulative incentive payments earned. This is the SSOT for DR program enrollment administration, event dispatch eligibility, M&V settlement, and regulatory compliance reporting.. Existence Justification: In energy utilities operations, a single meter can simultaneously enroll in multiple demand response programs (e.g., ISO/RTO capacity market + utility peak-time rebate + behavioral DR campaign), and each DR program enrolls thousands of meters across the service territory. The business actively manages enrollments as operational entities with lifecycle status, capacity commitments, participation tracking, opt-out history, and settlement data. Enrollment is a recognized business concept with dedicated administration, event dispatch eligibility determination, M&V settlement processes, and regulatory compliance reporting obligations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.ami_operations ;
    cmm:physicalTable "utility_cmm_silver.metering.metering_dr_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.metering.metering_dr_enrollment" ;
    owl:hasKey ( cmm:MeteringDrEnrollment.meteringDrEnrollmentId ) .

cmm:MeteringDrEnrollment.meteringDrEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metering dr enrollment id"@en ;
    rdfs:comment "Primary key for metering_dr_enrollment"@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "metering_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "metering_dr_enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:MeteringDrEnrollment.aggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "Foreign key to the third-party aggregator managing this enrollment, if enrollment_source is Aggregator. Null for utility-direct enrollments."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Aggregator Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_metering_dr_enrollment_aggregator_id" ;
    cmm:cimAssociation "IdentifiedObject.MarketParticipant" .
cmm:MeteringDrEnrollment.drEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr enrollment"@en ;
    rdfs:comment "Unique identifier for this meter enrollment in this DR program. Primary key."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "DR Enrollment Identifier" ;
    cmm:sourceColumn "demand_dr_enrollment_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_metering_dr_enrollment_dr_enrollment_id" ;
    cmm:cimAssociation "IdentifiedObject.Agreement" .
cmm:MeteringDrEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to the demand response program"@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment - Dr Program Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_metering_dr_enrollment_dr_program_id" ;
    cmm:cimAssociation "IdentifiedObject.DemandResponseProgram" .
cmm:MeteringDrEnrollment.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to the enrolled meter device"@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment - Meter Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_metering_dr_enrollment_meter_id" ;
    cmm:cimAssociation "IdentifiedObject.Meter" .
cmm:MeteringDrEnrollment.baselineCalculationMethodOverride a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation method override"@en ;
    rdfs:comment "Enrollment-specific override of the baseline calculation method defined at the program level. Allows customer-specific baseline methodology when negotiated or required by customer characteristics. Null indicates use of program default method."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_calculation_method_override" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Method Override" ;
    cmm:cimDatatype "String" .
cmm:MeteringDrEnrollment.capacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity kw"@en ;
    rdfs:comment "Committed load reduction capacity in kilowatts for this specific meter enrollment. Used for program capacity aggregation and ISO/RTO registration. May differ from meter peak demand based on customer commitment."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:MeteringDrEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when this enrollment record was created in the DR management system."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:MeteringDrEnrollment.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this enrollment terminates. Null for active open-ended enrollments. Populated for withdrawn or expired enrollments."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:MeteringDrEnrollment.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this enrollment becomes effective for event dispatch and incentive eligibility. May differ from enrollment_date due to program rules or customer request."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:MeteringDrEnrollment.enrollmentSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment source"@en ;
    rdfs:comment "Channel or mechanism through which this enrollment was created. Direct indicates utility direct enrollment; Aggregator indicates third-party aggregator enrollment; Auto-Enroll indicates automatic enrollment based on tariff or meter type; Tariff-Linked indicates enrollment required by rate schedule; ISO-RTO indicates wholesale market enrollment."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_source" ;
