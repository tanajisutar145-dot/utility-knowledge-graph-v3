cmm:ClusterStudyGroup.contingencyScenariosEvaluated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency scenarios evaluated"@en ;
    rdfs:comment "Description of the contingency scenarios and operating conditions analyzed in the cluster study. Includes N-1, N-2, and other reliability scenarios per NERC standards."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "contingency_scenarios_evaluated" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Scenarios Evaluated" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.costAllocationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation methodology"@en ;
    rdfs:comment "Method used to allocate the total cluster study cost among participating interconnection applications. Describes the formula or approach for distributing costs (e.g., pro-rata by capacity, equal share, tiered allocation)."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Methodology" ;
