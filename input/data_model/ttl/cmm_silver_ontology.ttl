    cmm:physicalColumn "lock_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lock Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.nercCipRelevantFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip relevant flag"@en ;
    rdfs:comment "Indicates whether this cost center supports NERC CIP-designated critical cyber assets or bulk electric system facilities. Used for compliance tracking and cost allocation for cybersecurity investments."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_relevant_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Critical Infrastructure Protection (CIP) Relevant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.overheadAllocationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overhead allocation flag"@en ;
    rdfs:comment "Indicates whether this cost center participates in overhead allocation cycles. Overhead cost centers distribute their costs to production and service cost centers."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "overhead_allocation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overhead Allocation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.parentCostCenterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "parent cost center code"@en ;
    rdfs:comment "Parent cost center in the organizational hierarchy. Enables hierarchical cost rollup and management reporting at multiple organizational levels."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "parent_cost_center_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Parent Cost Center Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether costs from this cost center are eligible for inclusion in the regulatory asset base for rate recovery. Critical for rate case preparation and return on equity (ROE) calculations."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.soxRelevantFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox relevant flag"@en ;
    rdfs:comment "Indicates whether this cost center is subject to SOX internal controls and audit requirements. Typically true for cost centers involved in financial reporting and material account balances."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_relevant_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Relevant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.statisticalCostCenterFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statistical cost center flag"@en ;
    rdfs:comment "Indicates whether this is a statistical cost center used for informational purposes only, without actual cost postings."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "statistical_cost_center_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Statistical Cost Center Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CostCenter.validFromDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valid from date"@en ;
    rdfs:comment "Start date of the cost center's validity period. Cost center becomes active for postings from this date."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:date ;
    cmm:physicalColumn "valid_from_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Valid From Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CostCenter.validToDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valid to date"@en ;
    rdfs:comment "End date of the cost center's validity period. Cost center is no longer active for postings after this date. Null indicates open-ended validity."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:date ;
    cmm:physicalColumn "valid_to_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Valid To Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .

cmm:ProfitCenter a owl:Class ;
    rdfs:label "Profit Center"@en ;
    rdfs:comment "SAP S/4HANA CO organizational master representing the full internal management reporting hierarchy — both cost collection units (cost centers) and autonomous business segments (profit centers). Captures organizational unit ID, name, hierarchy node and level, controlling area, responsible manager, parent unit, unit type (cost center or profit center), currency, validity period, activity type, segment classification, and FERC functional classification (generation, transmission, distribution, corporate). Cost center attributes include overhead allocation basis, activity type, and cost element group. Profit center attributes include segment P&L responsibility and business unit classification. SSOT for OPEX cost collection, overhead allocation, segment P&L reporting, and FERC cost-of-service study segmentation. Replaces separate cost_center and profit_center entities to reflect the unified organizational hierarchy used in utility finance operations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimExtends cim:Organisation ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.profit_center" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "SAP CO; SAP CO-PCA Profit Center" ;
    cmm:sourceObject "energy_utilities_ecm.finance.profit_center" ;
    owl:hasKey ( cmm:ProfitCenter.profitCenterId ) .

cmm:ProfitCenter.profitCenterId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center id"@en ;
    rdfs:comment "Unique identifier for the profit center or cost center organizational unit within SAP S/4HANA Controlling (CO) module. Primary key for internal management reporting hierarchy."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:long ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Profit Center ID" ;
    cmm:cimDatatype "Integer" .
cmm:ProfitCenter.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Foreign key reference to the employee who is accountable for the financial performance and operational results of this organizational unit. Used for management accountability reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Manager ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_profit_center_employee_id" ;
    cmm:cimAssociation "Organisation.ErpPersonnel" .
cmm:ProfitCenter.parentProfitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent profit center"@en ;
    rdfs:comment "Foreign key reference to the parent organizational unit in the management reporting hierarchy. Null for top-level units. Enables roll-up reporting and hierarchical cost allocation."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "parent_profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Parent Profit Center ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_profit_center_parent_profit_center_id" ;
    cmm:cimAssociation "Organisation.Organisation" .
cmm:ProfitCenter.activityType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "activity type"@en ;
    rdfs:comment "Primary activity type for cost center activity-based costing. Represents the unit of work output (e.g., labor hours, machine hours, MWh generated) used for internal cost allocation and overhead distribution."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "activity_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Activity Type" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.budgetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget amount"@en ;
    rdfs:comment "Approved annual budget amount for this organizational unit in the units currency. Used for variance analysis, budget vs. actual reporting, and financial performance management."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "budget_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Budget Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ProfitCenter.budgetFiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget fiscal year"@en ;
    rdfs:comment "Fiscal year for which the budget amount is applicable. Supports multi-year budget tracking and historical budget analysis."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:int ;
    cmm:physicalColumn "budget_fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:ProfitCenter.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "SAP business area classification for cross-company code segment reporting. Used for consolidated financial statements across multiple legal entities."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.businessUnitClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business unit classification"@en ;
    rdfs:comment "Strategic business unit classification for profit centers. Regulated units operate under PUC rate regulation; unregulated units operate in competitive markets; merchant units trade energy; renewable units manage clean energy assets; wholesale units serve bulk power markets; retail units serve end customers."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_unit_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Unit Classification" ;
    cmm:validValues "regulated|unregulated|merchant|renewable|wholesale|retail" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.capexOpexClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex opex classification"@en ;
    rdfs:comment "Primary expenditure classification for this organizational unit. CAPEX units manage capital projects and asset investments; OPEX units manage operating costs and maintenance; mixed units handle both capital and operating activities."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_opex_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) / Operational Expenditure (OPEX) Classification" ;
    cmm:validValues "capex|opex|mixed" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code representing the legal entity to which this organizational unit is assigned for external financial reporting and statutory compliance."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.controllingArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlling area"@en ;
    rdfs:comment "SAP Controlling Area code to which this organizational unit belongs. Represents the highest level of cost accounting and internal management reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlling_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlling Area (CO)" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.costCenterCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center category"@en ;
    rdfs:comment "Classification of cost center type for cost allocation methodology. Production centers directly support generation/transmission/distribution; service centers provide internal services; administrative centers are corporate overhead; overhead centers are indirect costs; project centers track capital initiatives."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center Category" ;
    cmm:validValues "production|service|administrative|overhead|project" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.costElementGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost element group"@en ;
    rdfs:comment "Primary cost element group classification for this organizational unit. Groups related cost types (labor, materials, services, depreciation) for financial analysis and variance reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_element_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Element Group" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this organizational unit record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Organisation.createdDateTime .
cmm:ProfitCenter.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for financial transactions and reporting in this organizational unit. Typically USD for US utilities."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ProfitCenter.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Depreciation methodology applied to assets assigned to this organizational unit. Straight-line is standard for utility rate-making; declining balance for tax purposes; units of production for generation assets; group composite for T&D infrastructure."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|units_of_production|group_composite" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.fercFunctionalClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc functional classification"@en ;
    rdfs:comment "FERC functional classification for cost-of-service studies and rate case filings. Maps organizational unit to generation, transmission, distribution, or corporate support functions per FERC Uniform System of Accounts."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_functional_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Functional Classification" ;
    cmm:validValues "generation|transmission|distribution|corporate|customer_service|administrative" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.geographicRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic region"@en ;
    rdfs:comment "Geographic region or service territory associated with this organizational unit. Used for regional performance analysis, regulatory jurisdiction mapping, and geographic cost allocation."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Region" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.hierarchyLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy level"@en ;
    rdfs:comment "Numeric level in the organizational hierarchy tree. Level 1 represents top-level units, with increasing numbers for deeper nesting. Used for hierarchical aggregation and drill-down reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:int ;
    cmm:physicalColumn "hierarchy_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hierarchy Level" ;
    cmm:cimDatatype "Integer" .
cmm:ProfitCenter.hierarchyNodePath a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy node path"@en ;
    rdfs:comment "Full path from root to this node in the organizational hierarchy, represented as a delimited string of profit center codes. Enables efficient ancestor and descendant queries."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "hierarchy_node_path" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hierarchy Node Path" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or system identifier of the person or process that last modified this organizational unit record. Supports SOX compliance and audit requirements."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this organizational unit record was last updated. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ProfitCenter.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity jurisdiction for reliability compliance. Used for CIP (Critical Infrastructure Protection) compliance tracking and reliability reporting segmentation. Reference-value candidates: WECC|TRE|SERC|RFC|MRO|NPCC|SPP|FRCC."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.overheadAllocationBasis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overhead allocation basis"@en ;
    rdfs:comment "Allocation basis used to distribute overhead costs from this cost center to other organizational units or products. Critical for FERC cost-of-service studies and rate case preparation."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "overhead_allocation_basis" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Overhead Allocation Basis" ;
    cmm:validValues "direct_labor|headcount|square_footage|mwh_generated|asset_value|revenue" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.profitCenterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center code"@en ;
    rdfs:comment "Business identifier code for the organizational unit as defined in SAP Controlling Area. Used in financial reporting, cost allocation, and FERC account mapping."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "profit_center_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Profit Center Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ProfitCenter.profitCenterDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center description"@en ;
    rdfs:comment "Detailed business description of the organizational units purpose, scope, and responsibilities. Provides context for financial analysis and management reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "profit_center_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Organizational Unit Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:ProfitCenter.profitCenterName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center name"@en ;
    rdfs:comment "Full business name of the profit center or cost center organizational unit. Human-readable label for management reporting and financial consolidation."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "profit_center_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Profit Center Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:ProfitCenter.profitCenterStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit center status"@en ;
    rdfs:comment "Current lifecycle status of the organizational unit. Active units accept cost postings; inactive units are retained for historical reporting; planned units are future organizational changes; closed units are archived."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "profit_center_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Organizational Unit Status" ;
    cmm:validValues "active|inactive|planned|closed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Organisation.status .
cmm:ProfitCenter.rabInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion flag"@en ;
    rdfs:comment "Boolean indicator whether costs from this organizational unit are included in the Regulatory Asset Base for rate-making purposes. True for regulated utility operations; false for unregulated competitive businesses."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProfitCenter.responsibility a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsibility"@en ;
    rdfs:comment "Level of P&L accountability for profit centers. Full P&L includes both revenue and cost responsibility; revenue-only tracks top-line performance; cost-only tracks expense management; none indicates cost center classification."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsibility" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Profit Center Profit and Loss (P&L) Responsibility" ;
    cmm:validValues "full_pl|revenue_only|cost_only|none" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.roeTarget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "roe target"@en ;
    rdfs:comment "Target return on equity rate for this profit center as authorized by regulatory commission or established by corporate finance policy. Expressed as a decimal (e.g., 0.0950 for 9.50%). Critical for rate case filings and performance evaluation."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "roe_target" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return on Equity (ROE) Target" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:ProfitCenter.rtoIsoAffiliation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso affiliation"@en ;
    rdfs:comment "RTO or ISO market affiliation for this organizational unit (e.g., PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP). Relevant for generation and transmission units participating in wholesale energy markets."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_affiliation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Affiliation" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.segment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment"@en ;
    rdfs:comment "Segment classification for IFRS and US GAAP segment reporting requirements. Represents reportable business segments for external financial disclosure."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Segment Classification" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.shortName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "short name"@en ;
    rdfs:comment "Abbreviated name for the organizational unit used in reports and dashboards where space is constrained."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "short_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Profit Center Short Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.aliasName .
cmm:ProfitCenter.soxControlScopeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control scope flag"@en ;
    rdfs:comment "Boolean indicator whether this organizational unit is within the scope of SOX financial controls and audit requirements. True for units with material financial impact; false for immaterial or non-financial units."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_scope_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Scope Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProfitCenter.unitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit type"@en ;
    rdfs:comment "Classification of the organizational unit as either a cost center (cost collection only) or profit center (autonomous business segment with P&L responsibility)."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Organizational Unit Type" ;
    cmm:validValues "cost_center|profit_center" ;
    cmm:cimDatatype "String" .
cmm:ProfitCenter.validFromDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valid from date"@en ;
    rdfs:comment "Effective start date for this organizational unit configuration. Supports time-dependent organizational structures and historical reporting."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:date ;
    cmm:physicalColumn "valid_from_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Valid From Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ProfitCenter.validToDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valid to date"@en ;
    rdfs:comment "Effective end date for this organizational unit configuration. Null for currently active configurations. Supports organizational restructuring and historical analysis."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:date ;
    cmm:physicalColumn "valid_to_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Valid To Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ProfitCenter.waccRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wacc rate"@en ;
    rdfs:comment "Weighted average cost of capital rate applied to this organizational unit for capital budgeting and investment analysis. Expressed as a decimal (e.g., 0.0725 for 7.25%). Used in NPV calculations and rate case ROE filings."@en ;
    rdfs:domain cmm:ProfitCenter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wacc_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weighted Average Cost of Capital (WACC) Rate" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .

cmm:GlAccount a owl:Class ;
    rdfs:label "Gl Account"@en ;
    rdfs:comment "General ledger chart of accounts master aligned to FERC Uniform System of Accounts (USoA) and SAP S/4HANA FI-GL. Captures FERC account code, account type (asset, liability, equity, revenue, expense), balance sheet vs. P&L indicator, tax category, reconciliation account flag, and controlling relevance. SSOT for all financial account classifications."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpChartOfAccounts ;
    cmm:cimCloseMatch cim:ErpChartOfAccounts ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.asset_accounting ;
    cmm:physicalTable "utility_cmm_silver.finance.gl_account" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC USoA (18 CFR 101); FERC Uniform System of Accounts / SAP FI-GL Account Master" ;
    cmm:sourceObject "energy_utilities_ecm.finance.gl_account" ;
    owl:hasKey ( cmm:GlAccount.glAccountId ) .

cmm:GlAccount.glAccountId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account id"@en ;
    rdfs:comment "Unique identifier for the general ledger account. Primary key for the GL account master data."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:long ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "General Ledger (GL) Account Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:GlAccount.accountGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account group"@en ;
    rdfs:comment "SAP account group that controls field status, number range, and screen layout for the account. Examples: ASSETS, LIABILITIES, REVENUE, EXPENSE."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Group" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.accountName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account name"@en ;
    rdfs:comment "Short descriptive name of the GL account. Human-readable label used in financial statements and reports."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "General Ledger (GL) Account Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:GlAccount.accountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account number"@en ;
    rdfs:comment "The externally-known GL account number used in SAP S/4HANA chart of accounts. This is the business identifier displayed on financial reports, journal entries, and trial balances."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "General Ledger (GL) Account Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:valuePattern "^[A-Z0-9]{4,16}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GlAccount.accountStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account status"@en ;
    rdfs:comment "Current lifecycle status of the GL account. Active accounts accept postings; inactive accounts are temporarily disabled; blocked accounts prevent all activity; retired accounts are permanently closed."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "General Ledger (GL) Account Status" ;
    cmm:validValues "active|inactive|blocked|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpChartOfAccounts.status .
cmm:GlAccount.accountType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account type"@en ;
    rdfs:comment "High-level classification of the account into one of the five fundamental accounting categories: asset, liability, equity, revenue, or expense. Determines financial statement placement and normal balance (debit or credit)."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "General Ledger (GL) Account Type" ;
    cmm:validValues "asset|liability|equity|revenue|expense" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpChartOfAccounts.type .
cmm:GlAccount.alternativeAccountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alternative account number"@en ;
    rdfs:comment "Alternative or legacy account number used for cross-reference purposes during system migrations or consolidations. Maintains traceability to prior chart of accounts structures."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "alternative_account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Alternative General Ledger (GL) Account Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GlAccount.balanceSheetIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balance sheet indicator"@en ;
    rdfs:comment "Flag indicating whether this account appears on the balance sheet (true) or profit and loss statement (false). Balance sheet accounts carry balances forward; P&L accounts reset annually."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "balance_sheet_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balance Sheet Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.capexOpexIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex opex indicator"@en ;
    rdfs:comment "Classifies the account as capital expenditure (CAPEX - capitalized and depreciated), operational expenditure (OPEX - expensed immediately), or not applicable. Critical for regulatory reporting and financial planning."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_opex_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) or Operational Expenditure (OPEX) Indicator" ;
    cmm:validValues "CAPEX|OPEX|N/A" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.chartOfAccounts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "chart of accounts"@en ;
    rdfs:comment "Identifier of the chart of accounts to which this GL account belongs. Utilities typically maintain a FERC-aligned chart of accounts."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "chart_of_accounts" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Chart of Accounts Code" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code to which this GL account belongs. Company code represents a legal entity for financial reporting and consolidation purposes."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.controllingRelevanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlling relevance flag"@en ;
    rdfs:comment "Indicates whether postings to this account are relevant for Controlling (CO) module and should flow to cost centers, internal orders, or profitability segments."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "controlling_relevance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlling (CO) Relevance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.costElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost element"@en ;
    rdfs:comment "Cost element code used in SAP Controlling (CO) module for cost center accounting, internal orders, and profitability analysis. Links financial accounting to management accounting."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlling (CO) Cost Element" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this GL account master record was first created in the system. Part of the audit trail for SOX compliance."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpChartOfAccounts.createdDateTime .
cmm:GlAccount.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the account. Most utility accounts use USD, but multi-national utilities may have accounts in other currencies."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:GlAccount.depreciationRelevantFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation relevant flag"@en ;
    rdfs:comment "Indicates whether this account is subject to depreciation calculations. Typically true for fixed asset accounts and false for expense or liability accounts."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "depreciation_relevant_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Relevant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date after which this GL account is no longer active for new postings. Null for currently active accounts. Used for account retirement and chart of accounts cleanup."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:GlAccount.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date from which this GL account becomes active and available for posting. Used for phased chart of accounts implementations and regulatory changes."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:GlAccount.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts (USoA) account code. Mandatory for regulated utilities to classify assets, liabilities, revenues, and expenses according to federal regulatory standards. Examples: 101 (Electric Plant in Service), 254 (Accounts Payable), 400 (Operation Expense), 440 (Rent Expense)."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[1-9][0-9]{2,5}$" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.fieldStatusGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field status group"@en ;
    rdfs:comment "SAP field status group that controls which fields are required, optional, or hidden when posting to this account. Enforces data entry rules and compliance requirements."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "field_status_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Field Status Group" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.financialStatementItem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "financial statement item"@en ;
    rdfs:comment "Code that maps the GL account to a specific line item on the balance sheet or profit and loss statement. Used for financial statement generation and consolidation reporting."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "financial_statement_item" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Financial Statement Item Code" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.functionalArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area"@en ;
    rdfs:comment "Functional area classification for segment reporting and management accounting. Examples: generation, transmission, distribution, customer service, administration. Used for FERC functional cost allocation."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area Code" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.lineItemDisplayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line item display flag"@en ;
    rdfs:comment "Indicates whether individual line items can be displayed for this account. Required for detailed transaction analysis and audit trails."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "line_item_display_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Line Item Display Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.longDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "long description"@en ;
    rdfs:comment "Extended description providing detailed explanation of the account purpose, usage guidelines, and posting rules. Used for training and audit documentation."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "long_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Long Description" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "User ID of the person who last modified this GL account master record. Used for change tracking and audit trail."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when this GL account master record was last modified. Part of the audit trail for SOX compliance and change management."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GlAccount.openItemManagementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "open item management flag"@en ;
    rdfs:comment "Indicates whether this account uses open item management, where individual line items remain open until explicitly cleared. Typically used for accounts receivable, accounts payable, and clearing accounts."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "open_item_management_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Open Item Management Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.planningBlockedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning blocked flag"@en ;
    rdfs:comment "Indicates whether this account is blocked for planning and budgeting activities. Used to exclude certain accounts from budget allocation processes."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "planning_blocked_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Blocked Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.postingBlockedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting blocked flag"@en ;
    rdfs:comment "Indicates whether direct postings to this account are blocked. Used to prevent accidental postings to control accounts or retired accounts."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "posting_blocked_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Blocked Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.profitLossIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profit loss indicator"@en ;
    rdfs:comment "Flag indicating whether this account appears on the profit and loss statement (income statement). P&L accounts measure periodic performance and are closed to retained earnings at year-end."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "profit_loss_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Profit and Loss (P&L) Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether costs posted to this account are eligible for inclusion in the Regulatory Asset Base (RAB) for rate-making purposes. RAB-eligible assets earn a regulated return on equity (ROE)."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.reconciliationAccountFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation account flag"@en ;
    rdfs:comment "Indicates whether this is a reconciliation account (subledger control account) that summarizes detailed transactions from subsidiary ledgers such as accounts receivable, accounts payable, or asset accounting. Reconciliation accounts cannot be posted to directly."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reconciliation_account_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Account Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.sortKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sort key"@en ;
    rdfs:comment "Sorting rule that determines how line items are sorted within the account (e.g., by posting date, document number, or amount). Used for account display and reconciliation."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "sort_key" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sort Key" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this account is subject to SOX internal control requirements and enhanced audit scrutiny. Typically true for material accounts affecting financial statement accuracy."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GlAccount.taxCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax category"@en ;
    rdfs:comment "Tax classification code that determines how transactions posted to this account are treated for tax reporting purposes. Examples: taxable income, non-taxable expense, capital expenditure."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Category Code" ;
    cmm:cimDatatype "String" .
cmm:GlAccount.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID of the person who created this GL account master record. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:GlAccount ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:JournalEntry a owl:Class ;
    rdfs:label "Journal Entry"@en ;
    rdfs:comment "SAP S/4HANA FI-GL journal entry header capturing all financial postings including manual entries, accruals, reversals, recurring entries, intercompany eliminations, and regulatory adjustments. Records document number, document type, posting date, fiscal year/period, company code, ledger group (leading/non-leading/extension), reference document, posting user, approval workflow status, and SOX control evidence reference. Core transactional record for the general ledger — every financial event in the utility ultimately creates or references a journal entry."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpJournal ;
    cmm:cimCloseMatch cim:ErpJournal ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.journal_entry" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI-GL Journal Entry (FB50/BKPF)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.journal_entry" ;
    owl:hasKey ( cmm:JournalEntry.journalEntryId ) .

cmm:JournalEntry.journalEntryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry id"@en ;
    rdfs:comment "Unique identifier for the journal entry record. Primary key for the journal entry entity."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:long ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Journal Entry ID" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntry.approverUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approver user employee"@en ;
    rdfs:comment "SAP user ID of the individual who approved this journal entry for posting. Populated only when approval_status is approved or posted. Required for SOX compliance and segregation of duties evidence."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approver_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_approver_user_employee_id" ;
    cmm:cimAssociation "ErpJournal.ErpPersonnel" .
cmm:JournalEntry.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Identifier of the capital project or work order associated with this journal entry. Links financial postings to specific infrastructure projects, generation plant construction, grid modernization initiatives, or renewable energy integration projects."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_capex_project_id" ;
    cmm:cimAssociation "ErpJournal.Project" .
cmm:JournalEntry.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Journal entries can have default cost center assignments at the header level (in addition to line-level assignments). The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_cost_center_id" ;
    cmm:cimAssociation "ErpJournal.Organisation" .
cmm:JournalEntry.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Foreign key linking to generation.generating_unit. Business justification: Manual journal entries adjust unit-level costs (accruals, reclassifications). Essential for period-end close, audit trail, and regulatory accounting adjustments."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_generating_unit_id" ;
    cmm:cimAssociation "ErpJournal.GeneratingUnit" .
cmm:JournalEntry.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level journal entries for cost allocations and corrections. Required for regulatory accounting adjustments and FERC compliance."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_power_plant_id" ;
    cmm:cimAssociation "ErpJournal.Plant" .
cmm:JournalEntry.primaryJournalEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary journal employee"@en ;
    rdfs:comment "SAP user ID of the individual who created and posted this journal entry. Used for audit trail, SOX compliance, segregation of duties monitoring, and user activity analysis."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_journal_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Posting User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_primary_journal_employee_id" ;
    cmm:cimAssociation "ErpJournal.ErpPersonnel" .
cmm:JournalEntry.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Journal entries can have default profit center assignments at the header level (in addition to line-level assignments). The profit_center (STRING) should be replaced with FK to profit_center.profit_ce"@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_profit_center_id" ;
    cmm:cimAssociation "ErpJournal.Organisation" .
cmm:JournalEntry.recurringEntryTemplate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recurring entry template"@en ;
    rdfs:comment "Identifier of the recurring entry template that generated this journal entry. Populated only when recurring_entry_indicator is true. Links the posted entry back to its master template for audit and maintenance purposes."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range cmm:RecurringEntryTemplate ;
    cmm:physicalColumn "recurring_entry_template_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Recurring Entry Template ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_recurring_entry_template_id" ;
    cmm:cimAssociation "ErpJournal.Document" .
cmm:JournalEntry.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current state of the journal entry in the approval workflow. Draft = entry created but not submitted; Pending Approval = submitted for review; Approved = authorized for posting; Rejected = denied by approver; Posted = successfully posted to GL. Supports SOX-compliant maker-checker controls."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "draft|pending_approval|approved|rejected|posted" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the journal entry was approved by the authorized approver. Populated only when approval_status is approved or posted. Part of the SOX control evidence and audit trail."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:JournalEntry.assetClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "Classification of the fixed asset associated with this journal entry (e.g., Generation Plant, Transmission Lines, Distribution Equipment, Substation Assets, Metering Infrastructure). Used for depreciation calculation, asset lifecycle management, and regulatory reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "High-level business segment code for external financial statement reporting. Represents major lines of business (e.g., Electric Utility Operations, Gas Distribution, Renewable Energy Services) for segment disclosure under GAAP/IFRS."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.capitalVsExpenseIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital vs expense indicator"@en ;
    rdfs:comment "Classification of the journal entry as either CAPEX (capital expenditure - capitalized to balance sheet) or OPEX (operational expenditure - expensed to income statement). Critical for regulatory asset base (RAB) calculations, rate case filings, and EBITDA reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "capital_vs_expense_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) vs Operational Expenditure (OPEX) Indicator" ;
    cmm:validValues "CAPEX|OPEX" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "Four-character alphanumeric code identifying the legal entity or operating company within the utility enterprise. Represents the organizational unit for which a complete self-contained set of accounts can be drawn up for purposes of external reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.costAllocationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation method"@en ;
    rdfs:comment "Method used to allocate costs across company codes, business units, or regulatory jurisdictions. Direct = costs directly assigned to a single entity; Allocated = costs distributed using allocation keys (e.g., headcount, revenue); Apportioned = costs split based on regulatory formulas; Shared Services = costs from centralized service centers. Critical for rate case cost-of-service studies."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Method" ;
    cmm:validValues "direct|allocated|apportioned|shared_services" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the transaction currency of this journal entry (e.g., USD, EUR, GBP, CAD). All monetary amounts in the journal entry lines are denominated in this currency."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:JournalEntry.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Depreciation calculation method applied for this journal entry. Straight Line = equal annual depreciation; Declining Balance = accelerated depreciation; Units of Production = usage-based depreciation; Regulatory Prescribed = depreciation rates mandated by FERC or state PUC. Populated for depreciation-related journal entries."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|units_of_production|regulatory_prescribed" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The date printed on the source document or invoice that originated this journal entry. Used for document aging, payment terms calculation, and audit trail reconciliation. May differ from posting date due to processing delays."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntry.documentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document number"@en ;
    rdfs:comment "Ten-digit unique accounting document number assigned by SAP FI-GL upon posting. Serves as the externally-known business identifier for this journal entry across all financial reporting and audit trails."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Document Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntry.documentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "Two-character code classifying the nature and origin of the journal entry. Examples: SA (G/L account document), AB (Accounting document), AF (Depreciation posting), DR (Customer invoice), KR (Vendor invoice), RE (Invoice receipt), RV (Billing document), WA (Goods issue), WE (Goods receipt), ZP (Payment document). Controls number ranges, account types allowed, and posting rules. Reference-value candidates: SA|AB|AF|DR|DZ|KA|KG|KN|KR|RE|RV|WA|WE|ZP."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Type" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.entryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entry date"@en ;
    rdfs:comment "The calendar date on which the journal entry was physically entered into the SAP system by the user. Used for audit trail, user activity tracking, and SOX compliance evidence."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:date ;
    cmm:physicalColumn "entry_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entry Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntry.exchangeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exchange rate"@en ;
    rdfs:comment "Exchange rate applied to convert foreign currency amounts to the company code's local currency. Populated for journal entries involving foreign currency transactions. Expressed as local currency per one unit of foreign currency."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "exchange_rate" ;
    cmm:sqlDataType "DECIMAL(15,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exchange Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:JournalEntry.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "Three-digit FERC Uniform System of Accounts code classifying the journal entry for regulatory reporting. Examples: 101 (Electric Plant in Service), 108 (Accumulated Depreciation), 400 (Operation Expense), 500 (Maintenance Expense). Required for FERC Form 1 and state PUC filings."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "Four-digit fiscal year in which the journal entry is posted. Aligns with the utility's fiscal calendar and determines the accounting period structure for regulatory and financial reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntry.functionalArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area"@en ;
    rdfs:comment "Classification of the journal entry by business function (e.g., Power Generation, Grid Operations, Customer Service, Regulatory Affairs, Corporate Administration). Used for functional cost analysis and segment reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.headerText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "header text"@en ;
    rdfs:comment "Free-form text field providing a descriptive explanation or memo for the entire journal entry. Typically includes the business reason for the posting, project references, or special instructions for auditors and reviewers."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "header_text" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Header Text" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.intercompanyIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intercompany indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this journal entry involves intercompany transactions between multiple company codes within the utility enterprise. True for entries requiring intercompany elimination in consolidated financial statements."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "intercompany_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Intercompany Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the journal entry record was last updated in the system. Captures any changes to header fields, approval status, or document attributes after initial creation. Part of the audit trail for change tracking."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:JournalEntry.ledgerGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ledger group"@en ;
    rdfs:comment "Two-character code identifying the ledger in which this entry is recorded. 0L = Leading Ledger (statutory GAAP reporting), 2L = Non-Leading Ledger (IFRS or management reporting), 3L = Extension Ledger (regulatory adjustments for FERC/PUC), 9L = Tax Ledger. Supports parallel accounting for multiple reporting frameworks."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "ledger_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ledger Group" ;
    cmm:validValues "0L|2L|3L|9L" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.parkedDocumentIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "parked document indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this journal entry is parked (saved but not yet posted to the general ledger). True for entries awaiting additional information, approval, or final review before posting. Parked documents do not update account balances."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "parked_document_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Parked Document Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which the journal entry is posted to the general ledger. Determines the fiscal period assignment and is the primary date for financial statement reporting and regulatory compliance. Distinct from document date and entry date."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntry.postingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting period"@en ;
    rdfs:comment "Numeric posting period (1-16) within the fiscal year. Periods 1-12 represent standard monthly periods; periods 13-16 are special periods for year-end adjustments, accruals, and closing entries required for regulatory filings."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:int ;
    cmm:physicalColumn "posting_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Period" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntry.postingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting timestamp"@en ;
    rdfs:comment "Date and time when the journal entry was successfully posted to the general ledger. Represents the exact moment the entry became part of the official books of record. Used for audit trail and transaction sequencing."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "posting_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:JournalEntry.rabEligibleIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible indicator"@en ;
    rdfs:comment "Boolean flag indicating whether the costs in this journal entry are eligible for inclusion in the utility's regulatory asset base (RAB) for rate-making purposes. True for prudent capital investments approved by the PUC for cost recovery through customer rates."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.rateCaseReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate case reference"@en ;
    rdfs:comment "Reference identifier linking this journal entry to a specific rate case filing or regulatory proceeding. Used to track costs and investments that are subject to regulatory review and rate recovery approval."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_case_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Case Reference" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.recurringEntryIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recurring entry indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this journal entry was generated from a recurring entry template. True for automated postings such as monthly depreciation, lease payments, insurance premiums, and other predictable periodic entries."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "recurring_entry_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recurring Entry Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.referenceDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference document number"@en ;
    rdfs:comment "Free-text field capturing the external reference number from the source document (e.g., vendor invoice number, purchase order number, contract reference, regulatory filing reference). Used for cross-referencing and audit trail documentation."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reference Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntry.regulatoryAdjustmentIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory adjustment indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this journal entry represents a regulatory accounting adjustment required by FERC, state PUC, or other utility regulatory bodies. True for entries that adjust GAAP results to regulatory accounting principles for rate case filings and regulatory asset base (RAB) calculations."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_adjustment_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Adjustment Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.reversalIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this journal entry is a reversal of a prior entry. True if this document reverses a previous posting (e.g., accrual reversal, error correction). Used to identify offsetting entries in audit and reconciliation processes."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntry.reversedDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversed document number"@en ;
    rdfs:comment "The document number of the original journal entry that this entry reverses. Populated only when reversal_indicator is true. Establishes the audit trail linkage between the original posting and its reversal."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversed_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reversed Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntry.soxControlReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control reference"@en ;
    rdfs:comment "Reference code linking this journal entry to the specific SOX internal control that governs its creation, approval, and posting. Examples include control IDs for manual journal entry reviews, segregation of duties, and management review controls. Required for SOX 404 compliance documentation."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "sox_control_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Reference" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.tradingPartnerCompanyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading partner company code"@en ;
    rdfs:comment "The company code of the intercompany trading partner for this journal entry. Populated only when intercompany_indicator is true. Used for intercompany reconciliation and elimination entries in consolidated reporting."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "trading_partner_company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trading Partner Company Code" ;
    cmm:cimDatatype "String" .
cmm:JournalEntry.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "Work Breakdown Structure element code identifying the specific phase or component of a capital project to which this journal entry is assigned. Enables detailed project cost tracking and earned value management."@en ;
    rdfs:domain cmm:JournalEntry ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .

cmm:JournalEntryLine a owl:Class ;
    rdfs:label "Journal Entry Line"@en ;
    rdfs:comment "Line-item detail of SAP S/4HANA FI-GL journal entries. Each line captures GL account, cost center, profit center, WBS element, functional area, debit/credit indicator, amount in transaction and local currency, tax code, and FERC account code. Enables granular cost allocation and regulatory account-level reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpJournalEntry ;
    cmm:cimExactMatch cim:ErpJournalEntry ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.journal_entry_line" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI-GL Line Item (BSEG)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.journal_entry_line" ;
    owl:hasKey ( cmm:JournalEntryLine.journalEntryLineId ) .

cmm:JournalEntryLine.journalEntryLineId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry line id"@en ;
    rdfs:comment "Unique identifier for the journal entry line item. Primary key for granular financial transaction detail."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:long ;
    cmm:physicalColumn "journal_entry_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Journal Entry Line ID" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntryLine.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Journal entry lines can post to fixed assets for capitalization, depreciation, and asset-related adjustments. The asset_number (STRING) should be replaced with FK to fixed_asset.fixed_asset_id, enabli"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_fixed_asset_id" ;
    cmm:cimAssociation "ErpJournalEntry.FinancialInfo" .
cmm:JournalEntryLine.journalCostCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Journal entry lines are assigned to cost centers for cost allocation and management reporting. The cost_center_code (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN to"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "journal_cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:sourceColumn "cost_center_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_journal_cost_center_id" ;
    cmm:cimAssociation "ErpJournalEntry.Organisation" .
cmm:JournalEntryLine.journalGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Journal entry lines post to GL accounts. This is a core financial posting relationship. The gl_account_code (STRING) should be replaced with a proper FK to gl_account.gl_account_id, allowing JOIN to r"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "journal_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_journal_gl_account_id" ;
    cmm:cimAssociation "ErpJournalEntry.ErpChartOfAccounts" .
cmm:JournalEntryLine.journalProfitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Journal entry lines are assigned to profit centers for internal management reporting and segment analysis. The profit_center_code (STRING) should be replaced with FK to profit_center.profit_center_id,"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "journal_profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:sourceColumn "profit_center_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_journal_profit_center_id" ;
    cmm:cimAssociation "ErpJournalEntry.Organisation" .
cmm:JournalEntryLine.primaryJournalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary journal entry"@en ;
    rdfs:comment "Foreign key reference to the parent journal entry header document. Links line-item detail to the overall posting document."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "primary_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Journal Entry Header ID" ;
    cmm:sourceColumn "journal_entry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_primary_journal_entry_id" ;
    cmm:cimAssociation "ErpJournalEntry.ErpJournal" .
cmm:JournalEntryLine.toCostCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to cost center"@en ;
    rdfs:comment "FK to finance.cost_center.cost_center_id — Journal entry lines for expense postings must reference a cost center for cost allocation and OPEX tracking. Critical for management reporting and FERC cost-of-service studies."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "to_cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_to_cost_center_id" ;
    cmm:cimAssociation "ErpJournalEntry.Organisation" .
cmm:JournalEntryLine.toGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to gl account"@en ;
    rdfs:comment "FK to finance.gl_account.gl_account_id — Every journal entry line posts to a GL account. This is the core debit/credit posting relationship. Without this FK, you cannot produce a trial balance or any financial statement."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "to_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_to_gl_account_id" ;
    cmm:cimAssociation "ErpJournalEntry.ErpChartOfAccounts" .
cmm:JournalEntryLine.toJournalEntryRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Fundamental header-to-line relationship. Every journal entry line must reference its parent journal entry header. This is the most critical FK in the GL — without it, line items are orphaned and the l"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "to_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_to_journal_entry_id" ;
    cmm:cimAssociation "ErpJournalEntry.ErpJournal" .
cmm:JournalEntryLine.toProfitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to profit center"@en ;
    rdfs:comment "FK to finance.profit_center.profit_center_id — Journal entry lines reference profit centers for segment reporting. Required for internal P&L by business segment (generation, T&D, retail)."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "to_profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_journal_entry_line_to_profit_center_id" ;
    cmm:cimAssociation "ErpJournalEntry.Organisation" .
cmm:JournalEntryLine.assetSubnumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset subnumber"@en ;
    rdfs:comment "Sub-asset identifier for component-level tracking within a main asset. Supports detailed depreciation and retirement accounting."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_subnumber" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Subnumber" ;
    cmm:valuePattern "^[0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.assignmentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment reference"@en ;
    rdfs:comment "Free-text assignment field for additional line item context. Often contains invoice numbers, purchase order references, or payment identifiers."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Reference" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.baselineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline date"@en ;
    rdfs:comment "Baseline date for payment terms calculation. Determines due date for accounts payable and receivable line items."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntryLine.businessAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area code"@en ;
    rdfs:comment "Business area for segment reporting and divisional financial statements. Supports multi-segment utility operations (generation, transmission, distribution)."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,6}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.clearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing date"@en ;
    rdfs:comment "Date on which this line item was cleared (paid or offset). Null for open items."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "clearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntryLine.clearingDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing document number"@en ;
    rdfs:comment "Document number of the clearing entry that settled this open item. Null for uncleared items; populated when payment or offset is posted."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearing_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearing Document Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntryLine.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User ID of the person or system account that created this journal entry line. Supports SOX compliance and audit requirements."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:valuePattern "^[A-Z0-9]{6,12}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when this journal entry line record was first created in the source system. Audit trail for data lineage."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpJournalEntry.createdDateTime .
cmm:JournalEntryLine.debitCreditIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "debit credit indicator"@en ;
    rdfs:comment "Indicates whether this line is a debit (D) or credit (C) posting. Fundamental double-entry bookkeeping classification."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "debit_credit_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Debit/Credit Indicator" ;
    cmm:validValues "D|C" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.exchangeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exchange rate"@en ;
    rdfs:comment "Foreign exchange rate applied to convert transaction amount to local amount. Null if transaction and local currencies are identical."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "exchange_rate" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exchange Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:JournalEntryLine.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for regulatory reporting. Mandatory for rate case filings and regulatory asset base (RAB) valuations."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3,6}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.functionalAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area code"@en ;
    rdfs:comment "Functional area classification for cross-organizational cost allocation. Supports activity-based costing and functional expense reporting."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,6}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.lineItemNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line item number"@en ;
    rdfs:comment "Sequential line number within the journal entry document. Determines the ordering and position of this line in the posting."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:int ;
    cmm:physicalColumn "line_item_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Line Item Number" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntryLine.lineItemText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line item text"@en ;
    rdfs:comment "Descriptive text explaining the business purpose or nature of this journal entry line. Provides audit trail and user context."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "line_item_text" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Line Item Text" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.localAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "local amount"@en ;
    rdfs:comment "Monetary amount converted to the company code local currency. Used for consolidated financial reporting and statutory books."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "local_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Local Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:JournalEntryLine.localCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "local currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for the local amount. Typically USD for US-based utilities."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "local_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Local Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:JournalEntryLine.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID of the person or system account that last modified this journal entry line. Supports SOX compliance and change tracking."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:valuePattern "^[A-Z0-9]{6,12}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "System timestamp of the most recent modification to this journal entry line record. Tracks change history for audit and compliance."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:JournalEntryLine.paymentTermsCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment terms code"@en ;
    rdfs:comment "Payment terms key defining discount periods and due dates. Applicable to AP and AR line items."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_terms_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Terms Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.postingKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting key"@en ;
    rdfs:comment "SAP posting key determining account type (GL, customer, vendor, asset) and debit/credit direction. Controls document entry behavior."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "posting_key" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Key" ;
    cmm:valuePattern "^[0-9]{2}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.quantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Physical quantity associated with this line item (e.g., MWh for energy purchases, units for materials). Supports quantity-based cost allocation."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:JournalEntryLine.referenceDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference document number"@en ;
    rdfs:comment "External reference document number (e.g., vendor invoice number, customer bill number). Links financial posting to source operational document."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reference Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntryLine.reversalIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal indicator"@en ;
    rdfs:comment "Flag indicating whether this line item is a reversal of a prior posting. True if this is a correcting or reversing entry."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:JournalEntryLine.reversedDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversed document number"@en ;
    rdfs:comment "Document number of the original entry being reversed by this line item. Null if this is not a reversal."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversed_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reversed Document Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:JournalEntryLine.specialGlIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "special gl indicator"@en ;
    rdfs:comment "Special GL transaction type code (e.g., down payment, bill of exchange, guarantee). Enables specialized accounting treatment."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "special_gl_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Special General Ledger (GL) Indicator" ;
    cmm:valuePattern "^[A-Z]$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "Calculated tax amount for this line item in local currency. Supports tax reconciliation and regulatory tax reporting."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:JournalEntryLine.taxCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax code"@en ;
    rdfs:comment "Tax jurisdiction and rate code applied to this line item. Determines sales tax, use tax, or VAT calculation for the transaction."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,4}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.toJournalEntry a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Every journal entry line belongs to exactly one journal entry header. This is the most fundamental header→line relationship in the GL. Without this FK, you cannot reconstruct a balanced journal entry"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_journal_entry" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntryLine.toOrgUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to org unit"@en ;
    rdfs:comment "FK to finance.organizational_unit.organizational_unit_id — Journal entry lines reference cost centers and profit centers (merged into organizational_unit) for cost allocation and segment reporting. Required for management reporting and FERC cost-of-service st"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_org_unit" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntryLine.toOrganizationalUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to organizational unit"@en ;
    rdfs:comment "FK to finance.profit_center.profit_center_id — Journal entry lines reference cost centers and profit centers (merged into organizational_unit) for internal management reporting, FERC cost-of-service segmentation, and segment P&L. Critical for cost"@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_organizational_unit" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:JournalEntryLine.tradingPartnerCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading partner code"@en ;
    rdfs:comment "Intercompany trading partner identifier for elimination entries. Supports consolidated financial statements and intercompany reconciliation."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "trading_partner_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trading Partner Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.transactionAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction amount"@en ;
    rdfs:comment "Monetary amount of the line item in the original transaction currency. Unsigned value; sign is determined by debit_credit_indicator."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "transaction_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:JournalEntryLine.transactionCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for the transaction amount. Supports multi-currency operations and foreign exchange tracking."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transaction Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:JournalEntryLine.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Unit of measure for the quantity field. Common values: MWH (megawatt-hour), KWH (kilowatt-hour), EA (each), TON (ton)."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:valuePattern "^[A-Z]{2,3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:JournalEntryLine.valueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "value date"@en ;
    rdfs:comment "Value date for cash management and interest calculation. Represents the effective date for financial impact, distinct from posting date."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:date ;
    cmm:physicalColumn "value_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Value Date" ;
    cmm:cimDatatype "Date" .
cmm:JournalEntryLine.wbsElementCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element code"@en ;
    rdfs:comment "WBS element for capital project tracking. Links line items to specific capital expenditure (CAPEX) projects for asset capitalization and depreciation."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element Code" ;
    cmm:valuePattern "^[A-Z0-9\\-\\.]{6,24}$" ;
    cmm:cimDatatype "String" .
cmm:JournalEntryLine.withholdingTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withholding tax amount"@en ;
    rdfs:comment "Calculated withholding tax amount in local currency. Deducted from vendor payment and remitted to tax authority."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "withholding_tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withholding Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:JournalEntryLine.withholdingTaxCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withholding tax code"@en ;
    rdfs:comment "Withholding tax type and rate code for vendor payments. Supports IRS 1099 reporting and international withholding compliance."@en ;
    rdfs:domain cmm:JournalEntryLine ; rdfs:range xsd:string ;
    cmm:physicalColumn "withholding_tax_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withholding Tax Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,4}$" ;
    cmm:cimDatatype "String" .

cmm:ApInvoice a owl:Class ;
    rdfs:label "Ap Invoice"@en ;
    rdfs:comment "Accounts payable lifecycle record in SAP S/4HANA FI-AP covering the full payable lifecycle from invoice receipt through payment execution. Invoice attributes: vendor invoice number, invoice date, posting date, payment terms, gross amount, tax amount, withholding tax, payment block status, three-way match status (PO/GR/IR), and due date. Payment attributes: payment run date, payment method (ACH, wire, check), bank account, clearing document, payment amount, discount taken, vendor bank details, and payment status. Supports OPEX and CAPEX payable tracking for utility procurement including fuel, materials, EPC contractors, and equipment vendors. Tracks the complete procure-to-pay financial lifecycle from obligation recognition through cash disbursement."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpPayable ;
    cmm:cimCloseMatch cim:ErpPayable ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.ap_invoice" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI-AP Vendor Invoice (MIRO/FB60)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.ap_invoice" ;
    owl:hasKey ( cmm:ApInvoice.apInvoiceId ) .

cmm:ApInvoice.apInvoiceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ap invoice id"@en ;
    rdfs:comment "Unique system identifier for the accounts payable invoice record. Primary key for the AP invoice entity."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:long ;
    cmm:physicalColumn "ap_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Accounts Payable (AP) Invoice Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ApInvoice.bankAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "bank account"@en ;
    rdfs:comment "Identifier of the company bank account from which payment was disbursed. Used for cash management and bank reconciliation."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "bank_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Company Bank Account Identifier" ;
    cmm:sourceColumn "account_id" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_bank_account_id" ;
    cmm:cimAssociation "ErpPayable.CustomerAccount" .
cmm:ApInvoice.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: AP invoices are assigned to cost centers for cost allocation and budget tracking. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN to retrieve cost_cent"@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_cost_center_id" ;
    cmm:cimAssociation "ErpPayable.Organisation" .
cmm:ApInvoice.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: AP invoices post to GL accounts for expense or asset classification. The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve account_name, accoun"@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_gl_account_id" ;
    cmm:cimAssociation "ErpPayable.ErpChartOfAccounts" .
cmm:ApInvoice.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: AP invoices can be charged to internal orders for project or activity-specific cost tracking. The internal_order_number (STRING) should be replaced with FK to internal_order.internal_order_id, enablin"@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_internal_order_id" ;
    cmm:cimAssociation "ErpPayable.ErpProjectAccounting" .
cmm:ApInvoice.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Every AP invoice/payment posting creates a journal entry in the GL. This FK enables AP subledger to GL reconciliation — a core SOX control and month-end close requirement."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_journal_entry_id" ;
    cmm:cimAssociation "ErpPayable.ErpJournal" .
cmm:ApInvoice.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Reference to the vendor (supplier) from whom goods or services were procured. Links to the vendor master data."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_invoice_vendor_id" ;
    cmm:cimAssociation "ErpPayable.Organisation" .
cmm:ApInvoice.baselineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline date"@en ;
    rdfs:comment "The reference date from which payment terms are calculated. Typically the invoice date or goods receipt date depending on payment term configuration."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.clearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing date"@en ;
    rdfs:comment "The date on which the invoice was cleared (paid) in the accounts payable ledger. Marks the completion of the payable lifecycle."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "clearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "Four-character organizational unit representing the legal entity for which the invoice is posted. Used for financial consolidation and reporting."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when the invoice record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpPayable.createdDateTime .
cmm:ApInvoice.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code in which the invoice is denominated (e.g., USD, EUR, GBP)."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ApInvoice.discountAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discount amount"@en ;
    rdfs:comment "Cash discount amount available if payment is made within the discount period as defined in payment terms. Incentivizes early payment."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "discount_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cash Discount Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApInvoice.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The date on which the invoice document was created or entered into the system. Used for document control and audit trail purposes."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "due date"@en ;
    rdfs:comment "The date by which payment is due to the vendor according to the agreed payment terms. Used for cash flow planning and payment scheduling."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.exchangeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exchange rate"@en ;
    rdfs:comment "Exchange rate applied for foreign currency invoices to convert to local company currency. Used for multi-currency accounting."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "exchange_rate" ;
    cmm:sqlDataType "DECIMAL(12,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exchange Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:ApInvoice.expenditureType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expenditure type"@en ;
    rdfs:comment "Classification of the invoice as operational expenditure (OPEX) or capital expenditure (CAPEX). Critical for financial reporting and regulatory asset base (RAB) calculations."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "expenditure_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expenditure Type" ;
    cmm:validValues "OPEX|CAPEX" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "Three-digit FERC account code for regulatory reporting compliance. Required for utilities subject to FERC jurisdiction."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3}$|^$" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year in which the invoice is posted, used for period-based financial reporting and year-end closing processes."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:ApInvoice.goodsReceiptNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "goods receipt number"@en ;
    rdfs:comment "Reference to the goods receipt document confirming physical receipt of materials or services. Part of three-way match process."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "goods_receipt_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Goods Receipt (GR) Number" ;
    cmm:valuePattern "^[0-9]{10}$|^$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.grossInvoiceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gross invoice amount"@en ;
    rdfs:comment "Total invoice amount before any deductions, including line item charges, freight, and taxes. Represents the vendor's billed amount."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gross_invoice_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Gross Invoice Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApInvoice.invoiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice date"@en ;
    rdfs:comment "The date on which the vendor issued the invoice. This is the business event date used for aging analysis and payment term calculations."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "invoice_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Invoice Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.invoiceDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice description"@en ;
    rdfs:comment "Free-text description of the goods or services covered by the invoice. Provides business context for the transaction."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Invoice Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:ApInvoice.invoiceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice status"@en ;
    rdfs:comment "Current lifecycle status of the invoice in the procure-to-pay workflow. Tracks progression from receipt through payment execution. Reference-value candidates: draft|posted|parked|blocked|approved|paid|cancelled|reversed."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Invoice Processing Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpPayable.status .
cmm:ApInvoice.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "User ID of the person who last modified the invoice record. Supports change tracking and SOX compliance audit requirements."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "System timestamp when the invoice record was last modified. Critical for change audit trail and SOX compliance."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ApInvoice.netPayableAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net payable amount"@en ;
    rdfs:comment "Net amount payable to the vendor after deducting withholding tax and applying any discounts. This is the actual cash disbursement amount."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_payable_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Payable Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApInvoice.paymentBlockCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment block code"@en ;
    rdfs:comment "Single-character code indicating if the invoice is blocked for payment. Blank if not blocked. Common values include A (blocked for payment), R (blocked for review)."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_block_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Block Code" ;
    cmm:valuePattern "^[A-Z]{1}$|^$" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.paymentBlockReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment block reason"@en ;
    rdfs:comment "Textual explanation for why the invoice is blocked for payment, such as pricing discrepancy, quantity variance, or pending approval."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_block_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Block Reason" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.paymentDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment document number"@en ;
    rdfs:comment "The SAP document number of the payment document that cleared this invoice. Used to trace payment execution and bank reconciliation."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Document Number" ;
    cmm:valuePattern "^[0-9]{10}$|^$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "The payment instrument used to disburse funds to the vendor, such as ACH, wire transfer, check, or electronic payment."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:validValues "ACH|wire|check|electronic_funds_transfer|credit_card|virtual_card" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.paymentRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment run date"@en ;
    rdfs:comment "The date on which the automatic payment program was executed to generate payment for this invoice. Null if not yet paid."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Run Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.paymentTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment terms"@en ;
    rdfs:comment "Four-character code defining the payment terms agreed with the vendor, including net due days, discount periods, and discount percentages."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Terms Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which the invoice was posted to the general ledger. Determines the accounting period and fiscal year assignment."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:ApInvoice.postingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting period"@en ;
    rdfs:comment "The accounting period (typically 1-12 for monthly periods) in which the invoice was posted. Used for period-based financial reporting."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:int ;
    cmm:physicalColumn "posting_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Period" ;
    cmm:cimDatatype "Integer" .
cmm:ApInvoice.purchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order number"@en ;
    rdfs:comment "Reference to the purchase order against which this invoice is matched. Used for three-way match validation (PO/GR/IR)."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Purchase Order (PO) Number" ;
    cmm:valuePattern "^[0-9]{10}$|^$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.sapDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap document number"@en ;
    rdfs:comment "The internal SAP accounting document number generated upon invoice posting. Ten-digit numeric identifier used for financial document traceability."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "sap_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "SAP Document Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.taxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax amount"@en ;
    rdfs:comment "Total tax amount charged on the invoice, including sales tax, use tax, VAT, or other applicable taxes based on jurisdiction."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApInvoice.threeWayMatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "three way match status"@en ;
    rdfs:comment "Status of the three-way match validation comparing purchase order, goods receipt, and invoice receipt. Identifies discrepancies requiring resolution."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "three_way_match_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Three-Way Match Status" ;
    cmm:validValues "matched|variance_quantity|variance_price|variance_date|not_applicable|pending" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.vendorBankAccountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor bank account number"@en ;
    rdfs:comment "The vendor's bank account number to which payment was sent. Confidential financial information used for electronic payment processing."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_bank_account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Vendor Bank Account Number" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.vendorBankRoutingNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor bank routing number"@en ;
    rdfs:comment "Nine-digit ABA routing number for the vendor's bank. Used for ACH and wire transfer payment processing in the United States."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_bank_routing_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Vendor Bank Routing Number" ;
    cmm:sensitivity "confidential" ;
    cmm:valuePattern "^[0-9]{9}$|^$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.vendorInvoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor invoice number"@en ;
    rdfs:comment "The invoice number assigned by the vendor. This is the externally-known identifier used for vendor reconciliation and three-way matching."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_invoice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Vendor Invoice Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApInvoice.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "WBS element for capital project cost tracking. Links invoice to specific phases of capital construction or infrastructure projects."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .
cmm:ApInvoice.withholdingTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withholding tax amount"@en ;
    rdfs:comment "Amount of tax withheld at source as required by tax regulations. Reduces the net payment to the vendor."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "withholding_tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withholding Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApInvoice.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID of the person who created or entered the invoice record into the system. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:ApInvoice ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:ApPayment a owl:Class ;
    rdfs:label "Ap Payment"@en ;
    rdfs:comment "Accounts payable payment transaction in SAP S/4HANA FI-AP. Records payment run date, payment method (ACH, wire, check), bank account, clearing document, payment amount, discount taken, and vendor bank details. Tracks outgoing cash flows for vendor obligations including fuel suppliers, EPC contractors, and equipment vendors."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpPayment ;
    cmm:cimExactMatch cim:ErpPayment ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.ap_payment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI-AP Payment (F110/PAYR)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.ap_payment" ;
    owl:hasKey ( cmm:ApPayment.apPaymentId ) .

cmm:ApPayment.apPaymentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ap payment id"@en ;
    rdfs:comment "Unique identifier for the accounts payable payment transaction. Primary key."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "ap_payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Accounts Payable (AP) Payment ID" ;
    cmm:cimDatatype "Integer" .
cmm:ApPayment.apInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ap invoice"@en ;
    rdfs:comment "FK to finance.ap_invoice.ap_invoice_id — AP payments clear AP invoices. This is the core payables clearing relationship. Without it, you cannot track which invoices are paid vs. open, breaking AP aging and cash flow reporting."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:ApInvoice ;
    cmm:physicalColumn "ap_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_ap_invoice_id" ;
    cmm:cimAssociation "ErpPayment.ErpPayable" .
cmm:ApPayment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: AP payments can be assigned to cost centers for tracking payment-related costs. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN to retrieve cost center"@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_cost_center_id" ;
    cmm:cimAssociation "ErpPayment.Organisation" .
cmm:ApPayment.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: AP payments post to GL accounts for cash, clearing accounts, and payment-related entries. The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve"@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_gl_account_id" ;
    cmm:cimAssociation "ErpPayment.ErpChartOfAccounts" .
cmm:ApPayment.paymentRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment run"@en ;
    rdfs:comment "Identifier of the automated payment run batch that generated this payment. Used for grouping payments processed together."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:PaymentRun ;
    cmm:physicalColumn "payment_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Run ID" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_payment_run_id" ;
    cmm:cimAssociation "ErpPayment.ActivityRecord" .
cmm:ApPayment.primaryApInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary ap invoice"@en ;
    rdfs:comment "Foreign key linking to finance.ap_invoice. Business justification: AP payments clear AP invoices. This is a core accounts payable relationship linking payment transactions to the invoices they settle. The invoice_reference_number (STRING) should be replaced with FK t"@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:ApInvoice ;
    cmm:physicalColumn "primary_ap_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ap Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_primary_ap_invoice_id" ;
    cmm:cimAssociation "ErpPayment.ErpPayable" .
cmm:ApPayment.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: AP payments can be assigned to profit centers for internal management reporting. The profit_center (STRING) should be replaced with FK to profit_center.profit_center_id, enabling JOIN to retrieve prof"@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_profit_center_id" ;
    cmm:cimAssociation "ErpPayment.Organisation" .
cmm:ApPayment.vendorBankAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor bank account"@en ;
    rdfs:comment "Identifier of the vendor bank account receiving the payment. May be IBAN for SEPA payments or domestic account number."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:VendorBankAccount ;
    cmm:physicalColumn "vendor_bank_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor Bank Account ID" ;
    cmm:sensitivity "confidential" ;
    cmm:valuePattern "^[A-Z0-9]{10,34}$" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_vendor_bank_account_id" ;
    cmm:cimAssociation "ErpPayment.ErpBankAccount" .
cmm:ApPayment.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Identifier of the vendor receiving payment. Links to vendor master data for fuel suppliers, EPC contractors, equipment vendors, and service providers."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_ap_payment_vendor_id" ;
    cmm:cimAssociation "ErpPayment.Organisation" .
cmm:ApPayment.baselineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline date"@en ;
    rdfs:comment "The baseline date from which payment terms are calculated. Typically the invoice date or goods receipt date."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.clearingDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing document number"@en ;
    rdfs:comment "The SAP clearing document number that links the payment to the original invoice(s) being settled. Used for accounts payable reconciliation."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearing_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearing Document Number" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "The SAP company code representing the legal entity making the payment. Used for financial consolidation and SOX-compliant segregation of duties."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "The SAP user ID who created or initiated the payment transaction. Used for SOX audit trails and segregation of duties compliance."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:valuePattern "^[A-Z0-9]{12}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when the payment record was first created in the system. Used for audit trail and record lifecycle tracking."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpPayment.createdDateTime .
cmm:ApPayment.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code for the payment transaction (e.g., USD, EUR, GBP)."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ApPayment.discountAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discount amount"@en ;
    rdfs:comment "The cash discount amount taken during payment processing for early payment terms (e.g., 2/10 net 30). Reduces the net payment amount."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "discount_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cash Discount Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApPayment.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The external document date of the payment. May differ from posting date for backdated or forward-dated transactions."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "due date"@en ;
    rdfs:comment "The calculated due date for the payment based on baseline date and payment terms. Used for cash flow forecasting and working capital management."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal period (month) within the fiscal year when the payment was posted. Used for monthly financial close and reporting."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:cimDatatype "Integer" .
cmm:ApPayment.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year in which the payment was posted. Used for financial reporting and year-end closing."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:ApPayment.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "The SAP user ID who last modified the payment transaction. Used for change tracking and SOX compliance."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User ID" ;
    cmm:valuePattern "^[A-Z0-9]{12}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "The timestamp when the payment record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ApPayment.netPaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net payment amount"@en ;
    rdfs:comment "The final net amount disbursed to the vendor after applying discounts and withholding taxes. Equals payment_amount minus discount_amount minus withholding_tax_amount."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_payment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApPayment.paymentAdviceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment advice number"@en ;
    rdfs:comment "The remittance advice document number sent to the vendor. Used for vendor reconciliation and inquiry resolution."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_advice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Advice Number" ;
    cmm:valuePattern "^[A-Z0-9]{10,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.paymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment amount"@en ;
    rdfs:comment "The gross payment amount disbursed to the vendor before any adjustments. Represents the total outgoing cash flow."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "payment_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ApPayment.paymentBlockIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment block indicator"@en ;
    rdfs:comment "Single-character code indicating if payment is blocked for manual review. Common values: A (blocked for payment), B (blocked for approval), blank (not blocked)."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_block_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Block Indicator" ;
    cmm:valuePattern "^[A-Z]$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.paymentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment channel"@en ;
    rdfs:comment "The system or interface through which the payment was initiated. Distinct from payment method - represents the operational channel."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Channel" ;
    cmm:validValues "SAP|treasury_workstation|bank_portal|manual" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.paymentDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment document number"@en ;
    rdfs:comment "The externally-known unique payment document number assigned by SAP S/4HANA FI-AP during the payment run. Used for audit trails and reconciliation."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Document Number" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "The payment instrument used to disburse funds. ACH (Automated Clearing House) for domestic electronic transfers, wire for urgent or international transfers, check for physical payments, EFT (Electronic Funds Transfer), RTGS (Real-Time Gross Settlement), SEPA (Single Euro Payments Area)."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:validValues "ACH|wire|check|EFT|RTGS|SEPA" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.paymentReferenceText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment reference text"@en ;
    rdfs:comment "Free-form reference text included with the payment for vendor reconciliation. May contain invoice numbers, contract references, or remittance advice."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_reference_text" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Reference Text" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.paymentRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment run date"@en ;
    rdfs:comment "The date when the payment run was executed in SAP S/4HANA FI-AP. Represents the principal business event timestamp for this transaction."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Run Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "Current lifecycle status of the payment transaction. Tracks progression from draft through clearing or reversal."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Status" ;
    cmm:validValues "draft|pending|cleared|voided|reversed|failed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpPayment.status .
cmm:ApPayment.paymentTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment terms"@en ;
    rdfs:comment "The payment terms code defining the due date calculation and cash discount conditions (e.g., 0001 for net 30 days, Z001 for 2/10 net 30)."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Terms Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The accounting posting date when the payment transaction was recorded in the general ledger. Used for financial period assignment."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.purchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order number"@en ;
    rdfs:comment "The purchase order number associated with the payment. Links payment to procurement transaction for three-way match validation."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Purchase Order (PO) Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.reversalDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal document number"@en ;
    rdfs:comment "The document number of the reversal transaction if this payment was reversed. Null if payment has not been reversed."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reversal Document Number" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.reversalIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this payment has been reversed. True if payment was voided or reversed due to error or stop payment."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:ApPayment.reversalReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal reason code"@en ;
    rdfs:comment "Two-character code indicating the reason for payment reversal (e.g., 01 for error, 02 for stop payment, 03 for duplicate)."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reversal_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Reason Code" ;
    cmm:valuePattern "^[A-Z0-9]{2}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.valueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "value date"@en ;
    rdfs:comment "The value date when funds are actually debited from the company bank account. Used for cash position management and bank reconciliation."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:date ;
    cmm:physicalColumn "value_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Value Date" ;
    cmm:cimDatatype "Date" .
cmm:ApPayment.vendorBankName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor bank name"@en ;
    rdfs:comment "The name of the financial institution holding the vendor bank account."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_bank_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vendor Bank Name" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.vendorBankRoutingNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor bank routing number"@en ;
    rdfs:comment "The bank routing number (ABA for US, SWIFT/BIC for international) for the vendor bank account. Used for electronic payment routing."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_bank_routing_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Vendor Bank Routing Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:valuePattern "^[0-9]{9}$|^[A-Z0-9]{8,11}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ApPayment.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "The WBS element for capital project tracking. Used when payment is for CAPEX items such as generation plant construction or transmission line upgrades."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:valuePattern "^[A-Z0-9\\-]{8,24}$" ;
    cmm:cimDatatype "String" .
cmm:ApPayment.withholdingTaxAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withholding tax amount"@en ;
    rdfs:comment "The withholding tax amount deducted from the payment per regulatory requirements. Remitted separately to tax authorities."@en ;
    rdfs:domain cmm:ApPayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "withholding_tax_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withholding Tax Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:FinanceReceivable a owl:Class ;
    rdfs:label "Finance Receivable"@en ;
    rdfs:comment "Accounts receivable open item in SAP S/4HANA FI-AR representing non-customer-billing receivables such as wholesale energy sales, renewable energy certificate (REC) sales, transmission access charges (OATT), capacity market settlements, and intercompany receivables. Captures document number, posting date, due date, amount, GL account, business partner, payment terms, dunning level, clearing status, and collection activity. Distinct from billing domain customer invoices — this entity covers enterprise-level AR outside the CIS/billing system including FERC-jurisdictional wholesale receivables, ISO/RTO settlement receivables, and inter-affiliate charges."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpReceivable ;
    cmm:cimExactMatch cim:ErpReceivable ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.receivable" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP FI-AR Open Item (FBL5N)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.receivable" ;
    owl:hasKey ( cmm:FinanceReceivable.receivableId ) .

cmm:FinanceReceivable.receivableId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "receivable id"@en ;
    rdfs:comment "Primary key for receivable"@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:long ;
    cmm:physicalColumn "receivable_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Receivable Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FinanceReceivable.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Unique identifier for the business partner (debtor) who owes this receivable. May reference wholesale counterparties, ISO/RTO entities, renewable energy certificate buyers, transmission customers, or inter-affiliate entities."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Business Partner ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_account_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerAccount" .
cmm:FinanceReceivable.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Receivables can be assigned to cost centers for tracking revenue or receivable-related costs by organizational unit. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_cost_center_id" ;
    cmm:cimAssociation "ErpReceivable.Organisation" .
cmm:FinanceReceivable.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Foreign key linking to billing.invoice. Business justification: Accounts receivable entries in finance originate from customer invoices in billing. The finance.receivable table currently has account_id linking to customer but lacks the direct link to the source in"@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_invoice_id" ;
    cmm:cimAssociation "ErpReceivable.CustomerBillingInfo" .
cmm:FinanceReceivable.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Every AR posting creates a journal entry in the GL. This FK enables AR subledger to GL reconciliation for wholesale energy sales, REC sales, OATT charges, and intercompany receivables."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_journal_entry_id" ;
    cmm:cimAssociation "ErpReceivable.ErpJournal" .
cmm:FinanceReceivable.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Receivables can be assigned to profit centers for internal management reporting and segment analysis. The profit_center (STRING) should be replaced with FK to profit_center.profit_center_id."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_profit_center_id" ;
    cmm:cimAssociation "ErpReceivable.Organisation" .
cmm:FinanceReceivable.receivableGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "receivable gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Receivables post to GL accounts for accounts receivable classification. The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve account details a"@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "receivable_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_receivable_gl_account_id" ;
    cmm:cimAssociation "ErpReceivable.ErpChartOfAccounts" .
cmm:FinanceReceivable.toGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to gl account"@en ;
    rdfs:comment "FK to finance.gl_account.gl_account_id — AR items post to reconciliation GL accounts. Required for AR subledger-to-GL reconciliation and FERC revenue account reporting."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "to_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_receivable_to_gl_account_id" ;
    cmm:cimAssociation "ErpReceivable.ErpChartOfAccounts" .
cmm:FinanceReceivable.amountDocumentCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount document currency"@en ;
    rdfs:comment "The gross receivable amount in the original transaction currency (document currency). Represents the total amount due before any payments or adjustments."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount_document_currency" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Amount in Document Currency" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.amountLocalCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount local currency"@en ;
    rdfs:comment "The receivable amount converted to the company code local currency (typically USD for US utilities). Used for consolidated financial reporting and general ledger posting."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount_local_currency" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Amount in Local Currency" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.assignmentField a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment field"@en ;
    rdfs:comment "SAP assignment field used for payment matching and reconciliation. Often contains purchase order number, contract number, or settlement period identifier."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_field" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Field" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.baselineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline date"@en ;
    rdfs:comment "The reference date from which payment terms are calculated. Typically the document date or posting date depending on configuration."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Date for Payment Terms" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "SAP business area code for segment reporting (e.g., generation, transmission, distribution, trading). Enables profitability analysis by line of business."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.businessPartnerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business partner name"@en ;
    rdfs:comment "The legal name of the business partner debtor. Denormalized for reporting convenience."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_partner_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Partner Name" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.clearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing date"@en ;
    rdfs:comment "The date when the receivable was cleared (fully paid or offset). Null for open items. Used to calculate days sales outstanding (DSO)."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "clearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.clearingDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing document number"@en ;
    rdfs:comment "The accounting document number that cleared this receivable (payment document, credit memo, offset). Null for open items."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearing_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearing Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FinanceReceivable.clearingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing status"@en ;
    rdfs:comment "Current clearing status of the receivable item. Open indicates unpaid, partially_cleared indicates partial payment received, fully_cleared indicates payment complete, written_off indicates bad debt write-off, disputed indicates customer dispute in progress."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearing_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Status" ;
    cmm:validValues "open|partially_cleared|fully_cleared|written_off|disputed" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code representing the legal entity that owns this receivable. Used for multi-entity consolidation and inter-company reconciliation."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this receivable record was first created in the SAP S/4HANA FI-AR system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpReceivable.createdDateTime .
cmm:FinanceReceivable.disputeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute flag"@en ;
    rdfs:comment "Boolean flag indicating whether the receivable is currently under dispute (true = disputed, false = not disputed). Disputed items are typically excluded from aging analysis and may have dunning blocked."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispute_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FinanceReceivable.disputeReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute reason code"@en ;
    rdfs:comment "Code indicating the reason for dispute if dispute_flag is true (e.g., pricing error, quantity discrepancy, contract interpretation, metering issue). Null if no dispute."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Reason Code" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.documentCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the original transaction (e.g., USD, CAD, MXN). Determines the currency in which the receivable was invoiced."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Document Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The date printed on the source document (invoice, settlement statement, billing document). May differ from posting date due to processing delays."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.documentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document number"@en ;
    rdfs:comment "The externally-known unique accounting document number assigned by SAP S/4HANA FI-AR for this receivable item. Used for reconciliation and audit trails."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Accounting Document Number" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FinanceReceivable.documentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "SAP document type code classifying the receivable: DR (Customer Invoice), DZ (Customer Payment), RV (Billing Document), AB (Accounting Document), KR (Vendor Credit Memo), KG (Vendor Invoice). Determines posting rules and workflow."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Type Code" ;
    cmm:validValues "DR|DZ|RV|AB|KR|KG" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "due date"@en ;
    rdfs:comment "The date by which payment is contractually due. Used for aging analysis, dunning, and collections prioritization."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.dunningBlockIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dunning block indicator"@en ;
    rdfs:comment "Boolean flag indicating whether dunning is blocked for this receivable (true = blocked, false = eligible for dunning). Set when disputes are under review or payment arrangements are in place."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dunning_block_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dunning Block Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:FinanceReceivable.dunningLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dunning level"@en ;
    rdfs:comment "The current dunning level (0 = no dunning, 1 = first reminder, 2 = second reminder, 3+ = escalated collections). Increments with each dunning run for overdue items."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:int ;
    cmm:physicalColumn "dunning_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dunning Level" ;
    cmm:cimDatatype "Integer" .
cmm:FinanceReceivable.exchangeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exchange rate"@en ;
    rdfs:comment "The exchange rate used to convert document currency to local currency at posting time. Stored for audit and revaluation purposes."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "exchange_rate" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exchange Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:FinanceReceivable.fercJurisdictionalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc jurisdictional flag"@en ;
    rdfs:comment "Boolean flag indicating whether this receivable falls under FERC jurisdiction (true = FERC-jurisdictional wholesale transaction, false = non-jurisdictional or state-regulated). Determines regulatory reporting requirements."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_jurisdictional_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Jurisdictional Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FinanceReceivable.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "The ISO or RTO market code if this receivable originates from wholesale market settlements. CAISO = California ISO, ERCOT = Electric Reliability Council of Texas, ISONE = ISO New England, MISO = Midcontinent ISO, NYISO = New York ISO, PJM = PJM Interconnection, SPP = Southwest Power Pool. Reference-value candidates: CAISO|ERCOT|ISONE|MISO|NYISO|PJM|SPP."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Code" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.lastDunningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last dunning date"@en ;
    rdfs:comment "The date of the most recent dunning notice sent for this receivable. Used to schedule next dunning action."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_dunning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Dunning Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this receivable record was last updated. Tracks changes to clearing status, amounts, or other attributes."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FinanceReceivable.localCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "local currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the company code local currency. Typically USD for US-based utilities."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "local_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Local Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.outstandingAmountDocumentCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding amount document currency"@en ;
    rdfs:comment "The remaining unpaid balance in document currency after partial payments or credits. Equals amount_document_currency for open items, zero for fully cleared items."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_amount_document_currency" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outstanding Amount in Document Currency" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.outstandingAmountLocalCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding amount local currency"@en ;
    rdfs:comment "The remaining unpaid balance in local currency. Used for cash flow forecasting and working capital management."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_amount_local_currency" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outstanding Amount in Local Currency" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FinanceReceivable.paymentBlockCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment block code"@en ;
    rdfs:comment "SAP payment block code if payment processing is temporarily blocked (e.g., pending approval, dispute resolution, credit hold). Null if no block is active."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_block_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Block Code" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "The expected or actual payment method for this receivable. Wire transfer and ACH are common for wholesale energy settlements, check for smaller counterparties, offset for inter-affiliate netting."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:validValues "wire_transfer|ach|check|eft|credit_card|offset" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.paymentTermsCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment terms code"@en ;
    rdfs:comment "SAP payment terms code defining the due date calculation and discount terms (e.g., Z001 for Net 30, Z002 for 2/10 Net 30). Determines dunning and collections strategy."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_terms_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Terms Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date when the receivable was posted to the general ledger. Represents the accounting period assignment and is the principal business event timestamp for financial reporting."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.receivableCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "receivable category"@en ;
    rdfs:comment "Business classification of the receivable type. Wholesale_energy covers ISO/RTO energy market settlements, rec_sales covers renewable energy certificate transactions, transmission_access covers OATT charges, capacity_market covers capacity auction settlements, ancillary_services covers frequency regulation and reserves, intercompany covers inter-affiliate charges. Reference-value candidates: wholesale_energy|rec_sales|transmission_access|capacity_market|ancillary_services|intercompany|other."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "receivable_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Receivable Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpReceivable.kind .
cmm:FinanceReceivable.referenceDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference document number"@en ;
    rdfs:comment "External reference number from the source system (e.g., ISO/RTO settlement statement number, REC transaction ID, OATT invoice number, inter-affiliate billing reference). Enables traceability to originating transaction."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reference Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FinanceReceivable.settlementPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period end date"@en ;
    rdfs:comment "The end date of the settlement period for wholesale energy or capacity market receivables. Defines the revenue recognition period."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.settlementPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period start date"@en ;
    rdfs:comment "The start date of the settlement period for wholesale energy or capacity market receivables. Used for period-based revenue recognition and reconciliation."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.textDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "text description"@en ;
    rdfs:comment "Free-text description of the receivable item. May include details such as 'Wholesale energy sales - January 2024', 'REC sales - Q1 2024', 'Transmission access charges - OATT Schedule 1', or 'Inter-affiliate services - shared services allocation'."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:string ;
    cmm:physicalColumn "text_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Text Description" ;
    cmm:cimDatatype "String" .
cmm:FinanceReceivable.writeOffDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off date"@en ;
    rdfs:comment "The date when the receivable was written off. Null if not written off. Used for bad debt reporting and recovery tracking."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:date ;
    cmm:physicalColumn "write_off_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Date" ;
    cmm:cimDatatype "Date" .
cmm:FinanceReceivable.writeOffFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "write off flag"@en ;
    rdfs:comment "Boolean flag indicating whether this receivable has been written off as uncollectible bad debt (true = written off, false = active). Write-offs are posted to bad debt expense accounts."@en ;
    rdfs:domain cmm:FinanceReceivable ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "write_off_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Write-Off Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:FixedAsset a owl:Class ;
    rdfs:label "Fixed Asset"@en ;
    rdfs:comment "SAP S/4HANA FI-AA fixed asset master and depreciation record representing capitalized utility infrastructure and its periodic depreciation lifecycle. Asset master attributes: asset class, FERC plant account (e.g., Account 101-106), capitalization date, useful life, depreciation method, RAB inclusion flag, accumulated depreciation, net book value, and location/functional assignment. Depreciation attributes: depreciation run date, fiscal period, depreciation area (book, tax, regulatory), depreciation amount, accumulated depreciation balance, and remaining useful life. SSOT for CAPEX tracking, RAB valuation inputs, FERC depreciation studies, rate case filings, and regulatory plant account reporting submitted to PUCs and FERC."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:FinancialInfo ;
    cmm:cimCloseMatch cim:FinancialInfo ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.asset_accounting ;
    cmm:physicalTable "utility_cmm_silver.finance.fixed_asset" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "FERC USoA; SAP FI-AA; SAP FI-AA Asset Master (AS01) / FERC Plant Accounts 101-106" ;
    cmm:sourceObject "energy_utilities_ecm.finance.fixed_asset" ;
    owl:hasKey ( cmm:FixedAsset.fixedAssetId ) .

cmm:FixedAsset.fixedAssetId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset id"@en ;
    rdfs:comment "Unique identifier for the fixed asset record. Primary key for the fixed asset master data in SAP S/4HANA FI-AA. This is the system-generated asset number that uniquely identifies each capitalized utility infrastructure asset throughout its lifecycle from acquisition through retirement."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:long ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Fixed Asset ID" ;
    cmm:cimDatatype "Integer" .
cmm:FixedAsset.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Reference to the capital project (CAPEX project) under which this asset was acquired or constructed. Links the asset to project budgets, work breakdown structures, and capital expenditure tracking."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_capital_project_id" ;
    cmm:cimAssociation "FinancialInfo.Project" .
cmm:FixedAsset.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Foreign key linking to asset.asset_class. Business justification: Fixed assets require asset class reference for depreciation method, useful life parameters, FERC account alignment, and regulatory reporting consistency. New FK needed; removes denormalized asset_clas"@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_class_id" ;
    cmm:cimAssociation "FinancialInfo.AssetInfo" .
cmm:FixedAsset.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Fixed assets (transmission lines, substations, generation units) are physically located within control areas. Essential for asset register by jurisdiction, depreciation allocation, rate base calculati"@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_control_area_id" ;
    cmm:cimAssociation "FinancialInfo.ControlArea" .
cmm:FixedAsset.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Fixed assets are assigned to cost centers for depreciation expense allocation and cost tracking. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN to ret"@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_cost_center_id" ;
    cmm:cimAssociation "FinancialInfo.Organisation" .
cmm:FixedAsset.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "FK to finance.gl_account.gl_account_id — Fixed assets post to FERC plant accounts (GL accounts 101-106). This FK enables asset-to-GL reconciliation, RAB valuation, and FERC Form 1 plant schedule reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_gl_account_id" ;
    cmm:cimAssociation "FinancialInfo.ErpChartOfAccounts" .
cmm:FixedAsset.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level fixed assets (buildings, land, common equipment) are assigned to plants for asset registry reconciliation, insurance valuation, and FERC reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_power_plant_id" ;
    cmm:cimAssociation "FinancialInfo.Plant" .
cmm:FixedAsset.regulatoryAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset"@en ;
    rdfs:comment "FK to finance.regulatory_asset.regulatory_asset_id — Fixed assets with RAB inclusion flag contribute to the regulatory asset base. This FK enables RAB roll-forward calculations by linking individual assets to their RAB valuation treatment."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range cmm:RegulatoryAsset ;
    cmm:physicalColumn "regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_fixed_asset_regulatory_asset_id" ;
    cmm:cimAssociation "FinancialInfo.Document" .
cmm:FixedAsset.accumulatedDepreciation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated depreciation"@en ;
    rdfs:comment "Total depreciation expense recognized to date since the asset was placed in service. Represents the cumulative reduction in asset value due to wear, obsolescence, and passage of time. Used to calculate net book value."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accumulated_depreciation" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Depreciation" ;
    cmm:cimDatatype "Decimal" .
cmm:FixedAsset.acquisitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition date"@en ;
    rdfs:comment "Date the asset was acquired or purchased by the utility. May differ from capitalization date for assets that require installation or commissioning before being placed in service."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "acquisition_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Acquisition Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.purchaseDate .
cmm:FixedAsset.acquisitionValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition value"@en ;
    rdfs:comment "Original acquisition cost or capitalized value of the asset including purchase price, installation costs, freight, and other costs necessary to bring the asset to its intended use. This is the gross book value before accumulated depreciation."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acquisition Value" ;
    cmm:cimDatatype "Decimal" .
cmm:FixedAsset.annualDepreciationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual depreciation amount"@en ;
    rdfs:comment "Calculated annual depreciation expense for the current fiscal year. For straight-line depreciation, this is acquisition value divided by useful life. Posted monthly or quarterly to the general ledger as depreciation expense."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_depreciation_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Depreciation Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FixedAsset.assetConditionRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset condition rating"@en ;
    rdfs:comment "Current physical condition assessment of the asset based on inspections, maintenance history, and performance monitoring. Used for asset health indexing, replacement prioritization, and risk assessment."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_condition_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Rating" ;
    cmm:validValues "excellent|good|fair|poor|critical" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.assetDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset description"@en ;
    rdfs:comment "Detailed textual description of the fixed asset including make, model, specifications, capacity, and distinguishing characteristics. Used for asset identification, inventory management, and regulatory documentation."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Asset Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:FixedAsset.assetLocationLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset location latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the asset location in decimal degrees. Used for GIS mapping, spatial analysis, outage correlation, and field service routing. Integrates with Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_location_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Asset Location Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:FixedAsset.assetLocationLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset location longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the asset location in decimal degrees. Used for GIS mapping, spatial analysis, outage correlation, and field service routing. Integrates with Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_location_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Asset Location Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:FixedAsset.assetNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset number"@en ;
    rdfs:comment "Business-facing asset number or tag used for external identification and physical labeling. This is the human-readable identifier displayed on asset tags, used in field operations, and referenced in maintenance work orders and regulatory filings."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FixedAsset.assetStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset status"@en ;
    rdfs:comment "Current lifecycle status of the fixed asset. In-service assets are operational and depreciating; under-construction assets are CWIP (Construction Work in Progress) not yet placed in service; retired assets are no longer operational; disposed assets have been sold or scrapped; transferred assets have moved between cost centers or legal entities."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Status" ;
    cmm:validValues "in_service|under_construction|retired|disposed|transferred|held_for_sale" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FinancialInfo.status .
cmm:FixedAsset.capacityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity rating"@en ;
    rdfs:comment "Nameplate capacity or rated output of the asset in appropriate units (MW for generation, MVA for transformers, kV for transmission lines, etc.). Used for load planning, capacity analysis, and regulatory reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_rating" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Rating" ;
    cmm:cimDatatype "Decimal" .
cmm:FixedAsset.capacityUnitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity unit of measure"@en ;
    rdfs:comment "Unit of measure for the capacity rating field. Common units include MW (megawatts) for generation, MVA (megavolt-amperes) for transformers, kV (kilovolts) for voltage, and circuit miles for transmission lines. Reference-value candidates: MW|MVA|kV|kVA|MWh|GWh|miles|circuit_miles|units."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "capacity_unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Capacity Unit of Measure" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:FixedAsset.capitalizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization date"@en ;
    rdfs:comment "Date the asset was placed in service and capitalized on the balance sheet. This is the date depreciation begins and marks the transition from CWIP to depreciable plant. Critical for depreciation calculations, RAB valuations, and regulatory reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "capitalization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Date" ;
    cmm:cimDatatype "Date" .
cmm:FixedAsset.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time this asset master record was first created in the system. Used for audit trails and data lineage tracking."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FinancialInfo.createdDateTime .
cmm:FixedAsset.criticalityClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality classification"@en ;
    rdfs:comment "Business criticality rating indicating the impact of asset failure on operations, customer service, safety, and regulatory compliance. Used for maintenance prioritization and risk-based asset management."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Classification" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.depreciationArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation area"@en ;
    rdfs:comment "Valuation perspective for depreciation calculation. Book depreciation for financial statements, tax depreciation for IRS filings, regulatory depreciation for rate case and PUC reporting. SAP supports parallel depreciation areas for the same asset."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Area" ;
    cmm:validValues "book|tax|regulatory|ifrs|gaap" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Depreciation calculation method applied to the asset. Straight-line is most common for utility plant. Regulatory method follows PUC-approved depreciation rates. Method determines how acquisition value is allocated over useful life."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|sum_of_years_digits|units_of_production|regulatory" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.disposalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disposal date"@en ;
    rdfs:comment "Date the asset was physically disposed of through sale, scrap, or transfer. May occur after retirement date. Used for gain/loss on disposal calculations and regulatory reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "disposal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disposal Date" ;
    cmm:cimDatatype "Date" .
cmm:FixedAsset.disposalProceeds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disposal proceeds"@en ;
    rdfs:comment "Cash or fair market value received from disposal of the asset through sale or salvage. Used to calculate gain or loss on disposal (proceeds minus net book value at disposal)."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disposal_proceeds" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disposal Proceeds" ;
    cmm:cimDatatype "Decimal" .
cmm:FixedAsset.environmentalComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental compliance flag"@en ;
    rdfs:comment "Indicates whether the asset is subject to environmental regulations such as EPA emissions standards, hazardous materials handling, or environmental permitting. Used for compliance tracking and environmental reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "environmental_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FixedAsset.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts plant account code (e.g., 101-399 for electric plant accounts). Critical for regulatory reporting, rate case filings, and depreciation studies. Examples: Account 310 (Transmission Plant), Account 360 (Distribution Plant), Account 340 (Generation Plant)."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.functionalLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional location"@en ;
    rdfs:comment "SAP Plant Maintenance (PM) functional location representing the physical or logical location of the asset within the utility infrastructure hierarchy. Used for maintenance planning, work order assignment, and asset tracking."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Location" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.geographicLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic location"@en ;
    rdfs:comment "Physical location or address of the asset including site name, substation, service territory, or facility. Used for GIS integration, outage management, field service dispatch, and regulatory reporting by jurisdiction."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Location" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date the asset was physically installed or constructed at its current location. May differ from capitalization date if commissioning or testing was required before the asset was placed in service."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:FixedAsset.lastDepreciationRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last depreciation run date"@en ;
    rdfs:comment "Date of the most recent depreciation calculation and posting run. Depreciation is typically calculated monthly or quarterly. This date tracks when accumulated depreciation was last updated."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_depreciation_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Depreciation Run Date" ;
    cmm:cimDatatype "Date" .
cmm:FixedAsset.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "User ID of the person who last modified this asset master record. Used for audit trails, change management, and SOX compliance documentation."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time this asset master record was last updated. Used for change tracking, audit trails, and data quality monitoring."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FixedAsset.manufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer"@en ;
    rdfs:comment "Name of the equipment manufacturer or vendor. Used for warranty tracking, spare parts sourcing, maintenance planning, and vendor performance analysis."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Manufacturer" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Manufacturer.name .
cmm:FixedAsset.modelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model number"@en ;
    rdfs:comment "Manufacturer model or part number for the asset. Used for technical specifications lookup, spare parts identification, and standardization analysis."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Model Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FixedAsset.nercCipClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip classification"@en ;
    rdfs:comment "NERC CIP cyber security classification level for assets that are part of the Bulk Electric System. High and medium impact assets require enhanced physical and cyber security controls per NERC CIP standards."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_cip_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Critical Infrastructure Protection (CIP) Classification" ;
    cmm:validValues "high|medium|low|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:FixedAsset.netBookValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net book value"@en ;
    rdfs:comment "Current carrying value of the asset calculated as acquisition value minus accumulated depreciation. Represents the remaining capitalized value on the balance sheet. Critical for RAB calculations and financial reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_book_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Book Value" ;
    cmm:cimDatatype "Decimal" .
cmm:FixedAsset.rabInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion flag"@en ;
    rdfs:comment "Indicates whether this asset is included in the Regulatory Asset Base for rate-making purposes. RAB assets are used to calculate allowed return on equity (ROE) and revenue requirements in rate cases filed with PUCs."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FixedAsset.remainingUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remaining useful life years"@en ;
    rdfs:comment "Remaining depreciable life of the asset in years calculated as useful life minus elapsed time since capitalization. Used for depreciation forecasting, asset replacement planning, and rate case projections."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "remaining_useful_life_years" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remaining Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:FixedAsset.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "Date the asset was retired from service and removed from the active plant inventory. Depreciation ceases on this date. Used for asset lifecycle analysis and regulatory plant retirement reporting."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:FixedAsset.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by the manufacturer. Used for warranty claims, recall tracking, and individual asset identification in the field."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:FixedAsset.soxMaterialFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox material flag"@en ;
    rdfs:comment "Indicates whether the asset value is material for SOX financial reporting and internal controls testing. Material assets require enhanced documentation, approval workflows, and audit trails."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_material_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Material Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FixedAsset.usefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "useful life years"@en ;
    rdfs:comment "Expected useful life of the asset in years as determined by depreciation studies and regulatory guidance. Used to calculate annual depreciation expense. Varies by asset class (e.g., 30-50 years for transmission lines, 10-15 years for vehicles)."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:int ;
    cmm:physicalColumn "useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:FixedAsset.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date the manufacturer warranty expires. Used for maintenance planning decisions (repair vs. replace) and warranty claim tracking."@en ;
    rdfs:domain cmm:FixedAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:AssetDepreciation a owl:Class ;
    rdfs:label "Asset Depreciation"@en ;
    rdfs:comment "Periodic depreciation posting records for fixed assets in SAP FI-AA. Captures depreciation run date, fiscal period, depreciation area (book, tax, regulatory), depreciation amount, accumulated depreciation balance, and remaining useful life. Supports FERC depreciation studies, rate case filings, and RAB calculations submitted to PUCs."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:FinancialInfo ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.asset_accounting ;
    cmm:physicalTable "utility_cmm_silver.finance.asset_depreciation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC USoA; SAP FI-AA Depreciation Run (AFAB)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.asset_depreciation" ;
    owl:hasKey ( cmm:AssetDepreciation.assetDepreciationId ) .

cmm:AssetDepreciation.assetDepreciationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset depreciation id"@en ;
    rdfs:comment "Unique identifier for the asset depreciation posting record. Primary key for the asset_depreciation product."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:long ;
    cmm:physicalColumn "asset_depreciation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Depreciation ID" ;
    cmm:cimDatatype "Integer" .
cmm:AssetDepreciation.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Foreign key linking to asset.asset_class. Business justification: Depreciation runs require asset class for rate tables, useful life parameters, depreciation method selection, and FERC regulatory reporting. New FK needed; removes denormalized asset_class_code."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_class_id" ;
    cmm:cimAssociation "FinancialInfo.AssetInfo" .
cmm:AssetDepreciation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Depreciation postings are assigned to cost centers for expense allocation. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN to retrieve cost center mast"@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_cost_center_id" ;
    cmm:cimAssociation "FinancialInfo.Organisation" .
cmm:AssetDepreciation.depreciationExpenseGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation expense gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Depreciation postings hit GL accounts for depreciation expense. The gl_account_depreciation_expense (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve account d"@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "depreciation_expense_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Depreciation Expense Gl Account Id (Foreign Key)" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_depreciation_expense_gl_account_id" ;
    cmm:cimAssociation "FinancialInfo.ErpChartOfAccounts" .
cmm:AssetDepreciation.depreciationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation run"@en ;
    rdfs:comment "Identifier for the batch depreciation calculation run that generated this posting. Used to group all depreciation postings from a single execution."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:DepreciationRun ;
    cmm:physicalColumn "depreciation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Depreciation Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_depreciation_run_id" ;
    cmm:cimAssociation "FinancialInfo.ActivityRecord" .
cmm:AssetDepreciation.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "FK to finance.fixed_asset.fixed_asset_id — Every depreciation posting must reference the fixed asset being depreciated. Without this FK, depreciation records are meaningless and RAB calculations cannot be performed."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_fixed_asset_id" ;
    cmm:cimAssociation "FinancialInfo.FinancialInfo" .
cmm:AssetDepreciation.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Foreign key linking to generation.generating_unit. Business justification: Depreciation expense is tracked at the unit level for rate base calculations, FERC depreciation studies, and rate case testimony. Critical for regulatory accounting."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_generating_unit_id" ;
    cmm:cimAssociation "FinancialInfo.GeneratingUnit" .
cmm:AssetDepreciation.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "Reference to the original asset_depreciation_id that this record reverses, if this is a reversal posting. Null for original postings."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Posting ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_journal_entry_id" ;
    cmm:cimAssociation "FinancialInfo.ErpJournal" .
cmm:AssetDepreciation.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level depreciation for aggregated asset classes. Required for monthly depreciation runs, RAB valuation, and regulatory reporting."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_power_plant_id" ;
    cmm:cimAssociation "FinancialInfo.Plant" .
cmm:AssetDepreciation.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Depreciation postings are assigned to profit centers for internal management reporting and segment analysis. The profit_center (STRING) should be replaced with FK to profit_center.profit_center_id, en"@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_profit_center_id" ;
    cmm:cimAssociation "FinancialInfo.Organisation" .
cmm:AssetDepreciation.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the fixed asset for which depreciation is being posted. Links to the asset registry master data."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_asset_depreciation_registry_id" ;
    cmm:cimAssociation "FinancialInfo.Asset" .
cmm:AssetDepreciation.accumulatedDepreciation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated depreciation"@en ;
    rdfs:comment "The cumulative total depreciation posted for this asset from acquisition date through the current period. Represents the total reduction in asset value to date."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accumulated_depreciation" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Depreciation" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetDepreciation.acquisitionValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition value"@en ;
    rdfs:comment "The original acquisition or capitalized cost of the asset. Used as the basis for depreciation calculations and remains constant unless revaluation occurs."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acquisition Value" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetDepreciation.assetLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset location"@en ;
    rdfs:comment "The physical location or plant where the asset is installed. Used for geographic cost allocation and service territory reporting to state PUCs."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Location" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.businessArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area"@en ;
    rdfs:comment "The business area or segment (e.g., generation, transmission, distribution, retail) to which this depreciation expense is assigned. Used for segment reporting and regulatory cost allocation."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "The legal entity or company code for which this depreciation posting is recorded. Supports multi-entity consolidation and separate regulatory reporting by operating company."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "The user ID or system account that created this depreciation posting record. Used for audit trail and SOX compliance."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this depreciation posting record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FinancialInfo.createdDateTime .
cmm:AssetDepreciation.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code for all monetary amounts in this record. Typically USD for US utilities."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:AssetDepreciation.depreciationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation amount"@en ;
    rdfs:comment "The periodic depreciation expense amount posted for this asset in this period. Represents the reduction in asset value for the reporting period."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciation_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AssetDepreciation.depreciationArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation area"@en ;
    rdfs:comment "The depreciation area or valuation view for which this posting applies. Supports parallel depreciation calculations for book accounting, tax reporting, regulatory filings (FERC), and international standards (IFRS/GAAP)."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Area" ;
    cmm:validValues "book|tax|regulatory|ifrs|gaap|ferc" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.depreciationKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation key"@en ;
    rdfs:comment "The depreciation method key that defines the calculation rules applied (e.g., straight-line, declining balance, units of production). Controls how depreciation is computed for this asset."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_key" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Key" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "The depreciation calculation method applied for this posting. Straight-line is most common for utility assets; composite and group methods are used for transmission and distribution assets per FERC guidelines."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|sum_of_years_digits|units_of_production|composite|group" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.depreciationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation rate percent"@en ;
    rdfs:comment "The annual depreciation rate applied as a percentage of acquisition value. For straight-line depreciation, calculated as 100 divided by useful life years."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(7,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Rate (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:AssetDepreciation.depreciationRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation run date"@en ;
    rdfs:comment "The date on which the depreciation calculation batch was executed. Represents the business event timestamp for this depreciation posting."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:date ;
    cmm:physicalColumn "depreciation_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Run Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetDepreciation.documentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document number"@en ;
    rdfs:comment "The financial document number assigned to this depreciation posting in the general ledger. Used for audit trail and reconciliation with FI-GL."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AssetDepreciation.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "The FERC Uniform System of Accounts code for this asset. Required for regulatory reporting to FERC and state Public Utility Commissions (PUCs). Examples: 311 (Structures), 353 (Station Equipment), 364 (Poles and Fixtures)."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal period (month) within the fiscal year for which this depreciation posting applies. Typically 1-12 for monthly periods."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:cimDatatype "Integer" .
cmm:AssetDepreciation.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year for which this depreciation posting applies. Used for financial period reporting and regulatory filings."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:AssetDepreciation.glAccountAccumulatedDepreciation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account accumulated depreciation"@en ;
    rdfs:comment "The general ledger account number to which accumulated depreciation is posted as a contra-asset. Typically maps to FERC Account 108 (Accumulated Depreciation) for utility assets."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_accumulated_depreciation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account - Accumulated Depreciation" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "The user ID or system account that last modified this depreciation posting record. Used for audit trail and SOX compliance."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "The timestamp when this depreciation posting record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AssetDepreciation.netBookValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net book value"@en ;
    rdfs:comment "The net book value of the asset after this depreciation posting, calculated as acquisition value minus accumulated depreciation. Represents the current carrying value of the asset."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_book_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Book Value (NBV)" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetDepreciation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments related to this depreciation posting. Used to document adjustments, corrections, or special circumstances."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AssetDepreciation.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which the depreciation transaction was posted to the general ledger. May differ from the depreciation run date due to period-end processing."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetDepreciation.postingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting status"@en ;
    rdfs:comment "The current status of this depreciation posting. Indicates whether the posting has been successfully recorded to the general ledger, reversed due to error, or is pending approval."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "posting_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Status" ;
    cmm:validValues "posted|reversed|cancelled|pending" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether this asset is eligible for inclusion in the Regulatory Asset Base (RAB) for rate-making purposes. True if the asset is used and useful in providing regulated utility service."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetDepreciation.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "The regulatory jurisdiction (state PUC or FERC) under which this asset and its depreciation are reported. Critical for rate case filings and cost recovery."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:AssetDepreciation.remainingUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remaining useful life years"@en ;
    rdfs:comment "The remaining useful life of the asset in years after this depreciation posting. Calculated as original useful life minus elapsed life. Critical for rate case filings and asset replacement planning."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "remaining_useful_life_years" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remaining Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:AssetDepreciation.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "The date on which the asset was retired or disposed of, if applicable. Null for active assets. Used to stop depreciation calculations and trigger retirement accounting."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:AssetDepreciation.reversalIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reversal indicator"@en ;
    rdfs:comment "Indicates whether this depreciation posting is a reversal of a previous posting. True if this record reverses a prior depreciation entry due to correction or adjustment."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reversal_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reversal Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetDepreciation.salvageValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "salvage value"@en ;
    rdfs:comment "The estimated residual value of the asset at the end of its useful life. Used in depreciation calculations and retirement accounting. May be negative for assets with removal costs."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "salvage_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Salvage Value" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetDepreciation.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this depreciation posting is subject to SOX financial controls and audit requirements. True for publicly traded utilities with material asset values."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetDepreciation.usefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "useful life years"@en ;
    rdfs:comment "The total estimated useful life of the asset in years as defined at acquisition. Used to calculate straight-line depreciation rates and supports FERC depreciation study requirements."@en ;
    rdfs:domain cmm:AssetDepreciation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "useful_life_years" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .

cmm:CapexProject a owl:Class ;
    rdfs:label "Capex Project"@en ;
    rdfs:comment "Capital expenditure project master and expenditure detail in SAP S/4HANA PS/IM covering the full CAPEX lifecycle from approval through capitalization. Project master attributes: WBS structure, approved CAPEX budget, actual spend to date, forecast at completion, project phase (planning, execution, in-service), responsible business unit, IRP alignment, CPCN reference, and capitalization status. Expenditure detail attributes: purchase order reference, goods receipt date, invoice amount, asset under construction (AuC) account, settlement rule, capitalization event, and FERC account code. Supports capital budget governance, project cost tracking by WBS element, rate case CAPEX justification, and regulatory reporting of capital additions to the rate base."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Project ;
    cmm:cimCloseMatch cim:Project ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.asset_accounting ;
    cmm:physicalTable "utility_cmm_silver.finance.capex_project" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-6; SAP PS WBS Element / SAP IM Investment Program" ;
    cmm:sourceObject "energy_utilities_ecm.finance.capex_project" ;
    owl:hasKey ( cmm:CapexProject.capexProjectId ) .

cmm:CapexProject.capexProjectId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex project id"@en ;
    rdfs:comment "Unique identifier for the capital expenditure project. Primary key."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:long ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Project ID" ;
    cmm:cimDatatype "Integer" .
cmm:CapexProject.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Capital projects are planned and executed within specific control areas for asset location tracking, regulatory jurisdiction assignment, and rate base allocation by service territory. Essential for ge"@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_project_control_area_id" ;
    cmm:cimAssociation "Project.ControlArea" .
cmm:CapexProject.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "FK to finance.profit_center.profit_center_id — CAPEX projects are assigned to organizational units (business units) for budget governance and segment reporting. Critical for CAPEX variance analysis by business segment."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_project_profit_center_id" ;
    cmm:cimAssociation "Project.Organisation" .
cmm:CapexProject.actualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion date"@en ;
    rdfs:comment "Actual date when the project was completed and the asset placed in service. Null if project is still in progress."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.actualSpendAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual spend amount"@en ;
    rdfs:comment "Cumulative actual expenditure to date for this project, in USD. Sum of all posted costs including purchase orders, goods receipts, invoices, and internal labor."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_spend_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Spend Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexProject.actualStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start date"@en ;
    rdfs:comment "Actual date when project work commenced. May differ from planned start date due to delays or early starts."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.approvedBudgetAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved budget amount"@en ;
    rdfs:comment "Total capital budget approved by the board or executive management for this project, in USD. Represents the authorized spending limit."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_budget_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Budget Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexProject.aucAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auc account code"@en ;
    rdfs:comment "General ledger account code used to accumulate project costs before capitalization. Typically a balance sheet account in the 100-series per FERC Uniform System of Accounts."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "auc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Under Construction (AuC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.capitalizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization date"@en ;
    rdfs:comment "Date when the asset under construction (AuC) was settled to the fixed asset register and depreciation commenced. Marks the transition from CAPEX project to operational asset."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "capitalization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.capitalizationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization status"@en ;
    rdfs:comment "Indicates whether the project costs have been transferred from asset under construction (AuC) to the fixed asset register: not capitalized (still in AuC), partially capitalized (some WBS elements settled), or fully capitalized (all costs settled and project closed)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "capitalization_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Status" ;
    cmm:validValues "not_capitalized|partially_capitalized|fully_capitalized" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.committedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "committed amount"@en ;
    rdfs:comment "Total committed funds for this project, in USD. Includes purchase orders issued but not yet invoiced. Used for budget availability checks."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "committed_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Committed Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexProject.cpcnApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn approval date"@en ;
    rdfs:comment "Date when the Public Utility Commission (PUC) granted the CPCN for this project. Null if CPCN is not required or not yet approved."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "cpcn_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Certificate of Public Convenience and Necessity (CPCN) Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.cpcnReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn reference number"@en ;
    rdfs:comment "Regulatory approval reference number for the Certificate of Public Convenience and Necessity (CPCN) issued by the Public Utility Commission (PUC) authorizing this capital project. Required for major transmission and generation projects."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "cpcn_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certificate of Public Convenience and Necessity (CPCN) Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexProject.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this capital project record was first created in the system."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Project.createdDateTime .
cmm:CapexProject.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for all monetary amounts in this project (e.g., USD, CAD, EUR)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CapexProject.environmentalPermitNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit number"@en ;
    rdfs:comment "Reference number for environmental permits required for this project (e.g., EPA air quality permit, wetlands permit, NEPA clearance). Multiple permits may be concatenated or stored in related tables."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "environmental_permit_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Environmental Permit Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexProject.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code to which the capitalized asset will be assigned (e.g., 350 for transmission lines, 360 for distribution lines, 310 for generation plant). Used for regulatory rate base reporting."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.forecastAtCompletionAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast at completion amount"@en ;
    rdfs:comment "Projected total cost at project completion, in USD. Updated periodically by project managers based on actual spend, commitments, and remaining work estimates."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecast_at_completion_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast at Completion (FAC) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexProject.irpAlignmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "irp alignment flag"@en ;
    rdfs:comment "Indicates whether this capital project is included in the utility's approved Integrated Resource Plan (IRP) filed with the Public Utility Commission (PUC). True if aligned; false otherwise."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "irp_alignment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) Alignment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexProject.irpReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "irp reference number"@en ;
    rdfs:comment "Reference identifier linking this project to the specific IRP filing or docket number with the Public Utility Commission (PUC)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "irp_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexProject.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or name of the person who last modified this capital project record."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this capital project record was last updated in the system."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CapexProject.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Indicates whether this project involves assets subject to NERC Critical Infrastructure Protection (CIP) standards or other NERC reliability requirements. True if subject to NERC compliance; false otherwise."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexProject.plannedCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned completion date"@en ;
    rdfs:comment "Scheduled date for project completion and asset in-service, as defined in the project plan."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.plannedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned start date"@en ;
    rdfs:comment "Scheduled date for project initiation and commencement of work, as defined in the project plan."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.priorityRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority rank"@en ;
    rdfs:comment "Relative priority ranking of this project within the capital portfolio, used for resource allocation and budget decisions. Lower numbers indicate higher priority."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_rank" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Priority Rank" ;
    cmm:cimDatatype "Integer" .
cmm:CapexProject.projectCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project category"@en ;
    rdfs:comment "Nature of the capital investment: new construction (greenfield), replacement (asset retirement and new installation), expansion (capacity increase), upgrade (technology improvement), maintenance (major overhaul capitalized per FERC), compliance (mandated by regulation), or other. Reference-value candidates: new_construction|replacement|expansion|upgrade|maintenance|compliance|other."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.kind .
cmm:CapexProject.projectDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project description"@en ;
    rdfs:comment "Detailed business justification and scope description of the capital project, including technical specifications and strategic rationale."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Project Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CapexProject.projectManagerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project manager name"@en ;
    rdfs:comment "Full name of the individual assigned as project manager, accountable for delivery, budget, and schedule."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_manager_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Manager Name" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.projectName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project name"@en ;
    rdfs:comment "Descriptive name of the capital project (e.g., 'Substation XYZ Transformer Replacement', 'Solar Farm Phase 2 Expansion')."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Project Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CapexProject.projectNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project number"@en ;
    rdfs:comment "Business-facing unique project identifier used in SAP S/4HANA PS and external communications. Corresponds to SAP Project Definition number."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexProject.projectPhase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project phase"@en ;
    rdfs:comment "Current lifecycle phase of the capital project: planning (feasibility and design), engineering (detailed design and permitting), procurement (vendor selection and contracting), construction (physical build), commissioning (testing and startup), in-service (asset capitalized and operational), or closed (project administratively complete). Reference-value candidates: planning|engineering|procurement|construction|commissioning|in_service|closed."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_phase" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Phase" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Terminal.phases .
cmm:CapexProject.projectSponsorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project sponsor name"@en ;
    rdfs:comment "Full name of the executive sponsor who approved the project and provides strategic oversight."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_sponsor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Sponsor Name" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.projectStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project status"@en ;
    rdfs:comment "Administrative status of the project: approved (budget authorized), active (work in progress), on hold (temporarily suspended), cancelled (terminated before completion), or completed (all work finished and capitalized)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Status" ;
    cmm:validValues "approved|active|on_hold|cancelled|completed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.status .
cmm:CapexProject.projectType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project type"@en ;
    rdfs:comment "Classification of the capital project by asset category: generation (power plant construction/upgrade), transmission (high-voltage lines and towers), distribution (local grid infrastructure), substation (transformer and switching equipment), renewable integration (solar/wind/storage), grid modernization (AMI, ADMS, smart grid), customer systems (CIS, billing, MDM), regulatory compliance (environmental, safety, NERC CIP), or other. Reference-value candidates: generation|transmission|distribution|substation|renewable_integration|grid_modernization|customer_systems|regulatory_compliance|other."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.type .
cmm:CapexProject.rabInclusionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion date"@en ;
    rdfs:comment "Date when the capitalized asset was added to the Regulatory Asset Base (RAB) for rate-making purposes, allowing cost recovery through customer rates."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "rab_inclusion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexProject.rateCaseDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate case docket number"@en ;
    rdfs:comment "Public Utility Commission (PUC) docket number for the rate case in which this capital project was included for cost recovery."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_case_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rate Case Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexProject.rateCaseInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate case inclusion flag"@en ;
    rdfs:comment "Indicates whether this capital project has been included in a rate case filing for cost recovery through the Regulatory Asset Base (RAB). True if included; false otherwise."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rate_case_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Case Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexProject.responsibleBusinessUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible business unit"@en ;
    rdfs:comment "Name or code of the business unit or division responsible for executing this capital project (e.g., Transmission Operations, Distribution Engineering, Generation Services)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_business_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Business Unit" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.riskRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk rating"@en ;
    rdfs:comment "Overall risk assessment for the capital project based on technical complexity, regulatory uncertainty, budget size, and schedule constraints: low (routine project), medium (moderate complexity), high (significant challenges), or critical (major strategic initiative with high uncertainty)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "risk_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Risk Rating" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Indicates whether this capital project is subject to SOX internal controls for financial reporting due to materiality thresholds. True if SOX controls apply; false otherwise."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapexProject.strategicInitiativeAlignment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "strategic initiative alignment"@en ;
    rdfs:comment "Name or code of the corporate strategic initiative or program to which this project is aligned (e.g., Grid Modernization 2025, Renewable Integration Program, Customer Experience Transformation)."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "strategic_initiative_alignment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Strategic Initiative Alignment" ;
    cmm:cimDatatype "String" .
cmm:CapexProject.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "Difference between approved budget and forecast at completion, in USD. Positive indicates under budget; negative indicates over budget."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CapexProject.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "Top-level WBS element code representing the project hierarchy in SAP PS. Used for cost collection and budget control."@en ;
    rdfs:domain cmm:CapexProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .

cmm:CapexExpenditure a owl:Class ;
    rdfs:label "Capex Expenditure"@en ;
    rdfs:comment "Individual capital expenditure transaction posted against a CAPEX project WBS element. Records purchase order reference, goods receipt date, invoice amount, asset under construction (AuC) account, settlement rule, and capitalization event. Enables granular CAPEX tracking by project, asset class, and FERC account for regulatory reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:WorkCostDetail ;
    cmm:cimCloseMatch cim:WorkCostDetail ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.capex_expenditure" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-6; SAP PS Actual Cost / AuC Settlement (AIAB)" ;
    cmm:sourceObject "energy_utilities_ecm.finance.capex_expenditure" ;
    owl:hasKey ( cmm:CapexExpenditure.capexExpenditureId ) .

cmm:CapexExpenditure.capexExpenditureId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex expenditure id"@en ;
    rdfs:comment "Unique identifier for the capital expenditure transaction record. Primary key for the CAPEX expenditure entity."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:long ;
    cmm:physicalColumn "capex_expenditure_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Expenditure ID" ;
    cmm:cimDatatype "Integer" .
cmm:CapexExpenditure.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Reference to the capital project under which this expenditure is incurred. Links to the capital project master record."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_capital_project_id" ;
    cmm:cimAssociation "WorkCostDetail.Project" .
cmm:CapexExpenditure.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Individual capital expenditures must be assigned to control areas for geographic cost tracking, regulatory reporting by jurisdiction, and rate case support documentation. Enables rate base calculation"@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_control_area_id" ;
    cmm:cimAssociation "WorkCostDetail.ControlArea" .
cmm:CapexExpenditure.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: CAPEX expenditures are assigned to cost centers for tracking capital spending by organizational unit. The cost_center (STRING) should be replaced with FK to cost_center.cost_center_id, enabling JOIN t"@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_cost_center_id" ;
    cmm:cimAssociation "WorkCostDetail.Organisation" .
cmm:CapexExpenditure.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the employee or manager who approved this capital expenditure. Links to the workforce or employee master record for audit trail."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_employee_id" ;
    cmm:cimAssociation "WorkCostDetail.ErpPersonnel" .
cmm:CapexExpenditure.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Foreign key linking to generation.generating_unit. Business justification: Capex expenditures capitalize to specific generating units (new equipment, upgrades). Essential for asset capitalization, depreciation start, and unit-level rate base tracking."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_generating_unit_id" ;
    cmm:cimAssociation "WorkCostDetail.GeneratingUnit" .
cmm:CapexExpenditure.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Capital expenditures must be tracked against approved IRP scenario forecasts for variance analysis and regulatory compliance. Utilities demonstrate actual spending aligns with IRP plans during prudenc"@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_irp_scenario_id" ;
    cmm:cimAssociation "WorkCostDetail.Document" .
cmm:CapexExpenditure.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Plant-level capex (substation upgrades, common facilities) capitalizes to the plant. Required for FERC plant-in-service accounting and rate base calculations."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_power_plant_id" ;
    cmm:cimAssociation "WorkCostDetail.Plant" .
cmm:CapexExpenditure.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Reference to the vendor or supplier from whom goods or services were procured for this capital expenditure. Links to the vendor master record."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_capex_expenditure_vendor_id" ;
    cmm:cimAssociation "WorkCostDetail.Organisation" .
cmm:CapexExpenditure.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which this capital expenditure was approved by the authorized approver. Required for SOX compliance and audit trail."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "The approval workflow status of this capital expenditure transaction. Indicates whether the expenditure has been authorized per internal controls and SOX compliance."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "pending|approved|rejected|cancelled" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.assetClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "The classification of the asset being constructed or acquired (e.g., Generation Equipment, Transmission Lines, Distribution Infrastructure, IT Systems). Used for depreciation and asset management."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.assetNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset number"@en ;
    rdfs:comment "The fixed asset number to which this expenditure was settled upon capitalization. Links the expenditure to the final asset record in the asset register."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapexExpenditure.aucAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auc account code"@en ;
    rdfs:comment "The general ledger account code for the Asset Under Construction (AuC) to which this expenditure is posted. Represents the interim capitalization account before final asset settlement."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "auc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Under Construction (AuC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.budgetLineItem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget line item"@en ;
    rdfs:comment "The budget line item or budget category against which this capital expenditure is tracked. Used for budget vs. actual variance reporting."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_line_item" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Line Item" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.capexExpenditureDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex expenditure description"@en ;
    rdfs:comment "A detailed textual description of the capital expenditure transaction, including the nature of goods or services procured and any relevant context."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_expenditure_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Expenditure Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CapexExpenditure.capitalizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization date"@en ;
    rdfs:comment "The date on which this expenditure was capitalized and transferred from the AuC account to a fixed asset. Marks the start of depreciation."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "capitalization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Date" ;
    cmm:cimDatatype "Date" .
cmm:CapexExpenditure.capitalizationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capitalization status"@en ;
    rdfs:comment "The current capitalization lifecycle status of this expenditure. Indicates whether the expenditure has been capitalized to an asset or is still in the AuC account."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "capitalization_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalization Status" ;
    cmm:validValues "pending|capitalized|settled|reversed" ;
    cmm:cimDatatype "String" .
cmm:CapexExpenditure.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this capital expenditure record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:WorkCostDetail.createdDateTime .
cmm:CapexExpenditure.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code in which this expenditure was transacted (e.g., USD, EUR, GBP)."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CapexExpenditure.depreciationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation start date"@en ;
    rdfs:comment "The date on which depreciation begins for the asset created from this capital expenditure. Typically aligns with the capitalization date or asset in-service date."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "depreciation_start_date" ;
