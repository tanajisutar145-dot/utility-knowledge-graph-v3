    cmm:businessTerm "OSIsoft PI Historian Tag Prefix" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.regulationReserveMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation reserve mw"@en ;
    rdfs:comment "Amount of regulation reserve in megawatts maintained for automatic generation control and frequency regulation."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulation_reserve_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
