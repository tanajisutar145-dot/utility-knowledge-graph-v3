cmm:Crew.nercCipCleared a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip cleared"@en ;
    rdfs:comment "Indicates whether all crew members have completed NERC CIP personnel risk assessments and are authorized for work on critical cyber assets or bulk electric system facilities."@en ;
