    rdfs:comment "Indicates whether real-time telemetry data from aggregated customer sites is required for dispatch and settlement purposes."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "telemetry_required_flag" ;
