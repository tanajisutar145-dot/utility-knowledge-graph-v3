    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_until" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:MessageTemplate.isActive a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is active"@en ;
    rdfs:comment "Indicates whether the template is currently usable in production."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_active" ;
