    cmm:cimDatatype "String" .
cmm:RegulatoryCorrespondence.agencyContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agency contact phone"@en ;
    rdfs:comment "Phone number of the regulatory agency contact person."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
