cmm:ServicePoint.serviceEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service end date"@en ;
    rdfs:comment "Date the service point ceased delivering utility service, if applicable."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:ServicePoint.servicePostalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service postal code"@en ;
    rdfs:comment "Postal/ZIP code for the service point address."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_postal_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:StreetAddress.postalCode .
cmm:ServicePoint.serviceStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service start date"@en ;
    rdfs:comment "Date the service point began delivering utility service."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:ServicePoint.serviceState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service state"@en ;
    rdfs:comment "State or province of the service point location."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:ServicePoint.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current operational status of the service point."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "service_point_status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:UsagePoint.status .
cmm:ServicePoint.tariffCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff code"@en ;
    rdfs:comment "Code representing the tariff applied to the service point."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ServicePoint.type a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "Category of the service point based on customer class or usage."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "service_point_type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:UsagePoint.kind .
cmm:ServicePoint.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to the service point record."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ServicePoint.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Design voltage classification for the service point."@en ;
    rdfs:domain cmm:ServicePoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .


#################################################################
# Subject area: outage
#################################################################

cmm:OutageEvent a owl:Class ;
    rdfs:label "Outage Event"@en ;
    rdfs:comment "Core master record for every unplanned or planned power interruption event managed by the OMS. Captures the full lifecycle from initial detection (via AMI ping, SCADA alarm, customer call clustering, or predictive model) through final restoration. Includes cause classification, outage type (sustained, momentary, planned, major event per IEEE 1366), affected circuit/feeder, estimated vs. actual restoration time (ETR/ATR), initial prediction metadata (source, confidence, predicted scope, predicted cause, predicted affected segments), source call/report metadata (call receipt timestamp, source type, reported symptom, call disposition, duplicate flag, call clustering results), lifecycle status transitions with full audit trail (status code, transition timestamp, triggering actor, status notes), affected network segment detail (segment identifier, type, de-energization timestamps, isolation method, customer count, restoration sequence priority), SAIDI/SAIFI/CAIDI contribution, storm flag, Major Event Day declaration status, and OMS event identifier. This is the authoritative SSOT for outage event identity, lifecycle, initial prediction, source reporting, status history, and segment-level impact in the outage domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Outage ;
    cmm:cimExactMatch cim:Outage ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.event" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEC 61968-3; IEEE 1366; OMS Outage Event (GE PowerOn ADMS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.event" ;
    owl:hasKey ( cmm:OutageEvent.eventId ) .

cmm:OutageEvent.eventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event id"@en ;
    rdfs:comment "Unique surrogate identifier for each outage event record in the OMS. Primary key for the outage_event data product. Serves as the authoritative SSOT identity key for all downstream joins, lineage, and reporting."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Outages may result from contingencies analyzed in advance (N-1, N-2 events). Linking enables post-event analysis comparing actual outage impacts vs. contingency analysis predictions for NERC complianc"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_contingency_id" ;
    cmm:cimAssociation "Outage.Contingency" .
cmm:OutageEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Outages within control areas impact ACE, CPS compliance, frequency response obligations, and NERC reporting. Control center operators need to track outage impacts on balancing authority performance me"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_control_area_id" ;
    cmm:cimAssociation "Outage.ControlArea" .
cmm:OutageEvent.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Storm restoration and emergency response costs are charged to specific cost centers for O&M expense tracking, FERC Form 1 reporting, and regulatory cost recovery filings. Standard utility financial pr"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_cost_center_id" ;
    cmm:cimAssociation "Outage.Organisation" .
cmm:OutageEvent.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Outage events must track DER involvement for root cause analysis, IEEE 1547 compliance verification, fault contribution assessment, and regulatory reporting. OMS systems routinely flag DER-related dis"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_der_system_id" ;
    cmm:cimAssociation "Outage.PowerElectronicsConnection" .
cmm:OutageEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation from which the affected circuit originates. Used for substation-level outage aggregation, asset performance analysis, and transmission-to-distribution boundary reporting."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_distribution_substation_id" ;
    cmm:cimAssociation "Outage.Substation" .
cmm:OutageEvent.emergencyResponsePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency response plan"@en ;
    rdfs:comment "Foreign key linking to outage.emergency_response_plan. Business justification: Associate an outage event with the emergency response plan used for that event; many events can use the same plan."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:EmergencyResponsePlan ;
    cmm:physicalColumn "emergency_response_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Response Plan Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_emergency_response_plan_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:OutageEvent.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the primary distribution circuit or feeder affected by the outage event, as maintained in the GIS (Esri ArcGIS Utility Network) and ADMS. Used for circuit-level reliability reporting, SAIDI/SAIFI aggregation, and feeder performance benchmarking."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Circuit / Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_feeder_id" ;
    cmm:cimAssociation "Outage.Feeder" .
cmm:OutageEvent.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Outage events occur within forecast zones. Utilities track zone-level outage impacts for load forecast adjustments, reliability index calculations by zone, and regulatory reporting. OMS systems routin"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_forecast_zone_id" ;
    cmm:cimAssociation "Outage.LoadArea" .
cmm:OutageEvent.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Planned outages require grid switching orders for safe de-energization. Linking enables coordination between OMS and EMS, ensuring switching plans align with outage schedules and customer notification"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_grid_switching_order_id" ;
    cmm:cimAssociation "Outage.SwitchingPlan" .
cmm:OutageEvent.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Major outage events (storms, major equipment failures) trigger internal orders to segregate restoration costs for insurance claims, PUC storm cost recovery proceedings, and FEMA reimbursement tracking"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_internal_order_id" ;
    cmm:cimAssociation "Outage.ErpProjectAccounting" .
cmm:OutageEvent.isolationDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "isolation device"@en ;
    rdfs:comment "Identifier of the primary switching or protective device (recloser, sectionalizer, fuse, breaker) used to isolate the fault and define the outage boundary. Sourced from GIS/ADMS network model. Used for FLISR (Fault Location, Isolation, and Service Restoration) analysis."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "isolation_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Isolation Device ID" ;
    cmm:sourceColumn "sectionalizing_device_id" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_isolation_device_id" ;
    cmm:cimAssociation "Outage.ProtectedSwitch" .
cmm:OutageEvent.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Outage events must be evaluated against regulatory obligations for NERC/PUC reportability. Compliance officers determine which outages trigger mandatory reporting under specific obligations (NERC EOP,"@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_obligation_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:OutageEvent.reliabilityIndexPeriod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index period"@en ;
    rdfs:comment "Foreign key linking to outage.reliability_index_period. Business justification: Connect each outage event to its reporting period for reliability metrics; many events belong to one reliability_index_period."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:ReliabilityIndexPeriod ;
    cmm:physicalColumn "reliability_index_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reliability Index Period Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_reliability_index_period_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:OutageEvent.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Reference to the regulated service territory within which the outage occurred. Used for PUC regulatory reporting, territory-level reliability benchmarking, and rate case support."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_service_territory_id" ;
    cmm:cimAssociation "Outage.SubGeographicalRegion" .
cmm:OutageEvent.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Reference to the parent storm or severe weather event record when is_storm_event is True. Links individual outage events to the storm event for aggregate storm impact reporting and mutual aid cost tracking."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_storm_event_id" ;
    cmm:cimAssociation "Outage.Incident" .
cmm:OutageEvent.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the corrective maintenance or emergency repair work order created in the Asset Management system (Ventyx Asset Suite / SAP S/4HANA PM) to address the root cause of the outage. Links outage event to asset repair lifecycle."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_work_order_id" ;
    cmm:cimAssociation "Outage.Work" .
cmm:OutageEvent.actualRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual restoration timestamp"@en ;
    rdfs:comment "The Actual Time of Restoration (ATR) — the confirmed timestamp when the last affected customer on this outage event was restored to service. Used as the authoritative end time for SAIDI/SAIFI/CAIDI duration calculations."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Time of Restoration (ATR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.affectedCustomersCommercial a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customers commercial"@en ;
    rdfs:comment "Number of commercial customer service points affected by this outage event. Subset of customers_affected_count. Used for commercial segment reliability reporting and economic impact estimation."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customers_commercial" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.affectedCustomersIndustrial a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customers industrial"@en ;
    rdfs:comment "Number of industrial customer service points affected by this outage event. Subset of customers_affected_count. Used for industrial segment reliability reporting and large-customer impact notifications."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customers_industrial" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Industrial Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.affectedCustomersResidential a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customers residential"@en ;
    rdfs:comment "Number of residential customer service points affected by this outage event. Subset of customers_affected_count. Used for customer class-level reliability reporting and equity analysis required by some state PUCs."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customers_residential" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Residential Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.caidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caidi minutes"@en ;
    rdfs:comment "The Customer Average Interruption Duration Index (CAIDI) for this outage event, representing the average restoration time experienced by affected customers. Calculated as total customer_minutes_interrupted divided by customers_affected_count. Stored at event level for benchmarking."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "caidi_minutes" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Average Interruption Duration Index (CAIDI) in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageEvent.callCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "call count"@en ;
    rdfs:comment "Total number of customer calls or trouble reports received and clustered to this outage event. Used to gauge customer impact severity, prioritize restoration, and assess IVR/call center load during storm events."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "call_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Call Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized cause classification code assigned to the outage event upon investigation. Follows the IEEE 1366 cause code taxonomy (e.g., weather, equipment failure, animal contact, vegetation, human error, unknown). Reference-value candidates: weather|equipment_failure|animal_contact|vegetation|human_error|scheduled_maintenance|third_party|unknown."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Free-text narrative description of the root cause of the outage, as determined by field crew investigation or engineering analysis. Supplements the structured cause_code with operational detail."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Description" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the outage event record was first created in the OMS or Silver layer data product. Used for audit trail, data lineage, and SLA tracking of event creation latency."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Outage.createdDateTime .
cmm:OutageEvent.crewDispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatch timestamp"@en ;
    rdfs:comment "Timestamp when the first field crew was dispatched to the outage location. Used to measure dispatch response time (detection_timestamp to crew_dispatch_timestamp) as an operational KPI and for regulatory response time compliance."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.crewOnSiteTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew on site timestamp"@en ;
    rdfs:comment "Timestamp when the first field crew arrived on-site at the outage location. Used to measure crew travel time and assess field response performance against SLA targets."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_on_site_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew On-Site Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.criticalFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facility flag"@en ;
    rdfs:comment "Indicates whether the outage event affects one or more critical facilities (hospitals, emergency services, water treatment, telecommunications, or other life-safety infrastructure). True triggers elevated priority and mandatory regulatory notification protocols."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facility Affected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.customerMinutesInterrupted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer minutes interrupted"@en ;
    rdfs:comment "Total customer minutes interrupted (CMI) contributed by this outage event, calculated as the sum of interruption duration (minutes) multiplied by customers affected for each restoration segment. Primary input to SAIDI (System Average Interruption Duration Index) calculation."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "customer_minutes_interrupted" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Minutes Interrupted (CMI)" ;
    cmm:cimDatatype "Decimal" .
cmm:OutageEvent.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Total number of customer service points (meters) interrupted by this outage event at peak impact. Used as the primary customer impact metric for SAIFI calculation (interruptions per customer) and regulatory reporting to PUC."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.detectionSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "detection source"@en ;
    rdfs:comment "The source or mechanism by which the outage was first detected. Supports analysis of detection method effectiveness and AMI/SCADA investment value. Values: ami_ping (AMI outage notification), scada_alarm (SCADA supervisory alarm), customer_call (inbound customer report), predictive_model (ML-based prediction), field_crew (crew observation), smart_meter_outage_notification (last gasp signal)."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "detection_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Detection Source" ;
    cmm:validValues "ami_ping|scada_alarm|customer_call|predictive_model|field_crew|smart_meter_outage_notification" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.detectionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "detection timestamp"@en ;
    rdfs:comment "The principal real-world timestamp when the outage event was first detected or reported, regardless of detection source (AMI ping, SCADA alarm, customer call, or predictive model). This is the authoritative event start time used for SAIDI/SAIFI/CAIDI duration calculations per IEEE 1366."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "detection_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Detection Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.energyNotServedMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy not served mwh"@en ;
    rdfs:comment "Estimated energy not served (ENS) in MWh due to this outage event, calculated as the product of average load (MW) on the affected circuit and the outage duration (hours). Used for economic impact assessment, IRP planning, and regulatory reporting."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_not_served_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Not Served (ENS) in Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:OutageEvent.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "The Estimated Time to Restoration (ETR) communicated to customers and field crews, representing the predicted date and time by which all affected customers will be restored. Updated dynamically as restoration progresses. Distinct from actual_restoration_timestamp."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time to Restoration (ETR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the outage event within the OMS workflow. Transitions: new (detected, unworked) → in_progress (crew dispatched or switching underway) → restored (all customers re-energized) → closed (event verified and finalized) → cancelled (duplicate or false positive confirmed)."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Event Lifecycle Status" ;
    cmm:validValues "new|in_progress|restored|closed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.status .
cmm:OutageEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the outage event per IEEE 1366 definitions: sustained (interruption > 5 minutes), momentary (≤ 5 minutes), planned (scheduled maintenance), major_event_day (MED per IEEE 1366 beta method), or partial (affecting a subset of customers on a circuit). Reference-value candidates: sustained|momentary|planned|major_event_day|partial|rolling."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Event Type" ;
    cmm:validValues "sustained|momentary|planned|major_event_day|partial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.type .
cmm:OutageEvent.faultLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault location"@en ;
    rdfs:comment "Descriptive location of the fault or interruption point on the network (e.g., pole number, span identifier, address nearest to fault). Captured from field crew report or automated fault location indicator (FLI) in the ADMS."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Description" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.initialCallReceiptTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initial call receipt timestamp"@en ;
    rdfs:comment "Timestamp when the first customer call or report associated with this outage event was received by the Customer Information System (CIS) or IVR. Used for call clustering analysis and detection latency measurement."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "initial_call_receipt_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initial Customer Call Receipt Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.isMajorEventDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is major event day"@en ;
    rdfs:comment "Indicates whether this outage event occurred on a day declared as a Major Event Day (MED) per the IEEE 1366 beta method. MED events are excluded from standard SAIDI/SAIFI calculations and reported separately to PUC. True = MED event; False = normal event."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_major_event_day" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.isStormEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is storm event"@en ;
    rdfs:comment "Indicates whether this outage event was caused by or associated with a declared storm or severe weather event. Storm-flagged events may be subject to separate regulatory reporting thresholds and mutual aid activation criteria."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_storm_event" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.isolationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation method"@en ;
    rdfs:comment "Method by which the fault was isolated from the network: automatic (protective device operated automatically), manual (field crew operated device manually), remote (SCADA/ADMS remote switching), or flisr_automated (ADMS FLISR automation executed switching sequence)."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "isolation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Isolation Method" ;
    cmm:validValues "automatic|manual|remote|flisr_automated" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this outage event meets NERC reporting thresholds (e.g., EOP-004 disturbance reporting criteria based on MW loss, customer count, or duration). True = event must be reported to NERC/DOE via OE-417 or equivalent."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Indicates whether automated customer outage notifications (IVR, SMS, email, or app push) have been sent for this outage event. True = at least one notification batch dispatched. Used for regulatory compliance tracking of customer communication requirements."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "Timestamp when the first customer outage notification was dispatched for this event. Used to measure notification latency from detection and to demonstrate compliance with PUC customer communication time requirements."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageEvent.omsEventCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms event code"@en ;
    rdfs:comment "The externally-known event identifier assigned by the Outage Management System (GE PowerOn ADMS). This is the operational business identifier used by field crews, dispatchers, and customer service representatives to reference the outage event across systems."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_event_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Event ID" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.predictedCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted cause code"@en ;
    rdfs:comment "The cause code predicted by the OMS predictive model or ADMS fault analysis engine at the time of initial detection, before field crew investigation. Compared against final cause_code for model accuracy tracking. Reference-value candidates: weather|equipment_failure|animal_contact|vegetation|human_error|unknown."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "predicted_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.predictedCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted customers affected"@en ;
    rdfs:comment "The number of customers predicted to be affected by the outage at the time of initial detection, as estimated by the OMS/ADMS predictive model. Compared against actual customers_affected_count for model accuracy and ETR calibration."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "predicted_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageEvent.predictionConfidenceScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prediction confidence score"@en ;
    rdfs:comment "Confidence score (0.00–100.00) assigned by the predictive model or ADMS fault analysis engine to the initial outage prediction, including predicted cause and affected scope. Used to assess model reliability and calibrate automated dispatch thresholds."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "prediction_confidence_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Prediction Confidence Score" ;
    cmm:cimDatatype "Decimal" .
cmm:OutageEvent.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Restoration priority classification assigned to the outage event, used to sequence crew dispatch and switching operations. Critical: hospitals, emergency services, critical infrastructure; High: large commercial/industrial, high customer count; Medium: standard residential; Low: single-customer or non-critical."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Restoration Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:OutageEvent.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Indicates whether this outage event meets the state Public Utility Commission (PUC) threshold for mandatory individual event reporting (e.g., exceeds customer count or duration thresholds defined in the utility's tariff or service quality rules)."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Public Utility Commission (PUC) Reportable Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageEvent.reportedSymptom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported symptom"@en ;
    rdfs:comment "The primary symptom reported by the first customer caller or detected by the AMI/SCADA system at the time of initial report. Used for triage, cause hypothesis, and crew dispatch guidance."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "reported_symptom" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported Outage Symptom" ;
    cmm:validValues "no_power|flickering|partial_power|low_voltage|high_voltage|other" ;
    cmm:cimDatatype "String" .
cmm:OutageEvent.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "This event's contribution to the System Average Interruption Duration Index (SAIDI), expressed in customer-minutes per total customers served. Calculated as customer_minutes_interrupted divided by total customers served in the reporting period. Stored at event level for regulatory period aggregation."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageEvent.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "This event's contribution to the System Average Interruption Frequency Index (SAIFI), expressed as customer interruptions per total customers served. Calculated as customers_affected_count divided by total customers served. Stored at event level for regulatory period aggregation."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:OutageEvent.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to the outage event record. Supports change detection, incremental ETL processing, and audit compliance."@en ;
    rdfs:domain cmm:OutageEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:CustomerInterruption a owl:Class ;
    rdfs:label "Customer Interruption"@en ;
    rdfs:comment "Granular record of a single customer or premise-level service interruption linked to a parent outage event or planned maintenance window. Tracks the specific service point, customer account reference, interruption start and end timestamps, duration in minutes, cause code, restoration method (switching, repair, bypass), planned/unplanned flag, notification sent flag, notification channel, critical care designation (medical baseline, life support), restoration confirmation, and association to planned maintenance windows. Also serves as the customer-outage association record capturing per-customer impact including notification delivery status and opt-out preferences. This is the single SSOT for ALL customer-level outage impact — feeds SAIDI, SAIFI, and CAIDI reliability index calculations, supports customer-facing outage communication, drives regulatory customer impact reporting, and provides the definitive record of which customers were affected by each event."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:Outage ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.interruption" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEEE 1366; Customer Interruption Record (IEEE 1366)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.interruption" ;
    owl:hasKey ( cmm:CustomerInterruption.interruptionId ) .

cmm:CustomerInterruption.interruptionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption id"@en ;
    rdfs:comment "Unique surrogate identifier for a single customer or premise-level service interruption record. Primary key for this entity."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:long ;
    cmm:physicalColumn "interruption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Interruption ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInterruption.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with the interrupted service point at the time of the interruption. Supports customer-facing outage communication and regulatory customer impact reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_account_id" ;
    cmm:cimAssociation "Outage.CustomerAccount" .
cmm:CustomerInterruption.amiMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ami meter"@en ;
    rdfs:comment "The AMI meter identifier associated with the service point at the time of the interruption. Used to correlate last-gasp and first-breath AMI signals from the MDM system for automated interruption detection and restoration confirmation."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "ami_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Meter ID" ;
    cmm:sourceColumn "meter_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_ami_meter_id" ;
    cmm:cimAssociation "Outage.Meter" .
cmm:CustomerInterruption.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Foreign key linking to billing.billing_service_agreement. Business justification: Individual customer interruptions require service agreement context to apply correct credit calculation rules based on rate schedule, service class, and contractual SLA terms. Enables automated credit"@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_billing_service_agreement_id" ;
    cmm:cimAssociation "Outage.CustomerAgreement" .
cmm:CustomerInterruption.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation serving the affected service point at the time of the interruption. Supports substation-level reliability performance reporting and outage root cause analysis."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_distribution_substation_id" ;
    cmm:cimAssociation "Outage.Substation" .
cmm:CustomerInterruption.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that caused this customer-level interruption. Links the granular interruption record to the broader outage event for SAIDI/SAIFI/CAIDI roll-up calculations."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_event_id" ;
    cmm:cimAssociation "Outage.Outage" .
cmm:CustomerInterruption.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the distribution feeder circuit that serves the affected service point. Supports feeder-level reliability analysis, SAIDI/SAIFI benchmarking by circuit, and GIS-based outage mapping."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_feeder_id" ;
    cmm:cimAssociation "Outage.Feeder" .
cmm:CustomerInterruption.interruptionPlannedOutageWindow a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interruption planned outage window"@en ;
    rdfs:comment "Reference to the planned maintenance window associated with this interruption, when applicable. Null for unplanned outages. Links to the planned outage schedule for customer notification and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:PlannedOutageWindow ;
    cmm:physicalColumn "interruption_planned_outage_window_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Maintenance Window ID" ;
    cmm:sourceColumn "planned_outage_window_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_interruption_planned_outage_window_id" ;
    cmm:cimAssociation "Outage.PlannedOutage" .
cmm:CustomerInterruption.outageCrewDispatch a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage crew dispatch"@en ;
    rdfs:comment "Reference to the field crew dispatch record associated with the restoration of this interruption. Links to workforce management for crew response time analysis and restoration efficiency reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:OutageCrewDispatch ;
    cmm:physicalColumn "outage_crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_outage_crew_dispatch_id" ;
    cmm:cimAssociation "Outage.FieldDispatchHistory" .
cmm:CustomerInterruption.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the switching order executed to isolate or restore the affected circuit segment. Links the customer-level interruption to the operational switching workflow in the ADMS/OMS."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_outage_switching_order_id" ;
    cmm:cimAssociation "Outage.SwitchingPlan" .
cmm:CustomerInterruption.servicePoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service point"@en ;
    rdfs:comment "Reference to the specific service delivery point (meter point or premise connection) that experienced the interruption. The fundamental unit of interruption tracking per IEEE 1366."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:ServicePoint ;
    cmm:physicalColumn "service_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_service_point_id" ;
    cmm:cimAssociation "Outage.UsagePoint" .
cmm:CustomerInterruption.toPlannedOutageWindow a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to planned outage window"@en ;
    rdfs:comment "FK to outage.planned_outage_window.planned_outage_window_id — Customer interruptions from planned maintenance link to the planned outage window. Required for distinguishing planned vs unplanned interruptions in reliability reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range cmm:PlannedOutageWindow ;
    cmm:physicalColumn "to_planned_outage_window_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_interruption_to_planned_outage_window_id" ;
    cmm:cimAssociation "Outage.PlannedOutage" .
cmm:CustomerInterruption.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized code identifying the primary cause of the service interruption (e.g., weather, equipment failure, animal contact, vegetation, scheduled maintenance, third-party damage). Aligned with IEEE 1366 cause categories and OMS cause code taxonomy. Reference-value candidates: weather|equipment_failure|animal_contact|vegetation|scheduled_maintenance|third_party_damage|unknown|human_error|overload|lightning."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption Cause Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Free-text narrative description of the specific cause of the interruption, supplementing the standardized cause_code with field crew observations, dispatcher notes, or automated OMS event descriptions."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption Cause Description" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this interruption record was first created in the system, either by automated OMS event processing or manual dispatcher entry. Supports audit trail and data lineage requirements."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Outage.createdDateTime .
cmm:CustomerInterruption.criticalCareType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical care type"@en ;
    rdfs:comment "Specific category of critical care designation for the affected customer. Used to prioritize restoration sequencing and determine notification requirements. Only populated when is_critical_care is true."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "critical_care_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Care Type" ;
    cmm:sensitivity "confidential" ;
    cmm:validValues "medical_baseline|life_support|dialysis|oxygen_dependent|none" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.customerClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer class"@en ;
    rdfs:comment "Classification of the affected customer by service class at the time of the interruption. Used for segmented SAIDI/SAIFI/CAIDI reporting by customer class as required by state PUC reliability standards and NERC reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|government" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customers affected by the parent outage event at the time this interruption record was created. Denormalized from the outage event for regulatory reporting convenience. Used in SAIFI numerator calculations and NERC/PUC customer impact reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInterruption.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Indicates the data quality status of this interruption record as assessed during Silver layer validation. 'validated' indicates all timestamps and durations are confirmed; 'estimated' indicates one or more fields are estimated; 'suspect' indicates anomalies detected; 'corrected' indicates the record has been manually revised post-initial capture."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "validated|estimated|suspect|corrected" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.durationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration minutes"@en ;
    rdfs:comment "Total duration of the service interruption in whole minutes, calculated as the difference between interruption_end_timestamp and interruption_start_timestamp. Stored as a business field to support SAIDI and CAIDI reliability index calculations without requiring real-time computation. Null if interruption is still active."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:CustomerInterruption.endTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end timestamp"@en ;
    rdfs:comment "Date and time when the customer's service was restored, recorded to millisecond precision. Null if the interruption is still active. Used as the end point for duration calculations and CAIDI index computation per IEEE 1366."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interruption End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CustomerInterruption.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "Estimated date and time of service restoration communicated to the customer and used for crew scheduling. Distinct from interruption_end_timestamp (actual restoration). Supports customer communication accuracy tracking and ETR (Estimated Time to Restore) performance measurement."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerInterruption.interruptionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption status"@en ;
    rdfs:comment "Current lifecycle state of the interruption record. 'active' indicates the customer is currently without power; 'restored' indicates service has been re-energized; 'cancelled' indicates the interruption was logged in error; 'pending_confirmation' indicates restoration has been initiated but field confirmation is outstanding."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "interruption_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interruption Status" ;
    cmm:validValues "active|restored|cancelled|pending_confirmation" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.status .
cmm:CustomerInterruption.interruptionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption type"@en ;
    rdfs:comment "Classification of the interruption as planned (scheduled maintenance), unplanned (forced outage), or momentary (duration less than 5 minutes per IEEE 1366 definition). Drives separate SAIDI/SAIFI/MAIFI index tracking and regulatory reporting segmentation."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "interruption_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interruption Type" ;
    cmm:validValues "planned|unplanned|momentary" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.type .
cmm:CustomerInterruption.isCriticalCare a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is critical care"@en ;
    rdfs:comment "Indicates whether the affected customer or premise is designated as a critical care account (medical baseline, life support equipment, or other medically vulnerable designation). Critical care customers receive priority restoration and mandatory advance notification under state PUC rules."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_critical_care" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Care Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this interruption record was most recently modified, including status updates, restoration confirmation, or cause code revisions. Supports change tracking and Silver layer incremental processing."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CustomerInterruption.majorEventDayExclusion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event day exclusion"@en ;
    rdfs:comment "Indicates whether this interruption has been formally excluded from the standard SAIDI/SAIFI reliability index calculations under the IEEE 1366 Major Event Day beta method. Distinct from storm_event_flag — this is the formal regulatory exclusion determination."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_day_exclusion" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.momentaryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "momentary flag"@en ;
    rdfs:comment "Indicates whether this interruption qualifies as a momentary interruption (duration less than 5 minutes per IEEE 1366 definition). Momentary interruptions are tracked separately for MAIFI (Momentary Average Interruption Frequency Index) calculations."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "momentary_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "Communication channel used to deliver the outage notification to the affected customer. Supports multi-channel notification analytics and customer preference compliance reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Channel" ;
    cmm:validValues "sms|email|ivr|mobile_app|none" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.notificationOptOut a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification opt out"@en ;
    rdfs:comment "Indicates whether the customer has opted out of outage notifications for this service point. When true, notification_sent will be false by design. Supports customer preference management and regulatory opt-out compliance."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_opt_out" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Opt-Out Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.notificationSent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent"@en ;
    rdfs:comment "Indicates whether an outage notification has been sent to the affected customer for this interruption. Supports regulatory compliance tracking for customer notification requirements mandated by state PUCs."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "Date and time when the outage notification was dispatched to the customer. Used to measure notification lead time relative to interruption start and to demonstrate regulatory compliance with advance notice requirements for planned outages."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerInterruption.omsEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms event number"@en ;
    rdfs:comment "The externally-known event number assigned by the Outage Management System (GE PowerOn ADMS) to the parent outage event. Serves as the cross-system integration key for reconciliation between OMS, CIS, and MDM systems."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerInterruption.protectiveDeviceOperation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protective device operation"@en ;
    rdfs:comment "Type of protective device that operated to isolate the fault causing this interruption. Supports equipment performance analysis, recloser operation tracking, and fuse-saving vs. trip-and-reclose strategy evaluation."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "protective_device_operation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protective Device Operation" ;
    cmm:validValues "fuse|recloser|breaker|sectionalizer|none" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference number"@en ;
    rdfs:comment "Externally visible alphanumeric reference number assigned to this interruption record, used in customer communications, regulatory filings, and OMS integration. Format: INT-YYYY-NNNNNNNN."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interruption Reference Number" ;
    cmm:valuePattern "^INT-[0-9]{4}-[0-9]{8}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerInterruption.regulatoryReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable"@en ;
    rdfs:comment "Indicates whether this interruption must be included in regulatory reliability reports submitted to NERC, FERC, or state PUCs. Interruptions below minimum duration thresholds or excluded under MED rules may be flagged as non-reportable."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.restorationConfirmationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration confirmation method"@en ;
    rdfs:comment "Method by which service restoration was confirmed. AMI ping uses Advanced Metering Infrastructure last-gasp/first-breath signals; field_crew indicates on-site verification; customer_callback indicates customer-reported restoration; scada indicates SCADA system re-energization signal; estimated indicates restoration assumed based on switching operations."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_confirmation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Confirmation Method" ;
    cmm:validValues "ami_ping|field_crew|customer_callback|scada|estimated" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.restorationConfirmed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration confirmed"@en ;
    rdfs:comment "Indicates whether service restoration has been confirmed for this interruption, either through AMI meter ping, field crew confirmation, or customer callback. Distinguishes between estimated restoration and verified restoration for CAIDI accuracy."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "restoration_confirmed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Confirmed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.restorationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration method"@en ;
    rdfs:comment "Method used to restore service to the affected customer or premise. Supports operational analysis of restoration efficiency and crew dispatch effectiveness. Reference-value candidates: switching|repair|bypass|auto_reclosure|manual_transfer|temporary_generation."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Method" ;
    cmm:validValues "switching|repair|bypass|auto_reclosure|manual_transfer|temporary_generation" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "This interruption's individual contribution to the SAIDI reliability index, expressed in customer-minutes divided by total customers served. Stored as a pre-computed business field to support regulatory reporting aggregation without requiring full recalculation. Null if interruption is active or excluded from SAIDI."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:CustomerInterruption.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the regulated service territory within which the interrupted service point is located. Used for jurisdictional segmentation of reliability reporting across multiple state PUC regulatory boundaries."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifies the operational system of record from which this interruption record originated. Supports data lineage, reconciliation, and Silver layer provenance tracking across OMS, CIS, and MDM source systems."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "GE_PowerOn_ADMS|Oracle_CC&B|SAP_ISU|Oracle_MDM|manual" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.startTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start timestamp"@en ;
    rdfs:comment "Date and time when the customer's service interruption began, recorded to millisecond precision. This is the principal business event timestamp used as the start point for duration calculations and SAIDI/SAIFI index computation per IEEE 1366."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interruption Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CustomerInterruption.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this interruption occurred during a declared major event or storm. When true, the interruption may be excluded from IEEE 1366 Major Event Day (MED) calculations per the beta method, affecting SAIDI/SAIFI index reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInterruption.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Every customer-level interruption must link to its parent outage event. This is the foundational relationship for SAIDI/SAIFI/CAIDI calculation — without it, reliability indices cannot be computed. Da"@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInterruption.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Voltage classification of the circuit segment at which the interruption originated. Used to segment reliability reporting by voltage class and to identify transmission vs. distribution-level outage impacts for FERC and state PUC reporting."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level" ;
    cmm:validValues "transmission|subtransmission|primary_distribution|secondary_distribution" ;
    cmm:cimDatatype "String" .
cmm:CustomerInterruption.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Prevailing weather condition at the time and location of the interruption. Used for weather-normalized reliability analysis, storm response performance reporting, and climate resilience planning. Reference-value candidates: clear|wind|ice|snow|lightning|flood|extreme_heat|none."@en ;
    rdfs:domain cmm:CustomerInterruption ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:OutageSwitchingOrder a owl:Class ;
    rdfs:label "Outage Switching Order"@en ;
    rdfs:comment "Formal switching order issued during outage restoration or planned maintenance to reconfigure the distribution network. Captures the complete switching sequence including individual step detail (step sequence number, device identifier, device type, action type — open/close/tag/verify, required safety state, completion status, actual execution timestamp, executing crew member). Also records issuing dispatcher, executing crew, affected switching devices (sectionalizers, reclosers, breakers), safety clearance references, energization/de-energization timestamps, and approval chain. Supports granular audit trail of switching sequences for NERC compliance and post-event analysis. Integrates with GE PowerOn ADMS switching management module."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingPlan ;
    cmm:cimExactMatch cim:SwitchingPlan ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.restoration_operations ;
    cmm:physicalTable "utility_cmm_silver.outage.outage_switching_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; Switching Order (GE PowerOn ADMS / NERC FAC-001)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.outage_switching_order" ;
    owl:hasKey ( cmm:OutageSwitchingOrder.outageSwitchingOrderId ) .

cmm:OutageSwitchingOrder.outageSwitchingOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order id"@en ;
    rdfs:comment "Unique surrogate identifier for the switching order record in the Silver Layer lakehouse. Primary key for this entity."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Switching Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.affectedFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "affected feeder"@en ;
    rdfs:comment "Identifier of the primary distribution feeder circuit affected by this switching order. Used for network topology analysis, outage impact assessment, and GIS integration with Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "affected_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Affected Distribution Feeder ID" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_affected_feeder_id" ;
    cmm:cimAssociation "SwitchingPlan.Feeder" .
cmm:OutageSwitchingOrder.approverEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approver employee"@en ;
    rdfs:comment "Reference to the supervisor or operations manager who approved this switching order prior to execution. Supports the approval chain audit trail."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approver_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_approver_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:OutageSwitchingOrder.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Switching orders affect control area operations (state estimation, interchange schedules, AGC). EMS operators coordinate switching with field crews to maintain system reliability and balancing authori"@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_control_area_id" ;
    cmm:cimAssociation "SwitchingPlan.ControlArea" .
cmm:OutageSwitchingOrder.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the field crew assigned to execute this switching order. Used for crew dispatch tracking and post-event analysis."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_crew_id" ;
    cmm:cimAssociation "SwitchingPlan.Crew" .
cmm:OutageSwitchingOrder.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Switching orders require DER isolation verification before energization per IEEE 1547 and utility operating procedures. Operators must confirm DER status (online/offline/isolated) before executing swi"@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_der_system_id" ;
    cmm:cimAssociation "SwitchingPlan.PowerElectronicsConnection" .
cmm:OutageSwitchingOrder.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation from which the affected feeder originates or where the primary switching devices are located. Used for geographic scoping and asset management integration."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_distribution_substation_id" ;
    cmm:cimAssociation "SwitchingPlan.Substation" .
cmm:OutageSwitchingOrder.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that triggered this switching order. Links the switching sequence to the originating interruption or planned maintenance event in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_event_id" ;
    cmm:cimAssociation "SwitchingPlan.Outage" .
cmm:OutageSwitchingOrder.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Outage switching orders may reference or be coordinated with grid switching orders for transmission-connected substations. Linking enables cross-system switching coordination and safety compliance."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_grid_switching_order_id" ;
    cmm:cimAssociation "SwitchingPlan.SwitchingPlan" .
cmm:OutageSwitchingOrder.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Switching orders on critical infrastructure require compliance documentation under NERC CIP or operational reliability standards. Operations must document adherence to switching protocols mandated by"@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_obligation_id" ;
    cmm:cimAssociation "SwitchingPlan.Document" .
cmm:OutageSwitchingOrder.primaryOutageEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary outage employee"@en ;
    rdfs:comment "Reference to the control room dispatcher who issued and authorized this switching order. Required for NERC compliance audit trail."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_outage_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issuing Dispatcher ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_order_primary_outage_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:OutageSwitchingOrder.actualCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual customers affected"@en ;
    rdfs:comment "The confirmed number of customer service points that were interrupted as a result of this switching order, validated post-restoration. Used for SAIDI/SAIFI/CAIDI reliability metric calculation and regulatory reporting to State PUCs."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.actualEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end timestamp"@en ;
    rdfs:comment "The actual date and time when the final switching step was completed and the switching order was closed. Used for outage duration calculation and SAIDI/SAIFI/CAIDI reliability performance reporting."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Execution End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "The actual date and time when the field crew began executing the first step of the switching sequence. Used for SAIDI/SAIFI/CAIDI reliability metric calculation and post-event analysis."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Execution Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.admsSwitchingOrderRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adms switching order ref"@en ;
    rdfs:comment "The native switching order identifier assigned by the GE PowerOn Advanced Distribution Management System (ADMS). Used for cross-system reconciliation between the Silver Layer lakehouse and the operational ADMS source system."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "adms_switching_order_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Distribution Management System (ADMS) Switching Order Reference" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.approvalChainNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval chain notes"@en ;
    rdfs:comment "Free-text notes documenting the approval chain for this switching order, including any conditional approvals, escalations, or deviations from standard authorization procedures. Supports NERC compliance audit trail."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_chain_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Approval Chain Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageSwitchingOrder.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "The date and time when the switching order received final authorization from the approving supervisor or operations manager. Part of the approval chain audit trail required for NERC compliance."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text explanation of why this switching order was cancelled, if applicable. Populated only when order_status is 'cancelled'. Supports post-event analysis and process improvement."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.completedStepsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completed steps count"@en ;
    rdfs:comment "The number of individual switching steps that have been successfully executed and confirmed as of the last update. Enables real-time progress monitoring during active switching operations."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "completed_steps_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Completed Switching Steps Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this switching order record was first created in the system, which may precede the issued timestamp if the order was drafted in advance. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingPlan.createdDateTime .
cmm:OutageSwitchingOrder.customerNotificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification sent flag"@en ;
    rdfs:comment "Indicates whether advance customer notification was sent for this switching order (applicable to planned outages). Supports compliance tracking against State PUC advance notification requirements, typically 48-72 hours prior to planned interruption."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingOrder.deEnergizationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "de energization timestamp"@en ;
    rdfs:comment "The date and time when the affected network segment was de-energized (taken out of service) as part of this switching order. Critical for outage duration measurement and SAIDI calculation start point."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "de_energization_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-Energization Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.energizationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energization timestamp"@en ;
    rdfs:comment "The date and time when the affected network segment was re-energized (returned to service) following completion of the switching sequence. Marks the end of the customer interruption for SAIDI/CAIDI calculation."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "energization_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energization Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.estimatedCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated customers affected"@en ;
    rdfs:comment "The estimated number of customer service points that will be or are interrupted as a result of this switching order. Used for customer notification prioritization, regulatory reporting, and SAIFI calculation inputs."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.hazardNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard notes"@en ;
    rdfs:comment "Free-text field capturing known hazards, special safety precautions, or environmental conditions relevant to executing this switching order. Examples include downed conductors, flooded equipment, or proximity to energized lines. Mandatory review by crew before execution."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "hazard_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Hazard Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageSwitchingOrder.issuedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issued timestamp"@en ;
    rdfs:comment "The date and time when the dispatcher formally issued this switching order to the field crew. This is the principal business event timestamp marking the start of the switching order lifecycle. Recorded in ISO 8601 format with timezone offset."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "issued_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Order Issued Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time when this switching order record was most recently modified. Tracks any changes to the order after initial creation, supporting audit trail requirements."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageSwitchingOrder.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this switching order is associated with an event that meets NERC reportability thresholds (e.g., EOP-004 disturbance reporting). When True, the event must be included in mandatory NERC regulatory submissions."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingOrder.networkSegmentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network segment description"@en ;
    rdfs:comment "Human-readable description of the distribution or transmission network segment affected by this switching order, including feeder name, circuit section, and geographic reference. Supports field crew orientation and post-event reporting."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_segment_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Segment Description" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "The incident or trouble call number from the Outage Management System (OMS) associated with this switching order. Enables traceability from the switching sequence back to the originating customer-reported outage or system-detected fault."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageSwitchingOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle state of the switching order. Tracks progression from initial drafting through dispatcher issuance, field execution, and final completion or cancellation. Drives workflow routing in GE PowerOn ADMS."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Status" ;
    cmm:validValues "draft|issued|in_progress|completed|cancelled|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.status .
cmm:OutageSwitchingOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classification of the switching order by operational purpose. Distinguishes planned maintenance windows from emergency outage restoration, storm response, load transfer operations, and asset commissioning/decommissioning activities. Reference-value candidates: planned_maintenance|emergency_restoration|storm_response|load_transfer|commissioning|decommissioning."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Type" ;
    cmm:validValues "planned_maintenance|emergency_restoration|storm_response|load_transfer|commissioning|decommissioning" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.kind .
cmm:OutageSwitchingOrder.plannedOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage flag"@en ;
    rdfs:comment "Indicates whether this switching order is associated with a planned (scheduled) outage as opposed to an unplanned (forced) interruption. Planned outages are tracked separately for SAIDI/SAIFI reporting and customer advance notification compliance."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "planned_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingOrder.postEventReviewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post event review flag"@en ;
    rdfs:comment "Indicates whether this switching order has been flagged for mandatory post-event review, typically triggered by NERC reportable events, major storm response, or switching errors. Drives the post-event analysis workflow."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "post_event_review_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Event Review Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingOrder.postEventReviewNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post event review notes"@en ;
    rdfs:comment "Free-text findings and corrective actions documented during the post-event review of this switching order. Populated after review completion when post_event_review_flag is True. Supports continuous improvement and regulatory compliance."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "post_event_review_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Post-Event Review Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageSwitchingOrder.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Operational priority assigned to this switching order, used for restoration prioritization and crew dispatch sequencing. Critical priority is reserved for transmission-level or large-scale customer impact events."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:OutageSwitchingOrder.restorationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration method"@en ;
    rdfs:comment "The method used to restore service as part of this switching order. Distinguishes manual field crew switching from automated ADMS-driven Fault Location, Isolation, and Service Restoration (FLISR), remote switching via SCADA, sectionalizing, or load transfer to alternate feeders."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Method" ;
    cmm:validValues "manual|automatic_flisr|remote_switching|sectionalizing|load_transfer" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.safetyClearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance number"@en ;
    rdfs:comment "The reference number of the safety clearance (hold tag or clearance order) associated with this switching order. Ensures that de-energized equipment is properly tagged and locked out before crew work begins. Mandatory for OSHA lockout/tagout compliance."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Number" ;
    cmm:valuePattern "^CLR-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageSwitchingOrder.scheduledEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled end timestamp"@en ;
    rdfs:comment "The planned date and time by which the switching sequence is expected to be completed and the network restored to target configuration. Used for outage duration estimation and customer notification."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "The planned date and time for field crew to begin executing the switching sequence. Used for planned maintenance scheduling and crew coordination. May differ from actual execution start time."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingOrder.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this switching order was issued in response to a major storm or declared emergency event. When True, the associated outage duration may be excluded from IEEE Std 1366 SAIDI/SAIFI calculations per major event day (MED) criteria."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingOrder.suspensionReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "suspension reason"@en ;
    rdfs:comment "Free-text explanation of why this switching order was suspended mid-execution, if applicable. Populated only when order_status is 'suspended'. Common reasons include unexpected hazards, equipment failure, or crew safety concerns."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "suspension_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Suspension Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Externally-known alphanumeric identifier for the switching order, used by dispatchers, field crews, and control room operators. Format: SO-{YYYY}-{NNNNNN}. This is the business-facing reference number used in OMS and ADMS systems."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:valuePattern "^SO-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageSwitchingOrder.switchingPurposeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching purpose description"@en ;
    rdfs:comment "Free-text description of the operational reason for issuing this switching order, including the specific fault, maintenance activity, or load transfer objective. Provides context beyond the structured order_type classification."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_purpose_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Purpose Description" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.switchingZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching zone"@en ;
    rdfs:comment "The operational control zone or dispatch territory within which this switching order is executed. Aligns with the utility's geographic service territory divisions used for crew dispatch and reliability performance reporting."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Zone" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingOrder.totalStepsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total steps count"@en ;
    rdfs:comment "The total number of individual switching steps defined in this switching order sequence. Used for progress tracking and completeness validation during execution."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_steps_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Switching Steps Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.version a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version"@en ;
    rdfs:comment "Version number of this switching order, incremented each time the order is revised after initial issuance. Supports audit trail requirements and ensures field crews are executing the most current approved version of the switching sequence."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "version" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Order Version Number" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingOrder.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "The nominal operating voltage level in kilovolts (kV) of the network segment affected by this switching order. Determines applicable safety procedures, crew qualifications, and regulatory requirements."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OutageSwitchingOrder.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Reference to the associated maintenance or repair work order in the asset management system (Ventyx Asset Suite or SAP S/4HANA Plant Maintenance). Links the switching order to the underlying maintenance activity that necessitated the switching sequence."@en ;
    rdfs:domain cmm:OutageSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:OutageSwitchingStep a owl:Class ;
    rdfs:label "Outage Switching Step"@en ;
    rdfs:comment "Individual step within a switching order defining a discrete device operation (open, close, tag, verify). Tracks step sequence number, device identifier, action type, required safety state, completion status, actual execution timestamp, and executing crew member. Enables granular audit trail of switching sequences for NERC compliance and post-event analysis."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingAction ;
    cmm:cimExactMatch cim:SwitchingAction ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.restoration_operations ;
    cmm:physicalTable "utility_cmm_silver.outage.outage_switching_step" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; Switching Step (GE PowerOn ADMS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.outage_switching_step" ;
    owl:hasKey ( cmm:OutageSwitchingStep.outageSwitchingStepId ) .

cmm:OutageSwitchingStep.outageSwitchingStepId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching step id"@en ;
    rdfs:comment "Unique surrogate identifier for each individual step within a switching order. Primary key for the outage_switching_step entity in the Silver Layer lakehouse."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_switching_step_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Switching Step ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingStep.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the field crew unit dispatched to execute this switching step. A crew may execute multiple steps across one or more switching orders. Used for crew workload tracking and dispatch optimization."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_crew_id" ;
    cmm:cimAssociation "SwitchingAction.Crew" .
cmm:OutageSwitchingStep.deviceAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "device asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Switching steps operate on physical distribution assets (circuit breakers, reclosers, sectionalizers, switches). Linking to asset_registry enables maintenance history correlation, asset condition trac"@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "device_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Device Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_device_asset_registry_id" ;
    cmm:cimAssociation "SwitchingAction.Asset" .
cmm:OutageSwitchingStep.device a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "device"@en ;
    rdfs:comment "Reference to the specific switchable grid device (breaker, recloser, disconnect switch, sectionalizer, fuse, capacitor bank, or regulator) targeted by this switching step. Sourced from the GIS network model."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Device ID" ;
    cmm:sourceColumn "sectionalizing_device_id" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_device_id" ;
    cmm:cimAssociation "SwitchingAction.ProtectedSwitch" .
cmm:OutageSwitchingStep.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation associated with the target device. Supports substation-level switching activity reporting, transformer loading analysis, and geographic outage impact assessment."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_distribution_substation_id" ;
    cmm:cimAssociation "SwitchingAction.Substation" .
cmm:OutageSwitchingStep.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event (planned or unplanned) that this switching step is associated with. Links the granular switching activity to the broader outage lifecycle for SAIDI/SAIFI/CAIDI reporting and OMS event correlation."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_event_id" ;
    cmm:cimAssociation "SwitchingAction.Outage" .
cmm:OutageSwitchingStep.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the distribution feeder circuit on which the target device resides. Enables feeder-level aggregation of switching activity for reliability performance reporting and load management analysis."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_feeder_id" ;
    cmm:cimAssociation "SwitchingAction.Feeder" .
cmm:OutageSwitchingStep.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the parent switching order that contains this step. Establishes the header-to-line relationship between the switching order and its individual device operation steps."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_outage_switching_order_id" ;
    cmm:cimAssociation "SwitchingAction.SwitchingPlan" .
cmm:OutageSwitchingStep.primaryOutageEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary outage employee"@en ;
    rdfs:comment "Reference to the qualified crew member who physically performed this switching step. Required for NERC compliance audit trail and post-event accountability. Must be a certified switching operator per utility qualification standards."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_outage_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Executing Crew Member ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_primary_outage_employee_id" ;
    cmm:cimAssociation "SwitchingAction.ErpPersonnel" .
cmm:OutageSwitchingStep.protectionDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "protection device"@en ;
    rdfs:comment "Reference to the protective relay associated with the target device for this switching step. Relevant for steps involving circuit breakers where relay coordination must be verified before switching. Supports protection coordination analysis."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:ProtectionDevice ;
    cmm:physicalColumn "protection_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Protective Relay ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_protection_device_id" ;
    cmm:cimAssociation "SwitchingAction.ProtectionEquipment" .
cmm:OutageSwitchingStep.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Foreign key linking to grid.scada_point. Business justification: Switching steps operate devices monitored by SCADA points. Linking enables remote verification of device status, automated switching validation, and ADMS/OMS integration for coordinated switching."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scada Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_scada_point_id" ;
    cmm:cimAssociation "SwitchingAction.Measurement" .
cmm:OutageSwitchingStep.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the maintenance or construction work order in the asset management system that necessitated this switching step. Links switching activity to planned maintenance work for O&M cost tracking and asset lifecycle management."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_switching_step_work_order_id" ;
    cmm:cimAssociation "SwitchingAction.Work" .
cmm:OutageSwitchingStep.actionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action type"@en ;
    rdfs:comment "The discrete device operation to be performed in this switching step. 'Open' de-energizes a circuit segment; 'Close' re-energizes; 'Tag' applies a hold tag for safety isolation; 'Verify' confirms device state without operating it; 'Ground' applies protective grounding; 'De-energize'/'Energize' for non-switching state changes. Reference-value candidates: open|close|tag|verify|ground|de-energize|energize."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Type" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.actualDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual duration minutes"@en ;
    rdfs:comment "Actual time in minutes taken to execute this switching step, calculated from actual_execution_timestamp to completion_timestamp. Used for switching performance benchmarking, crew efficiency analysis, and future switching order planning."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageSwitchingStep.actualExecutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual execution timestamp"@en ;
    rdfs:comment "Actual date and time at which this switching step was physically executed in the field, expressed in ISO 8601 format with timezone offset. Critical for NERC compliance audit trails, SAIDI/SAIFI/CAIDI reliability metric calculation, and post-event analysis."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_execution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingStep.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time when this switching step received formal authorization from the control room operator or switching supervisor. Distinct from created_timestamp (authoring) and actual_execution_timestamp (field execution). Required for NERC compliance audit trail."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingStep.clearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance number"@en ;
    rdfs:comment "Safety clearance authorization number issued by the control room for this switching step. Required for high-voltage operations and provides the formal authorization reference linking the field operation to the control room approval record."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearance Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageSwitchingStep.completionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion notes"@en ;
    rdfs:comment "Free-text field for the executing crew member to record observations, anomalies, or deviations encountered during step execution. Captured at time of completion and preserved for post-event analysis and NERC compliance documentation."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "completion_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Completion Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageSwitchingStep.completionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion timestamp"@en ;
    rdfs:comment "Date and time at which the step was confirmed complete and the result was recorded in the OMS. May differ from actual_execution_timestamp if there is a delay between physical execution and system confirmation (e.g., radio communication lag or SCADA confirmation delay)."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingStep.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this switching step record was first created in the OMS/ADMS system. Establishes the audit trail start point for the step lifecycle. Expressed in ISO 8601 format with timezone offset."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingAction.createdDateTime .
cmm:OutageSwitchingStep.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of end-use customers whose service is interrupted or restored as a direct result of this switching step. Used in real-time SAIDI/SAIFI/CAIDI calculation and customer notification prioritization. Derived from the network topology model at time of execution."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingStep.deviceStateAfter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device state after"@en ;
    rdfs:comment "Confirmed state of the target device immediately after this switching step was executed. Verified by the executing crew member and/or SCADA telemetry. Used to confirm successful execution and update the real-time network model."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_state_after" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device State After" ;
    cmm:validValues "open|closed|tagged|grounded|unknown" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.deviceStateBefore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device state before"@en ;
    rdfs:comment "Confirmed state of the target device immediately before this switching step was executed (e.g., 'open', 'closed', 'tagged'). Verified by the executing crew member and recorded for audit trail integrity and post-event sequence reconstruction."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_state_before" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device State Before" ;
    cmm:validValues "open|closed|tagged|grounded|unknown" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.deviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:comment "Classification of the switchable device targeted by this step. Determines applicable safety procedures, required PPE, and permissible action types. Reference-value candidates: circuit_breaker|disconnect_switch|recloser|sectionalizer|fuse|capacitor_bank|voltage_regulator."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Type" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.estimatedDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated duration minutes"@en ;
    rdfs:comment "Planned duration in minutes for executing this switching step, as estimated during switching order planning. Used for outage window scheduling, crew time allocation, and customer notification of expected restoration times."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageSwitchingStep.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Documented reason why this switching step failed to execute successfully. Populated only when step_status is 'failed'. Used for root cause analysis, equipment reliability tracking, and corrective action planning."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.hazardDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard description"@en ;
    rdfs:comment "Free-text description of the specific hazard condition identified at the device location. Populated only when hazard_flag is True. Provides field crew with critical safety information before approaching the device."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "hazard_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazard Description" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.hazardFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard flag"@en ;
    rdfs:comment "Indicates whether a known hazard condition (e.g., downed conductor, flooded equipment, damaged structure) has been identified at the device location for this step. When True, additional safety precautions and supervisor approval are required before execution."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "hazard_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazard Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingStep.holdTagNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hold tag number"@en ;
    rdfs:comment "Physical hold tag or clearance tag number applied to the device as part of a lockout/tagout (LOTO) procedure for this switching step. Required for 'tag' action types. Provides traceability between the physical safety tag and the digital switching record."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "hold_tag_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Hold Tag Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageSwitchingStep.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this switching step record was most recently modified. Tracks the latest change to step details, status, or execution data. Used for data lineage, change detection in ETL pipelines, and audit compliance."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageSwitchingStep.loadTransferredMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transferred mw"@en ;
    rdfs:comment "Estimated or measured electrical load in megawatts (MW) transferred as a result of this switching step. Relevant for load transfer switching operations during outage restoration. Used for grid loading analysis and post-event load flow validation."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_transferred_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transferred (MW) Megawatts" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OutageSwitchingStep.nercReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable"@en ;
    rdfs:comment "Indicates whether this switching step is part of a switching sequence that must be reported to NERC under applicable reliability standards (e.g., FAC-001, FAC-002, or CIP standards). Drives automated regulatory reporting workflows."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Reportable" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingStep.omsStepReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms step reference"@en ;
    rdfs:comment "Native step identifier from the source Outage Management System (GE PowerOn ADMS) for this switching step record. Enables bidirectional traceability between the Silver Layer data product and the operational OMS for reconciliation and audit purposes."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_step_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Step Reference" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.plannedExecutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned execution timestamp"@en ;
    rdfs:comment "Scheduled date and time at which this switching step is planned to be executed, expressed in ISO 8601 format with timezone offset. Used for crew scheduling, outage window coordination, and customer notification timing."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_execution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingStep.remoteOperated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remote operated"@en ;
    rdfs:comment "Indicates whether this switching step was executed remotely via SCADA/ADMS control (True) or required physical field crew intervention (False). Supports FLISR (Fault Location Isolation and Service Restoration) automation performance tracking and remote switching capability analytics."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "remote_operated" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Operated" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingStep.requiredSafetyState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required safety state"@en ;
    rdfs:comment "Mandatory pre-condition safety state that the device or circuit segment must be in before this step can be executed. Enforces OSHA lockout/tagout (LOTO) and NERC safety rule compliance. Field crew must verify this state before proceeding."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "required_safety_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Required Safety State" ;
    cmm:validValues "de-energized|grounded|tagged_out|isolated|energized|any" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:OutageSwitchingStep.scadaConfirmationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada confirmation timestamp"@en ;
    rdfs:comment "Date and time at which SCADA telemetry confirmed the device state change for this switching step. Populated only when scada_confirmed is True. Used to measure SCADA response latency and validate field execution timing."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scada_confirmation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Confirmation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageSwitchingStep.scadaConfirmed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada confirmed"@en ;
    rdfs:comment "Indicates whether the device state change for this step was confirmed via SCADA telemetry in addition to field crew verbal confirmation. True when SCADA telemetry corroborates the reported device state; False when confirmation is based solely on field crew report (e.g., non-telemetered device)."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_confirmed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Confirmed" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageSwitchingStep.skipReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "skip reason"@en ;
    rdfs:comment "Documented justification for skipping this switching step, populated only when step_status is 'skipped'. Must be authorized by the control room operator and recorded for NERC compliance audit trail."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "skip_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Skip Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.stepInstruction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step instruction"@en ;
    rdfs:comment "Detailed written instruction describing exactly how this switching step is to be performed, including specific device location, approach direction, required tools, and safety precautions. Authored by the switching order planner and reviewed by the authorizing operator."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "step_instruction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step Instruction" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.stepSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step sequence number"@en ;
    rdfs:comment "Ordinal position of this step within the parent switching order. Defines the mandatory execution order of device operations to ensure safe and correct switching sequences. Steps must be executed in ascending sequence order unless the switching order explicitly permits parallel execution."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:int ;
    cmm:physicalColumn "step_sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:OutageSwitchingStep.stepStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step status"@en ;
    rdfs:comment "Current lifecycle state of this switching step. 'Pending' indicates awaiting execution; 'In Progress' indicates crew is actively performing the operation; 'Completed' indicates successfully executed; 'Skipped' indicates bypassed per approved deviation; 'Failed' indicates execution attempted but unsuccessful; 'Cancelled' indicates step voided prior to execution."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "step_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Step Status" ;
    cmm:validValues "pending|in_progress|completed|skipped|failed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingAction.status .
cmm:OutageSwitchingStep.switchingOrderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order type"@en ;
    rdfs:comment "Classification of the parent switching order that contextualizes this step. Determines applicable approval workflows, safety requirements, and reporting categories. Reference-value candidates: planned_maintenance|emergency_restoration|load_transfer|commissioning|decommissioning|storm_response."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Order Type" ;
    cmm:validValues "planned_maintenance|emergency_restoration|load_transfer|commissioning|decommissioning|storm_response" ;
    cmm:cimDatatype "String" .
cmm:OutageSwitchingStep.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage level in kilovolts (kV) of the circuit or bus associated with the target device. Determines applicable safety clearance distances, PPE requirements, and qualified worker certifications required for this step."@en ;
    rdfs:domain cmm:OutageSwitchingStep ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV) Kilovolts" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:OutageCrewDispatch a owl:Class ;
    rdfs:label "Outage Crew Dispatch"@en ;
    rdfs:comment "Record of a field crew assignment dispatched to an outage location for investigation, repair, or restoration. Captures dispatched crew identifier, dispatch timestamp, estimated travel time, on-site arrival time, work start and completion times, crew type (line crew, troubleshooter, contractor), vehicle assignment, dispatch priority tier, and dispatch status lifecycle. Links to outage events and restoration actions without duplicating workforce master data owned by the workforce domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:FieldDispatchHistory ;
    cmm:cimCloseMatch cim:FieldDispatchHistory ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.restoration_operations ;
    cmm:physicalTable "utility_cmm_silver.outage.outage_crew_dispatch" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 61968-3; Crew Dispatch (GE PowerOn ADMS / Ventyx Asset Suite)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.outage_crew_dispatch" ;
    owl:hasKey ( cmm:OutageCrewDispatch.outageCrewDispatchId ) .

cmm:OutageCrewDispatch.outageCrewDispatchId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage crew dispatch id"@en ;
    rdfs:comment "Unique surrogate identifier for each crew dispatch record within the outage management system. Primary key for the crew_dispatch data product."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Crew Dispatch ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCrewDispatch.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Crew dispatches to transmission-connected substations affect control area operations. Coordination between field crews and control center operators is essential for safe switching and maintaining syst"@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_control_area_id" ;
    cmm:cimAssociation "FieldDispatchHistory.ControlArea" .
cmm:OutageCrewDispatch.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Crew labor, vehicle, and equipment costs are allocated to cost centers for O&M expense tracking, budget variance analysis, and FERC account classification. Required for labor cost accounting and regul"@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_cost_center_id" ;
    cmm:cimAssociation "FieldDispatchHistory.Organisation" .
cmm:OutageCrewDispatch.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the field crew assigned to this dispatch. Links to the workforce domain crew master record without duplicating workforce data. Crew composition and qualifications are owned by the workforce domain."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_crew_id" ;
    cmm:cimAssociation "FieldDispatchHistory.Crew" .
cmm:OutageCrewDispatch.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event that triggered this crew dispatch. Links the dispatch record to the parent outage lifecycle managed in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_event_id" ;
    cmm:cimAssociation "FieldDispatchHistory.Outage" .
cmm:OutageCrewDispatch.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Crew dispatches are assigned to forecast zones for resource tracking, mutual aid coordination, and operational planning. Utilities use zone-level crew deployment data for storm response planning, reso"@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_forecast_zone_id" ;
    cmm:cimAssociation "FieldDispatchHistory.LoadArea" .
cmm:OutageCrewDispatch.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Crew dispatches execute grid switching orders. Linking enables tracking of switching order execution status, crew assignment, and field crew coordination with control center operators."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_grid_switching_order_id" ;
    cmm:cimAssociation "FieldDispatchHistory.SwitchingPlan" .
cmm:OutageCrewDispatch.restorationAction a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "restoration action"@en ;
    rdfs:comment "Reference to the specific restoration action or switching order this dispatch is fulfilling. Enables traceability from dispatch to restoration workflow step."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:RestorationAction ;
    cmm:physicalColumn "restoration_action_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Restoration Action ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_restoration_action_id" ;
    cmm:cimAssociation "FieldDispatchHistory.SwitchingAction" .
cmm:OutageCrewDispatch.trainingRecord a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "training record"@en ;
    rdfs:comment "Foreign key linking to compliance.training_record. Business justification: Crew dispatches to critical infrastructure or NERC CIP assets require verification that crew members have completed required compliance training (NERC CIP personnel risk assessments, safety certificat"@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range cmm:TrainingRecord ;
    cmm:physicalColumn "training_record_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Training Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_crew_dispatch_training_record_id" ;
    cmm:cimAssociation "FieldDispatchHistory.ActivityRecord" .
cmm:OutageCrewDispatch.actualArrivalAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual arrival at"@en ;
    rdfs:comment "Actual timestamp when the crew arrived at the outage location and confirmed on-site presence. Captured via mobile device check-in or OMS field update. Used to measure travel time actuals vs. estimates."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_arrival_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual On-Site Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.actualRestorationAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual restoration at"@en ;
    rdfs:comment "Timestamp when power was actually restored to affected customers following crew repair work. Used as the definitive restoration time for SAIDI (System Average Interruption Duration Index) and CAIDI (Customer Average Interruption Duration Index) calculations."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_restoration_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Reason code for dispatch cancellation when dispatch_status is 'cancelled'. Captures why the crew was stood down before completing the assignment (e.g., outage restored via FLISR/remote switching, duplicate dispatch, crew reassigned to higher priority). Reference-value candidates: duplicate_dispatch|outage_restored_remotely|crew_reassigned|weather_stand_down|customer_cancelled|other."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:validValues "duplicate_dispatch|outage_restored_remotely|crew_reassigned|weather_stand_down|customer_cancelled|other" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized cause code assigned by the crew upon arrival or completion, classifying the root cause of the outage (e.g., equipment failure, tree contact, animal contact, weather, vehicle accident). Aligns with IEEE 1366 cause code taxonomy for reliability reporting."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.clearedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cleared at"@en ;
    rdfs:comment "Timestamp when the crew was formally released from the outage site and cleared for reassignment. May differ from work_completed_at if post-work safety checks, documentation, or switching order closeout is required."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cleared_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Cleared Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.contractorCompanyName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor company name"@en ;
    rdfs:comment "Name of the external contractor company providing the crew, when crew_type is 'contractor' or mutual_aid_flag is true. Used for contractor performance tracking, invoice reconciliation, and mutual aid cost recovery."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "contractor_company_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contractor Company Name" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.createdAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created at"@en ;
    rdfs:comment "Timestamp when the crew dispatch record was first created in the Outage Management System (OMS). Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.createdDateTime .
cmm:OutageCrewDispatch.crewIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew identifier"@en ;
    rdfs:comment "Human-readable operational identifier for the dispatched crew (e.g., crew badge number, radio call sign, or crew unit code) as used by dispatchers and field supervisors in OMS communications."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Identifier Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.crewSize a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew size"@en ;
    rdfs:comment "Number of personnel included in the dispatched crew. Used for resource planning, storm response staffing analytics, and mutual aid tracking."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_size" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Size" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCrewDispatch.crewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type"@en ;
    rdfs:comment "Classification of the dispatched crew by functional role and capability. Determines the type of work the crew is qualified to perform at the outage site. Reference-value candidates: line_crew|troubleshooter|contractor|tree_crew|substation_crew|damage_assessment."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Type" ;
    cmm:validValues "line_crew|troubleshooter|contractor|tree_crew|substation_crew|damage_assessment" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.kind .
cmm:OutageCrewDispatch.criticalFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facility flag"@en ;
    rdfs:comment "Indicates whether the outage site or affected area includes a critical facility (e.g., hospital, emergency services, water treatment plant, military installation). Drives elevated dispatch priority and regulatory notification requirements."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCrewDispatch.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customer service points affected by the outage event at the time of dispatch. Used for prioritization, regulatory reporting, and SAIFI (System Average Interruption Frequency Index) calculations."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCrewDispatch.damageAssessmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage assessment code"@en ;
    rdfs:comment "Field crew assessment of infrastructure damage severity at the outage site. Used for storm response resource planning, mutual aid requests, and post-event damage reporting to regulators."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "damage_assessment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Damage Assessment Code" ;
    cmm:validValues "none|minor|moderate|major|catastrophic" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.dispatchLocationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch location description"@en ;
    rdfs:comment "Free-text description of the outage site location provided to the crew at dispatch time, including landmarks, access instructions, or hazard notes. Supplements GIS coordinates for field navigation."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Location Description" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.dispatchNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch number"@en ;
    rdfs:comment "Externally-known alphanumeric identifier for the dispatch record, used by field crews, dispatchers, and OMS operators for cross-system reference and communication. Format: DSP-YYYY-NNNNNN."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Number" ;
    cmm:valuePattern "^DSP-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCrewDispatch.dispatchPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority"@en ;
    rdfs:comment "Priority tier assigned to this dispatch, reflecting urgency based on outage impact (e.g., critical infrastructure, hospital, large customer count). Drives restoration sequencing and resource allocation decisions."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Priority Tier" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:OutageCrewDispatch.dispatchSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch source"@en ;
    rdfs:comment "Originating channel or system through which the dispatch was initiated. Distinguishes automated OMS-driven dispatches from manual dispatcher assignments, storm center activations, or mutual aid requests."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Source" ;
    cmm:validValues "oms_auto|dispatcher_manual|storm_center|mutual_aid|contractor_portal" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.dispatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch status"@en ;
    rdfs:comment "Current lifecycle state of the crew dispatch record, tracking progression from initial assignment through field completion. Reference-value candidates: pending|dispatched|en_route|on_site|work_in_progress|completed|cancelled."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.status .
cmm:OutageCrewDispatch.dispatchedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatched at"@en ;
    rdfs:comment "The principal real-world event timestamp when the crew was formally dispatched from the operations center to the outage location. Used as the primary business event time for SAIDI/SAIFI/CAIDI reliability metric calculations."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatched_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.dispatcherNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatcher notes"@en ;
    rdfs:comment "Free-text notes entered by the dispatcher at the time of crew assignment, including special instructions, hazard warnings, customer contact information, or access restrictions for the outage site."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatcher_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatcher Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageCrewDispatch.estimatedArrivalAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated arrival at"@en ;
    rdfs:comment "Calculated timestamp for when the crew is expected to arrive on-site at the outage location. Derived at dispatch time from dispatched_at plus estimated_travel_time_min. Used for customer ETR (Estimated Time to Restore) communications."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_arrival_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.estimatedRestorationAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration at"@en ;
    rdfs:comment "Estimated Time to Restore (ETR) as assessed by the crew or dispatcher after on-site evaluation. Used for customer notification updates and regulatory ETR reporting requirements. Distinct from estimated_arrival_at."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time to Restore (ETR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.estimatedTravelTimeMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated travel time min"@en ;
    rdfs:comment "Estimated travel time in minutes from the crew's current location or staging area to the outage site at the time of dispatch. Used for restoration time estimation and customer notification ETAs."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_travel_time_min" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Travel Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageCrewDispatch.fieldCrewNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field crew notes"@en ;
    rdfs:comment "Free-text notes entered by the field crew upon arrival or completion, documenting observed conditions, equipment findings, repair actions taken, or follow-up work required. Captured via mobile OMS interface."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "field_crew_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Field Crew Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageCrewDispatch.followUpRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "follow up required flag"@en ;
    rdfs:comment "Indicates whether the crew identified additional work required beyond the initial restoration scope (e.g., permanent repair after temporary restoration, equipment replacement, vegetation management). Triggers follow-up work order creation."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "follow_up_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Follow-Up Work Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCrewDispatch.mutualAidFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid flag"@en ;
    rdfs:comment "Indicates whether the dispatched crew is a mutual aid crew provided by another utility or contractor under a mutual assistance agreement. Used for storm cost tracking, mutual aid settlement, and NERC EOP-011 compliance reporting."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mutual_aid_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCrewDispatch.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "The incident or trouble call number assigned by the Outage Management System (OMS) that initiated this dispatch. Provides cross-system traceability between the OMS incident record and the dispatch record."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCrewDispatch.operatingDistrictCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating district code"@en ;
    rdfs:comment "Internal operating district or division code for the area where the outage occurred. Used for crew assignment routing, regional performance reporting, and SAIDI/SAIFI district-level aggregation."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "operating_district_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating District Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.safetyClearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance number"@en ;
    rdfs:comment "Unique identifier for the safety clearance or hold tag issued to the crew before commencing energized work. Required for OSHA lockout/tagout compliance and NERC CIP physical security documentation."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCrewDispatch.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the utility service territory or operating district in which the outage site is located. Used for regulatory reporting to State Public Utility Commissions (PUCs) and for regional resource allocation."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.siteLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "site latitude"@en ;
    rdfs:comment "Geographic latitude coordinate (decimal degrees, WGS84) of the outage site to which the crew is dispatched. Sourced from GIS or OMS outage location data for field navigation and spatial analytics."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "site_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Site Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:OutageCrewDispatch.siteLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "site longitude"@en ;
    rdfs:comment "Geographic longitude coordinate (decimal degrees, WGS84) of the outage site to which the crew is dispatched. Sourced from GIS or OMS outage location data for field navigation and spatial analytics."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "site_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Site Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:OutageCrewDispatch.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this dispatch is associated with a declared storm or major event. When true, the dispatch may be excluded from standard SAIDI/SAIFI calculations per IEEE 1366 major event day (MED) exclusion criteria."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCrewDispatch.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Reference number of the switching order issued to the crew for safe isolation and restoration of the affected circuit segment. Links to the switching order management workflow in the ADMS."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCrewDispatch.updatedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated at"@en ;
    rdfs:comment "Timestamp of the most recent modification to the crew dispatch record. Supports change tracking, audit compliance, and incremental data pipeline processing."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageCrewDispatch.vehicleIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vehicle identifier"@en ;
    rdfs:comment "Operational identifier for the assigned vehicle (e.g., fleet unit number, license plate, or radio unit ID) as used by dispatchers for field tracking and resource management."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "vehicle_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vehicle Identifier Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCrewDispatch.vehicleNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vehicle number"@en ;
    rdfs:comment "Reference to the vehicle assigned to this dispatch from the fleet management system. Links to the asset management domain vehicle master record."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:long ;
    cmm:physicalColumn "vehicle_number" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vehicle ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCrewDispatch.workCompletedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work completed at"@en ;
    rdfs:comment "Timestamp when the crew completed all assigned repair or restoration work at the outage site and confirmed task closure in the OMS. Used for SAIDI/CAIDI calculation and restoration performance reporting."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "work_completed_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCrewDispatch.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Reference to the associated work order in the asset management or ERP system (Ventyx Asset Suite or SAP S/4HANA Plant Maintenance) that governs the repair or restoration task assigned to this crew."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCrewDispatch.workStartAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work start at"@en ;
    rdfs:comment "Timestamp when the crew began active repair or restoration work at the outage site. Distinct from arrival time — accounts for safety setup, hazard assessment, and switching order receipt before work commences."@en ;
    rdfs:domain cmm:OutageCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "work_start_at" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Start Timestamp" ;
    cmm:cimDatatype "DateTime" .

cmm:RestorationAction a owl:Class ;
    rdfs:label "Restoration Action"@en ;
    rdfs:comment "Discrete restoration action taken during an outage event to restore power to a portion of affected customers, covering both manual and automated (FLISR) restoration. Records action type (isolation, sectionalizing, temporary bypass, permanent repair, load transfer, automated FLISR), execution mode (manual crew action vs automated grid self-healing), affected segment, customers restored by this action, action timestamp, crew performing the action (if manual), partial vs. full restoration flag, FLISR-specific attributes (fault detection timestamp, faulted segment, isolation actions taken automatically, load transfer actions, FLISR algorithm version, success/failure outcome, customers restored automatically vs requiring manual intervention). Enables step-by-step restoration tracking, ETR refinement, and FLISR performance analytics."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:SwitchingAction ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.restoration_operations ;
    cmm:physicalTable "utility_cmm_silver.outage.restoration_action" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; Restoration Action (GE PowerOn ADMS OMS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.restoration_action" ;
    owl:hasKey ( cmm:RestorationAction.restorationActionId ) .

cmm:RestorationAction.restorationActionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration action id"@en ;
    rdfs:comment "Unique surrogate identifier for each discrete restoration action record within the outage management system. Primary key for the restoration_action data product."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "restoration_action_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Restoration Action ID" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Restoration actions change load/generation balance within control areas, requiring AGC adjustments and interchange schedule updates. Essential for coordinating distribution restoration with transmissi"@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_control_area_id" ;
    cmm:cimAssociation "SwitchingAction.ControlArea" .
cmm:RestorationAction.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Restoration work costs (switching operations, load transfers, FLISR actions) are charged to cost centers for O&M expense allocation and variance analysis against distribution operations budgets. Stand"@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_cost_center_id" ;
    cmm:cimAssociation "SwitchingAction.Organisation" .
cmm:RestorationAction.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the field crew assigned to execute this restoration action. Populated only for manual crew-dispatched actions; null for fully automated FLISR actions."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_crew_id" ;
    cmm:cimAssociation "SwitchingAction.Crew" .
cmm:RestorationAction.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: FLISR and manual restoration sequences must account for DER presence on segments (anti-islanding protection, voltage regulation impact, fault current contribution). Restoration logic checks DER status"@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_der_system_id" ;
    cmm:cimAssociation "SwitchingAction.PowerElectronicsConnection" .
cmm:RestorationAction.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation serving the network segment affected by this restoration action. Used for substation-level outage aggregation and reliability reporting."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_distribution_substation_id" ;
    cmm:cimAssociation "SwitchingAction.Substation" .
cmm:RestorationAction.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that this restoration action is associated with. Links the discrete action to the broader outage lifecycle managed in the OMS."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_event_id" ;
    cmm:cimAssociation "SwitchingAction.Outage" .
cmm:RestorationAction.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit on which this restoration action was performed, as defined in the GIS and ADMS network model. Used for feeder-level reliability performance tracking."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_feeder_id" ;
    cmm:cimAssociation "SwitchingAction.Feeder" .
cmm:RestorationAction.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the switching order that authorized or directed this restoration action, if applicable. Switching orders govern the sequence of switching operations for safe restoration."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_outage_switching_order_id" ;
    cmm:cimAssociation "SwitchingAction.SwitchingPlan" .
cmm:RestorationAction.primaryRestorationNetworkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary restoration network segment"@en ;
    rdfs:comment "Reference to the distribution network segment (feeder section, lateral, or zone) affected by this restoration action. Identifies the portion of the grid being isolated, sectionalized, or re-energized."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "primary_restoration_network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Network Segment ID" ;
    cmm:sourceColumn "network_segment_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_primary_restoration_network_segment_id" ;
    cmm:cimAssociation "SwitchingAction.EquipmentContainer" .
cmm:RestorationAction.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Foreign key linking to grid.scada_point. Business justification: Restoration actions involve SCADA-monitored devices (reclosers, switches). Linking enables real-time status verification, FLISR automation, and coordinated distribution automation with EMS operations."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scada Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_scada_point_id" ;
    cmm:cimAssociation "SwitchingAction.Measurement" .
cmm:RestorationAction.sectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device"@en ;
    rdfs:comment "Identifier of the switching device (recloser, sectionalizer, circuit breaker, or fuse) operated to isolate the faulted segment during this action. References the device asset in the GIS or ADMS network model."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Isolation Device Identifier" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_restoration_action_sectionalizing_device_id" ;
    cmm:cimAssociation "SwitchingAction.ProtectedSwitch" .
cmm:RestorationAction.actionCompletedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action completed timestamp"@en ;
    rdfs:comment "Timestamp when the restoration action was confirmed complete and verified by the crew or automated system. Used to calculate action duration and assess restoration efficiency."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "action_completed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Completed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.actionDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action duration minutes"@en ;
    rdfs:comment "Elapsed time in minutes from action initiation (action_timestamp) to action completion (action_completed_timestamp). Used in CAIDI calculations and crew performance benchmarking."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "action_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:RestorationAction.actionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action notes"@en ;
    rdfs:comment "Free-text field for operator or crew notes describing the specific conditions, complications, or observations encountered during this restoration action. Supports post-event analysis and lessons-learned documentation."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Restoration Action Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:RestorationAction.actionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action number"@en ;
    rdfs:comment "Externally visible, human-readable identifier for this restoration action as recorded in the OMS or switching order log (e.g., RA-2024-00451). Used by field crews, control room operators, and regulators to reference specific actions."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Restoration Action Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RestorationAction.actionSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action sequence"@en ;
    rdfs:comment "Ordinal sequence number of this action within the parent outage event's restoration workflow. Enables step-by-step reconstruction of the restoration sequence for post-event analysis and SAIDI/SAIFI/CAIDI reporting."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "action_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.actionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action status"@en ;
    rdfs:comment "Current lifecycle status of the restoration action. Pending: scheduled but not yet started. In_progress: crew or automation is actively executing. Completed: action successfully finished. Failed: action attempted but unsuccessful. Cancelled: action voided before execution."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Restoration Action Status" ;
    cmm:validValues "pending|in_progress|completed|failed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingAction.status .
cmm:RestorationAction.actionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action timestamp"@en ;
    rdfs:comment "The principal real-world timestamp when this restoration action was executed or initiated in the field or by the automated system. Used as the primary event time for SAIDI/SAIFI/CAIDI calculations and restoration timeline analysis."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "action_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.actionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action type"@en ;
    rdfs:comment "Classification of the type of restoration action performed. Isolation: de-energizes a faulted segment. Sectionalizing: divides a feeder to limit the outage zone. Load transfer: moves load to an alternate feeder. Temporary bypass: restores power via a temporary path. Permanent repair: physical repair restoring normal configuration. FLISR automated: Fault Location Isolation and Service Restoration (FLISR) algorithm-driven action."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Restoration Action Type" ;
    cmm:validValues "isolation|sectionalizing|load_transfer|temporary_bypass|permanent_repair|flisr_automated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingAction.kind .
cmm:RestorationAction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this restoration action record was first created in the OMS or data platform. Supports audit trail and data lineage requirements."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingAction.createdDateTime .
cmm:RestorationAction.crewArrivalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew arrival timestamp"@en ;
    rdfs:comment "Timestamp when the field crew arrived on-site to begin executing this manual restoration action. Used to calculate crew travel time and on-site restoration duration for workforce performance analytics."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_arrival_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.crewDispatchedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatched timestamp"@en ;
    rdfs:comment "Timestamp when the field crew was dispatched from the control room or dispatch center to execute this restoration action. Used to measure dispatch-to-arrival interval and overall crew response time."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_dispatched_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Dispatched Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.customerNotificationSent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification sent"@en ;
    rdfs:comment "Indicates whether a customer notification (outage alert, ETR update, or restoration confirmation) was sent to affected customers as a result of this restoration action. Supports compliance with state PUC customer communication requirements."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_sent" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RestorationAction.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Total number of customer service points that were de-energized or affected by the segment targeted by this action at the time of action execution. Provides context for partial vs. full restoration assessment."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.customersRequiringManual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers requiring manual"@en ;
    rdfs:comment "Number of customers within the affected segment that could not be restored by FLISR automation and required manual crew dispatch for restoration. Highlights FLISR coverage gaps."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_requiring_manual" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Requiring Manual Intervention Count" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.customersRestoredAutomatically a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored automatically"@en ;
    rdfs:comment "Number of customers restored through fully automated Fault Location Isolation and Service Restoration (FLISR) self-healing actions without manual crew intervention. Key metric for FLISR performance analytics."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_automatically" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Automatically (FLISR)" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.customersRestoredCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored count"@en ;
    rdfs:comment "Number of customer service points restored to power as a direct result of this specific restoration action. Used in SAIDI, SAIFI, and CAIDI index calculations and regulatory reliability reporting."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.estimatedRestorationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration time"@en ;
    rdfs:comment "Estimated Time to Restore (ETR) for the remaining affected customers at the time this action was recorded. Updated as each restoration action is completed to refine the ETR communicated to customers and regulators."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time to Restore (ETR)" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.executionMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution mode"@en ;
    rdfs:comment "Indicates whether the restoration action was executed manually by a field crew or control room operator, fully automated by the FLISR algorithm, or semi-automated (system-initiated but operator-confirmed)."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "execution_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Mode" ;
    cmm:validValues "manual|automated|semi_automated" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.faultDetectedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault detected timestamp"@en ;
    rdfs:comment "Timestamp when the fault triggering this restoration action was first detected by SCADA, FLISR, or field crew. Distinct from action_timestamp; used to calculate fault-to-isolation and fault-to-restoration intervals."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "fault_detected_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Detected Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RestorationAction.flisrAlgorithmVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr algorithm version"@en ;
    rdfs:comment "Version identifier of the Fault Location Isolation and Service Restoration (FLISR) algorithm that executed this automated restoration action. Enables performance benchmarking across algorithm versions and supports software change management."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_algorithm_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Algorithm Version" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.flisrIsolationActionsTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr isolation actions taken"@en ;
    rdfs:comment "Number of automated switching operations performed by the FLISR algorithm to isolate the faulted segment during this restoration action. Supports FLISR performance analytics and switching operation audits."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "flisr_isolation_actions_taken" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Isolation Actions Taken Count" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.flisrLoadTransferActionsTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr load transfer actions taken"@en ;
    rdfs:comment "Number of automated load transfer switching operations performed by the FLISR algorithm to restore power to non-faulted segments during this action. Key metric for FLISR self-healing effectiveness."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "flisr_load_transfer_actions_taken" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Load Transfer Actions Taken Count" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.flisrOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr outcome"@en ;
    rdfs:comment "Outcome of the FLISR automated restoration attempt for this action. Success: FLISR fully restored the affected segment. Partial_success: FLISR restored a portion; manual intervention required for remainder. Failure: FLISR could not restore; full manual restoration required. Not_applicable: action was manual, not FLISR-driven."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Outcome" ;
    cmm:validValues "success|partial_success|failure|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.isMajorEventDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is major event day"@en ;
    rdfs:comment "Indicates whether this restoration action occurred during a Major Event Day (MED) as defined by IEEE 1366 beta method. MED events are typically excluded from standard SAIDI/SAIFI calculations and reported separately to regulators."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_major_event_day" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RestorationAction.isPartialRestoration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is partial restoration"@en ;
    rdfs:comment "Indicates whether this action resulted in a partial restoration (True) — restoring power to a subset of affected customers — or a full restoration of the affected segment (False). Drives ETR refinement and customer notification logic."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_partial_restoration" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Partial Restoration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RestorationAction.isPlannedOutage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is planned outage"@en ;
    rdfs:comment "Indicates whether this restoration action is associated with a planned maintenance outage (True) or an unplanned/forced outage (False). Planned outages are tracked separately for SAIDI/SAIFI reporting and customer notification compliance."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_planned_outage" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RestorationAction.loadTransferSourceFeeder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transfer source feeder"@en ;
    rdfs:comment "Identifier of the source feeder or substation bus from which load is transferred during a load transfer restoration action. Populated when action_type is load_transfer or flisr_automated."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_transfer_source_feeder" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transfer Source Feeder" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.loadTransferTargetFeeder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transfer target feeder"@en ;
    rdfs:comment "Identifier of the target feeder or substation bus receiving the transferred load during a load transfer restoration action. Used to assess feeder loading and capacity constraints post-transfer."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_transfer_target_feeder" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transfer Target Feeder" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.omsActionReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms action reference"@en ;
    rdfs:comment "Source system reference key for this restoration action as recorded in the GE PowerOn ADMS Outage Management System (OMS). Enables traceability and reconciliation between the lakehouse silver layer and the operational OMS."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_action_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Action Reference" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.outageCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage cause code"@en ;
    rdfs:comment "Standardized cause code for the fault or outage condition that necessitated this restoration action (e.g., equipment failure, tree contact, animal contact, storm, vehicle accident, planned maintenance). Aligns with IEEE 1366 cause code taxonomy. Reference-value candidates: equipment_failure|tree_contact|animal_contact|storm|vehicle_accident|planned_maintenance|unknown|other."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.regulatoryReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable"@en ;
    rdfs:comment "Indicates whether this restoration action is associated with an outage event that must be reported to a regulatory body (NERC, FERC, State PUC, or DOE). Drives inclusion in regulatory reliability reports and OE-417 emergency incident filings."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RestorationAction.scadaEventReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada event reference"@en ;
    rdfs:comment "Reference identifier linking this restoration action to the corresponding SCADA (Supervisory Control and Data Acquisition) event or alarm in OSIsoft PI historian. Enables correlation between OMS restoration records and real-time grid telemetry."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_event_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA Event Reference" ;
    cmm:cimDatatype "String" .
cmm:RestorationAction.toCrew a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to crew"@en ;
    rdfs:comment "FK to outage.crew_dispatch.crew_dispatch_id — Each restoration action is performed by a dispatched crew. Links action to the crew that executed it for accountability and performance tracking."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_crew" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.toCrewDispatch a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to crew dispatch"@en ;
    rdfs:comment "FK to outage.crew_dispatch.crew_dispatch_id — Restoration actions are performed by dispatched crews. This FK links the action to the crew that executed it, enabling crew performance tracking and accountability."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_crew_dispatch" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Every restoration action is performed within the context of an outage event. Required for step-by-step restoration tracking and ETR refinement."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RestorationAction.transferredLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transferred load mw"@en ;
    rdfs:comment "Magnitude of electrical load in Megawatts (MW) transferred from the faulted segment to an alternate feeder during a load transfer action. Used for grid capacity analysis and post-event load flow validation."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "transferred_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transferred Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:RestorationAction.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this restoration action record was last modified. Tracks updates to status, customer counts, or FLISR outcome fields throughout the restoration lifecycle."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RestorationAction.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) of the network segment on which this restoration action was performed (e.g., 4.16, 12.47, 34.5, 69, 115 kV). Used to classify the action within transmission vs. distribution tiers."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:RestorationAction.weatherConditionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition code"@en ;
    rdfs:comment "Weather condition code at the time of the outage event and restoration action. Used for storm-related reliability analysis, SAIDI/SAIFI major event day (MED) exclusion calculations, and regulatory storm reporting. Reference-value candidates: normal|wind|ice|lightning|flood|extreme_heat|other."@en ;
    rdfs:domain cmm:RestorationAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition Code" ;
    cmm:cimDatatype "String" .

cmm:OutageCause a owl:Class ;
    rdfs:label "Outage Cause"@en ;
    rdfs:comment "Reference classification of outage cause codes used to categorize the root cause of interruption events. Includes cause category (equipment failure, weather, vegetation, animal contact, human error, third-party damage, unknown), sub-cause code, NERC cause code mapping, PUC reportable flag, and whether the cause qualifies as a Major Event Day (MED) exclusion under IEEE 1366. Drives regulatory reporting and reliability analytics."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.cause" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "IEEE 1366 cause codes; Outage Cause Code (IEEE 1366 / NERC EOP)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.cause" ;
    owl:hasKey ( cmm:OutageCause.causeId ) .

cmm:OutageCause.causeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause id"@en ;
    rdfs:comment "Unique surrogate identifier for each outage cause code record in the reference classification table. Primary key. [REFERENCE_LOOKUP role — canonical_skip_reason: This entity is a reference/lookup table of cause codes; per-role minimum categories do not apply.]"@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:long ;
    cmm:physicalColumn "cause_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Cause ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCause.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Specific outage cause codes trigger different regulatory reporting obligations (e.g., vegetation management failures vs. equipment failures have different NERC reporting rules). Compliance teams map c"@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_cause_obligation_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:OutageCause.assetClassApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class applicability"@en ;
    rdfs:comment "Identifies the class(es) of utility assets to which this cause code applies (e.g., 'Overhead Distribution', 'Underground Transmission', 'Substation Equipment', 'Generation Unit'). Supports asset-cause correlation in reliability and asset management analytics."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class Applicability" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.causeCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause category"@en ;
    rdfs:comment "High-level grouping of the outage cause into standard industry categories. Drives SAIDI/SAIFI/CAIDI segmentation in reliability analytics and PUC regulatory reporting. Reference-value candidates: equipment_failure|weather|vegetation|animal_contact|human_error|third_party_damage|unknown."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Cause Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:OutageCause.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Alphanumeric code uniquely identifying the outage cause within the classification system. Used as the business-facing key in OMS, regulatory filings, and reliability reports. Sourced from GE PowerOn ADMS cause code configuration."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCause.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Full narrative description of the outage cause, including typical failure modes, contributing conditions, and examples. Used for training, documentation, and regulatory submissions."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Outage Cause Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:OutageCause.causeGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause group"@en ;
    rdfs:comment "Operational grouping of cause codes for internal reporting and benchmarking purposes (e.g., 'Overhead T&D', 'Underground T&D', 'Substation', 'Generation', 'External'). Supports drill-down analysis in reliability dashboards."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Group" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.causeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause name"@en ;
    rdfs:comment "Human-readable short name for the outage cause (e.g., 'Tree Contact', 'Equipment Failure - Transformer', 'Animal Contact'). Displayed in OMS dashboards and regulatory reports."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Outage Cause Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:OutageCause.causeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause status"@en ;
    rdfs:comment "Current lifecycle status of the cause code record. Active codes are available for OMS event classification; deprecated codes are retained for historical reporting only; pending_review codes are under regulatory or operational review."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cause Code Status" ;
    cmm:validValues "active|inactive|deprecated|pending_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:OutageCause.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this cause code record was first created in the data platform. Supports data lineage, audit trail, and change management for the reference classification table."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:OutageCause.crewTypeRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type required"@en ;
    rdfs:comment "Identifies the type of field crew typically required to restore outages of this cause (e.g., 'Line Crew', 'Cable Crew', 'Substation Technician', 'Tree Crew', 'Damage Assessment'). Supports automated crew dispatch recommendations in OMS."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type_required" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Crew Type" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.customerNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification required"@en ;
    rdfs:comment "Indicates whether outages with this cause trigger mandatory proactive customer notification obligations (e.g., via IVR, SMS, or email). Supports compliance with PUC customer communication requirements."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "The date from which this cause code is valid and available for use in outage event classification. Supports temporal versioning of the cause code reference table for historical reporting accuracy."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cause Code Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:OutageCause.epaCauseIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "epa cause indicator"@en ;
    rdfs:comment "Indicates whether the outage cause has environmental reporting implications under EPA regulations (e.g., spill events, emissions exceedances triggered by unplanned generation outages). Used for environmental compliance tracking."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "epa_cause_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Protection Agency (EPA) Cause Indicator" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.expiryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiry date"@en ;
    rdfs:comment "The date after which this cause code is no longer valid for new outage event classification. Null indicates the code is currently active with no planned expiry. Supports cause code lifecycle management and historical data integrity."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiry_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cause Code Expiry Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:OutageCause.ieee1366Category a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee 1366 category"@en ;
    rdfs:comment "Classification of the outage cause under IEEE Standard 1366 for electric power distribution reliability indices. Determines how interruptions associated with this cause are counted in SAIDI, SAIFI, and CAIDI calculations."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "ieee_1366_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Institute of Electrical and Electronics Engineers (IEEE) 1366 Interruption Category" ;
    cmm:validValues "sustained|momentary|major_event_day|planned|unknown" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.insuranceClaimable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance claimable"@en ;
    rdfs:comment "Indicates whether outage events attributed to this cause are eligible for insurance claim submission (e.g., storm damage, third-party damage). Supports financial recovery tracking and CAPEX/OPEX classification."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "insurance_claimable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Claimable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isControllable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is controllable"@en ;
    rdfs:comment "Indicates whether the outage cause is considered controllable by the utility (i.e., preventable through operational or maintenance actions). Used in reliability improvement program targeting and PUC performance benchmarking."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_controllable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controllable Cause Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isDoeReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is doe reportable"@en ;
    rdfs:comment "Indicates whether outage events with this cause require submission to the U.S. Department of Energy via the OE-417 Electric Emergency Incident and Disturbance Report. True = DOE OE-417 filing required."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_doe_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Energy (DOE) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isMedExclusion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is med exclusion"@en ;
    rdfs:comment "Indicates whether outage events attributed to this cause qualify for exclusion from SAIDI/SAIFI/CAIDI baseline calculations as a Major Event Day (MED) under IEEE 1366. True = MED-eligible exclusion; False = included in standard reliability indices."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_med_exclusion" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isMomentary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is momentary"@en ;
    rdfs:comment "Indicates whether this cause code is associated with momentary interruptions (duration less than 5 minutes per IEEE 1366). Momentary events are tracked separately in MAIFI (Momentary Average Interruption Frequency Index) calculations."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_momentary" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Cause Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isNercReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is nerc reportable"@en ;
    rdfs:comment "Indicates whether outage events attributed to this cause trigger mandatory NERC event reporting obligations (e.g., EOP-004 threshold events). True = NERC reporting required; False = not required."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_nerc_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isPlanned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is planned"@en ;
    rdfs:comment "Indicates whether this cause code applies to planned (scheduled) outages rather than unplanned interruptions. Planned outages are excluded from SAIDI/SAIFI/CAIDI calculations per IEEE 1366. True = planned; False = unplanned."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_planned" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Cause Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isPucReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is puc reportable"@en ;
    rdfs:comment "Indicates whether outage events with this cause must be reported to the state Public Utility Commission (PUC) under applicable regulatory reporting requirements. True = mandatory PUC notification required; False = not required."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_puc_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.isWeatherRelated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is weather related"@en ;
    rdfs:comment "Indicates whether the outage cause is classified as weather-related. Drives storm response analytics, MED determination, and insurance/force-majeure reporting. Distinct from the cause_category field as some sub-causes may be weather-adjacent."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_weather_related" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather-Related Cause Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.nercCauseCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cause category"@en ;
    rdfs:comment "NERC-defined top-level cause category label corresponding to the nerc_cause_code. Supports direct mapping to NERC event reporting taxonomy without requiring a separate lookup. Examples: 'Electrical', 'Environmental', 'Human Error', 'Other'."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Cause Category" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.nercCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cause code"@en ;
    rdfs:comment "Standardized cause code as defined by NERC for transmission and bulk electric system outage reporting. Required for NERC event reporting (EOP-004) and DOE OE-417 submissions. Maps the internal cause code to the NERC taxonomy."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Cause Code" ;
    cmm:valuePattern "^[A-Z0-9]{1,10}$" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.omsCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms cause code"@en ;
    rdfs:comment "The native cause code identifier as configured in the GE PowerOn ADMS/OMS system. Used for direct system integration, data lineage tracing, and reconciliation between the silver layer and the source OMS."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Cause Code" ;
    cmm:valuePattern "^[A-Z0-9_]{1,20}$" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.pucCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc cause code"@en ;
    rdfs:comment "The cause code as defined in the applicable state Public Utility Commission (PUC) reporting taxonomy. Required for annual reliability reports and service quality filings. May differ from internal cause_code."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Cause Code" ;
    cmm:valuePattern "^[A-Z0-9_]{1,20}$" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.regulatoryReportingNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting notes"@en ;
    rdfs:comment "Free-text field capturing specific regulatory reporting instructions, exceptions, or conditions associated with this cause code. Used by compliance teams to document PUC, NERC, or DOE reporting nuances for this cause."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_reporting_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Reporting Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OutageCause.reliabilityIndexImpact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index impact"@en ;
    rdfs:comment "Identifies which reliability performance indices (SAIDI, SAIFI, CAIDI, MAIFI) are impacted by outage events attributed to this cause. Drives automated index calculation logic in the reliability analytics platform."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "reliability_index_impact" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reliability Index Impact" ;
    cmm:validValues "saidi|saifi|caidi|maifi|all|none" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.saidiWeightFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi weight factor"@en ;
    rdfs:comment "Numeric weighting factor applied to SAIDI calculations for outages of this cause type. Allows regulatory-mandated cause-specific weighting adjustments in reliability index computations. Default is 1.0 (no adjustment)."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_weight_factor" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Weight Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:OutageCause.sortOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sort order"@en ;
    rdfs:comment "Numeric value controlling the display sequence of cause codes in OMS dropdown lists, regulatory report templates, and analytics dashboards. Lower values appear first."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:int ;
    cmm:physicalColumn "sort_order" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Display Sort Order" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCause.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifies the operational system of record from which this cause code was sourced or synchronized (e.g., GE PowerOn ADMS, SAP IS-U). Supports data lineage and reconciliation in the Databricks silver layer."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "GE_PowerOn_ADMS|SAP_ISU|Oracle_CCB|Manual|Other" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.subCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sub cause code"@en ;
    rdfs:comment "Secondary classification code providing finer granularity within a cause category (e.g., within 'equipment_failure': transformer, cable, switch, fuse). Enables detailed root-cause analysis and asset failure trending."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "sub_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Sub-Cause Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,30}$" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.subCauseName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sub cause name"@en ;
    rdfs:comment "Human-readable label for the sub-cause code (e.g., 'Overhead Conductor', 'Underground Cable Fault', 'Fuse Operation'). Used in OMS event classification and crew dispatch workflows."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "sub_cause_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Sub-Cause Name" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.switchingOrderRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order required"@en ;
    rdfs:comment "Indicates whether outages attributed to this cause typically require a formal switching order to be issued before restoration work can begin. Drives workflow automation in OMS switching order management."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "switching_order_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Order Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.thirdPartyLiabilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "third party liability flag"@en ;
    rdfs:comment "Indicates whether outages attributed to this cause may involve third-party liability (e.g., contractor damage, vehicle contact, excavation damage). Triggers claims management and legal notification workflows."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "third_party_liability_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Third-Party Liability Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCause.typicalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "typical duration minutes"@en ;
    rdfs:comment "Historical average or benchmark restoration duration in minutes for outages attributed to this cause. Used for crew dispatch planning, customer estimated restoration time (ERT) communications, and CAIDI benchmarking."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:int ;
    cmm:physicalColumn "typical_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Typical Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutageCause.typicalRestorationPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "typical restoration priority"@en ;
    rdfs:comment "Default restoration priority level associated with outages of this cause type. Used to pre-populate restoration prioritization workflows in OMS and crew dispatch systems. Overridable at the individual outage event level."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "typical_restoration_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Typical Restoration Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:OutageCause.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to this cause code record. Used for incremental data pipeline processing, change detection, and audit compliance."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageCause.versionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version number"@en ;
    rdfs:comment "Incremental version number tracking revisions to the cause code definition, category mapping, or regulatory alignment. Supports audit trail and change management for the reference classification table."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:int ;
    cmm:physicalColumn "version_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cause Code Version Number" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Document.revisionNumber .
cmm:OutageCause.voltageLevelApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level applicability"@en ;
    rdfs:comment "Indicates the voltage level(s) at which this cause code is applicable: transmission (>= 115 kV), sub-transmission, distribution (< 35 kV), or all levels. Ensures correct cause code assignment during OMS event classification."@en ;
    rdfs:domain cmm:OutageCause ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level Applicability" ;
    cmm:validValues "transmission|sub_transmission|distribution|all" ;
    cmm:cimDatatype "String" .

cmm:PlannedOutageWindow a owl:Class ;
    rdfs:label "Planned Outage Window"@en ;
    rdfs:comment "Scheduled planned outage window for maintenance, construction, or upgrade activities requiring deliberate de-energization of network segments. Captures planned start and end times, affected feeder/circuit, work order reference, customer notification requirement, advance notice period, regulatory filing requirement, and actual vs. planned duration variance. Distinct from unplanned outage events — has its own approval and notification workflow."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PlannedOutage ;
    cmm:cimCloseMatch cim:PlannedOutage ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.planned_outage_window" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-3; Planned Outage (GE PowerOn ADMS / Ventyx Asset Suite Work Management)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.planned_outage_window" ;
    owl:hasKey ( cmm:PlannedOutageWindow.plannedOutageWindowId ) .

cmm:PlannedOutageWindow.plannedOutageWindowId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage window id"@en ;
    rdfs:comment "Primary key for planned_outage_window"@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:long ;
    cmm:physicalColumn "planned_outage_window_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Planned Outage Window Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PlannedOutageWindow.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation from which the affected feeder or circuit originates. Used for switching coordination, crew dispatch, and geographic impact analysis."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_planned_outage_window_distribution_substation_id" ;
    cmm:cimAssociation "PlannedOutage.Substation" .
cmm:PlannedOutageWindow.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the primary distribution feeder or circuit segment to be de-energized during the planned outage window. Sourced from the GIS network model (Esri ArcGIS Utility Network) and used for switching order generation."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Circuit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_planned_outage_window_feeder_id" ;
    cmm:cimAssociation "PlannedOutage.Feeder" .
cmm:PlannedOutageWindow.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Tariff rules require notifying customers with pending interconnection applications of planned outages affecting their POI. Coordination prevents construction conflicts and ensures applicants can sched"@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_planned_outage_window_interconnection_application_id" ;
    cmm:cimAssociation "PlannedOutage.Request" .
cmm:PlannedOutageWindow.omsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "oms event"@en ;
    rdfs:comment "Identifier of the corresponding event record in the Outage Management System (OMS), such as GE PowerOn ADMS. Provides traceability between the planned outage window record and the operational OMS event for reconciliation and audit."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "oms_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Management System (OMS) Event ID" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_planned_outage_window_oms_event_id" ;
    cmm:cimAssociation "PlannedOutage.Outage" .
cmm:PlannedOutageWindow.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to customer.premise. Business justification: Planned maintenance windows often target specific premises for equipment upgrades, service line work, or meter replacements. Utilities must track affected premises for advance customer notification (r"@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_planned_outage_window_premise_id" ;
    cmm:cimAssociation "PlannedOutage.ServiceLocation" .
cmm:PlannedOutageWindow.actualDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual duration minutes"@en ;
    rdfs:comment "Actual duration of the de-energization in minutes, recorded upon restoration. Used to compute duration variance against planned_duration_minutes and to feed SAIDI/SAIFI/CAIDI reliability indices."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PlannedOutageWindow.actualEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end timestamp"@en ;
    rdfs:comment "Actual date and time at which the network segment was re-energized and service restored. Used to compute actual outage duration and variance against planned duration for SAIDI/SAIFI/CAIDI performance reporting."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Re-energization End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time at which the network segment was de-energized. Compared against planned_start_timestamp to compute schedule variance for reliability reporting and SAIDI/SAIFI tracking."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual De-energization Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.advanceNoticePeriodHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "advance notice period hours"@en ;
    rdfs:comment "Minimum advance notice period in hours required before the planned outage commences, as mandated by state PUC tariff rules or internal SLA policy. Drives the customer notification scheduling workflow."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "advance_notice_period_hours" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advance Notice Period (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:PlannedOutageWindow.affectedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer count"@en ;
    rdfs:comment "Estimated number of customer service points (meters) that will experience interruption during the planned outage window. Used for customer notification prioritization, regulatory reporting, and SAIFI impact assessment."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:PlannedOutageWindow.alternateFeedAvailable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alternate feed available"@en ;
    rdfs:comment "Indicates whether an alternate supply path exists to maintain service to some or all affected customers during the planned outage window. Informs restoration strategy and customer notification messaging."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "alternate_feed_available" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alternate Feed Available Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Approval workflow status for the planned outage window, tracking whether the request has been reviewed and authorized by the appropriate operations or grid control authority before execution."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Window Approval Status" ;
    cmm:validValues "pending|approved|rejected|withdrawn" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Identifier or name of the operations supervisor, grid control authority, or system operator who authorized the planned outage window. Required for audit trail and NERC compliance documentation."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By (Employee ID or Name)" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time at which the planned outage window received formal authorization from the approving authority. Part of the approval audit trail required for NERC and PUC compliance."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time at which the planned outage window record was first created in the system. Used for audit trail, workflow SLA tracking, and advance notice compliance verification."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PlannedOutage.createdDateTime .
cmm:PlannedOutageWindow.criticalCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical customer count"@en ;
    rdfs:comment "Number of critical or life-support customers (medical baseline, hospitals, emergency services) within the affected area. Drives mandatory advance notification requirements and restoration prioritization per PUC rules."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "critical_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:PlannedOutageWindow.customerNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification required"@en ;
    rdfs:comment "Indicates whether customer advance notification is required for this planned outage window based on PUC tariff rules, affected customer count thresholds, or presence of critical customers."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.customerNotificationSent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification sent"@en ;
    rdfs:comment "Indicates whether the required customer advance notification has been dispatched for this planned outage window. Used for compliance tracking and audit trail against PUC notification obligations."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_sent" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.durationVarianceMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration variance minutes"@en ;
    rdfs:comment "Difference between actual and planned outage duration in minutes (actual_duration_minutes minus planned_duration_minutes). Positive values indicate overrun; negative values indicate early restoration. Key metric for reliability performance reporting."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_variance_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration Variance (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PlannedOutageWindow.estimatedLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated load mw"@en ;
    rdfs:comment "Estimated peak load in megawatts (MW) that will be interrupted during the planned outage window. Used for grid stability assessment, load transfer planning, and RTO/ISO notification thresholds."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Interrupted Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PlannedOutageWindow.geographicRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic region"@en ;
    rdfs:comment "Geographic region or district within the service territory where the planned outage is located (e.g., North District, Urban Core, Rural East). Used for crew dispatch routing and regional reliability reporting."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Region" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time at which the planned outage window record was most recently modified. Used for change tracking, data lineage, and Silver layer incremental processing."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PlannedOutageWindow.loadTransferRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transfer required"@en ;
    rdfs:comment "Indicates whether load transfer switching is required to maintain service to customers via alternate feed paths during the planned outage window. Triggers switching order generation and crew coordination."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "load_transfer_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transfer Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "Primary channel used to deliver the planned outage advance notification to affected customers (e.g., IVR automated call, SMS, email, postal mail, online portal, or field visit for critical customers)."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Channel" ;
    cmm:validValues "ivr|sms|email|mail|portal|field_visit" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.notificationSentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent timestamp"@en ;
    rdfs:comment "Date and time at which the customer advance notification was dispatched. Used to verify compliance with the required advance_notice_period_hours and to support PUC audit inquiries."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_sent_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.outageCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage cause code"@en ;
    rdfs:comment "Standardized cause code classifying the reason for the planned de-energization (e.g., scheduled maintenance, capital project, vegetation management, equipment replacement). Aligns with IEEE 1366 cause code taxonomy for reliability reporting. Reference-value candidates: scheduled_maintenance|capital_project|vegetation_management|equipment_replacement|inspection|testing|new_connection."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.outageReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage reference number"@en ;
    rdfs:comment "Externally-known business identifier for the planned outage window, used in customer notifications, regulatory filings, and OMS records. Format: POW-{YYYY}-{NNNNNN}."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Planned Outage Window Reference Number" ;
    cmm:valuePattern "^POW-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PlannedOutageWindow.outageWindowStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage window status"@en ;
    rdfs:comment "Current lifecycle state of the planned outage window through its approval and execution workflow. Tracks progression from initial draft through approval, active execution, and final completion or cancellation."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_window_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Planned Outage Window Status" ;
    cmm:validValues "draft|pending_approval|approved|in_progress|completed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PlannedOutage.status .
cmm:PlannedOutageWindow.outageWindowType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage window type"@en ;
    rdfs:comment "Classification of the planned outage window by the nature of the work activity requiring de-energization. Drives notification requirements, crew dispatch, and regulatory filing obligations. Reference-value candidates: maintenance|construction|upgrade|inspection|testing|emergency_planned|commissioning|decommissioning."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_window_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Planned Outage Window Type" ;
    cmm:validValues "maintenance|construction|upgrade|inspection|testing|emergency_planned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PlannedOutage.type .
cmm:PlannedOutageWindow.plannedDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned duration minutes"@en ;
    rdfs:comment "Planned duration of the de-energization window in minutes, derived from planned start and end timestamps at scheduling time. Stored explicitly for scheduling, crew planning, and customer notification purposes."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:int ;
    cmm:physicalColumn "planned_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PlannedOutageWindow.plannedEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned end timestamp"@en ;
    rdfs:comment "Scheduled date and time at which the network segment is planned to be re-energized and service restored. Used to calculate planned outage duration and customer notification windows."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Re-energization End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.plannedStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned start timestamp"@en ;
    rdfs:comment "Scheduled date and time at which the network segment is planned to be de-energized to begin the maintenance or construction activity. Used for customer advance notification and crew scheduling."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned De-energization Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PlannedOutageWindow.plannedWindowToOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned window to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — When a planned outage window is executed, it creates an outage event. Links planned scheduling to actual execution for variance tracking."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:long ;
    cmm:physicalColumn "planned_window_to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PlannedOutageWindow.regulatoryFilingReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing reference"@en ;
    rdfs:comment "Reference number or docket number of the regulatory filing submitted to the PUC, NERC, or FERC for this planned outage. Populated only when regulatory_filing_required is true."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_filing_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Filing Reference Number" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.regulatoryFilingRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing required"@en ;
    rdfs:comment "Indicates whether this planned outage window requires a formal regulatory filing with the state PUC, NERC, or FERC prior to execution (e.g., for high-voltage transmission outages or outages affecting critical infrastructure)."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_filing_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Filing Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.requestedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested by"@en ;
    rdfs:comment "Identifier or name of the employee, crew supervisor, or project manager who submitted the planned outage window request. Used for accountability tracking and workflow routing."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "requested_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested By (Employee ID or Name)" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.requestingDepartment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting department"@en ;
    rdfs:comment "Name or code of the business unit or department (e.g., T&D Engineering, Asset Management, Construction) that initiated the planned outage window request. Used for resource allocation and OPEX/CAPEX tracking."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_department" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requesting Department" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.rtoIsoNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso notification required"@en ;
    rdfs:comment "Indicates whether the planned outage must be reported to the Regional Transmission Organization (RTO) or Independent System Operator (ISO) due to transmission-level impact or market implications under NERC/FERC requirements."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rto_iso_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO/ISO Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.rtoIsoOutageCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso outage code"@en ;
    rdfs:comment "Outage coordination identifier assigned by the RTO or ISO (e.g., MISO, PJM, CAISO) when the planned outage is registered in the transmission outage coordination system. Populated only when rto_iso_notification_required is true."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_outage_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO/ISO Outage Coordination ID" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "Contribution of this planned outage window to the annual System Average Interruption Duration Index (SAIDI) in customer-minutes per customer served. Calculated as (actual_duration_minutes × affected_customer_count) / total_customers_served. Used for IEEE 1366 reliability reporting."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PlannedOutageWindow.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "Contribution of this planned outage window to the annual System Average Interruption Frequency Index (SAIFI), calculated as affected_customer_count / total_customers_served. Used for IEEE 1366 reliability performance reporting to PUC."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:PlannedOutageWindow.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the regulated service territory within which the planned outage window occurs. Used for PUC jurisdictional reporting, rate case filings, and geographic performance analysis."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this planned outage window is associated with a declared storm or major event, which may qualify for IEEE 1366 major event day (MED) exclusion from SAIDI/SAIFI reliability index calculations."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlannedOutageWindow.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Reference number of the switching order issued in the ADMS or OMS to execute the de-energization and re-energization sequence for this planned outage window. Links to the operational switching workflow."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PlannedOutageWindow.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Planned maintenance windows result in planned outage events. This FK links the scheduling/approval workflow to the actual outage event record."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PlannedOutageWindow.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage level in kilovolts (kV) of the network segment being de-energized. Determines safety protocols, crew qualifications, and regulatory notification thresholds."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:PlannedOutageWindow.workDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work description"@en ;
    rdfs:comment "Free-text description of the maintenance, construction, or upgrade activity to be performed during the planned outage window. Provides context for crew briefings, customer communications, and regulatory filings."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Activity Description" ;
    cmm:cimDatatype "String" .
cmm:PlannedOutageWindow.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Reference number of the associated work order in the asset management or ERP system (e.g., SAP S/4HANA PM or Ventyx Asset Suite) that drives the maintenance, construction, or upgrade activity requiring de-energization."@en ;
    rdfs:domain cmm:PlannedOutageWindow ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:AffectedCustomer a owl:Class ;
    rdfs:label "Affected Customer"@en ;
    rdfs:comment "Association record linking a specific customer service point to an outage event or planned maintenance window, capturing the customer-level impact. Records customer account reference, service point identifier, interruption start and end times, duration, notification sent flag, notification channel, critical care flag (medical baseline, life support), and restoration confirmation. Enables customer-facing outage communication and regulatory customer impact reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.customer_communication ;
    cmm:physicalTable "utility_cmm_silver.outage.affected_customer" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Outage Customer Impact (Oracle CC&B / SAP IS-U OMS Integration)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.affected_customer" ;
    owl:hasKey ( cmm:AffectedCustomer.affectedCustomerId ) .

cmm:AffectedCustomer.affectedCustomerId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer id"@en ;
    rdfs:comment "Unique surrogate identifier for the affected customer association record linking a customer service point to an outage or planned maintenance event."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:long ;
    cmm:physicalColumn "affected_customer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Affected Customer ID" ;
    cmm:cimDatatype "Integer" .
cmm:AffectedCustomer.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Foreign key linking to billing.billing_service_agreement. Business justification: Affected customer records need service agreement link to determine applicable credit/adjustment rules, verify eligibility for outage compensation programs, and ensure credits are posted to correct bil"@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_billing_service_agreement_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAgreement" .
cmm:AffectedCustomer.complianceException a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance exception"@en ;
    rdfs:comment "Foreign key linking to compliance.exception. Business justification: Critical care customers experiencing outages may trigger compliance exceptions if notification protocols weren't followed per regulatory requirements. Compliance monitors critical customer outages for"@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:ComplianceException ;
    cmm:physicalColumn "compliance_exception_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Exception Id (Foreign Key)" ;
    cmm:sourceColumn "exception_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_compliance_exception_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:AffectedCustomer.customerAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer account"@en ;
    rdfs:comment "Reference to the customer account record in the Customer Information System (CIS). Sourced from SAP IS-U or Oracle CC&B customer account master."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "customer_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_customer_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:AffectedCustomer.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Tracks DER-owning customers experiencing outages for NEM credit adjustments (energy not exported during outage), performance guarantee calculations, and regulatory reporting (CPUC Rule 21 requires tra"@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_der_system_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerElectronicsConnection" .
cmm:AffectedCustomer.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation serving this customer service point at the time of the outage. Used for substation-level reliability performance reporting and asset management correlation."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_distribution_substation_id" ;
    cmm:cimAssociation "IdentifiedObject.Substation" .
cmm:AffectedCustomer.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage or planned maintenance event that caused this customer interruption. Links to the outage event record in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_event_id" ;
    cmm:cimAssociation "IdentifiedObject.Outage" .
cmm:AffectedCustomer.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit serving this customer service point at the time of the outage. Used for feeder-level reliability analysis and SAIDI/SAIFI segmentation."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_feeder_id" ;
    cmm:cimAssociation "IdentifiedObject.Feeder" .
cmm:AffectedCustomer.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Foreign key linking to billing.invoice. Business justification: When customers are affected by outages, credits are applied to specific invoices; direct link streamlines adjustment posting, enables invoice-level outage credit tracking for regulatory reporting, and"@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_invoice_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerBillingInfo" .
cmm:AffectedCustomer.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the meter installed at the affected service point. Used to correlate outage impact with Advanced Metering Infrastructure (AMI) last-gasp signals and meter data."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_meter_id" ;
    cmm:cimAssociation "IdentifiedObject.Meter" .
cmm:AffectedCustomer.outageCrewDispatch a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage crew dispatch"@en ;
    rdfs:comment "Reference to the crew dispatch or work order assigned to restore power at this customer service point. Links to the field crew assignment in the OMS or Work Management System."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:OutageCrewDispatch ;
    cmm:physicalColumn "outage_crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_outage_crew_dispatch_id" ;
    cmm:cimAssociation "IdentifiedObject.FieldDispatchHistory" .
cmm:AffectedCustomer.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the switching order or planned maintenance work order that caused this customer interruption. Populated for planned outages; null for unplanned events."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_outage_switching_order_id" ;
    cmm:cimAssociation "IdentifiedObject.SwitchingPlan" .
cmm:AffectedCustomer.servicePoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service point"@en ;
    rdfs:comment "Reference to the specific service point (premise delivery point) associated with this customer interruption. Corresponds to the service point or premise identifier in the CIS and GIS."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:ServicePoint ;
    cmm:physicalColumn "service_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_service_point_id" ;
    cmm:cimAssociation "IdentifiedObject.UsagePoint" .
cmm:AffectedCustomer.troubleCall a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trouble call"@en ;
    rdfs:comment "Reference identifier for the customer trouble call or service request that reported this outage, as recorded in the Customer Information System (CIS) or CRM. Populated when customer_reported_flag is True."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range cmm:OutageCall ;
    cmm:physicalColumn "trouble_call_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trouble Call ID" ;
    cmm:sourceColumn "call_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_affected_customer_trouble_call_id" ;
    cmm:cimAssociation "IdentifiedObject.TroubleTicket" .
cmm:AffectedCustomer.accountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account number"@en ;
    rdfs:comment "The externally-known customer account number as assigned by the Customer Information System (CIS). Used for customer-facing communications and regulatory impact reporting."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Customer Account Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AffectedCustomer.advanceNoticeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "advance notice hours"@en ;
    rdfs:comment "Number of hours of advance notice provided to this customer prior to a planned interruption. Used to verify compliance with PUC minimum advance notification requirements for planned outages (typically 48–72 hours)."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "advance_notice_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advance Notice Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:AffectedCustomer.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized cause code classifying the root cause of the outage affecting this customer (e.g., equipment failure, tree contact, animal contact, weather, vehicle accident). Sourced from OMS cause code taxonomy aligned with EEI/NERC reporting categories. Reference-value candidates: equipment_failure|tree_contact|animal_contact|weather|vehicle_accident|scheduled_maintenance|unknown|other."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this affected customer association record was first created in the system, typically when the outage event was declared and customer impact was identified by the OMS."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:AffectedCustomer.criticalCareFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical care flag"@en ;
    rdfs:comment "Indicates whether the customer at this service point is registered as a critical care or life support customer (e.g., medical baseline, home oxygen, dialysis). Critical care customers receive priority restoration and mandatory advance notification per PUC regulations."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_care_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Care Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.criticalCareType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical care type"@en ;
    rdfs:comment "Specific type of critical care or life support designation for the affected customer. Populated only when critical_care_flag is True. Classified as restricted health information per HIPAA and state PUC medical baseline program rules."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "critical_care_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Care Type" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_health" ;
    cmm:validValues "medical_baseline|life_support|home_oxygen|dialysis|other" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.customerClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer class"@en ;
    rdfs:comment "Regulatory and rate classification of the customer affected by the outage. Used for segmented reliability reporting and prioritization of restoration efforts per PUC requirements."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|municipal" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.customerReportedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer reported flag"@en ;
    rdfs:comment "Indicates whether this outage was identified through a customer trouble call or self-reported via web/app, as opposed to being detected automatically via AMI last-gasp, SCADA, or OMS prediction. Used for outage detection source analysis."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_reported_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Reported Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Identifies the operational source system from which this affected customer record was ingested into the Silver Layer lakehouse. Used for data lineage, reconciliation, and audit purposes."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:validValues "GE_PowerOn_ADMS|SAP_ISU|Oracle_CCB|Oracle_MDM|ArcGIS|manual" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.derCustomerFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der customer flag"@en ;
    rdfs:comment "Indicates whether the affected customer has a registered Distributed Energy Resource (DER) such as rooftop solar, battery storage, or a Net Energy Metering (NEM) arrangement. Relevant for assessing behind-the-meter (BTM) resilience and grid impact during outages."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_customer_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "The estimated date and time of power restoration communicated to this customer. Corresponds to the Estimated Restoration Time (ERT) published in customer-facing outage communications and OMS crew dispatch workflows."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Timestamp (ERT)" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.interruptionDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption duration minutes"@en ;
    rdfs:comment "Total duration of the power interruption at this customer service point in minutes, calculated from interruption start to end timestamp. Used directly in SAIDI (System Average Interruption Duration Index) and CAIDI (Customer Average Interruption Duration Index) regulatory reporting."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:int ;
    cmm:physicalColumn "interruption_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:AffectedCustomer.interruptionEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption end timestamp"@en ;
    rdfs:comment "The date and time when power supply was restored at this customer service point. Null if restoration has not yet occurred. Used in SAIDI/CAIDI duration calculations."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interruption_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.interruptionStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruption start timestamp"@en ;
    rdfs:comment "The date and time when power supply was interrupted at this customer service point. Used as the principal business event timestamp for SAIDI/SAIFI/CAIDI reliability index calculations and regulatory reporting."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interruption_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruption Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time when this affected customer association record was most recently modified, such as when restoration status was updated, notification was sent, or duration was recalculated."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AffectedCustomer.majorEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event flag"@en ;
    rdfs:comment "Indicates whether this customer interruption is associated with a declared Major Event Day (MED) per IEEE 1366 criteria. Major event interruptions are excluded from standard SAIDI/SAIFI calculations and reported separately to regulators."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.momentaryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "momentary flag"@en ;
    rdfs:comment "Indicates whether this interruption is classified as a momentary interruption (duration under 5 minutes per IEEE 1366 definition). Momentary interruptions are counted in MAIFI (Momentary Average Interruption Frequency Index) rather than SAIDI/SAIFI."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "momentary_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "The communication channel used to deliver the outage notification to this customer (e.g., SMS text, email, Interactive Voice Response (IVR) call, mobile app push notification). Supports multi-channel outage communication tracking."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Channel" ;
    cmm:validValues "sms|email|ivr|app_push|none" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Indicates whether an outage notification has been sent to this customer for the associated outage event. Used to track compliance with PUC customer notification requirements."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "The date and time when the outage notification was sent to this customer. Used for regulatory compliance reporting on customer notification timeliness."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.omsCustomerRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms customer ref"@en ;
    rdfs:comment "External customer reference identifier as recorded in the Outage Management System (OMS), used for cross-system reconciliation between OMS and CIS records."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_customer_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Customer Reference" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event type affecting this customer. 'unplanned' = unexpected fault-driven interruption, 'planned' = scheduled maintenance window, 'momentary' = interruption under 5 minutes per IEEE 1366, 'major_event' = declared major event excluded from standard reliability indices."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "unplanned|planned|momentary|major_event" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.plannedInterruptionEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned interruption end timestamp"@en ;
    rdfs:comment "The originally scheduled end time of the planned maintenance interruption for this customer service point. Populated only for planned outages. Compared against actual interruption_end_timestamp for schedule adherence reporting."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_interruption_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Interruption End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.plannedInterruptionStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned interruption start timestamp"@en ;
    rdfs:comment "The originally scheduled start time of the planned maintenance interruption for this customer service point. Populated only for planned outages. Compared against actual interruption_start_timestamp for schedule adherence reporting."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_interruption_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Interruption Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AffectedCustomer.regulatoryExclusionReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory exclusion reason"@en ;
    rdfs:comment "Reason code indicating why this customer interruption is excluded from standard IEEE 1366 reliability index calculations. 'major_event' = IEEE 1366 MED exclusion, 'planned' = scheduled maintenance exclusion, 'momentary' = under 5-minute threshold, 'none' = included in standard indices."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_exclusion_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Exclusion Reason" ;
    cmm:validValues "major_event|planned|momentary|none" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.restorationConfirmationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration confirmation method"@en ;
    rdfs:comment "The method by which power restoration was confirmed at this customer service point. 'ami_signal' = AMI meter power-on event, 'crew_verification' = field crew confirmation, 'customer_callback' = customer reported power restored, 'scada' = SCADA system indication."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_confirmation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Confirmation Method" ;
    cmm:validValues "ami_signal|crew_verification|customer_callback|scada|none" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.restorationConfirmedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration confirmed flag"@en ;
    rdfs:comment "Indicates whether power restoration at this customer service point has been confirmed, either via AMI last-gasp/power-on signal, crew field verification, or customer callback. Distinguishes crew-reported restoration from confirmed restoration."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "restoration_confirmed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Confirmed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AffectedCustomer.restorationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration status"@en ;
    rdfs:comment "Current restoration lifecycle status for this customer service point. 'interrupted' = power out, 'restored' = power confirmed back, 'partial' = partial restoration, 'pending_confirmation' = crew reports restored but not yet confirmed, 'excluded' = excluded from reliability indices per IEEE 1366 major event criteria."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Status" ;
    cmm:validValues "interrupted|restored|partial|pending_confirmation|excluded" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "This customer's individual contribution to the SAIDI reliability index in customer-minutes. Equals the interruption duration in minutes for this customer record. Aggregated across all affected customers to compute system-level SAIDI per IEEE 1366."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:AffectedCustomer.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "This customer's individual contribution to the SAIFI reliability index (value of 1 per sustained interruption, 0 for momentary). Aggregated across all affected customers to compute system-level SAIFI per IEEE 1366."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:AffectedCustomer.servicePointNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service point number"@en ;
    rdfs:comment "The externally-known alphanumeric identifier for the customer service point (premise delivery point) where the interruption occurred. Used in field crew dispatch and restoration confirmation."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_point_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Point Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AffectedCustomer.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the regulated service territory in which this customer service point is located. Used for jurisdictional reliability reporting to the applicable State Public Utility Commission (PUC)."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:AffectedCustomer.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this customer interruption occurred during a declared storm or major weather event. Used for storm response performance reporting and potential major event day exclusion analysis."@en ;
    rdfs:domain cmm:AffectedCustomer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:CustomerNotification a owl:Class ;
    rdfs:label "Customer Notification"@en ;
    rdfs:comment "Record of outage-related notifications sent to customers via IVR, SMS, email, or mobile app. Captures notification type (outage alert, ETR update, restoration confirmation, planned outage advance notice), channel, delivery timestamp, delivery status, customer preference reference, and opt-out flag. Supports regulatory requirements for advance notice of planned outages and tracks communication SLA compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CustomerNotification ;
    cmm:cimCloseMatch cim:CustomerNotification ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.customer_communication ;
    cmm:physicalTable "utility_cmm_silver.outage.customer_notification" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-8; Customer Outage Notification (Oracle CC&B / CIS Integration)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.customer_notification" ;
    owl:hasKey ( cmm:CustomerNotification.customerNotificationId ) .

cmm:CustomerNotification.customerNotificationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification id"@en ;
    rdfs:comment "Unique surrogate identifier for each customer notification record in the outage management system. Primary key for the customer_notification data product."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:long ;
    cmm:physicalColumn "customer_notification_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Customer Notification ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerNotification.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account receiving this notification. Sourced from the Customer Information System (CIS) in SAP IS-U or Oracle CC&B."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_account_id" ;
    cmm:cimAssociation "CustomerNotification.CustomerAccount" .
cmm:CustomerNotification.customerPreference a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer preference"@en ;
    rdfs:comment "Reference to the customer's communication preference profile that governed channel selection and opt-in/opt-out status at the time this notification was generated. Enables preference-driven communication auditing."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:NotificationPreference ;
    cmm:physicalColumn "customer_preference_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Communication Preference ID" ;
    cmm:sourceColumn "notification_preference_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_customer_preference_id" ;
    cmm:cimAssociation "CustomerNotification.CustomerNotification" .
cmm:CustomerNotification.etrRevision a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "etr revision"@en ;
    rdfs:comment "FK to outage.etr_revision.etr_revision_id — ETR update notifications are triggered by ETR revisions. This FK enables audit trail from revision to customer communication."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:EtrRevision ;
    cmm:physicalColumn "etr_revision_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_etr_revision_id" ;
    cmm:cimAssociation "CustomerNotification.EstimatedRestorationTime" .
cmm:CustomerNotification.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event that triggered this notification. Links the notification to the specific unplanned interruption or planned maintenance window in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_event_id" ;
    cmm:cimAssociation "CustomerNotification.Outage" .
cmm:CustomerNotification.messageTemplate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "message template"@en ;
    rdfs:comment "Reference to the approved message template used to compose this notification. Templates are pre-approved for regulatory compliance and brand consistency. Enables template performance analytics and A/B testing of communication effectiveness."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:MessageTemplate ;
    cmm:physicalColumn "message_template_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Message Template ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_message_template_id" ;
    cmm:cimAssociation "CustomerNotification.Document" .
cmm:CustomerNotification.servicePoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service point"@en ;
    rdfs:comment "Reference to the specific service delivery point (premise) affected by the outage for which this notification was issued. Enables geographic and network-level analysis of notification coverage."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range cmm:ServicePoint ;
    cmm:physicalColumn "service_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_customer_notification_service_point_id" ;
    cmm:cimAssociation "CustomerNotification.UsagePoint" .
cmm:CustomerNotification.acknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledgment timestamp"@en ;
    rdfs:comment "Timestamp when the customer acknowledged receipt of this notification. Null if no acknowledgment was received. Used for life-support welfare check compliance and two-way communication analytics."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.advanceNoticeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "advance notice hours"@en ;
    rdfs:comment "Number of hours of advance notice provided to the customer prior to a planned outage, calculated as the difference between notification sent timestamp and planned outage start timestamp. Used to verify compliance with state PUC minimum advance notice requirements (typically 48–72 hours)."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "advance_notice_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advance Notice Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:CustomerNotification.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Human-readable description of the outage cause as communicated to the customer in this notification (e.g., 'equipment failure on Main St. feeder', 'storm damage to transmission line'). Supports customer transparency and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Description" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.cisAccountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cis account number"@en ;
    rdfs:comment "The customer account number as recorded in the Customer Information System (CIS) — SAP IS-U or Oracle CC&B — at the time of notification. Provides a direct cross-reference to the billing and service account for regulatory audit and dispute resolution."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "cis_account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Customer Information System (CIS) Account Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerNotification.contactAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contact address"@en ;
    rdfs:comment "The specific contact address (email address, phone number, or device token) used for this notification delivery attempt, as resolved from the customer's preference profile. Stored for audit and delivery confirmation purposes. Classified as restricted PII."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "contact_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Contact Address" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Audit timestamp when this notification record was first created in the outage management system. Supports data lineage, audit trail, and regulatory record-keeping requirements."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CustomerNotification.createdDateTime .
cmm:CustomerNotification.customerAcknowledgmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer acknowledgment flag"@en ;
    rdfs:comment "Indicates whether the customer explicitly acknowledged receipt of this notification (e.g., via IVR keypress, SMS reply, or mobile app confirmation). True = acknowledged. Supports two-way communication tracking and life-support customer welfare checks."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_acknowledgment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Acknowledgment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerNotification.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Total number of customers affected by the associated outage event at the time this notification was generated. Included in the notification for context and used in SAIFI (System Average Interruption Frequency Index) reporting."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerNotification.deliveredTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivered timestamp"@en ;
    rdfs:comment "Timestamp when delivery confirmation was received from the channel provider, confirming the notification reached the customer's device, inbox, or IVR endpoint. Null if delivery has not been confirmed or failed."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "delivered_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Delivered Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.deliveryStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery status"@en ;
    rdfs:comment "Current lifecycle state of the notification delivery attempt. pending: queued for dispatch; sent: transmitted to channel provider; delivered: confirmed receipt by customer device or inbox; failed: delivery attempt unsuccessful; bounced: message returned undeliverable; opted_out: customer has opted out of this channel."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "delivery_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Status" ;
    cmm:validValues "pending|sent|delivered|failed|bounced|opted_out" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.etrTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "etr timestamp"@en ;
    rdfs:comment "The Estimated Time to Restore (ETR) communicated to the customer in this notification. Represents the utility's best estimate of when power will be restored to the affected service point. Critical for customer satisfaction and regulatory ETR accuracy reporting."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "etr_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time to Restore (ETR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Reason code for notification delivery failure when delivery_status is 'failed' or 'bounced'. Supports channel quality monitoring, contact data hygiene initiatives, and SLA root cause analysis. Reference-value candidates: invalid_contact|channel_unavailable|provider_error|customer_opted_out|number_disconnected|mailbox_full|unknown."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Failure Reason" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.languageCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "language code"@en ;
    rdfs:comment "ISO 639-1 language code (optionally with ISO 3166-1 country subtag) of the language in which the notification was composed and delivered. Supports multilingual customer communication compliance requirements mandated by state PUCs in diverse service territories."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "language_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Language Code" ;
    cmm:valuePattern "^[a-z]{2}(-[A-Z]{2})?$" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.lastRetryTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last retry timestamp"@en ;
    rdfs:comment "Timestamp of the most recent delivery retry attempt for this notification. Null if no retries have been attempted. Used in conjunction with retry_count to assess delivery persistence and channel failure patterns."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_retry_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Retry Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.lifeSupportFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support flag"@en ;
    rdfs:comment "Indicates whether the customer is registered as a life support or medical baseline customer at the time of this notification. True = life support customer. Triggers priority notification handling and regulatory reporting obligations under state PUC medical baseline rules."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "life_support_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerNotification.messageBody a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "message body"@en ;
    rdfs:comment "Full text content of the notification message as delivered to the customer, including outage details, Estimated Time to Restore (ETR), and restoration instructions. Stored for regulatory audit and dispute resolution."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "message_body" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Message Body" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.messageSubject a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "message subject"@en ;
    rdfs:comment "Subject line or headline of the notification as delivered to the customer. Applicable primarily to email and mobile app push notifications. Stored for audit, regulatory review, and communication effectiveness analysis."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "message_subject" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Message Subject" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.notificationBatchNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification batch number"@en ;
    rdfs:comment "Identifier for the batch or campaign in which this notification was grouped and dispatched. Multiple customer notifications for the same outage event are typically dispatched in batches. Supports batch-level delivery performance analysis and storm response coordination."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_batch_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notification Batch ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerNotification.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "Communication channel through which the notification was dispatched to the customer. IVR: Interactive Voice Response automated call; SMS: text message; email: electronic mail; mobile_app: push notification via utility mobile application; web_portal: in-portal alert; postal_mail: physical letter for regulatory advance notice."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Channel" ;
    cmm:validValues "ivr|sms|email|mobile_app|web_portal|postal_mail" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.notificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification number"@en ;
    rdfs:comment "Externally visible, human-readable business identifier for this notification record. Used in customer correspondence, regulatory audit trails, and SLA compliance tracking. Format: NTF- followed by 10-digit sequence."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notification Number" ;
    cmm:valuePattern "^NTF-[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerNotification.notificationPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification priority"@en ;
    rdfs:comment "Priority level assigned to this notification, governing dispatch queue order and retry escalation logic. Critical priority is used for life-support customers and medical baseline accounts. Supports regulatory requirements for prioritized restoration communication."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notification Priority" ;
    cmm:validValues "critical|high|standard|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:CustomerNotification.notificationToOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Customer notifications are triggered by outage events (alerts, ETR updates, restoration confirmations). Must link to the event for communication audit trail."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:long ;
    cmm:physicalColumn "notification_to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerNotification.notificationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification type"@en ;
    rdfs:comment "Classification of the notification purpose. outage_alert: initial unplanned outage alert; etr_update: Estimated Time to Restore (ETR) revision; restoration_confirmation: power restored confirmation; planned_outage_notice: advance notice of scheduled maintenance; safety_alert: safety-related communication; demand_response_event: Demand Response (DR) program event notice."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notification Type" ;
    cmm:validValues "outage_alert|etr_update|restoration_confirmation|planned_outage_notice|safety_alert|demand_response_event" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CustomerNotification.kind .
cmm:CustomerNotification.omsNotificationRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms notification ref"@en ;
    rdfs:comment "External reference identifier assigned by the Outage Management System (OMS), specifically GE PowerOn ADMS, to this notification record. Enables bidirectional traceability between the lakehouse silver layer and the operational OMS source system."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_notification_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Notification Reference" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.optOutFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out flag"@en ;
    rdfs:comment "Indicates whether the customer had opted out of this notification channel or notification type at the time of dispatch. True = customer opted out; notification may have been suppressed or sent via alternate channel per preference rules. Critical for TCPA and state PUC opt-out compliance."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "opt_out_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerNotification.outageStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage start timestamp"@en ;
    rdfs:comment "The timestamp of the outage event start as communicated to the customer in this notification. Provides the customer with context on when the interruption began. Used in SAIDI/SAIFI/CAIDI reliability index calculations."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event type associated with this notification. Distinguishes between unplanned interruptions, scheduled maintenance windows, storm-related events, equipment failures, and transmission faults. Supports SAIDI/SAIFI/CAIDI reliability metric segmentation."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "unplanned|planned|storm_related|equipment_failure|transmission_fault" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.plannedOutageEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage end timestamp"@en ;
    rdfs:comment "For planned maintenance outage notifications, the scheduled end time of the planned interruption communicated to the customer. Null for unplanned outage notifications. Supports advance notice compliance and customer impact duration communication."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_outage_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.plannedOutageStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage start timestamp"@en ;
    rdfs:comment "For planned maintenance outage notifications, the scheduled start time of the planned interruption communicated to the customer. Null for unplanned outage notifications. Supports advance notice compliance tracking required by state PUCs."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_outage_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.regulatoryNoticeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory notice flag"@en ;
    rdfs:comment "Indicates whether this notification fulfills a specific regulatory advance notice obligation (e.g., state PUC-mandated 48-hour advance notice for planned outages). True = this notification is a regulatory compliance notice. Supports regulatory reporting and audit evidence."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_notice_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Notice Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerNotification.retryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retry count"@en ;
    rdfs:comment "Number of delivery retry attempts made for this notification after an initial failure. Used to track delivery persistence, diagnose channel reliability issues, and support SLA compliance reporting."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:int ;
    cmm:physicalColumn "retry_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Retry Count" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerNotification.sentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sent timestamp"@en ;
    rdfs:comment "The principal real-world event timestamp when the notification was dispatched from the utility's outage communication platform to the delivery channel provider. Used as the primary business event time for SLA measurement and regulatory compliance reporting."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "sent_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Sent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerNotification.slaMetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla met flag"@en ;
    rdfs:comment "Indicates whether this notification was dispatched within the required Service Level Agreement (SLA) target time. True = SLA met; False = SLA breached. Supports regulatory SLA compliance reporting to state PUCs and internal performance dashboards."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_met_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerNotification.slaTargetMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla target minutes"@en ;
    rdfs:comment "The Service Level Agreement (SLA) target time in minutes within which this notification type must be dispatched following the triggering outage event. Defined by state PUC regulations and internal communication standards. Used as the benchmark for SLA compliance measurement."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:int ;
    cmm:physicalColumn "sla_target_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Target Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:CustomerNotification.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifies the operational system of record that originated this notification record. Primarily GE PowerOn ADMS for OMS-driven notifications, but may include SAP IS-U, Oracle CC&B for billing-related outage notices, or manual OMS entries during storm response."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "GE_PowerOn_ADMS|SAP_ISU|Oracle_CCB|OMS_Manual|DERMS" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.territoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "territory code"@en ;
    rdfs:comment "Code identifying the utility's service territory or operating division within which the affected customer and service point are located. Supports territory-level SLA compliance reporting to individual state PUCs and regional storm response performance analysis."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:string ;
    cmm:physicalColumn "territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:valuePattern "^[A-Z]{2,6}$" ;
    cmm:cimDatatype "String" .
cmm:CustomerNotification.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Notifications are sent in the context of an outage event or planned outage. Required for communication SLA compliance tracking."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerNotification.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Audit timestamp of the most recent modification to this notification record, such as a delivery status update or retry attempt. Supports change tracking and SLA audit."@en ;
    rdfs:domain cmm:CustomerNotification ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:EventStatusHistory a owl:Class ;
    rdfs:label "Event Status History"@en ;
    rdfs:comment "Lifecycle status history of an outage event, capturing each state transition from initial report through investigation, crew dispatch, partial restoration, and full restoration. Records status code, transition timestamp, triggering actor (dispatcher, system, crew), and status notes. Enables full audit trail of outage event progression and supports OMS workflow state machine."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.event_status_history" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OMS Event Status History (GE PowerOn ADMS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.event_status_history" ;
    owl:hasKey ( cmm:EventStatusHistory.eventStatusHistoryId ) .

cmm:EventStatusHistory.eventStatusHistoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status history id"@en ;
    rdfs:comment "Primary key for event_status_history"@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:long ;
    cmm:physicalColumn "event_status_history_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Event Status History Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EventStatusHistory.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Identifier of the field crew associated with this status transition, particularly relevant for CREW_DISPATCHED and PARTIAL_RESTORE transitions. Links to the crew or work order management record in Ventyx Asset Suite or SAP S/4HANA Plant Maintenance."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_status_history_crew_id" ;
    cmm:cimAssociation "ActivityRecord.Crew" .
cmm:EventStatusHistory.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "System identifier of the specific dispatcher, crew member, or automated system process that triggered this status transition. References the workforce or system actor record. Used for accountability auditing and OMS workflow traceability."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Triggering Actor ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_status_history_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:EventStatusHistory.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event whose lifecycle this status record belongs to. Links each status transition to the originating outage event in the OMS. Serves as the EVENT_SOURCE_REFERENCE for this event log entity."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_status_history_event_id" ;
    cmm:cimAssociation "ActivityRecord.Outage" .
cmm:EventStatusHistory.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the switching order executed as part of this status transition, applicable when the OMS issues switching instructions to isolate faults or restore service segments. Links to the switching order record in GE PowerOn ADMS."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_status_history_outage_switching_order_id" ;
    cmm:cimAssociation "ActivityRecord.SwitchingPlan" .
cmm:EventStatusHistory.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the work order created or updated in conjunction with this status transition. Links the outage event status history to the maintenance and restoration work order in Ventyx Asset Suite or SAP S/4HANA Plant Maintenance for integrated O&M tracking."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_event_status_history_work_order_id" ;
    cmm:cimAssociation "ActivityRecord.Work" .
cmm:EventStatusHistory.actualRestorationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual restoration time"@en ;
    rdfs:comment "The actual date and time at which service was fully restored, populated only when status_code transitions to RESTORED. Used as the definitive restoration timestamp for SAIDI/SAIFI/CAIDI calculations and regulatory outage duration reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_restoration_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Restoration Time" ;
    cmm:cimDatatype "DateTime" .
cmm:EventStatusHistory.affectedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer count"@en ;
    rdfs:comment "Number of customers without power at the time of this status transition. Updated at each transition to reflect partial restorations. Used for SAIDI/SAIFI/CAIDI calculations, customer notification prioritization, and regulatory outage reporting to State PUCs and NERC."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:EventStatusHistory.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized cause classification code assigned or updated at this status transition point, following IEEE 1366 or utility-specific cause code taxonomy. May be refined as investigation progresses (e.g., initially UNKNOWN, later updated to EQUIPMENT_FAILURE or TREE_CONTACT). Reference-value candidates: UNKNOWN|EQUIPMENT_FAILURE|TREE_CONTACT|ANIMAL_CONTACT|WEATHER|VEHICLE_ACCIDENT|SCHEDULED_MAINTENANCE|OVERLOAD|THIRD_PARTY."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time at which this status history record was first created in the Silver layer data product. Distinct from transition_timestamp (the business event time). Used for data lineage, audit trail, and Silver layer ingestion monitoring. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:EventStatusHistory.criticalFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facility flag"@en ;
    rdfs:comment "Indicates whether one or more critical facilities (hospitals, emergency services, water treatment plants, NERC CIP-designated assets) are among the affected customers at this status transition. Triggers escalation protocols and mandatory regulatory notification timelines."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facility Affected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.ertConfidenceLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ert confidence level"@en ;
    rdfs:comment "Dispatcher or system assessment of the confidence level in the estimated_restoration_time at this transition. Supports customer communication tiering (e.g., only publish ERT to customers when confidence is HIGH or MEDIUM) and ERT accuracy analytics."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "ert_confidence_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Time (ERT) Confidence Level" ;
    cmm:validValues "HIGH|MEDIUM|LOW|UNKNOWN" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.estimatedRestorationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration time"@en ;
    rdfs:comment "The estimated date and time by which full service restoration is expected, as assessed at the time of this status transition. ERT may be revised at each transition as field conditions evolve. Used for customer notifications, dispatcher planning, and regulatory ERT accuracy reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Time (ERT)" ;
    cmm:cimDatatype "DateTime" .
cmm:EventStatusHistory.flisrActivatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr activated flag"@en ;
    rdfs:comment "Indicates whether the GE PowerOn ADMS Fault Location, Isolation, and Service Restoration (FLISR) automation was activated during this status transition. FLISR activations represent automated restoration actions and are tracked separately for reliability performance and automation benefit reporting."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_activated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Activated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.majorEventDayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event day flag"@en ;
    rdfs:comment "Indicates whether this status transition occurred during a declared IEEE 1366 Major Event Day (MED), where system-wide outage levels exceed the 2.5 beta threshold. MED-flagged records are excluded from normalized SAIDI/SAIFI regulatory reporting."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_day_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "The primary communication channel used to notify affected customers of this status transition. Populated when notification_sent_flag is True. Supports multi-channel notification analytics and State PUC communication compliance reporting."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Channel" ;
    cmm:validValues "SMS|IVR|EMAIL|APP_PUSH|NONE" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Indicates whether a customer notification (SMS, IVR, email, or app push) was dispatched to affected customers as a result of this status transition. Supports notification compliance tracking and customer communication audit trails per State PUC notification requirements."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.omsEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms event number"@en ;
    rdfs:comment "The externally-known OMS event reference number assigned by GE PowerOn ADMS at the time of outage event creation. Carried on each status history record to enable direct cross-reference with OMS reports, dispatcher logs, and regulatory filings without requiring a join to the parent event table."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EventStatusHistory.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Elapsed duration in minutes from the initial outage report timestamp to this status transition timestamp. Provides a running duration metric at each lifecycle stage without requiring a join to the parent event. Used for real-time SAIDI contribution monitoring and SLA tracking."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:EventStatusHistory.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event type at the time of this status record. Distinguishes unplanned interruptions (equipment failure, fault), planned maintenance windows, storm-related events, and emergency outages. Denormalized from the parent event for efficient status history reporting and SAIDI/SAIFI segmentation."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "UNPLANNED|PLANNED|STORM|EMERGENCY" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.previousStatusCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "previous status code"@en ;
    rdfs:comment "The OMS workflow state code that was active immediately before this transition occurred. Enables reconstruction of the full state machine path and supports regression analysis of outage event progressions. Null for the initial status record. Reference-value candidates: same."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "previous_status_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Previous Outage Event Status Code" ;
    cmm:validValues "REPORTED|INVESTIGATING|CREW_DISPATCHED|PARTIAL_RESTORE|RESTORED|CANCELLED" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Restoration priority classification assigned at this status transition, reflecting the urgency of restoration based on affected customer types (e.g., hospitals, critical infrastructure), customer count, and storm response protocols. Drives crew dispatch sequencing and resource allocation."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Restoration Priority Level" ;
    cmm:validValues "CRITICAL|HIGH|MEDIUM|LOW" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:EventStatusHistory.regulatoryNotificationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory notification required flag"@en ;
    rdfs:comment "Indicates whether this status transition triggers a mandatory regulatory notification obligation to NERC, FERC, State PUC, or other governing bodies based on outage severity thresholds (e.g., NERC EOP-004 event reporting, State PUC major outage notification). Drives compliance workflow automation."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_notification_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.regulatoryNotificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory notification sent flag"@en ;
    rdfs:comment "Indicates whether the required regulatory notification has been submitted to the applicable governing body (NERC, FERC, State PUC) as of this status transition. Supports compliance audit trails and ensures no mandatory notifications are missed."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.restoredCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restored customer count"@en ;
    rdfs:comment "Cumulative number of customers whose service has been restored as of this status transition. Enables tracking of partial restoration progress and supports incremental SAIDI/SAIFI credit calculations. Particularly relevant for PARTIAL_RESTORE status transitions."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "restored_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restored Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:EventStatusHistory.scadaAlarmReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada alarm reference"@en ;
    rdfs:comment "Reference identifier of the SCADA alarm or event in OSIsoft PI or GE PowerOn ADMS that triggered or is associated with this status transition. Enables cross-system traceability between the OMS event lifecycle and real-time SCADA/EMS alarm data."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_alarm_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Alarm Reference" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifies the operational system of record that originated this status transition record. Primarily GE PowerOn ADMS for automated OMS transitions, but may include SAP IS-U, Oracle CC&B, or MANUAL for dispatcher-entered records. Supports data lineage and Silver layer reconciliation."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "GE_POWERON_ADMS|SAP_ISU|ORACLE_CCB|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.sourceSystemRecordCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record code"@en ;
    rdfs:comment "The native record identifier assigned by the source system (e.g., GE PowerOn ADMS internal status log ID) for this status transition. Enables bidirectional traceability between the Silver layer and the operational system of record for reconciliation and audit purposes."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record ID" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.statusCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status code"@en ;
    rdfs:comment "Standardized OMS workflow state code representing the current lifecycle stage of the outage event at the time of this transition. Drives the OMS state machine and is used for SAIDI/SAIFI/CAIDI milestone tracking. Serves as the EVENT_TYPE_OR_CHANNEL discriminator for this event log. Reference-value candidates: REPORTED|INVESTIGATING|CREW_DISPATCHED|PARTIAL_RESTORE|RESTORED|CANCELLED|ON_HOLD|ESCALATED|PENDING_VERIFICATION."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "status_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Event Status Code" ;
    cmm:validValues "REPORTED|INVESTIGATING|CREW_DISPATCHED|PARTIAL_RESTORE|RESTORED|CANCELLED" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EventStatusHistory.statusDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status description"@en ;
    rdfs:comment "Human-readable label or narrative description corresponding to the status_code at the time of this transition. Provides dispatcher-facing context for the OMS workflow state and supports customer notification messaging. Serves as the EVENT_PAYLOAD_OR_VALUE for this event log."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "status_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Outage Event Status Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:EventStatusHistory.statusNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status notes"@en ;
    rdfs:comment "Free-text notes entered by the dispatcher, crew, or system at the time of this status transition. Captures contextual information such as field conditions, equipment findings, partial restoration scope, or escalation reasons. Supports OMS audit trail and post-event analysis."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "status_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Status Transition Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EventStatusHistory.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this outage event is classified as part of a declared storm or major event at the time of this status transition. Storm-classified events are typically excluded from IEEE 1366 SAIDI/SAIFI calculations per the Major Event Day (MED) exclusion methodology."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EventStatusHistory.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Status history records belong to a parent outage event. This is the core audit trail FK for OMS workflow state machine."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:EventStatusHistory.transitionSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transition sequence"@en ;
    rdfs:comment "Ordinal sequence number of this status transition within the parent outage event lifecycle, starting at 1 for the initial reported status. Used to order status history records chronologically and to identify the current (latest) status without relying solely on timestamps."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:int ;
    cmm:physicalColumn "transition_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Status Transition Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:EventStatusHistory.transitionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transition timestamp"@en ;
    rdfs:comment "The exact date and time (with timezone offset) at which the outage event transitioned into this status. This is the principal EVENT_TIMESTAMP for the log record and is used for SAIDI/SAIFI/CAIDI duration calculations and OMS audit trail. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "transition_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Status Transition Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EventStatusHistory.triggeringActorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering actor name"@en ;
    rdfs:comment "Display name of the dispatcher, crew member, or automated system process that triggered this status transition. Retained for audit trail readability independent of workforce record changes. For system-triggered transitions, contains the system or process name (e.g., 'GE PowerOn ADMS Auto-Restore')."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_actor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Actor Name" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.triggeringActorType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering actor type"@en ;
    rdfs:comment "Category of the actor (person, crew, or automated system) that initiated this status transition. Distinguishes between manual dispatcher actions, field crew updates, automated OMS/SCADA system triggers, customer-initiated reports, and supervisory overrides. Supports workflow accountability and automation rate analytics."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_actor_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Actor Type" ;
    cmm:validValues "DISPATCHER|CREW|SYSTEM|CUSTOMER|SUPERVISOR" ;
    cmm:cimDatatype "String" .
cmm:EventStatusHistory.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "The date and time at which this status history record was last modified in the Silver layer data product. Supports change detection, incremental processing, and audit trail requirements. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EventStatusHistory.voltVarImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var impact flag"@en ;
    rdfs:comment "Indicates whether GE PowerOn ADMS Volt-VAR Optimization (VVO) actions were taken in conjunction with this status transition to manage voltage and reactive power during the outage or restoration. Supports grid operations analytics and ADMS performance reporting."@en ;
    rdfs:domain cmm:EventStatusHistory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "volt_var_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization Impact Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:StormEvent a owl:Class ;
    rdfs:label "Storm Event"@en ;
    rdfs:comment "Master record for a declared storm or major weather event that triggers storm response operations. Captures storm name, storm type (hurricane, ice storm, derecho, tornado, heat event), declared start and end times, affected service territory, Major Event Day (MED) declaration flag per IEEE 1366, storm response activation level (e.g., Level 1-5), mutual aid request flag, total estimated affected customers at peak, and storm cost tracking reference. Parent entity for grouping multiple outage events and mutual aid requests under a single coordinated storm response."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Incident ;
    cmm:cimExtends cim:Incident ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.storm_event" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEEE 1366 MED; Major Event Day / Storm Event (IEEE 1366 / NERC EOP-011)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.storm_event" ;
    owl:hasKey ( cmm:StormEvent.stormEventId ) .

cmm:StormEvent.stormEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event id"@en ;
    rdfs:comment "Unique surrogate identifier for the storm event record in the Outage Management System (OMS). Primary key for the storm_event entity."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Storm response costs are tracked to dedicated cost centers for PUC storm cost recovery filings, insurance claims, FEMA disaster reimbursement, and major event day (MED) cost exclusion from reliability"@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_event_cost_center_id" ;
    cmm:cimAssociation "Incident.Organisation" .
cmm:StormEvent.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Storm events impact specific forecast zones. Utilities track zone-level storm impacts for Major Event Day (MED) threshold calculations, mutual aid resource allocation, and regulatory reporting (IEEE 1"@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_event_forecast_zone_id" ;
    cmm:cimAssociation "Incident.LoadArea" .
cmm:StormEvent.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Major storm events trigger specific regulatory reporting obligations (NERC EOP-004 emergency operations, state PUC emergency reporting requirements). Compliance teams track which obligations are activ"@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_event_obligation_id" ;
    cmm:cimAssociation "Incident.Document" .
cmm:StormEvent.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Reference to the primary service territory affected by the storm event. Links to the geographic service area definition used for regulatory reporting and customer impact scoping."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_event_service_territory_id" ;
    cmm:cimAssociation "Incident.SubGeographicalRegion" .
cmm:StormEvent.affectedDistributionCircuits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected distribution circuits"@en ;
    rdfs:comment "Number of distribution circuits (below 69kV) that experienced outages or damage during this storm event. Key metric for distribution storm damage assessment and restoration prioritization."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_distribution_circuits" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Distribution Circuits Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.affectedRegionDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected region description"@en ;
    rdfs:comment "Free-text description of the geographic area impacted by the storm, including counties, cities, or distribution circuits affected. Supplements the service territory reference for regulatory filings and public communications."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_region_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Region Description" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.affectedTransmissionLines a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected transmission lines"@en ;
    rdfs:comment "Number of transmission lines (69kV and above) that experienced outages or damage during this storm event. Used for NERC reliability reporting and transmission damage assessment."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_transmission_lines" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Transmission Lines Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.afterActionReportReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "after action report reference"@en ;
    rdfs:comment "Document management reference number or URL for the post-storm After-Action Report (AAR) filed following storm demobilization. Used for continuous improvement tracking and regulatory compliance."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "after_action_report_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "After-Action Report Reference" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time this storm event record was first created in the OMS or data platform. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Incident.createdDateTime .
cmm:StormEvent.criticalFacilitiesAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facilities affected"@en ;
    rdfs:comment "Number of critical facilities (hospitals, emergency services, water treatment plants, shelters) that experienced power interruptions during this storm event. Drives restoration prioritization and regulatory reporting."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "critical_facilities_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facilities Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.customerNotificationIssued a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification issued"@en ;
    rdfs:comment "Indicates whether proactive customer notifications (via IVR, SMS, email, or web portal) were issued for this storm event. Supports PUC customer communication compliance tracking."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_issued" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Issued Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.declaredEndTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "declared end time"@en ;
    rdfs:comment "The date and time at which the storm event was officially closed and storm response operations were demobilized. Null if the storm is still active."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "declared_end_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Declared End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.declaredStartTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "declared start time"@en ;
    rdfs:comment "The date and time at which the storm event was officially declared by the utility's emergency operations center, triggering storm response activation. Principal business event timestamp for the storm lifecycle."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "declared_start_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Declared Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.emergencyOperationsCenterActivated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency operations center activated"@en ;
    rdfs:comment "Indicates whether the utility's Emergency Operations Center (EOC) was formally activated for this storm event. EOC activation triggers escalated staffing, executive involvement, and enhanced regulatory reporting obligations."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "emergency_operations_center_activated" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Operations Center (EOC) Activated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.eocActivationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eoc activation time"@en ;
    rdfs:comment "Date and time the Emergency Operations Center (EOC) was formally activated for this storm event. Null if EOC was not activated."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "eoc_activation_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Operations Center (EOC) Activation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.eocDeactivationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eoc deactivation time"@en ;
    rdfs:comment "Date and time the Emergency Operations Center (EOC) was formally deactivated following storm response demobilization. Null if EOC is still active."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "eoc_deactivation_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Operations Center (EOC) Deactivation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.estimatedStormCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated storm cost usd"@en ;
    rdfs:comment "Estimated total cost of storm response operations in US dollars, including labor (internal and mutual aid), materials, equipment, and contractor costs. Used for regulatory cost recovery filings and executive reporting. Actual costs tracked in SAP S/4HANA."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_storm_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Storm Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:StormEvent.externalCrewsDeployed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "external crews deployed"@en ;
    rdfs:comment "Actual number of external line crews that arrived and were deployed during this storm event. Compared against requested count for mutual aid effectiveness analysis."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "external_crews_deployed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "External Crews Deployed Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.externalCrewsRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "external crews requested"@en ;
    rdfs:comment "Number of external line crews requested through mutual aid for this storm event. Used for resource planning, cost tracking, and post-storm mutual aid reconciliation."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "external_crews_requested" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "External Crews Requested Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.femaDisasterDeclarationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fema disaster declaration number"@en ;
    rdfs:comment "FEMA federal disaster declaration number associated with this storm event, if applicable. Required for federal cost reimbursement claims and regulatory filings when a presidential disaster declaration is issued."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fema_disaster_declaration_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Federal Emergency Management Agency (FEMA) Disaster Declaration Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:StormEvent.firstCustomerNotificationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "first customer notification time"@en ;
    rdfs:comment "Date and time the first proactive customer notification was issued for this storm event. Used for PUC compliance reporting on customer communication timeliness."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "first_customer_notification_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "First Customer Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.incidentCommander a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident commander"@en ;
    rdfs:comment "Name of the designated Incident Commander responsible for overall storm response operations under the Incident Command System (ICS). Used for accountability, communications, and post-storm after-action review."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "incident_commander" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incident Commander Name" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.isMajorEventDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is major event day"@en ;
    rdfs:comment "Indicates whether this storm event qualifies as a Major Event Day (MED) per IEEE 1366-2012 statistical threshold methodology. When True, outages during this event are excluded from SAIDI/SAIFI/CAIDI reliability index calculations for regulatory reporting."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_major_event_day" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.isMutualAidRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is mutual aid requested"@en ;
    rdfs:comment "Indicates whether mutual aid from other utilities or the regional mutual aid group was formally requested for this storm event. Triggers mutual aid tracking, cost allocation, and regulatory reporting obligations."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_mutual_aid_requested" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Requested Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time this storm event record was most recently modified. Used for change tracking, data freshness monitoring, and audit compliance."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:StormEvent.medThresholdSaidi a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med threshold saidi"@en ;
    rdfs:comment "The calculated SAIDI threshold value (in minutes per customer) used to determine MED qualification for this event year, per IEEE 1366-2012 beta method. Stored for audit and regulatory verification purposes."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "med_threshold_saidi" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) System Average Interruption Duration Index (SAIDI) Threshold" ;
    cmm:cimDatatype "Decimal" .
cmm:StormEvent.meteorologicalEndTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meteorological end time"@en ;
    rdfs:comment "The date and time the weather event physically ended impacting the service territory per NWS or internal meteorological data. Used for IEEE 1366 MED exclusion period boundary calculations."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "meteorological_end_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meteorological Storm End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.meteorologicalStartTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meteorological start time"@en ;
    rdfs:comment "The date and time the weather event physically began impacting the service territory, as reported by the National Weather Service or internal meteorological data. May precede the declared start time."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "meteorological_start_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meteorological Storm Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.mutualAidCoordinator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid coordinator"@en ;
    rdfs:comment "Name of the regional mutual aid coordinator organization or agreement (e.g., 'EEI Mutual Aid', 'Southeast Mutual Aid Group') through which external crews were requested."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "mutual_aid_coordinator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Coordinator Name" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.mutualAidRequestTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid request time"@en ;
    rdfs:comment "Date and time the formal mutual aid request was submitted to the regional mutual aid coordinator or neighboring utilities. Null if no mutual aid was requested."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "mutual_aid_request_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Request Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.nercEventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc event type"@en ;
    rdfs:comment "NERC event classification code for mandatory regulatory reporting. EEA1/EEA2/EEA3 indicate Emergency Energy Alert levels; MEA indicates a Misoperation Event Alert; OE417 indicates a DOE Electric Emergency Incident and Disturbance Report filing requirement. Reference-value candidates: EEA1|EEA2|EEA3|MEA|OE417|other|not_applicable."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Event Type" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.nwsStormCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nws storm code"@en ;
    rdfs:comment "External identifier assigned by the National Weather Service (NWS) to the weather event, used to cross-reference official meteorological data, storm tracks, and NWS storm reports for regulatory and insurance purposes."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nws_storm_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "National Weather Service (NWS) Storm ID" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.oe417FilingRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oe417 filing required"@en ;
    rdfs:comment "Indicates whether this storm event meets the threshold requiring a DOE OE-417 Electric Emergency Incident and Disturbance Report filing. Triggered when 50,000+ customers are affected or critical infrastructure is impacted."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "oe417_filing_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Energy (DOE) OE-417 Filing Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.oe417FilingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oe417 filing timestamp"@en ;
    rdfs:comment "Date and time the DOE OE-417 Electric Emergency Incident and Disturbance Report was submitted for this storm event. Null if filing not required or not yet submitted."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "oe417_filing_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DOE OE-417 Filing Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.peakCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak customers affected"@en ;
    rdfs:comment "Maximum number of customers simultaneously without power at any point during the storm event. Key metric for regulatory reporting, mutual aid justification, and public communications. Sourced from OMS outage aggregation."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "peak_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.pucNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc notification required"@en ;
    rdfs:comment "Indicates whether this storm event requires formal notification to the state Public Utility Commission (PUC) per state-specific emergency reporting thresholds (e.g., >10% of customers affected or extended outage duration)."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormEvent.pucNotificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc notification timestamp"@en ;
    rdfs:comment "Date and time the formal notification was submitted to the state Public Utility Commission (PUC) for this storm event. Null if notification not required or not yet submitted."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "puc_notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PUC Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormEvent.responseActivationLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response activation level"@en ;
    rdfs:comment "Numeric level (1–5) indicating the severity of the storm response activation, where Level 1 is routine and Level 5 is maximum emergency mobilization. Determines staffing, resource deployment, and executive notification thresholds."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "response_activation_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Response Activation Level" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.responseStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response status"@en ;
    rdfs:comment "Current lifecycle state of the storm response operation. Drives workflow routing in OMS and determines whether mutual aid, crew dispatch, and cost tracking are active."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "response_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Response Status" ;
    cmm:validValues "declared|active|demobilizing|closed|cancelled" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.stormCostReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm cost reference"@en ;
    rdfs:comment "Reference code linking this storm event to the corresponding cost collection object in SAP S/4HANA (e.g., WBS element, internal order, or cost center) for storm cost tracking, regulatory cost recovery filings, and OPEX reporting."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_cost_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Cost Reference Code" ;
    cmm:cimDatatype "String" .
cmm:StormEvent.stormName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm name"@en ;
    rdfs:comment "Human-readable name assigned to the storm event (e.g., 'Hurricane Ida', 'Winter Storm Uri', 'Derecho 2023-07'). Used for communications, regulatory reporting, and historical reference."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Storm Event Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:StormEvent.stormNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm notes"@en ;
    rdfs:comment "Free-text operational notes and situational awareness comments entered by storm coordinators during the event lifecycle. Captures key decisions, escalations, and observations not captured in structured fields."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Storm Event Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:StormEvent.stormNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm number"@en ;
    rdfs:comment "Externally-known business identifier for the storm event, used in OMS, regulatory filings, and mutual aid coordination. Format: STM-{YYYY}-{NNNNN}."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Storm Event Number" ;
    cmm:valuePattern "^STM-[0-9]{4}-[0-9]{5}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:StormEvent.stormToOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm to outage events"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — A storm event groups multiple outage events under coordinated response. This parent-child link is essential for storm response management and MED calculations."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "storm_to_outage_events" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.stormType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm type"@en ;
    rdfs:comment "Classification of the weather event type driving storm response operations. Determines response protocols, mutual aid triggers, and IEEE 1366 Major Event Day (MED) classification criteria. Reference-value candidates: hurricane|ice_storm|derecho|tornado|heat_event|winter_storm|thunderstorm|flood|wildfire|other."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Storm Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Incident.type .
cmm:StormEvent.totalCustomerInterruptions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total customer interruptions"@en ;
    rdfs:comment "Cumulative count of individual customer interruption events associated with this storm, accounting for customers who experienced multiple outages. Used in SAIFI calculation inputs for IEEE 1366 reporting."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_customer_interruptions" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Customer Interruptions Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormEvent.totalOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total outage events"@en ;
    rdfs:comment "Total number of discrete outage events (trouble calls, switching events, fault isolations) grouped under this storm event in the OMS. Used for storm complexity assessment and resource planning."@en ;
    rdfs:domain cmm:StormEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_outage_events" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Outage Events Count" ;
    cmm:cimDatatype "Integer" .

cmm:MutualAidRequest a owl:Class ;
    rdfs:label "Mutual Aid Request"@en ;
    rdfs:comment "Record of a mutual aid request issued to or received from neighboring utilities during large-scale storm response or major outage events. Captures requesting utility, responding utility, request date, crew type and count requested, crew type and count committed, mobilization date, demobilization date, ESOP (Emergency Support Operations Plan) reference, and cost reimbursement tracking flag. Supports NERC EOP mutual aid obligations and storm recovery coordination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Request ;
    cmm:cimCloseMatch cim:Request ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.mutual_aid_request" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EEI Mutual Assistance; Mutual Aid Agreement (NERC EOP-011 / ESOP)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.mutual_aid_request" ;
    owl:hasKey ( cmm:MutualAidRequest.mutualAidRequestId ) .

cmm:MutualAidRequest.mutualAidRequestId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid request id"@en ;
    rdfs:comment "Unique surrogate identifier for the mutual aid request record. Primary key for this entity in the Silver Layer lakehouse."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:long ;
    cmm:physicalColumn "mutual_aid_request_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Mutual Aid Request ID" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Mutual aid costs (crew deployment, equipment, lodging) are charged to cost centers for reimbursement tracking, interstate billing, and regulatory reporting. Required for cost recovery from requesting"@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_mutual_aid_request_cost_center_id" ;
    cmm:cimAssociation "Request.Organisation" .
cmm:MutualAidRequest.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event that triggered this mutual aid request. Links the aid request to the specific storm, major outage, or emergency event driving the need for external resources."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_mutual_aid_request_event_id" ;
    cmm:cimAssociation "Request.Outage" .
cmm:MutualAidRequest.mutualStormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "mutual storm event"@en ;
    rdfs:comment "FK to outage.storm_event.storm_event_id — Mutual aid requests are issued in response to storm events. Required for storm cost tracking and NERC EOP mutual aid reporting."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "mutual_storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "storm_event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_mutual_aid_request_mutual_storm_event_id" ;
    cmm:cimAssociation "Request.Incident" .
cmm:MutualAidRequest.primaryStormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary storm event"@en ;
    rdfs:comment "FK to outage.storm_event.storm_event_id — Mutual aid requests are issued in context of a storm event. Must link to parent storm for coordination and cost tracking."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "primary_storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_mutual_aid_request_primary_storm_event_id" ;
    cmm:cimAssociation "Request.Incident" .
cmm:MutualAidRequest.regulatoryCorrespondence a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory correspondence"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_correspondence. Business justification: Mutual aid coordination often involves regulatory notifications and correspondence with state commissions or NERC regarding emergency response. Emergency operations centers document regulatory communi"@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range cmm:RegulatoryCorrespondence ;
    cmm:physicalColumn "regulatory_correspondence_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Correspondence Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_mutual_aid_request_regulatory_correspondence_id" ;
    cmm:cimAssociation "Request.Document" .
cmm:MutualAidRequest.acknowledgementTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledgement timestamp"@en ;
    rdfs:comment "Date and time when the responding utility formally acknowledged receipt of the mutual aid request. Used to measure response time SLA compliance."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "acknowledgement_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledgement Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MutualAidRequest.actualCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual cost usd"@en ;
    rdfs:comment "Actual total cost in US dollars incurred for the mutual aid deployment upon demobilization, as submitted by the responding utility for reimbursement. Populated after demobilization and cost reconciliation."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Mutual Aid Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MutualAidRequest.affectedCustomersCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customers count"@en ;
    rdfs:comment "Number of customers without power at the time the mutual aid request was issued. Provides context for the scale of the outage event and justifies the level of external resource request."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customers_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customers Count" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.arrivalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrival date"@en ;
    rdfs:comment "Actual date on which the responding utility's crews arrived at the staging area or work location within the requesting utility's service territory and became available for restoration work."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "arrival_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Arrival Date" ;
    cmm:cimDatatype "Date" .
cmm:MutualAidRequest.commitmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commitment timestamp"@en ;
    rdfs:comment "Date and time when the responding utility formally committed to providing the requested resources, transitioning the request from acknowledged to committed status."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "commitment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commitment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MutualAidRequest.costReimbursementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost reimbursement flag"@en ;
    rdfs:comment "Indicates whether the requesting utility has agreed to reimburse the responding utility for costs incurred during the mutual aid deployment. True = reimbursable; False = non-reimbursable (goodwill aid). Drives cost tracking and invoice generation workflows."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cost_reimbursement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Reimbursement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MutualAidRequest.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this mutual aid request record was first created in the system. Audit trail field for data lineage and compliance purposes."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Request.createdDateTime .
cmm:MutualAidRequest.crewCountCommitted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew count committed"@en ;
    rdfs:comment "Number of crew units actually committed by the responding utility. May be less than crew_count_requested if the responding utility has limited available resources."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_count_committed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Count Committed" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.crewCountDeployed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew count deployed"@en ;
    rdfs:comment "Actual number of crew units that physically arrived and performed restoration work in the requesting utility's territory. May differ from committed count due to last-minute changes or attrition during transit."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_count_deployed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Count Deployed" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.crewCountRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew count requested"@en ;
    rdfs:comment "Number of crew units (typically crew trucks or work teams) requested from the responding utility. A crew unit typically consists of a truck and associated personnel per ESOP standards."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_count_requested" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Count Requested" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.crewTypeCommitted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type committed"@en ;
    rdfs:comment "Classification of crew type actually committed by the responding utility. May differ from crew_type_requested if the responding utility can only provide a partial or alternative resource match. Reference-value candidates: line_crew|tree_crew|damage_assessment|substation|transmission|logistics."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type_committed" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Type Committed" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.crewTypeRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type requested"@en ;
    rdfs:comment "Classification of crew type requested by the requesting utility (e.g., line crew, tree trimming crew, damage assessment crew, substation crew, transmission crew, logistics crew). Drives resource matching in ESOP coordination. Reference-value candidates: line_crew|tree_crew|damage_assessment|substation|transmission|logistics."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type_requested" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Type Requested" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.demobilizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demobilization date"@en ;
    rdfs:comment "Actual date on which the responding utility's crews completed their assignment and were released to return to their home utility. Marks the end of active mutual aid deployment."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "demobilization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Demobilization Date" ;
    cmm:cimDatatype "Date" .
cmm:MutualAidRequest.equipmentCountCommitted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment count committed"@en ;
    rdfs:comment "Number of equipment units of the specified type actually committed by the responding utility."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "equipment_count_committed" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Count Committed" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.equipmentCountRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment count requested"@en ;
    rdfs:comment "Number of equipment units of the specified type requested from the responding utility."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "equipment_count_requested" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Count Requested" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidRequest.equipmentTypeRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type requested"@en ;
    rdfs:comment "Type of specialized equipment requested alongside crews, such as bucket trucks, digger derricks, cable pullers, generators, or mobile command units. Supplements crew type in resource matching."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type_requested" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Type Requested" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.esopReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "esop reference number"@en ;
    rdfs:comment "Reference number of the Emergency Support Operations Plan (ESOP) or mutual aid agreement under which this request is issued. Ties the request to the governing bilateral or regional aid compact."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "esop_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "ESOP (Emergency Support Operations Plan) Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MutualAidRequest.estimatedCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated cost usd"@en ;
    rdfs:comment "Estimated total cost in US dollars for the mutual aid deployment, including labor, equipment, lodging, and travel expenses. Used for budget planning and pre-authorization of reimbursable aid."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Mutual Aid Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MutualAidRequest.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the weather or emergency event that triggered the mutual aid request. Used for post-event analysis, NERC regulatory reporting, and storm response benchmarking. Reference-value candidates: hurricane|ice_storm|tornado|wildfire|flood|earthquake|major_outage|other."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Event Type" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.invoiceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice number"@en ;
    rdfs:comment "Invoice number issued by the responding utility to the requesting utility for cost reimbursement of mutual aid services. Links to the accounts receivable/payable process in SAP S/4HANA."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reimbursement Invoice Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MutualAidRequest.invoiceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice status"@en ;
    rdfs:comment "Current status of the cost reimbursement invoice associated with this mutual aid request. Tracks the financial settlement lifecycle from invoice submission through payment or dispute resolution."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "invoice_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reimbursement Invoice Status" ;
    cmm:validValues "not_applicable|pending|submitted|approved|paid|disputed" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this mutual aid request record was most recently modified. Supports change tracking, audit compliance, and Silver Layer incremental processing."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:MutualAidRequest.mobilizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mobilization date"@en ;
    rdfs:comment "Planned or actual date on which the committed crews and resources depart from the responding utility and begin travel to the requesting utility's service territory."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "mobilization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Mobilization Date" ;
    cmm:cimDatatype "Date" .
cmm:MutualAidRequest.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this mutual aid request must be reported to NERC under EOP-005-3 or other applicable reliability standards. True = reportable event requiring NERC submission."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MutualAidRequest.nercSubmissionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc submission timestamp"@en ;
    rdfs:comment "Date and time when this mutual aid event was submitted to NERC for regulatory reporting. Null if nerc_reportable_flag is False or submission is pending."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "nerc_submission_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Submission Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MutualAidRequest.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or coordination details associated with the mutual aid request. May include staging instructions, safety briefing requirements, or special equipment needs."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mutual Aid Request Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:MutualAidRequest.omsEventReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms event reference"@en ;
    rdfs:comment "Reference identifier from the Outage Management System (GE PowerOn ADMS) for the outage event associated with this mutual aid request. Enables traceability between the aid request and the OMS event record."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_event_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OMS (Outage Management System) Event Reference" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Priority classification of the mutual aid request, reflecting the severity of the outage event and urgency of resource need. Drives dispatch sequencing when multiple requests compete for limited responding utility resources."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mutual Aid Request Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:MutualAidRequest.regionalMutualAidGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regional mutual aid group"@en ;
    rdfs:comment "Name of the regional mutual aid compact or group under which this request is coordinated (e.g., Southeast Electric Exchange, Mid-Atlantic Mutual Aid Group, Midwest Mutual Aid Group). Identifies the regional coordination framework."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "regional_mutual_aid_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Mutual Aid Group" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.requestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request date"@en ;
    rdfs:comment "Date and time when the mutual aid request was formally submitted by the requesting utility. Serves as the principal business event timestamp for the request lifecycle."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "request_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Request Date" ;
    cmm:cimDatatype "DateTime" .
cmm:MutualAidRequest.requestNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request number"@en ;
    rdfs:comment "Externally-known business identifier for the mutual aid request, used in inter-utility communications, ESOP documentation, and regulatory reporting. Format: MAR-{YYYY}-{NNNNNN}."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mutual Aid Request Number" ;
    cmm:valuePattern "^MAR-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MutualAidRequest.requestStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request status"@en ;
    rdfs:comment "Current lifecycle state of the mutual aid request, tracking progression from initial submission through crew mobilization, active deployment, and final demobilization or cancellation. Reference-value candidates: draft|submitted|acknowledged|committed|active|demobilized|cancelled|closed."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mutual Aid Request Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.status .
cmm:MutualAidRequest.requestType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request type"@en ;
    rdfs:comment "Indicates whether this utility is the requesting party (outbound — this utility is seeking aid from a neighbor) or the responding party (inbound — this utility is providing aid to a neighbor)."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Mutual Aid Request Type" ;
    cmm:validValues "outbound|inbound" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.type .
cmm:MutualAidRequest.requestingContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting contact name"@en ;
    rdfs:comment "Name of the primary operational contact at the requesting utility responsible for coordinating the mutual aid request and managing incoming crews."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requesting Utility Contact Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.requestingContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting contact phone"@en ;
    rdfs:comment "Direct phone number for the primary operational contact at the requesting utility. Used for real-time coordination during storm response."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Requesting Utility Contact Phone" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:valuePattern "^\\+?[0-9\\-\\s()]{7,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:MutualAidRequest.requestingUtilityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting utility name"@en ;
    rdfs:comment "Legal name of the utility that is requesting mutual aid resources. Identifies the party in need of crew or equipment support during a major outage or storm event."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_utility_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requesting Utility Name" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.requestingUtilityNercCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requesting utility nerc code"@en ;
    rdfs:comment "NERC-assigned registered entity identifier for the requesting utility, used for regulatory reporting and inter-utility coordination under NERC EOP standards."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "requesting_utility_nerc_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requesting Utility NERC (North American Electric Reliability Corporation) ID" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.respondingContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responding contact name"@en ;
    rdfs:comment "Name of the primary operational contact at the responding utility responsible for coordinating crew dispatch and resource commitment."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "responding_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responding Utility Contact Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.respondingContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responding contact phone"@en ;
    rdfs:comment "Direct phone number for the primary operational contact at the responding utility. Used for real-time coordination during crew mobilization."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "responding_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Responding Utility Contact Phone" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:valuePattern "^\\+?[0-9\\-\\s()]{7,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:MutualAidRequest.respondingUtilityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responding utility name"@en ;
    rdfs:comment "Legal name of the utility that is committing resources in response to the mutual aid request. Identifies the aid-providing party."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "responding_utility_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responding Utility Name" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.respondingUtilityNercCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responding utility nerc code"@en ;
    rdfs:comment "NERC-assigned registered entity identifier for the responding (aid-providing) utility, used for regulatory reporting and inter-utility coordination."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "responding_utility_nerc_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responding Utility NERC (North American Electric Reliability Corporation) ID" ;
    cmm:cimDatatype "String" .
cmm:MutualAidRequest.serviceTerritoryState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory state"@en ;
    rdfs:comment "Two-letter US state code for the primary service territory where restoration work will be performed. Used for jurisdictional compliance, state PUC reporting, and logistics planning."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service Territory State" ;
    cmm:valuePattern "^[A-Z]{2}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:MutualAidRequest.stagingLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "staging location"@en ;
    rdfs:comment "Name or address of the staging area designated for incoming mutual aid crews within the requesting utility's service territory. Used for logistics coordination and crew check-in management."@en ;
    rdfs:domain cmm:MutualAidRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "staging_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Staging Location" ;
    cmm:cimDatatype "String" .

cmm:ReliabilityIndexPeriod a owl:Class ;
    rdfs:label "Reliability Index Period"@en ;
    rdfs:comment "Periodic reliability performance record capturing computed SAIDI, SAIFI, and CAIDI index values for a defined reporting period (monthly, quarterly, annual) at a given reporting level (system, circuit, substation, PUC territory). Stores total customer minutes interrupted, total interruptions, customers served, MED-excluded values, and IEEE 1366 normalized values. This is the authoritative operational record — NOT an analytics aggregate — used for PUC regulatory filings and NERC reliability reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.reliability_index_period" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEEE 1366; SAIDI/SAIFI/CAIDI Reporting (IEEE 1366 / PUC Annual Reliability Report)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.reliability_index_period" ;
    owl:hasKey ( cmm:ReliabilityIndexPeriod.reliabilityIndexPeriodId ) .

cmm:ReliabilityIndexPeriod.reliabilityIndexPeriodId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index period id"@en ;
    rdfs:comment "Primary key for reliability_index_period"@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:long ;
    cmm:physicalColumn "reliability_index_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Reliability Index Period Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: SAIDI/SAIFI/CAIDI reporting is mandated by specific PUC obligations with defined performance thresholds and filing deadlines. Regulatory affairs maps each reporting period to the governing obligation"@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_reliability_index_period_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ReliabilityIndexPeriod.amendmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amendment reason"@en ;
    rdfs:comment "Free-text description of the reason for amending or recomputing this reliability index period record (e.g., data correction from OMS, reclassification of MED events, customer count correction). Required for version_number greater than 1. Supports regulatory audit trail and PUC amendment filing documentation."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "amendment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amendment Reason Description" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Identifier or name of the authorized utility employee (typically a Reliability Engineer or Director of Grid Operations) who approved this reliability index period record for regulatory filing. Supports SOX internal control documentation and regulatory audit requirements."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By (Employee ID or Name)" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time when this reliability index period record was formally approved for regulatory filing. Supports SOX internal control audit trails and regulatory submission documentation."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ReliabilityIndexPeriod.caidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caidi minutes"@en ;
    rdfs:comment "Customer Average Interruption Duration Index expressed in minutes per interruption. Computed as total_customer_minutes_interrupted divided by total_customer_interruptions (equivalently, SAIDI divided by SAIFI). Represents the average duration of each interruption experienced by affected customers. Used to assess restoration performance."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "caidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Average Interruption Duration Index (CAIDI) in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.caidiNormalizedMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caidi normalized minutes"@en ;
    rdfs:comment "CAIDI value computed after excluding Major Event Day (MED) interruptions per IEEE 1366 normalization methodology. Derived from normalized SAIDI and SAIFI values. Used for PUC performance standard compliance and restoration performance benchmarking."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "caidi_normalized_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1366 Normalized CAIDI (Excluding Major Event Days) in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.computationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "computation method"@en ;
    rdfs:comment "Identifies the specific computational methodology applied to derive the reliability indices in this record. IEEE_1366_STANDARD applies the full IEEE 1366 methodology including MEDs; IEEE_1366_MED_EXCLUDED applies the normalized MED-excluded methodology; PUC_CUSTOM applies a state-specific PUC-mandated variation; NERC_BENCHMARK applies NERC benchmarking methodology."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "computation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Index Computation Method" ;
    cmm:validValues "IEEE_1366_STANDARD|IEEE_1366_MED_EXCLUDED|PUC_CUSTOM|NERC_BENCHMARK" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this reliability index period record was first created in the system. Supports data lineage, audit trail, and SOX internal control requirements."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:ReliabilityIndexPeriod.customersServed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers served"@en ;
    rdfs:comment "Total number of customers served within the reporting entity boundary during the reporting period. This is the denominator used in SAIDI and SAIFI index calculations per IEEE 1366. Typically represents the average or end-of-period customer count as defined by the applicable PUC methodology."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_served" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Customers Served" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.equipmentFailureOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment failure outage events"@en ;
    rdfs:comment "Number of outage events during the reporting period caused by equipment failure (excluding storm and third-party causes). Supports asset reliability analysis, maintenance planning, and capital investment justification for aging infrastructure programs."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "equipment_failure_outage_events" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Failure Outage Events Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.filedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filed date"@en ;
    rdfs:comment "Actual date on which this reliability index period record was submitted to the applicable regulatory authority. Null if not yet filed. Used to verify on-time filing compliance and support regulatory audit trails."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:date ;
    cmm:physicalColumn "filed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Filing Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:ReliabilityIndexPeriod.filingDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing due date"@en ;
    rdfs:comment "Deadline date by which this reliability index period record must be submitted to the applicable regulatory authority (PUC or NERC). Used to track filing compliance and trigger workflow notifications. Determined by PUC tariff or NERC standard reporting schedule."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Filing Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ReliabilityIndexPeriod.filingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing status"@en ;
    rdfs:comment "Current lifecycle state of the reliability index period record in the regulatory submission workflow. DRAFT indicates preliminary computation; UNDER_REVIEW indicates internal QA; APPROVED indicates sign-off for submission; FILED indicates submission to PUC or NERC; AMENDED indicates a corrected re-submission; SUPERSEDED indicates replaced by a newer version."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Filing Status" ;
    cmm:validValues "DRAFT|UNDER_REVIEW|APPROVED|FILED|AMENDED|SUPERSEDED" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this reliability index period record was most recently modified. Tracks amendments, recomputations, and corrections to the reliability indices. Supports audit trail and regulatory amendment documentation."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ReliabilityIndexPeriod.maifiIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maifi index"@en ;
    rdfs:comment "Momentary Average Interruption Frequency Index computed as total momentary customer interruptions divided by customers served. Measures the frequency of brief power interruptions (five minutes or less) per customer. Increasingly required by PUCs as a power quality metric alongside SAIDI and SAIFI."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maifi_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Average Interruption Frequency Index (MAIFI)" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.medEventCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med event count"@en ;
    rdfs:comment "Number of calendar days during the reporting period that qualified as Major Event Days (MEDs) per the IEEE 1366 beta + 2.5 sigma threshold methodology. Used to assess storm and extreme weather impact on reliability performance."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "med_event_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.medExcludedCustomerInterruptions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med excluded customer interruptions"@en ;
    rdfs:comment "Total customer interruptions attributable to Major Event Days (MEDs) that are excluded from the normalized IEEE 1366 index calculations. MEDs are days where the daily SAIDI exceeds a statistically derived threshold (beta + 2.5 sigma). Tracking this separately enables both total and MED-excluded reporting as required by most PUCs."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "med_excluded_customer_interruptions" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Excluded Customer Interruptions" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.medExcludedCustomerMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med excluded customer minutes"@en ;
    rdfs:comment "Total customer minutes interrupted attributable to Major Event Days (MEDs) that are excluded from the normalized IEEE 1366 index calculations. Used to compute MED-normalized SAIDI and SAIFI values required for PUC regulatory filings and NERC benchmarking."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "med_excluded_customer_minutes" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Excluded Customer Minutes Interrupted" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.medThresholdSaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med threshold saidi minutes"@en ;
    rdfs:comment "The computed daily SAIDI threshold (beta + 2.5 sigma) used to classify a calendar day as a Major Event Day for this reporting period. Derived from the five-year historical daily SAIDI distribution per IEEE 1366 methodology. Documents the MED classification boundary applied to this period."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "med_threshold_saidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) SAIDI Threshold in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.momentaryInterruptionCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "momentary interruption count"@en ;
    rdfs:comment "Total number of momentary interruptions (duration five minutes or less per IEEE 1366 definition) experienced by customers during the reporting period. Used to compute MAIFI (Momentary Average Interruption Frequency Index) and assess power quality performance."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "momentary_interruption_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.nercRegisteredEntityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc registered entity code"@en ;
    rdfs:comment "NERC Compliance Registry identifier for the utility entity responsible for this reliability report. Required for NERC reliability standard compliance submissions and benchmarking participation. Aligns with the NERC Transmission Planner, Distribution Provider, or Load-Serving Entity registration."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_registered_entity_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Registered Entity ID" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.omsSourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms source system code"@en ;
    rdfs:comment "Identifier of the Outage Management System (OMS) instance from which the underlying outage event data was sourced for this reliability index computation. Supports data lineage tracing back to GE PowerOn ADMS or equivalent OMS. Critical for audit and regulatory filing validation."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Source System Code" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.periodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "period end date"@en ;
    rdfs:comment "Calendar date marking the inclusive end of the reliability reporting period. Combined with period_start_date to define the exact window over which SAIDI, SAIFI, and CAIDI indices are computed."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:date ;
    cmm:physicalColumn "period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:ReliabilityIndexPeriod.periodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "period start date"@en ;
    rdfs:comment "Calendar date marking the inclusive start of the reliability reporting period. Combined with period_end_date to define the exact window over which SAIDI, SAIFI, and CAIDI indices are computed."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:date ;
    cmm:physicalColumn "period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ReliabilityIndexPeriod.periodType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "period type"@en ;
    rdfs:comment "Classification of the reporting period granularity. Determines the aggregation window for SAIDI, SAIFI, and CAIDI index calculations. MONTHLY is used for operational monitoring; QUARTERLY and ANNUAL are used for PUC regulatory filings; ROLLING_12_MONTH is used for NERC benchmarking."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "period_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reporting Period Type" ;
    cmm:validValues "MONTHLY|QUARTERLY|ANNUAL|ROLLING_12_MONTH" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:ReliabilityIndexPeriod.plannedInterruptionCustomerMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned interruption customer minutes"@en ;
    rdfs:comment "Customer minutes interrupted attributable to planned (scheduled maintenance) outage events during the reporting period. Some PUC jurisdictions require separate reporting of planned vs. unplanned interruptions. Enables decomposition of total CMI into planned and unplanned components."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_interruption_customer_minutes" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Interruption Customer Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.priorPeriodSaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prior period saidi minutes"@en ;
    rdfs:comment "SAIDI value from the immediately preceding equivalent reporting period (e.g., prior month, prior quarter, prior year) for the same reporting entity. Stored on the record to support period-over-period variance analysis in regulatory filings without requiring a self-join."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "prior_period_saidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prior Period SAIDI in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.priorPeriodSaifiIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prior period saifi index"@en ;
    rdfs:comment "SAIFI value from the immediately preceding equivalent reporting period for the same reporting entity. Stored on the record to support period-over-period variance analysis in regulatory filings without requiring a self-join."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "prior_period_saifi_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prior Period SAIFI" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.pucJurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc jurisdiction code"@en ;
    rdfs:comment "Two-letter state code plus PUC suffix identifying the state Public Utility Commission jurisdiction under which this reliability index period record is filed (e.g., CA-PUC, NY-PUC, TX-PUC). Determines applicable performance standards, reporting formats, and filing deadlines."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Jurisdiction Code" ;
    cmm:valuePattern "^[A-Z]{2}-PUC$" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.pucSaidiPerformanceTarget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc saidi performance target"@en ;
    rdfs:comment "Regulatory SAIDI performance target (in minutes) established by the applicable state PUC for the reporting period and reporting entity. Used to assess compliance with performance-based rate mechanisms and potential penalty or incentive triggers. Null if no PUC target applies to this reporting level."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "puc_saidi_performance_target" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) SAIDI Performance Target in Minutes" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.pucSaifiPerformanceTarget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc saifi performance target"@en ;
    rdfs:comment "Regulatory SAIFI performance target established by the applicable state PUC for the reporting period and reporting entity. Used to assess compliance with performance-based rate mechanisms and potential penalty or incentive triggers. Null if no PUC target applies to this reporting level."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "puc_saifi_performance_target" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) SAIFI Performance Target" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.pucTargetMet a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc target met"@en ;
    rdfs:comment "Indicates whether the utility met all applicable PUC reliability performance targets (SAIDI and SAIFI) for this reporting period and reporting entity. True if all applicable targets were met; False if one or more targets were missed. Null if no PUC targets apply. Drives performance-based rate adjustment calculations."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_target_met" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Performance Target Met Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:ReliabilityIndexPeriod.reportingEntityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting entity code"@en ;
    rdfs:comment "Business identifier for the specific entity (circuit ID, substation code, PUC territory code, operating area code, or system-level identifier) at which the reliability indices are reported. Corresponds to the reporting_level classification. For SYSTEM level, this is the utility NERC registered entity identifier."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_entity_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Entity Code" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.reportingEntityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting entity name"@en ;
    rdfs:comment "Human-readable name of the reporting entity (e.g., circuit name, substation name, PUC territory name, operating area name). Used for display in regulatory filings and reliability performance dashboards."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_entity_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Entity Name" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.reportingLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting level"@en ;
    rdfs:comment "Organizational or geographic granularity at which the reliability indices are computed and reported. SYSTEM represents the full utility service territory; CIRCUIT and SUBSTATION represent distribution-level granularity; PUC_TERRITORY aligns with regulatory jurisdiction boundaries; OPERATING_AREA represents internal operational divisions."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reliability Reporting Level" ;
    cmm:validValues "SYSTEM|CIRCUIT|SUBSTATION|PUC_TERRITORY|OPERATING_AREA" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.reportingPeriodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting period code"@en ;
    rdfs:comment "Externally-known business identifier for the reporting period, encoding the period type and calendar reference (e.g., MONTHLY-2024-03, QUARTERLY-2024-Q1, ANNUAL-2024). Used as the primary business key for regulatory filings and cross-system reconciliation."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_period_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Period Code" ;
    cmm:valuePattern "^(MONTHLY|QUARTERLY|ANNUAL)-[0-9]{4}(-Q[1-4]|-[0-1][0-9])?$" ;
    cmm:cimDatatype "String" .
cmm:ReliabilityIndexPeriod.saidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi minutes"@en ;
    rdfs:comment "System Average Interruption Duration Index expressed in minutes per customer. Computed as total_customer_minutes_interrupted divided by customers_served. Represents the average total duration of interruptions experienced per customer during the reporting period. Primary reliability metric for PUC regulatory filings and NERC benchmarking."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.saidiNormalizedMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi normalized minutes"@en ;
    rdfs:comment "SAIDI value computed after excluding Major Event Day (MED) interruptions per IEEE 1366 normalization methodology. Computed as (total_customer_minutes_interrupted minus med_excluded_customer_minutes) divided by customers_served. This is the primary metric used for year-over-year performance benchmarking and PUC performance standard compliance."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_normalized_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1366 Normalized SAIDI (Excluding Major Event Days) in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.saifiIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi index"@en ;
    rdfs:comment "System Average Interruption Frequency Index expressed as interruptions per customer. Computed as total_customer_interruptions divided by customers_served. Represents the average number of interruptions experienced per customer during the reporting period. Key reliability metric for PUC regulatory filings."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI)" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.saifiNormalizedIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi normalized index"@en ;
    rdfs:comment "SAIFI value computed after excluding Major Event Day (MED) interruptions per IEEE 1366 normalization methodology. Computed as (total_customer_interruptions minus med_excluded_customer_interruptions) divided by customers_served. Used for PUC performance standard compliance and NERC benchmarking."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_normalized_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1366 Normalized SAIFI (Excluding Major Event Days)" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.stormRelatedOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm related outage events"@en ;
    rdfs:comment "Number of outage events during the reporting period that were classified as storm-related (weather-caused). Supports storm impact analysis, MED classification validation, and regulatory storm reporting requirements. Sourced from OMS event cause codes."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "storm_related_outage_events" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm-Related Outage Events Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.thirdPartyOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "third party outage events"@en ;
    rdfs:comment "Number of outage events during the reporting period caused by third parties (e.g., vehicle accidents, dig-ins, animal contacts, vegetation encroachment by non-utility parties). Some PUC jurisdictions allow exclusion of third-party caused outages from performance standard calculations."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "third_party_outage_events" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Third-Party Caused Outage Events Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.totalCustomerInterruptions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total customer interruptions"@en ;
    rdfs:comment "Total number of customer interruptions (sum of customers affected across all outage events) during the reporting period. This is the numerator for SAIFI calculation. Each customer affected by each distinct outage event counts as one interruption."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_customer_interruptions" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Customer Interruptions" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.totalCustomerMinutesInterrupted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total customer minutes interrupted"@en ;
    rdfs:comment "Sum of the product of customers affected multiplied by outage duration in minutes across all outage events in the reporting period. This is the numerator for SAIDI calculation, expressed in customer-minutes. Also referred to as Customer Minutes of Interruption (CMI) in regulatory filings."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_customer_minutes_interrupted" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Customer Minutes Interrupted (CMI)" ;
    cmm:cimDatatype "Decimal" .
cmm:ReliabilityIndexPeriod.totalOutageEvents a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total outage events"@en ;
    rdfs:comment "Total number of distinct outage events (interruption incidents) that occurred within the reporting entity boundary during the reporting period. Provides context for interpreting SAIDI and SAIFI values and supports frequency-based reliability analysis."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_outage_events" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Outage Events Count" ;
    cmm:cimDatatype "Integer" .
cmm:ReliabilityIndexPeriod.unplannedInterruptionCustomerMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unplanned interruption customer minutes"@en ;
    rdfs:comment "Customer minutes interrupted attributable to unplanned (forced/fault) outage events during the reporting period. Unplanned interruptions are the primary driver of reliability index degradation and are the focus of most PUC performance standards."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unplanned_interruption_customer_minutes" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unplanned Interruption Customer Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ReliabilityIndexPeriod.versionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version number"@en ;
    rdfs:comment "Sequential version number incremented each time this reliability index period record is amended or recomputed. Version 1 represents the initial filing; subsequent versions represent amendments. Supports regulatory amendment tracking and audit trail requirements."@en ;
    rdfs:domain cmm:ReliabilityIndexPeriod ; rdfs:range xsd:int ;
    cmm:physicalColumn "version_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Version Number" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Document.revisionNumber .

cmm:OutagePrediction a owl:Class ;
    rdfs:label "Outage Prediction"@en ;
    rdfs:comment "Operational record of a system-generated or dispatcher-created predicted outage scope at the time of initial event creation, capturing estimated number of affected customers, predicted cause, predicted affected circuit segments, confidence level, and prediction source (AMI ping, SCADA alarm, customer call clustering, predictive model). Distinct from the actual outage event — represents the initial assessment used for crew pre-positioning and ETR communication before field confirmation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Incident ;
    cmm:cimCloseMatch cim:Incident ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.prediction" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEC 61968-3; Predicted Outage (GE PowerOn ADMS Predictive Outage)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.prediction" ;
    owl:hasKey ( cmm:OutagePrediction.predictionId ) .

cmm:OutagePrediction.predictionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prediction id"@en ;
    rdfs:comment "Unique surrogate identifier for the outage prediction record. Primary key for this entity in the Silver Layer lakehouse."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:long ;
    cmm:physicalColumn "prediction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Prediction ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutagePrediction.circuitFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "circuit feeder"@en ;
    rdfs:comment "Identifier of the primary distribution circuit predicted to be affected by the outage. Sourced from the GIS network model and used for crew routing and switching order preparation."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "circuit_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Circuit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_circuit_feeder_id" ;
    cmm:cimAssociation "Incident.Feeder" .
cmm:OutagePrediction.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation associated with the predicted outage scope. Used for crew dispatch routing and switching order coordination."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_distribution_substation_id" ;
    cmm:cimAssociation "Incident.Substation" .
cmm:OutagePrediction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the system operator or dispatcher who created or last modified this prediction record when prediction_source is 'dispatcher_manual'. Provides accountability and audit trail for manually-entered predictions."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispatcher ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_employee_id" ;
    cmm:cimAssociation "Incident.ErpPersonnel" .
cmm:OutagePrediction.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder predicted to be affected. A feeder is a primary distribution line segment fed from a substation bus. Used for network topology analysis and switching order preparation."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_feeder_id" ;
    cmm:cimAssociation "Incident.Feeder" .
cmm:OutagePrediction.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Predictive outage management systems integrate load forecasts to estimate customer impact (count, MW interrupted) and prioritize response. Advanced OMS platforms reference specific load forecast runs"@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_load_id" ;
    cmm:cimAssociation "Incident.ConformLoadSchedule" .
cmm:OutagePrediction.omsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "oms event"@en ;
    rdfs:comment "Externally-known identifier assigned by the Outage Management System (OMS) to the predicted outage event. Used to correlate this prediction record with the OMS event lifecycle and downstream actual outage records."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "oms_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Management System (OMS) Event ID" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_oms_event_id" ;
    cmm:cimAssociation "Incident.Outage" .
cmm:OutagePrediction.predictiveModel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "predictive model"@en ;
    rdfs:comment "Identifier of the predictive analytics model version that generated this prediction, when prediction_source is 'predictive_model'. Enables model performance tracking, auditability, and retraining feedback loops."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:ForecastModel ;
    cmm:physicalColumn "predictive_model_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Predictive Model ID" ;
    cmm:sourceColumn "model_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_predictive_model_id" ;
    cmm:cimAssociation "Incident.Document" .
cmm:OutagePrediction.scadaAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada alarm"@en ;
    rdfs:comment "Identifier of the SCADA (Supervisory Control and Data Acquisition) alarm that triggered or corroborated this outage prediction. Provides traceability back to the real-time operational data historian (OSIsoft PI) or ADMS alarm log."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "scada_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "SCADA Alarm ID" ;
    cmm:sourceColumn "ems_alarm_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_scada_alarm_id" ;
    cmm:cimAssociation "Incident.ActivityRecord" .
cmm:OutagePrediction.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Reference to the regulated service territory within which the predicted outage falls. Used for regulatory reporting to State Public Utility Commissions (PUCs) and SAIDI/SAIFI/CAIDI performance tracking."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_service_territory_id" ;
    cmm:cimAssociation "Incident.SubGeographicalRegion" .
cmm:OutagePrediction.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Reference to the storm or major weather event record associated with this prediction, if applicable. Links the prediction to the storm response management workflow for resource mobilization and regulatory major event day (MED) classification."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_storm_event_id" ;
    cmm:cimAssociation "Incident.Incident" .
cmm:OutagePrediction.weatherInput a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "weather input"@en ;
    rdfs:comment "Foreign key linking to forecast.weather_input. Business justification: Outage prediction models consume weather forecast inputs (wind speed, precipitation, temperature) to predict storm-related outage likelihood and severity. Utilities use this linkage for storm prepared"@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range cmm:WeatherInput ;
    cmm:physicalColumn "weather_input_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Weather Forecast Input Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_prediction_weather_input_id" ;
    cmm:cimAssociation "Incident.EnvironmentalAnalog" .
cmm:OutagePrediction.amiMeterCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami meter count"@en ;
    rdfs:comment "Number of Advanced Metering Infrastructure (AMI) smart meters within the predicted outage scope that contributed last-gasp or ping-failure signals to the prediction. Indicates the AMI signal density supporting the prediction confidence."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:int ;
    cmm:physicalColumn "ami_meter_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Meter Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutagePrediction.confidenceLevelPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level pct"@en ;
    rdfs:comment "Numeric confidence score (0.00–100.00) representing the model's or system's certainty in the predicted outage scope, cause, and affected area. Higher values indicate greater confidence. Used to prioritize crew dispatch and ETR communication decisions."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_level_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prediction Confidence Level Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:OutagePrediction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Audit timestamp recording when this outage prediction record was first persisted in the data platform. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Incident.createdDateTime .
cmm:OutagePrediction.crewPreplacementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew preplacement flag"@en ;
    rdfs:comment "Indicates whether field crews have been pre-positioned based on this outage prediction prior to field confirmation of the actual outage. When True, crew dispatch records are linked to this prediction in the workforce management system."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "crew_preplacement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Pre-Placement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.criticalCustomerFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical customer flag"@en ;
    rdfs:comment "Indicates whether the predicted outage scope includes one or more critical customers (e.g., hospitals, emergency services, life-support customers, large industrial accounts with SLA obligations). When True, triggers priority restoration protocols and mandatory customer notification."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_customer_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.customerCallCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer call count"@en ;
    rdfs:comment "Number of inbound customer outage calls received and clustered to generate or corroborate this prediction. Used to assess the customer-reported signal strength and prioritize crew dispatch."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_call_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Outage Call Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutagePrediction.derImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der impact flag"@en ;
    rdfs:comment "Indicates whether the predicted outage scope includes Distributed Energy Resources (DERs) such as rooftop solar, battery storage, or microgrids that may be islanded or require isolation procedures. When True, DERMS coordination is required."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.expiryTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiry timestamp"@en ;
    rdfs:comment "Date and time after which this prediction is considered stale and should no longer be used for crew dispatch or ETR communication without refresh. Typically set to a configurable window (e.g., 2 hours) after prediction_timestamp. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "expiry_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prediction Expiry Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePrediction.flisrEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr eligible flag"@en ;
    rdfs:comment "Indicates whether the predicted outage scope is within a network segment eligible for automated Fault Location, Isolation, and Service Restoration (FLISR) execution via the ADMS. When True, automated switching sequences may be initiated without manual dispatcher intervention."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.majorEventDayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event day flag"@en ;
    rdfs:comment "Indicates whether this prediction is associated with a Major Event Day (MED) as defined by IEEE 1366. MED events are excluded from standard SAIDI/SAIFI/CAIDI calculations and reported separately to state PUCs and NERC."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_day_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.medicalBaselineCustomerFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical baseline customer flag"@en ;
    rdfs:comment "Indicates whether the predicted outage scope includes customers enrolled in a medical baseline or life-support program. When True, triggers mandatory proactive notification and priority restoration per state PUC regulations."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "medical_baseline_customer_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Baseline Customer Flag" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Indicates whether an outage notification has been sent to affected customers based on this prediction. When True, the notification timestamp and channel are tracked in the customer notification log. Supports state PUC notification compliance reporting."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePrediction.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "Date and time at which the first customer notification was dispatched based on this outage prediction. Used for state PUC compliance reporting on notification timeliness. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePrediction.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the predicted outage by its nature. 'unplanned' = unexpected equipment or system failure; 'planned' = scheduled maintenance window; 'storm' = weather-driven event; 'momentary' = predicted to be a brief interruption (< 5 minutes per IEEE 1366); 'sustained' = predicted to exceed the momentary threshold."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "unplanned|planned|storm|momentary|sustained" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictedAffectedSegments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted affected segments"@en ;
    rdfs:comment "Comma-delimited list of distribution circuit segment identifiers predicted to be de-energized. Sourced from the GIS network model topology analysis. Used for switching order preparation and crew routing."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "predicted_affected_segments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Affected Circuit Segments" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictedCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted cause code"@en ;
    rdfs:comment "Standardized cause code representing the predicted root cause of the outage at time of initial assessment (e.g., equipment failure, tree contact, animal contact, weather, vehicle accident, unknown). Aligned with IEEE 1366 cause code taxonomy. Reference-value candidates: equipment_failure|tree_contact|animal_contact|weather|vehicle_accident|planned_maintenance|unknown|overload|lightning|ice_loading."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "predicted_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictedCauseDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted cause description"@en ;
    rdfs:comment "Free-text narrative describing the predicted cause of the outage as assessed at the time of prediction creation. Supplements the structured cause code with dispatcher or model-generated context."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "predicted_cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Outage Cause Description" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted customer count"@en ;
    rdfs:comment "Estimated number of customers predicted to be without power based on the initial assessment. Used for crew pre-positioning, ETR communication, and SAIDI/SAIFI/CAIDI impact estimation. Distinct from the confirmed customer count on the actual outage event record."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:int ;
    cmm:physicalColumn "predicted_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutagePrediction.predictedEtr a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted etr"@en ;
    rdfs:comment "Initial estimated date and time by which power is predicted to be restored to affected customers. Communicated to customers and field crews at the time of prediction creation. Distinct from the revised ETR updated during active restoration. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "predicted_etr" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Estimated Time to Restore (ETR)" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePrediction.predictedFaultLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted fault latitude"@en ;
    rdfs:comment "WGS-84 decimal latitude coordinate of the predicted fault location. Used for GIS-based crew dispatch and outage mapping."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "predicted_fault_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Predicted Fault Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:OutagePrediction.predictedFaultLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted fault location"@en ;
    rdfs:comment "Predicted geographic or network location of the fault, expressed as a GIS asset identifier, address, or coordinate reference. Used to direct first-responder crews to the most probable fault point before field confirmation."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "predicted_fault_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Fault Location" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictedFaultLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted fault longitude"@en ;
    rdfs:comment "WGS-84 decimal longitude coordinate of the predicted fault location. Used for GIS-based crew dispatch and outage mapping."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "predicted_fault_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Predicted Fault Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:OutagePrediction.predictedLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted load mw"@en ;
    rdfs:comment "Estimated megawatts (MW) of load predicted to be interrupted based on the affected circuit segments and customer mix. Used for grid operations impact assessment and load restoration prioritization."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "predicted_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Interrupted Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OutagePrediction.predictedOutageDurationMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predicted outage duration min"@en ;
    rdfs:comment "Estimated duration of the outage in minutes as assessed at the time of prediction creation. Derived from historical restoration times for similar cause codes and circuit configurations. Used for CAIDI estimation and crew resource planning."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:int ;
    cmm:physicalColumn "predicted_outage_duration_min" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predicted Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:OutagePrediction.predictionSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prediction source"@en ;
    rdfs:comment "The originating signal or mechanism that triggered the outage prediction. 'ami_ping' = Advanced Metering Infrastructure (AMI) last-gasp or ping failure; 'scada_alarm' = SCADA system alarm from field device; 'customer_call_cluster' = clustering of inbound customer outage calls; 'predictive_model' = ML/analytics model output; 'dispatcher_manual' = manually entered by a system operator or dispatcher; 'smart_meter_outage_notification' = direct outage notification from smart meter."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "prediction_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Prediction Source" ;
    cmm:validValues "ami_ping|scada_alarm|customer_call_cluster|predictive_model|dispatcher_manual|smart_meter_outage_notification" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.predictionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prediction status"@en ;
    rdfs:comment "Current lifecycle state of the outage prediction record. 'pending' = generated but not yet dispatched; 'active' = in use for crew pre-positioning and ETR communication; 'confirmed' = field crew has validated the predicted scope; 'superseded' = replaced by a newer prediction; 'cancelled' = prediction voided before confirmation; 'expired' = prediction window elapsed without field confirmation."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "prediction_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Prediction Status" ;
    cmm:validValues "pending|active|confirmed|superseded|cancelled|expired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Incident.status .
cmm:OutagePrediction.predictionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prediction timestamp"@en ;
    rdfs:comment "The date and time at which the outage prediction was system-generated or dispatcher-created. Represents the principal real-world event time for this prediction record. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "prediction_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Prediction Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePrediction.predictiveModelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "predictive model version"@en ;
    rdfs:comment "Version string of the predictive analytics model that generated this prediction. Used alongside predictive_model_id for model governance, auditability, and performance benchmarking."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "predictive_model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Predictive Model Version" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.protectionZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection zone"@en ;
    rdfs:comment "The protection zone or relay zone within which the predicted fault is located. Used by switching order coordinators to identify the correct protective device (recloser, fuse, breaker) to operate for isolation and restoration."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Zone" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the operational system of record that originated this outage prediction record. Used for data lineage, reconciliation, and Silver Layer provenance tracking."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "GE_POWERON_ADMS|OSI_PI|ORACLE_MDM|SAP_ISU|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Audit timestamp recording when this outage prediction record was last modified in the data platform. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutagePrediction.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Voltage classification of the network segment predicted to be affected. Determines the severity tier, crew qualification requirements, and regulatory reporting category."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level" ;
    cmm:validValues "transmission|sub_transmission|primary_distribution|secondary_distribution" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.weatherConditionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition code"@en ;
    rdfs:comment "Standardized code representing the weather conditions at the time of prediction creation (e.g., clear, wind, ice, lightning, flood). Used for cause analysis, storm classification, and reliability reporting. Reference-value candidates: clear|wind|ice|lightning|flood|snow|extreme_heat|fog|tornado|hurricane."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition Code" ;
    cmm:cimDatatype "String" .
cmm:OutagePrediction.windSpeedMph a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind speed mph"@en ;
    rdfs:comment "Recorded or forecast wind speed in miles per hour at the predicted fault location at the time of prediction creation. Used for storm severity assessment and major event day (MED) classification."@en ;
    rdfs:domain cmm:OutagePrediction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wind_speed_mph" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Speed (MPH)" ;
    cmm:unitSymbol "mph" ;
    cmm:cimDatatype "Speed" .

cmm:EtrRevision a owl:Class ;
    rdfs:label "Etr Revision"@en ;
    rdfs:comment "Record of each revision to the Estimated Time of Restoration (ETR) for an outage event. Captures revision sequence number, previous ETR, revised ETR, revision timestamp, revision reason code, issuing dispatcher, and whether customer notifications were triggered by the revision. Enables ETR accuracy tracking, customer communication audit trail, and dispatcher performance review."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:EstimatedRestorationTime ;
    cmm:cimExactMatch cim:EstimatedRestorationTime ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.etr_revision" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; ETR Management (GE PowerOn ADMS OMS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.etr_revision" ;
    owl:hasKey ( cmm:EtrRevision.etrRevisionId ) .

cmm:EtrRevision.etrRevisionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "etr revision id"@en ;
    rdfs:comment "Unique surrogate identifier for each ETR revision record within the outage management system. Primary key for the etr_revision data product."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:long ;
    cmm:physicalColumn "etr_revision_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Estimated Time of Restoration (ETR) Revision ID" ;
    cmm:cimDatatype "Integer" .
cmm:EtrRevision.affectedFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "affected feeder"@en ;
    rdfs:comment "Reference to the primary distribution feeder affected by the outage event at the time of this ETR revision. Supports feeder-level reliability analysis and SAIDI/SAIFI/CAIDI reporting."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "affected_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Affected Distribution Feeder ID" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_affected_feeder_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.Feeder" .
cmm:EtrRevision.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the dispatcher or control room operator who issued this ETR revision. Supports dispatcher performance review and accountability tracking."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispatcher ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_employee_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.ErpPersonnel" .
cmm:EtrRevision.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event for which this ETR revision was issued. Links the revision to its originating outage lifecycle record in the OMS."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_event_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.Outage" .
cmm:EtrRevision.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Reference to the switching order associated with the restoration effort at the time of this ETR revision. Links the ETR revision to the specific switching sequence being executed. Null if no switching order was active."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Switching Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_outage_switching_order_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.SwitchingPlan" .
cmm:EtrRevision.regulatoryCorrespondence a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory correspondence"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_correspondence. Business justification: ETR revisions for major outages may require regulatory notifications or explanations to PUC regarding restoration delays. Customer service and regulatory affairs teams document regulatory communicatio"@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:RegulatoryCorrespondence ;
    cmm:physicalColumn "regulatory_correspondence_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Correspondence Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_regulatory_correspondence_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.Document" .
cmm:EtrRevision.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the field work order created for the restoration effort associated with this ETR revision. Links to the asset management and workforce management system for crew and material tracking."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_etr_revision_work_order_id" ;
    cmm:cimAssociation "EstimatedRestorationTime.Work" .
cmm:EtrRevision.autoGenerated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto generated"@en ;
    rdfs:comment "Indicates whether this ETR revision was automatically generated by the OMS/ADMS system (e.g., via predictive restoration algorithms or rule-based triggers) rather than manually entered by a dispatcher. True if system-generated; False if manually entered."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_generated" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Generated ETR Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.confidenceLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level"@en ;
    rdfs:comment "Dispatcher or system-assigned confidence level for the revised ETR at the time of issuance. Reflects the degree of certainty based on available information (crew on-site, damage assessment status, resource availability). Used in ETR accuracy analytics."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "confidence_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Confidence Level" ;
    cmm:validValues "HIGH|MEDIUM|LOW|UNKNOWN" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time at which this ETR revision record was first created in the data platform. Serves as the audit trail creation timestamp for the Silver layer record. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:EstimatedRestorationTime.createdDateTime .
cmm:EtrRevision.crewDispatched a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatched"@en ;
    rdfs:comment "Indicates whether a field crew had been dispatched to the outage location at the time this ETR revision was issued. True if crew dispatch had occurred; False if crew was not yet dispatched. Supports correlation between crew availability and ETR accuracy."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "crew_dispatched" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Dispatched Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.crewOnSite a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew on site"@en ;
    rdfs:comment "Indicates whether a field crew had arrived on-site at the outage location at the time this ETR revision was issued. True if crew was confirmed on-site; False otherwise. Supports analysis of ETR accuracy improvement after crew arrival."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "crew_on_site" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew On-Site Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.customerNotificationTriggered a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer notification triggered"@en ;
    rdfs:comment "Indicates whether this ETR revision triggered an outbound customer notification (SMS, IVR, email, or web portal update). True if notifications were dispatched; False if the revision was internal only. Supports customer communication audit trail."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_notification_triggered" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Triggered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customer service points affected by the outage event at the time this ETR revision was issued. May change between revisions as the outage scope is refined. Used for prioritization and SAIDI/SAIFI/CAIDI reliability metric calculations."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:EtrRevision.customersRestoredCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored count"@en ;
    rdfs:comment "Cumulative number of customer service points that had been restored at the time this ETR revision was issued. Enables tracking of restoration progress across the outage lifecycle and supports CAIDI calculation."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:EtrRevision.damageAssessmentComplete a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage assessment complete"@en ;
    rdfs:comment "Indicates whether a formal damage assessment had been completed prior to this ETR revision. True if damage assessment was finalized; False if the revision was issued before full assessment. ETR revisions post-assessment are typically more accurate."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "damage_assessment_complete" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Damage Assessment Complete Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.dispatcherNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatcher notes"@en ;
    rdfs:comment "Free-text operational notes entered by the dispatcher at the time of this ETR revision. May include field crew communications, equipment status updates, or coordination details not captured in structured fields. Supports dispatcher performance review and post-event analysis."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatcher_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatcher Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EtrRevision.estimatedMwInterrupted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated mw interrupted"@en ;
    rdfs:comment "Estimated load in megawatts (MW) interrupted by the outage event at the time of this ETR revision. Used for NERC EOP-004 regulatory reporting thresholds and for grid impact assessment."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_mw_interrupted" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Megawatts (MW) Interrupted" ;
    cmm:cimDatatype "Decimal" .
cmm:EtrRevision.etrShiftMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "etr shift minutes"@en ;
    rdfs:comment "Signed integer representing the change in estimated restoration time in minutes between the previous ETR and the revised ETR. Positive values indicate a later restoration estimate; negative values indicate an earlier estimate. Derived at ingestion for analytical convenience — not a KPI aggregate."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "etr_shift_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Shift Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:EtrRevision.mutualAidRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid requested"@en ;
    rdfs:comment "Indicates whether mutual aid from neighboring utilities or contractors had been requested for this outage event at the time of this ETR revision. True if mutual aid was requested; False otherwise. Mutual aid requests often correlate with extended ETR windows."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mutual_aid_requested" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Requested Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.nercEventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc event type"@en ;
    rdfs:comment "NERC EOP-004 event type classification applicable to the outage at the time of this ETR revision. Populated only when regulatory_reportable is True. Reference-value candidates: LOSS_OF_LOAD|TRANSMISSION_LOSS|GENERATION_LOSS|VOLTAGE_DEVIATION|FREQUENCY_DEVIATION|CYBER_SECURITY|PHYSICAL_SECURITY|NATURAL_DISASTER."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Event Type" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "Primary channel through which customer notifications were dispatched for this ETR revision. Null or NONE if customer_notification_triggered is False. Supports multi-channel communication audit and regulatory compliance reporting."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Channel" ;
    cmm:validValues "SMS|IVR|EMAIL|WEB_PORTAL|NONE" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "Date and time at which customer notifications were dispatched following this ETR revision. Null if no notification was triggered. Enables measurement of lag between ETR revision and customer communication. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EtrRevision.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "External incident number assigned by the GE PowerOn ADMS Outage Management System to the parent outage event. Serves as the cross-system business identifier for traceability between the OMS and downstream reporting systems."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EtrRevision.outageCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage cause code"@en ;
    rdfs:comment "Standardized cause code for the outage event as known at the time of this ETR revision. May be updated across revisions as field crews refine the root cause. Aligns with IEEE 1366 cause code taxonomy. Reference-value candidates: WEATHER|EQUIPMENT_FAILURE|TREE_CONTACT|ANIMAL_CONTACT|VEHICLE_ACCIDENT|PLANNED_MAINTENANCE|UNKNOWN|THIRD_PARTY|OVERLOAD|LIGHTNING."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage event type at the time of this ETR revision. UNPLANNED covers unexpected equipment failures; PLANNED covers scheduled maintenance windows; STORM covers major weather events; EMERGENCY covers safety-driven de-energizations."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "UNPLANNED|PLANNED|STORM|EMERGENCY" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.partialRestorationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "partial restoration flag"@en ;
    rdfs:comment "Indicates whether a partial restoration of service had been achieved for a subset of affected customers prior to this ETR revision being issued. True if partial restoration was in effect; False if no customers had been restored yet."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "partial_restoration_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Partial Restoration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.previousEtr a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "previous etr"@en ;
    rdfs:comment "The ETR value that was in effect immediately before this revision was applied. Null for the initial ETR issuance (revision_sequence_number = 1). Enables before/after comparison for ETR accuracy analysis. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "previous_etr" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Previous Estimated Time of Restoration (ETR)" ;
    cmm:cimDatatype "DateTime" .
cmm:EtrRevision.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Restoration priority assigned to the outage event at the time of this ETR revision. CRITICAL typically covers medical baseline customers, hospitals, or critical infrastructure; HIGH covers large commercial/industrial customers; MEDIUM and LOW cover standard residential and commercial segments."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Restoration Priority Level" ;
    cmm:validValues "CRITICAL|HIGH|MEDIUM|LOW" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:EtrRevision.regulatoryReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable"@en ;
    rdfs:comment "Indicates whether the parent outage event meets the threshold for mandatory regulatory reporting to NERC, FERC, or State PUC at the time of this ETR revision. True if reportable thresholds (e.g., customer count, duration, MW lost) are met; False otherwise."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.revisedEtr a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revised etr"@en ;
    rdfs:comment "The new ETR value established by this revision. Represents the dispatcher's best estimate of when service will be restored to affected customers at the time of revision. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "revised_etr" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revised Estimated Time of Restoration (ETR)" ;
    cmm:cimDatatype "DateTime" .
cmm:EtrRevision.revisionReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision reason code"@en ;
    rdfs:comment "Standardized code indicating the primary reason for this ETR revision. Used for root-cause analysis of ETR accuracy and dispatcher performance reporting. Reference-value candidates: INITIAL_ESTIMATE|CREW_ASSESSMENT|SCOPE_CHANGE|RESOURCE_DELAY|WEATHER_UPDATE|RESTORATION_PARTIAL|EQUIPMENT_COMPLEXITY|SAFETY_HOLD|MUTUAL_AID_DELAY|DAMAGE_REASSESSMENT."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Revision Reason Code" ;
    cmm:validValues "INITIAL_ESTIMATE|CREW_ASSESSMENT|SCOPE_CHANGE|RESOURCE_DELAY|WEATHER_UPDATE|RESTORATION_PARTIAL" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.revisionReasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision reason description"@en ;
    rdfs:comment "Free-text narrative provided by the dispatcher explaining the specific circumstances that necessitated this ETR revision. Supplements the structured reason code with operational context."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Revision Reason Description" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.revisionSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision sequence number"@en ;
    rdfs:comment "Ordinal sequence number of this revision within the outage event, starting at 1 for the initial ETR issuance. Enables chronological ordering of all ETR revisions for a given outage and supports ETR accuracy trend analysis."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "revision_sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Revision Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:EtrRevision.revisionSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision source"@en ;
    rdfs:comment "Indicates the originating source of this ETR revision — whether it was manually entered by a dispatcher, automatically generated by the OMS/ADMS system, submitted by a field crew, escalated by a supervisor, or issued from a storm operations center."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Revision Source" ;
    cmm:validValues "DISPATCHER|SYSTEM_AUTO|CREW_FIELD|SUPERVISOR|STORM_CENTER" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.revisionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision status"@en ;
    rdfs:comment "Current lifecycle status of this ETR revision record. ACTIVE indicates the revision is the current operative ETR; SUPERSEDED indicates it has been replaced by a later revision; CANCELLED indicates the revision was voided; FINAL indicates the outage has been restored and this was the last ETR."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "ETR Revision Status" ;
    cmm:validValues "ACTIVE|SUPERSEDED|CANCELLED|FINAL" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EstimatedRestorationTime.status .
cmm:EtrRevision.revisionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision timestamp"@en ;
    rdfs:comment "Date and time (with timezone offset) at which this ETR revision was recorded in the OMS. Serves as the principal business event timestamp for the revision lifecycle. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "revision_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ETR Revision Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EtrRevision.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "Incremental SAIDI contribution in customer-minutes attributable to this outage event as projected at the time of this ETR revision, calculated as (customers_affected_count × projected_duration_minutes) / total_customers_served. Supports real-time reliability index tracking."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:EtrRevision.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the regulated service territory within which the outage event occurred. Used for jurisdictional regulatory reporting to State PUCs and for territory-level reliability benchmarking."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the operational system of record from which this ETR revision record was sourced. Supports data lineage tracking and Silver layer provenance in the Databricks Lakehouse."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "GE_POWERON_ADMS|SAP_ISU|ORACLE_CC_B|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:EtrRevision.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this ETR revision was issued during an active declared storm event or major weather emergency. True if a storm event declaration was active; False for normal operations. Supports storm vs. non-storm ETR accuracy benchmarking."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EtrRevision.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Every ETR revision is for a specific outage event. Required for ETR accuracy tracking and customer communication audit."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:EtrRevision.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time at which this ETR revision record was last modified in the data platform. Supports audit trail and change tracking for the Silver layer. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EtrRevision.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) of the affected circuit or equipment at the time of this ETR revision. Distinguishes transmission-level (>69 kV) from distribution-level (<69 kV) outages for regulatory classification and restoration complexity assessment."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:EtrRevision.weatherConditionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition code"@en ;
    rdfs:comment "Standardized weather condition code recorded at the time of this ETR revision. Used to correlate ETR accuracy and outage duration with prevailing weather conditions for storm hardening and reliability planning. Reference-value candidates: CLEAR|WIND|RAIN|ICE|SNOW|LIGHTNING|EXTREME_HEAT|FLOOD."@en ;
    rdfs:domain cmm:EtrRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition Code" ;
    cmm:cimDatatype "String" .

cmm:OutageCall a owl:Class ;
    rdfs:label "Outage Call"@en ;
    rdfs:comment "Record of an inbound customer trouble call or AMI-generated outage report received by the utility, used to initiate or corroborate an outage event. Captures call receipt timestamp, source type (IVR, agent, AMI ping, mobile app, web portal), reported symptom, caller account reference, associated outage event (once matched), call disposition, and whether the call was a duplicate of an existing event. Feeds OMS call clustering and outage prediction logic."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TroubleTicket ;
    cmm:cimExactMatch cim:TroubleTicket ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.call" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEC 61968-8; Trouble Call (GE PowerOn ADMS / Oracle CC&B CIS)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.call" ;
    owl:hasKey ( cmm:OutageCall.callId ) .

cmm:OutageCall.callId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "call id"@en ;
    rdfs:comment "Unique surrogate identifier for each inbound customer trouble call or AMI-generated outage report record in the Outage Management System (OMS). Primary key for this entity."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:long ;
    cmm:physicalColumn "call_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Call ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCall.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the utility customer account associated with the caller or AMI device that originated this outage report. Links to the Customer Information System (CIS) account record."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_account_id" ;
    cmm:cimAssociation "TroubleTicket.CustomerAccount" .
cmm:OutageCall.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation serving the reported outage location, resolved from the GIS network model. Used for geographic grouping of calls, outage event scoping, and storm response coordination."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_distribution_substation_id" ;
    cmm:cimAssociation "TroubleTicket.Substation" .
cmm:OutageCall.duplicateOfCall a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "duplicate of call"@en ;
    rdfs:comment "Reference to the original (first-received) outage call record of which this call is a duplicate. Populated only when is_duplicate = True. Enables deduplication lineage tracing in OMS call clustering."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:OutageCall ;
    cmm:physicalColumn "duplicate_of_call_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Duplicate Of Call ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_duplicate_of_call_id" ;
    cmm:cimAssociation "TroubleTicket.TroubleTicket" .
cmm:OutageCall.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Employee identifier of the call center agent who received and logged this trouble call. Populated only when call_source_type = AGENT. Used for quality assurance, workforce management, and call handling performance reporting."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Call Center Agent ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_employee_id" ;
    cmm:cimAssociation "TroubleTicket.ErpPersonnel" .
cmm:OutageCall.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event record once this call has been matched or clustered to a confirmed outage event in the OMS. Null until the call is correlated to an event."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_event_id" ;
    cmm:cimAssociation "TroubleTicket.Outage" .
cmm:OutageCall.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution circuit (feeder) serving the reported outage location, resolved from the GIS network model based on the service address or premise. Used for OMS call clustering by circuit and outage event correlation."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Circuit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_feeder_id" ;
    cmm:cimAssociation "TroubleTicket.Feeder" .
cmm:OutageCall.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the smart meter or AMI endpoint that generated an automated outage ping or last-gasp signal, if the call source is AMI-initiated rather than a human caller."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_meter_id" ;
    cmm:cimAssociation "TroubleTicket.Meter" .
cmm:OutageCall.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the utility service premise (physical delivery point) associated with the reported outage location. Links to the GIS/network model for spatial outage clustering and distribution circuit identification."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_premise_id" ;
    cmm:cimAssociation "TroubleTicket.ServiceLocation" .
cmm:OutageCall.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Reference to the declared storm or major weather event record associated with this outage call, when weather_event_flag = True. Links to the storm event management entity for storm response coordination and MED exclusion processing."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_call_storm_event_id" ;
    cmm:cimAssociation "TroubleTicket.Incident" .
cmm:OutageCall.affectedCustomersReported a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customers reported"@en ;
    rdfs:comment "Number of customers the caller reports as being affected by the outage (e.g., 'my whole street is out'). This is a caller-provided estimate, not a system-confirmed count. Used as an early indicator for outage scope assessment and crew dispatch prioritization."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customers_reported" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageCall.amiDeviceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami device code"@en ;
    rdfs:comment "Unique identifier of the AMI endpoint (smart meter) that generated an automated last-gasp outage notification or power-off ping. Populated only when call_source_type = AMI_PING. Used to correlate AMI-detected outages with customer account and network topology."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "ami_device_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.amiSignalType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami signal type"@en ;
    rdfs:comment "Type of automated signal received from the AMI endpoint that triggered this outage report. LAST_GASP = meter-detected power loss notification; POWER_RESTORE = meter-detected power restoration; TAMPER = tamper event; BLINK = momentary interruption blink count; POWER_QUALITY = voltage sag/swell event. Populated only when call_source_type = AMI_PING."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "ami_signal_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Signal Type" ;
    cmm:validValues "LAST_GASP|POWER_RESTORE|TAMPER|BLINK|POWER_QUALITY" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.callStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "call status"@en ;
    rdfs:comment "Current lifecycle status of the outage call record within the OMS workflow. RECEIVED = call logged, not yet processed; PENDING_MATCH = awaiting correlation to an outage event; MATCHED = successfully linked to an outage event; DUPLICATE = identified as a duplicate of an existing call or event; CLOSED = call resolved and closed; CANCELLED = call withdrawn or invalid."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "call_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Call Status" ;
    cmm:validValues "RECEIVED|PENDING_MATCH|MATCHED|DUPLICATE|CLOSED|CANCELLED" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TroubleTicket.status .
cmm:OutageCall.callerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caller name"@en ;
    rdfs:comment "Full name of the individual who placed the trouble call, as provided at time of call. May differ from the account holder name if a third party is reporting on behalf of the customer. Classified as confidential PII per GDPR/CCPA."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "caller_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Caller Name" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_name" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.callerPhoneNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caller phone number"@en ;
    rdfs:comment "Phone number provided by or captured from the caller at time of call receipt. Used for call-back confirmation and customer notification of restoration. Classified as restricted PII per GDPR/CCPA."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "caller_phone_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Caller Phone Number" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_phone" ;
    cmm:valuePattern "^\\+?[0-9\\s\\-().]{7,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCall.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time at which this outage call record was first created in the data platform (Silver Layer ingestion timestamp). Serves as the audit creation timestamp for data lineage and regulatory record-keeping. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:TroubleTicket.createdDateTime .
cmm:OutageCall.customerClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer class"@en ;
    rdfs:comment "Classification of the customer associated with this outage call by service type. Used for restoration prioritization, regulatory reporting, and SAIDI/SAIFI index segmentation per IEEE 1366 and PUC requirements."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Class" ;
    cmm:validValues "RESIDENTIAL|COMMERCIAL|INDUSTRIAL|AGRICULTURAL|MUNICIPAL" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Indicates the data quality status of this outage call record as assessed during Silver Layer ingestion and validation. VALID = passed all validation rules; SUSPECT = passed ingestion but has anomalies requiring review; INVALID = failed critical validation; PENDING_REVIEW = awaiting manual data quality review."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "VALID|SUSPECT|INVALID|PENDING_REVIEW" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.dispositionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disposition code"@en ;
    rdfs:comment "Standardized code indicating the final outcome or resolution action taken on this call (e.g., EVENT_CREATED, ADDED_TO_EVENT, DUPLICATE_CLOSED, NO_OUTAGE_FOUND, REFERRED_TO_CREW, CUSTOMER_CALLBACK_SCHEDULED). Sourced from OMS disposition reference table. Reference-value candidates: EVENT_CREATED|ADDED_TO_EVENT|DUPLICATE_CLOSED|NO_OUTAGE_FOUND|REFERRED_TO_CREW|CUSTOMER_CALLBACK_SCHEDULED|INVALID."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "disposition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Call Disposition Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.durationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration seconds"@en ;
    rdfs:comment "Duration of the customer call in seconds from answer to disconnect, for calls received via IVR or live agent channels. Used for call center operational reporting, SLA (Service Level Agreement) compliance, and customer experience analytics."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Call Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:OutageCall.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "Estimated date and time of power restoration communicated to the customer at the time of call handling or subsequent notification. Sourced from OMS restoration forecasting. Used for customer expectation management and SLA (Service Level Agreement) tracking. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Timestamp (ERT)" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCall.hazardIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard indicator"@en ;
    rdfs:comment "Indicates whether the caller reported a safety hazard associated with the outage (e.g., downed power line, sparking equipment, fire, flooding near electrical equipment). True = hazard reported; False = no hazard reported. Triggers priority escalation in OMS crew dispatch and public safety notification workflows."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "hazard_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazard Indicator Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCall.hazardType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard type"@en ;
    rdfs:comment "Specific type of safety hazard reported by the caller when hazard_indicator = True. Used to determine emergency response protocol, crew safety briefing requirements, and coordination with emergency services (fire, police). Reference-value candidates: DOWNED_LINE|SPARKING|FIRE|FLOODING|EQUIPMENT_DAMAGE|TREE_ON_LINE|VEHICLE_ACCIDENT|OTHER."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "hazard_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazard Type" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.isDuplicate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is duplicate"@en ;
    rdfs:comment "Indicates whether this call has been identified as a duplicate report of an outage already captured by a prior call or AMI notification for the same event and location. True = duplicate; False = unique first report. Used by OMS call clustering logic to avoid double-counting in reliability metrics."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_duplicate" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Duplicate Call Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCall.ivrSessionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ivr session code"@en ;
    rdfs:comment "Unique session identifier assigned by the Interactive Voice Response (IVR) system for calls received through the automated phone channel. Used for call traceability, IVR system reconciliation, and customer experience analytics. Populated only when call_source_type = IVR."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "ivr_session_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interactive Voice Response (IVR) Session ID" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.matchedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "matched timestamp"@en ;
    rdfs:comment "Date and time at which this call was successfully matched or correlated to a confirmed outage event in the OMS. Populated when call_status transitions to MATCHED. Used for OMS processing latency analysis and reliability reporting timelines. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "matched_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Match Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCall.medicalBaselineFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical baseline flag"@en ;
    rdfs:comment "Indicates whether the affected customer account is registered on the utility's medical baseline or life-support program, requiring priority restoration and proactive notification per PUC regulations. True = medical baseline customer; False = standard customer. Classified as confidential due to sensitivity of health-related program enrollment."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "medical_baseline_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Baseline Customer Flag" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCall.notificationSentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification sent flag"@en ;
    rdfs:comment "Indicates whether an outage acknowledgement or estimated restoration time (ERT) notification has been sent to the customer associated with this call. True = notification sent; False = not yet sent. Supports PUC customer notification compliance tracking."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_sent_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Sent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageCall.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "Date and time at which the outage acknowledgement or estimated restoration time (ERT) notification was dispatched to the customer. Populated when notification_sent_flag = True. Used for PUC notification compliance reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCall.omsCallClusterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms call cluster code"@en ;
    rdfs:comment "Identifier of the OMS call cluster to which this call has been assigned during the outage prediction and event correlation process. Multiple calls from the same geographic area or circuit are grouped into a cluster to predict the probable outage location and initiate crew dispatch before a formal event is confirmed."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_call_cluster_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Call Cluster ID" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.outageStartReportedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage start reported timestamp"@en ;
    rdfs:comment "Date and time the caller reports the outage began, as stated by the customer or detected by the AMI device. May differ from the OMS-confirmed outage start time. Used as an input to outage event timeline reconstruction and SAIDI/CAIDI calculations. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_start_reported_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCall.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Restoration priority level assigned to this outage call based on hazard indicators, medical baseline status, customer class, and outage scope. CRITICAL = life-safety or critical infrastructure; HIGH = medical baseline or large commercial/industrial; MEDIUM = standard residential or small commercial; LOW = non-urgent or duplicate. Drives OMS crew dispatch sequencing."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Call Priority Level" ;
    cmm:validValues "CRITICAL|HIGH|MEDIUM|LOW" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:OutageCall.receivedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "received timestamp"@en ;
    rdfs:comment "Date and time at which the outage call or AMI-generated outage report was received by the utility system. This is the principal business event timestamp used for OMS call clustering, outage prediction, and SAIDI/SAIFI/CAIDI reliability index calculations. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "received_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Call Received Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageCall.referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference number"@en ;
    rdfs:comment "Externally visible alphanumeric reference number assigned to this trouble call at receipt, used for customer-facing acknowledgement (e.g., IVR confirmation code, agent ticket number, web portal confirmation). Sourced from the CIS or OMS call intake module."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Call Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageCall.reportedSymptomCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported symptom code"@en ;
    rdfs:comment "Standardized code representing the symptom or problem reported by the caller or detected by the AMI system (e.g., FULL_OUTAGE, PARTIAL_OUTAGE, FLICKERING, LOW_VOLTAGE, DOWNED_LINE, BURNING_SMELL). Sourced from the OMS symptom code reference table. Reference-value candidates: FULL_OUTAGE|PARTIAL_OUTAGE|FLICKERING|LOW_VOLTAGE|DOWNED_LINE|BURNING_SMELL|SPARKING|BUZZING."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "reported_symptom_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported Symptom Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.reportedSymptomDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported symptom description"@en ;
    rdfs:comment "Free-text description of the outage symptom or problem as reported by the caller or transcribed by the call center agent. Supplements the structured symptom code with verbatim customer language for OMS analysis and crew dispatch context."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "reported_symptom_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported Symptom Description" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.serviceAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service address"@en ;
    rdfs:comment "Street address of the service location reported as experiencing the outage, as provided by the caller or resolved from the account record. Used for geographic clustering in the OMS and crew dispatch routing."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the utility's regulated service territory or operating division in which the reported outage is located. Used for regulatory reporting segmentation to State PUCs and NERC reliability reporting."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.sourceSystemCallCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system call code"@en ;
    rdfs:comment "Original call or ticket identifier assigned by the source operational system (e.g., OMS call number from GE PowerOn ADMS, CIS interaction ID from SAP IS-U or Oracle CC&B). Enables traceability and reconciliation between the Silver Layer data product and the system of record."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_call_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Call ID" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.sourceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source type"@en ;
    rdfs:comment "Channel or mechanism through which the outage report was received. IVR = Interactive Voice Response automated phone system; AGENT = live call center agent; AMI_PING = Advanced Metering Infrastructure last-gasp or outage notification; MOBILE_APP = utility mobile application; WEB_PORTAL = online self-service portal; FIELD_CREW = field crew-initiated report."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Call Source Type" ;
    cmm:validValues "IVR|AGENT|AMI_PING|MOBILE_APP|WEB_PORTAL|FIELD_CREW" ;
    cmm:cimDatatype "String" .
cmm:OutageCall.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time at which this outage call record was last modified in the data platform, reflecting any status updates, event matching, or data corrections applied during the call lifecycle. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageCall.weatherEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather event flag"@en ;
    rdfs:comment "Indicates whether the outage reported in this call is associated with a declared weather event (storm, hurricane, ice storm, heat wave, etc.). True = weather-related; False = non-weather. Relevant for IEEE 1366 Major Event Day (MED) exclusion determination and storm response activation."@en ;
    rdfs:domain cmm:OutageCall ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "weather_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Event Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:SegmentImpact a owl:Class ;
    rdfs:label "Segment Impact"@en ;
    rdfs:comment "Record of a specific distribution network segment (feeder section, lateral, transformer zone) impacted by an outage event. Captures segment identifier, segment type, de-energization start and end timestamps, isolation method, number of customers on segment, and restoration sequence priority. Enables network topology-based outage analysis and supports FLISR (Fault Location, Isolation, and Service Restoration) workflow tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:OutageArea ;
    cmm:cimCloseMatch cim:OutageArea ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.segment_impact" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 61968-3; Network Segment Outage (GE PowerOn ADMS / Esri ArcGIS Utility Network)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.segment_impact" ;
    owl:hasKey ( cmm:SegmentImpact.segmentImpactId ) .

cmm:SegmentImpact.segmentImpactId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment impact id"@en ;
    rdfs:comment "Primary key for segment_impact"@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:long ;
    cmm:physicalColumn "segment_impact_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Segment Impact Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.cause a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cause"@en ;
    rdfs:comment "Reference to the outage cause classification record describing the root cause of the de-energization event for this segment."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:OutageCause ;
    cmm:physicalColumn "cause_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Cause ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_cause_id" ;
    cmm:cimAssociation "OutageArea.IdentifiedObject" .
cmm:SegmentImpact.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Network segment analysis must identify DER on affected segments for hosting capacity recalculation, protection coordination verification, and restoration priority determination. Engineering studies po"@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_der_system_id" ;
    cmm:cimAssociation "OutageArea.PowerElectronicsConnection" .
cmm:SegmentImpact.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation that supplies this network segment. Used for substation-level outage impact aggregation and transmission-distribution boundary analysis."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_distribution_substation_id" ;
    cmm:cimAssociation "OutageArea.Substation" .
cmm:SegmentImpact.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that caused this segment to be de-energized. Links the segment impact to the originating outage lifecycle record."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_event_id" ;
    cmm:cimAssociation "OutageArea.Outage" .
cmm:SegmentImpact.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit that this segment belongs to. Used for feeder-level outage aggregation, reliability reporting, and ADMS topology navigation. Sourced from Esri ArcGIS Utility Network feeder model."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_feeder_id" ;
    cmm:cimAssociation "OutageArea.Feeder" .
cmm:SegmentImpact.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: Network segment impacts may affect NERC CIP-designated BES Cyber Systems, triggering CIP incident reporting obligations. Cybersecurity teams assess whether outages impacted CIP assets to determine CIP"@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_nerc_cip_asset_id" ;
    cmm:cimAssociation "OutageArea.Asset" .
cmm:SegmentImpact.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "Reference to the distribution network segment (feeder section, lateral, transformer zone) affected by the outage. Sourced from the GIS network model in Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Network Segment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_network_segment_id" ;
    cmm:cimAssociation "OutageArea.EquipmentContainer" .
cmm:SegmentImpact.outageCrewDispatch a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage crew dispatch"@en ;
    rdfs:comment "Reference to the crew dispatch assignment record for field crews assigned to restore this segment. Links to workforce and work order management in Ventyx Asset Suite."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:OutageCrewDispatch ;
    cmm:physicalColumn "outage_crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_outage_crew_dispatch_id" ;
    cmm:cimAssociation "OutageArea.FieldDispatchHistory" .
cmm:SegmentImpact.sectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device"@en ;
    rdfs:comment "Identifier of the switching device (recloser, sectionalizer, fuse, breaker) that performed the isolation of this segment. Sourced from the GIS network model and ADMS device registry. Used for asset performance tracking in Ventyx Asset Suite."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Isolation Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_sectionalizing_device_id" ;
    cmm:cimAssociation "OutageArea.ProtectedSwitch" .
cmm:SegmentImpact.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Reference to the storm or major weather event record associated with this segment impact. Null for non-storm outages. Used for storm response coordination, MED exclusion processing, and FEMA/state emergency reporting."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_segment_impact_storm_event_id" ;
    cmm:cimAssociation "OutageArea.Incident" .
cmm:SegmentImpact.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this segment impact record was first created in the OMS or lakehouse system. Used for audit trail, data lineage, and record provenance tracking."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:OutageArea.createdDateTime .
cmm:SegmentImpact.criticalInfrastructureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical infrastructure flag"@en ;
    rdfs:comment "Indicates whether this segment serves critical infrastructure facilities (hospitals, emergency services, water treatment, telecommunications). When true, triggers elevated restoration priority and mandatory regulatory notification."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_infrastructure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Infrastructure Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.customersOnSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers on segment"@en ;
    rdfs:comment "Total number of customer service points (meters) located on this network segment at the time of the outage event. Used as the customer count denominator for SAIDI, SAIFI, and CAIDI reliability index calculations per IEEE 1366."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_on_segment" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers on Segment Count" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.customersPartiallyRestored a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers partially restored"@en ;
    rdfs:comment "Number of customers on this segment restored during partial restoration switching operations prior to full segment restoration. Used to accurately credit partial restoration in SAIDI/CAIDI calculations per IEEE 1366."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_partially_restored" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Partially Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.customersRestored a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored"@en ;
    rdfs:comment "Number of customer service points on this segment that have been restored to service. Incremented as partial restoration switching operations are completed. Enables real-time tracking of restoration progress."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.deEnergizationEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "de energization end timestamp"@en ;
    rdfs:comment "Date and time when the network segment was fully restored to energized state. Null if the segment has not yet been restored. Used with de_energization_start_timestamp to compute segment outage duration for SAIDI/CAIDI calculations."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "de_energization_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-Energization End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SegmentImpact.deEnergizationStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "de energization start timestamp"@en ;
    rdfs:comment "Date and time when the network segment was de-energized (lost power) as recorded by the OMS or SCADA system. This is the principal business event timestamp used for SAIDI/SAIFI/CAIDI reliability index calculations per IEEE 1366."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "de_energization_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-Energization Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SegmentImpact.doeReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "doe reportable flag"@en ;
    rdfs:comment "Indicates whether this segment impact is part of an event requiring reporting to the U.S. Department of Energy (DOE) via Form OE-417 (Electric Emergency Incident and Disturbance Report)."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "doe_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Energy (DOE) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "Estimated date and time when the segment is expected to be restored to service. Published to customer notification systems and field crews. Updated dynamically as restoration progresses. Supports ETR (Estimated Time to Restore) commitments to regulators and customers."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time to Restore (ETR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SegmentImpact.faultLocationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault location description"@en ;
    rdfs:comment "Textual description of the fault or damage location on this segment as identified by field crews or FLISR analysis (e.g., 'Pole 47 on Oak Street', 'Underground cable section between manholes MH-12 and MH-14'). Supports crew navigation and post-event analysis."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Description" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.flisrActionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr action type"@en ;
    rdfs:comment "Type of Fault Location, Isolation, and Service Restoration (FLISR) automated action applied to this segment. Indicates whether the segment was handled by automatic FLISR logic or required manual crew intervention."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Action Type" ;
    cmm:validValues "fault_location|isolation|service_restoration|manual_override|none" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.flisrAutomatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr automated flag"@en ;
    rdfs:comment "Indicates whether the FLISR (Fault Location, Isolation, and Service Restoration) action for this segment was executed automatically by the ADMS system (true) or required manual crew switching (false). Used to measure ADMS automation effectiveness."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_automated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Automated Action Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.gisSegmentRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis segment ref"@en ;
    rdfs:comment "Reference identifier for this network segment in the Esri ArcGIS Utility Network geospatial model. Enables spatial analysis, outage mapping, and topology-based impact assessment."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_segment_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Segment Reference" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:SegmentImpact.impactStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact status"@en ;
    rdfs:comment "Current lifecycle status of the segment impact record. Tracks the progression from initial de-energization through isolation, partial restoration, and full restoration. Drives OMS workflow state transitions in GE PowerOn ADMS."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "impact_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Segment Impact Status" ;
    cmm:validValues "de-energized|isolated|partially_restored|restored|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:OutageArea.status .
cmm:SegmentImpact.isMedExclusion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is med exclusion"@en ;
    rdfs:comment "Indicates whether this segment impact qualifies for Major Event Day (MED) exclusion from SAIDI/SAIFI reliability index calculations per IEEE 1366-2012 beta method. MED exclusions apply during catastrophic storm or disaster events."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_med_exclusion" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.isMomentary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is momentary"@en ;
    rdfs:comment "Indicates whether this segment impact qualifies as a momentary interruption (typically less than 5 minutes per IEEE 1366 definition). Momentary interruptions are counted in MAIFI (Momentary Average Interruption Frequency Index) rather than SAIDI/SAIFI."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_momentary" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.isPlanned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is planned"@en ;
    rdfs:comment "Indicates whether this segment de-energization was a planned maintenance outage (true) or an unplanned/forced interruption (false). Planned outages are typically excluded from SAIDI/SAIFI calculations per IEEE 1366 and state PUC rules."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_planned" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.isolationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation method"@en ;
    rdfs:comment "The switching or protective device operation method used to isolate this segment from the energized network. Critical for FLISR (Fault Location, Isolation, and Service Restoration) workflow analysis and switching order documentation. Reference-value candidates: automatic_switch|manual_switch|fuse_operation|recloser|sectionalizer|breaker_trip."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "isolation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Segment Isolation Method" ;
    cmm:validValues "automatic_switch|manual_switch|fuse_operation|recloser|sectionalizer|breaker_trip" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.lifeSupportCustomers a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support customers"@en ;
    rdfs:comment "Number of customers on this segment registered as life-support or medical baseline customers. Elevates restoration priority and triggers mandatory notification protocols per state PUC regulations."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "life_support_customers" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customers Count" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.loadMwAtOutage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load mw at outage"@en ;
    rdfs:comment "Estimated electrical load in megawatts (MW) on this segment at the time of de-energization. Sourced from SCADA/OSIsoft PI historian data. Used for load loss reporting, demand response impact assessment, and grid restoration planning."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_mw_at_outage" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load at Outage (MW)" ;
    cmm:cimDatatype "Decimal" .
cmm:SegmentImpact.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this segment impact contributes to a reportable event under NERC reliability standards (e.g., EOP-004 disturbance reporting thresholds). Drives mandatory NERC event reporting workflows."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.omsSegmentRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms segment ref"@en ;
    rdfs:comment "Source system reference identifier for this segment impact record as assigned by the GE PowerOn ADMS Outage Management System. Used for cross-system reconciliation and data lineage tracing between the OMS and the lakehouse silver layer."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_segment_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Segment Reference" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Total duration of the de-energization event for this segment in minutes, calculated from de_energization_start_timestamp to de_energization_end_timestamp. Null if segment is not yet restored. Used directly in SAIDI and CAIDI reliability index calculations per IEEE 1366."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:SegmentImpact.partialRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "partial restoration timestamp"@en ;
    rdfs:comment "Date and time when partial restoration of this segment was achieved (i.e., a subset of customers on the segment were restored via switching operations before full restoration). Null if no partial restoration occurred."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "partial_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Partial Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SegmentImpact.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Indicates whether this segment impact must be included in mandatory reliability reporting submissions to the state Public Utility Commission (PUC). Determined by customer count thresholds, duration thresholds, and critical infrastructure involvement."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SegmentImpact.restorationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration method"@en ;
    rdfs:comment "Method used to restore this segment to service. Distinguishes between switching-based restoration (no repair needed), physical repair of damaged equipment, temporary bypass, or load transfer to alternate feeder."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Method" ;
    cmm:validValues "switching|repair|temporary_bypass|load_transfer|none" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.restorationSequencePriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration sequence priority"@en ;
    rdfs:comment "Numeric priority rank assigned to this segment for restoration sequencing within the outage event. Lower values indicate higher priority. Drives crew dispatch order and switching plan execution. Considers life-support customers, critical infrastructure, and load size."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "restoration_sequence_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Sequence Priority" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.segmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment code"@en ;
    rdfs:comment "Externally-known alphanumeric identifier for the distribution network segment as maintained in the GIS and ADMS systems (e.g., feeder section code, lateral identifier). Used for cross-system reconciliation with GE PowerOn ADMS and Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Segment Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{3,30}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SegmentImpact.segmentName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment name"@en ;
    rdfs:comment "Human-readable descriptive name of the impacted distribution network segment (e.g., 'Oak Street Lateral 3', 'Feeder 12A Section 4'). Used in operational dashboards and crew dispatch communications."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Network Segment Name" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:IdentifiedObject.name .
cmm:SegmentImpact.segmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment type"@en ;
    rdfs:comment "Classification of the distribution network segment topology type. Determines the scope of impact and applicable FLISR (Fault Location, Isolation, and Service Restoration) switching logic. Reference-value candidates: feeder_section|lateral|transformer_zone|substation_bus|service_point_group|tie_line."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Network Segment Type" ;
    cmm:validValues "feeder_section|lateral|transformer_zone|substation_bus|service_point_group|tie_line" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:OutageArea.kind .
cmm:SegmentImpact.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Reference number of the switching order issued to field crews for isolating or restoring this segment. Links to the switching order management workflow in GE PowerOn ADMS. Required for audit trail of all switching operations."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:valuePattern "^[A-Z0-9-]{4,30}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SegmentImpact.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Network segment impacts are recorded per outage event. Required for topology-based outage analysis and FLISR workflow tracking."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:SegmentImpact.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this segment impact record was last modified. Tracks updates to restoration status, customer counts, ETR, and other operational fields throughout the outage lifecycle."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SegmentImpact.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage of the impacted network segment in kilovolts (kV). Used to classify the segment within the distribution voltage hierarchy (e.g., 4kV, 12kV, 25kV, 34.5kV) and determine applicable switching procedures."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:SegmentImpact.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Prevailing weather condition at the time of the segment de-energization. Used for storm-related outage analysis, MED exclusion determination, and regulatory storm reporting. Reference-value candidates: normal|wind|ice|lightning|flood|heat|snow|hurricane|tornado."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition at Outage" ;
    cmm:cimDatatype "String" .
cmm:SegmentImpact.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Work order number from the asset management system (Ventyx Asset Suite or SAP S/4HANA Plant Maintenance) associated with the restoration or repair activity for this segment impact."@en ;
    rdfs:domain cmm:SegmentImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:valuePattern "^[A-Z0-9-]{4,30}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:OutageFlisrEvent a owl:Class ;
    rdfs:label "Outage Flisr Event"@en ;
    rdfs:comment "Record of an automated FLISR (Fault Location, Isolation, and Service Restoration) execution triggered by a fault on the distribution network. Captures fault detection timestamp, faulted segment, isolation actions taken automatically, load transfer actions, customers restored automatically vs. requiring manual intervention, FLISR algorithm version, and success/failure outcome. Distinct from manual switching orders — represents automated grid self-healing actions."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.outage_flisr_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; FLISR Automation (GE PowerOn ADMS FLISR Module)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.outage_flisr_event" ;
    owl:hasKey ( cmm:OutageFlisrEvent.outageFlisrEventId ) .

cmm:OutageFlisrEvent.outageFlisrEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage flisr event id"@en ;
    rdfs:comment "Unique surrogate identifier for each automated FLISR execution event record in the distribution network self-healing system."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_flisr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Automated FLISR operations on critical infrastructure are audited for compliance with operational reliability standards. Compliance audits review FLISR algorithm performance, operator override decisio"@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_audit_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:OutageFlisrEvent.cause a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cause"@en ;
    rdfs:comment "Reference to the outage cause classification record that categorizes the root cause of the fault triggering this FLISR event (e.g., equipment failure, tree contact, animal contact, lightning). Links to the outage_cause reference product for NERC/PUC cause code reporting."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:OutageCause ;
    cmm:physicalColumn "cause_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Cause ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_cause_id" ;
    cmm:cimAssociation "PSREvent.IdentifiedObject" .
cmm:OutageFlisrEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation from which the faulted feeder originates. Used for geographic and operational scoping of the FLISR event."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_distribution_substation_id" ;
    cmm:cimAssociation "PSREvent.Substation" .
cmm:OutageFlisrEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that triggered this FLISR execution. Links the automated self-healing action to the broader outage lifecycle record in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:OutageFlisrEvent.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "Identifier of the specific distribution network segment (line section, cable section, or switch zone) determined by the FLISR algorithm to contain the fault. Sourced from the GIS/Utility Network model."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Faulted Network Segment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_network_segment_id" ;
    cmm:cimAssociation "PSREvent.EquipmentContainer" .
cmm:OutageFlisrEvent.primaryOutageFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary outage feeder"@en ;
    rdfs:comment "Reference to the distribution feeder on which the fault was detected and FLISR was triggered. Identifies the primary circuit affected by the fault event."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "primary_outage_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_primary_outage_feeder_id" ;
    cmm:cimAssociation "PSREvent.Feeder" .
cmm:OutageFlisrEvent.sectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device"@en ;
    rdfs:comment "Identifier of the normally-open tie switch operated by the FLISR algorithm to transfer load to the alternate feeder during restoration. Sourced from the GIS/Utility Network model. Critical for post-event switching order reconciliation."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Tie Switch ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_sectionalizing_device_id" ;
    cmm:cimAssociation "PSREvent.ProtectedSwitch" .
cmm:OutageFlisrEvent.tieSwitchAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tie switch asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: FLISR (Fault Location, Isolation, Service Restoration) events use tie switches to transfer load between feeders. Linking to asset_registry enables tracking tie switch operation counts, maintenance nee"@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "tie_switch_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Tie Switch Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_outage_flisr_event_tie_switch_asset_registry_id" ;
    cmm:cimAssociation "PSREvent.Asset" .
cmm:OutageFlisrEvent.admsEventRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adms event ref"@en ;
    rdfs:comment "Native event reference identifier assigned by the GE PowerOn ADMS system for this FLISR execution. Enables cross-system traceability between the data lakehouse record and the operational ADMS source system."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "adms_event_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Distribution Management System (ADMS) Event Reference" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this FLISR event record was first created in the data platform. Serves as the audit trail creation marker for data lineage and compliance purposes."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PSREvent.createdDateTime .
cmm:OutageFlisrEvent.customersAffectedTotal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected total"@en ;
    rdfs:comment "Total number of customer service points de-energized as a result of the fault event prior to any FLISR restoration actions. Used as the baseline for SAIFI and SAIDI reliability index calculations per IEEE 1366."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_total" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Customers Affected" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.customersRequiringManual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers requiring manual"@en ;
    rdfs:comment "Number of customer service points within the faulted segment that could not be restored automatically by FLISR and require manual crew dispatch and switching operations for restoration. Drives crew dispatch prioritization."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_requiring_manual" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Requiring Manual Restoration" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.customersRestoredAuto a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored auto"@en ;
    rdfs:comment "Number of customer service points successfully restored to service by the FLISR automated switching and load transfer actions, without requiring manual crew intervention. Key metric for measuring FLISR effectiveness and SAIDI/CAIDI improvement."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_auto" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Automatically" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.doeReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "doe reportable flag"@en ;
    rdfs:comment "Indicates whether this FLISR event is associated with an outage that meets DOE OE-417 reporting thresholds (e.g., affecting 50,000+ customers or critical infrastructure). Triggers mandatory federal emergency reporting."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "doe_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Energy (DOE) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the FLISR execution event. 'initiated' = algorithm triggered; 'in_progress' = isolation/restoration actions underway; 'completed' = full automated restoration achieved; 'failed' = algorithm could not restore; 'partial' = some customers restored automatically, remainder require manual intervention; 'cancelled' = FLISR aborted before completion."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "FLISR Event Status" ;
    cmm:validValues "initiated|in_progress|completed|failed|partial|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.status .
cmm:OutageFlisrEvent.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Descriptive reason code or message explaining why the FLISR execution failed or was aborted. Populated only when outcome is 'failure' or 'aborted'. Examples: capacity constraint on alternate feeder, communication failure to remote switch, operator override, protection relay lockout."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Failure or Abort Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.faultDetectedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault detected timestamp"@en ;
    rdfs:comment "Date and time when the fault on the distribution network was first detected by the ADMS/FLISR system, triggering the automated response sequence. This is the principal business event timestamp for SAIDI/SAIFI/CAIDI reliability index calculations per IEEE 1366."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "fault_detected_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Detection Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageFlisrEvent.faultDistanceM a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault distance m"@en ;
    rdfs:comment "Estimated distance in meters from the substation or reference point to the calculated fault location on the feeder, as determined by the FLISR impedance-based fault location algorithm. Used for crew dispatch and asset inspection prioritization."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_distance_m" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Distance (Meters)" ;
    cmm:unitSymbol "m" ;
    cmm:cimDatatype "Length" .
cmm:OutageFlisrEvent.faultLocationConfidence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault location confidence"@en ;
    rdfs:comment "Confidence level assigned by the FLISR algorithm to its fault location determination. Influences whether automated restoration proceeds or is held pending manual verification. High confidence enables full automation; low confidence may trigger manual review."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_location_confidence" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Confidence Level" ;
    cmm:validValues "high|medium|low|unconfirmed" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.faultType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault type"@en ;
    rdfs:comment "Electrical classification of the fault detected on the distribution network. Determines the FLISR algorithm's isolation and restoration strategy. Phase-to-ground is the most common distribution fault type."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Type" ;
    cmm:validValues "phase_to_ground|phase_to_phase|three_phase|open_conductor|unknown" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.flisrAlgorithmVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr algorithm version"@en ;
    rdfs:comment "Version identifier of the FLISR algorithm deployed in the ADMS at the time of this event execution. Critical for reproducibility analysis, algorithm performance benchmarking, and post-event audit of automated decision logic."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_algorithm_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Algorithm Version" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.flisrEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr event number"@en ;
    rdfs:comment "Human-readable, externally referenceable identifier for this FLISR execution event, as assigned by the Advanced Distribution Management System (ADMS). Used in operational reports, regulatory filings, and cross-system correlation."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageFlisrEvent.isMomentary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is momentary"@en ;
    rdfs:comment "Indicates whether the fault event was classified as a momentary interruption (duration ≤ 5 minutes per IEEE 1366) rather than a sustained outage. Momentary events are tracked under MAIFI rather than SAIFI/SAIDI for reliability reporting."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_momentary" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Momentary Interruption Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.isolationCompletedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation completed timestamp"@en ;
    rdfs:comment "Date and time when the FLISR algorithm completed all automated isolation switching actions to contain the faulted segment. Marks the end of the isolation phase and the start of the restoration phase."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "isolation_completed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Isolation Completed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageFlisrEvent.isolationDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation duration seconds"@en ;
    rdfs:comment "Elapsed time in seconds from fault detection to completion of all automated isolation switching actions. Key performance indicator for FLISR speed and ADMS response time benchmarking."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "isolation_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Phase Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:OutageFlisrEvent.isolationSwitchCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation switch count"@en ;
    rdfs:comment "Total number of automated switching operations executed by the FLISR algorithm during the isolation phase to contain the faulted segment. Used for asset wear tracking and switching order audit."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "isolation_switch_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Switch Operation Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.lifeSupportCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support customers affected"@en ;
    rdfs:comment "Number of registered life support or medical baseline customers within the affected area of this FLISR event. Used to prioritize restoration sequencing and trigger mandatory customer notification per state PUC medical baseline rules."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "life_support_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.loadTransferredMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transferred mw"@en ;
    rdfs:comment "Total electrical load in megawatts (MW) transferred to alternate feeders or tie switches by the FLISR algorithm during the restoration phase. Used to assess grid capacity utilization and validate load transfer feasibility."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_transferred_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transferred (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OutageFlisrEvent.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this FLISR event is associated with an outage that meets NERC reporting thresholds and must be reported to NERC under applicable reliability standards (e.g., EOP-004). Drives regulatory reporting workflow."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "Incident number assigned by the Outage Management System (OMS) to the outage event associated with this FLISR execution. Enables correlation between automated FLISR actions and the broader outage incident record for regulatory reporting."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OutageFlisrEvent.operatorOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override flag"@en ;
    rdfs:comment "Indicates whether a dispatcher or system operator manually intervened to override, modify, or abort the FLISR automated execution sequence. True = operator intervention occurred; False = fully automated execution without human intervention."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.operatorOverrideReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override reason"@en ;
    rdfs:comment "Free-text description of the reason a dispatcher or operator overrode the FLISR automated execution. Populated only when operator_override_flag is True. Used for post-event analysis and FLISR algorithm improvement."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_override_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Reason" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.outcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outcome"@en ;
    rdfs:comment "Overall outcome of the FLISR execution event. 'success' = all restorable customers restored automatically; 'partial_success' = some customers restored, remainder require manual intervention; 'failure' = FLISR could not execute any restoration; 'aborted' = execution halted due to constraint violation or operator override."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Execution Outcome" ;
    cmm:validValues "success|partial_success|failure|aborted" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.preFaultLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre fault load mw"@en ;
    rdfs:comment "Total electrical load in megawatts (MW) on the affected feeder immediately prior to the fault event, as recorded by the ADMS/SCADA historian. Used to assess load transfer feasibility and post-restoration capacity margin."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_fault_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Fault Load (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OutageFlisrEvent.protectionRelayOperatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection relay operated flag"@en ;
    rdfs:comment "Indicates whether a protection relay (recloser, sectionalizer, or breaker) operated to initiate the fault isolation sequence that triggered FLISR. True = relay operation confirmed; False = FLISR triggered by other detection method (e.g., SCADA alarm, voltage sag detection)."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "protection_relay_operated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Relay Operated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.recloserOperationsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recloser operations count"@en ;
    rdfs:comment "Number of automatic recloser operations that occurred on the faulted circuit prior to FLISR lockout and isolation. Used to distinguish momentary interruptions from sustained outages for IEEE 1366 MAIFI vs SAIFI classification."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "recloser_operations_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recloser Operations Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.restorationCompletedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration completed timestamp"@en ;
    rdfs:comment "Date and time when the FLISR algorithm completed all automated load transfer and service restoration actions. Customers restored after this timestamp required manual crew intervention."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_completed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automated Restoration Completed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OutageFlisrEvent.restorationDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration duration seconds"@en ;
    rdfs:comment "Elapsed time in seconds from completion of fault isolation to completion of all automated load transfer and service restoration actions. Used to measure FLISR restoration speed and its contribution to CAIDI reduction."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "restoration_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Phase Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:OutageFlisrEvent.restorationSwitchCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration switch count"@en ;
    rdfs:comment "Total number of automated switching operations executed by the FLISR algorithm during the load transfer and service restoration phase. Distinct from isolation switch count — represents the re-energization actions."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "restoration_switch_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Switch Operation Count" ;
    cmm:cimDatatype "Integer" .
cmm:OutageFlisrEvent.scadaCommunicationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada communication status"@en ;
    rdfs:comment "Status of SCADA communication to the affected field devices (switches, reclosers, sensors) at the time of FLISR execution. 'degraded' or 'failed' communication may limit FLISR automation capability and is a key factor in partial or failed outcomes."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_communication_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Communication Status" ;
    cmm:validValues "normal|degraded|failed" ;
    cmm:cimDatatype "String" .
cmm:OutageFlisrEvent.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this FLISR event occurred during a declared major event or storm. Major event exclusions per IEEE 1366 may apply to SAIDI/SAIFI calculations when this flag is True."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OutageFlisrEvent.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this FLISR event record was most recently modified in the data platform. Supports audit trail and incremental data pipeline processing."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OutageFlisrEvent.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage in kilovolts (kV) of the distribution circuit on which the FLISR event occurred. Determines applicable switching procedures, safety clearances, and regulatory reporting thresholds."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OutageFlisrEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Prevailing weather condition recorded at the time of the fault event (e.g., clear, wind, lightning, ice, flooding). Used for outage cause analysis, storm event classification, and reliability reporting under IEEE 1366 Major Event Day criteria. Reference-value candidates: clear|wind|lightning|ice|flooding|snow|fog|extreme_heat|unknown."@en ;
    rdfs:domain cmm:OutageFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition at Time of Event" ;
    cmm:cimDatatype "String" .

cmm:SafetyClearance a owl:Class ;
    rdfs:label "Safety Clearance"@en ;
    rdfs:comment "Formal safety clearance (hold tag, clearance tag, or ground placement) issued to protect field crews working on de-energized equipment during outage restoration or planned maintenance. Captures clearance type, issuing authority, equipment covered, clearance issue and release timestamps, crew member holding the clearance, and safety state verification. Required for OSHA and NERC FAC compliance during switching and restoration operations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ClearanceDocument ;
    cmm:cimExactMatch cim:ClearanceDocument ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.safety_clearance" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; OSHA 1910.269; Safety Clearance / Hold Tag (OSHA 1910.269 / NERC FAC)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.safety_clearance" ;
    owl:hasKey ( cmm:SafetyClearance.safetyClearanceId ) .

cmm:SafetyClearance.safetyClearanceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance id"@en ;
    rdfs:comment "Unique surrogate identifier for the safety clearance record in the lakehouse. Primary key for the safety_clearance data product. Entity role: TRANSACTION_HEADER — a discrete, lifecycle-managed safety authorization event issued to protect field crews working on de-energized equipment."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:long ;
    cmm:physicalColumn "safety_clearance_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Safety Clearance ID" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyClearance.approverEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approver employee"@en ;
    rdfs:comment "Reference to the supervisor, lead dispatcher, or safety officer who approved the issuance of this safety clearance, where a dual-authorization workflow is required. May be the same as the issuing dispatcher in single-authority configurations."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approver_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Clearance Approver ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_approver_employee_id" ;
    cmm:cimAssociation "ClearanceDocument.ErpPersonnel" .
cmm:SafetyClearance.complianceSoxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance sox control"@en ;
    rdfs:comment "Foreign key linking to compliance.sox_control. Business justification: Safety clearance processes for critical infrastructure work may be subject to SOX internal controls over operational safety and asset protection. Internal audit tests safety clearance controls as part"@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "compliance_sox_control_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Sox Control Id (Foreign Key)" ;
    cmm:sourceColumn "sox_control_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_compliance_sox_control_id" ;
    cmm:cimAssociation "ClearanceDocument.Document" .
cmm:SafetyClearance.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the de-energized equipment covered by this clearance is located. Used for geographic scoping of the clearance and for SAIDI/SAIFI reliability reporting."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_distribution_substation_id" ;
    cmm:cimAssociation "ClearanceDocument.Substation" .
cmm:SafetyClearance.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event during which this safety clearance was issued. Links the clearance to the associated unplanned interruption or planned maintenance outage driving the switching and restoration work."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_event_id" ;
    cmm:cimAssociation "ClearanceDocument.Outage" .
cmm:SafetyClearance.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the distribution feeder or circuit segment on which the safety clearance applies. Enables feeder-level aggregation of active clearances for dispatcher situational awareness and restoration sequencing."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_feeder_id" ;
    cmm:cimAssociation "ClearanceDocument.Feeder" .
cmm:SafetyClearance.gridSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid switching order"@en ;
    rdfs:comment "Foreign key linking to grid.grid_switching_order. Business justification: Safety clearances are issued for grid switching orders to protect field crews. Linking enables safety compliance tracking, OSHA documentation, and lockout/tagout procedure enforcement."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:GridSwitchingOrder ;
    cmm:physicalColumn "grid_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_grid_switching_order_id" ;
    cmm:cimAssociation "ClearanceDocument.SwitchingPlan" .
cmm:SafetyClearance.primarySafetyEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary safety employee"@en ;
    rdfs:comment "Reference to the control room dispatcher or system operator who formally issued this safety clearance. The issuing authority is accountable for verifying equipment de-energization and isolation before granting clearance. Satisfies PARTY_REFERENCE category for TRANSACTION_HEADER role."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_safety_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issuing Dispatcher ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_primary_safety_employee_id" ;
    cmm:cimAssociation "ClearanceDocument.ErpPersonnel" .
cmm:SafetyClearance.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the primary electrical equipment asset (transformer, circuit breaker, switch, line segment, cable, bus section) covered by this safety clearance. Sourced from the asset registry in Ventyx Asset Suite or Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Equipment Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_registry_id" ;
    cmm:cimAssociation "ClearanceDocument.Asset" .
cmm:SafetyClearance.tertiarySafetyReleaseAuthorizedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary safety release authorized by employee"@en ;
    rdfs:comment "Reference to the dispatcher or supervisor who authorized the release of this safety clearance after confirming all crew members are clear of the work zone and equipment is ready for re-energization. May differ from the original issuing dispatcher."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_safety_release_authorized_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Release Authorized By ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_tertiary_safety_release_authorized_by_employee_id" ;
    cmm:cimAssociation "ClearanceDocument.ErpPersonnel" .
cmm:SafetyClearance.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the maintenance or restoration work order in the asset management system (Ventyx Asset Suite / SAP S/4HANA PM) that this safety clearance supports. Enables traceability between safety clearances and planned work activities."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_safety_clearance_work_order_id" ;
    cmm:cimAssociation "ClearanceDocument.Work" .
cmm:SafetyClearance.admsSwitchingRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adms switching ref"@en ;
    rdfs:comment "Reference identifier from the GE PowerOn Advanced Distribution Management System (ADMS) linking this safety clearance to the associated switching sequence or network model state. Enables traceability to the ADMS network topology at the time of clearance issuance."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "adms_switching_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Distribution Management System (ADMS) Switching Reference" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text description of the reason this safety clearance was cancelled before use or suspended mid-work. Populated only when clearance_status is 'cancelled' or 'suspended'. Required for safety audit trail and incident investigation."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.clearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance number"@en ;
    rdfs:comment "Externally-known, human-readable alphanumeric identifier for the safety clearance, as assigned by the OMS or switching management system (e.g., GE PowerOn ADMS). Used by dispatchers, field crews, and control room operators to reference the clearance in verbal and written communications. Satisfies BUSINESS_IDENTIFIER category for TRANSACTION_HEADER role."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SafetyClearance.clearancePurpose a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance purpose"@en ;
    rdfs:comment "Business purpose for which the safety clearance was issued. Outage Restoration: unplanned outage repair. Planned Maintenance: scheduled preventive or corrective maintenance. Emergency Repair: urgent unplanned repair outside normal outage workflow. Inspection: equipment inspection requiring de-energization. Construction: new construction or capital project work. Storm Response: clearance issued during declared storm event."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_purpose" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Clearance Purpose" ;
    cmm:validValues "outage_restoration|planned_maintenance|emergency_repair|inspection|construction|storm_response" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.clearanceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance status"@en ;
    rdfs:comment "Current lifecycle state of the safety clearance. Requested: clearance has been requested but not yet issued. Issued: clearance has been formally issued to the holding crew member. Active: crew is actively working under the clearance. Suspended: clearance temporarily suspended (e.g., weather hold). Released: clearance has been formally released and equipment may be re-energized. Cancelled: clearance voided before use. Expired: clearance lapsed without formal release. Satisfies LIFECYCLE_STATUS category for TRANSACTION_HEADER role. Reference-value candidates: requested|issued|active|suspended|released|cancelled|expired."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ClearanceDocument.status .
cmm:SafetyClearance.clearanceToSwitchingOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance to switching order"@en ;
    rdfs:comment "FK to outage.switching_order.switching_order_id — Safety clearances are issued in context of switching orders to protect crews. Must link for safety compliance and clearance release workflow."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:long ;
    cmm:physicalColumn "clearance_to_switching_order" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyClearance.clearanceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance type"@en ;
    rdfs:comment "Classification of the safety clearance instrument issued to protect field crew. Hold Tag: prevents re-energization while crew is on equipment. Clearance Tag: formal authorization to work on de-energized equipment. Ground Placement: physical grounding of conductors for crew protection. Danger Tag: prohibits operation of tagged device. Caution Tag: advisory restriction. Equipment Tag: equipment-specific isolation marker. Reference-value candidates: hold_tag|clearance_tag|ground_placement|danger_tag|caution_tag|equipment_tag."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "clearance_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Clearance Type" ;
    cmm:validValues "hold_tag|clearance_tag|ground_placement|danger_tag|caution_tag|equipment_tag" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ClearanceDocument.type .
cmm:SafetyClearance.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this safety clearance record was first created in the OMS or switching management system. Satisfies RECORD_AUDIT_CREATED category for TRANSACTION_HEADER role. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ClearanceDocument.createdDateTime .
cmm:SafetyClearance.crewCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew count"@en ;
    rdfs:comment "Number of field crew members working under this safety clearance. Used for crew accountability tracking and to ensure all crew members are clear of the work zone before the clearance is released and equipment is re-energized."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Member Count" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyClearance.crewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type"@en ;
    rdfs:comment "Classification of the field crew holding this safety clearance. Line Crew: distribution line workers. Substation Crew: substation maintenance technicians. Transmission Crew: high-voltage transmission workers. Contractor Crew: third-party contracted crew. Mutual Aid Crew: crew deployed under a mutual aid agreement from another utility."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Type" ;
    cmm:validValues "line_crew|substation_crew|transmission_crew|contractor_crew|mutual_aid_crew" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customers de-energized as a result of the switching and isolation actions associated with this safety clearance. Used for SAIDI/SAIFI/CAIDI reliability index calculation and customer notification prioritization."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyClearance.equipmentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment description"@en ;
    rdfs:comment "Human-readable description of the electrical equipment covered by this safety clearance, including equipment name, type, and location identifier as recorded in the OMS or GIS. Supplements the equipment_id for dispatcher and crew reference."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Description" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.groundsApplied a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grounds applied"@en ;
    rdfs:comment "Indicates whether physical protective grounds have been applied to the de-energized conductors or equipment covered by this clearance. True = grounds applied; False = no grounds applied. Grounding is mandatory for certain voltage levels and work types per OSHA 29 CFR 1910.269."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "grounds_applied" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grounds Applied Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.groundsLocationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grounds location description"@en ;
    rdfs:comment "Textual description of the specific locations where protective grounds have been applied (e.g., 'North side of pole 47A, phase A-B-C'). Required when grounds_applied is True. Used for crew safety verification and clearance release sequencing."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "grounds_location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grounds Location Description" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.hazardNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazard notes"@en ;
    rdfs:comment "Free-text field capturing specific hazard conditions, safety warnings, or special precautions associated with this clearance (e.g., proximity to energized conductors, confined space entry, asbestos presence, wildlife hazards). Communicated to field crew at time of clearance issuance."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "hazard_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Hazard Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:SafetyClearance.isolationPointDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation point description"@en ;
    rdfs:comment "Textual description of the electrical isolation boundary for this safety clearance, identifying all open points, switches, and disconnects that define the de-energized zone. Critical for crew safety verification and dispatcher situational awareness."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "isolation_point_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Point Description" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.issuedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issued timestamp"@en ;
    rdfs:comment "Date and time when the safety clearance was formally issued to the holding crew member by the issuing dispatcher. This is the principal real-world business event time for the clearance lifecycle. Satisfies BUSINESS_EVENT_TIMESTAMP category for TRANSACTION_HEADER role. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "issued_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearance Issued Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SafetyClearance.lifeSupportCustomersFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support customers flag"@en ;
    rdfs:comment "Indicates whether any customers dependent on life support equipment (medical baseline, life support registry) are within the de-energized zone covered by this safety clearance. True = life support customers affected. Triggers priority restoration and mandatory customer notification per PUC rules."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "life_support_customers_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customers Affected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.lockoutTagoutRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lockout tagout ref"@en ;
    rdfs:comment "Reference number for the associated Lockout/Tagout (LOTO) procedure document or energy control program record, as required by OSHA 29 CFR 1910.147 for control of hazardous energy. Links the safety clearance to the formal LOTO documentation package."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "lockout_tagout_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lockout/Tagout Reference Number" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether the switching and clearance activity associated with this safety clearance is subject to NERC reliability standard reporting requirements (e.g., FAC-001, FAC-002, or CIP-related switching). True = NERC reportable."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.networkSegmentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network segment description"@en ;
    rdfs:comment "Description of the electrical network segment (feeder section, bus section, transmission line segment) covered by this safety clearance, including circuit identifiers and geographic boundaries. Used for dispatcher situational awareness and restoration sequencing."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_segment_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Segment Description" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.omsClearanceRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms clearance ref"@en ;
    rdfs:comment "Native clearance or safety tag identifier as recorded in the source Outage Management System (GE PowerOn ADMS). Used for cross-system traceability between the lakehouse silver layer record and the operational OMS source record."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_clearance_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Management System (OMS) Clearance Reference" ;
    cmm:cimDatatype "String" .
cmm:SafetyClearance.oshaComplianceVerified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha compliance verified"@en ;
    rdfs:comment "Indicates whether all applicable OSHA 29 CFR 1910.269 electrical safety requirements have been verified and documented prior to issuing this clearance, including minimum approach distances, PPE requirements, and lockout/tagout procedures. True = OSHA compliance verified."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_compliance_verified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSHA Compliance Verified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.plannedOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned outage flag"@en ;
    rdfs:comment "Indicates whether this safety clearance was issued in support of a planned (scheduled) outage rather than an unplanned interruption. True = planned outage; False = unplanned/emergency outage. Used for SAIDI/SAIFI planned vs. unplanned reliability index segregation."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "planned_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Priority classification for this safety clearance, reflecting the urgency of the associated restoration or maintenance work. Critical: life safety or critical infrastructure. High: large customer impact or time-sensitive restoration. Normal: standard planned or unplanned work. Low: minor maintenance with minimal customer impact."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearance Priority Level" ;
    cmm:validValues "critical|high|normal|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:SafetyClearance.regulatoryNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory notes"@en ;
    rdfs:comment "Free-text field for regulatory compliance notes associated with this safety clearance, including NERC FAC, OSHA, or PUC-specific documentation requirements, special reporting obligations, or compliance exceptions noted at time of issuance."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:SafetyClearance.releasedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "released timestamp"@en ;
    rdfs:comment "Date and time when the safety clearance was formally released by the holding crew member and acknowledged by the issuing dispatcher, signaling that the equipment may be re-energized. Null if the clearance has not yet been released. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "released_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearance Released Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SafetyClearance.requestedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested timestamp"@en ;
    rdfs:comment "Date and time when the field crew or work planner submitted the request for this safety clearance to the control room. Used to measure dispatcher response time and clearance issuance latency for safety performance reporting. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "requested_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearance Requested Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SafetyClearance.safetyStateVerified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety state verified"@en ;
    rdfs:comment "Indicates whether the issuing dispatcher has formally verified that the equipment is in a safe de-energized state (confirmed open isolation points, absence of voltage, and grounding where required) prior to issuing the clearance. True = verified; False = not yet verified. Required for OSHA and NERC FAC compliance."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_state_verified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety State Verified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.scheduledEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled end timestamp"@en ;
    rdfs:comment "Planned date and time when field work under this safety clearance is expected to be completed and the clearance released. Used for outage duration estimation and customer notification ETR (Estimated Time of Restoration). Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Work End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SafetyClearance.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "Planned date and time when field work under this safety clearance is scheduled to begin. Used for planned maintenance windows and pre-scheduled outage coordination. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Work Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:SafetyClearance.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this safety clearance was issued during a declared major event or storm restoration. True = storm event clearance. Used to segregate storm-related clearances for major event day (MED) exclusion in IEEE 1366 reliability reporting."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SafetyClearance.toSwitchingOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to switching order"@en ;
    rdfs:comment "FK to outage.switching_order.switching_order_id — Safety clearances are issued in conjunction with switching orders. Required for OSHA/NERC FAC compliance — every clearance must trace to the switching activity it protects."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_switching_order" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyClearance.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this safety clearance record was last modified in the source system. Satisfies RECORD_AUDIT_UPDATED category for TRANSACTION_HEADER role. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SafetyClearance.versionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version number"@en ;
    rdfs:comment "Incremental version counter for this safety clearance record, tracking revisions such as scope extensions, crew changes, or re-issuance after suspension. Supports audit trail requirements and change history for regulatory compliance."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:int ;
    cmm:physicalColumn "version_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Clearance Version Number" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Document.revisionNumber .
cmm:SafetyClearance.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage level in kilovolts (kV) of the equipment covered by this safety clearance. Determines the applicable OSHA electrical safety standards, required personal protective equipment (PPE), and minimum approach distances for field crew."@en ;
    rdfs:domain cmm:SafetyClearance ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:PucOutageReport a owl:Class ;
    rdfs:label "Puc Outage Report"@en ;
    rdfs:comment "Formal regulatory outage report filed with the state Public Utility Commission (PUC) for qualifying outage events meeting reportable thresholds (e.g., >50,000 customers, >8 hours, transmission-level events). Captures report type (initial, update, final), filing deadline, actual filing timestamp, reporting utility, affected customer count, outage duration, cause narrative, corrective action plan, and PUC acknowledgment status. Supports NERC EOP-004 and state PUC reporting obligations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.puc_outage_report" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "PUC Outage Report (NERC EOP-004 / State PUC Rules)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.puc_outage_report" ;
    owl:hasKey ( cmm:PucOutageReport.pucOutageReportId ) .

cmm:PucOutageReport.pucOutageReportId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc outage report id"@en ;
    rdfs:comment "Unique surrogate identifier for each PUC outage report record in the silver layer lakehouse. Primary key for this entity."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "puc_outage_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Public Utility Commission (PUC) Outage Report ID" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the underlying outage event that triggered this PUC regulatory report. Links the formal filing to the operational outage record in the Outage Management System (OMS)."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_puc_outage_report_event_id" ;
    cmm:cimAssociation "Document.Outage" .
cmm:PucOutageReport.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: PUC outage reports are a specific type of regulatory filing with docket numbers, submission tracking, and approval workflows. Compliance teams manage outage reports within the broader regulatory filin"@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_puc_outage_report_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PucOutageReport.supersededByReportPucOutageReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by report puc outage report"@en ;
    rdfs:comment "Reference to the newer puc_outage_report_id that supersedes this record when a corrected or amended report has been filed. Null if this is the current active version. Enables version chain traversal for audit purposes."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range cmm:PucOutageReport ;
    cmm:physicalColumn "superseded_by_report_puc_outage_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By PUC Outage Report ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_puc_outage_report_superseded_by_report_puc_outage_report_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PucOutageReport.actualFilingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual filing timestamp"@en ;
    rdfs:comment "Date and time when this report was actually submitted to the state PUC. Compared against filing_deadline_timestamp to determine on-time compliance. This is the principal business event timestamp for the report transaction."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_filing_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual PUC Filing Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.affectedCounties a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected counties"@en ;
    rdfs:comment "Comma-separated list of county names within the utility service territory that experienced customer interruptions during this outage event. Required by many state PUCs for geographic impact assessment and emergency management coordination."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_counties" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Counties" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.affectedServiceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected service territory"@en ;
    rdfs:comment "Description of the geographic service territory area impacted by the outage, such as county names, city names, or distribution circuit identifiers. Used in PUC reports to communicate the geographic scope of the event to regulators."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Service Territory" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.causeNarrative a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause narrative"@en ;
    rdfs:comment "Free-text narrative description of the root cause of the outage event as submitted in the PUC report. Provides detailed explanation beyond the cause category code, including contributing factors, sequence of events, and any relevant environmental or equipment conditions."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_narrative" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Narrative" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.correctiveActionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action due date"@en ;
    rdfs:comment "Target completion date for the corrective action plan committed to in the final PUC report. Used for regulatory follow-up tracking and compliance monitoring."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "corrective_action_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Due Date" ;
    cmm:cimDatatype "Date" .
cmm:PucOutageReport.correctiveActionPlan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Free-text description of the corrective actions taken or planned to prevent recurrence of the outage event. Required in final PUC reports. Includes infrastructure improvements, maintenance program changes, vegetation management, and operational procedure updates."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_plan" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Plan" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this PUC outage report record was first created in the lakehouse silver layer. Represents the audit trail creation timestamp for data governance and lineage tracking."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:PucOutageReport.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Total number of customer accounts that experienced an interruption during this outage event. Used to determine whether the event meets PUC reportable customer threshold (e.g., >50,000 customers) and for System Average Interruption Frequency Index (SAIFI) calculations."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.customersRestoredCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored count"@en ;
    rdfs:comment "Number of customer accounts that have been restored to service as of the time this report was filed. For final reports, this should equal customers_affected_count. For initial and update reports, tracks restoration progress."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.estimatedRestorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration timestamp"@en ;
    rdfs:comment "Estimated date and time by which all affected customers are expected to be restored, as reported in initial and update PUC filings. The Estimated Time of Restoration (ETR) is a key metric for customer communication and regulatory scrutiny during major events."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Time of Restoration (ETR) Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.filingDeadlineTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing deadline timestamp"@en ;
    rdfs:comment "Regulatory deadline by which this report type (initial, update, or final) must be submitted to the state PUC. Calculated based on outage_start_timestamp and the applicable PUC reporting rules for the jurisdiction. Used for compliance monitoring and SLA tracking."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "filing_deadline_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PUC Filing Deadline Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.isFiledOnTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is filed on time"@en ;
    rdfs:comment "Indicates whether the report was submitted to the PUC at or before the filing_deadline_timestamp. Used for regulatory compliance tracking, internal audit, and PUC performance reporting."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_filed_on_time" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filed On Time Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PucOutageReport.isMajorEventDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is major event day"@en ;
    rdfs:comment "Indicates whether this outage occurred on a day classified as a Major Event Day (MED) per IEEE 1366 beta method. MED events are typically excluded from SAIDI/SAIFI baseline calculations but must still be reported to the PUC separately."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_major_event_day" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PucOutageReport.isNercReportable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is nerc reportable"@en ;
    rdfs:comment "Indicates whether this outage event also meets NERC EOP-004 reporting thresholds and has been or must be filed with NERC in addition to the state PUC. Enables cross-regulatory compliance tracking."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_nerc_reportable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PucOutageReport.isStormEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is storm event"@en ;
    rdfs:comment "Indicates whether this outage was caused by or associated with a declared storm event. Storm-related outages may have different PUC reporting requirements, extended restoration time allowances, and separate cost recovery treatment."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_storm_event" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PucOutageReport.lifeSupportCustomersAffected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support customers affected"@en ;
    rdfs:comment "Number of customers registered on the utility's life support or medical baseline program who were affected by this outage. PUC regulations typically require special notification and prioritized restoration for life support customers, and this count is a required field in many state PUC outage reports."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "life_support_customers_affected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.mutualAidActivated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid activated"@en ;
    rdfs:comment "Indicates whether mutual aid assistance from other utilities was requested and activated in response to this outage event. Mutual aid activation is a reportable fact in many state PUC major event reports and NERC EOP-004 filings."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mutual_aid_activated" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mutual Aid Activated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PucOutageReport.nercEventReportNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc event report number"@en ;
    rdfs:comment "NERC-assigned event report number for the corresponding NERC EOP-004 filing, when applicable. Enables cross-referencing between the state PUC report and the federal NERC submission for the same outage event."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_event_report_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Event Report Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PucOutageReport.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "Reference number of the corresponding incident record in the Outage Management System (OMS), specifically GE PowerOn ADMS. Enables traceability between the regulatory PUC report and the operational OMS incident record."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PucOutageReport.outageCauseCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage cause category"@en ;
    rdfs:comment "High-level cause category for the outage event as reported to the PUC. Derived from the OMS outage cause classification and mapped to PUC-required cause taxonomy. Distinct from the detailed cause code in the outage_cause reference product."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Category" ;
    cmm:validValues "weather|equipment_failure|human_error|third_party|unknown|other" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Total duration of the outage event in minutes, measured from outage_start_timestamp to outage_end_timestamp. Used to assess whether the event meets PUC reportable duration thresholds (e.g., >8 hours) and for SAIDI/CAIDI reliability index calculations."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PucOutageReport.outageEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage end timestamp"@en ;
    rdfs:comment "Date and time when the last affected customer was restored and the outage event was officially closed. Used to calculate total outage duration for SAIDI/CAIDI reporting and to confirm restoration completion."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.outageStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage start timestamp"@en ;
    rdfs:comment "Date and time when the reportable outage event began, as recorded in the Outage Management System (OMS). This is the principal real-world event time used to calculate outage duration and filing deadline compliance."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "outage_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.outageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage type"@en ;
    rdfs:comment "Classification of the outage by the level of the electric grid affected. Transmission-level events typically have lower PUC reporting thresholds than distribution events. Used to route reports to the appropriate regulatory body and apply correct reporting rules."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Type" ;
    cmm:validValues "transmission|distribution|generation|substation" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:PucOutageReport.preparedByName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prepared by name"@en ;
    rdfs:comment "Full name of the utility employee responsible for preparing and submitting this PUC outage report. Required for regulatory accountability and as the point of contact for PUC inquiries about the filing."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "prepared_by_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Report Prepared By Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.preparedByPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prepared by phone"@en ;
    rdfs:comment "Direct phone number of the utility employee who prepared this PUC outage report. Provided to the PUC as the contact number for follow-up questions regarding the filing."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "prepared_by_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Report Prepared By Phone Number" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:PucOutageReport.preparedByTitle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prepared by title"@en ;
    rdfs:comment "Job title of the utility employee who prepared this PUC outage report (e.g., 'Manager, Regulatory Affairs', 'Director, Grid Operations'). Required by some PUCs to confirm appropriate organizational authority for the filing."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "prepared_by_title" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Report Prepared By Title" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.pucAcknowledgmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc acknowledgment status"@en ;
    rdfs:comment "Status of the PUC's formal acknowledgment or acceptance of this report filing. 'pending' indicates awaiting PUC response; 'acknowledged' indicates receipt confirmed; 'accepted' indicates formally accepted without deficiency; 'rejected' indicates returned with deficiency notice requiring resubmission."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_acknowledgment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Acknowledgment Status" ;
    cmm:validValues "pending|acknowledged|accepted|rejected" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.pucAcknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the state PUC formally acknowledged or responded to this report filing. Null if acknowledgment has not yet been received."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "puc_acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:PucOutageReport.pucDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc docket number"@en ;
    rdfs:comment "Official docket or case number assigned by the state PUC upon receipt of the outage report. Used for tracking the regulatory proceeding and all subsequent correspondence with the commission."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Public Utility Commission (PUC) Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PucOutageReport.pucJurisdictionState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc jurisdiction state"@en ;
    rdfs:comment "Two-letter US state code identifying the state Public Utility Commission (PUC) to which this report is filed. Determines applicable reporting thresholds, deadlines, and format requirements."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_jurisdiction_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Public Utility Commission (PUC) Jurisdiction State" ;
    cmm:valuePattern "^[A-Z]{2}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:PucOutageReport.pucRejectionReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc rejection reason"@en ;
    rdfs:comment "Free-text description of the reason provided by the PUC for rejecting or returning this report filing. Populated only when puc_acknowledgment_status is 'rejected'. Used to guide corrective resubmission."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_rejection_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Rejection Reason" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.pucReportToOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc report to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — PUC reports are filed for specific qualifying outage events. Must link to the event(s) being reported for regulatory traceability."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "puc_report_to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.reportNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report number"@en ;
    rdfs:comment "Externally-known, human-readable report identifier assigned by the reporting utility and submitted to the state PUC. Used as the official reference number in all regulatory correspondence and acknowledgment tracking (e.g., PUC-2024-OUT-00123)."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "report_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "PUC Outage Report Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PucOutageReport.reportStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report status"@en ;
    rdfs:comment "Current lifecycle status of this regulatory report filing. 'draft' indicates preparation in progress; 'submitted' indicates filed with PUC; 'acknowledged' indicates PUC receipt confirmed; 'accepted' indicates PUC formally accepted; 'rejected' indicates PUC returned for correction; 'superseded' indicates replaced by a subsequent filing."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "report_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "PUC Outage Report Status" ;
    cmm:validValues "draft|submitted|acknowledged|accepted|rejected|superseded" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:PucOutageReport.reportType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report type"@en ;
    rdfs:comment "Indicates the filing stage of this report submission: 'initial' (first notification within required timeframe), 'update' (interim progress report), or 'final' (complete post-restoration report with root cause and corrective actions). Multiple report types may exist per outage event."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "report_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "PUC Outage Report Type" ;
    cmm:validValues "initial|update|final" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:PucOutageReport.reportVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report version"@en ;
    rdfs:comment "Sequential version number of this report record, incremented each time the report is revised and resubmitted to the PUC. Version 1 represents the original submission; subsequent versions represent amendments or corrections."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "report_version" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PUC Outage Report Version" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.reportingUtilityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting utility name"@en ;
    rdfs:comment "Legal name of the electric utility entity filing this PUC outage report. Required on all regulatory submissions to identify the responsible regulated entity."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_utility_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Utility Name" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.reportingUtilityNercCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting utility nerc code"@en ;
    rdfs:comment "NERC-assigned registered entity identifier for the reporting utility. Used to cross-reference NERC EOP-004 filings and to uniquely identify the utility across multi-state regulatory submissions."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "reporting_utility_nerc_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reporting Utility North American Electric Reliability Corporation (NERC) ID" ;
    cmm:cimDatatype "String" .
cmm:PucOutageReport.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "This outage event's contribution to the utility's System Average Interruption Duration Index (SAIDI), calculated as (customer_interruption_minutes / total_customers_served). Reported to the PUC as part of annual reliability performance metrics."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:PucOutageReport.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "This outage event's contribution to the utility's System Average Interruption Frequency Index (SAIFI), calculated as (customers_affected / total_customers_served). Reported to the PUC as part of annual reliability performance metrics."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:PucOutageReport.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — PUC reports are filed for specific qualifying outage events. Required for regulatory compliance tracking."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:PucOutageReport.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this PUC outage report record was last modified in the lakehouse silver layer. Used for incremental data processing, change detection, and audit trail maintenance."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PucOutageReport.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) of the highest-voltage facility involved in the outage event. Used to classify the outage as transmission-level (typically ≥69 kV) or distribution-level, which determines applicable PUC and NERC reporting thresholds."@en ;
    rdfs:domain cmm:PucOutageReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:DamageAssessment a owl:Class ;
    rdfs:label "Damage Assessment"@en ;
    rdfs:comment "Field damage assessment record capturing infrastructure damage identified during outage response or storm patrol. Records assessment timestamp, assessed location (GPS coordinates, circuit, pole number), damage type (broken conductor, damaged transformer, downed pole, equipment failure, vegetation contact), severity rating, estimated repair time, materials required, crew performing assessment, and photographic evidence reference. Feeds restoration planning, material procurement, mutual aid resource estimation, and insurance/regulatory damage reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.damage_assessment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "Damage Assessment (GE PowerOn ADMS / Ventyx Asset Suite)" ;
    cmm:sourceObject "energy_utilities_ecm.outage.damage_assessment" ;
    owl:hasKey ( cmm:DamageAssessment.damageAssessmentId ) .

cmm:DamageAssessment.damageAssessmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage assessment id"@en ;
    rdfs:comment "Unique surrogate identifier for the field damage assessment record. Primary key for the damage_assessment data product in the outage domain."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "damage_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Damage Assessment ID" ;
    cmm:cimDatatype "Integer" .
cmm:DamageAssessment.complianceEnvironmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: Damage assessments may identify environmental permit violations (oil spills from damaged transformers, hazardous material releases). Environmental compliance officers review damage reports to assess p"@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "compliance_environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Environmental Permit Id (Foreign Key)" ;
    cmm:sourceColumn "environmental_permit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_compliance_environmental_permit_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:DamageAssessment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Damage assessment labor and vehicle costs are allocated to cost centers for O&M expense tracking and storm cost accounting. Essential for separating assessment costs from restoration costs in regulato"@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:DamageAssessment.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the field crew that performed this damage assessment. Used for crew accountability, workload tracking, and mutual aid resource estimation."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_crew_id" ;
    cmm:cimAssociation "Document.Crew" .
cmm:DamageAssessment.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation serving the damaged location. Used for outage scope analysis, switching order coordination, and reliability reporting at the substation level."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_distribution_substation_id" ;
    cmm:cimAssociation "Document.Substation" .
cmm:DamageAssessment.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the parent outage event that triggered this damage assessment. Links the assessment to the outage lifecycle for restoration planning and OMS integration."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_event_id" ;
    cmm:cimAssociation "Document.Outage" .
cmm:DamageAssessment.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution circuit (feeder) on which the damage was assessed. Used for outage scope determination, SAIDI/SAIFI/CAIDI calculations, and restoration sequencing by feeder."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Circuit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_feeder_id" ;
    cmm:cimAssociation "Document.Feeder" .
cmm:DamageAssessment.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Damage assessments identify specific materials needed for repairs (poles, transformers, wire). Field crews use this to requisition parts from inventory. The materials_required text field should be rep"@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_material_master_id" ;
    cmm:cimAssociation "Document.ErpItemMaster" .
cmm:DamageAssessment.primaryDamageAssessorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary damage assessor employee"@en ;
    rdfs:comment "Employee identifier of the field crew member who performed and submitted the damage assessment. Used for accountability, quality review, and training program analysis. References the workforce management system."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_damage_assessor_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assessor Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_primary_damage_assessor_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:DamageAssessment.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the specific utility infrastructure asset record in the asset management system that was assessed as damaged. Links to Ventyx Asset Suite and Esri ArcGIS Utility Network for asset lifecycle and geospatial tracking."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_damage_assessment_registry_id" ;
    cmm:cimAssociation "Document.Asset" .
cmm:DamageAssessment.assessmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment number"@en ;
    rdfs:comment "Externally-known business identifier for the damage assessment record, formatted as DA-YYYY-NNNNNN. Used in OMS incident tracking, insurance claims, regulatory damage reports, and mutual aid coordination."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Damage Assessment Number" ;
    cmm:valuePattern "^DA-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DamageAssessment.assessmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment status"@en ;
    rdfs:comment "Current lifecycle state of the damage assessment record. Drives restoration planning workflow: draft (field entry in progress), submitted (crew submitted for review), verified (supervisor confirmed), approved (cleared for work order creation), closed (repair completed), cancelled (assessment voided)."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Damage Assessment Status" ;
    cmm:validValues "draft|submitted|verified|approved|closed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:DamageAssessment.assessmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment timestamp"@en ;
    rdfs:comment "Date and time when the field crew performed the physical damage assessment at the site. Principal real-world event time used for SAIDI/SAIFI/CAIDI reliability index calculations and storm response timeline reporting."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "assessment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DamageAssessment.assetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset type"@en ;
    rdfs:comment "Type of utility infrastructure asset that sustained damage. Used for asset class reporting, material procurement planning, and reliability performance analysis by asset category. Aligns with Esri ArcGIS Utility Network asset classification. Reference-value candidates: conductor|transformer|pole|crossarm|insulator|fuse|switch|cable|substation_equipment|meter|service_drop|other."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Damaged Asset Type" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized cause code identifying the root cause of the damage (e.g., wind, lightning, vehicle contact, equipment failure, vegetation). Aligns with IEEE 1366 and NERC cause code taxonomy for reliability reporting. References outage.outage_cause for full cause hierarchy."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the damage assessment record was first created in the system. Used for audit trail, data lineage, and SLA compliance tracking."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:DamageAssessment.crewCountRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew count required"@en ;
    rdfs:comment "Number of crew members estimated to be required to complete the repair. Used for resource planning, mutual aid request sizing, and restoration workforce management during major storm events."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:int ;
    cmm:physicalColumn "crew_count_required" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Count Required" ;
    cmm:cimDatatype "Integer" .
cmm:DamageAssessment.criticalFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facility flag"@en ;
    rdfs:comment "Indicates whether the damage location affects a critical facility such as a hospital, emergency services, water treatment plant, or life-support customer. Triggers elevated restoration priority and regulatory notification requirements."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customers estimated to be without power due to the damage at this assessed location. Used for restoration prioritization, SAIDI/SAIFI/CAIDI index calculations, and regulatory reporting thresholds."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:DamageAssessment.damageDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage description"@en ;
    rdfs:comment "Free-text narrative description of the damage observed by the field crew. Captures details not covered by structured fields such as extent of damage, contributing factors, and site conditions. Used in insurance claims and regulatory damage reports."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "damage_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Damage Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:DamageAssessment.damageSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage severity"@en ;
    rdfs:comment "Severity rating of the assessed damage. Used for restoration prioritization, mutual aid resource estimation, and insurance/regulatory damage reporting. Critical indicates immediate public safety risk or bulk power system impact."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "damage_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Damage Severity Rating" ;
    cmm:validValues "minor|moderate|major|critical" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.damageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "damage type"@en ;
    rdfs:comment "Classification of the primary infrastructure damage identified during assessment. Drives material procurement, crew skill requirements, and restoration sequencing. Reference-value candidates: broken_conductor|damaged_transformer|downed_pole|equipment_failure|vegetation_contact|damaged_crossarm|fuse_blown|insulator_damage|underground_cable_fault|substation_damage|meter_damage|service_drop_damage."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "damage_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Damage Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:DamageAssessment.doeReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "doe reportable flag"@en ;
    rdfs:comment "Indicates whether the damage event meets DOE OE-417 reporting thresholds (e.g., affecting 50,000+ customers or critical infrastructure). Triggers DOE emergency reporting workflow."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "doe_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Department of Energy (DOE) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.estimatedRepairHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated repair hours"@en ;
    rdfs:comment "Field crew estimate of the time in hours required to complete repairs for the assessed damage. Used for estimated time of restoration (ETR) calculation, customer notification, and restoration planning prioritization."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_repair_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Repair Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:DamageAssessment.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Feature identifier from Esri ArcGIS Utility Network corresponding to the damaged asset or network segment. Enables geospatial analysis, damage heatmap generation, and network topology impact assessment."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Feature ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:DamageAssessment.insuranceClaimableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insurance claimable flag"@en ;
    rdfs:comment "Indicates whether the damage is eligible for an insurance claim (e.g., third-party vehicle contact, natural disaster coverage). Triggers insurance claim initiation workflow and cost recovery tracking."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "insurance_claimable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insurance Claimable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "GPS latitude coordinate (WGS84 decimal degrees) of the damage location recorded by the field crew. Enables geospatial mapping in GIS, storm damage heatmaps, and precise crew dispatch routing."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "GPS Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DamageAssessment.lifeSupportFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support flag"@en ;
    rdfs:comment "Indicates whether the damage location affects one or more customers registered on the life support or medical baseline program. Triggers immediate escalation and priority restoration per state PUC requirements."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "life_support_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.locationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location description"@en ;
    rdfs:comment "Free-text description of the damage location including street address, landmark references, or cross-street information. Supplements GPS coordinates for field crew navigation and customer communication."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Damage Location Description" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "GPS longitude coordinate (WGS84 decimal degrees) of the damage location recorded by the field crew. Enables geospatial mapping in GIS, storm damage heatmaps, and precise crew dispatch routing."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "GPS Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DamageAssessment.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether the damage event meets NERC reporting thresholds (e.g., bulk electric system impact, transmission-level damage). Triggers NERC EOP-004 event reporting workflow."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.omsIncidentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oms incident number"@en ;
    rdfs:comment "Incident number from the GE PowerOn ADMS Outage Management System associated with this damage assessment. Enables bidirectional traceability between the field assessment record and the OMS outage incident for restoration coordination."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "oms_incident_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Management System (OMS) Incident Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DamageAssessment.photoEvidenceRef a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "photo evidence ref"@en ;
    rdfs:comment "Reference path or URL to photographic evidence captured by the field crew during the damage assessment. Stored in the enterprise document management system. Used for insurance claims, regulatory damage reports, and contractor work verification."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "photo_evidence_ref" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Photographic Evidence Reference" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.poleNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pole number"@en ;
    rdfs:comment "Utility pole identifier at or nearest to the damage location. Standard field reference used by field crews, GIS systems, and OMS for precise location identification on the distribution network."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "pole_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Pole Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DamageAssessment.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Indicates whether the damage event meets state Public Utility Commission reporting thresholds for major outage or infrastructure damage notification. Triggers state regulatory reporting workflow."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.repairCompletedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "repair completed timestamp"@en ;
    rdfs:comment "Date and time when the repair identified in this damage assessment was completed and the asset was returned to service. Used for actual vs. estimated repair time analysis, SAIDI/CAIDI calculations, and post-storm performance reporting."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "repair_completed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Repair Completed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DamageAssessment.repairType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "repair type"@en ;
    rdfs:comment "Classification of the repair approach required based on the damage assessment. Drives work order type creation in SAP S/4HANA Plant Maintenance and material procurement in Ventyx Asset Suite."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "repair_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Repair Type" ;
    cmm:validValues "emergency_repair|temporary_repair|permanent_repair|replacement|no_repair_required" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the utility service territory or operating district where the damage occurred. Used for regulatory reporting by jurisdiction, mutual aid resource allocation, and storm damage aggregation by territory."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.specializedEquipmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "specialized equipment flag"@en ;
    rdfs:comment "Indicates whether the repair requires specialized equipment such as a digger derrick, aerial lift, cable puller, or transformer handling equipment. Used for resource dispatch planning and mutual aid equipment requests."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "specialized_equipment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Specialized Equipment Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.stormEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm event flag"@en ;
    rdfs:comment "Indicates whether this damage assessment is associated with a declared storm or major event. Used for Major Event Day (MED) exclusion from SAIDI/SAIFI calculations and storm cost recovery regulatory filings."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.thirdPartyLiabilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "third party liability flag"@en ;
    rdfs:comment "Indicates whether the damage was caused by a third party (e.g., vehicle accident, contractor damage, excavation). Triggers third-party liability claim process and cost recovery actions."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "third_party_liability_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Third Party Liability Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DamageAssessment.toOutageEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to outage event"@en ;
    rdfs:comment "FK to outage.outage_event.outage_event_id — Damage assessments are performed during outage response. Required for restoration planning and insurance/regulatory damage reporting."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_outage_event" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DamageAssessment.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when the damage assessment record was last modified. Used for change tracking, audit trail, and data synchronization with OMS and work management systems."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DamageAssessment.verifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verified timestamp"@en ;
    rdfs:comment "Date and time when the damage assessment was verified by a supervisor or field operations manager. Used for quality assurance tracking, SLA compliance, and audit trail of the assessment lifecycle."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "verified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Verified Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DamageAssessment.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) of the damaged infrastructure. Determines crew safety requirements, switching order complexity, restoration priority, and NERC/FERC reportability thresholds."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DamageAssessment.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather condition observed at the damage site at the time of assessment. Used for storm damage correlation, MED classification, insurance claims, and predictive analytics for future storm hardening investments. Reference-value candidates: clear|wind|rain|ice|snow|lightning|hurricane|tornado|flood|extreme_heat|other."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition at Assessment" ;
    cmm:cimDatatype "String" .
cmm:DamageAssessment.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "SAP S/4HANA Plant Maintenance work order number created as a result of this damage assessment. Links the assessment to the repair execution workflow for cost tracking, O&M reporting, and CAPEX/OPEX classification."@en ;
    rdfs:domain cmm:DamageAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:StormDerImpact a owl:Class ;
    rdfs:label "Storm Der Impact"@en ;
    rdfs:comment "This association product represents the operational impact assessment between a storm event and a distributed energy resource system. It captures DER performance, availability, and grid interaction behavior during major weather events for regulatory reporting, after-action analysis, and DER program evaluation. Each record links one storm event to one DER system with metrics that exist only in the context of that specific storm's impact on that specific DER asset.. Existence Justification: In energy utility operations, storm events impact multiple DER systems across the affected service territory (one storm affects hundreds or thousands of DER installations), and each DER system experiences multiple storm events over its operational lifetime (10-25 years). Utilities actively manage and track DER performance during Major Event Days for regulatory compliance (DOE OE-417 filings, IEEE 1366 MED reporting), after-action analysis, mutual aid coordination, and DER program evaluation. This is an operational assessment process, not an analytical correlation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
    cmm:physicalTable "utility_cmm_silver.outage.storm_der_impact" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.outage.storm_der_impact" ;
    owl:hasKey ( cmm:StormDerImpact.stormDerImpactId ) .

cmm:StormDerImpact.stormDerImpactId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm der impact id"@en ;
    rdfs:comment "Unique surrogate identifier for this storm-DER impact assessment record. Primary key for the association."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:long ;
    cmm:physicalColumn "storm_der_impact_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Storm DER Impact Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:StormDerImpact.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to the distributed energy resource system record. Identifies which specific DER installation experienced this storm impact."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Der Impact - Der System Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_der_impact_der_system_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerElectronicsConnection" .
cmm:StormDerImpact.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the utility staff member or system user who performed or validated this storm impact assessment. Used for accountability and data quality tracking."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assessed By User Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_der_impact_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:StormDerImpact.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Foreign key linking to the storm event record. Identifies which declared storm or major weather event this DER impact assessment belongs to."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Der Impact - Storm Event Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_outage_storm_der_impact_storm_event_id" ;
    cmm:cimAssociation "IdentifiedObject.Incident" .
cmm:StormDerImpact.derAvailabilityDuringStorm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der availability during storm"@en ;
    rdfs:comment "Operational availability classification of the DER system during the storm event. Indicates whether the system remained online, went offline, or operated in islanded mode. Used for resilience analysis and DER program evaluation."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_availability_during_storm" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER Availability Status During Storm" ;
    cmm:cimDatatype "String" .
cmm:StormDerImpact.gridSupportProvidedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid support provided flag"@en ;
    rdfs:comment "Indicates whether the DER system provided measurable grid support services during the storm event, such as voltage support, frequency regulation, or black start capability. Used for regulatory filings and DER value assessment."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "grid_support_provided_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grid Support Provided Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormDerImpact.impactAssessmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact assessment timestamp"@en ;
    rdfs:comment "Date and time when this storm-DER impact assessment record was created or last updated by operations staff. Used for audit trail and data quality verification."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "impact_assessment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impact Assessment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StormDerImpact.islandingAttemptsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "islanding attempts count"@en ;
    rdfs:comment "Number of times the DER system attempted to island (disconnect from grid and serve local load independently) during the storm event. Relevant for advanced inverter systems with IEEE 1547-2018 capabilities. Used to assess microgrid and resilience functionality."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:int ;
    cmm:physicalColumn "islanding_attempts_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Islanding Attempts Count" ;
    cmm:cimDatatype "Integer" .
cmm:StormDerImpact.performanceRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance rating"@en ;
    rdfs:comment "Qualitative assessment of the DER system's overall performance during the storm event based on availability, grid support contribution, and reconnection behavior. Used for after-action reports and DER program evaluation."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER Storm Performance Rating" ;
    cmm:cimDatatype "String" .
cmm:StormDerImpact.reconnectionDelayHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconnection delay hours"@en ;
    rdfs:comment "Number of hours between grid restoration at the DER installation location and successful DER system reconnection to the grid. Measures compliance with IEEE 1547 reconnection requirements and identifies potential protection system issues."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reconnection_delay_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconnection Delay Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:StormDerImpact.regulatoryReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting flag"@en ;
    rdfs:comment "Indicates whether this specific DER impact record is included in regulatory filings such as DOE OE-417 reports or state commission after-action reports. Used to filter records for compliance reporting."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StormDerImpact.stormDamageToDerFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm damage to der flag"@en ;
    rdfs:comment "Indicates whether the DER system sustained physical damage from the storm event requiring repair or replacement. Used for insurance claims, damage assessment reporting, and equipment reliability analysis."@en ;
    rdfs:domain cmm:StormDerImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "storm_damage_to_der_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storm Damage to DER Flag" ;
    cmm:cimDatatype "Boolean" .

