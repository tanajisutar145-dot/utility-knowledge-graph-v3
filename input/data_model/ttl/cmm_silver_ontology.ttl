    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Feeder.createdDateTime .
cmm:Feeder.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
