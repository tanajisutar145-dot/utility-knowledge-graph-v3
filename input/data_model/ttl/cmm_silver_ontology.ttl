cmm:TransmissionServiceAgreement.rtoIsoRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso region"@en ;
    rdfs:comment "RTO or ISO region in which this transmission service agreement operates (e.g., PJM, MISO, CAISO, ERCOT, SPP, NYISO, ISO-NE)."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Region" ;
    cmm:cimDatatype "String" .
cmm:TransmissionServiceAgreement.serviceSubtype a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service subtype"@en ;
    rdfs:comment "Subtype classification of transmission service indicating priority and curtailment rights: firm (guaranteed), non-firm (interruptible), or conditional firm."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_subtype" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Service Subtype" ;
    cmm:validValues "firm|non-firm|conditional_firm" ;
    cmm:cimDatatype "String" .
cmm:TransmissionServiceAgreement.serviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service type"@en ;
    rdfs:comment "Type of transmission service under OATT: PTP (Point-to-Point Transmission Service) or NITS (Network Integration Transmission Service)."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transmission Service Type" ;
