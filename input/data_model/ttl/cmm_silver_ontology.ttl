cmm:IncentiveProgram.enrollmentCapMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment cap mw"@en ;
    rdfs:comment "Maximum total capacity in megawatts (MW) that can be enrolled in the incentive program. Null if no capacity cap applies."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrollment_cap_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
