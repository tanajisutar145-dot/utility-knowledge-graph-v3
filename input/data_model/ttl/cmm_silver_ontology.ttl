    cmm:cimCloseMatch cim:Name.name .

cmm:TransmissionSwitchingOrder a owl:Class ;
    rdfs:label "Transmission Switching Order"@en ;
    rdfs:comment "Transactional record of a transmission switching order authorizing changes to the network topology (open/close breakers, isolate equipment). Captures order identifier, issuing dispatcher, affected substation and devices, switching sequence steps, safety clearance reference, planned execution time, actual execution time, and completion status. Supports safe switching operations and SCADA-driven topology changes in EMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SwitchingPlan ;
    cmm:cimExactMatch cim:SwitchingPlan ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.service_operations ;
    cmm:physicalTable "utility_cmm_silver.transmission.transmission_switching_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; NERC EOP / Transmission Switching Procedure" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.transmission_switching_order" ;
    owl:hasKey ( cmm:TransmissionSwitchingOrder.transmissionSwitchingOrderId ) .

cmm:TransmissionSwitchingOrder.transmissionSwitchingOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transmission switching order id"@en ;
    rdfs:comment "Unique identifier for the transmission switching order. Primary key for this entity."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "transmission_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Transmission Switching Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:TransmissionSwitchingOrder.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the user or system account that last modified this switching order record. Supports audit trail and change management compliance."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:TransmissionSwitchingOrder.goodsIssue a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "goods issue"@en ;
    rdfs:comment "Foreign key linking to supply.goods_issue. Business justification: Switching orders requiring materials (protective equipment, temporary jumpers, fuses, grounding equipment) trigger goods issues from warehouse stock. Direct operational linkage for material cost alloc"@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:GoodsIssue ;
    cmm:physicalColumn "goods_issue_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Goods Issue Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_goods_issue_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpIssueInventory" .
cmm:TransmissionSwitchingOrder.outageSwitchingOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "outage switching order"@en ;
    rdfs:comment "Foreign key linking to outage.outage_switching_order. Business justification: Transmission switching orders executed during outage restoration must link to OMS switching order tracking for unified crew coordination, safety clearance management, and NERC CIP compliance. Real-wor"@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:OutageSwitchingOrder ;
    cmm:physicalColumn "outage_switching_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Switching Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_outage_switching_order_id" ;
    cmm:cimAssociation "SwitchingPlan.SwitchingPlan" .
cmm:TransmissionSwitchingOrder.preSwitchingStateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pre switching state estimation run"@en ;
    rdfs:comment "Foreign key linking to grid.state_estimation_run. Business justification: Switching orders require pre-switching state estimation to validate topology changes, ensure voltage/thermal limits, and comply with NERC CIP-005 (electronic security perimeter changes). New FK captur"@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "pre_switching_state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Pre Switching State Estimation Run Id (Foreign Key)" ;
    cmm:sourceColumn "state_estimation_run_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_pre_switching_state_estimation_run_id" ;
    cmm:cimAssociation "SwitchingPlan.ActivityRecord" .
cmm:TransmissionSwitchingOrder.primaryTransmissionEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary transmission employee"@en ;
    rdfs:comment "Identifier of the transmission system operator or dispatcher who authorized and issued the switching order. Links to workforce or operator registry."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_transmission_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issuing Dispatcher ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_primary_transmission_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:TransmissionSwitchingOrder.tertiaryTransmissionVerifiedByOperatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary transmission verified by operator employee"@en ;
    rdfs:comment "Identifier of the operator or technician who verified the switching operation completion. May be different from the issuing dispatcher for independent verification."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "tertiary_transmission_verified_by_operator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Verified By Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_tertiary_transmission_verified_by_operator_employee_id" ;
    cmm:cimAssociation "SwitchingPlan.ErpPersonnel" .
cmm:TransmissionSwitchingOrder.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Identifier of the primary transmission substation where the switching operation will be executed. Links to the substation master data."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_switching_order_transmission_substation_id" ;
    cmm:cimAssociation "SwitchingPlan.Substation" .
cmm:TransmissionSwitchingOrder.actualCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion timestamp"@en ;
    rdfs:comment "Actual date and time when the switching operation was completed and verified. Used to calculate switching duration and operational efficiency metrics."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionSwitchingOrder.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time when the switching operation execution began. Captured from SCADA or operator log entry for performance tracking and compliance reporting."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionSwitchingOrder.affectedEquipmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected equipment code"@en ;
    rdfs:comment "Unique identifier or tag of the specific equipment device to be switched. References equipment asset registry and SCADA tag database."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_equipment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Equipment ID" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.affectedEquipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected equipment type"@en ;
    rdfs:comment "Type of transmission equipment that will be operated or isolated by this switching order. Determines safety protocols and operational procedures."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Equipment Type" ;
    cmm:validValues "circuit_breaker|disconnect_switch|transformer|bus_section|capacitor_bank|reactor" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.affectedLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected load mw"@en ;
    rdfs:comment "Estimated or actual load in megawatts that was transferred, interrupted, or affected by the switching operation. Used for impact assessment and reliability reporting."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "affected_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Load Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:TransmissionSwitchingOrder.approvingAuthorityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approving authority name"@en ;
    rdfs:comment "Full name of the approving authority for audit trail and compliance documentation."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "approving_authority_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approving Authority Name" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.atcRecalculationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc recalculation required flag"@en ;
    rdfs:comment "Indicates whether the switching operation changes network topology sufficiently to require recalculation of Available Transfer Capability for transmission service scheduling."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "atc_recalculation_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ATC (Available Transfer Capability) Recalculation Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.cipComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cip compliance flag"@en ;
    rdfs:comment "Indicates whether this switching order involves CIP-designated critical cyber assets requiring enhanced security controls and audit logging per NERC CIP standards."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cip_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CIP (Critical Infrastructure Protection) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.completionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion notes"@en ;
    rdfs:comment "Free-text operational notes documenting any deviations from planned procedure, unexpected conditions encountered, or additional actions taken during switching execution."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "completion_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Completion Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:TransmissionSwitchingOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this switching order record was first created in the system. Audit trail for order lifecycle tracking."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:SwitchingPlan.createdDateTime .
cmm:TransmissionSwitchingOrder.durationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration minutes"@en ;
    rdfs:comment "Total elapsed time in minutes from start to completion of the switching operation. Used for performance analysis and future planning."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:TransmissionSwitchingOrder.emsTopologyChangeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems topology change code"@en ;
    rdfs:comment "Identifier of the corresponding network topology change event in the Energy Management System. Links switching order to power flow model updates and state estimation."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_topology_change_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "EMS (Energy Management System) Topology Change ID" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Description of the reason for switching operation failure if status is failed or suspended. Documents equipment malfunction, safety concerns, or procedural issues."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Failure Reason" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.issuingDispatcherName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing dispatcher name"@en ;
    rdfs:comment "Full name of the transmission system operator or dispatcher who issued the switching order for audit and accountability purposes."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_dispatcher_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Dispatcher Name" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this switching order record was last updated. Tracks changes to order status, execution details, or verification information."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:TransmissionSwitchingOrder.nercBesDesignation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc bes designation"@en ;
    rdfs:comment "Indicates whether the affected equipment is designated as part of the Bulk Electric System under NERC reliability standards. BES-designated equipment requires enhanced documentation and compliance reporting."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_bes_designation" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) BES (Bulk Electric System) Designation" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.oattImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oatt impact flag"@en ;
    rdfs:comment "Indicates whether this switching operation affects transmission capacity or service under OATT agreements, requiring customer notification or ATC recalculation."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "oatt_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OATT (Open Access Transmission Tariff) Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.orderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order number"@en ;
    rdfs:comment "Externally-known unique business identifier for the switching order, typically formatted as TSO-YYYYMMDD-NNNN for tracking and reference in operational logs and SCADA systems."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:valuePattern "^TSO-[0-9]{8}-[0-9]{4}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TransmissionSwitchingOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle status of the switching order in the operational workflow. Tracks progression from draft through execution to completion or cancellation. Reference-value candidates: draft|approved|scheduled|in_progress|completed|cancelled|suspended|failed."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.status .
cmm:TransmissionSwitchingOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classification of the switching order based on operational purpose. Planned orders support scheduled maintenance, emergency orders respond to grid events, restoration orders support outage recovery."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Type" ;
    cmm:validValues "planned|emergency|maintenance|restoration|testing|commissioning" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:SwitchingPlan.kind .
cmm:TransmissionSwitchingOrder.outageEventReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage event reference"@en ;
    rdfs:comment "Reference to the outage event or restoration plan if this switching order is part of emergency restoration or planned outage operations."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_event_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Event Reference" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.plannedExecutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned execution timestamp"@en ;
    rdfs:comment "Scheduled date and time when the switching operation is planned to be executed. Used for operational coordination and resource scheduling."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "planned_execution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Execution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionSwitchingOrder.postSwitchingCurrentAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post switching current amps"@en ;
    rdfs:comment "Measured current flow in amperes through the affected equipment immediately after the switching operation. Validates load redistribution and equipment status."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_switching_current_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Switching Current Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:TransmissionSwitchingOrder.postSwitchingVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post switching voltage kv"@en ;
    rdfs:comment "Measured voltage level in kilovolts at the affected equipment location immediately after the switching operation. Confirms successful execution and grid stability."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_switching_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Switching Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:TransmissionSwitchingOrder.preSwitchingCurrentAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre switching current amps"@en ;
    rdfs:comment "Measured current flow in amperes through the affected equipment immediately before the switching operation. Critical for load transfer verification."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_switching_current_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Switching Current Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:TransmissionSwitchingOrder.preSwitchingVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre switching voltage kv"@en ;
    rdfs:comment "Measured voltage level in kilovolts at the affected equipment location immediately before the switching operation. Used for operational verification and safety validation."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_switching_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Switching Voltage Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:TransmissionSwitchingOrder.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Operational priority assigned to the switching order. Critical priority indicates immediate grid reliability impact requiring expedited execution."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Priority Level" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:TransmissionSwitchingOrder.rtoIsoApprovalReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso approval reference"@en ;
    rdfs:comment "Reference number or identifier of RTO/ISO approval or coordination acknowledgment if required for this switching operation. Links to regional coordination records."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_approval_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO (Regional Transmission Organization) ISO (Independent System Operator) Approval Reference" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.rtoIsoNotificationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso notification flag"@en ;
    rdfs:comment "Indicates whether the RTO or ISO was notified of this switching operation due to potential impact on regional transmission capacity or market operations."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rto_iso_notification_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO (Regional Transmission Organization) ISO (Independent System Operator) Notification Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.safetyClearanceReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance reference"@en ;
    rdfs:comment "Reference number or identifier of the associated safety clearance or work permit authorizing personnel to work on or near the affected equipment. Links to safety clearance records."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Clearance Reference" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.scadaCommandCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada command code"@en ;
    rdfs:comment "Unique identifier of the SCADA command or control sequence that executed the switching operation. Links to SCADA historian for detailed telemetry and event reconstruction."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_command_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Command ID" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.scadaIntegrationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada integration flag"@en ;
    rdfs:comment "Indicates whether the switching operation was executed via SCADA remote control (true) or manual field operation (false). Critical for automation tracking and reliability analysis."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_integration_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Integration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionSwitchingOrder.switchingAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching action"@en ;
    rdfs:comment "Primary switching action to be performed on the affected equipment. Open and close apply to breakers and switches, isolate and energize apply to equipment sections. Reference-value candidates: open|close|isolate|energize|de_energize|ground|test."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_action" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Action" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.switchingSequenceSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching sequence steps"@en ;
    rdfs:comment "Detailed step-by-step procedure for executing the switching operation in correct sequence. Includes device identifiers, actions, and verification checkpoints to ensure safe topology changes."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_sequence_steps" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Sequence Steps" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.verificationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification method"@en ;
    rdfs:comment "Method used to verify successful completion of the switching operation. SCADA telemetry provides remote confirmation, field visual requires on-site operator verification."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "verification_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Verification Method" ;
    cmm:validValues "scada_telemetry|field_visual|relay_indication|meter_reading|remote_camera" ;
    cmm:cimDatatype "String" .
cmm:TransmissionSwitchingOrder.verificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification timestamp"@en ;
    rdfs:comment "Date and time when the switching operation was verified and confirmed complete. May differ from completion timestamp if verification requires additional checks."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "verification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Verification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionSwitchingOrder.workOrderReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order reference"@en ;
    rdfs:comment "Reference to the maintenance or construction work order that necessitates this switching operation. Links to asset management work order system."@en ;
    rdfs:domain cmm:TransmissionSwitchingOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Order Reference" ;
    cmm:cimDatatype "String" .

cmm:ProtectionDevice a owl:Class ;
    rdfs:label "Protection Device"@en ;
    rdfs:comment "Master record for transmission protection devices including protective relays, high-voltage circuit breakers, and disconnect switches at transmission substations. Captures device identifier, device type (relay/breaker/disconnect), voltage class (kV), for relays: relay type (distance, differential, overcurrent), manufacturer, model, firmware version, zone of protection, trip settings, last test date; for breakers: interrupting rating (kA), operating mechanism type, trip counter, last maintenance date; associated protected element (line/transformer/bus), SCADA integration tag, installation date, and operational status. Critical for NERC PRC compliance, fault clearing performance, switching operations, and fault isolation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ProtectionEquipment ;
    cmm:cimExactMatch cim:ProtectionEquipment ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Protection" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.asset_management ;
    cmm:physicalTable "utility_cmm_silver.transmission.protection_device" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "NERC PRC; NERC PRC-001 / IEEE C37.90 Protection Relay" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.protection_device" ;
    owl:hasKey ( cmm:ProtectionDevice.protectionDeviceId ) .

cmm:ProtectionDevice.protectionDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection device id"@en ;
    rdfs:comment "Primary key for protection_device"@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range xsd:long ;
    cmm:physicalColumn "protection_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Protection Device Identifier" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:ProtectionDevice.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Protection relays and devices are capitalized assets tracked for depreciation, replacement planning, and capital budgeting. Essential for asset lifecycle management and financial reporting under FERC"@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_protection_device_fixed_asset_id" ;
    cmm:cimAssociation "ProtectionEquipment.FinancialInfo" .
cmm:ProtectionDevice.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Protection relays and devices require material master linkage for spare parts management, firmware update tracking, warranty administration, and replacement planning. Critical for NERC CIP supply chai"@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_protection_device_material_master_id" ;
    cmm:cimAssociation "ProtectionEquipment.ErpItemMaster" .
cmm:ProtectionDevice.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: Protection relays are cyber assets requiring CIP-010 configuration baseline management and CIP-007 patch management. Microprocessor-based relays with network connectivity are explicitly covered under"@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_protection_device_nerc_cip_asset_id" ;
    cmm:cimAssociation "ProtectionEquipment.Asset" .
cmm:ProtectionDevice.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Protection relays and devices are tracked assets requiring periodic testing, maintenance, and replacement per NERC CIP compliance requirements. Utilities maintain asset records for lifecycle managemen"@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_protection_device_registry_id" ;
    cmm:cimAssociation "ProtectionEquipment.Asset" .
cmm:ProtectionDevice.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Supervisory Control and Data Acquisition (SCADA) system tag identifier for real-time monitoring and control integration of the protection device."@en ;
    rdfs:domain cmm:ProtectionDevice ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
