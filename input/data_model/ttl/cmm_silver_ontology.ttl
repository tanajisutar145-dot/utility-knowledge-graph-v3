cmm:ClusterStudyGroup.geographicStudyArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic study area"@en ;
    rdfs:comment "Geographic boundary or service territory area encompassing all interconnection applications included in this cluster study group. May reference feeder, substation zone, planning area, or transmission zone."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_study_area" ;
