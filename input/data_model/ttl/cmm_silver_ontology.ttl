cmm:JobRequisition.workLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location code"@en ;
    rdfs:comment "Reference to the primary work location (service center, plant, substation, office) where the employee will be based. Critical for field crew and operations roles."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_location_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Location Identifier (ID)" ;
    cmm:cimDatatype "Integer" .

cmm:MutualAidDeployment a owl:Class ;
    rdfs:label "Mutual Aid Deployment"@en ;
    rdfs:comment "Records of utility workforce and contractor crews deployed under mutual aid agreements during major storm events, natural disasters, or grid emergencies. Captures requesting utility, providing utility or contractor, crew type, number of personnel, deployment start/end dates, work location, restoration tasks performed, and reimbursable cost. Supports EATON/EEI mutual aid cost recovery, FEMA reimbursement documentation, and post-storm after-action reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Assignment ;
    cmm:cimExtends cim:Assignment ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.mutual_aid_deployment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EEI Mutual Assistance; EEI Mutual Assistance Agreement; FEMA PA Program" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.mutual_aid_deployment" ;
    owl:hasKey ( cmm:MutualAidDeployment.mutualAidDeploymentId ) .

cmm:MutualAidDeployment.mutualAidDeploymentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid deployment id"@en ;
    rdfs:comment "Unique identifier for the mutual aid deployment record. Primary key."@en ;
    rdfs:domain cmm:MutualAidDeployment ; rdfs:range xsd:long ;
    cmm:physicalColumn "mutual_aid_deployment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Mutual Aid Deployment ID" ;
    cmm:cimDatatype "Integer" .
cmm:MutualAidDeployment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Mutual aid deployments track cost centers for reimbursement tracking, cost recovery, and financial reporting. Replacing denormalized cost_allocation_code with proper FK to cost_center."@en ;
    rdfs:domain cmm:MutualAidDeployment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_mutual_aid_deployment_cost_center_id" ;
    cmm:cimAssociation "Assignment.Organisation" .
cmm:MutualAidDeployment.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "FK to workforce.crew.crew_id — Mutual aid deployments send specific crews to requesting utilities. This link enables tracking which crews are deployed, their availability status, and restoration cost allocation."@en ;
    rdfs:domain cmm:MutualAidDeployment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_mutual_aid_deployment_crew_id" ;
    cmm:cimAssociation "Assignment.Crew" .
cmm:MutualAidDeployment.deploymentCoordinatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
