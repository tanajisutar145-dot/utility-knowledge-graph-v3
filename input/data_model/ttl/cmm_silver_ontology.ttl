    rdfs:domain cmm:PlanningPeriod ; rdfs:range xsd:long ;
    cmm:physicalColumn "planning_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
