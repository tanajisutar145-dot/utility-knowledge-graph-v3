cmm:PowerPlant.fuelMixClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel mix classification"@en ;
    rdfs:comment "Primary fuel or energy source used by the generation facility. For multi-fuel plants, indicates the predominant fuel type. Reference-value candidates: coal|natural_gas|nuclear|hydro|wind|solar|biomass|geothermal|oil|dual_fuel|multi_fuel."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_mix_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Mix Classification" ;
    cmm:cimDatatype "String" .
cmm:PowerPlant.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
