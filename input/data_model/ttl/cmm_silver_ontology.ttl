cmm:PpaSettlement.transmissionChargeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transmission charge amount"@en ;
    rdfs:comment "Transmission service charges in dollars allocated to this settlement period for delivery of renewable generation to the point of interconnection or delivery point."@en ;
