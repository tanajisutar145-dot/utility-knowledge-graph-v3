cmm:DepreciationRun a owl:Class ;
    rdfs:label "Depreciation Run"@en ;
    rdfs:comment "Master reference table for depreciation_run. Referenced by depreciation_run_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.asset_accounting ;
    cmm:physicalTable "utility_cmm_silver.finance.depreciation_run" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.finance.depreciation_run" ;
    owl:hasKey ( cmm:DepreciationRun.depreciationRunId ) .

cmm:DepreciationRun.depreciationRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
