cmm:Crew.lastSafetyTrainingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last safety training date"@en ;
    rdfs:comment "Date of most recent crew-level safety training session. Used to track compliance with annual refresher requirements and identify crews due for recertification."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_safety_training_date" ;
