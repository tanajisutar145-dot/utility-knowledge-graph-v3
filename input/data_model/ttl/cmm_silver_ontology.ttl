cmm:NemCredit.creditAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit amount"@en ;
    rdfs:comment "Total dollar value of NEM credits earned during this period, calculated as exported_energy_kwh multiplied by credit_rate_per_kwh."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:NemCredit.creditAppliedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit applied amount"@en ;
    rdfs:comment "Dollar amount of NEM credits applied to offset current billing period charges, reducing the customer's net invoice amount."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_applied_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
