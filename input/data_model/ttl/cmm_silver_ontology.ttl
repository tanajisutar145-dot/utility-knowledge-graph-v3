    rdfs:comment "Reason for termination or suspension of the contractor worker engagement (e.g., contract completion, safety violation, performance issue, voluntary departure). Null if status is active."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
