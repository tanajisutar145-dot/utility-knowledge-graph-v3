cmm:JobRequisition.requisitionJustification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition justification"@en ;
    rdfs:comment "Business reason for the hiring request. Supports headcount planning and budget approval processes. Distinguishes between replacement hires and net new positions. Reference-value candidates: backfill_retirement|backfill_resignation|backfill_termination|new_headcount_growth|new_headcount_project|seasonal_demand|regulatory_requirement|workload_increase."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "requisition_justification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requisition Justification" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.requisitionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition number"@en ;
    rdfs:comment "Business identifier for the job requisition, typically formatted as REQ-NNNNNN. Used for external communication and tracking in recruitment systems."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "requisition_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
