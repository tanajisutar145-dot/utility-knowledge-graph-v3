    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:SelfReport.reportType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report type"@en ;
    rdfs:comment "Classification of the self-report based on the regulatory framework and submission process used."@en ;
