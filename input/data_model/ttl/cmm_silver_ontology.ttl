cmm:FuelPriceAssumption.transportationCostPerUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transportation cost per unit"@en ;
    rdfs:comment "Assumed transportation cost per unit of fuel (e.g., dollars per MMBtu for gas pipeline, dollars per ton for coal rail). Added to base fuel price to calculate delivered cost at generation facility."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "transportation_cost_per_unit" ;
