cmm:OperatorLog a owl:Class ;
    rdfs:label "Operator Log"@en ;
    rdfs:comment "Chronological record of all system operator actions, EMS alarms, voltage control actions, and observations recorded during grid operations. Operator log attributes include entry timestamp, operator ID, shift reference, entry type (action taken, alarm, voltage control action, verbal communication, abnormal condition noted, switching order issued), free-text narrative, associated equipment or event reference, and priority level. Alarm attributes (entry_type=alarm) include alarm type (limit violation, equipment status change, communication failure, protection relay operation), alarm priority (critical/major/minor), associated SCADA point or EMS node, alarm message text, acknowledgment timestamp, and clearance timestamp. Voltage control attributes (entry_type=voltage_control) include control type (capacitor bank switching, reactor switching, transformer tap change, generator VAR dispatch), controlled device, pre/post-action voltage (kV), MVAR change, and initiating cause (automatic/operator). SSOT for the unified operational event log required by NERC TOP-001, NERC FAC-001 voltage profile compliance, alarm management performance tracking, post-event investigations, and regulatory audits."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.operator_log" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC COM/TOP; NERC TOP-001 Operator Log" ;
    cmm:sourceObject "energy_utilities_ecm.grid.operator_log" ;
    owl:hasKey ( cmm:OperatorLog.operatorLogId ) .

cmm:OperatorLog.operatorLogId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator log id"@en ;
    rdfs:comment "Unique identifier for the operator log entry. Primary key for the operator log record."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:long ;
    cmm:physicalColumn "operator_log_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Operator Log ID" ;
    cmm:cimDatatype "Integer" .
cmm:OperatorLog.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Operator logs are primary evidence during NERC audits for TOP and IRO standards. Auditors review logs to verify operator actions during system events and compliance with operating procedures. This lin"@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_audit_id" ;
    cmm:cimAssociation "Document.ActivityRecord" .
cmm:OperatorLog.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Unique identifier of the system operator who created the log entry. Used for accountability, audit trails, and NERC compliance verification."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:OperatorLog.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Reference to the EMS node or bus associated with the log entry. Applicable when the entry relates to a specific electrical node in the network model."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Node ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_ems_node_id" ;
    cmm:cimAssociation "Document.TopologicalNode" .
cmm:OperatorLog.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Operators log actions during outage events for audit trail, shift handover, and regulatory compliance. Linking enables comprehensive event reconstruction and NERC compliance documentation."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_event_id" ;
    cmm:cimAssociation "Document.Outage" .
cmm:OperatorLog.operatorScadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator scada point"@en ;
    rdfs:comment "Reference to the SCADA telemetry point associated with the log entry. Links the entry to specific real-time measurement or control points."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "operator_scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_operator_scada_point_id" ;
    cmm:cimAssociation "Document.Measurement" .
cmm:OperatorLog.primaryOperatorControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary operator control area"@en ;
    rdfs:comment "Reference to the control area or balancing authority area where the logged event occurred. Links the entry to the responsible operational jurisdiction."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "primary_operator_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:sourceColumn "control_area_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_primary_operator_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:OperatorLog.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Operators frequently log observations about specific equipment (unusual noise, oil leak, temperature anomaly, visual damage). These narrative entries feed asset condition assessments, health index cal"@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_registry_id" ;
    cmm:cimAssociation "Document.Asset" .
cmm:OperatorLog.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "FK to grid.scada_point.scada_point_id — After merging ems_alarm and voltage_control_action into operator_log, alarm entries reference associated SCADA points. Required for alarm-to-measurement correlation."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_scada_point_id" ;
    cmm:cimAssociation "Document.Measurement" .
cmm:OperatorLog.shiftAssignment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "shift assignment"@en ;
    rdfs:comment "Identifier for the operational shift during which the log entry was created. Links entries to specific shift periods for crew accountability and handover analysis."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:ShiftAssignment ;
    cmm:physicalColumn "shift_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Shift ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_shift_assignment_id" ;
    cmm:cimAssociation "Document.Assignment" .
cmm:OperatorLog.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Reference to the state estimation solution run active at the time of the log entry. Links operator actions to the network state model."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimator Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operator_log_state_estimation_run_id" ;
    cmm:cimAssociation "Document.ActivityRecord" .
cmm:OperatorLog.abnormalConditionCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "abnormal condition category"@en ;
    rdfs:comment "Classification of the abnormal condition when entry_type is abnormal_condition_noted. Categorizes the type of operational anomaly observed."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "abnormal_condition_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Abnormal Condition Category" ;
    cmm:validValues "frequency_deviation|voltage_deviation|equipment_malfunction|weather_impact|load_forecast_error|other" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.aceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace mw"@en ;
    rdfs:comment "Area control error in megawatts at the time of the log entry. Key metric for balancing authority performance and CPS compliance."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ace_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Area Control Error (ACE) in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OperatorLog.agcModeAtEntry a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc mode at entry"@en ;
    rdfs:comment "Operating mode of the automatic generation control system at the time of the log entry. Documents the AGC state for operational context."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "agc_mode_at_entry" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Mode at Entry" ;
    cmm:validValues "automatic|manual|off" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.alarmAcknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the alarm was acknowledged by the operator. Used for alarm response time analysis and operator performance metrics."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "alarm_acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatorLog.alarmClearanceTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm clearance timestamp"@en ;
    rdfs:comment "Date and time when the alarm condition was cleared or resolved. Marks the end of the alarm lifecycle for duration analysis."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "alarm_clearance_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Clearance Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatorLog.alarmMessageText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm message text"@en ;
    rdfs:comment "System-generated alarm message text when entry_type is alarm. Captures the exact alarm notification presented to the operator."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_message_text" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Message Text" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.alarmPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm priority"@en ;
    rdfs:comment "Priority classification of the alarm when entry_type is alarm. Indicates the operational severity and required response urgency."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Priority" ;
    cmm:validValues "critical|major|minor" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.alarmType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm type"@en ;
    rdfs:comment "Classification of the alarm when entry_type is alarm. Categorizes the nature of the alarm condition for alarm management and performance tracking."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Type" ;
    cmm:validValues "limit_violation|equipment_status_change|communication_failure|protection_relay_operation|other" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.communicationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication method"@en ;
    rdfs:comment "Method or channel used for the communication when entry_type is verbal_communication. Documents the communication medium for audit purposes."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Method" ;
    cmm:validValues "phone|radio|ems_messaging|email|other" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.communicationParty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication party"@en ;
    rdfs:comment "Identifier or name of the external party involved in the communication when entry_type is verbal_communication. May include other control areas, reliability coordinators, or field personnel."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_party" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Party" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.contingencyAnalysisFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis flag"@en ;
    rdfs:comment "Flag indicating whether the log entry is related to a contingency analysis result or violation. Links operator actions to contingency assessment outcomes."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OperatorLog.controlInitiatingCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control initiating cause"@en ;
    rdfs:comment "Classification of what triggered the voltage control action. Distinguishes between automatic system responses, manual operator interventions, scheduled actions, and emergency responses."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_initiating_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Initiating Cause" ;
    cmm:validValues "automatic|operator_manual|scheduled|emergency" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.controlledDevice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "controlled device"@en ;
    rdfs:comment "Identifier or name of the device that was controlled when entry_type is voltage_control_action. Specifies the equipment operated for voltage regulation."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "controlled_device" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Controlled Device" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the operator log record was first created in the lakehouse silver layer. Audit field for data lineage tracking."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:OperatorLog.entryNarrative a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entry narrative"@en ;
    rdfs:comment "Free-text narrative description of the operator action, observation, or event. Provides detailed context and operator commentary for post-event analysis and regulatory review."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "entry_narrative" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entry Narrative" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.entryTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entry timestamp"@en ;
    rdfs:comment "Date and time when the operator log entry was recorded in the EMS system. This is the principal event timestamp for the log entry, critical for chronological reconstruction of grid operations and NERC TOP-001 compliance."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "entry_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entry Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatorLog.entryType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entry type"@en ;
    rdfs:comment "Classification of the operator log entry type. Discriminates between operator actions, system alarms, voltage control activities, communications, abnormal conditions, and switching orders."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "entry_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entry Type" ;
    cmm:validValues "action_taken|alarm|voltage_control_action|verbal_communication|abnormal_condition_noted|switching_order_issued" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.equipmentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment reference"@en ;
    rdfs:comment "Free-text reference to the equipment, device, or facility associated with the log entry. May include breaker names, transformer IDs, line designations, or substation names."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Reference" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.frequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency hz"@en ;
    rdfs:comment "System frequency in hertz at the time of the log entry. Critical measurement for frequency regulation and NERC BAL standard compliance."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_hz" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:OperatorLog.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when the operator log record was last modified in the lakehouse silver layer. Audit field for change tracking."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OperatorLog.mvarChange a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mvar change"@en ;
    rdfs:comment "Change in reactive power in megavolt-amperes reactive resulting from the voltage control action. Quantifies the reactive power adjustment made."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mvar_change" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megavolt-Ampere Reactive (MVAR) Change" ;
    cmm:cimDatatype "Decimal" .
cmm:OperatorLog.nercReportableEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable event"@en ;
    rdfs:comment "Flag indicating whether the logged event meets NERC EOP-004 criteria for mandatory event reporting. Used for regulatory compliance tracking."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_event" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Event" ;
    cmm:cimDatatype "Boolean" .
cmm:OperatorLog.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional free-text notes or comments added by operators or analysts during post-event review. Supplementary information for investigation and compliance documentation."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:OperatorLog.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name associated with the log entry. Links the operator log to time-series telemetry data for integrated analysis."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Tag Name" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.postActionVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post action voltage kv"@en ;
    rdfs:comment "Voltage level in kilovolts measured after the voltage control action was completed. Result measurement for evaluating control effectiveness."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_action_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Action Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OperatorLog.preActionVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre action voltage kv"@en ;
    rdfs:comment "Voltage level in kilovolts measured before the voltage control action was taken. Baseline measurement for evaluating control effectiveness."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_action_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Action Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OperatorLog.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Operational priority or severity level assigned to the log entry. Used for filtering critical events and prioritizing post-event review activities."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:validValues "critical|high|medium|low|informational" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:OperatorLog.reliabilityCoordinatorNotified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability coordinator notified"@en ;
    rdfs:comment "Flag indicating whether the reliability coordinator was notified of the event or condition. Critical for NERC TOP-001 compliance verification."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reliability_coordinator_notified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reliability Coordinator Notified" ;
    cmm:cimDatatype "Boolean" .
cmm:OperatorLog.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the source system that generated or recorded the operator log entry. Typically the EMS, SCADA, or operator logging application."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:OperatorLog.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Unique identifier of the switching order when entry_type is switching_order_issued. Links the log entry to the formal switching procedure documentation."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:OperatorLog.toSwitchingOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to switching order"@en ;
    rdfs:comment "FK to grid.switching_order.switching_order_id — Operator log entries frequently reference switching orders being issued or executed. This FK enables audit trail linkage between operator actions and switching operations for NERC TOP compliance."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_switching_order" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:OperatorLog.voltageControlType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage control type"@en ;
    rdfs:comment "Classification of the voltage control action when entry_type is voltage_control_action. Identifies the specific control mechanism employed."@en ;
    rdfs:domain cmm:OperatorLog ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_control_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Control Type" ;
    cmm:validValues "capacitor_bank_switching|reactor_switching|transformer_tap_change|generator_var_dispatch|other" ;
    cmm:cimDatatype "String" .

cmm:EmsAlarm a owl:Class ;
    rdfs:label "Ems Alarm"@en ;
    rdfs:comment "Transactional record of EMS alarms generated by the SCADA/EMS system for abnormal conditions on the grid. Captures alarm timestamp, alarm type (limit violation, equipment status change, communication failure, protection relay operation), priority level (critical/major/minor), associated SCADA point or EMS node, alarm message text, operator acknowledgment timestamp, operator ID, and alarm clearance timestamp. Supports NERC TOP situational awareness requirements and alarm management performance tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.ems_alarm" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 62682 Alarm Management / NERC TOP-001" ;
    cmm:sourceObject "energy_utilities_ecm.grid.ems_alarm" ;
    owl:hasKey ( cmm:EmsAlarm.emsAlarmId ) .

cmm:EmsAlarm.emsAlarmId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm id"@en ;
    rdfs:comment "Unique identifier for the EMS alarm record. Primary key for the alarm transaction."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:long ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Energy Management System (EMS) Alarm Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EmsAlarm.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: EMS alarms indicating limit violations or equipment failures can be audit findings under NERC TOP or FAC standards. Auditors review alarm response times and operator actions. This link enables finding"@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_audit_finding_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:EmsAlarm.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the control area or balancing authority responsible for the grid segment where the alarm originated. Supports multi-area alarm management and NERC reporting."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:EmsAlarm.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the alarm condition originated, enabling geographic and asset-based alarm analysis."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_distribution_substation_id" ;
    cmm:cimAssociation "ActivityRecord.Substation" .
cmm:EmsAlarm.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Critical EMS alarms (equipment failure, thermal overload) may trigger emergency material deployment for equipment replacement before catastrophic failure. Links alarm escalation to emergency stock mob"@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_emergency_stock_event_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:EmsAlarm.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User ID or employee identifier of the operator who acknowledged the alarm. Supports accountability and audit trail for alarm handling."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Acknowledged By Operator Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:EmsAlarm.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Reference to the EMS node (bus) associated with the alarm, if the alarm pertains to a specific electrical node in the power system model."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Node Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_ems_node_id" ;
    cmm:cimAssociation "ActivityRecord.TopologicalNode" .
cmm:EmsAlarm.emsScadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems scada point"@en ;
    rdfs:comment "Reference to the SCADA point that triggered the alarm, if the alarm is associated with a specific telemetry measurement or control point."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "ems_scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_ems_scada_point_id" ;
    cmm:cimAssociation "ActivityRecord.Measurement" .
cmm:EmsAlarm.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: EMS alarms (voltage violations, equipment overloads) may trigger or result from outages. Linking enables alarm correlation, root cause analysis, and coordinated response between transmission and distr"@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_event_id" ;
    cmm:cimAssociation "ActivityRecord.Outage" .
cmm:EmsAlarm.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: EMS alarms often indicate asset-level issues (overheating transformer, breaker failure, capacitor bank malfunction). Linking alarms to asset records enables automated work order creation, asset health"@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_registry_id" ;
    cmm:cimAssociation "ActivityRecord.Asset" .
cmm:EmsAlarm.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "FK to grid.scada_point.scada_point_id — EMS alarms are triggered by SCADA point limit violations or status changes. The FK to scada_point identifies which measurement or status point generated the alarm — essential for alarm management and"@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_alarm_scada_point_id" ;
    cmm:cimAssociation "ActivityRecord.Measurement" .
cmm:EmsAlarm.acknowledgedByOperatorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledged by operator name"@en ;
    rdfs:comment "Full name of the operator who acknowledged the alarm. Provides human-readable audit trail for alarm management."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "acknowledged_by_operator_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledged By Operator Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.acknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the alarm was acknowledged by an operator. Null if the alarm has not yet been acknowledged. Used to track operator response time and alarm management performance."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsAlarm.alarmCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm category"@en ;
    rdfs:comment "High-level categorization of the alarm for filtering and reporting purposes. Groups alarms into operational, equipment, communication, protection, system, and security categories."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Alarm Category" ;
    cmm:validValues "operational|equipment|communication|protection|system|security" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.kind .
cmm:EmsAlarm.alarmDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm duration seconds"@en ;
    rdfs:comment "Total duration in seconds from alarm generation to clearance. Calculated field used for alarm management performance analysis and NERC TOP situational awareness metrics."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:int ;
    cmm:physicalColumn "alarm_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:EmsAlarm.alarmMessage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm message"@en ;
    rdfs:comment "Detailed textual description of the alarm condition generated by the EMS system. Provides context and specifics about the abnormal condition for operator situational awareness."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_message" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Message Text" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.alarmNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm number"@en ;
    rdfs:comment "Business identifier for the alarm, typically a sequential or formatted alarm number assigned by the EMS system for operator reference and tracking."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Alarm Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:EmsAlarm.alarmSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm source"@en ;
    rdfs:comment "Identifies the functional source or subsystem within the EMS that generated the alarm: SCADA telemetry, state estimator, contingency analysis, AGC, protection system, or manual operator entry."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Source" ;
    cmm:validValues "scada|state_estimator|contingency_analysis|agc|protection_system|operator_entry" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.alarmState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm state"@en ;
    rdfs:comment "Current lifecycle state of the alarm. Active indicates the condition persists and has not been acknowledged. Acknowledged means an operator has reviewed it. Cleared indicates the condition has resolved. Suppressed and shelved indicate operator-managed alarm filtering."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Alarm State" ;
    cmm:validValues "active|acknowledged|cleared|suppressed|shelved" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:EmsAlarm.alarmTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm timestamp"@en ;
    rdfs:comment "The precise date and time when the alarm condition was detected and generated by the SCADA/EMS system. This is the principal business event timestamp for the alarm."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "alarm_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsAlarm.alarmType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm type"@en ;
    rdfs:comment "Classification of the alarm based on the nature of the abnormal condition detected. Includes limit violations, equipment status changes, communication failures, protection relay operations, state estimation failures, and topology changes."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Alarm Type" ;
    cmm:validValues "limit_violation|equipment_status_change|communication_failure|protection_relay_operation|state_estimation_failure|topology_change" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:EmsAlarm.balancingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority"@en ;
    rdfs:comment "Name or code of the balancing authority responsible for the area where the alarm occurred. Used for coordination and regulatory reporting."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.clearanceTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearance timestamp"@en ;
    rdfs:comment "Date and time when the alarm condition was resolved and the alarm was cleared. Null if the alarm is still active. Used to calculate alarm duration and system performance metrics."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "clearance_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearance Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsAlarm.contingencyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency flag"@en ;
    rdfs:comment "Indicates whether the alarm is related to a contingency analysis violation or post-contingency condition. True if the alarm resulted from contingency analysis."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsAlarm.correctiveAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action"@en ;
    rdfs:comment "Description of the corrective action taken to resolve the alarm condition. Used for operational documentation and continuous improvement."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this alarm record was first inserted into the data system. Used for data lineage and audit trail purposes."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:EmsAlarm.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name or identifier of the source system that provided this alarm record, such as the specific EMS vendor system or SCADA master. Supports multi-system data integration and lineage tracking."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.disturbanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance flag"@en ;
    rdfs:comment "Indicates whether the alarm is associated with a system disturbance event requiring NERC reporting. True if the alarm is part of a reportable disturbance."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disturbance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disturbance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsAlarm.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name or identifier of the EMS system that generated the alarm. Supports multi-EMS environments and system-specific alarm analysis."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.engineeringUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engineering unit"@en ;
    rdfs:comment "Unit of measure for the limit value and measured value, such as MW, MVAR, kV, Amps, Hz, or degrees. Essential for interpreting alarm magnitude."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "engineering_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Engineering Unit" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.equipmentName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment name"@en ;
    rdfs:comment "Human-readable name or designation of the specific equipment associated with the alarm, as known to operators and maintenance personnel."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Name" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.equipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type"@en ;
    rdfs:comment "Type of equipment associated with the alarm condition, such as transformer, breaker, line, generator, capacitor bank, or relay. Supports equipment-specific alarm analysis."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Type" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this alarm record was last modified. Tracks changes to alarm state, acknowledgment, clearance, or operator notes."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmsAlarm.limitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limit type"@en ;
    rdfs:comment "For limit violation alarms, specifies the type of limit that was exceeded: high, low, high-high (critical high), low-low (critical low), rate of change, or deadband violation."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "limit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limit Type" ;
    cmm:validValues "high|low|high_high|low_low|rate_of_change|deadband" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.limitValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limit value"@en ;
    rdfs:comment "The threshold value that was exceeded to trigger the alarm. Provides context for the severity of the limit violation."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "limit_value" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limit Value" ;
    cmm:cimDatatype "Decimal" .
cmm:EmsAlarm.measuredValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measured value"@en ;
    rdfs:comment "The actual measured value at the time the alarm was triggered. Allows operators to assess the magnitude of the deviation from normal or limit conditions."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "measured_value" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measured Value" ;
    cmm:cimDatatype "Decimal" .
cmm:EmsAlarm.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity code (e.g., WECC, ERCOT, NPCC, SERC, MRO, RFC, SPP, TRE) for the geographic region where the alarm originated. Required for NERC compliance reporting."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether the alarm condition meets NERC criteria for mandatory event reporting under EOP-004 or other reliability standards. True if reportable to NERC."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsAlarm.operatorNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator notes"@en ;
    rdfs:comment "Free-text notes entered by operators regarding the alarm, including actions taken, root cause observations, or coordination with other entities. Supports knowledge capture and post-event review."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operator Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EmsAlarm.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name associated with the alarm, enabling integration with PI data for post-event analysis and trending."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Severity classification of the alarm indicating the urgency of operator response required. Critical alarms require immediate action, major alarms require prompt attention, minor alarms are monitored, and informational alarms are logged for awareness."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:validValues "critical|major|minor|informational" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:EmsAlarm.relatedAlarmCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "related alarm count"@en ;
    rdfs:comment "Number of related or cascading alarms that occurred within a defined time window of this alarm. Helps identify alarm floods and system-wide events."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:int ;
    cmm:physicalColumn "related_alarm_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Related Alarm Count" ;
    cmm:cimDatatype "Integer" .
cmm:EmsAlarm.responseTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response time seconds"@en ;
    rdfs:comment "Time in seconds from alarm generation to operator acknowledgment. Key performance indicator for alarm management and operator situational awareness."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:int ;
    cmm:physicalColumn "response_time_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Time (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:EmsAlarm.rootCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause code"@en ;
    rdfs:comment "Standardized code identifying the root cause of the alarm condition, assigned during post-event analysis. Supports trending and reliability improvement initiatives."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "root_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Code" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.rtuReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rtu reference"@en ;
    rdfs:comment "Reference to the RTU that reported the alarm condition, if applicable. Links alarm to field communication infrastructure."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:long ;
    cmm:physicalColumn "rtu_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Terminal Unit (RTU) Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EmsAlarm.suppressionRule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "suppression rule"@en ;
    rdfs:comment "Name or identifier of the alarm suppression rule applied to this alarm, if any. Supports intelligent alarm management and reduction of alarm floods."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:string ;
    cmm:physicalColumn "suppression_rule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Suppression Rule" ;
    cmm:cimDatatype "String" .
cmm:EmsAlarm.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts of the equipment or node associated with the alarm. Critical for prioritizing alarms based on system criticality."@en ;
    rdfs:domain cmm:EmsAlarm ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:GridReliabilityEvent a owl:Class ;
    rdfs:label "Grid Reliability Event"@en ;
    rdfs:comment "Transactional record of reportable reliability events as defined by NERC reliability standards (EOP, TOP, BAL), including frequency excursion events. General event attributes include event date/time, event type (disturbance, emergency, unusual occurrence, frequency excursion), NERC standard applicability, affected facilities, initiating cause, MW impact, duration, corrective actions taken, NERC OE-417 report reference, and regulatory submission status. Frequency excursion attributes (event_type=frequency_excursion) include nadir frequency (Hz), recovery frequency (Hz), ROCOF (Hz/s), excursion duration (seconds), triggering cause (generation trip, load loss, islanding), UFLS activation flag, MW of load shed, and restoration timestamp. SSOT for all NERC reliability event reporting including NERC BAL-003 frequency response obligation — distinct from outage records (owned by outage domain) which focus on customer impact."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.grid_reliability_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC EOP-004; NERC EOP-004 / DOE OE-417 Disturbance Report" ;
    cmm:sourceObject "energy_utilities_ecm.grid.grid_reliability_event" ;
    owl:hasKey ( cmm:GridReliabilityEvent.gridReliabilityEventId ) .

cmm:GridReliabilityEvent.gridReliabilityEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event id"@en ;
    rdfs:comment "Unique identifier for the grid reliability event record. Primary key for the grid reliability event entity."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Grid Reliability Event Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:GridReliabilityEvent.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: NERC and regional entities audit reliability events (especially EOP-004 reportable events) to verify utility response and compliance. This link tracks which events were examined during compliance audi"@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_audit_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:GridReliabilityEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the control area or balancing authority where the reliability event occurred."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_control_area_id" ;
    cmm:cimAssociation "PSREvent.ControlArea" .
cmm:GridReliabilityEvent.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: NERC-reportable reliability events (OE-417 reports) trigger emergency procurement and mutual aid material requests. Essential for tracking restoration material costs, FEMA reimbursement documentation,"@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_emergency_stock_event_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:GridReliabilityEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Grid reliability events (NERC reportable) often involve customer outages. Linking enables consolidated DOE OE-417 reporting, reliability metrics calculation, and regulatory compliance documentation."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:GridReliabilityEvent.operatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operator employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: NERC reliability events (OE-417 reports) require documented operator accountability. 'operator_on_duty' text field should be FK to employee for regulatory audit trails and operator performance analysi"@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "operator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_operator_employee_id" ;
    cmm:cimAssociation "PSREvent.ErpPersonnel" .
cmm:GridReliabilityEvent.safetyIncident a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident"@en ;
    rdfs:comment "Foreign key linking to workforce.safety_incident. Business justification: NERC reliability events can involve personnel safety incidents. Linking enables correlation of NERC OE-417 reports with OSHA recordables for comprehensive event investigation and regulatory reporting."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range cmm:SafetyIncident ;
    cmm:physicalColumn "safety_incident_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Safety Incident Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_reliability_event_safety_incident_id" ;
    cmm:cimAssociation "PSREvent.Incident" .
cmm:GridReliabilityEvent.affectedFacilities a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected facilities"@en ;
    rdfs:comment "Comma-separated list or free-text description of generation plants, substations, transmission lines, and other facilities impacted by the reliability event."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_facilities" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Facilities" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.correctiveActionsTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective actions taken"@en ;
    rdfs:comment "Detailed description of immediate corrective actions and operator interventions taken to mitigate and resolve the reliability event. Includes switching orders, generation redispatch, and emergency procedures."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_actions_taken" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Actions Taken" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this reliability event record was first created in the system, in UTC. Audit field for data lineage and record lifecycle tracking."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PSREvent.createdDateTime .
cmm:GridReliabilityEvent.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customer accounts impacted by the reliability event, if the event resulted in customer outages. Used for regulatory reporting and impact assessment."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:GridReliabilityEvent.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or application that created or last updated this reliability event record. Used for data lineage and integration troubleshooting."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name of the EMS system that detected and recorded the reliability event. Used for data lineage and system integration."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.eventDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event duration minutes"@en ;
    rdfs:comment "Total duration of the reliability event from start to resolution, measured in minutes. Calculated from event start and end timestamps."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "event_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:GridReliabilityEvent.eventEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event end timestamp"@en ;
    rdfs:comment "Date and time when the reliability event was resolved or system returned to normal operating conditions, in UTC. Null if event is still ongoing."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridReliabilityEvent.eventStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event start timestamp"@en ;
    rdfs:comment "Date and time when the reliability event was first detected or initiated, in UTC. This is the principal business event timestamp for the reliability event."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridReliabilityEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the reliability event in the investigation and resolution workflow."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Status" ;
    cmm:validValues "open|under_investigation|corrective_action_pending|resolved|closed|reported_to_nerc" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.status .
cmm:GridReliabilityEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the reliability event according to NERC reporting categories. Determines which NERC standards and reporting requirements apply. Reference-value candidates: disturbance|emergency|unusual_occurrence|frequency_excursion|voltage_excursion|load_shed|generation_loss|transmission_loss|islanding."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.type .
cmm:GridReliabilityEvent.frequencyExcursionDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency excursion duration seconds"@en ;
    rdfs:comment "Duration of the frequency excursion from initial deviation to recovery within acceptable limits, measured in seconds. Used for NERC BAL-003 compliance assessment."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_excursion_duration_seconds" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Excursion Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:GridReliabilityEvent.frequencyExcursionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency excursion flag"@en ;
    rdfs:comment "Indicates whether this event involved a system frequency excursion outside normal operating limits. True if frequency deviated beyond acceptable thresholds per NERC BAL-003."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "frequency_excursion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Excursion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridReliabilityEvent.frequencyExcursionTrigger a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency excursion trigger"@en ;
    rdfs:comment "Specific triggering cause of the frequency excursion event. Categorizes the type of disturbance that caused frequency deviation."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "frequency_excursion_trigger" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Excursion Trigger" ;
    cmm:validValues "generation_trip|load_loss|islanding|tie_line_trip|other" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.initiatingCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating cause"@en ;
    rdfs:comment "Root cause or triggering event that initiated the reliability event. Free-text description of the primary causal factor (e.g., generator trip, transmission line fault, equipment failure, weather event)."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initiating Cause" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.initiatingCauseCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating cause category"@en ;
    rdfs:comment "Standardized classification of the root cause category for analytics and trend analysis. Aligns with NERC cause code taxonomy. Reference-value candidates: equipment_failure|weather|human_error|cyber_security|physical_security|fuel_supply|load_forecast_error|unknown|other."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initiating Cause Category" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "North American interconnection in which the reliability event occurred. Determines applicable reliability standards and coordination requirements."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Name" ;
    cmm:validValues "eastern|western|texas|quebec" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.investigationCompleteFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation complete flag"@en ;
    rdfs:comment "Indicates whether the root cause investigation and analysis of the reliability event has been completed. True when final investigation report is approved."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "investigation_complete_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigation Complete Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridReliabilityEvent.investigationReportUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation report url"@en ;
    rdfs:comment "URL or file path to the detailed investigation report document for this reliability event. Used for audit trail and knowledge repository access."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "investigation_report_url" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigation Report Uniform Resource Locator (URL)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this reliability event record was most recently modified, in UTC. Audit field for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GridReliabilityEvent.lessonsLearned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lessons learned"@en ;
    rdfs:comment "Summary of key lessons learned from the reliability event investigation. Used for knowledge management and continuous improvement of grid operations."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "lessons_learned" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lessons Learned" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.mwImpact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mw impact"@en ;
    rdfs:comment "Total megawatt impact of the reliability event, representing generation loss, load shed, or transmission capacity reduction. Positive value indicates magnitude of impact."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mw_impact" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megawatt (MW) Impact" ;
    cmm:cimDatatype "Decimal" .
cmm:GridReliabilityEvent.nadirFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nadir frequency hz"@en ;
    rdfs:comment "Lowest system frequency reached during a frequency excursion event, measured in Hertz. Applicable only when event_type is frequency_excursion. Critical metric for NERC BAL-003 frequency response obligation."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nadir_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nadir Frequency (Hertz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:GridReliabilityEvent.nercOe417ReportNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc oe417 report number"@en ;
    rdfs:comment "Reference number for the DOE OE-417 Electric Emergency Incident and Disturbance Report filed for this event, if applicable. Used to track regulatory submission."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_oe417_report_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "NERC OE-417 Report Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GridReliabilityEvent.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity with jurisdiction over the control area where the event occurred. Determines regional compliance and reporting requirements. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|TRE|SPP."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this event meets NERC criteria for mandatory reporting to regulatory authorities. True if event must be reported per NERC EOP-004."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridReliabilityEvent.nercStandardApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc standard applicability"@en ;
    rdfs:comment "Comma-separated list of applicable NERC reliability standards triggered by this event (e.g., EOP-004, BAL-003, TOP-001). Determines regulatory reporting obligations."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_standard_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Standard Applicability" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.nercSubmissionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc submission status"@en ;
    rdfs:comment "Status of regulatory report submission to NERC and other governing bodies. Tracks compliance with mandatory reporting timelines."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_submission_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Submission Status" ;
    cmm:validValues "not_required|pending|submitted|acknowledged|under_review|closed" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.nercSubmissionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc submission timestamp"@en ;
    rdfs:comment "Date and time when the event report was submitted to NERC or other regulatory authorities, in UTC. Used to verify compliance with reporting deadlines."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "nerc_submission_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Submission Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridReliabilityEvent.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional free-form notes and comments about the reliability event. Used for supplementary information not captured in structured fields."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:GridReliabilityEvent.piHistorianTagPrefix a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag prefix"@en ;
    rdfs:comment "Tag prefix in the OSIsoft PI historian system for retrieving detailed telemetry data associated with this reliability event. Enables post-event analysis and forensics."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag_prefix" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Prefix" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.preventiveActionsRecommended a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preventive actions recommended"@en ;
    rdfs:comment "Recommended preventive measures and long-term corrective actions to prevent recurrence of similar reliability events. Used for continuous improvement and reliability planning."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "preventive_actions_recommended" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preventive Actions Recommended" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.recoveryFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recovery frequency hz"@en ;
    rdfs:comment "System frequency after initial recovery and stabilization following a frequency excursion, measured in Hertz. Used to assess frequency response adequacy."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recovery_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recovery Frequency (Hertz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:GridReliabilityEvent.restorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration timestamp"@en ;
    rdfs:comment "Date and time when all affected facilities and customer load were fully restored to normal service following the reliability event, in UTC."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridReliabilityEvent.rocofHzPerSecond a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rocof hz per second"@en ;
    rdfs:comment "Maximum rate of change of frequency during the excursion event, measured in Hertz per second. Critical parameter for assessing system inertia and frequency response performance."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rocof_hz_per_second" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate of Change of Frequency (ROCOF) in Hertz per Second" ;
    cmm:cimDatatype "Decimal" .
cmm:GridReliabilityEvent.rtoIsoName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso name"@en ;
    rdfs:comment "Name of the RTO or ISO responsible for grid operations in the affected area, if applicable. Used for coordination and reporting."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Name" ;
    cmm:cimDatatype "String" .
cmm:GridReliabilityEvent.scadaSnapshotTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada snapshot timestamp"@en ;
    rdfs:comment "Timestamp of the SCADA system snapshot captured at the time of event detection, in UTC. Used to correlate event data with real-time telemetry."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scada_snapshot_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Snapshot Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GridReliabilityEvent.severityIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "severity index"@en ;
    rdfs:comment "Calculated severity score for the reliability event based on MW impact, duration, frequency deviation, and customer impact. Used for prioritization and trend analysis."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "severity_index" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Severity Index" ;
    cmm:cimDatatype "Decimal" .
cmm:GridReliabilityEvent.uflsActivationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ufls activation flag"@en ;
    rdfs:comment "Indicates whether automatic under-frequency load shedding relays were activated during the event. True if UFLS protection operated to arrest frequency decline."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ufls_activation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Under Frequency Load Shedding (UFLS) Activation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridReliabilityEvent.uflsLoadShedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ufls load shed mw"@en ;
    rdfs:comment "Total amount of load automatically shed by UFLS relays during the frequency excursion, measured in megawatts. Null if UFLS was not activated."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ufls_load_shed_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Under Frequency Load Shedding (UFLS) Load Shed (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GridReliabilityEvent.weatherConditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather conditions"@en ;
    rdfs:comment "Description of weather conditions at the time of the reliability event, if weather was a contributing factor. Includes temperature, wind, precipitation, and severe weather events."@en ;
    rdfs:domain cmm:GridReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_conditions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Conditions" ;
    cmm:cimDatatype "String" .

cmm:OperatingLimit a owl:Class ;
    rdfs:label "Operating Limit"@en ;
    rdfs:comment "Master and transactional record defining all operating limits for transmission elements and interfaces — static seasonal ratings, ambient-adjusted ratings (AAR), and dynamic line ratings (DLR) — within the EMS network model. Static/seasonal attributes include element reference (line, transformer, interface), limit type (normal/emergency MVA, voltage upper/lower kV, stability MW), applicable season, ambient temperature condition, and NERC FAC-002 study reference. Dynamic real-time rating attributes (grain: one row per element per rating timestamp) include ambient-adjusted or dynamic normal and emergency MVA, ambient temperature (°F), wind speed (mph), solar irradiance (W/m²), conductor temperature (°C), rating method (static/ambient-adjusted/dynamic), and validity window. SSOT for all operating limits and real-time ratings used by EMS contingency analysis, operator displays, NERC FAC-001/FAC-008 compliance, and transmission capacity optimization."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:OperationalLimit ;
    cmm:cimExactMatch cim:OperationalLimit ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::OperationalLimits" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.operating_limit" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC FAC-008; NERC FAC-001 / FAC-002 Operating Limit" ;
    cmm:sourceObject "energy_utilities_ecm.grid.operating_limit" ;
    owl:hasKey ( cmm:OperatingLimit.operatingLimitId ) .

cmm:OperatingLimit.operatingLimitId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating limit id"@en ;
    rdfs:comment "Unique identifier for the operating limit record. Primary key for the operating limit entity."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:long ;
    cmm:physicalColumn "operating_limit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Operating Limit Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:OperatingLimit.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Identifier of the balancing authority responsible for monitoring and enforcing this operating limit. Links to the control area entity for jurisdictional and operational responsibility."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operating_limit_control_area_id" ;
    cmm:cimAssociation "OperationalLimit.ControlArea" .
cmm:OperatingLimit.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — Operating limits (thermal, voltage, stability) are defined for specific transmission elements and interfaces in the EMS network model, referenced by EMS node or branch. Required for contingency analys"@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operating_limit_ems_node_id" ;
    cmm:cimAssociation "OperationalLimit.TopologicalNode" .
cmm:OperatingLimit.operatingEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operating ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — Operating limits (now including real-time ratings) are defined for transmission elements referenced in the EMS network model. FK to ems_node anchors limits to the network topology."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "operating_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operating_limit_operating_ems_node_id" ;
    cmm:cimAssociation "OperationalLimit.TopologicalNode" .
cmm:OperatingLimit.operatingLimitForEmsElement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operating_limit_for_ems_element"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — Operating limits and real-time ratings apply to specific transmission elements referenced by EMS nodes/branches. Required for contingency analysis limit checking and operator displays."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "operating_limit_for_ems_element" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_operating_limit_operating_limit_for_ems_element" ;
    cmm:cimAssociation "OperationalLimit.TopologicalNode" .
cmm:OperatingLimit.ambientTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature f"@en ;
    rdfs:comment "Ambient air temperature in degrees Fahrenheit used for ambient-adjusted or dynamic rating calculations. Real-time weather data input for AAR and DLR methodologies."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_f" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature Fahrenheit (°F)" ;
    cmm:cimDatatype "Decimal" .
cmm:OperatingLimit.conductorTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "conductor temperature c"@en ;
    rdfs:comment "Actual or calculated conductor temperature in degrees Celsius. For dynamic line ratings, this may be measured directly via fiber optic sensors or calculated from current flow and weather conditions. Maximum allowable conductor temperature determines thermal rating."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "conductor_temperature_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conductor Temperature Celsius (°C)" ;
    cmm:cimDatatype "Decimal" .
cmm:OperatingLimit.contingencyAnalysisFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis flag"@en ;
    rdfs:comment "Boolean flag indicating whether this operating limit is monitored and enforced during EMS contingency analysis (N-1, N-2 studies). True means the limit is included in contingency screening and violation detection."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OperatingLimit.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this operating limit record was first created in the system. Audit trail for data lineage and regulatory compliance."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:OperationalLimit.createdDateTime .
cmm:OperatingLimit.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that provided this operating limit data (e.g., EMS, DLR system, engineering study database). Used for data lineage, reconciliation, and troubleshooting."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.elementName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element name"@en ;
    rdfs:comment "Human-readable name of the transmission element (e.g., line name, transformer designation, interface name) for operator displays and reporting."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Name" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.elementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element reference"@en ;
    rdfs:comment "Unique identifier for the transmission element (line, transformer, interface) to which this operating limit applies. References the network model element in the EMS system."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.elementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element type"@en ;
    rdfs:comment "Classification of the transmission element type to which the operating limit applies. Determines the applicable limit categories and rating methodologies."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Type" ;
    cmm:validValues "transmission_line|transformer|interface|generator|tie_line|bus" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.emergencyRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency rating mva"@en ;
    rdfs:comment "Emergency operating limit in MVA for the transmission element under post-contingency conditions. This higher rating is allowed for a limited duration (typically 15 minutes to 4 hours) following a system disturbance."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emergency_rating_mva" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Rating Megavolt-Ampere (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:OperatingLimit.emsModelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems model version"@en ;
    rdfs:comment "Version identifier of the EMS network model in which this operating limit is defined. Critical for change management, model synchronization, and audit trails."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Model Version" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name of the EMS system (e.g., GE ADMS, Siemens Spectrum, ABB Network Manager) that manages and enforces this operating limit. Used for multi-EMS environments and data lineage tracking."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.fromBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "from bus name"@en ;
    rdfs:comment "Name of the originating bus or substation for transmission line or transformer elements. Defines the topology and network connectivity for EMS modeling."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "from_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "From Bus Name" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this operating limit record was last modified. Tracks changes to ratings, limits, or metadata for change management and audit purposes."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:OperatingLimit.limitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limit type"@en ;
    rdfs:comment "Category of operating limit being defined: normal MVA rating, emergency MVA rating, voltage upper limit, voltage lower limit, stability limit in MW, or thermal limit in MW. Determines the constraint type enforced by EMS contingency analysis."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "limit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operating Limit Type" ;
    cmm:validValues "normal_mva|emergency_mva|voltage_upper_kv|voltage_lower_kv|stability_mw|thermal_mw" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:OperationalLimit.kind .
cmm:OperatingLimit.maxConductorTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max conductor temperature c"@en ;
    rdfs:comment "Maximum allowable conductor temperature in degrees Celsius before thermal damage, excessive sag, or loss of tensile strength occurs. Typically 75-100°C for ACSR conductors. Defines the thermal constraint for rating calculations."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "max_conductor_temperature_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Conductor Temperature Celsius (°C)" ;
    cmm:cimDatatype "Decimal" .
cmm:OperatingLimit.nercFac002StudyReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc fac 002 study reference"@en ;
    rdfs:comment "Reference identifier for the NERC FAC-002 facility interconnection study or FAC-008 facility ratings methodology study that established this operating limit. Provides traceability to engineering analysis and regulatory compliance documentation."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_fac_002_study_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Facility Interconnection Requirements Study (FAC-002) Study Reference" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity responsible for reliability oversight of this transmission element: WECC (Western), ERCOT (Texas), MRO (Midwest), NPCC (Northeast), RF (ReliabilityFirst), SERC (Southeast), SPP (Southwest), or TRE (Texas RE). Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|SPP|TRE."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.normalRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal rating mva"@en ;
    rdfs:comment "Normal continuous operating limit in MVA for the transmission element under normal system conditions. This is the baseline capacity used for day-to-day operations and pre-contingency analysis."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normal_rating_mva" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Rating Megavolt-Ampere (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:OperatingLimit.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes providing additional context, special operating instructions, temporary limit adjustments, or engineering rationale for this operating limit. Used by operators and engineers for situational awareness."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operating Limit Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:OperatingLimit.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational status of the transmission element and its associated operating limits. In-service limits are actively enforced by EMS; out-of-service limits are inactive due to equipment outages."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|testing|maintenance|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:OperationalLimit.status .
cmm:OperatingLimit.operatorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator code"@en ;
    rdfs:comment "Code identifying the transmission operator responsible for real-time operation and monitoring of this element and its limits. May differ from owner in joint-use or RTO-operated facilities."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Operator Code" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.operatorDisplayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator display flag"@en ;
    rdfs:comment "Boolean flag indicating whether this operating limit is displayed on EMS operator screens and alarm systems. True means operators receive real-time visibility and alarms for limit violations."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_display_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Display Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:OperatingLimit.ownerCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner code"@en ;
    rdfs:comment "Code identifying the transmission asset owner responsible for the physical equipment and its ratings. Used for cost allocation, maintenance responsibility, and regulatory reporting."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Owner Code" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name for archiving this operating limit time-series data. Enables historical trending, post-event analysis, and integration with asset performance analytics."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Process Information (PI) Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.ratingMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating method"@en ;
    rdfs:comment "Method used to determine the operating limit: static (fixed rating), seasonal (varies by season), ambient-adjusted (AAR based on weather), or dynamic (DLR with real-time conductor monitoring). Indicates the sophistication and real-time responsiveness of the rating."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "rating_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Method" ;
    cmm:validValues "static|seasonal|ambient_adjusted|dynamic" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.ratingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating timestamp"@en ;
    rdfs:comment "Timestamp when this operating limit or dynamic rating was calculated or became effective. For dynamic ratings, this represents the real-time calculation timestamp. Critical for time-series analysis and operational decision-making."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rating_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatingLimit.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "Code identifying the RTO or ISO market region in which this transmission element operates. Relevant for market-based congestion management and transmission capacity allocation."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.season a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "season"@en ;
    rdfs:comment "Season for which this operating limit is applicable. Seasonal ratings account for ambient temperature variations that affect conductor thermal capacity. Year-round indicates a single rating applies across all seasons."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "season" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Season" ;
    cmm:validValues "summer|winter|spring|fall|year_round" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.solarIrradianceWPerM2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solar irradiance w per m2"@en ;
    rdfs:comment "Solar irradiance in watts per square meter incident on the conductor. Affects conductor heating and is a key input for dynamic line rating calculations, particularly during high solar exposure periods."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "solar_irradiance_w_per_m2" ;
    cmm:sqlDataType "DECIMAL(7,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solar Irradiance Watts Per Square Meter (W/m²)" ;
    cmm:cimDatatype "Decimal" .
cmm:OperatingLimit.stabilityLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stability limit mw"@en ;
    rdfs:comment "Maximum power transfer in MW constrained by system stability considerations (transient stability, voltage stability, or oscillatory stability). Derived from stability studies and enforced to prevent system instability following disturbances."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "stability_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stability Limit Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OperatingLimit.studyDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study date"@en ;
    rdfs:comment "Date when the engineering study establishing this operating limit was completed. Used for tracking study vintage and determining when re-studies are required per NERC standards."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Date" ;
    cmm:cimDatatype "Date" .
cmm:OperatingLimit.toBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to bus name"@en ;
    rdfs:comment "Name of the terminating bus or substation for transmission line or transformer elements. Defines the topology and network connectivity for EMS modeling."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:string ;
    cmm:physicalColumn "to_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "To Bus Name" ;
    cmm:cimDatatype "String" .
cmm:OperatingLimit.validityEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validity end timestamp"@en ;
    rdfs:comment "Timestamp when this operating limit expires or is superseded by a new rating. For dynamic ratings, defines the end of the rating validity window. Null indicates an open-ended validity period."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "validity_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validity End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatingLimit.validityStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validity start timestamp"@en ;
    rdfs:comment "Timestamp when this operating limit becomes valid and enforceable in EMS operations. For dynamic ratings, defines the beginning of the rating validity window."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "validity_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validity Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:OperatingLimit.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kV of the transmission element (e.g., 69 kV, 138 kV, 230 kV, 345 kV, 500 kV). Used for classification, reporting, and determining applicable standards."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level Kilovolt (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OperatingLimit.voltageLowerLimitKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage lower limit kv"@en ;
    rdfs:comment "Minimum allowable voltage in kV for the transmission element or bus. Falling below this limit may cause voltage collapse, equipment malfunction, or customer service quality issues. Used by EMS voltage control and contingency analysis."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_lower_limit_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Lower Limit Kilovolt (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OperatingLimit.voltageUpperLimitKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage upper limit kv"@en ;
    rdfs:comment "Maximum allowable voltage in kV for the transmission element or bus. Exceeding this limit may cause equipment damage or insulation breakdown. Used by EMS voltage control and contingency analysis."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_upper_limit_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Upper Limit Kilovolt (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:OperatingLimit.windSpeedMph a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind speed mph"@en ;
    rdfs:comment "Wind speed in miles per hour at the transmission element location. Critical input for dynamic line rating calculations as wind cooling significantly increases conductor thermal capacity."@en ;
    rdfs:domain cmm:OperatingLimit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wind_speed_mph" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Speed Miles Per Hour (mph)" ;
    cmm:unitSymbol "mph" ;
    cmm:cimDatatype "Speed" .

cmm:RealTimeRating a owl:Class ;
    rdfs:label "Real Time Rating"@en ;
    rdfs:comment "Transactional record of dynamic or ambient-adjusted real-time thermal ratings (AAR/DLR) for transmission lines and transformers, replacing static seasonal ratings in the EMS. Captures element reference, rating timestamp, real-time normal rating (MVA), real-time emergency rating (MVA), ambient temperature (°F), wind speed (mph), solar irradiance (W/m²), conductor temperature (°C), rating method (static/ambient-adjusted/dynamic), and validity window. Supports NERC FAC-001 compliance and transmission capacity optimization."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:OperationalUpdatedRating ;
    cmm:cimCloseMatch cim:OperationalUpdatedRating ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.asset_control ;
    cmm:physicalTable "utility_cmm_silver.grid.real_time_rating" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC Order 881 (AAR); NERC FAC-001 AAR/DLR Dynamic Line Rating" ;
    cmm:sourceObject "energy_utilities_ecm.grid.real_time_rating" ;
    owl:hasKey ( cmm:RealTimeRating.realTimeRatingId ) .

cmm:RealTimeRating.realTimeRatingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "real time rating id"@en ;
    rdfs:comment "Unique identifier for each real-time rating record. Primary key for the real_time_rating product."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:long ;
    cmm:physicalColumn "real_time_rating_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Real-Time Rating Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:RealTimeRating.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Identifier of the balancing authority responsible for this transmission element. Links rating to operational control area."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_real_time_rating_control_area_id" ;
    cmm:cimAssociation "OperationalUpdatedRating.ControlArea" .
cmm:RealTimeRating.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the substation where this transmission element originates or terminates. Links rating to physical grid location."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_real_time_rating_distribution_substation_id" ;
    cmm:cimAssociation "OperationalUpdatedRating.Substation" .
cmm:RealTimeRating.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User identifier of the system operator who reviewed or overrode this rating. Supports accountability and audit requirements."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_real_time_rating_employee_id" ;
    cmm:cimAssociation "OperationalUpdatedRating.ErpPersonnel" .
cmm:RealTimeRating.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Dynamic line ratings are calculated for specific transmission line and transformer assets. Asset management uses these ratings for thermal aging models, risk-based replacement prioritization, and capi"@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_real_time_rating_registry_id" ;
    cmm:cimAssociation "OperationalUpdatedRating.Asset" .
cmm:RealTimeRating.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Identifier of the SCADA measurement point providing real-time loading or temperature data for this element."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_real_time_rating_scada_point_id" ;
    cmm:cimAssociation "OperationalUpdatedRating.Measurement" .
cmm:RealTimeRating.ambientTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature f"@en ;
    rdfs:comment "Measured or forecasted ambient air temperature in degrees Fahrenheit at the element location. Primary environmental input for thermal rating calculations."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_f" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Air Temperature (Fahrenheit - °F)" ;
    cmm:cimDatatype "Decimal" .
cmm:RealTimeRating.circuitReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "circuit reference"@en ;
    rdfs:comment "Circuit identifier distinguishing parallel transmission paths between the same bus pair. Used in switching orders and outage coordination."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "circuit_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Circuit Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.conductorTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "conductor temperature c"@en ;
    rdfs:comment "Measured or calculated conductor surface temperature in degrees Celsius. Must not exceed maximum design temperature to prevent annealing and sag violations."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "conductor_temperature_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conductor Temperature (Celsius - °C)" ;
    cmm:cimDatatype "Decimal" .
cmm:RealTimeRating.contingencyAnalysisFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis flag"@en ;
    rdfs:comment "Indicates whether this rating is actively used in real-time contingency analysis. True for critical elements monitored for N-1 and N-2 contingencies."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RealTimeRating.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this rating record was first inserted into the data platform. Supports data lineage and audit trail requirements."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:OperationalUpdatedRating.createdDateTime .
cmm:RealTimeRating.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or application that generated this rating record (e.g., DLR system, EMS rating module, weather integration service)."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.elementName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element name"@en ;
    rdfs:comment "Human-readable name or designation of the transmission element as known in operational systems and switching orders."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Name" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.elementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element reference"@en ;
    rdfs:comment "Unique identifier of the transmission element (line, transformer, cable) being rated. References the asset or network element in the EMS model."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.elementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element type"@en ;
    rdfs:comment "Type of transmission equipment being rated. Determines applicable rating methodology and thermal limits."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Element Type" ;
    cmm:validValues "transmission_line|transformer|cable|series_capacitor|phase_shifting_transformer" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.emergencyRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency rating mva"@en ;
    rdfs:comment "Real-time emergency thermal rating in megavolt-amperes. Maximum load the element can carry for a limited duration (typically 15 minutes to 4 hours) during contingency conditions."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emergency_rating_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Operating Rating (Megavolt-Ampere - MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:RealTimeRating.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name of the EMS or SCADA system that received and is using this real-time rating for state estimation and contingency analysis."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.fromBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "from bus name"@en ;
    rdfs:comment "Name of the originating bus or node in the EMS network model. Defines one end of a transmission line or branch element."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "from_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "From Bus Name" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this rating record was last modified. Tracks changes to ratings due to recalculation or operator override."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RealTimeRating.loadShedRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load shed rating mva"@en ;
    rdfs:comment "Short-term emergency rating used during system restoration or load shedding events. Highest permissible loading for very brief durations to prevent cascading outages."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_shed_rating_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Shed Rating (Megavolt-Ampere - MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:RealTimeRating.maxConductorTemperatureC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max conductor temperature c"@en ;
    rdfs:comment "Maximum allowable conductor temperature in degrees Celsius per design specifications. Exceeding this limit risks permanent conductor damage and clearance violations."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "max_conductor_temperature_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Conductor Temperature Limit (Celsius - °C)" ;
    cmm:cimDatatype "Decimal" .
cmm:RealTimeRating.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity with jurisdiction over this transmission element. Determines applicable reliability standards and reporting requirements. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|TRE|SPP."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.normalRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal rating mva"@en ;
    rdfs:comment "Real-time normal (continuous) thermal rating in megavolt-amperes. Maximum load the element can carry indefinitely under current ambient conditions without exceeding design limits."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normal_rating_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Operating Rating (Megavolt-Ampere - MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:RealTimeRating.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional context, special conditions, or operational notes related to this rating. Used for documentation and knowledge transfer."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rating Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:RealTimeRating.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational status of the transmission element. Out-of-service elements do not require active rating updates."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|testing|maintenance|forced_outage" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:OperationalUpdatedRating.status .
cmm:RealTimeRating.operatorOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override flag"@en ;
    rdfs:comment "Indicates whether a system operator manually overrode the calculated rating. True when operator judgment supersedes automated calculation."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RealTimeRating.operatorOverrideReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override reason"@en ;
    rdfs:comment "Free-text explanation provided by the operator for manually overriding the calculated rating. Required for audit trail and compliance documentation."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_override_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Reason" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "PI historian tag name where this rating value is archived for historical analysis, trending, and post-event review."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.ratingCalculationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating calculation timestamp"@en ;
    rdfs:comment "Timestamp when the rating calculation algorithm executed. May differ from rating_timestamp if calculation is performed ahead of validity period."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rating_calculation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Calculation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RealTimeRating.ratingConfidenceLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating confidence level"@en ;
    rdfs:comment "Overall confidence in the calculated rating based on data quality, sensor availability, and model accuracy. Low confidence may trigger operator alerts."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "rating_confidence_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Confidence Level" ;
    cmm:validValues "high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.ratingMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating method"@en ;
    rdfs:comment "Methodology used to calculate the real-time rating. Static uses fixed seasonal values; ambient-adjusted incorporates weather; dynamic line rating (DLR) uses real-time sensor data."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "rating_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Calculation Method" ;
    cmm:validValues "static|seasonal|ambient_adjusted|dynamic_line_rating|real_time_monitoring" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.ratingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating timestamp"@en ;
    rdfs:comment "Date and time when this real-time rating was calculated and became effective. Represents the moment the rating applies to grid operations."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rating_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RealTimeRating.ratingValidityEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating validity end timestamp"@en ;
    rdfs:comment "Timestamp when this rating expires and must be replaced by a new rating calculation. Ensures stale ratings are not used in operations."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rating_validity_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Validity End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RealTimeRating.ratingValidityStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating validity start timestamp"@en ;
    rdfs:comment "Timestamp when this rating becomes valid and can be used by EMS for operational decisions and contingency analysis."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "rating_validity_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Validity Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RealTimeRating.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "Code identifying the RTO or ISO market operator if this element participates in organized wholesale markets."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.sagClearanceFt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sag clearance ft"@en ;
    rdfs:comment "Calculated vertical clearance in feet between conductor at current temperature and ground or obstacles. Must maintain minimum clearances per NESC standards."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "sag_clearance_ft" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conductor Sag Clearance (Feet - ft)" ;
    cmm:unitSymbol "ft" ;
    cmm:cimDatatype "Length" .
cmm:RealTimeRating.solarIrradianceWPerM2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solar irradiance w per m2"@en ;
    rdfs:comment "Solar radiation intensity in watts per square meter. Solar heating reduces available thermal capacity, especially for overhead conductors."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "solar_irradiance_w_per_m2" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solar Irradiance (Watts per Square Meter - W/m²)" ;
    cmm:cimDatatype "Decimal" .
cmm:RealTimeRating.toBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to bus name"@en ;
    rdfs:comment "Name of the terminating bus or node in the EMS network model. Defines the other end of a transmission line or branch element."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "to_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "To Bus Name" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal operating voltage level of the transmission element in kilovolts. Critical for determining thermal and electrical limits."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolt - kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:RealTimeRating.weatherDataQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather data quality code"@en ;
    rdfs:comment "Quality indicator for weather inputs used in rating calculation. Poor quality data may require conservative rating adjustments or operator review."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_data_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Data Quality Code" ;
    cmm:validValues "good|uncertain|estimated|default|stale" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.weatherDataSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather data source"@en ;
    rdfs:comment "Source of weather data used in rating calculation. Real-time sensors provide highest accuracy; forecasts or seasonal defaults are fallback options."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_data_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Data Source" ;
    cmm:validValues "scada_sensor|weather_station|forecast_model|satellite|default_seasonal" ;
    cmm:cimDatatype "String" .
cmm:RealTimeRating.windDirectionDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind direction degrees"@en ;
    rdfs:comment "Wind direction in degrees (0-360) relative to true north. Wind angle relative to conductor affects cooling efficiency."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wind_direction_degrees" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Direction (Degrees)" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:RealTimeRating.windSpeedMph a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind speed mph"@en ;
    rdfs:comment "Measured or forecasted wind speed in miles per hour at conductor height. Wind cooling significantly increases thermal capacity of overhead lines."@en ;
    rdfs:domain cmm:RealTimeRating ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "wind_speed_mph" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Wind Speed (Miles Per Hour - mph)" ;
    cmm:unitSymbol "mph" ;
    cmm:cimDatatype "Speed" .

cmm:TopologySnapshot a owl:Class ;
    rdfs:label "Topology Snapshot"@en ;
    rdfs:comment "Periodic snapshot of the EMS network topology model capturing the real-time connectivity state of the grid — which breakers and switches are open or closed, resulting in the active network islands and energized/de-energized sections. Captures snapshot timestamp, topology processor run reference, number of islands, number of energized buses, number of open switching devices, and topology change flag. Used for post-event network reconstruction, NERC TOP compliance, and EMS model validation. Complements state_estimation_run by capturing the topological (connectivity) state separately from the electrical (power flow) state."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:TopologicalIsland ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Topology" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.topology_snapshot" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC CIM TopologyProcessor / EMS Network Model" ;
    cmm:sourceObject "energy_utilities_ecm.grid.topology_snapshot" ;
    owl:hasKey ( cmm:TopologySnapshot.topologySnapshotId ) .

cmm:TopologySnapshot.topologySnapshotId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology snapshot id"@en ;
    rdfs:comment "Primary key for topology_snapshot"@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:long ;
    cmm:physicalColumn "topology_snapshot_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Topology Snapshot Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:TopologySnapshot.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the control area or balancing authority whose network topology is captured in this snapshot."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_topology_snapshot_control_area_id" ;
    cmm:cimAssociation "TopologicalIsland.ControlArea" .
cmm:TopologySnapshot.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User identifier of the control center operator who acknowledged or reviewed this topology snapshot."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_topology_snapshot_employee_id" ;
    cmm:cimAssociation "TopologicalIsland.ErpPersonnel" .
cmm:TopologySnapshot.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Reference to the state estimation run that triggered or is associated with this topology snapshot. Links the topological state to the electrical state analysis."@en ;
