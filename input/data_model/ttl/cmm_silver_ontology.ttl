    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.country .
cmm:PowerPlant.cpcnNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn number"@en ;
    rdfs:comment "State Public Utility Commission certificate number authorizing construction and operation of the generation facility."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
