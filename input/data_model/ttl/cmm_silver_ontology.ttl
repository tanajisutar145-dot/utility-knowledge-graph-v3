    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ComplianceViolation.correctiveActionPlan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Description of the corrective actions required to remediate the violation."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:string ;
