cmm:SparePartsInventory.quantityOnHand a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity on hand"@en ;
    rdfs:comment "Current physical inventory quantity available in stock at the stocking location. Measured in the material's unit of measure."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_on_hand" ;
