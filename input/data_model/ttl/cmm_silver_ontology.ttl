cmm:PayrollRun a owl:Class ;
    rdfs:label "Payroll Run"@en ;
    rdfs:comment "Master reference table for payroll_run. Referenced by payroll_run_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.cost_allocation ;
    cmm:physicalTable "utility_cmm_silver.workforce.payroll_run" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.payroll_run" ;
    owl:hasKey ( cmm:PayrollRun.payrollRunId ) .

cmm:PayrollRun.payrollRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
