cmm:RateSchedule.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date from which this rate schedule becomes effective and applicable to customer billing."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:RateSchedule.energyChargeRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy charge rate"@en ;
    rdfs:comment "Base energy charge rate in dollars per kilowatt-hour. Represents the primary volumetric charge component for energy consumption."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_charge_rate" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Charge Rate ($/kWh)" ;
    cmm:cimDatatype "Decimal" .
cmm:RateSchedule.fuelAdjustmentClauseApplicable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel adjustment clause applicable"@en ;
    rdfs:comment "Indicates whether a fuel adjustment clause or energy cost adjustment mechanism applies to this rate schedule."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "fuel_adjustment_clause_applicable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
