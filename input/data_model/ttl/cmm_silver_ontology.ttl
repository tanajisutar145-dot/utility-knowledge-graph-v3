cmm:NetworkUpgrade.upgradeNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade number"@en ;
    rdfs:comment "Business identifier for the network upgrade, typically assigned by engineering or project management systems. Used for external communication and tracking."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_number" ;
