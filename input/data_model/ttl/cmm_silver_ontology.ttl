    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Applied Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:NemCredit.creditExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit expiration date"@en ;
    rdfs:comment "Date on which unused NEM credits from this transaction will expire if not applied, per state NEM program rules (typically 12 months)."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:date ;
