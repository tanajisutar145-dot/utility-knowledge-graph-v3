    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_cip_assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
