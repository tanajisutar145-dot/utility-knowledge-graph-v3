cmm:ControlArea.l10LimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "l10 limit mw"@en ;
    rdfs:comment "L10 parameter used in CPS1 (Control Performance Standard 1) calculation, representing the control area's frequency bias obligation in megawatts per 0.1 Hz."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "l10_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "L10 Limit (Megawatts)" ;
