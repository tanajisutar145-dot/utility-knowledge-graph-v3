cmm:RegulatoryFiling a owl:Class ;
    rdfs:label "Regulatory Filing"@en ;
    rdfs:comment "Transactional record of every formal submission made to a regulatory body, encompassing routine periodic filings, regulatory proceeding applications, market transaction reports, proactive self-disclosures, rate case proceedings, and long-term resource planning filings. Covers FERC Form 1, FERC EQR, FERC Form 552, FERC market-based rate tariff filings, NERC reliability standard audit submissions, PUC general and transmission rate case filings (including test year, revenue requirement, proposed rate changes, intervenor parties, procedural milestones, settlement status, and commission orders), CPCN applications for major capital projects (including project description, capital cost, environmental review, and certificate conditions), IRP filings (including planning horizon, load forecast, resource scenarios, and commission approval), EPA emissions reports, RPS compliance filings, self-reported potential violations (SPVs), FERC voluntary disclosures, and EPA self-disclosure submissions. Captures filing type, docket number, regulatory agency, submission date, filing period, filing status, responsible preparer, and filing-type-specific detail attributes. SSOT for all outbound regulatory submissions, regulatory proceeding lifecycle tracking, proactive disclosure management, rate case management, and resource planning filings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.regulatory_filing" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC eLibrary; FERC Form 1; EPA Clean Air Markets; NERC Compliance Registry" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.regulatory_filing" ;
    owl:hasKey ( cmm:RegulatoryFiling.regulatoryFilingId ) .

cmm:RegulatoryFiling.regulatoryFilingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing id"@en ;
    rdfs:comment "Unique identifier for the regulatory filing record. Primary key."@en ;
    rdfs:domain cmm:RegulatoryFiling ; rdfs:range xsd:long ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Regulatory Filing Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryFiling.cpcnApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn application"@en ;
    rdfs:comment "Foreign key linking to compliance.cpcn_application. Business justification: A regulatory filing can be part of a CPCN application proceeding. Many filings can relate to one CPCN application (1:N). The docket_number in regulatory_filing often references a CPCN docket. Adding c"@en ;
    rdfs:domain cmm:RegulatoryFiling ; rdfs:range cmm:CpcnApplication ;
    cmm:physicalColumn "cpcn_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cpcn Application Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_regulatory_filing_cpcn_application_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RegulatoryFiling.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "FK to compliance.obligation.obligation_id — Regulatory filings are submitted to fulfill specific compliance obligations. This link enables tracking which obligations have been satisfied by which filings."@en ;
    rdfs:domain cmm:RegulatoryFiling ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_regulatory_filing_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RegulatoryFiling.rateCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case"@en ;
    rdfs:comment "Foreign key linking to compliance.rate_case. Business justification: A regulatory filing can be part of a rate case proceeding. Many filings can relate to one rate case (1:N). The docket_number in regulatory_filing often references a rate case docket. Adding rate_case_"@en ;
    rdfs:domain cmm:RegulatoryFiling ; rdfs:range cmm:RateCase ;
    cmm:physicalColumn "rate_case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Case Id (Foreign Key)" ;
