cmm:ComplianceViolation.violationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation type"@en ;
    rdfs:comment "Category of the violation based on regulatory domain."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_type" ;
