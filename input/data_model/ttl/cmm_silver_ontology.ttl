cmm:BillingRun.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this billing run record was first created in the system, establishing the audit trail for billing operations tracking."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:BillingRun.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this billing run, typically USD for US-based energy utilities."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BillingRun.durationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration seconds"@en ;
    rdfs:comment "Total elapsed time in seconds from actual start to actual end of the billing run, used for performance analysis and capacity planning."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Run Duration in Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:BillingRun.errorCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "error count"@en ;
    rdfs:comment "Total number of critical errors encountered during billing run execution that prevented successful processing of accounts or invoice generation."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "error_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Error Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.exceptionCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception count"@en ;
    rdfs:comment "Total number of billing exceptions, warnings, or validation issues encountered during the run that require manual review or correction."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "exception_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Count" ;
    cmm:cimDatatype "Integer" .
cmm:BillingRun.executionMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution mode"@en ;
    rdfs:comment "Method by which the billing run was triggered, indicating whether it was automatically scheduled, manually initiated, or executed on-demand."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "execution_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Mode" ;
    cmm:validValues "automatic|manual|scheduled|on_demand" ;
    cmm:cimDatatype "String" .
cmm:BillingRun.glPostingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl posting date"@en ;
    rdfs:comment "Accounting date when the billing run results were posted to the general ledger for revenue recognition and accounts receivable booking."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "gl_posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Posting Date" ;
