cmm:PpaSettlement.settlementPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period start date"@en ;
    rdfs:comment "The first date of the settlement period for which generation and financial calculations apply."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaSettlement.settlementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement status"@en ;
    rdfs:comment "Current lifecycle status of the settlement record in the settlement-to-payment workflow. Reference-value candidates: draft|calculated|invoiced|paid|disputed|adjusted|cancelled."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Settlement Status" ;
