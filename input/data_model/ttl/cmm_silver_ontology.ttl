cmm:RegulatoryCorrespondence.correspondenceCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "correspondence category"@en ;
    rdfs:comment "Categorical classification of the correspondence type. Examples include information request, data request, interrogatory, compliance schedule letter, audit notice, enforcement action, reporting acknowledgment, or general inquiry. Reference-value candidates: information_request|data_request|interrogatory|compliance_schedule|audit_notice|enforcement_action|reporting_acknowledgment|general_inquiry|notice_of_violation|settlement_agreement."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "correspondence_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Correspondence Category" ;
    cmm:cimDatatype "String" ;
