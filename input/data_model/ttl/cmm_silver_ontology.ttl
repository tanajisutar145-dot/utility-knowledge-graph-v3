cmm:SafetyIncident.mroName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mro name"@en ;
    rdfs:comment "Name of the Medical Review Officer who reviewed and verified the drug test result. Required for DOT compliance documentation."@en ;
