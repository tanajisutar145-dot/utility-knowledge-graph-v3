cmm:AncillaryServiceOffer.offerCurveSegmentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer curve segment count"@en ;
    rdfs:comment "The number of price-quantity segments in the ancillary service offer curve, if the offer is structured as a multi-segment bid."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:int ;
    cmm:physicalColumn "offer_curve_segment_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Curve Segment Count" ;
