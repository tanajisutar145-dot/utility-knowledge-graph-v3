cmm:BillingServiceAgreement.dunningBlockFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dunning block flag"@en ;
    rdfs:comment "Indicates whether collections and dunning activities are blocked for this service agreement due to payment arrangement, dispute, or special circumstances."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
