    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:SafetyTraining a owl:Class ;
    rdfs:label "Safety Training"@en ;
    rdfs:comment "Records of safety training sessions delivered to utility workforce personnel, including OSHA-mandated training (lockout/tagout, confined space entry, arc flash, fall protection, hazmat), NERC CIP security awareness training, and utility-specific operational safety programs. Captures training program name, delivery date, instructor, delivery method (classroom, online, field), employees trained, pass/fail status, and next required date. Supports OSHA compliance and NERC CIP-004 security awareness evidence."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.safety_compliance ;
    cmm:physicalTable "utility_cmm_silver.workforce.safety_training" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OSHA 1910.269; OSHA 1910.132; NERC CIP-004 R2 Security Awareness" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.safety_training" ;
    owl:hasKey ( cmm:SafetyTraining.safetyTrainingId ) .

cmm:SafetyTraining.safetyTrainingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety training id"@en ;
    rdfs:comment "Unique identifier for the safety training session record. Primary key."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range xsd:long ;
    cmm:physicalColumn "safety_training_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Safety Training ID" ;
    cmm:cimDatatype "Integer" .
cmm:SafetyTraining.primarySafetyEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary safety employee"@en ;
    rdfs:comment "Identifier of the utility workforce employee who attended the training session. Links to workforce employee master data."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_safety_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_training_primary_safety_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:SafetyTraining.trainingProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "training program"@en ;
    rdfs:comment "Identifier of the safety training program or course catalog entry. Links to training program master data."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "training_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Training Program ID" ;
    cmm:sourceColumn "program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_training_training_program_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:SafetyTraining.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the work order to which training labor costs are allocated, if applicable. Links to asset management work order data."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_safety_training_work_order_id" ;
    cmm:cimAssociation "ActivityRecord.Work" .
cmm:SafetyTraining.assessmentRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment required flag"@en ;
    rdfs:comment "Boolean flag indicating whether the training program requires a formal assessment or examination for completion."@en ;
    rdfs:domain cmm:SafetyTraining ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "assessment_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
