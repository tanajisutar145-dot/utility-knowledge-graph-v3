    cmm:cimCloseMatch cim:Name.name .
cmm:PpaSettlement.settlementPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period end date"@en ;
    rdfs:comment "The last date of the settlement period for which generation and financial calculations apply."@en ;
