    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Aggregate Distributed Energy Resource (DER) Capacity in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:TechnicalReview.assignedEngineerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned engineer name"@en ;
    rdfs:comment "Full name of the utility engineer assigned to conduct the technical review. Denormalized for reporting convenience."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:string ;
