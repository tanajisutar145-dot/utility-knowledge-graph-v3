    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_der_registry_id" ;
    cmm:cimAssociation "InspectionDataSet.PowerElectronicsConnection" .
cmm:AssetInspection.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Foreign key linking to distribution.transformer. Business justification: Transformer inspections (visual, oil sampling, dissolved gas analysis, thermography) are mandated by NFPA 70B, IEEE C57 standards, and insurance requirements. Links inspection results to specific tran"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Id (Foreign Key)" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_distribution_transformer_id" ;
    cmm:cimAssociation "InspectionDataSet.PowerTransformer" .
cmm:AssetInspection.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Feeder inspections (patrol, infrared thermography, detailed climbing inspections) are regulatory requirements (NERC FAC standards, state PUC mandates) and reliability best practices. Links inspection"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_feeder_id" ;
    cmm:cimAssociation "InspectionDataSet.Feeder" .
cmm:AssetInspection.inspectionApprovedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inspection approved by user employee"@en ;
    rdfs:comment "Identifier of the supervisor or engineer who reviewed and approved the inspection findings and recommendations."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "inspection_approved_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_inspection_inspection_approved_by_user_employee_id" ;
    cmm:cimAssociation "InspectionDataSet.ErpPersonnel" .
cmm:AssetInspection.inspectionEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inspection employee"@en ;
