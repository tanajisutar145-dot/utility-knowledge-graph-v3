cmm:DispatchInstruction a owl:Class ;
    rdfs:label "Dispatch Instruction"@en ;
    rdfs:comment "Master reference table for dispatch_instruction. Referenced by dispatch_instruction_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:GenUnitOpSchedule ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.dispatch_instruction" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.grid.dispatch_instruction" ;
    owl:hasKey ( cmm:DispatchInstruction.dispatchInstructionId ) .

cmm:DispatchInstruction.dispatchInstructionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch instruction id"@en ;
    rdfs:comment "Primary key for dispatch_instruction"@en ;
    rdfs:domain cmm:DispatchInstruction ; rdfs:range xsd:long ;
    cmm:physicalColumn "dispatch_instruction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Dispatch Instruction Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DispatchInstruction.approvedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approved by user employee"@en ;
    rdfs:comment "Identifier of the user who approved the dispatch instruction."@en ;
    rdfs:domain cmm:DispatchInstruction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approved_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_dispatch_instruction_approved_by_user_employee_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ErpPersonnel" .
cmm:DispatchInstruction.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Dispatch instructions are issued within a control area context; adding dispatch_instruction.control_area_id links each instruction to its control area, providing the required inbound relationship."@en ;
    rdfs:domain cmm:DispatchInstruction ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_dispatch_instruction_control_area_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ControlArea" .
cmm:DispatchInstruction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the user who created the dispatch instruction record."@en ;
    rdfs:domain cmm:DispatchInstruction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_dispatch_instruction_employee_id" ;
    cmm:cimAssociation "GenUnitOpSchedule.ErpPersonnel" .
cmm:DispatchInstruction.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
