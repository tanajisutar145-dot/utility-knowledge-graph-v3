cmm:TransmissionOutage.rtoIsoRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso region"@en ;
    rdfs:comment "The RTO or ISO region where the outage occurred (e.g., PJM, MISO, CAISO, ERCOT, SPP). Determines coordination and reporting requirements."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Region" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.safetyClearanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety clearance number"@en ;
    rdfs:comment "Safety clearance or hold number issued to protect workers during the outage. Ensures compliance with OSHA and utility safety protocols."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_clearance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
