    cmm:cimDatatype "Integer" .
cmm:SparePartsInventory.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Identifier for the operational system of record from which this inventory data originated. VENTYX for Ventyx Asset Suite Inventory module, SAP_MM for SAP S/4HANA Materials Management, SAP_PM for SAP Plant Maintenance, MANUAL for manually entered records."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
