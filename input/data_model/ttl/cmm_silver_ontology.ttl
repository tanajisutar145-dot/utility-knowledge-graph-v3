cmm:TopologySnapshot.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of the validation checks performed on this topology snapshot to ensure consistency with physical network constraints and operational rules."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
