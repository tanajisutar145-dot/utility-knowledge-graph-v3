    cmm:cimDatatype "String" .
cmm:CostCenter.environmentalComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental compliance flag"@en ;
    rdfs:comment "Indicates whether this cost center incurs costs related to environmental compliance (EPA emissions standards, renewable portfolio standards, environmental remediation). Used for regulatory reporting and cost recovery."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:boolean ;
