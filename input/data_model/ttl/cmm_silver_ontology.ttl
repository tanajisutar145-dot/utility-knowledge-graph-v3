    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrIncentivePayment.isoRtoName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto name"@en ;
    rdfs:comment "Name of the ISO or RTO wholesale market from which this payment originates (e.g., PJM, CAISO, ERCOT, NYISO, ISO-NE, MISO, SPP). Null for retail-only programs."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Name" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this incentive payment record was last updated, reflecting the most recent change to payment status, amounts, or reconciliation status."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DrIncentivePayment.lmpPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price per mwh"@en ;
    rdfs:comment "The locational marginal price in dollars per megawatt-hour at the pricing node (PNode) during the demand response event. Used for wholesale market energy payment calculations."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lmp_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DrIncentivePayment.measuredCurtailmentKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measured curtailment kw"@en ;
    rdfs:comment "The verified load reduction in kilowatts achieved during the demand response event, calculated as baseline load minus actual load. Basis for energy payments."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "measured_curtailment_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measured Curtailment (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrIncentivePayment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes regarding special circumstances, adjustments, disputes, or other relevant information about this incentive payment."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DrIncentivePayment.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "Method by which the incentive payment is disbursed: bill credit applied to customer account, direct deposit to bank account, physical check, wire transfer, or settlement through aggregator."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:validValues "bill_credit|direct_deposit|check|wire_transfer|aggregator_settlement" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.paymentReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment reference number"@en ;
    rdfs:comment "Unique business identifier for this incentive payment transaction, used for customer communication and payment tracking."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrIncentivePayment.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "Current lifecycle status of the incentive payment: pending calculation (awaiting M&V), pending approval (awaiting management review), approved (ready for disbursement), disbursed (payment issued), reconciled (matched with wholesale settlement), disputed (under review), or cancelled (voided). Reference-value candidates: pending_calculation|pending_approval|approved|disbursed|reconciled|disputed|cancelled."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.status .
cmm:DrIncentivePayment.paymentToEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment to enrollment"@en ;
    rdfs:comment "FK to demand.dr_enrollment.dr_enrollment_id — Payments are issued to enrolled customers/aggregators. This FK links the payment to the enrollment record for customer identification and payment routing."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "payment_to_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DrIncentivePayment.paymentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment type"@en ;
    rdfs:comment "Classification of the incentive payment type: capacity payment for enrolled load, energy payment for actual curtailment, performance bonus for exceeding targets, penalty deduction for non-performance, reconciliation adjustment for settlement corrections, or aggregator commission for program management."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Type" ;
    cmm:validValues "capacity_payment|energy_payment|performance_bonus|penalty_deduction|reconciliation_adjustment|aggregator_commission" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.kind .
cmm:DrIncentivePayment.penaltyDeductionAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty deduction amount"@en ;
    rdfs:comment "Penalty amount in dollars deducted from payment for non-performance, failure to curtail, or non-compliance with program requirements."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "penalty_deduction_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Deduction Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrIncentivePayment.performanceBonusAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance bonus amount"@en ;
    rdfs:comment "Additional incentive payment in dollars awarded for exceeding curtailment targets or achieving exceptional performance metrics."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "performance_bonus_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Bonus Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrIncentivePayment.pnodeIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pnode identifier"@en ;
    rdfs:comment "Identifier for the pricing node in the wholesale market where the demand response resource is located. Used for LMP-based settlement calculations."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "pnode_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode) Identifier" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.reconciliationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation status"@en ;
    rdfs:comment "Status of reconciliation between retail incentive payment and wholesale market settlement: not reconciled, reconciled (matched), variance identified (discrepancy found), under review (investigating), or resolved (variance corrected)."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "reconciliation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Status" ;
    cmm:validValues "not_reconciled|reconciled|variance_identified|under_review|resolved" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.settlementPeriodEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period end"@en ;
    rdfs:comment "End timestamp of the settlement period covered by this incentive payment. Defines the billing cycle or market settlement window."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "settlement_period_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrIncentivePayment.settlementPeriodStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement period start"@en ;
    rdfs:comment "Start timestamp of the settlement period covered by this incentive payment. Aligns with ISO/RTO settlement intervals for wholesale market payments."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "settlement_period_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Period Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrIncentivePayment.settlementStatementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement statement reference"@en ;
    rdfs:comment "Cross-reference to the ISO/RTO wholesale market settlement statement from which this payment originates. Used for reconciliation with wholesale market settlements."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_statement_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Statement Reference Number" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.utilityNetCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility net cost"@en ;
    rdfs:comment "Net cost to the utility in dollars for this demand response incentive payment after accounting for wholesale market revenue offsets and ISO/RTO settlements."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_net_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utility Net Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:DrAggregator a owl:Class ;
    rdfs:label "Dr Aggregator"@en ;
    rdfs:comment "Master record for third-party demand response aggregators and curtailment service providers (CSPs) registered to aggregate customer load for ISO/RTO wholesale DR markets. Captures aggregator legal entity, FERC/ISO registration ID, service territory, aggregation technology platform, contractual capacity commitment (MW), performance bond, compliance status, and active program associations. SSOT for aggregator identity and contractual management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MarketParticipant ;
    cmm:cimCloseMatch cim:MarketParticipant ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::MarketCommon" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.event_execution ;
    cmm:physicalTable "utility_cmm_silver.demand.aggregator" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC Order 2222; FERC Order 2222 Aggregator Registration; ISO/RTO CSP Registry" ;
    cmm:sourceObject "energy_utilities_ecm.demand.aggregator" ;
    owl:hasKey ( cmm:DrAggregator.aggregatorId ) .

cmm:DrAggregator.aggregatorId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator id"@en ;
    rdfs:comment "Unique identifier for the demand response aggregator or curtailment service provider (CSP). Primary key for the aggregator master record."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:long ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Aggregator Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DrAggregator.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Aggregators undergo compliance audits by FERC and regional entities to verify performance, telemetry accuracy, and contractual compliance. Required for aggregator performance audits, compliance verifi"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_audit_id" ;
    cmm:cimAssociation "MarketParticipant.ActivityRecord" .
cmm:DrAggregator.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Aggregator relationships incur administrative and settlement costs that must be tracked by cost center. Performance_bond_amount and contracted_capacity_mw represent financial obligations requiring cos"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_cost_center_id" ;
    cmm:cimAssociation "MarketParticipant.Organisation" .
cmm:DrAggregator.derInstaller a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der installer"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_installer. Business justification: Aggregators partner with certified DER installers for customer acquisition and enrollment pipeline development. Installer performance metrics (application completeness rate, average time to PTO) infor"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:DerInstaller ;
    cmm:physicalColumn "der_installer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Installer Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_der_installer_id" ;
    cmm:cimAssociation "MarketParticipant.OrganisationRole" .
cmm:DrAggregator.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Aggregators operate in specific geographic zones/service territories for capacity aggregation and ISO/RTO market participation. Zone assignment is required for local capacity requirements, transmissio"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_forecast_zone_id" ;
    cmm:cimAssociation "MarketParticipant.LoadArea" .
cmm:DrAggregator.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Aggregators must comply with FERC Order 2222 registration obligations and regional entity operational requirements. Essential for aggregator compliance tracking, registration validation, and ensuring"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_obligation_id" ;
    cmm:cimAssociation "MarketParticipant.Document" .
cmm:DrAggregator.primaryContactEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Aggregator relationships are managed by specific utility account managers (employees) who coordinate contracts, performance monitoring, and settlement. Primary_contact fields denormalize employee data"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_contact_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Primary Contact Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_primary_contact_employee_id" ;
    cmm:cimAssociation "MarketParticipant.ErpPersonnel" .
cmm:DrAggregator.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to supply.vendor. Business justification: Aggregators are registered as vendors for payment processing and contract management. Business process: financial settlement, invoice verification, payment terms administration, performance bond track"@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_aggregator_vendor_id" ;
    cmm:cimAssociation "MarketParticipant.Organisation" .
cmm:DrAggregator.aggregationPlatform a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregation platform"@en ;
    rdfs:comment "Name or description of the technology platform or system used by the aggregator to manage and dispatch aggregated customer load."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregation_platform" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Aggregation Technology Platform" ;
    cmm:cimDatatype "String" .
cmm:DrAggregator.aggregatorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator code"@en ;
    rdfs:comment "Short business code or abbreviation used internally to identify the aggregator in operational systems and reports."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregator_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Aggregator Business Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrAggregator.aggregatorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator name"@en ;
    rdfs:comment "Full legal name of the third-party demand response aggregator or curtailment service provider as registered with regulatory authorities."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregator_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Aggregator Legal Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DrAggregator.aggregatorStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator status"@en ;
    rdfs:comment "Current operational status of the aggregator relationship with the utility, indicating whether the aggregator is authorized to aggregate customer load."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregator_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Aggregator Status" ;
    cmm:validValues "active|inactive|suspended|pending_approval|terminated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MarketParticipant.status .
cmm:DrAggregator.aggregatorType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator type"@en ;
    rdfs:comment "Classification of the aggregator based on its primary business model and service offering in the demand response ecosystem."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregator_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Aggregator Type" ;
    cmm:validValues "curtailment_service_provider|demand_response_aggregator|virtual_power_plant_operator|energy_service_company|load_serving_entity" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MarketParticipant.kind .
cmm:DrAggregator.baselineMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline methodology"@en ;
    rdfs:comment "Approved methodology used to calculate customer baseline load for measurement and verification of demand response performance (e.g., high-X-of-Y, regression-based)."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Methodology" ;
    cmm:cimDatatype "String" .
cmm:DrAggregator.businessAddressLine1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business address line1"@en ;
    rdfs:comment "First line of the aggregators primary business address, typically including street number and street name."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_address_line1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Business Address Line 1" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:DrAggregator.businessAddressLine2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business address line2"@en ;
    rdfs:comment "Second line of the aggregators business address for suite, floor, or building information."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_address_line2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Business Address Line 2" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:DrAggregator.businessCity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business city"@en ;
    rdfs:comment "City or municipality of the aggregators primary business address."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Business City" ;
