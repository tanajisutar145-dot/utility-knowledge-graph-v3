    rdfs:label "switching order reference"@en ;
    rdfs:comment "Reference identifier to the switching order or operational instruction that caused the topology change captured in this snapshot, if applicable."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
