    cmm:cimDatatype "String" .
cmm:NercCipAsset.cipImpactRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cip impact rating"@en ;
    rdfs:comment "Impact classification per NERC CIP-002: High, Medium, or Low. Determines the rigor of CIP standards applicable to this asset."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "cip_impact_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CIP (Critical Infrastructure Protection) Impact Rating" ;
    cmm:validValues "High|Medium|Low" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.cipStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cip status"@en ;
    rdfs:comment "Current lifecycle status of the asset within the CIP compliance program: In Scope (subject to CIP standards), Out of Scope, Pending Assessment, Decommissioned, or Retired."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "cip_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "CIP (Critical Infrastructure Protection) Status" ;
    cmm:validValues "In Scope|Out of Scope|Pending Assessment|Decommissioned|Retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.status .
cmm:NercCipAsset.cipVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cip version"@en ;
    rdfs:comment "Version of the NERC CIP standard applicable to this asset (e.g., CIP-002-5.1a, CIP-005-6, CIP-007-6). Tracks which version of the standard governs compliance obligations."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "cip_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CIP (Critical Infrastructure Protection) Standard Version" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.configurationChangeManagementRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "configuration change management required"@en ;
    rdfs:comment "Indicates whether this asset is subject to CIP-010 Configuration Change Management and Configuration Monitoring requirements."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "configuration_change_management_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Configuration Change Management Required" ;
