#################################################################
# Subject area: renewable
#################################################################

cmm:DerRegistry a owl:Class ;
    rdfs:label "Der Registry"@en ;
    rdfs:comment "Master registry of all Distributed Energy Resources (DERs) registered within the utility service territory. Captures DER type (solar PV, battery storage, small wind, fuel cell), nameplate capacity (kW/MW), technology class, interconnection point (POI), DERMS system identifier, commissioning date, operational status, ownership structure (customer-owned, third-party, utility), and geographic coordinates. SSOT for all distributed generation and storage assets participating in utility programs including NEM, VPP, demand response, and storage incentives. Excludes utility-scale generation facilities mastered in the generation domain and customer-level interconnection applications managed in the interconnection domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PowerElectronicsConnection ;
    cmm:cimCloseMatch cim:PowerElectronicsConnection ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.asset_management ;
    cmm:physicalTable "utility_cmm_silver.renewable.der_registry" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEEE 1547; IEEE 2030.5; DERMS DER Registry / NERC Generator Registration" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.der_registry" ;
    owl:hasKey ( cmm:DerRegistry.derRegistryId ) .

cmm:DerRegistry.derRegistryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der registry id"@en ;
    rdfs:comment "Unique identifier for the DER registration record. Primary key for the DER registry."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Registry ID" ;
    cmm:cimDatatype "Integer" .
cmm:DerRegistry.commissioningTechnicianEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning technician employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: DER commissioning requires licensed electricians to perform final inspections, sign-off, and permission-to-operate certification. Tracks responsible technician for regulatory compliance, warranty clai"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "commissioning_technician_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Commissioning Technician Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_commissioning_technician_employee_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.ErpPersonnel" .
cmm:DerRegistry.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: DERs operate within specific control areas for balancing authority coordination, ACE calculation, frequency regulation, and interchange scheduling. Control area operators need visibility of all DER ca"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_control_area_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.ControlArea" .
cmm:DerRegistry.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Distribution substation identifier serving the DER location. Used for substation-level DER aggregation, capacity planning, and grid impact analysis."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_distribution_substation_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.Substation" .
cmm:DerRegistry.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Foreign key linking to grid.ems_node. Business justification: Large DERs (>1MW typically) modeled as EMS nodes for state estimation, power flow analysis, and contingency analysis. Required for grid operators to include DER generation in real-time network models"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Node Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_ems_node_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.TopologicalNode" .
cmm:DerRegistry.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Distribution feeder circuit identifier where the DER is interconnected. Used for hosting capacity analysis, voltage regulation studies, and feeder-level DER penetration tracking."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_feeder_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.Feeder" .
cmm:DerRegistry.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Utility-owned DER installations (solar, storage) are capitalized fixed assets requiring FERC account assignment, depreciation, and rate base inclusion; core link for renewable asset accounting and reg"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_fixed_asset_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.FinancialInfo" .
cmm:DerRegistry.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: DER assets are geographically assigned to forecast zones for aggregated load and generation forecasting, resource adequacy assessments, and distribution planning. Essential for modeling DER impact on"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_forecast_zone_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.LoadArea" .
cmm:DerRegistry.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: DER equipment (inverters, batteries, solar panels) are procured materials with part numbers, specifications, and warranty tracking. Real business process: asset lifecycle management, spare parts plann"@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_registry_material_master_id" ;
    cmm:cimAssociation "PowerElectronicsConnection.ErpItemMaster" .
cmm:DerRegistry.btmGenerationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "btm generation flag"@en ;
    rdfs:comment "Indicates whether the DER is a behind-the-meter installation serving on-site load. True for customer-sited resources that offset premise consumption. False for front-of-meter or utility-scale resources that export all generation to the grid."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "btm_generation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behind-the-Meter (BTM) Generation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the DER completed all interconnection requirements and was authorized to begin commercial operation. Used for Renewable Energy Certificate (REC) vintage determination, incentive eligibility, and asset age tracking."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:DerRegistry.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this DER registry record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PowerElectronicsConnection.createdDateTime .
cmm:DerRegistry.curtailmentCapableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment capable flag"@en ;
    rdfs:comment "Indicates whether the DER can be remotely curtailed by the utility or aggregator. True if the resource has communication and control infrastructure for dispatch down commands. False if the resource operates autonomously without remote control capability."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "curtailment_capable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or application that provided this DER registration data. Examples include interconnection application systems, DERMS platforms, or manual registration portals. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.decommissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decommissioning date"@en ;
    rdfs:comment "Date when the DER was permanently removed from service and disconnected from the grid. Null for active resources. Used for asset lifecycle tracking and capacity planning."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "decommissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Decommissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:DerRegistry.demandResponseEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response eligible flag"@en ;
    rdfs:comment "Indicates whether the DER is eligible to participate in utility demand response programs. True if the resource has controllable load or dispatchable generation/storage capability. False if ineligible due to size, technology, or operational constraints."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.derName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der name"@en ;
    rdfs:comment "Business name or designation of the distributed energy resource installation."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DerRegistry.derToEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der to enrollment"@en ;
    rdfs:comment "FK to renewable.renewable_der_enrollment.renewable_der_enrollment_id — DER enrollment records must reference the specific DER they enroll. This is the fundamental master-to-transaction link for DER program management."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_to_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DerRegistry.derType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der type"@en ;
    rdfs:comment "Classification of the DER technology. Solar PV includes rooftop and ground-mount photovoltaic systems. Battery storage includes lithium-ion, flow batteries, and other electrochemical storage. Wind includes small-scale turbines under 1 MW. Fuel cell includes hydrogen and natural gas fuel cells. Combined heat and power (CHP) includes cogeneration systems. Microturbine includes small combustion turbines."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Type" ;
    cmm:validValues "solar_pv|battery_storage|wind|fuel_cell|combined_heat_power|microturbine" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PowerElectronicsConnection.kind .
cmm:DerRegistry.dermsSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derms system code"@en ;
    rdfs:comment "External system identifier used by the DERMS platform to monitor and control this DER. Enables real-time dispatch, curtailment commands, and telemetry integration. Null for DERs not enrolled in DERMS programs."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "derms_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource Management System (DERMS) System ID" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.exportLimitKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export limit kw"@en ;
    rdfs:comment "Maximum power export limit in kilowatts (kW) allowed by the interconnection agreement. May be less than nameplate capacity due to grid constraints, NEM program rules, or hosting capacity limitations. Null if no export limit applies."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "export_limit_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Limit (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerRegistry.forecastProvider a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast provider"@en ;
    rdfs:comment "Name of the third-party or internal system providing generation forecasts for this DER. Used for solar and wind resources requiring day-ahead and real-time production forecasting. Null for non-variable resources."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "forecast_provider" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Provider" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.incentiveProgramCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive program code"@en ;
    rdfs:comment "Code identifying the utility or state incentive program under which the DER was installed. Examples include solar rebate programs, storage incentives, or federal Investment Tax Credit (ITC) tracking. Null if no incentive was claimed."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Program Code" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.installationCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation cost usd"@en ;
    rdfs:comment "Total installed cost of the DER in US dollars including equipment, labor, permitting, and interconnection fees. Business-confidential. Used for incentive program cost-effectiveness analysis and LCOE calculations."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "installation_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DerRegistry.interconnectionAgreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement number"@en ;
    rdfs:comment "Unique identifier for the executed interconnection agreement governing the DERs connection to the utility grid. References the legal contract specifying technical requirements, liability, and operational protocols."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interconnection Agreement Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DerRegistry.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent utility or third-party inspection of the DER installation. Used for compliance verification, safety audit tracking, and periodic re-certification requirements."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:DerRegistry.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this DER registry record was most recently updated. Used for change tracking, data quality monitoring, and audit trail purposes."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DerRegistry.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the DER installation in decimal degrees. Used for GIS mapping, solar irradiance modeling, weather correlation, and grid topology analysis."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DerRegistry.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the DER installation in decimal degrees. Used for GIS mapping, solar irradiance modeling, weather correlation, and grid topology analysis."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DerRegistry.meterNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter number"@en ;
    rdfs:comment "Utility meter identifier associated with the DER interconnection point. References the revenue meter or production meter used for NEM credit calculation, billing, and generation tracking. May reference a dedicated production meter or the premise service meter."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DerRegistry.nameplateCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity kw"@en ;
    rdfs:comment "Maximum rated power output or storage capacity of the DER in kilowatts (kW). For generation resources, this is the AC output rating. For battery storage, this is the maximum discharge rate. Critical for grid planning, interconnection studies, and program eligibility determination."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nameplate Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerRegistry.nemEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem eligible flag"@en ;
    rdfs:comment "Indicates whether the DER is eligible for Net Energy Metering (NEM) programs. True if the resource meets size, technology, and jurisdictional requirements for NEM credit generation. False if ineligible or enrolled in alternative compensation mechanisms."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next required inspection or compliance verification. Null if no periodic inspection is required. Used for proactive maintenance scheduling and regulatory compliance tracking."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:DerRegistry.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, special conditions, or operational notes related to the DER registration. May include interconnection study findings, operational restrictions, or program-specific requirements."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DerRegistry.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the DER. Commissioned indicates the resource has completed interconnection and is authorized to operate. Operational indicates active generation or storage capability. Offline indicates temporary non-operation due to maintenance or technical issues. Decommissioned indicates permanent removal from service. Suspended indicates administrative hold. Testing indicates pre-commissioning validation phase."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "commissioned|operational|offline|decommissioned|suspended|testing" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PowerElectronicsConnection.status .
cmm:DerRegistry.ownerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner name"@en ;
    rdfs:comment "Legal name of the entity that owns the DER asset. May be a residential customer, commercial entity, or third-party developer. Business-confidential for competitive and privacy reasons."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Owner Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.ownershipStructure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership structure"@en ;
    rdfs:comment "Legal ownership model of the DER. Customer-owned indicates the premise owner owns the asset. Third-party-owned indicates a solar lease, PPA, or other third-party financing arrangement. Utility-owned indicates utility-scale BTM assets. Community-shared indicates community solar or shared renewable programs."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_structure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Structure" ;
    cmm:validValues "customer_owned|third_party_owned|utility_owned|community_shared" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.poiIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi identifier"@en ;
    rdfs:comment "Unique identifier for the physical point where the DER connects to the utility distribution system. References the specific transformer, service panel, or substation bus where interconnection occurs. Critical for grid modeling, outage management, and voltage regulation analysis."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Identifier" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.recEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec eligible flag"@en ;
    rdfs:comment "Indicates whether the DER is eligible to generate Renewable Energy Certificates (RECs). True if the resource is a qualifying renewable technology under state RPS rules. False if ineligible due to technology type, vintage, or jurisdictional requirements."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.registrationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "registration date"@en ;
    rdfs:comment "Date when the DER was first registered in the utility DER registry. Represents the initial record creation date, which may precede commissioning. Used for audit trail and registration workflow tracking."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "registration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Registration Date" ;
    cmm:cimDatatype "Date" .
cmm:DerRegistry.rpsComplianceTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps compliance tier"@en ;
    rdfs:comment "RPS tier classification for the DER under state renewable portfolio standards. Tiers typically differentiate by technology type, vintage, or geographic location. Examples include Tier 1 (new renewables), Tier 2 (existing renewables), Solar Carve-Out, or Distributed Generation tier. Null if not RPS-eligible."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "rps_compliance_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Compliance Tier" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Utility service territory or operating company jurisdiction where the DER is located. Used for regulatory reporting, RPS compliance tracking, and jurisdictional analysis."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:DerRegistry.smartInverterCapableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "smart inverter capable flag"@en ;
    rdfs:comment "Indicates whether the DER is equipped with IEEE 1547-2018 compliant smart inverter functionality. True if the inverter supports advanced grid support functions including volt-VAR, frequency-watt, and dynamic reactive power control. False for legacy inverters without advanced functions."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "smart_inverter_capable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Smart Inverter Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerRegistry.storageCapacityKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage capacity kwh"@en ;
    rdfs:comment "Total energy storage capacity in kilowatt-hours (kWh) for battery storage and other energy storage systems. Null for non-storage DER types. Used for Virtual Power Plant (VPP) aggregation and demand response program sizing."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "storage_capacity_kwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storage Capacity (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DerRegistry.technologyClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technology class"@en ;
    rdfs:comment "Detailed technology classification including manufacturer model, inverter type, panel efficiency class, or battery chemistry. Provides granular technical categorization beyond the primary DER type."@en ;
    rdfs:domain cmm:DerRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "technology_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technology Class" ;
    cmm:cimDatatype "String" .

cmm:RenewableRecCertificate a owl:Class ;
    rdfs:label "Renewable Rec Certificate"@en ;
    rdfs:comment "Renewable Energy Certificate (REC) issuance and retirement record. Each REC represents 1 MWh of renewable electricity generated and injected into the grid. Captures certificate serial number, generation source facility or DER, generation period, technology type, vintage year, issuing registry (WREGIS, M-RETS, PJM-GATS, NAR), certificate status (issued, transferred, retired, expired), retirement reason (RPS compliance, voluntary, export), and associated RPS obligation period. SSOT for REC inventory, lifecycle tracking, and compliance retirement within the renewable domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.program_incentives ;
    cmm:physicalTable "utility_cmm_silver.renewable.renewable_rec_certificate" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "WREGIS; M-RETS; WREGIS / M-RETS / NERC GATS REC Certificate" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.renewable_rec_certificate" ;
    owl:hasKey ( cmm:RenewableRecCertificate.renewableRecCertificateId ) .

cmm:RenewableRecCertificate.renewableRecCertificateId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable rec certificate id"@en ;
    rdfs:comment "Unique identifier for the renewable energy certificate record. Primary key."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:long ;
    cmm:physicalColumn "renewable_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) ID" ;
    cmm:cimDatatype "Integer" .
cmm:RenewableRecCertificate.attestationDocument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "attestation document"@en ;
    rdfs:comment "Reference identifier for the supporting documentation or attestation filed with the registry to verify generation and REC issuance. Used for audit and compliance verification."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:AttestationDocument ;
    cmm:physicalColumn "attestation_document_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Attestation Document ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_attestation_document_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RenewableRecCertificate.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "FK to renewable.der_registry.der_registry_id — Each REC must trace back to the generation source (DER or facility) that produced the 1 MWh of renewable electricity. This is a regulatory requirement for REC validity."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_der_registry_id" ;
    cmm:cimAssociation "Document.PowerElectronicsConnection" .
cmm:RenewableRecCertificate.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: IRP scenarios project REC generation and retirement to model RPS compliance pathways, renewable attribute tracking, and ACP exposure. Essential for long-term renewable procurement planning."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RenewableRecCertificate.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "Foreign key linking to finance.journal_entry. Business justification: REC issuance, transfer, and retirement trigger GL entries for inventory valuation, revenue recognition, and compliance cost accounting; direct link automates posting and provides audit trail for renew"@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Journal Entry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_journal_entry_id" ;
    cmm:cimAssociation "Document.ErpJournal" .
cmm:RenewableRecCertificate.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to metering.meter. Business justification: REC issuance requires validated metered generation data from specific revenue-quality meters for attestation. REC audit trail and compliance verification link certificate to source meter for data line"@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_meter_id" ;
    cmm:cimAssociation "Document.Meter" .
cmm:RenewableRecCertificate.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: RECs must be tracked against specific RPS compliance obligations for regulatory reporting. Utilities track which RPS mandate each REC satisfies. Critical for RPS compliance verification and obligation"@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RenewableRecCertificate.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Reference to the renewable generation facility or distributed energy resource (DER) that produced the electricity represented by this REC."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:RenewableRecCertificate.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: RECs issued from utility-owned renewable assets require asset linkage for RPS compliance audits, vintage tracking, and double-counting prevention. Complements existing power_plant_id for non-plant ren"@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_registry_id" ;
    cmm:cimAssociation "Document.Asset" .
cmm:RenewableRecCertificate.rpsObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rps obligation"@en ;
    rdfs:comment "FK to renewable.rps_obligation.rps_obligation_id — RECs are retired to satisfy RPS obligations. This is the core compliance linkage — every REC retirement for RPS compliance must reference the specific obligation period it satisfies. Production-critic"@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:RpsObligation ;
    cmm:physicalColumn "rps_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_rps_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RenewableRecCertificate.vppConfiguration a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vpp configuration"@en ;
    rdfs:comment "Reference to the virtual power plant (VPP) or DER aggregation program if this REC was generated by a facility participating in aggregated dispatch. Null for standalone facilities."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range cmm:VppConfiguration ;
    cmm:physicalColumn "vpp_configuration_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Aggregation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_renewable_rec_certificate_vpp_configuration_id" ;
    cmm:cimAssociation "Document.EndDeviceGroup" .
cmm:RenewableRecCertificate.certificateSerialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certificate serial number"@en ;
    rdfs:comment "Unique serial number assigned by the issuing registry to this REC. This is the externally-known identifier used for tracking, trading, and retirement across registries and market participants."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "certificate_serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certificate Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:RenewableRecCertificate.certificateStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certificate status"@en ;
    rdfs:comment "Current lifecycle status of the REC. Issued: newly created; Active: available for trading; Transferred: ownership changed; Retired: used for compliance or voluntary claim; Expired: past validity period; Cancelled: invalidated; Suspended: temporarily held. Reference-value candidates: issued|active|transferred|retired|expired|cancelled|suspended."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "certificate_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certificate Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:RenewableRecCertificate.complianceYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance year"@en ;
    rdfs:comment "Calendar year for which this REC was retired to meet RPS compliance obligations. May differ from vintage year due to banking or forward compliance rules."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:int ;
    cmm:physicalColumn "compliance_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Year" ;
    cmm:cimDatatype "Integer" .
cmm:RenewableRecCertificate.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this REC record was first created in the internal system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RenewableRecCertificate.curtailmentMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment mwh"@en ;
    rdfs:comment "Amount of renewable generation that was curtailed (not delivered to grid) during the generation period due to grid constraints or economic dispatch. Subtracted from gross generation to determine net REC-eligible generation."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "curtailment_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RenewableRecCertificate.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or registry API from which this REC data was ingested. Examples: WREGIS API, M-RETS API, manual entry, internal generation system."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.eligibilityFlags a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility flags"@en ;
    rdfs:comment "Comma-separated list of eligibility attributes for this REC, such as tier classification (Tier I, Tier II), solar carve-out eligibility, new facility status, or other state-specific program qualifications."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligibility_flags" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Flags" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date after which the REC can no longer be used for compliance or voluntary claims. Typically 3-5 years from vintage year depending on state rules."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:RenewableRecCertificate.facilityCommercialOperationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility commercial operation date"@en ;
    rdfs:comment "Date when the generation facility began commercial operation. Used to determine new vs. existing facility status for RPS tier classification."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "facility_commercial_operation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Commercial Operation Date" ;
    cmm:cimDatatype "Date" .
cmm:RenewableRecCertificate.facilityCounty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility county"@en ;
    rdfs:comment "County or equivalent administrative region where the generation facility is located. Used for local content and economic development tracking."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_county" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Facility County" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TownDetail.section .
cmm:RenewableRecCertificate.facilityState a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility state"@en ;
    rdfs:comment "Two-letter US state code or three-letter country code where the generation facility is located. Used for determining RPS eligibility and geographic tracking."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_state" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Facility State" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:RenewableRecCertificate.generationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation end date"@en ;
    rdfs:comment "End date of the generation period during which the renewable electricity represented by this REC was produced."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "generation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation End Date" ;
    cmm:cimDatatype "Date" .
cmm:RenewableRecCertificate.generationMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation mwh"@en ;
    rdfs:comment "Quantity of renewable electricity generation represented by this REC, measured in megawatt-hours. Each REC typically represents 1 MWh of renewable generation injected into the grid."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "generation_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RenewableRecCertificate.generationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation start date"@en ;
    rdfs:comment "Start date of the generation period during which the renewable electricity represented by this REC was produced."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "generation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RenewableRecCertificate.gridInjectionPoint a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid injection point"@en ;
    rdfs:comment "Point of interconnection (POI) identifier where the renewable generation was injected into the transmission or distribution grid. Used for locational tracking and grid impact analysis."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "grid_injection_point" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grid Injection Point" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.issuanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuance date"@en ;
    rdfs:comment "Date on which the REC was officially issued by the registry and became available for trading or retirement."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "issuance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuance Date" ;
    cmm:cimDatatype "Date" .
cmm:RenewableRecCertificate.issuingRegistry a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing registry"@en ;
    rdfs:comment "Name of the regional or national registry that issued and tracks this REC. WREGIS: Western Renewable Energy Generation Information System; M-RETS: Midwest Renewable Energy Tracking System; PJM-GATS: PJM Generation Attribute Tracking System; NAR: North American Renewables Registry; NEPOOL-GIS: New England Power Pool Generation Information System; ERCOT: Electric Reliability Council of Texas; MIRECS: Michigan Renewable Energy Certification System. Reference-value candidates: WREGIS|M-RETS|PJM-GATS|NAR|NEPOOL-GIS|ERCOT|MIRECS."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_registry" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Registry" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this REC record was last updated in the internal system. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RenewableRecCertificate.marketValueUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market value usd"@en ;
    rdfs:comment "Estimated or actual market value of this REC in US dollars at the time of issuance or most recent valuation. Used for financial reporting and portfolio valuation."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "market_value_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Value United States Dollar (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RenewableRecCertificate.nameplateCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity mw"@en ;
    rdfs:comment "Maximum rated electrical output capacity of the generation facility in megawatts at the time of REC issuance. Used for facility classification and program eligibility."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nameplate Capacity Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:RenewableRecCertificate.netMeteringFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering flag"@en ;
    rdfs:comment "Indicates whether the generation represented by this REC came from a behind-the-meter (BTM) net metering facility. True if NEM generation; False if utility-scale or non-NEM DER."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "net_metering_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RenewableRecCertificate.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "Date on which the REC was retired and removed from circulation. Null if the REC has not been retired."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:RenewableRecCertificate.retirementReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement reason"@en ;
    rdfs:comment "Business reason for retiring the REC. RPS Compliance: used to meet state renewable portfolio standard obligations; Voluntary Green Power: customer voluntary renewable energy program; Export Compliance: retired for out-of-state RPS; Corporate Sustainability: retired for corporate renewable energy goals; Carbon Offset: retired for carbon neutrality claims."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "retirement_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retirement Reason" ;
    cmm:validValues "rps_compliance|voluntary_green_power|export_compliance|corporate_sustainability|carbon_offset" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.rpsObligationPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps obligation period"@en ;
    rdfs:comment "The compliance period (typically a calendar year or program year) for which this REC is being applied toward RPS obligations. Format: YYYY or YYYY-YYYY for multi-year periods."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "rps_obligation_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Obligation Period" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.technologyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technology type"@en ;
    rdfs:comment "Type of renewable energy technology used to generate the electricity. Solar PV: photovoltaic solar; Wind: onshore or offshore wind turbines; Hydroelectric: run-of-river or reservoir hydro; Biomass: organic material combustion; Geothermal: earth heat; Landfill Gas: methane capture."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "technology_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technology Type" ;
    cmm:validValues "solar_pv|wind|hydroelectric|biomass|geothermal|landfill_gas" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.tradingPlatform a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading platform"@en ;
    rdfs:comment "Name of the electronic trading platform or bilateral agreement mechanism through which this REC was last traded. Examples: Marex Spectron, Evolution Markets, bilateral OTC."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:string ;
    cmm:physicalColumn "trading_platform" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trading Platform" ;
    cmm:cimDatatype "String" .
cmm:RenewableRecCertificate.transferHistoryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transfer history count"@en ;
    rdfs:comment "Number of times this REC has been transferred between accounts since issuance. Used for audit trail and market activity analysis."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:int ;
    cmm:physicalColumn "transfer_history_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transfer History Count" ;
    cmm:cimDatatype "Integer" .
cmm:RenewableRecCertificate.vintageYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vintage year"@en ;
    rdfs:comment "Calendar year in which the renewable electricity was generated. Used for RPS compliance tracking and market valuation, as some programs require current or recent vintage RECs."@en ;
    rdfs:domain cmm:RenewableRecCertificate ; rdfs:range xsd:int ;
    cmm:physicalColumn "vintage_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vintage Year" ;
    cmm:cimDatatype "Integer" .

cmm:RpsObligation a owl:Class ;
    rdfs:label "Rps Obligation"@en ;
    rdfs:comment "Renewable Portfolio Standard (RPS) compliance obligation and running position record per compliance period and state jurisdiction. Captures the regulatory target (obligated retail sales MWh, required renewable percentage, technology-specific carve-outs for solar/offshore wind/storage, ACP rate) and the running compliance position against that target (RECs retired to date, RECs in inventory, projected shortfall or surplus MWh, compliance percentage achieved, last reconciliation timestamp). Includes compliance deadline, filing status, and alternative compliance payment exposure. SSOT for RPS obligation targets AND compliance position tracking within the renewable domain — no separate position product exists. Feeds regulatory filings to state PUCs and internal compliance dashboards."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.contract_administration ;
    cmm:physicalTable "utility_cmm_silver.renewable.rps_obligation" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "State PUC RPS Compliance Filing / FERC RPS Reporting" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.rps_obligation" ;
    owl:hasKey ( cmm:RpsObligation.rpsObligationId ) .

cmm:RpsObligation.rpsObligationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps obligation id"@en ;
    rdfs:comment "Unique identifier for the RPS compliance obligation record. Primary key for the RPS obligation entity."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:long ;
    cmm:physicalColumn "rps_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Obligation ID" ;
    cmm:cimDatatype "Integer" .
cmm:RpsObligation.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: RPS compliance obligations drive renewable capacity targets in IRP scenarios. Scenarios model pathways to meet RPS requirements, including capacity additions, REC procurement, and ACP exposure."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_rps_obligation_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RpsObligation.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: RPS obligations are regulatory compliance obligations under state renewable portfolio standards. Links RPS-specific tracking to enterprise compliance framework. Essential for integrated compliance man"@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_rps_obligation_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RpsObligation.regulatoryAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset"@en ;
    rdfs:comment "Foreign key linking to finance.regulatory_asset. Business justification: RPS compliance costs (ACP payments, REC procurement above market) create regulatory assets for future rate recovery; link supports rate case filings, FERC Form 1 reporting, and amortization tracking."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range cmm:RegulatoryAsset ;
    cmm:physicalColumn "regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_rps_obligation_regulatory_asset_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RpsObligation.acpExposureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acp exposure amount"@en ;
    rdfs:comment "Total financial exposure in dollars for Alternative Compliance Payments based on projected shortfall multiplied by ACP rate. Represents potential penalty cost if shortfall is not remedied."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acp_exposure_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alternative Compliance Payment (ACP) Exposure Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RpsObligation.acpPaidAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acp paid amount"@en ;
    rdfs:comment "Actual Alternative Compliance Payment amount in dollars paid to the state for this compliance period. Null if no ACP has been paid."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acp_paid_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alternative Compliance Payment (ACP) Paid Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RpsObligation.acpRatePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acp rate per mwh"@en ;
    rdfs:comment "Regulatory penalty rate per MWh for shortfall, expressed in dollars per MWh. This is the Alternative Compliance Payment rate that the utility must pay for each MWh of unmet RPS obligation."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acp_rate_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alternative Compliance Payment (ACP) Rate per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.complianceDeadlineDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance deadline date"@en ;
    rdfs:comment "Regulatory deadline by which the utility must demonstrate full compliance with the RPS obligation for this period. Typically 3-6 months after the compliance period end date."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "compliance_deadline_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Deadline Date" ;
    cmm:cimDatatype "Date" .
cmm:RpsObligation.compliancePercentageAchieved a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance percentage achieved"@en ;
    rdfs:comment "Current compliance percentage achieved based on RECs retired to date divided by required renewable MWh, expressed as a percentage. Indicates progress toward meeting the RPS obligation."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "compliance_percentage_achieved" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Percentage Achieved" ;
    cmm:cimDatatype "Decimal" .
cmm:RpsObligation.compliancePeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance period end date"@en ;
    rdfs:comment "End date of the compliance period for this RPS obligation. Typically December 31 of the compliance year."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "compliance_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:RpsObligation.compliancePeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance period start date"@en ;
    rdfs:comment "Start date of the compliance period for this RPS obligation. Typically January 1 of the compliance year."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "compliance_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RpsObligation.compliancePeriodYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance period year"@en ;
    rdfs:comment "Calendar year for which this RPS obligation applies. RPS compliance is typically measured annually or over multi-year periods."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:int ;
    cmm:physicalColumn "compliance_period_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Period Year" ;
    cmm:cimDatatype "Integer" .
cmm:RpsObligation.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current status of the RPS obligation compliance. In_progress indicates the compliance period is active; compliant indicates full compliance achieved; shortfall indicates projected or actual deficit; surplus indicates excess compliance; filed indicates compliance report submitted; under_review indicates regulatory review in progress."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:validValues "in_progress|compliant|shortfall|surplus|filed|under_review" ;
    cmm:cimDatatype "String" .
cmm:RpsObligation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this RPS obligation record was first created in the system. Audit field for data lineage."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RpsObligation.filingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing status"@en ;
    rdfs:comment "Status of the regulatory compliance filing to the state PUC. Not_filed indicates no filing yet; draft indicates filing in preparation; submitted indicates filing delivered to regulator; accepted indicates regulator approval; rejected indicates regulator rejection; amended indicates revised filing submitted."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filing Status" ;
    cmm:validValues "not_filed|draft|submitted|accepted|rejected|amended" ;
    cmm:cimDatatype "String" .
cmm:RpsObligation.filingSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing submission date"@en ;
    rdfs:comment "Date on which the RPS compliance filing was submitted to the state PUC. Null if not yet filed."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filing Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:RpsObligation.jurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jurisdiction code"@en ;
    rdfs:comment "Two-letter state code identifying the regulatory jurisdiction imposing the RPS obligation (e.g., CA for California, NY for New York, MA for Massachusetts)."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Jurisdiction Code" ;
    cmm:valuePattern "^[A-Z]{2}$" ;
    cmm:cimDatatype "String" .
cmm:RpsObligation.lastReconciliationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last reconciliation timestamp"@en ;
    rdfs:comment "Timestamp of the most recent reconciliation of the RPS compliance position. Indicates when RECs retired, inventory, and shortfall/surplus calculations were last updated."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_reconciliation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Reconciliation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RpsObligation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes capturing additional context, assumptions, or special circumstances related to this RPS obligation. May include details on carve-out strategies, banking decisions, or regulatory correspondence."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Compliance Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:RpsObligation.obligatedRetailSalesMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligated retail sales mwh"@en ;
    rdfs:comment "Total retail electricity sales in MWh subject to the RPS obligation for this compliance period. This is the base quantity against which the renewable percentage requirement is applied."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "obligated_retail_sales_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Obligated Retail Sales Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.offshoreWindCarveoutMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offshore wind carveout mwh"@en ;
    rdfs:comment "Absolute quantity of offshore wind energy in MWh required to meet the offshore wind carve-out. Null if no offshore wind carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "offshore_wind_carveout_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offshore Wind Carve-Out Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.offshoreWindCarveoutPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offshore wind carveout percentage"@en ;
    rdfs:comment "Technology-specific carve-out percentage requiring a minimum portion of the RPS obligation to be met with offshore wind generation. Null if no offshore wind carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "offshore_wind_carveout_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offshore Wind Carve-Out Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RpsObligation.projectedShortfallMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "projected shortfall mwh"@en ;
    rdfs:comment "Projected shortfall in MWh between the required renewable MWh and the sum of RECs retired plus RECs in inventory. Positive value indicates a deficit; null or zero indicates compliance is on track or surplus exists."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "projected_shortfall_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Projected Shortfall Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.projectedSurplusMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "projected surplus mwh"@en ;
    rdfs:comment "Projected surplus in MWh beyond the required renewable MWh. Positive value indicates excess RECs available for banking or future compliance periods; null or zero indicates no surplus."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "projected_surplus_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Projected Surplus Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.reconciliationFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation frequency"@en ;
    rdfs:comment "Frequency at which the RPS compliance position is reconciled and updated. Indicates how often the running position is refreshed."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reconciliation_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Frequency" ;
    cmm:validValues "daily|weekly|monthly|quarterly|annual" ;
    cmm:cimDatatype "String" .
cmm:RpsObligation.recsInventoryMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recs inventory mwh"@en ;
    rdfs:comment "Quantity of RECs in MWh currently held in inventory and available for retirement toward this compliance period. Represents banked RECs not yet applied."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recs_inventory_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificates (RECs) Inventory Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.recsRetiredMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recs retired mwh"@en ;
    rdfs:comment "Total quantity of RECs in MWh that have been retired to date for this compliance period. This is the running compliance position representing actual compliance achieved."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "recs_retired_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificates (RECs) Retired Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.requiredRenewableMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required renewable mwh"@en ;
    rdfs:comment "Absolute quantity of renewable energy in MWh required to meet the RPS obligation. Calculated as obligated_retail_sales_mwh multiplied by required_renewable_percentage."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "required_renewable_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Renewable Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.requiredRenewablePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required renewable percentage"@en ;
    rdfs:comment "Mandated percentage of retail sales that must be served by renewable energy sources for this compliance period. Expressed as a percentage (e.g., 33.00 for 33%)."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "required_renewable_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Renewable Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RpsObligation.responsiblePartyName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible party name"@en ;
    rdfs:comment "Name of the internal business unit or individual responsible for managing this RPS obligation and ensuring compliance."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_party_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Party Name" ;
    cmm:cimDatatype "String" .
cmm:RpsObligation.rpsRecRetirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps rec retirement"@en ;
    rdfs:comment "FK to renewable.rec_certificate.rec_certificate_id — RPS obligations are satisfied by retiring RECs. The compliance position tracks RECs retired against the obligation. This FK is essential for compliance reconciliation and regulatory reporting."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:long ;
    cmm:physicalColumn "rps_rec_retirement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:RpsObligation.solarCarveoutMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solar carveout mwh"@en ;
    rdfs:comment "Absolute quantity of solar energy in MWh required to meet the solar carve-out. Null if no solar carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "solar_carveout_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solar Carve-Out Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.solarCarveoutPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solar carveout percentage"@en ;
    rdfs:comment "Technology-specific carve-out percentage requiring a minimum portion of the RPS obligation to be met with solar generation. Null if no solar carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "solar_carveout_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solar Carve-Out Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RpsObligation.storageCarveoutMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage carveout mwh"@en ;
    rdfs:comment "Absolute quantity of energy storage in MWh required to meet the storage carve-out. Null if no storage carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "storage_carveout_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Storage Carve-Out Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RpsObligation.storageCarveoutPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage carveout percentage"@en ;
    rdfs:comment "Technology-specific carve-out percentage requiring a minimum portion of the RPS obligation to be met with energy storage systems. Null if no storage carve-out applies."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "storage_carveout_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Storage Carve-Out Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:RpsObligation.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this RPS obligation record was last modified. Audit field for data lineage and change tracking."@en ;
    rdfs:domain cmm:RpsObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:PpaContract a owl:Class ;
    rdfs:label "Ppa Contract"@en ;
    rdfs:comment "Power Purchase Agreement (PPA) master record for renewable energy procurement contracts between the utility and independent power producers (IPPs) or project developers. Captures counterparty, contracted capacity (MW), energy volume (MWh/year), contract term, pricing structure (fixed, indexed, escalating), delivery point (POI/PNode), REC ownership and transfer terms, curtailment provisions, force majeure clauses, FERC filing reference, and contract status. SSOT boundary: scoped ONLY to renewable-source PPAs where REC ownership, renewable attributes, and RPS compliance are integral contract terms. Conventional/thermal PPAs, tolling agreements, and wholesale trading contracts are managed in the trading domain. Cross-domain SSOT adjudication pending with global architect."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.contract_administration ;
    cmm:physicalTable "utility_cmm_silver.renewable.ppa_contract" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC OATT / NAESB PPA Standard / OpenLink Endur Contract" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.ppa_contract" ;
    owl:hasKey ( cmm:PpaContract.ppaContractId ) .

cmm:PpaContract.ppaContractId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ppa contract id"@en ;
    rdfs:comment "Primary key for ppa_contract"@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:long ;
    cmm:physicalColumn "ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Ppa Contract Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PpaContract.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: PPAs finance renewable generation projects; linking contract to capex project enables rate base inclusion tracking, regulatory cost recovery filings, and FERC reporting of contracted generation assets"@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_contract_capex_project_id" ;
    cmm:cimAssociation "Agreement.Project" .
cmm:PpaContract.contractManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contract manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Power purchase agreements require designated contract managers for negotiation, execution, amendment tracking, and ongoing administration. Essential for accountability in multi-million dollar renewabl"@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "contract_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contract Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_contract_contract_manager_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:PpaContract.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Reference to the independent power producer (IPP), project developer, or renewable energy supplier that is the counterparty to this PPA contract."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_contract_counterparty_id" ;
    cmm:cimAssociation "Agreement.MarketParticipant" .
cmm:PpaContract.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: PPA contracts reference forward price forecasts for contract valuation, hedging strategy development, and financial risk assessment. Critical for procurement and portfolio management decisions."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Valuation Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_contract_energy_price_id" ;
    cmm:cimAssociation "Agreement.RegularIntervalSchedule" .
cmm:PpaContract.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: PPAs often require FERC or state PUC approval filings. Utilities must track which regulatory filing authorized each contract for compliance and audit purposes. Standard practice in regulated markets f"@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_contract_regulatory_filing_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:PpaContract.basePricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base price per mwh"@en ;
    rdfs:comment "Base energy price in USD per MWh at contract inception, before escalation or indexing adjustments. Business-confidential pricing term."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Price per Megawatt-Hour (MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PpaContract.capacityFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity factor percent"@en ;
    rdfs:comment "Expected or contracted capacity factor (ratio of actual output to maximum possible output) expressed as a percentage, used for forecasting and performance evaluation."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Factor (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PpaContract.contractAmendmentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract amendment count"@en ;
    rdfs:comment "Number of amendments or modifications made to the original PPA contract since execution."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:int ;
    cmm:physicalColumn "contract_amendment_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Amendment Count" ;
    cmm:cimDatatype "Integer" .
cmm:PpaContract.contractExecutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract execution date"@en ;
    rdfs:comment "Date when the PPA contract was signed and executed by both parties."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_execution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Execution Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaContract.contractName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract name"@en ;
    rdfs:comment "Human-readable name or title of the PPA contract, typically referencing the project or facility name."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Contract Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:PpaContract.contractNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract notes"@en ;
    rdfs:comment "Free-text field for additional notes, comments, or special conditions related to the PPA contract."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:PpaContract.contractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract number"@en ;
    rdfs:comment "Externally-known business identifier for the PPA contract, used in legal documents, regulatory filings, and counterparty communications."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PpaContract.contractStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract status"@en ;
    rdfs:comment "Current lifecycle status of the PPA contract: draft (under negotiation), pending approval (awaiting internal or regulatory approval), active (in force), suspended (temporarily halted), terminated (ended early), or expired (reached end of term)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Status" ;
    cmm:validValues "draft|pending_approval|active|suspended|terminated|expired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:PpaContract.contractTermYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract term years"@en ;
    rdfs:comment "Total duration of the PPA contract in years from effective start date to effective end date."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:int ;
    cmm:physicalColumn "contract_term_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Term (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:PpaContract.contractType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract type"@en ;
    rdfs:comment "Classification of the PPA pricing structure: fixed price (flat rate), indexed (tied to market index), escalating (annual increases), hybrid (combination), or tolling (capacity payment plus energy)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Type" ;
    cmm:validValues "fixed_price|indexed|escalating|hybrid|tolling" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.type .
cmm:PpaContract.contractedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted capacity mw"@en ;
    rdfs:comment "Maximum generation capacity in megawatts (MW) that the counterparty is obligated to make available under this PPA contract."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PpaContract.contractedEnergyVolumeMwhAnnual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted energy volume mwh annual"@en ;
    rdfs:comment "Total annual energy volume in megawatt-hours (MWh) that the utility commits to purchase under this PPA contract."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_energy_volume_mwh_annual" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Energy Volume (MWh) Annual" ;
    cmm:cimDatatype "Decimal" .
cmm:PpaContract.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this PPA contract record was first created in the system."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:PpaContract.curtailmentCompensationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment compensation flag"@en ;
    rdfs:comment "Indicates whether the counterparty is entitled to compensation for curtailed energy (True) or not (False)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "curtailment_compensation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Compensation Flag" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "Boolean" .
cmm:PpaContract.curtailmentProvision a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment provision"@en ;
    rdfs:comment "Contractual terms allowing the utility to curtail (reduce or halt) energy delivery from the renewable facility due to grid constraints, oversupply, or operational needs, including compensation or penalty terms."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "curtailment_provision" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Provision" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.deliveryPointPoi a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery point poi"@en ;
    rdfs:comment "Physical location or substation where energy is delivered from the renewable facility to the utility grid, also known as the Point of Interconnection (POI)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "delivery_point_poi" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Point / Point of Interconnection (POI)" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when the PPA contract term expires and energy delivery obligations cease. Nullable for open-ended or evergreen contracts."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:PpaContract.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when the PPA contract becomes legally binding and energy delivery obligations commence."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:PpaContract.fercFilingReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc filing reference"@en ;
    rdfs:comment "Reference number or docket ID for the FERC filing associated with this PPA contract, if applicable for wholesale market transactions."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_filing_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Filing Reference" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.forceMajeureClause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "force majeure clause"@en ;
    rdfs:comment "Legal clause defining events beyond the control of either party (natural disasters, regulatory changes, grid failures) that excuse non-performance without penalty."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "force_majeure_clause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Force Majeure Clause" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.generationSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation source"@en ;
    rdfs:comment "Type of renewable energy resource covered by this PPA: solar (photovoltaic or thermal), wind (onshore or offshore), hydro (run-of-river or reservoir), battery storage (energy storage system), biomass, or geothermal."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "generation_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Source" ;
    cmm:validValues "solar|wind|hydro|battery_storage|biomass|geothermal" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.lastAmendmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last amendment date"@en ;
    rdfs:comment "Date of the most recent amendment or modification to the PPA contract. Nullable if no amendments have been made."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_amendment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Amendment Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaContract.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this PPA contract record was last updated in the system."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PpaContract.minimumDeliveryObligationMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum delivery obligation mwh"@en ;
    rdfs:comment "Minimum annual energy volume in MWh that the counterparty must deliver to avoid penalties or contract breach."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_delivery_obligation_mwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Delivery Obligation (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PpaContract.performanceGuaranteeTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance guarantee terms"@en ;
    rdfs:comment "Contractual terms specifying performance guarantees, including availability targets, capacity factor commitments, and associated liquidated damages or penalties for underperformance."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_guarantee_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Guarantee Terms" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.priceEscalationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "price escalation rate percent"@en ;
    rdfs:comment "Annual percentage rate at which the energy price escalates over the contract term. Null for fixed-price contracts. Business-confidential pricing term."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "price_escalation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Price Escalation Rate (Percent)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PpaContract.priceIndexReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "price index reference"@en ;
    rdfs:comment "Name of the market index or benchmark to which the PPA price is tied (e.g., Locational Marginal Price (LMP) at specific PNode, CPI, natural gas index). Null for fixed-price contracts."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "price_index_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Price Index Reference" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.pricingNodePnode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pricing node pnode"@en ;
    rdfs:comment "Specific pricing node (PNode) in the Regional Transmission Organization (RTO) or Independent System Operator (ISO) market used for settlement and Locational Marginal Price (LMP) determination."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "pricing_node_pnode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode)" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.recOwnership a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec ownership"@en ;
    rdfs:comment "Specifies which party owns the Renewable Energy Certificates (RECs) generated by the facility: utility (utility retains RECs for RPS compliance), counterparty (IPP retains RECs), shared (split between parties), or unbundled (RECs sold separately)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "rec_ownership" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Ownership" ;
    cmm:validValues "utility|counterparty|shared|unbundled" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.recTransferTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec transfer terms"@en ;
    rdfs:comment "Detailed terms governing the transfer, retirement, and tracking of RECs, including timing, registry requirements, and compliance obligations."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "rec_transfer_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Transfer Terms" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.regulatoryApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory approval date"@en ;
    rdfs:comment "Date when the PPA contract received required regulatory approval from the Public Utility Commission (PUC) or other governing body. Nullable if approval is not required."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "regulatory_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaContract.renewableAttributeTransfer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable attribute transfer"@en ;
    rdfs:comment "Detailed terms governing the transfer of renewable energy attributes (environmental benefits, carbon offsets, green tags) beyond RECs, including timing and compliance obligations."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "renewable_attribute_transfer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Attribute Transfer" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.rpsComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps compliance flag"@en ;
    rdfs:comment "Indicates whether this PPA contract contributes to the utility's Renewable Portfolio Standard (RPS) compliance obligations (True) or not (False)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rps_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PpaContract.rpsJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps jurisdiction"@en ;
    rdfs:comment "State or regulatory jurisdiction whose RPS requirements this PPA contract helps satisfy (e.g., California, New York, Texas)."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "rps_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.settlementFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement frequency"@en ;
    rdfs:comment "Frequency at which energy delivery and payments are settled between the utility and counterparty: monthly, quarterly, or annual."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Frequency" ;
    cmm:validValues "monthly|quarterly|annual" ;
    cmm:cimDatatype "String" .
cmm:PpaContract.terminationClause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination clause"@en ;
    rdfs:comment "Contractual terms under which either party may terminate the PPA early, including notice periods, breach conditions, and financial penalties."@en ;
    rdfs:domain cmm:PpaContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_clause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Clause" ;
    cmm:cimDatatype "String" .

cmm:PpaSettlement a owl:Class ;
    rdfs:label "Ppa Settlement"@en ;
    rdfs:comment "Monthly or periodic financial settlement record for each active renewable PPA contract. Captures settlement period, metered generation (MWh), contracted price ($/MWh), settlement amount ($), curtailment adjustments (MWh and $), imbalance charges, REC transfer confirmation, invoice reference, payment status, and dispute flags. SSOT boundary: scoped ONLY to renewable PPA settlements where REC transfer and curtailment credit calculations are integral. Wholesale market settlements and conventional contract settlements are managed in the trading domain. Cross-domain SSOT adjudication pending with global architect."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:Settlement ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC62325::MarketResults" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.contract_administration ;
    cmm:physicalTable "utility_cmm_silver.renewable.ppa_settlement" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OpenLink Endur Settlement / NAESB Business Practice" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.ppa_settlement" ;
    owl:hasKey ( cmm:PpaSettlement.ppaSettlementId ) .

cmm:PpaSettlement.ppaSettlementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ppa settlement id"@en ;
    rdfs:comment "Primary key for ppa_settlement"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:long ;
    cmm:physicalColumn "ppa_settlement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Ppa Settlement Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PpaSettlement.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Reference to the counterparty entity (renewable generator, independent power producer, or purchasing utility) involved in this PPA settlement."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_counterparty_id" ;
    cmm:cimAssociation "Settlement.MarketParticipant" .
cmm:PpaSettlement.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Reference to the renewable generation facility (wind farm, solar array, hydro plant, battery storage) that produced the generation for this settlement."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_der_registry_id" ;
    cmm:cimAssociation "Settlement.PowerElectronicsConnection" .
cmm:PpaSettlement.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: PPA settlements reference market price forecasts for imbalance charge calculation, curtailment credit valuation, and contract performance assessment. Required for accurate financial settlement and rep"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Market Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_energy_price_id" ;
    cmm:cimAssociation "Settlement.RegularIntervalSchedule" .
cmm:PpaSettlement.forceMajeureOutageEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "force majeure outage event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: PPA settlements account for curtailment and unavailability caused by grid outages under force majeure provisions. Counterparties dispute settlement amounts when outages prevent contracted delivery. Re"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "force_majeure_outage_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Force Majeure Outage Event Id (Foreign Key)" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_force_majeure_outage_event_id" ;
    cmm:cimAssociation "Settlement.Outage" .
cmm:PpaSettlement.journalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "journal entry"@en ;
    rdfs:comment "Foreign key linking to finance.journal_entry. Business justification: Every PPA settlement generates GL entries for energy revenue, REC transfers, curtailment credits, and transmission charges; direct link enables automated posting, audit trail, and SOX compliance for r"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Journal Entry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_journal_entry_id" ;
    cmm:cimAssociation "Settlement.ErpJournal" .
cmm:PpaSettlement.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to metering.meter. Business justification: PPA settlements require metered generation from specific revenue meters at generation facilities. Monthly PPA invoice reconciliation and dispute resolution link settlement calculations to source meter"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_meter_id" ;
    cmm:cimAssociation "Settlement.Meter" .
cmm:PpaSettlement.originalSettlementPpaSettlement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original settlement ppa settlement"@en ;
    rdfs:comment "Reference to the original settlement record if this is an adjustment settlement. Null for original settlements."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:PpaSettlement ;
    cmm:physicalColumn "original_settlement_ppa_settlement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Settlement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_original_settlement_ppa_settlement_id" ;
    cmm:cimAssociation "Settlement.Settlement" .
cmm:PpaSettlement.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: PPA settlements require metered generation data from the renewable power plant to calculate invoice amounts, reconcile contracted vs. actual delivery, and resolve disputes over curtailment credits or"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_power_plant_id" ;
    cmm:cimAssociation "Settlement.Plant" .
cmm:PpaSettlement.ppaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa contract"@en ;
    rdfs:comment "FK to renewable.ppa_contract.ppa_contract_id — Each PPA settlement record is for a specific PPA contract. This is a classic header-line relationship. Without this FK, settlements cannot be reconciled to contracts."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_ppa_contract_id" ;
    cmm:cimAssociation "Settlement.Agreement" .
cmm:PpaSettlement.primaryPpaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary ppa contract"@en ;
    rdfs:comment "Reference to the parent renewable PPA contract under which this settlement is executed."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "primary_ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Purchase Agreement (PPA) Contract ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_primary_ppa_contract_id" ;
    cmm:cimAssociation "Settlement.Agreement" .
cmm:PpaSettlement.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: PPA settlements for utility-owned generation reference the physical asset for cost allocation, depreciation matching, and FERC compliance reporting. Asset-specific PPAs require direct linkage for regu"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_registry_id" ;
    cmm:cimAssociation "Settlement.Asset" .
cmm:PpaSettlement.settlementAnalystEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "settlement analyst employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: PPA settlements require energy analysts to reconcile metered generation against contracted volumes, calculate curtailment credits, and resolve invoice disputes. Tracks analyst for settlement accuracy,"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "settlement_analyst_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Settlement Analyst Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_settlement_analyst_employee_id" ;
    cmm:cimAssociation "Settlement.ErpPersonnel" .
cmm:PpaSettlement.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to supply.vendor. Business justification: PPA counterparties are registered as vendors for accounts payable processing, payment terms management, and vendor performance evaluation. Real business process: invoice verification, payment processi"@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vendor Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_ppa_settlement_vendor_id" ;
    cmm:cimAssociation "Settlement.Organisation" .
cmm:PpaSettlement.adjustmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment flag"@en ;
    rdfs:comment "Boolean flag indicating whether this settlement record is an adjustment to a previously finalized settlement."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "adjustment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PpaSettlement.adjustmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment reason"@en ;
    rdfs:comment "Description of the reason for the settlement adjustment, such as meter data correction, contract amendment, or billing error correction."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjustment Reason" ;
    cmm:cimDatatype "String" .
cmm:PpaSettlement.ancillaryServicesChargeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary services charge amount"@en ;
    rdfs:comment "Charges in dollars for ancillary services (regulation, spinning reserves, voltage support) allocated to this settlement period."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ancillary_services_charge_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Services Charge Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PpaSettlement.availabilityPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "availability percent"@en ;
    rdfs:comment "Facility availability percentage during the settlement period, representing the proportion of time the facility was available for generation."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "availability_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Availability Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PpaSettlement.capacityFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity factor percent"@en ;
    rdfs:comment "Capacity factor percentage for the renewable facility during the settlement period, calculated as actual generation divided by maximum potential generation."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Factor Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PpaSettlement.contractedPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted price per mwh"@en ;
    rdfs:comment "The contracted unit price in dollars per MWh as specified in the PPA contract for this settlement period. May vary by time-of-use or seasonal schedules."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Price per Megawatt-Hour (MWh)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PpaSettlement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this settlement record was first created in the system."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Settlement.createdDateTime .
cmm:PpaSettlement.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this settlement record."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:validValues "USD|CAD|MXN" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:PpaSettlement.curtailmentCreditAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
