    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inverter Manufacturer" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.inverterModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter model"@en ;
