    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:MessageTemplate.name a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "name"@en ;
