    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Capacity Additions MVA" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:SubstationScenarioPlan.plannedTransformerUpgrades a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned transformer upgrades"@en ;
    rdfs:comment "Description of planned transformer bank upgrades or replacements for this substation in this scenario (e.g., 'Add third 10MVA transformer', 'Replace aging 33/11kV bank', 'None')."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "planned_transformer_upgrades" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Transformer Upgrades" ;
