cmm:CapexExpenditure.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this capital expenditure record was last updated or modified. Used for change tracking and audit trail."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
