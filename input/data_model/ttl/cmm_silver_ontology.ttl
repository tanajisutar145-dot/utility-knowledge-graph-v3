cmm:JobRequisition.requisitionApprovedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition approved date"@en ;
    rdfs:comment "Date when the requisition received final approval and was authorized to proceed with recruitment. Null if still pending or rejected."@en ;
