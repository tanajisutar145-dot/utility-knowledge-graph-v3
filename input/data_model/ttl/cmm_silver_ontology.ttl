cmm:DrAggregator.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Geographic service territory or jurisdiction where the aggregator is authorized to operate and aggregate customer demand response load."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
