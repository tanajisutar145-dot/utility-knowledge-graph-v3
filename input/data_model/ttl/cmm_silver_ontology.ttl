cmm:RateSchedule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this rate schedule record was first created in the billing system."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:dateTime ;
