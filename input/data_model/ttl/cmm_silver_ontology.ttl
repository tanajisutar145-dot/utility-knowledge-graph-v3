cmm:ContractorCompany.bankAccountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank account number"@en ;
    rdfs:comment "Primary bank account number used for payments to the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_account_number" ;
