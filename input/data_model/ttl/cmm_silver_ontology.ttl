    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Plant Unit Identifier" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.pollutantType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pollutant type"@en ;
    rdfs:comment "The type of pollutant being reported: SO2 (Sulfur Dioxide), NOx (Nitrogen Oxides), CO2 (Carbon Dioxide), Mercury, PM2.5 (Particulate Matter 2.5 micrometers), or PM10 (Particulate Matter 10 micrometers)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
