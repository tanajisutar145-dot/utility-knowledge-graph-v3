cmm:BillingServiceAgreement.lifeSupportFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support flag"@en ;
    rdfs:comment "Indicates whether the premise has registered life support medical equipment requiring continuous power. Provides regulatory protection from disconnection."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "life_support_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life Support Equipment Flag" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.loadProfileType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile type"@en ;
    rdfs:comment "Classification of the customer load profile and associated rate structure. Determines whether Time of Use, Critical Peak Pricing, or Real Time Pricing applies."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
