cmm:ControlAreaObligation.responsiblePerson a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible person"@en ;
    rdfs:comment "Name or employee identifier of the individual responsible for ensuring compliance with this obligation for this specific control area."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_person" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
