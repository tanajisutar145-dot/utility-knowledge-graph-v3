cmm:ContingencyAnalysisRun a owl:Class ;
    rdfs:label "Contingency Analysis Run"@en ;
    rdfs:comment "Transactional record of each EMS contingency analysis (CA) execution. Captures run timestamp, parent state_estimation_run reference, number of contingencies evaluated, number of violations detected (thermal, voltage), worst-case contingency identifier, solution method (full AC / linear DC), and operator acknowledgment status. Supports NERC TPL compliance evidence and real-time operator situational awareness. Runs are triggered automatically after each converged state estimator solution."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.contingency_analysis_run" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EMS Contingency Analysis / NERC TPL-001" ;
    cmm:sourceObject "energy_utilities_ecm.grid.contingency_analysis_run" ;
    owl:hasKey ( cmm:ContingencyAnalysisRun.contingencyAnalysisRunId ) .

cmm:ContingencyAnalysisRun.contingencyAnalysisRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis run id"@en ;
    rdfs:comment "Unique identifier for each contingency analysis execution. Primary key for the contingency analysis run record."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "contingency_analysis_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contingency Analysis (CA) Run Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the control area or balancing authority area for which this contingency analysis was executed."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:ContingencyAnalysisRun.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Contingency analysis is performed by specific grid operations teams whose costs are tracked in cost centers. Needed for activity-based costing of reliability analysis work, NERC compliance cost tracki"@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_cost_center_id" ;
    cmm:cimAssociation "ActivityRecord.Organisation" .
cmm:ContingencyAnalysisRun.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Contingency analysis detecting thermal/voltage violations may trigger emergency material deployment for corrective action schemes (capacitor banks, reactors, mobile transformers). Links analysis run t"@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_emergency_stock_event_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ContingencyAnalysisRun.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User identifier of the system operator who acknowledged the contingency analysis results. Used for audit trail and compliance documentation."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator User Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ContingencyAnalysisRun.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: NERC TPL-001/TPL-002 standards mandate contingency analysis for transmission planning. Each analysis run must be traceable to the specific NERC obligation it satisfies for audit evidence and complianc"@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_obligation_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:ContingencyAnalysisRun.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Reference to the parent state estimator solution that triggered this contingency analysis. Each CA run is executed after a converged state estimation solution."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimation Run Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_state_estimation_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ContingencyAnalysisRun.worstCaseContingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "worst case contingency"@en ;
    rdfs:comment "Identifier of the contingency scenario that produced the most severe violations or highest risk to system reliability in this analysis run."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "worst_case_contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Worst Case Contingency Identifier" ;
    cmm:sourceColumn "contingency_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_analysis_run_worst_case_contingency_id" ;
    cmm:cimAssociation "ActivityRecord.Contingency" .
cmm:ContingencyAnalysisRun.analysisType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis type"@en ;
    rdfs:comment "Classification of the contingency analysis execution context. Real-time runs support live operations; study mode supports planning; post-event supports incident investigation."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "analysis_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contingency Analysis Type" ;
    cmm:validValues "real_time|study_mode|post_event|training" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:ContingencyAnalysisRun.baseCaseMvarMismatch a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base case mvar mismatch"@en ;
    rdfs:comment "Total MVAR mismatch in the base case power flow solution before contingency evaluation. Indicates quality of reactive power balance in the state estimation input."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_case_mvar_mismatch" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Case Megavar (MVAR) Mismatch" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyAnalysisRun.baseCaseMwMismatch a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base case mw mismatch"@en ;
    rdfs:comment "Total MW mismatch in the base case power flow solution before contingency evaluation. Indicates quality of the state estimation input. Should be near zero for valid analysis."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_case_mw_mismatch" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Case Megawatt (MW) Mismatch" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyAnalysisRun.convergenceTolerance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "convergence tolerance"@en ;
    rdfs:comment "The numerical convergence tolerance threshold used for power flow solutions in this contingency analysis. Smaller values provide higher accuracy but longer execution time."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "convergence_tolerance" ;
    cmm:sqlDataType "DECIMAL(12,8)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Convergence Tolerance Threshold" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyAnalysisRun.correctiveActionDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action description"@en ;
    rdfs:comment "Description of recommended or required corrective actions to address violations detected in the contingency analysis. May include generation redispatch, switching orders, or load curtailment."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Description" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.correctiveActionRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action required"@en ;
    rdfs:comment "Indicates whether corrective actions are required based on the violations detected. Triggers operator response procedures when true."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "corrective_action_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyAnalysisRun.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this contingency analysis run record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:ContingencyAnalysisRun.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that generated this contingency analysis run record. Typically the EMS application name and version for data lineage tracking."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name or identifier of the EMS system that executed this contingency analysis run. Supports multi-EMS environments and system integration tracking."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.executionDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution duration seconds"@en ;
    rdfs:comment "Total elapsed time in seconds for the contingency analysis execution from initiation to completion. Critical for monitoring EMS performance and real-time operational requirements."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "execution_duration_seconds" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Duration in Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:ContingencyAnalysisRun.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this contingency analysis run record was last modified. Tracks updates to operator acknowledgment, corrective actions, or status changes."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ContingencyAnalysisRun.maxIterations a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max iterations"@en ;
    rdfs:comment "Maximum number of iterations allowed for power flow convergence in each contingency scenario. Prevents excessive computation time for non-converging cases."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "max_iterations" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Iterations Limit" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.n1ContingenciesEvaluated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "n1 contingencies evaluated"@en ;
    rdfs:comment "Number of single-element (N-1) contingencies evaluated in this run. N-1 represents loss of a single transmission element."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "n1_contingencies_evaluated" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "N-1 Contingencies Evaluated Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.n2ContingenciesEvaluated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "n2 contingencies evaluated"@en ;
    rdfs:comment "Number of double-element (N-2) contingencies evaluated in this run. N-2 represents simultaneous loss of two transmission elements."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "n2_contingencies_evaluated" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "N-2 Contingencies Evaluated Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Indicates whether this contingency analysis run meets NERC TPL compliance requirements for documentation and retention. Used for regulatory audit evidence."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyAnalysisRun.nonConvergedContingencies a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "non converged contingencies"@en ;
    rdfs:comment "Number of contingency scenarios that failed to converge within the iteration limit. Non-convergence may indicate severe system stress or numerical issues."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "non_converged_contingencies" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Converged Contingencies Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments regarding this contingency analysis run. May include operator observations, special conditions, or analysis context."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contingency Analysis Run Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ContingencyAnalysisRun.operatorAcknowledged a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator acknowledged"@en ;
    rdfs:comment "Indicates whether the system operator has reviewed and acknowledged the contingency analysis results and any violations detected."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_acknowledged" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Acknowledged Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyAnalysisRun.operatorAcknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the system operator acknowledged the contingency analysis results. Null if not yet acknowledged."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "operator_acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyAnalysisRun.piHistorianTagPrefix a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag prefix"@en ;
    rdfs:comment "Tag prefix used for storing this contingency analysis run results in the OSIsoft PI historian for operational analytics and post-event review."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag_prefix" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Prefix" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.runStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run status"@en ;
    rdfs:comment "Current execution status of the contingency analysis run. Tracks the lifecycle from initiation through completion or failure."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contingency Analysis Run Status" ;
    cmm:validValues "initiated|running|completed|failed|aborted|timeout" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:ContingencyAnalysisRun.runTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run timestamp"@en ;
    rdfs:comment "The date and time when this contingency analysis execution was initiated by the EMS system. Represents the real-world operational moment of the analysis."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "run_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Run Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyAnalysisRun.scadaSnapshotTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada snapshot timestamp"@en ;
    rdfs:comment "Timestamp of the SCADA telemetry snapshot used as input to the state estimator that preceded this contingency analysis. Establishes data lineage for compliance."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scada_snapshot_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Snapshot Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyAnalysisRun.solutionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solution method"@en ;
    rdfs:comment "The power flow calculation method used for this contingency analysis execution. Full AC provides highest accuracy; linear DC provides faster performance for screening studies."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "solution_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Solution Method" ;
    cmm:validValues "full_ac|linear_dc|fast_decoupled|hybrid" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.stabilityViolationsDetected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stability violations detected"@en ;
    rdfs:comment "Number of system stability violations detected including transient stability, voltage stability, or oscillatory stability issues."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "stability_violations_detected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stability Violations Detected Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.thermalViolationsDetected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal violations detected"@en ;
    rdfs:comment "Number of thermal overload violations detected where transmission line or transformer loading exceeds emergency ratings under contingency conditions."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "thermal_violations_detected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Thermal Violations Detected Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.totalContingenciesEvaluated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total contingencies evaluated"@en ;
    rdfs:comment "The total number of contingency scenarios evaluated during this analysis run. Includes N-1, N-2, and other credible contingencies per NERC TPL standards."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_contingencies_evaluated" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Contingencies Evaluated Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.totalViolationsDetected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total violations detected"@en ;
    rdfs:comment "Total number of reliability violations detected across all contingencies evaluated. Includes thermal overloads, voltage violations, and stability issues."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_violations_detected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Violations Detected Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.voltageViolationsDetected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violations detected"@en ;
    rdfs:comment "Number of bus voltage violations detected where voltage levels fall outside acceptable operating limits under contingency conditions."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "voltage_violations_detected" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Violations Detected Count" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyAnalysisRun.worstCaseContingencyDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "worst case contingency description"@en ;
    rdfs:comment "Human-readable description of the worst-case contingency scenario, typically describing the element(s) lost and the resulting system impact."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "worst_case_contingency_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Worst Case Contingency Description" ;
    cmm:cimDatatype "String" .
cmm:ContingencyAnalysisRun.worstCaseSeverityIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "worst case severity index"@en ;
    rdfs:comment "Numerical severity index for the worst-case contingency, typically representing the magnitude of the most severe violation (e.g., percent overload or per-unit voltage deviation)."@en ;
    rdfs:domain cmm:ContingencyAnalysisRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "worst_case_severity_index" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Worst Case Severity Index" ;
    cmm:cimDatatype "Decimal" .

cmm:ContingencyViolation a owl:Class ;
    rdfs:label "Contingency Violation"@en ;
    rdfs:comment "Individual violation record produced by a contingency analysis run for a specific contingency case. Captures the contingency reference, violated element (line, transformer, bus), violation type (thermal overload % of rating, voltage limit exceedance kV), pre-contingency and post-contingency values, applicable rating (normal/emergency/extreme), and operator corrective action status. SSOT for real-time N-1 security violations used in NERC TPL and TOP reliability reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.contingency_violation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC TPL-001 Violation Record" ;
    cmm:sourceObject "energy_utilities_ecm.grid.contingency_violation" ;
    owl:hasKey ( cmm:ContingencyViolation.contingencyViolationId ) .

cmm:ContingencyViolation.contingencyViolationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency violation id"@en ;
    rdfs:comment "Unique identifier for the contingency violation record. Primary key for the contingency violation entity."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:long ;
    cmm:physicalColumn "contingency_violation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contingency Violation ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyViolation.contingencyAnalysisRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis run"@en ;
    rdfs:comment "Reference to the parent contingency analysis execution that produced this violation. Links to the specific analysis run timestamp and configuration."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:ContingencyAnalysisRun ;
    cmm:physicalColumn "contingency_analysis_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Analysis Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_contingency_analysis_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ContingencyViolation.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Reference to the specific contingency scenario (N-1, N-2, etc.) that was simulated and resulted in this violation. Identifies the outage condition tested."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Case ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_contingency_id" ;
    cmm:cimAssociation "ActivityRecord.Contingency" .
cmm:ContingencyViolation.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the balancing authority responsible for the violated element. Identifies the operational control area where the violation occurred."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority (BA) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:ContingencyViolation.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the violated element is located. Links the violation to physical infrastructure location."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_distribution_substation_id" ;
    cmm:cimAssociation "ActivityRecord.Substation" .
cmm:ContingencyViolation.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Contingency violations requiring physical corrective action (not just redispatch) trigger emergency stock mobilization. Essential for tracking material deployment decisions, FEMA reimbursement eligibi"@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_emergency_stock_event_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ContingencyViolation.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the system operator or dispatcher who acknowledged or acted on the violation. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ContingencyViolation.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "SCADA telemetry point identifier for the violated element. Links the violation to real-time monitoring data in the SCADA system."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_violation_scada_point_id" ;
    cmm:cimAssociation "ActivityRecord.Measurement" .
cmm:ContingencyViolation.acknowledgedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledged flag"@en ;
    rdfs:comment "Indicates whether the violation alarm has been acknowledged by an operator. True if acknowledged, false if still requiring attention."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "acknowledged_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledged Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyViolation.acknowledgedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledged timestamp"@en ;
    rdfs:comment "Date and time when the violation alarm was acknowledged by an operator. Null if not yet acknowledged."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "acknowledged_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledged Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyViolation.alarmPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm priority"@en ;
    rdfs:comment "Priority level assigned to the violation alarm in the EMS operator interface. Determines visual and audible alarm presentation to operators."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.analysisModelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis model version"@en ;
    rdfs:comment "Version identifier of the power flow or stability model used for the contingency analysis. Ensures traceability of analysis results to specific model configurations."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "analysis_model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Analysis Model Version" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.contingencyCaseName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency case name"@en ;
    rdfs:comment "Human-readable name of the contingency scenario tested (e.g., 'Loss of Line 345-123', 'Generator Unit 5 Trip'). Provides operator-friendly identification of the simulated outage."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "contingency_case_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Case Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.contingencyProbability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency probability"@en ;
    rdfs:comment "Estimated probability of the contingency event occurring (0.0 to 1.0). Used for risk-based contingency ranking and prioritization."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contingency_probability" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Probability" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.correctiveActionDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action description"@en ;
    rdfs:comment "Free-text description of the corrective actions taken or planned to mitigate the violation (e.g., 'Reduce generation at Unit 3 by 50 MW', 'Open breaker at Station A')."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Description" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.correctiveActionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action status"@en ;
    rdfs:comment "Current status of operator corrective actions to resolve the violation. Tracks the lifecycle of violation mitigation from detection to resolution."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Status" ;
    cmm:validValues "pending|in_progress|completed|not_required|deferred" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.correctiveActionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action timestamp"@en ;
    rdfs:comment "Date and time when corrective action was initiated or completed by the operator. Null if no action has been taken yet."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "corrective_action_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyViolation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this violation record was first created in the system. Audit trail for record lifecycle tracking."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:ContingencyViolation.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system or application that generated this violation record (e.g., 'GE EMS', 'Siemens Spectrum PowerOn', 'OSI Monarch'). Used for data lineage and troubleshooting."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name of the EMS or contingency analysis application that generated the violation record (e.g., 'GE PSLF', 'Siemens Spectrum', 'OSI Monarch')."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this violation record was last modified. Tracks the most recent change to any field in the record."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ContingencyViolation.limitValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limit value"@en ;
    rdfs:comment "The applicable operating limit threshold that was exceeded (e.g., thermal rating in MW, voltage limit in kV). Defines the boundary of acceptable operation."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "limit_value" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limit Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.nercCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc category"@en ;
    rdfs:comment "NERC TPL planning event category classification (P0 through P7) that this contingency represents. Defines the severity and likelihood of the contingency scenario. Reference-value candidates: P0|P1|P2|P3|P4|P5|P6|P7."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Category" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for operator comments, analysis notes, or additional context about the violation. Used for post-event review and documentation."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ContingencyViolation.operatorActionRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator action required"@en ;
    rdfs:comment "Flag indicating whether immediate operator intervention is required to mitigate the violation. True if corrective action is needed, false if informational only."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_action_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Action Required" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyViolation.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name for the violated element measurement. Enables integration with PI historian for post-event analysis and trending."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI (Plant Information) Tag Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.postContingencyValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post contingency value"@en ;
    rdfs:comment "Simulated or calculated value of the monitored parameter after the contingency event. Represents the stressed system condition that triggered the violation."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_contingency_value" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Contingency Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.preContingencyValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre contingency value"@en ;
    rdfs:comment "Measured or estimated value of the monitored parameter (MW loading, voltage kV, etc.) before the contingency event. Baseline condition for comparison."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_contingency_value" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Contingency Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.ratingDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating duration minutes"@en ;
    rdfs:comment "Time duration in minutes for which the applicable rating is valid (e.g., 15-minute emergency rating, 4-hour emergency rating). Null for continuous normal ratings."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:int ;
    cmm:physicalColumn "rating_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ContingencyViolation.ratingType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating type"@en ;
    rdfs:comment "Classification of the equipment rating that was violated. Identifies whether the violation is against normal, emergency, or extreme operating limits."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "rating_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Type" ;
    cmm:validValues "normal|emergency|short_term_emergency|long_term_emergency|extreme" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.resolutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution timestamp"@en ;
    rdfs:comment "Date and time when the violation was resolved and the system returned to secure operating limits. Null if violation is still active."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "resolution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyViolation.riskScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk score"@en ;
    rdfs:comment "Calculated risk score combining violation severity, probability, and impact. Used for prioritizing violations in operator displays and reports."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "risk_score" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Score" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.timeToViolationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time to violation seconds"@en ;
    rdfs:comment "Simulated time in seconds from the contingency event initiation to the violation occurrence. Indicates how quickly the system degrades post-contingency."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:int ;
    cmm:physicalColumn "time_to_violation_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time to Violation Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:ContingencyViolation.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Unit of measurement for the violation values (MW for thermal, kV for voltage, etc.). Provides context for interpreting pre/post-contingency and limit values."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure" ;
    cmm:validValues "MW|MVAR|kV|amperes|percent|degrees" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:ContingencyViolation.violatedElementName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violated element name"@en ;
    rdfs:comment "Human-readable name or designation of the violated grid element (e.g., 'Line 345kV Smith-Jones', 'Transformer T-123'). Provides operator-friendly identification."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "violated_element_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violated Element Name" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.violatedElementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violated element reference"@en ;
    rdfs:comment "Reference to the specific grid element (transmission line, transformer, bus, generator) that experienced the limit violation in the post-contingency state."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:long ;
    cmm:physicalColumn "violated_element_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violated Element ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyViolation.violatedElementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violated element type"@en ;
    rdfs:comment "Classification of the grid element that experienced the violation. Categorizes the equipment type for analysis and reporting purposes."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "violated_element_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violated Element Type" ;
    cmm:validValues "transmission_line|transformer|bus|generator|capacitor_bank|reactor" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.violationMagnitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation magnitude"@en ;
    rdfs:comment "Absolute difference between the post-contingency value and the limit value. Quantifies the extent of the violation in native units (MW, kV, etc.)."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "violation_magnitude" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Magnitude" ;
    cmm:cimDatatype "Decimal" .
cmm:ContingencyViolation.violationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation percentage"@en ;
    rdfs:comment "Percentage by which the post-contingency value exceeds the limit. Calculated as ((post_contingency_value - limit_value) / limit_value) * 100. Used for relative severity assessment."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "violation_percentage" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ContingencyViolation.violationSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation severity"@en ;
    rdfs:comment "Severity classification of the violation based on magnitude and operational impact. Used for prioritization of operator corrective actions."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Severity" ;
    cmm:validValues "critical|major|minor|informational" ;
    cmm:cimDatatype "String" .
cmm:ContingencyViolation.violationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation timestamp"@en ;
    rdfs:comment "Date and time when the contingency violation was detected by the analysis engine. Represents the real-time or study timestamp of the violation occurrence."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "violation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyViolation.violationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation type"@en ;
    rdfs:comment "Category of the limit violation detected. Identifies whether the violation is thermal (loading), voltage (magnitude), or stability-related."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Violation Type" ;
    cmm:validValues "thermal_overload|voltage_high|voltage_low|stability_limit|transient_instability|voltage_collapse" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:ContingencyViolation.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts of the violated element. Used for categorizing violations by voltage class (transmission vs sub-transmission)."@en ;
    rdfs:domain cmm:ContingencyViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:AgcSignal a owl:Class ;
    rdfs:label "Agc Signal"@en ;
    rdfs:comment "Time-series transactional record of Automatic Generation Control (AGC) regulation signals and Area Control Error (ACE) computations for the balancing authority control area. AGC attributes include generating unit reference, base point (MW), regulation raise/lower signal (MW), regulation reserve deployed (MW), and response rate (MW/min). ACE attributes (same time grain) include raw ACE (MW), filtered ACE (MW), 10-minute average ACE, CPS1/CPS2 compliance indicators, frequency bias setting (MW/0.1 Hz), actual system frequency (Hz), scheduled frequency (Hz), and net interchange deviation (MW). Sourced from OSIsoft PI historian AGC and ACE tags. SSOT for all AGC regulation and ACE compliance data — used for NERC BAL-001 CPS1/CPS2 compliance evidence, NERC BAL-003 frequency response obligation, frequency regulation performance tracking, and ancillary services settlement."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:AnalogValue ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.agc_signal" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC BAL-003; NERC BAL-001 AGC / OSIsoft PI AGC Tags" ;
    cmm:sourceObject "energy_utilities_ecm.grid.agc_signal" ;
    owl:hasKey ( cmm:AgcSignal.agcSignalId ) .

cmm:AgcSignal.agcSignalId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc signal id"@en ;
    rdfs:comment "Unique identifier for the AGC signal record. Primary key for the agc_signal product."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:long ;
    cmm:physicalColumn "agc_signal_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Signal ID" ;
    cmm:cimDatatype "Integer" .
cmm:AgcSignal.agcControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "agc control area"@en ;
    rdfs:comment "Reference to the balancing authority control area issuing this AGC signal."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "agc_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:sourceColumn "control_area_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_agc_control_area_id" ;
    cmm:cimAssociation "AnalogValue.ControlArea" .
cmm:AgcSignal.generatingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit"@en ;
    rdfs:comment "Reference to the generating unit receiving this AGC regulation signal."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_generating_unit_id" ;
    cmm:cimAssociation "AnalogValue.GeneratingUnit" .
cmm:AgcSignal.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: AGC operations directly implement NERC BAL-001 and BAL-002 standards for frequency control and CPS compliance. Each AGC signal execution must be traceable to the governing obligation for CPS1/CPS2 com"@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_obligation_id" ;
    cmm:cimAssociation "AnalogValue.Document" .
cmm:AgcSignal.primaryControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — AGC regulation signals and ACE computations are performed for a specific balancing authority control area. This link is required for NERC BAL-001 CPS1/CPS2 compliance reporting scoped to the correct B"@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "primary_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_primary_control_area_id" ;
    cmm:cimAssociation "AnalogValue.ControlArea" .
cmm:AgcSignal.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "The SCADA system point identifier associated with this AGC signal measurement."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_scada_point_id" ;
    cmm:cimAssociation "AnalogValue.Measurement" .
cmm:AgcSignal.toControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — AGC signals and ACE records (now merged) are computed for a specific balancing authority control area. This FK is essential for multi-area operations and NERC BAL compliance reporting."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "to_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_to_control_area_id" ;
    cmm:cimAssociation "AnalogValue.ControlArea" .
cmm:AgcSignal.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: AGC regulation deployment often fulfills ancillary service trades or regulation market awards. Linking enables real-time trade performance tracking, settlement quantity validation, and compliance veri"@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_agc_signal_trade_id" ;
    cmm:cimAssociation "AnalogValue.Trade" .
cmm:AgcSignal.actualFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual frequency hz"@en ;
    rdfs:comment "The actual measured system frequency in hertz (Hz) at the time of this AGC signal. Nominal frequency is 60.000 Hz in North America."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AgcSignal.agcMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc mode"@en ;
    rdfs:comment "The operational mode of the Automatic Generation Control system at the time of this signal. Automatic mode means AGC is actively controlling generation; manual mode means operators are controlling generation manually."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "agc_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "AGC Mode" ;
    cmm:validValues "automatic|manual|off|test" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.ancillaryServiceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service type"@en ;
    rdfs:comment "The type of ancillary service being provided by this AGC signal. Regulation services provide continuous balancing, while reserve services provide contingency response."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "ancillary_service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Service Type" ;
    cmm:validValues "regulation_up|regulation_down|spinning_reserve|non_spinning_reserve" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.basePointMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base point mw"@en ;
    rdfs:comment "The base generation setpoint in megawatts (MW) for the generating unit before AGC regulation adjustment."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_point_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Point (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.cps1Compliant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps1 compliant"@en ;
    rdfs:comment "Boolean indicator of whether this AGC signal interval meets NERC CPS1 compliance criteria. CPS1 measures the balancing authority's ability to follow its own generation schedule on a one-minute basis."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cps1_compliant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 1 (CPS1) Compliant" ;
    cmm:cimDatatype "Boolean" .
cmm:AgcSignal.cps2Compliant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps2 compliant"@en ;
    rdfs:comment "Boolean indicator of whether this AGC signal interval meets NERC CPS2 compliance criteria. CPS2 measures the balancing authority's ability to limit unscheduled power flows on a 10-minute average basis."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cps2_compliant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 2 (CPS2) Compliant" ;
    cmm:cimDatatype "Boolean" .
cmm:AgcSignal.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "The name of the operational system from which this AGC signal record was sourced (e.g., OSIsoft PI, EMS, SCADA)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "The name of the Energy Management System that generated this AGC signal."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.filteredAceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filtered ace mw"@en ;
    rdfs:comment "The filtered Area Control Error in megawatts (MW) after applying smoothing algorithms to remove noise and transient spikes."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "filtered_ace_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filtered Area Control Error (ACE) (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.frequencyBiasSettingMwPer01Hz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency bias setting mw per 0 1 hz"@en ;
    rdfs:comment "The frequency bias setting in megawatts per 0.1 hertz (MW/0.1 Hz) used in the ACE calculation. Represents the balancing authority's expected MW response to a 0.1 Hz frequency deviation."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_bias_setting_mw_per_0_1_hz" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Bias Setting (MW per 0.1 Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AgcSignal.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "The name of the North American electric interconnection to which this control area belongs. The four major interconnections are Eastern, Western, Texas (ERCOT), and Quebec."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Name" ;
    cmm:validValues "eastern|western|texas|quebec" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "The NERC regional entity code responsible for reliability oversight of this control area (e.g., WECC, SERC, MRO, NPCC, RF, TRE)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.netInterchangeActualMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net interchange actual mw"@en ;
    rdfs:comment "The actual net interchange power flow in megawatts (MW) across all tie lines for the control area at this timestamp."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_interchange_actual_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Interchange Actual (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.netInterchangeDeviationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net interchange deviation mw"@en ;
    rdfs:comment "The deviation between actual and scheduled net interchange in megawatts (MW). Calculated as (Actual Net Interchange - Scheduled Net Interchange)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_interchange_deviation_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Interchange Deviation (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.netInterchangeScheduledMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net interchange scheduled mw"@en ;
    rdfs:comment "The scheduled net interchange power flow in megawatts (MW) across all tie lines for the control area at this timestamp."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_interchange_scheduled_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Interchange Scheduled (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, annotations, or operational notes related to this AGC signal event."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AgcSignal.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "The OSIsoft PI historian tag name from which this AGC signal data was sourced. Used for traceability back to the SCADA system."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.rawAceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "raw ace mw"@en ;
    rdfs:comment "The unfiltered Area Control Error in megawatts (MW) computed at the same time grain as the AGC signal. Raw ACE = (Actual Net Interchange - Scheduled Net Interchange) - (Frequency Bias Setting) × (Actual Frequency - Scheduled Frequency)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "raw_ace_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Raw Area Control Error (ACE) (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "The timestamp when this AGC signal record was first created in the data platform."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:AgcSignal.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "The timestamp when this AGC signal record was last updated in the data platform."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:AgcSignal.regulationDirection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation direction"@en ;
    rdfs:comment "The direction of the regulation signal. Raise indicates the unit should increase generation, lower indicates decrease, neutral indicates no change."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulation_direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulation Direction" ;
    cmm:validValues "raise|lower|neutral" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.regulationReserveDeployedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation reserve deployed mw"@en ;
    rdfs:comment "The amount of regulation reserve capacity deployed in megawatts (MW) in response to the AGC signal."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulation_reserve_deployed_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulation Reserve Deployed (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.regulationSignalMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulation signal mw"@en ;
    rdfs:comment "The AGC regulation signal in megawatts (MW) sent to the generating unit. Positive values indicate raise signal, negative values indicate lower signal."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulation_signal_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulation Signal (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.responseRateMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response rate mw per min"@en ;
    rdfs:comment "The rate at which the generating unit responds to the AGC signal, measured in megawatts per minute (MW/min)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "response_rate_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Rate (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:AgcSignal.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "The code identifying the RTO or ISO responsible for coordinating this control area's operations (e.g., PJM, MISO, CAISO, ERCOT, NYISO, ISO-NE, SPP)."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .
cmm:AgcSignal.scheduledFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled frequency hz"@en ;
    rdfs:comment "The scheduled target system frequency in hertz (Hz). Typically 60.000 Hz for North American interconnections."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "scheduled_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AgcSignal.settlementInterval a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement interval"@en ;
    rdfs:comment "The settlement interval number within the operating day, used for ancillary services market settlement. Typically 5-minute or 15-minute intervals."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:int ;
    cmm:physicalColumn "settlement_interval" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Interval" ;
    cmm:cimDatatype "Integer" .
cmm:AgcSignal.signalQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "signal quality code"@en ;
    rdfs:comment "Quality indicator for the AGC signal data. Good indicates reliable data, uncertain indicates questionable data, bad indicates invalid data, substituted indicates estimated or replaced data."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "signal_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Signal Quality Code" ;
    cmm:validValues "good|uncertain|bad|substituted" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:AgcSignal.signalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "signal timestamp"@en ;
    rdfs:comment "The precise timestamp when this AGC signal and ACE computation were recorded. Primary event timestamp for this transactional record."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "signal_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "AGC Signal Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:AgcSignal.tenMinuteAverageAceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ten minute average ace mw"@en ;
    rdfs:comment "The rolling 10-minute average of Area Control Error in megawatts (MW), used for NERC CPS2 compliance calculations."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ten_minute_average_ace_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ten-Minute Average ACE (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AgcSignal.unitResponseStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit response status"@en ;
    rdfs:comment "The status of the generating unit's response to the AGC signal. Indicates whether the unit is following the signal as expected."@en ;
    rdfs:domain cmm:AgcSignal ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_response_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Response Status" ;
    cmm:validValues "responding|not_responding|limited|unavailable" ;
    cmm:cimDatatype "String" .

cmm:AceRecord a owl:Class ;
    rdfs:label "Ace Record"@en ;
    rdfs:comment "Time-series record of Area Control Error (ACE) computed by the EMS for the balancing authority control area. Captures UTC timestamp, raw ACE (MW), filtered ACE (MW), 10-minute average ACE (MW), CPS1 compliance indicator, CPS2 compliance indicator, frequency bias setting (MW/0.1 Hz), actual system frequency (Hz), scheduled frequency (Hz), and net interchange deviation (MW). SSOT for NERC BAL-001 CPS1/CPS2 compliance evidence and frequency regulation performance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:AnalogValue ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.ace_record" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC BAL-001; NERC BAL-001 CPS1/CPS2 ACE" ;
    cmm:sourceObject "energy_utilities_ecm.grid.ace_record" ;
    owl:hasKey ( cmm:AceRecord.aceRecordId ) .

cmm:AceRecord.aceRecordId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace record id"@en ;
    rdfs:comment "Unique identifier for the ACE record. Primary key for the time-series ACE dataset."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:long ;
    cmm:physicalColumn "ace_record_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Area Control Error (ACE) Record ID" ;
    cmm:cimDatatype "Integer" .
cmm:AceRecord.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key reference to the balancing authority control area for which this ACE value was computed."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ace_record_control_area_id" ;
    cmm:cimAssociation "AnalogValue.ControlArea" .
cmm:AceRecord.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: ACE measurements are the foundation of NERC BAL-001 compliance for balancing authorities. Every ACE record serves as evidence for CPS1/CPS2 compliance calculations. This link enables automated complia"@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ace_record_obligation_id" ;
    cmm:cimAssociation "AnalogValue.Document" .
cmm:AceRecord.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "SCADA system point identifier for the ACE calculation output. Links this record to the underlying SCADA telemetry infrastructure."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ace_record_scada_point_id" ;
    cmm:cimAssociation "AnalogValue.Measurement" .
cmm:AceRecord.ace10minAvgMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace 10min avg mw"@en ;
    rdfs:comment "Rolling 10-minute average of ACE values in megawatts. Critical metric for NERC CPS2 compliance evaluation, which requires the 10-minute average ACE to remain within L10 limits."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ace_10min_avg_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Area Control Error (ACE) 10-Minute Average (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.aceFilteredMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace filtered mw"@en ;
    rdfs:comment "Filtered Area Control Error value in megawatts after applying smoothing algorithms to remove noise and transient spikes. Used for AGC control actions."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ace_filtered_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Area Control Error (ACE) Filtered (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.aceRawMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace raw mw"@en ;
    rdfs:comment "Raw unfiltered Area Control Error value in megawatts as computed by the EMS. Represents the instantaneous imbalance between scheduled and actual interchange plus frequency bias contribution."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ace_raw_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Area Control Error (ACE) Raw (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.actualFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual frequency hz"@en ;
    rdfs:comment "Actual measured interconnection frequency in hertz at the time of this ACE calculation. Nominal frequency is 60.000 Hz for North American interconnections (Eastern, Western, Texas) and 50.000 Hz for other regions."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AceRecord.agcEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc enabled"@en ;
    rdfs:comment "Boolean flag indicating whether AGC was enabled and actively issuing control signals to generating units at the time of this ACE measurement."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:AceRecord.agcMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc mode"@en ;
    rdfs:comment "Operating mode of the AGC system at the time of this ACE measurement. Automatic mode indicates AGC is actively controlling generation; manual mode indicates operators are manually balancing; off indicates AGC is disabled; test indicates AGC is in test/simulation mode."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "agc_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Mode" ;
    cmm:validValues "automatic|manual|off|test" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.calculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation method"@en ;
    rdfs:comment "Method used to compute this ACE value. Standard indicates normal EMS calculation; backup indicates calculation by backup system; manual indicates operator calculation; estimated indicates interpolated or reconstructed value."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ACE Calculation Method" ;
    cmm:validValues "standard|backup|manual|estimated" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.cps1Compliant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps1 compliant"@en ;
    rdfs:comment "Boolean indicator of whether this ACE measurement contributes positively to CPS1 compliance. CPS1 measures the balancing authority's contribution to interconnection frequency error over a rolling 12-month period."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cps1_compliant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 1 (CPS1) Compliant" ;
    cmm:cimDatatype "Boolean" .
cmm:AceRecord.cps2Compliant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps2 compliant"@en ;
    rdfs:comment "Boolean indicator of whether the 10-minute average ACE is within the L10 limit for this measurement period. CPS2 requires the balancing authority to maintain its 10-minute average ACE within specific bounds at least 90% of clock-10-minute periods."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cps2_compliant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 2 (CPS2) Compliant" ;
    cmm:cimDatatype "Boolean" .
cmm:AceRecord.dataQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality code"@en ;
    rdfs:comment "Quality indicator for this ACE measurement. Good indicates validated real-time data; suspect indicates potential data quality issues; bad indicates known invalid data; estimated indicates calculated/interpolated value; manual indicates operator-entered value."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Code" ;
    cmm:validValues "good|suspect|bad|estimated|manual" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:AceRecord.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name or identifier of the source system that provided this ACE record (e.g., EMS vendor name, PI historian instance, SCADA system identifier)."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.disturbanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance flag"@en ;
    rdfs:comment "Boolean flag indicating whether a reportable disturbance event was occurring during this ACE measurement period. Disturbances may trigger special ACE evaluation rules under NERC standards."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disturbance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disturbance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AceRecord.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name or identifier of the EMS system that computed this ACE value. Supports environments with multiple EMS instances or backup systems."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) System Name" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.frequencyBiasSettingMwPer01Hz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency bias setting mw per 0 1 hz"@en ;
    rdfs:comment "The frequency bias setting in megawatts per 0.1 Hz used in the ACE calculation for this measurement period. Represents the balancing authority's obligation to respond to frequency deviations. Negative value indicates the BA will increase generation when frequency drops."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_bias_setting_mw_per_0_1_hz" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Bias Setting (MW per 0.1 Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AceRecord.frequencyDeviationHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency deviation hz"@en ;
    rdfs:comment "Difference between actual and scheduled frequency in hertz (actual minus scheduled). Positive values indicate over-frequency; negative values indicate under-frequency."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_deviation_hz" ;
    cmm:sqlDataType "DECIMAL(8,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency Deviation (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AceRecord.imeMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ime mw"@en ;
    rdfs:comment "Interchange meter error correction term in megawatts applied to the ACE calculation to account for known metering inaccuracies on tie lines."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ime_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interchange Meter Error (IME) (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.interconnectionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection name"@en ;
    rdfs:comment "Name of the North American interconnection to which this balancing authority belongs. Eastern, Western, and Texas (ERCOT) are the three major asynchronous interconnections in North America; Quebec operates as a separate interconnection."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Name" ;
    cmm:validValues "eastern|western|texas|quebec" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.l10LimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "l10 limit mw"@en ;
    rdfs:comment "The L10 limit in megawatts for CPS2 compliance evaluation. Represents the maximum allowable 10-minute average ACE magnitude. Calculated as 1.65 times epsilon10 (the root-mean-square of the balancing authority's 10-minute average ACE over 12 months)."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "l10_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "L10 Limit (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.measurementTimestampUtc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement timestamp utc"@en ;
    rdfs:comment "UTC timestamp when the ACE measurement was captured by the EMS. Represents the real-world event time for this ACE calculation cycle, typically at 4-6 second intervals per NERC requirements."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "measurement_timestamp_utc" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Timestamp (UTC)" ;
    cmm:cimDatatype "DateTime" .
cmm:AceRecord.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity code for the balancing authority. WECC=Western Electricity Coordinating Council, TRE=Texas Reliability Entity, MRO=Midwest Reliability Organization, NPCC=Northeast Power Coordinating Council, RF=ReliabilityFirst, SERC=SERC Reliability Corporation, SPP=Southwest Power Pool, FRCC=Florida Reliability Coordinating Council. Reference-value candidates: WECC|TRE|MRO|NPCC|RF|SERC|SPP|FRCC."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.netActualInterchangeMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net actual interchange mw"@en ;
    rdfs:comment "Net actual interchange power flow in megawatts across all tie lines connecting this balancing authority to neighboring control areas. Positive values indicate net export; negative values indicate net import."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_actual_interchange_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Actual Interchange (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.netInterchangeDeviationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net interchange deviation mw"@en ;
    rdfs:comment "Difference between net actual interchange and net scheduled interchange in megawatts (actual minus scheduled). A key component of the ACE calculation formula."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_interchange_deviation_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Interchange Deviation (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.netScheduledInterchangeMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net scheduled interchange mw"@en ;
    rdfs:comment "Net scheduled interchange power flow in megawatts for this measurement period, including all confirmed interchange transactions and dynamic schedules."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_scheduled_interchange_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Scheduled Interchange (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, annotations, or explanations related to this ACE measurement. May include operator comments about unusual conditions, data quality issues, or special events."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AceRecord.piHistorianTag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag"@en ;
    rdfs:comment "OSIsoft PI historian tag name for this ACE measurement point. Enables traceability to the real-time data historian for post-event analysis and compliance reporting."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag" ;
    cmm:cimDatatype "String" .
cmm:AceRecord.primaryFrequencyResponseAdjustmentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary frequency response adjustment mw"@en ;
    rdfs:comment "Adjustment term in megawatts applied to ACE during primary frequency response events to account for the balancing authority's contribution to arresting frequency decline or rise."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "primary_frequency_response_adjustment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Frequency Response Adjustment (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AceRecord.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this ACE record was first inserted into the data historian or lakehouse. Distinct from measurement_timestamp_utc, which represents the real-world event time."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:AceRecord.scheduledFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled frequency hz"@en ;
    rdfs:comment "Scheduled interconnection frequency in hertz for this measurement period. Typically 60.000 Hz for North American grids, but may vary during time error correction periods."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "scheduled_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,5)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:AceRecord.stateEstimatorSolutionValid a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimator solution valid"@en ;
    rdfs:comment "Boolean flag indicating whether the EMS state estimator had a valid converged solution at the time of this ACE calculation. Invalid state estimator solutions may affect ACE accuracy."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "state_estimator_solution_valid" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Estimator Solution Valid" ;
    cmm:cimDatatype "Boolean" .
cmm:AceRecord.tieLineMeterCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tie line meter count"@en ;
    rdfs:comment "Number of tie line meters contributing to the net actual interchange calculation for this ACE measurement. Used for data quality assessment."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:int ;
    cmm:physicalColumn "tie_line_meter_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tie Line Meter Count" ;
    cmm:cimDatatype "Integer" .
cmm:AceRecord.tieLineMeterFailures a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tie line meter failures"@en ;
    rdfs:comment "Number of tie line meters that were unavailable or failed at the time of this ACE calculation. Non-zero values may indicate degraded ACE accuracy."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:int ;
    cmm:physicalColumn "tie_line_meter_failures" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tie Line Meter Failures" ;
    cmm:cimDatatype "Integer" .
cmm:AceRecord.timeErrorCorrectionActive a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time error correction active"@en ;
    rdfs:comment "Boolean flag indicating whether the interconnection was in time error correction mode during this measurement period. Time error correction adjusts scheduled frequency to correct accumulated time error."@en ;
    rdfs:domain cmm:AceRecord ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "time_error_correction_active" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Error Correction Active" ;
    cmm:cimDatatype "Boolean" .

cmm:InterchangeSchedule a owl:Class ;
    rdfs:label "Interchange Schedule"@en ;
    rdfs:comment "Master and transactional record of energy interchange schedules between the balancing authority and neighboring control areas or counterparties. Captures schedule ID, counterparty entity (NERC registered), interchange direction (import/export), scheduled MW by hour, e-Tag reference number, NERC TAG ID, effective start/end timestamps, schedule type (firm/non-firm), curtailment status, and OASIS posting reference. SSOT for interchange scheduling used in NERC BAL-002 compliance and energy trading settlement."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:EnergyTransaction ;
    cmm:cimCloseMatch cim:EnergyTransaction ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::InfEnergyScheduling" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.interchange_schedule" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NAESB WEQ e-Tag; NERC BAL-002 / NAESB e-Tag" ;
    cmm:sourceObject "energy_utilities_ecm.grid.interchange_schedule" ;
    owl:hasKey ( cmm:InterchangeSchedule.interchangeScheduleId ) .

cmm:InterchangeSchedule.interchangeScheduleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interchange schedule id"@en ;
    rdfs:comment "Unique identifier for the interchange schedule record. Primary key for the interchange schedule entity."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "interchange_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Interchange Schedule ID" ;
    cmm:cimDatatype "Integer" .
cmm:InterchangeSchedule.approvedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approved by employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Energy interchange schedules (NERC e-Tags) require documented approver for audit trails, market settlement disputes, and FERC compliance. 'approved_by' text field should be FK to employee."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approved_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_approved_by_employee_id" ;
    cmm:cimAssociation "EnergyTransaction.ErpPersonnel" .
cmm:InterchangeSchedule.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Identifier of the neighboring control area or counterparty entity involved in the interchange. Must be a NERC registered entity."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty Entity ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_counterparty_id" ;
    cmm:cimAssociation "EnergyTransaction.MarketParticipant" .
cmm:InterchangeSchedule.energySchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy schedule"@en ;
    rdfs:comment "Foreign key linking to trading.energy_schedule. Business justification: Interchange schedules are created from or validated against energy schedules submitted by scheduling coordinators. Linking enables schedule reconciliation, e-Tag validation, and curtailment coordinati"@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:EnergySchedule ;
    cmm:physicalColumn "energy_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Schedule Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_energy_schedule_id" ;
    cmm:cimAssociation "EnergyTransaction.EnergyTransaction" .
cmm:InterchangeSchedule.interchangeControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interchange control area"@en ;
    rdfs:comment "Identifier of the balancing authority control area that owns this interchange schedule."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "interchange_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:sourceColumn "control_area_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_interchange_control_area_id" ;
    cmm:cimAssociation "EnergyTransaction.ControlArea" .
cmm:InterchangeSchedule.primaryControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Interchange schedules define energy flows between control areas. The FK to control_area identifies which balancing authority is party to the schedule — required for NERC BAL-002 compliance."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "primary_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_primary_control_area_id" ;
    cmm:cimAssociation "EnergyTransaction.ControlArea" .
cmm:InterchangeSchedule.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Interchange schedules supporting market-based rate authority or transmission service must reference the authorizing FERC filing (MBR authorization, OATT tariff). This link enables rate compliance veri"@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_regulatory_filing_id" ;
    cmm:cimAssociation "EnergyTransaction.Document" .
cmm:InterchangeSchedule.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Interchange schedules implement physical delivery of bilateral energy trades. Direct trade linkage enables trade-to-schedule reconciliation, settlement validation, and curtailment impact analysis. Ess"@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_trade_id" ;
    cmm:cimAssociation "EnergyTransaction.Trade" .
cmm:InterchangeSchedule.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Identifier of the transmission path or flowgate used for this interchange. Defines the physical route of energy transfer between control areas."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Path ID" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_interchange_schedule_transmission_path_id" ;
    cmm:cimAssociation "EnergyTransaction.TransmissionPath" .
cmm:InterchangeSchedule.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time when the interchange schedule was approved by the balancing authority or transmission operator."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:InterchangeSchedule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this interchange schedule record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:EnergyTransaction.createdDateTime .
cmm:InterchangeSchedule.curtailmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment status"@en ;
    rdfs:comment "Indicates whether the interchange schedule has been curtailed due to transmission constraints or reliability concerns. None indicates no curtailment; partial indicates reduced MW; full indicates complete curtailment."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "curtailment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Status" ;
    cmm:validValues "none|partial|full" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that originated this interchange schedule record. Typically the EMS, energy trading system, or e-Tag system."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.effectiveEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end timestamp"@en ;
    rdfs:comment "Date and time when the interchange schedule ends and energy flow ceases. Marks the conclusion of the scheduled interchange period."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:InterchangeSchedule.effectiveStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start timestamp"@en ;
    rdfs:comment "Date and time when the interchange schedule becomes effective and energy flow begins. Marks the start of the scheduled interchange period."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:InterchangeSchedule.etagReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "etag reference number"@en ;
    rdfs:comment "Electronic tag reference number assigned by the NERC tag authority for this interchange transaction. Links to the OASIS e-Tag system."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "etag_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "e-Tag Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterchangeSchedule.interchangeDirection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interchange direction"@en ;
    rdfs:comment "Direction of energy flow relative to the balancing authority. Import indicates energy flowing into the control area; export indicates energy flowing out."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "interchange_direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interchange Direction" ;
    cmm:validValues "import|export" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this interchange schedule record was most recently modified. Tracks the latest change for audit and version control."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InterchangeSchedule.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "Classification of the market context for the interchange schedule. Day-ahead schedules are submitted in advance; real-time schedules are for immediate delivery; bilateral schedules are direct contracts between parties."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Type" ;
    cmm:validValues "day-ahead|real-time|bilateral" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.nercTagReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc tag reference"@en ;
    rdfs:comment "NERC-assigned tag identifier for the interchange schedule. Used for compliance reporting and audit trail."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_tag_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) TAG ID" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, special instructions, or operational notes related to the interchange schedule. Used for context and communication between operators."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:InterchangeSchedule.oasisPostingReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oasis posting reference"@en ;
    rdfs:comment "Reference identifier for the OASIS posting associated with this interchange schedule. Links to the transmission reservation and available transfer capability posting."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "oasis_posting_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OASIS (Open Access Same-Time Information System) Posting Reference" ;
    cmm:cimDatatype "String" .
cmm:InterchangeSchedule.priorityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "Numeric priority ranking for the interchange schedule used during curtailment events. Lower numbers indicate higher priority. Typically ranges from 1 to 7 per NERC curtailment procedures."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Priority Level" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:InterchangeSchedule.rampRateMwPerMinute a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per minute"@en ;
    rdfs:comment "Maximum rate of change in megawatts per minute allowed for this interchange schedule. Used for ramping between hourly schedule values to maintain grid stability."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_mw_per_minute" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate MW (Megawatt) Per Minute" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:InterchangeSchedule.scheduleNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule number"@en ;
    rdfs:comment "Business identifier for the interchange schedule. Externally visible schedule reference number used in operational communications and settlements."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterchangeSchedule.scheduleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule status"@en ;
    rdfs:comment "Current lifecycle status of the interchange schedule. Tracks progression from submission through approval, execution, and completion or cancellation."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Status" ;
    cmm:validValues "pending|approved|active|curtailed|completed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EnergyTransaction.status .
cmm:InterchangeSchedule.scheduleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "schedule type"@en ;
    rdfs:comment "Classification of the interchange schedule as firm (guaranteed delivery) or non-firm (interruptible). Firm schedules have priority during curtailment events."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "schedule_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Schedule Type" ;
    cmm:validValues "firm|non-firm" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EnergyTransaction.type .
cmm:InterchangeSchedule.scheduledMwHour01 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled mw hour 01"@en ;
    rdfs:comment "Scheduled interchange megawatt value for hour ending 01:00. Positive values indicate export; negative values indicate import per NERC convention."@en ;
    rdfs:domain cmm:InterchangeSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "scheduled_mw_hour_01" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
