    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CostCenter.costCenterStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center status"@en ;
    rdfs:comment "Current lifecycle status of the cost center. Active cost centers accept postings; inactive and blocked cost centers do not."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_status" ;
