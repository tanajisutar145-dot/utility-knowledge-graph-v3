cmm:PlanningStudy a owl:Class ;
    rdfs:label "Planning Study"@en ;
    rdfs:comment "Master record for transmission planning studies and associated power flow models including NERC TPL assessments, IRP transmission analyses, regional transmission expansion plans, and steady-state/stability/short-circuit study cases. Captures study identifier, study type (TPL/IRP/regional/interconnection support), planning horizon, load growth assumptions, generation additions, power flow model metadata (software tool such as PSS/E or PowerWorld, NERC model version, base case/contingency scenario, season, peak/off-peak), identified deficiencies, recommended projects, estimated CAPEX, and regulatory filing reference. SSOT for long-range transmission planning and the power flow models that underpin ATC studies and NERC TPL-001 compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.planning_studies ;
    cmm:physicalTable "utility_cmm_silver.transmission.planning_study" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC TPL-001; NERC TPL-001 / FERC Order 1000 Transmission Planning" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.planning_study" ;
    owl:hasKey ( cmm:PlanningStudy.planningStudyId ) .

cmm:PlanningStudy.planningStudyId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning study id"@en ;
    rdfs:comment "Primary key for planning_study"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:long ;
    cmm:physicalColumn "planning_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Planning Study Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PlanningStudy.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Planning studies identify and justify capital projects that become formal capex projects in finance system. Links technical planning to capital budgeting, IRP compliance, and rate case support."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:PlanningStudy.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Foreign key linking to asset.capital_project. Business justification: Transmission planning studies identify system needs that drive capital projects. Utilities link planning study recommendations to specific capital projects for regulatory justification (FERC/PUC filin"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_capital_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:PlanningStudy.equipmentSupplierContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "equipment supplier contract"@en ;
    rdfs:comment "Foreign key linking to supply.supplier_contract. Business justification: Long-term transmission planning studies reference existing supplier contracts for major equipment (power transformers, circuit breakers, disconnect switches) to validate capital cost assumptions, deli"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:SupplierContract ;
    cmm:physicalColumn "equipment_supplier_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Equipment Supplier Contract Id (Foreign Key)" ;
    cmm:sourceColumn "supplier_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_equipment_supplier_contract_id" ;
    cmm:cimAssociation "Document.Agreement" .
cmm:PlanningStudy.evaluatedInterconnectionQueue a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evaluated interconnection queue"@en ;
    rdfs:comment "Foreign key linking to renewable.interconnection_queue. Business justification: Transmission planning studies (system impact studies, facilities studies, cluster studies) directly assess the system impacts of specific interconnection queue projects. FERC Order 2023 cluster study"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:InterconnectionQueue ;
    cmm:physicalColumn "evaluated_interconnection_queue_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Evaluated Interconnection Queue Id (Foreign Key)" ;
    cmm:sourceColumn "interconnection_queue_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_evaluated_interconnection_queue_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PlanningStudy.hedgeStrategy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hedge strategy"@en ;
    rdfs:comment "Foreign key linking to trading.hedge_strategy. Business justification: Long-term transmission planning studies (load growth, generation mix changes) directly inform multi-year hedge strategy design. Hedge strategies reference specific planning study assumptions for board"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:HedgeStrategy ;
    cmm:physicalColumn "hedge_strategy_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Hedge Strategy Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_hedge_strategy_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PlanningStudy.irpFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp filing"@en ;
    rdfs:comment "Foreign key linking to compliance.irp_filing. Business justification: Transmission expansion plans are integral components of Integrated Resource Plan filings required by state PUCs. IRP filings include transmission needs assessment, capacity expansion plans, and cost a"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:IrpFiling ;
    cmm:physicalColumn "irp_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_irp_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PlanningStudy.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Transmission planning studies reference IRP scenarios for long-term load growth, generation mix, and policy assumptions. Standard regulatory planning workflow where transmission expansion plans must a"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PlanningStudy.leadEngineerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lead engineer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Transmission planning studies require accountable lead engineer for FERC/PUC filings, NERC TPL compliance, and stakeholder review processes. lead_engineer_name currently plain text; FK enables workloa"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "lead_engineer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lead Engineer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_lead_engineer_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:PlanningStudy.path a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "path"@en ;
    rdfs:comment "FK to transmission.path.path_id — Planning studies analyze specific transmission paths for transfer capability and reliability. Links planning to operational topology."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_path_id" ;
    cmm:cimAssociation "Document.TransmissionPath" .
cmm:PlanningStudy.planningPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "planning path"@en ;
    rdfs:comment "FK to transmission.path.path_id — Planning studies evaluate transmission paths for adequacy and expansion needs. Links study recommendations to physical network elements."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "planning_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_planning_path_id" ;
    cmm:cimAssociation "Document.TransmissionPath" .
cmm:PlanningStudy.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Transmission planning studies are filed with state PUCs and FERC for prudency review and cost recovery approval. FERC Order 1000 requires regional transmission planning process documentation and stake"@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_planning_study_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:PlanningStudy.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when the planning study was formally approved by management or the regional planning authority."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:PlanningStudy.atcImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc impact mw"@en ;
    rdfs:comment "Estimated impact on Available Transfer Capability (ATC) in megawatts resulting from recommended projects or identified constraints in this study."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "atc_impact_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Transfer Capability (ATC) Impact (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PlanningStudy.baseCaseScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base case scenario"@en ;
    rdfs:comment "Description of the base case scenario used in the power flow model (e.g., 2030 Summer Peak, 2025 Winter Off-Peak, Current Year Light Load)."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "base_case_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Case Scenario Description" ;
    cmm:cimDatatype "String" .
cmm:PlanningStudy.contingencyScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency scenario"@en ;
    rdfs:comment "Description of contingency scenarios analyzed in this study (e.g., N-1, N-2, generator outage, transmission line outage, extreme weather)."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "contingency_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Scenario Description" ;
    cmm:cimDatatype "String" .
cmm:PlanningStudy.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this planning study record was first created in the system."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:PlanningStudy.estimatedCapexUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated capex usd"@en ;
    rdfs:comment "Estimated total capital expenditure in USD for all recommended transmission projects identified in this study."@en ;
    rdfs:domain cmm:PlanningStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_capex_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Capital Expenditure (CAPEX) in United States Dollars (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PlanningStudy.estimatedProjectInServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
