    rdfs:comment "The voltage class range for which this certification requirement applies. Certain certifications (e.g., high voltage safety, arc flash) are only required when the generating unit operates at or above specific voltage thresholds."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_class_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
