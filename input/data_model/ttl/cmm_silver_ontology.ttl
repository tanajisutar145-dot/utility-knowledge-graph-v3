cmm:WorkOrderMaterialIssue a owl:Class ;
    rdfs:label "Work Order Material Issue"@en ;
    rdfs:comment "This association product represents the Material Issue Transaction between work_order and spare_parts_inventory. It captures the consumption of spare parts, materials, and consumables against maintenance work orders in utility asset management operations. Each record links one work order to one spare part inventory item with transactional attributes including quantities issued and returned, costs at time of issue, timestamps, material document references, and cost allocation codes. This is a core operational entity in EAM/CMMS systems (Ventyx Asset Suite, SAP PM, Maximo) that enables material cost tracking, inventory consumption analysis, and work order cost rollup.. Existence Justification: In utility asset management operations, maintenance work orders consume multiple spare parts and materials (transformers, insulators, cables, tools, consumables), and each spare part in inventory is issued to multiple work orders over its lifecycle. Material issue transactions are actively created by storeroom clerks and technicians during work execution, with each transaction recording quantities, costs, timestamps, and document references. This is a recognized operational entity in EAM systems called Material Issue, Parts Consumption, or Material Document."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MaterialItem ;
    cmm:cimCloseMatch cim:MaterialItem ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.work_order_material_issue" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.asset.work_order_material_issue" ;
    owl:hasKey ( cmm:WorkOrderMaterialIssue.workOrderMaterialIssueId ) .

cmm:WorkOrderMaterialIssue.workOrderMaterialIssueId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order material issue id"@en ;
    rdfs:comment "Unique identifier for the material issue transaction record. Primary key for the association."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_order_material_issue_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Work Order Material Issue ID" ;
    cmm:cimDatatype "Integer" .
cmm:WorkOrderMaterialIssue.issuedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "issued by employee"@en ;
    rdfs:comment "Reference to the storeroom clerk, technician, or employee who physically issued the material from inventory. Used for accountability and audit purposes."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "issued_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Issued By Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_material_issue_issued_by_employee_id" ;
    cmm:cimAssociation "MaterialItem.ErpPersonnel" .
cmm:WorkOrderMaterialIssue.sparePartsInventory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts inventory"@en ;
    rdfs:comment "Foreign key linking to the spare parts inventory item that was issued. Identifies which material master record was consumed."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range cmm:SparePartsInventory ;
    cmm:physicalColumn "spare_parts_inventory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Material Issue - Spare Parts Inventory Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_material_issue_spare_parts_inventory_id" ;
    cmm:cimAssociation "MaterialItem.ErpInventory" .
cmm:WorkOrderMaterialIssue.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Foreign key linking to the work order that consumed the material. Identifies which maintenance activity the spare part was issued against."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Material Issue - Work Order Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_material_issue_work_order_id" ;
    cmm:cimAssociation "MaterialItem.Work" .
cmm:WorkOrderMaterialIssue.costCenterCharged a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center charged"@en ;
    rdfs:comment "Financial cost center code to which this material consumption cost is allocated. May differ from the work order cost center if material is charged to a different organizational unit."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_charged" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center Charged" ;
    cmm:cimDatatype "String" .
cmm:WorkOrderMaterialIssue.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code for financial posting of the material cost. Aligns with chart of accounts for O&M expense or capital project accounting."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "GL Account Code" ;
    cmm:cimDatatype "String" .
cmm:WorkOrderMaterialIssue.issueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue date"@en ;
    rdfs:comment "Calendar date when the material was issued from inventory to the work order. Used for inventory transaction history and cost period allocation."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:date ;
    cmm:physicalColumn "issue_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issue Date" ;
    cmm:cimDatatype "Date" .
cmm:WorkOrderMaterialIssue.issueTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue timestamp"@en ;
    rdfs:comment "Precise date and time when the material issue transaction was recorded in the EAM system. Provides audit trail and chronological sequencing of material movements."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "issue_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issue Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkOrderMaterialIssue.materialDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material document number"@en ;
    rdfs:comment "Unique document identifier for the material issue transaction in the EAM or ERP system (e.g., SAP Material Document, Maximo Issue Record). Provides audit trail and cross-system reconciliation."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Material Document Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WorkOrderMaterialIssue.quantityIssued a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity issued"@en ;
    rdfs:comment "Quantity of the spare part or material issued from inventory to the work order. Measured in the unit of measure defined in the spare parts inventory record. This is the primary consumption metric."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_issued" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity Issued" ;
    cmm:cimDatatype "Decimal" .
cmm:WorkOrderMaterialIssue.quantityReturned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity returned"@en ;
    rdfs:comment "Quantity of the spare part or material returned to inventory after work order completion (unused or excess material). Used to adjust actual consumption and inventory levels."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_returned" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity Returned" ;
    cmm:cimDatatype "Decimal" .
cmm:WorkOrderMaterialIssue.reservationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation number"@en ;
    rdfs:comment "Material reservation or requisition number that pre-allocated this inventory item to the work order. Links the issue transaction to the planning phase reservation record."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:string ;
    cmm:physicalColumn "reservation_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reservation Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WorkOrderMaterialIssue.returnDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "return date"@en ;
    rdfs:comment "Calendar date when unused or excess material was returned to inventory from the work order. Null if no return occurred."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:date ;
    cmm:physicalColumn "return_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Return Date" ;
    cmm:cimDatatype "Date" .
cmm:WorkOrderMaterialIssue.unitCostAtIssue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit cost at issue"@en ;
    rdfs:comment "Standard or moving average cost per unit at the time the material was issued. Captures the cost basis for work order cost allocation, which may differ from current inventory unit cost due to price changes over time."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_cost_at_issue" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Cost at Issue" ;
    cmm:cimDatatype "Decimal" .
cmm:WorkOrderMaterialIssue.workOrderLineNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order line number"@en ;
    rdfs:comment "Line item sequence number within the work order material list. Used for organizing and referencing multiple material issues on the same work order."@en ;
    rdfs:domain cmm:WorkOrderMaterialIssue ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_line_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Line Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:AssetProgramEnrollment a owl:Class ;
    rdfs:label "Asset Program Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment relationship between physical utility assets and demand response programs. It captures the operational participation of specific assets (substations, feeders, transformers) in DR programs, including capacity commitments, performance tracking, and settlement parameters. Each record links one asset to one DR program with attributes that exist only in the context of this enrollment relationship.. Existence Justification: In energy utility operations, physical distribution assets (substations, feeders, transformers) are enrolled in multiple demand response programs simultaneously to serve different grid reliability and market participation objectives. A single substation may participate in ISO capacity markets, emergency DR programs, economic dispatch programs, and voltage support programs concurrently. Each enrollment has distinct capacity commitments, performance metrics, baseline methodologies, and settlement rates that are managed independently by the demand response operations team."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.asset_program_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.asset.asset_program_enrollment" ;
    owl:hasKey ( cmm:AssetProgramEnrollment.assetProgramEnrollmentId ) .

cmm:AssetProgramEnrollment.assetProgramEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset program enrollment id"@en ;
    rdfs:comment "Primary key for asset_program_enrollment"@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "asset_program_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "asset_program_enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:AssetProgramEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to the demand response program"@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Program Enrollment - Dr Program Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_program_enrollment_dr_program_id" ;
    cmm:cimAssociation "IdentifiedObject.DemandResponseProgram" .
cmm:AssetProgramEnrollment.program a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "program"@en ;
    rdfs:comment "Unique identifier for this asset-program enrollment record. Primary key."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Program Enrollment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_program_enrollment_program_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:AssetProgramEnrollment.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the enrolled asset in the asset registry"@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Program Enrollment - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_program_enrollment_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:AssetProgramEnrollment.averagePerformancePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average performance percentage"@en ;
    rdfs:comment "Rolling average of actual load reduction achieved versus committed enrolled capacity across all dispatch events for this asset-program combination. Used for performance tier assignment."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_performance_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Performance Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:AssetProgramEnrollment.baselineMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline methodology"@en ;
    rdfs:comment "The specific baseline calculation methodology applied to this asset for this program. May differ from program default if asset has unique operational characteristics requiring customized M&V approach."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Methodology" ;
    cmm:cimDatatype "String" .
cmm:AssetProgramEnrollment.cumulativeDispatchHoursYtd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative dispatch hours ytd"@en ;
    rdfs:comment "Year-to-date cumulative hours this asset has been dispatched under this program. Used to monitor compliance with max_event_hours_per_year program limits."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_dispatch_hours_ytd" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Dispatch Hours YTD" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetProgramEnrollment.enrolledCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled capacity kw"@en ;
    rdfs:comment "The committed load reduction capacity in kilowatts for this specific asset under this DR program. Aggregated across all asset enrollments to calculate program-level enrolled_capacity_actual_mw."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:AssetProgramEnrollment.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date when this specific asset was enrolled into this DR program. Used for eligibility calculations and incentive accrual start date."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetProgramEnrollment.enrollmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment end date"@en ;
    rdfs:comment "Date when this asset's enrollment in this DR program ended or is scheduled to end. Null for active ongoing enrollments."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment End Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetProgramEnrollment.incentiveRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate"@en ;
    rdfs:comment "The specific incentive payment rate ($/kW or $/kWh) applicable to this asset for this program. May vary from program base rate based on performance tier, asset criticality, or negotiated terms."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_rate" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetProgramEnrollment.lastDispatchDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last dispatch date"@en ;
    rdfs:comment "Date of the most recent DR event dispatch where this asset was called to reduce load under this program. Used for performance tracking and compliance monitoring."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_dispatch_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Dispatch Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetProgramEnrollment.participationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation status"@en ;
    rdfs:comment "Current status of this asset's participation in this DR program. Active indicates asset is eligible for dispatch. Suspended indicates temporary exclusion. Withdrawn indicates permanent removal. Pending indicates enrollment awaiting approval."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "participation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Status" ;
    cmm:cimDatatype "String" .
cmm:AssetProgramEnrollment.performanceTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance tier"@en ;
    rdfs:comment "Performance classification for this asset within this program based on historical dispatch compliance and load reduction achievement. Used to determine incentive rates and dispatch priority."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Tier" ;
    cmm:cimDatatype "String" .
cmm:AssetProgramEnrollment.withdrawalReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "withdrawal reason"@en ;
    rdfs:comment "Business reason for asset withdrawal from program (e.g., asset retired, performance non-compliance, program requirements changed, operational constraints). Populated when participation_status is Withdrawn."@en ;
    rdfs:domain cmm:AssetProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "withdrawal_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Withdrawal Reason" ;
    cmm:cimDatatype "String" .

cmm:AssetCompliance a owl:Class ;
    rdfs:label "Asset Compliance"@en ;
    rdfs:comment "This association product represents the compliance tracking relationship between physical utility assets and regulatory obligations. It captures the compliance status, verification history, and evidence management for each asset-obligation pair. Each record links one asset to one regulatory obligation with attributes that track compliance verification dates, responsible parties, and audit evidence specific to that asset's compliance with that particular obligation.. Existence Justification: In energy utilities operations, individual physical assets (transformers, transmission towers, substations, protection relays) are each subject to multiple regulatory obligations from different governing bodies (NERC CIP cybersecurity standards, EPA emissions limits, OSHA safety mandates, FERC reliability requirements). Simultaneously, each regulatory obligation applies to many assets across the utility's asset base based on asset characteristics like voltage class, criticality score, and operational function. Compliance teams actively manage this many-to-many relationship by tracking verification dates, collecting evidence, assigning responsible parties, and preparing for audits on each asset-obligation pair."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.asset_compliance" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.asset.asset_compliance" ;
    owl:hasKey ( cmm:AssetCompliance.assetComplianceId ) .

cmm:AssetCompliance.assetComplianceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset compliance id"@en ;
    rdfs:comment "Primary key for asset_compliance"@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:long ;
    cmm:physicalColumn "asset_compliance_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "asset_compliance Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:AssetCompliance.complianceObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance obligation"@en ;
    rdfs:comment "Unique identifier for this asset-obligation compliance tracking record. Primary key."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "compliance_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Compliance Record ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_compliance_compliance_obligation_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:AssetCompliance.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to the regulatory compliance obligation being verified"@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Compliance - Obligation Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_compliance_obligation_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:AssetCompliance.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the physical utility asset being tracked for compliance"@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Compliance - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_compliance_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:AssetCompliance.remediationPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "remediation plan"@en ;
    rdfs:comment "Reference to the remediation or mitigation plan if this asset-obligation pair is in non-compliance or conditional status."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "remediation_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Remediation Plan ID" ;
    cmm:sourceColumn "corrective_action_plan_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_asset_compliance_remediation_plan_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:AssetCompliance.applicabilityDeterminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicability determination date"@en ;
    rdfs:comment "Date when it was determined that this obligation applies to this asset, based on asset characteristics (voltage class, criticality, location) and obligation scope."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:date ;
    cmm:physicalColumn "applicability_determination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicability Determination Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetCompliance.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of this specific asset with respect to this specific obligation. Explicitly identified in detection reasoning as relationship data."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:AssetCompliance.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this asset-obligation compliance tracking record was created in the system."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:AssetCompliance.evidenceReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "evidence reference"@en ;
    rdfs:comment "Reference identifier or location of compliance evidence documentation for this asset-obligation pair (e.g., inspection report ID, test result document, audit file reference). Explicitly identified in detection reasoning as relationship data."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:string ;
    cmm:physicalColumn "evidence_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Evidence Reference" ;
    cmm:cimDatatype "String" .
cmm:AssetCompliance.lastAuditFinding a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last audit finding"@en ;
    rdfs:comment "Most recent audit finding specific to this asset's compliance with this obligation (pass, minor-finding, major-finding, observation)."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_audit_finding" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Audit Finding" ;
    cmm:cimDatatype "String" .
cmm:AssetCompliance.lastComplianceVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last compliance verification date"@en ;
    rdfs:comment "Date when compliance of this asset with this obligation was most recently verified through inspection, testing, or audit. Explicitly identified in detection reasoning as relationship data."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_compliance_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Compliance Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetCompliance.nextComplianceDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next compliance due date"@en ;
    rdfs:comment "Next scheduled date by which this asset must be verified for compliance with this obligation, based on the obligation's compliance frequency and asset-specific factors. Explicitly identified in detection reasoning as relationship data."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_compliance_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Compliance Due Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetCompliance.nonComplianceRiskScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "non compliance risk score"@en ;
    rdfs:comment "Calculated risk score for this asset-obligation pair based on asset criticality, obligation VRF/VSL, and current compliance status. Used for audit prioritization."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:int ;
    cmm:physicalColumn "non_compliance_risk_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Compliance Risk Score" ;
    cmm:cimDatatype "Integer" .
cmm:AssetCompliance.responsibleParty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible party"@en ;
    rdfs:comment "Name or identifier of the individual or organizational unit responsible for ensuring this asset's compliance with this obligation. Explicitly identified in detection reasoning as relationship data."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_party" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Party" ;
    cmm:cimDatatype "String" .
cmm:AssetCompliance.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this compliance record was last updated, reflecting changes in status, verification dates, or responsible parties."@en ;
    rdfs:domain cmm:AssetCompliance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:PpaAllocation a owl:Class ;
    rdfs:label "Ppa Allocation"@en ;
    rdfs:comment "This association product represents the allocation relationship between physical generation assets and renewable power purchase agreement contracts. It captures the contractual assignment of specific assets (or portions thereof) to PPA contracts for renewable attribute tracking, settlement, and RPS compliance. Each record links one asset to one PPA contract with allocation percentage, contracted capacity, pricing terms, and effective dates that exist only in the context of this specific asset-contract pairing.. Existence Justification: In utility-scale renewable energy procurement, portfolio PPAs routinely allocate generation from multiple physical assets (e.g., individual wind turbines, solar array sections, or entire generation facilities) to a single contract to aggregate capacity and meet volume commitments. Conversely, a single asset can participate in multiple PPAs simultaneously through time-slicing (baseload energy sold to one contract, renewable attributes to another), partial capacity allocation, or sequential contract assignments. The allocation relationship itself carries critical operational data including allocation percentage, asset-specific pricing, effective dates, and settlement meter assignments that belong to neither the asset nor the PPA alone."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.ppa_allocation" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.asset.ppa_allocation" ;
    owl:hasKey ( cmm:PpaAllocation.ppaAllocationId ) .

cmm:PpaAllocation.ppaAllocationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ppa allocation id"@en ;
    rdfs:comment "Unique identifier for this asset-PPA allocation record. Primary key."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:long ;
    cmm:physicalColumn "ppa_allocation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset PPA Allocation ID" ;
    cmm:cimDatatype "Integer" .
cmm:PpaAllocation.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the physical generation asset being allocated to this PPA contract"@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Ppa Allocation - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_ppa_allocation_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:PpaAllocation.renewablePpaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable ppa contract"@en ;
    rdfs:comment "Foreign key linking to the renewable PPA contract receiving this asset allocation"@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "renewable_ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Ppa Allocation - Renewable Ppa Contract Id" ;
    cmm:sourceColumn "ppa_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_ppa_allocation_renewable_ppa_contract_id" ;
    cmm:cimAssociation "IdentifiedObject.Agreement" .
cmm:PpaAllocation.settlementMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "settlement meter"@en ;
    rdfs:comment "Identifier of the revenue-quality meter used to measure generation from this asset for settlement under this PPA contract. Critical for multi-PPA scenarios where different meters or meter channels track output allocated to different contracts."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "settlement_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Settlement Meter ID" ;
    cmm:sourceColumn "meter_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_ppa_allocation_settlement_meter_id" ;
    cmm:cimAssociation "IdentifiedObject.Meter" .
cmm:PpaAllocation.allocationNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation notes"@en ;
    rdfs:comment "Free-text field capturing business context for this allocation, such as contract amendment references, reallocation justifications, or special settlement terms applicable to this asset-PPA pairing."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:PpaAllocation.allocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation percentage"@en ;
    rdfs:comment "Percentage of the asset's generation capacity or output allocated to this specific PPA contract. Allows partial allocation where a single asset serves multiple contracts or where portfolio PPAs aggregate multiple assets. Sum of allocation percentages across all PPAs for a given asset may equal or be less than 100%."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PpaAllocation.allocationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation status"@en ;
    rdfs:comment "Current operational status of this asset-PPA allocation: active (currently generating and settling), pending (approved but not yet effective), suspended (temporarily halted due to maintenance or curtailment), terminated (ended early), expired (reached contract_end_date). Drives settlement processing and REC transfer eligibility."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:PpaAllocation.contractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract end date"@en ;
    rdfs:comment "Effective end date when this asset's allocation to this PPA contract terminates. May differ from the PPA contract's overall effective_end_date if assets are removed from the contract early due to retirement, reallocation, or contract amendment."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation End Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaAllocation.contractStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract start date"@en ;
    rdfs:comment "Effective start date when this specific asset began contributing generation to this PPA contract. May differ from the PPA contract's overall effective_start_date if assets are added to the contract over time or if the asset was commissioned after contract inception."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PpaAllocation.contractedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted capacity mw"@en ;
    rdfs:comment "Portion of the asset's rated capacity (in MW) that is contractually committed to this specific PPA. For portfolio PPAs, this represents the asset's contribution to the total contracted capacity. Used for capacity payment calculations and contract compliance tracking."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocated Contracted Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PpaAllocation.contractedPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted price per mwh"@en ;
    rdfs:comment "Energy price in USD per MWh applicable to this specific asset-PPA pairing. May differ from the PPA's base_price_per_mwh if the contract has asset-specific pricing tiers, vintage-based pricing, or technology-specific rates. Used for settlement calculations."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset-Specific Contract Price" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PpaAllocation.recAllocationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec allocation flag"@en ;
    rdfs:comment "Indicates whether Renewable Energy Certificates (RECs) generated by this asset under this allocation are transferred to the utility per the PPA's rec_ownership terms. Supports scenarios where energy and RECs are sold separately or where only a portion of an asset's RECs are allocated to a specific PPA."@en ;
    rdfs:domain cmm:PpaAllocation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_allocation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "REC Allocation Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:ImpactAssessment a owl:Class ;
    rdfs:label "Impact Assessment"@en ;
    rdfs:comment "This association product represents the technical impact assessment between a utility asset and an interconnection application. It captures the engineering analysis of how a proposed distributed energy resource (DER) interconnection affects specific grid assets, including thermal loading, voltage regulation, protection coordination, and required upgrades. Each record links one asset to one interconnection application with impact-specific attributes that exist only in the context of this relationship. This is the foundation for cluster study formation, cost allocation, and queue management under FERC Order 2023 and state interconnection rules.. Existence Justification: In utility interconnection operations, a single interconnection application routinely impacts multiple grid assets (transformer, feeder, substation, protection devices) that must be analyzed for thermal, voltage, and protection impacts. Conversely, a single asset can be affected by multiple pending interconnection applications in the queue, requiring coordinated analysis to determine cumulative impacts and shared upgrade costs. Utilities actively manage these asset-application impact assessments as part of the technical review process, tracking impact type, severity, upgrade requirements, and cost allocation for each asset-application combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.impact_assessment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.asset.impact_assessment" ;
    owl:hasKey ( cmm:ImpactAssessment.impactAssessmentId ) .

cmm:ImpactAssessment.impactAssessmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact assessment id"@en ;
    rdfs:comment "Primary key for the asset_impact_assessment association"@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "impact_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Impact Assessment - Asset Impact Assessment Id" ;
    cmm:cimDatatype "Integer" .
cmm:ImpactAssessment.analyzedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "analyzed by employee"@en ;
    rdfs:comment "Reference to the utility engineer who performed the technical impact analysis for this asset-application combination. Used for accountability, quality assurance, and workload tracking."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "analyzed_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Analyzed By" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_impact_assessment_analyzed_by_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:ImpactAssessment.clusterStudyGroup a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cluster study group"@en ;
    rdfs:comment "Reference to the cluster study group that includes this asset impact assessment, if applicable. Under FERC Order 2023, multiple interconnection applications that impact the same assets may be grouped into cluster studies for coordinated analysis and cost allocation."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range cmm:ClusterStudyGroup ;
    cmm:physicalColumn "cluster_study_group_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cluster Study ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_impact_assessment_cluster_study_group_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ImpactAssessment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to the interconnection application being reviewed"@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Impact Assessment - Interconnection Application Id" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_impact_assessment_interconnection_application_id" ;
    cmm:cimAssociation "IdentifiedObject.Request" .
cmm:ImpactAssessment.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the utility asset being impacted by the interconnection application"@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Impact Assessment - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_impact_assessment_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:ImpactAssessment.affectedCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected capacity kw"@en ;
    rdfs:comment "Amount of asset capacity in kilowatts that is affected or consumed by the proposed DER interconnection. Used to determine hosting capacity impacts and whether the asset has sufficient remaining capacity for additional interconnection applications in the queue."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "affected_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:ImpactAssessment.analysisDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis date"@en ;
    rdfs:comment "Date when the technical impact analysis for this asset-application combination was performed by the utility review engineer. Used to track review timeline compliance with regulatory deadlines and to determine whether re-analysis is required if grid conditions change."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "analysis_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Analysis Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactAssessment.analysisStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis status"@en ;
    rdfs:comment "Current status of the impact analysis for this asset-application combination. Tracks progression through the technical review workflow and identifies when supplemental studies are required."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "analysis_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Analysis Status" ;
    cmm:cimDatatype "String" .
cmm:ImpactAssessment.estimatedCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated cost"@en ;
    rdfs:comment "Estimated cost in USD to upgrade or replace this asset to accommodate the proposed DER interconnection. Used for cost allocation across applications in cluster studies and to determine applicant financial responsibility under interconnection agreements."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Upgrade Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ImpactAssessment.impactSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact severity"@en ;
    rdfs:comment "Engineering assessment of the severity of impact the proposed DER has on this asset. Determines review tier escalation, supplemental study requirements, and priority for upgrade planning."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "impact_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impact Severity" ;
    cmm:cimDatatype "String" .
cmm:ImpactAssessment.impactType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact type"@en ;
    rdfs:comment "Category of technical impact the proposed DER has on this specific asset (thermal loading, voltage regulation, protection coordination, fault current contribution, stability, power quality). Determines the type of engineering analysis required and potential mitigation measures."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "impact_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Impact Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:ImpactAssessment.mitigationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mitigation required"@en ;
    rdfs:comment "Description of mitigation measures required to address the impact on this asset, such as protection relay upgrades, voltage regulator adjustments, transformer replacement, or operational restrictions on DER output."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "mitigation_required" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mitigation Required" ;
    cmm:cimDatatype "String" .
cmm:ImpactAssessment.upgradeRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade required flag"@en ;
    rdfs:comment "Indicates whether this asset requires upgrade or replacement to accommodate the proposed DER interconnection. Drives cost allocation and determines whether the application triggers network upgrade costs that may be shared across multiple applications in a cluster study."@en ;
    rdfs:domain cmm:ImpactAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "upgrade_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Upgrade Required Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:DerConnection a owl:Class ;
    rdfs:label "Der Connection"@en ;
    rdfs:comment "This association product represents the physical electrical connection between a utility asset and a distributed energy resource (DER) system. It captures the technical configuration, protection coordination, metering arrangement, and operational status of each connection point. Each record links one asset_registry entry to one der_system with attributes that exist only in the context of this specific interconnection configuration. Essential for distribution operations, protection coordination, outage management, and maintenance planning of DER-integrated grid infrastructure.. Existence Justification: In utility distribution operations, a single DER system (solar PV, battery storage, EV charger) physically connects to multiple utility assets at the point of interconnection - typically a service transformer, revenue meter, utility-accessible disconnect switch, and protection relay. Conversely, a single utility asset such as a distribution transformer or secondary service panel can serve multiple DER systems installed at different customer premises or even multiple DER systems at the same location. Each connection has unique technical attributes including metering configuration, protection coordination settings, connection capacity limits, and operational status that belong to the specific DER-asset pairing, not to either entity alone."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.der_connection" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEEE 1547" ;
    cmm:sourceObject "energy_utilities_ecm.asset.der_connection" ;
    owl:hasKey ( cmm:DerConnection.derConnectionId ) .

cmm:DerConnection.derConnectionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der connection id"@en ;
    rdfs:comment "Unique identifier for this specific connection between a utility asset and a DER system. Primary key for the association."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_connection_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset-DER Connection Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DerConnection.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to the distributed energy resource system that is physically connected to the utility asset"@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Der Connection - Der System Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_der_connection_der_system_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerElectronicsConnection" .
cmm:DerConnection.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the utility asset (transformer, meter, disconnect switch, protection relay) that serves as a connection point for the DER system"@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Der Connection - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_der_connection_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:DerConnection.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when this specific DER-asset connection was commissioned and placed into operational service. Marks the point when the physical connection was energized and the DER system began operating in coordination with the utility asset."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Connection Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:DerConnection.connectionCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection capacity kw"@en ;
    rdfs:comment "Maximum power capacity in kilowatts approved for this specific DER-asset connection point. May be lower than the DER system nameplate capacity if the utility asset has capacity constraints or if multiple DER systems share the same asset."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "connection_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerConnection.connectionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection type"@en ;
    rdfs:comment "Classification of the physical connection point type between the DER system and the utility asset. Identifies the specific electrical interface and connection configuration used for the interconnection."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "connection_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Connection Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:DerConnection.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this connection record was created in the system."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:DerConnection.disconnectSwitchAccessibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnect switch accessible flag"@en ;
    rdfs:comment "Indicates whether the utility-accessible disconnect switch for this DER-asset connection is readily accessible to utility crews for maintenance and emergency operations. Critical for outage response and safety procedures."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disconnect_switch_accessible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnect Switch Accessible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerConnection.exportLimitKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export limit kw"@en ;
    rdfs:comment "Maximum power export limit in kilowatts allowed for this specific DER-asset connection. May be constrained by asset capacity, feeder capacity, or interconnection agreement terms. Null if no export is permitted."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "export_limit_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Limit" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerConnection.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent physical inspection or testing of this DER-asset connection point. Used for maintenance tracking and compliance verification."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:DerConnection.meteringConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metering configuration"@en ;
    rdfs:comment "Specification of the metering arrangement and measurement configuration for this specific DER-asset connection. Defines how energy flow is measured and recorded for billing, settlement, and grid monitoring purposes."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "metering_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Metering Configuration" ;
    cmm:cimDatatype "String" .
cmm:DerConnection.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next required inspection or testing of this DER-asset connection based on utility maintenance standards and regulatory requirements."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:DerConnection.operatingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating status"@en ;
    rdfs:comment "Current operational status of this specific DER-asset connection. Indicates whether the connection is actively energized, temporarily suspended, under maintenance, or permanently decommissioned. Used for outage management and operational coordination."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "operating_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Operating Status" ;
    cmm:cimDatatype "String" .
cmm:DerConnection.poiVoltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts at the specific point where the DER system connects to this utility asset. Critical for protection coordination and equipment specification."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "poi_voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection Voltage Level" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DerConnection.protectionScheme a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection scheme"@en ;
    rdfs:comment "Description of the protection coordination scheme and relay settings applied to this specific DER-asset connection. Captures the protective relay configuration, trip settings, and coordination with upstream/downstream protection devices to ensure safe operation and fault isolation."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_scheme" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Scheme" ;
    cmm:cimDatatype "String" .
cmm:DerConnection.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this connection record was last updated."@en ;
    rdfs:domain cmm:DerConnection ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:ProjectPermit a owl:Class ;
    rdfs:label "Project Permit"@en ;
    rdfs:comment "This association product represents the regulatory compliance relationship between capital projects and environmental permits. It captures permit-specific compliance tracking, verification activities, and mitigation measures required for each project-permit combination. Each record links one capital project to one environmental permit with attributes that exist only in the context of this regulatory compliance relationship.. Existence Justification: Capital projects in energy utilities require multiple environmental permits (EPA Title V air permits, NPDES water discharge permits, wetlands permits, endangered species authorizations) depending on project scope and location. Each permit applies to multiple projects over its validity period. Environmental compliance officers actively manage project-permit relationships by tracking compliance with specific permit conditions, conducting verification activities, documenting mitigation measures, and coordinating regulatory inspections for each project-permit combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.project_permit" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.asset.project_permit" ;
    owl:hasKey ( cmm:ProjectPermit.projectPermitId ) .

cmm:ProjectPermit.projectPermitId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project permit id"@en ;
    rdfs:comment "Unique identifier for this project-permit compliance relationship. Primary key."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:long ;
    cmm:physicalColumn "project_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Project Permit Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ProjectPermit.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Foreign key linking to the capital project requiring environmental permit compliance"@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Permit - Capital Project Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_project_permit_capital_project_id" ;
    cmm:cimAssociation "IdentifiedObject.Project" .
cmm:ProjectPermit.complianceEnvironmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance environmental permit"@en ;
    rdfs:comment "Foreign key linking to the environmental permit governing this project"@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "compliance_environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Permit - Compliance Environmental Permit Id" ;
    cmm:sourceColumn "environmental_permit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_project_permit_compliance_environmental_permit_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ProjectPermit.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of the capital project with respect to this specific permit and condition. Tracks whether the project meets permit requirements."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:cimDatatype "String" .
cmm:ProjectPermit.environmentalPermitNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit number"@en ;
    rdfs:comment "Reference number for environmental permits required for the capital project, issued by EPA or state environmental agencies. [Moved from capital_project: This attribute in capital_project appears to reference a single permit, but in reality capital projects require multiple permits. This attribute should be removed from capital_project as the relationship is properly modeled through the project_permit association, which can link to multiple permits and track permit-specific compliance details.]"@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "environmental_permit_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Environmental Permit Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ProjectPermit.mitigationMeasureDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mitigation measure description"@en ;
    rdfs:comment "Description of specific mitigation measures, controls, or corrective actions implemented for this project to comply with this permit condition. May include engineering controls, monitoring protocols, or operational restrictions."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "mitigation_measure_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mitigation Measure Description" ;
    cmm:cimDatatype "String" .
cmm:ProjectPermit.nextInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection date"@en ;
    rdfs:comment "Scheduled date for the next regulatory inspection or compliance verification for this project-permit combination."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectPermit.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional notes, comments, or documentation references related to permit compliance for this specific project."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Compliance Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ProjectPermit.permitApplicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permit application date"@en ;
    rdfs:comment "Date when the permit application was submitted for this specific project. Relevant for project-specific permits or permit modifications required for the capital project."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "permit_application_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permit Application Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectPermit.permitApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permit approval date"@en ;
    rdfs:comment "Date when the permit was approved or modified to cover this capital project. Critical for tracking project schedule dependencies on regulatory approvals."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "permit_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permit Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectPermit.permitConditionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permit condition number"@en ;
    rdfs:comment "Specific permit condition number or reference that applies to this capital project. Each permit may have multiple conditions, and projects must track compliance with specific applicable conditions."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "permit_condition_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Permit Condition Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ProjectPermit.responsibleParty a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible party"@en ;
    rdfs:comment "Name or identifier of the individual or team responsible for ensuring compliance with this permit condition for this specific project. May be project manager, environmental coordinator, or compliance officer."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_party" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Party" ;
    cmm:cimDatatype "String" .
cmm:ProjectPermit.verificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification date"@en ;
    rdfs:comment "Date when compliance with this permit condition was last verified by environmental compliance staff or regulatory inspectors."@en ;
    rdfs:domain cmm:ProjectPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Verification Date" ;
    cmm:cimDatatype "Date" .


#################################################################
# Subject area: billing
#################################################################

cmm:RateSchedule a owl:Class ;
    rdfs:label "Rate Schedule"@en ;
    rdfs:comment "Master reference entity defining tariff rate schedules and their granular charge components applicable to customer accounts. At the schedule level: stores rate code, effective dates, rate class, voltage level, applicable customer segments, regulatory approval references, and jurisdiction. At the component level: captures individual charge elements including energy charges ($/kWh), demand charges ($/kW), customer charges, fuel adjustment clauses, distribution charges, transmission charges, and riders with component type, unit of measure, tier thresholds, seasonal applicability, time-of-use period mapping, and calculation formula. Sourced from SAP IS-U and Oracle CC&B rate configuration modules. SSOT for all rate definitions and charge component structures used in bill calculation. Supports rate case filings and regulatory tariff compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Tariff ;
    cmm:cimExactMatch cim:Tariff ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.rate_management ;
    cmm:physicalTable "utility_cmm_silver.billing.rate_schedule" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "IEC 61968-8; Tariff Rate Schedule" ;
    cmm:sourceObject "energy_utilities_ecm.billing.rate_schedule" ;
    owl:hasKey ( cmm:RateSchedule.rateScheduleId ) .

cmm:RateSchedule.rateScheduleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule id"@en ;
    rdfs:comment "Unique identifier for the rate schedule. Primary key for the rate schedule master reference entity."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Rate Schedule ID" ;
    cmm:cimDatatype "Integer" .
cmm:RateSchedule.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Rate schedules are designed to recover costs projected in IRP scenarios. Regulatory rate cases reference specific IRP scenarios for cost recovery justification. Utilities track which IRP scenario info"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_irp_scenario_id" ;
    cmm:cimAssociation "Tariff.Document" .
cmm:RateSchedule.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Dynamic retail tariffs indexed to real-time or day-ahead LMP require direct price reference for automated rate calculation, regulatory cost recovery validation, and customer bill transparency in real-"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_lmp_price_id" ;
    cmm:cimAssociation "Tariff.PnodeResults" .
cmm:RateSchedule.peakDemand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand"@en ;
    rdfs:comment "Foreign key linking to forecast.peak_demand. Business justification: Demand charge rate schedules are designed to recover capacity costs allocated based on peak demand forecasts. Rate design documents reference specific peak demand forecasts (by customer class and seas"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:PeakDemand ;
    cmm:physicalColumn "peak_demand_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Peak Demand Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_peak_demand_id" ;
    cmm:cimAssociation "Tariff.RegularIntervalSchedule" .
cmm:RateSchedule.rateCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case"@en ;
    rdfs:comment "Foreign key linking to compliance.rate_case. Business justification: Rate schedules in billing are approved through regulatory rate case proceedings tracked in compliance. This is a fundamental regulatory relationship in utility operations - every tariff/rate schedule"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:RateCase ;
    cmm:physicalColumn "rate_case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Case Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_rate_case_id" ;
    cmm:cimAssociation "Tariff.Document" .
cmm:RateSchedule.renewableIncentiveProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable incentive program"@en ;
    rdfs:comment "Foreign key linking to renewable.incentive_program. Business justification: Rate schedules incorporate renewable incentive program terms for green tariff pricing, renewable energy riders, and regulatory compliance. Tariff design requires linking incentive program rates to bil"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:IncentiveProgram ;
    cmm:physicalColumn "renewable_incentive_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Incentive Program Id (Foreign Key)" ;
    cmm:sourceColumn "incentive_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_renewable_incentive_program_id" ;
    cmm:cimAssociation "Tariff.Document" .
cmm:RateSchedule.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Foreign key linking to distribution.service_territory. Business justification: Rate schedules are approved by regulatory jurisdiction tied to service territory. Required for tariff management, rate case filings, and ensuring customers are billed under correct jurisdictional rate"@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_rate_schedule_service_territory_id" ;
    cmm:cimAssociation "Tariff.SubGeographicalRegion" .
cmm:RateSchedule.billingCycleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle type"@en ;
    rdfs:comment "Standard billing frequency applicable to customers on this rate schedule."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_cycle_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Cycle Type" ;
    cmm:validValues "monthly|bimonthly|quarterly|annual|on_demand" ;
    cmm:cimDatatype "String" .
cmm:RateSchedule.budgetBillingEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing eligible"@en ;
    rdfs:comment "Indicates whether customers on this rate schedule are eligible for budget billing or levelized payment plans."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:boolean ;
