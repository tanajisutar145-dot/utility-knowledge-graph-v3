cmm:FacilityAuditScope a owl:Class ;
    rdfs:label "Facility Audit Scope"@en ;
    rdfs:comment "This association product represents the audit scope relationship between power_plant and audit. It captures the specific inclusion of a generation facility within a compliance audit's scope, including facility-specific findings, audit activities, and closure status. Each record links one power_plant to one audit with attributes that exist only in the context of this facility being audited.. Existence Justification: In energy utilities compliance operations, audits routinely cover multiple generation facilities (a NERC CIP audit may examine 10+ plants, an EPA inspection may cover all coal plants in a region), and each facility undergoes multiple audits over time (NERC reliability, FERC market behavior, state PUC, EPA environmental). The business actively manages facility-specific audit scope, tracks findings per facility, assigns facility coordinators, and closes findings independently per facility even within the same audit."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.fuel_management ;
    cmm:physicalTable "utility_cmm_silver.generation.facility_audit_scope" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.generation.facility_audit_scope" ;
    owl:hasKey ( cmm:FacilityAuditScope.facilityAuditScopeId ) .

cmm:FacilityAuditScope.facilityAuditScopeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility audit scope id"@en ;
    rdfs:comment "Unique identifier for this facility-audit scope record. Primary key."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:long ;
    cmm:physicalColumn "facility_audit_scope_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Facility Audit Scope Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FacilityAuditScope.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to the compliance audit under which this facility is being examined"@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility Audit Scope - Audit Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_facility_audit_scope_audit_id" ;
    cmm:cimAssociation "IdentifiedObject.ActivityRecord" .
cmm:FacilityAuditScope.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to the generation facility included in the audit scope"@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility Audit Scope - Power Plant Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_facility_audit_scope_power_plant_id" ;
    cmm:cimAssociation "IdentifiedObject.Plant" .
cmm:FacilityAuditScope.auditDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit date"@en ;
    rdfs:comment "Date when audit activities were conducted at this specific facility (site visit, inspection, or evidence review). May differ from overall audit start/end dates when audit covers multiple facilities over time."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "audit_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Audit Date" ;
    cmm:cimDatatype "Date" .
cmm:FacilityAuditScope.closureStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure status"@en ;
    rdfs:comment "Current closure status for this facility's portion of the audit. Tracks whether findings for this specific facility have been addressed and closed by the auditing body. Status can vary by facility within a multi-facility audit."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "closure_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Audit Closure Status" ;
    cmm:cimDatatype "String" .
cmm:FacilityAuditScope.criticalFindingsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical findings count"@en ;
    rdfs:comment "Number of critical or severe findings identified specifically for this facility during this audit."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:int ;
    cmm:physicalColumn "critical_findings_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Critical Findings Count" ;
    cmm:cimDatatype "Integer" .
cmm:FacilityAuditScope.facilityClosureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility closure date"@en ;
    rdfs:comment "Date when all findings and corrective actions for this specific facility were closed by the auditing body. May differ from overall audit closure date when facilities close at different times."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "facility_closure_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Audit Closure Date" ;
    cmm:cimDatatype "Date" .
cmm:FacilityAuditScope.facilityCoordinatorEmail a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility coordinator email"@en ;
    rdfs:comment "Email address of the facility audit coordinator for this facility-audit scope."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_coordinator_email" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Facility Audit Coordinator Email" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_email" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "ElectronicAddress.email1" .
cmm:FacilityAuditScope.facilityCoordinatorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility coordinator name"@en ;
    rdfs:comment "Name of the utility employee at this facility who coordinated audit activities, provided access, and gathered evidence for this facility's portion of the audit."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_coordinator_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Audit Coordinator Name" ;
    cmm:cimDatatype "String" .
cmm:FacilityAuditScope.facilityPenaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility penalty amount"@en ;
    rdfs:comment "Monetary penalty assessed specifically for violations identified at this facility during this audit. Penalties are often assessed per facility based on facility-specific violations."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "facility_penalty_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Penalty Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FacilityAuditScope.findingsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "findings count"@en ;
    rdfs:comment "Number of audit findings, violations, or observations identified specifically for this facility during this audit. Derived from child finding records but denormalized for reporting."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:int ;
    cmm:physicalColumn "findings_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Findings Count" ;
    cmm:cimDatatype "Integer" .
cmm:FacilityAuditScope.includedInScopeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "included in scope flag"@en ;
    rdfs:comment "Boolean flag indicating whether this facility was ultimately included in the final audit scope. Facilities may be initially listed but excluded during scoping phase."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "included_in_scope_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Included in Scope Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FacilityAuditScope.leadAuditorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lead auditor name"@en ;
    rdfs:comment "Name of the auditor from the auditing body who led the audit activities at this specific facility. May differ from the overall audit lead auditor when audit teams are divided across multiple facilities."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "lead_auditor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Lead Auditor Name" ;
    cmm:cimDatatype "String" .
cmm:FacilityAuditScope.scopeAddedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scope added date"@en ;
    rdfs:comment "Date when this facility was added to the audit scope. Tracks when the facility-audit relationship was established."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "scope_added_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scope Added Date" ;
    cmm:cimDatatype "Date" .
cmm:FacilityAuditScope.scopeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scope description"@en ;
    rdfs:comment "Detailed description of what aspects of this specific facility are included in the audit scope (e.g., 'NERC CIP-002 through CIP-009 compliance for critical cyber assets', 'EPA Title V air emissions permit compliance', 'Generation unit 1 and 2 only'). Scope varies by facility even within the same audit."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "scope_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Facility-Specific Audit Scope Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:FacilityAuditScope.scopeRemovedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scope removed date"@en ;
    rdfs:comment "Date when this facility was removed from the audit scope, if applicable. Null if facility remains in scope."@en ;
    rdfs:domain cmm:FacilityAuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "scope_removed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scope Removed Date" ;
    cmm:cimDatatype "Date" .

cmm:PlantCrewAssignment a owl:Class ;
    rdfs:label "Plant Crew Assignment"@en ;
    rdfs:comment "This association product represents the Assignment between power_plant and crew. It captures the operational assignment of field crews to generation facilities for operations, maintenance, environmental compliance, security, and emergency response work. Each record links one power_plant to one crew with attributes that define the assignment period, crew function, assignment priority, and emergency response role. Critical for resource planning, mutual aid coordination, regulatory staffing compliance (NERC CIP personnel requirements), and outage work scheduling.. Existence Justification: In energy utilities generation operations, power plants require multiple specialized crews assigned simultaneously for different functions (operations, maintenance, environmental compliance, security, outage work). Crews are routinely assigned to multiple plants within a generation fleet, particularly in regions where plants are geographically clustered. The business actively manages these assignments with specific start/end dates, primary vs. backup designations, emergency response roles, and NERC CIP compliance tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Assignment ;
    cmm:cimCloseMatch cim:Assignment ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.fuel_management ;
    cmm:physicalTable "utility_cmm_silver.generation.plant_crew_assignment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.generation.plant_crew_assignment" ;
    owl:hasKey ( cmm:PlantCrewAssignment.plantCrewAssignmentId ) .

cmm:PlantCrewAssignment.plantCrewAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plant crew assignment id"@en ;
    rdfs:comment "Unique identifier for the plant-crew assignment record. Primary key."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "plant_crew_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Plant Crew Assignment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PlantCrewAssignment.assignedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned by employee"@en ;
    rdfs:comment "Reference to the plant manager or operations supervisor who authorized this crew assignment. Used for audit trail and assignment approval workflow."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "assigned_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned By Employee" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_plant_crew_assignment_assigned_by_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:PlantCrewAssignment.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Foreign key linking to the field crew assigned to the generation facility"@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant Crew Assignment - Crew Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_plant_crew_assignment_crew_id" ;
    cmm:cimAssociation "Assignment.Crew" .
cmm:PlantCrewAssignment.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to the generation facility where the crew is assigned"@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant Crew Assignment - Power Plant Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_plant_crew_assignment_power_plant_id" ;
    cmm:cimAssociation "Assignment.Plant" .
cmm:PlantCrewAssignment.assignmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment end date"@en ;
    rdfs:comment "Date when the crew assignment to the generation facility ended or is planned to end. Null for ongoing assignments. Critical for tracking temporary assignments during outages or mutual aid deployments."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment End Date" ;
    cmm:cimDatatype "Date" .
cmm:PlantCrewAssignment.assignmentNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment notes"@en ;
    rdfs:comment "Free-text notes about the assignment including special instructions, temporary restrictions, or coordination requirements with other crews."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:PlantCrewAssignment.assignmentStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment start date"@en ;
    rdfs:comment "Date when the crew assignment to the generation facility became effective. Used for resource planning and historical tracking of crew deployments."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PlantCrewAssignment.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Current lifecycle status of the crew assignment. Active assignments are used for dispatch and cost allocation. Suspended assignments indicate temporary unavailability (e.g., crew deployed elsewhere)."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.status .
cmm:PlantCrewAssignment.costAllocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation percentage"@en ;
    rdfs:comment "Percentage of crew labor costs allocated to this plant assignment. Used when a crew is split across multiple facilities. Sum of percentages across all assignments for a crew should equal 100%."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PlantCrewAssignment.crewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type"@en ;
    rdfs:comment "Classification of the crew function for this specific assignment. A crew may serve different functions at different plants. Determines work authorization, safety protocols, and regulatory compliance requirements."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Assignment.type .
cmm:PlantCrewAssignment.emergencyResponseRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency response role"@en ;
    rdfs:comment "Defines the crew's role in emergency response scenarios at this facility. Critical for NERC CIP compliance, emergency action plan (EAP) execution, and mutual aid coordination during grid emergencies."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_response_role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Response Role" ;
    cmm:cimDatatype "String" .
cmm:PlantCrewAssignment.nercCipComplianceVerifiedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip compliance verified date"@en ;
    rdfs:comment "Date when crew members' NERC CIP personnel risk assessments were verified for this specific facility. Required for crews working in CIP-designated critical cyber assets or physical security perimeters."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "nerc_cip_compliance_verified_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP Compliance Verified Date" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Date" .
cmm:PlantCrewAssignment.primaryAssignmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary assignment flag"@en ;
    rdfs:comment "Indicates whether this is the crew's primary plant assignment (true) or a secondary/backup assignment (false). Primary assignments determine home base for crew scheduling and cost allocation."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "primary_assignment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Assignment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PlantCrewAssignment.workAuthorizationLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work authorization level"@en ;
    rdfs:comment "Level of access and work authorization the crew has at this specific facility. Varies by NERC CIP security zone, plant type, and crew certification level. Determines which work orders can be assigned."@en ;
    rdfs:domain cmm:PlantCrewAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_authorization_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Authorization Level" ;
    cmm:cimDatatype "String" .


#################################################################
# Subject area: grid
#################################################################

cmm:ControlArea a owl:Class ;
    rdfs:label "Control Area"@en ;
    rdfs:comment "Master record for a balancing authority control area — the fundamental geographic and electrical boundary within which the EMS/SCADA system maintains real-time generation-load balance, frequency regulation, and interchange scheduling. Captures control area identifier, NERC registered entity ID, balancing authority code, nominal frequency (60 Hz), ACE (Area Control Error) tolerance limits, tie-line list, interchange schedule references, and regulatory jurisdiction. SSOT for control area identity used across grid operations, trading, and NERC BAL compliance reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ControlArea ;
    cmm:cimExactMatch cim:ControlArea ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::ControlArea" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.market_scheduling ;
    cmm:physicalTable "utility_cmm_silver.grid.control_area" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "NERC BAL; NERC BAL-001 Balancing Authority Area" ;
    cmm:sourceObject "energy_utilities_ecm.grid.control_area" ;
    owl:hasKey ( cmm:ControlArea.controlAreaId ) .

cmm:ControlArea.controlAreaId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control area id"@en ;
    rdfs:comment "Unique identifier for the balancing authority control area. Primary key for the control area master record."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:long ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Control Area Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ControlArea.contactEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contact employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Control areas require designated responsible operator for NERC CPS1/CPS2 accountability and reliability coordinator communications. 'contact_name/phone/email' denormalized fields should be FK to emplo"@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "contact_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contact Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_contact_employee_id" ;
    cmm:cimAssociation "ControlArea.ErpPersonnel" .
cmm:ControlArea.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Control areas are operational units that incur costs (staffing, SCADA, EMS maintenance). Finance tracks these costs by control area for FERC Form 1 reporting, rate case cost allocation, and operationa"@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_cost_center_id" ;
    cmm:cimAssociation "ControlArea.Organisation" .
cmm:ControlArea.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Control areas represent distinct operational/geographic segments for P&L reporting. Utilities track revenue and costs by control area for segment reporting, regulatory jurisdiction analysis, and RTO/I"@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_profit_center_id" ;
    cmm:cimAssociation "ControlArea.Organisation" .
cmm:ControlArea.program a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "program"@en ;
    rdfs:comment "Foreign key linking to compliance.program. Business justification: Each control area operates under a NERC Reliability Standards compliance program. This link tracks which compliance program governs the control area's operations, enabling audit scoping, program effec"@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_program_id" ;
    cmm:cimAssociation "ControlArea.Document" .
cmm:ControlArea.aceToleranceLimitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ace tolerance limit mw"@en ;
    rdfs:comment "Maximum allowable Area Control Error in megawatts before corrective action is required, used for automatic generation control and NERC BAL-001 compliance."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ace_tolerance_limit_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Area Control Error (ACE) Tolerance Limit (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.agcMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc mode"@en ;
    rdfs:comment "Current operating mode of the automatic generation control system for this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "agc_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Mode" ;
    cmm:validValues "automatic|manual|off|test" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.balancingAuthorityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority name"@en ;
    rdfs:comment "Full legal name of the balancing authority organization operating this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority Name" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.contingencyAnalysisEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis enabled"@en ;
    rdfs:comment "Indicates whether real-time contingency analysis is active for N-1 and N-2 security assessment."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:ControlArea.controlAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control area code"@en ;
    rdfs:comment "Short alphanumeric code identifying the control area, typically 2-6 uppercase letters used in interchange scheduling and NERC reporting."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Control Area Code" ;
    cmm:valuePattern "^[A-Z]{2,6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ControlArea.cps1TargetPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps1 target percentage"@en ;
    rdfs:comment "Target CPS1 compliance percentage (minimum 100%) measuring the control area's contribution to interconnection frequency error over a rolling 12-month period."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cps1_target_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 1 (CPS1) Target Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ControlArea.cps2LimitPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cps2 limit percentage"@en ;
    rdfs:comment "CPS2 compliance limit percentage (minimum 90%) measuring the control area's ACE performance within defined bounds during 10-minute periods."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cps2_limit_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Performance Standard 2 (CPS2) Limit Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ControlArea.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this control area master record was first created in the system."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ControlArea.createdDateTime .
cmm:ControlArea.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system from which this control area record originated (e.g., EMS, SCADA, PI Historian, NERC Registry)."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.disturbanceControlStandardMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance control standard mw"@en ;
    rdfs:comment "Most severe single contingency loss in megawatts that the control area must be prepared to recover from within 15 minutes, per NERC BAL-002 standard."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disturbance_control_standard_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disturbance Control Standard (DCS) Obligation (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this control area ceased operations or when the current configuration was superseded, null if currently active."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ControlArea.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this control area became operational or when the current configuration became effective."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ControlArea.emsSystemName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems system name"@en ;
    rdfs:comment "Name or identifier of the primary EMS platform used for real-time monitoring and control of this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_system_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Name" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.frequencyBiasSettingMwPerHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency bias setting mw per hz"@en ;
    rdfs:comment "Frequency bias setting in MW per 0.1 Hz used in ACE calculation, representing the control area's expected response to frequency deviations."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
