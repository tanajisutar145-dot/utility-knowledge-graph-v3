cmm:PowerPlant.rampRateMwPerMinute a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per minute"@en ;
    rdfs:comment "Maximum rate at which the plant can increase or decrease generation output, measured in MW per minute."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:decimal ;
