cmm:ContractorCompany.headquartersLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "headquarters location"@en ;
    rdfs:comment "City and country of the contractor's corporate headquarters."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "headquarters_location" ;
