    cmm:cimCloseMatch cim:ErpCompetency.status .
cmm:EmployeeQualification.qualificationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualification type"@en ;
    rdfs:comment "Category of internal qualification awarded to the employee. Represents utility-specific competency assessments distinct from external certifications. Examples include journeyman lineman qualification, substation operator qualification, generation unit operator qualification, and Supervisory Control and Data Acquisition (SCADA) operator authorization. Reference-value candidates: journeyman_lineman|substation_operator|generation_unit_operator|scada_operator|distribution_operator|transmission_operator|relay_technician|metering_technician|apprentice_lineman|control_room_operator|field_service_technician|protection_engineer."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "qualification_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Qualification Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpCompetency.kind .
cmm:EmployeeQualification.renewalFrequencyMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal frequency months"@en ;
    rdfs:comment "Number of months between required renewals or reassessments for this qualification. Common values include 12, 24, or 36 months. Null for qualifications that do not require renewal."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:int ;
    cmm:physicalColumn "renewal_frequency_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Frequency in Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:EmployeeQualification.renewalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal required flag"@en ;
    rdfs:comment "Indicates whether this qualification requires periodic renewal or reassessment. True for qualifications with defined expiration dates; false for lifetime qualifications such as journeyman status."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "renewal_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmployeeQualification.revocationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revocation date"@en ;
    rdfs:comment "Date on which the qualification was revoked or permanently withdrawn. Populated only for qualifications with status of revoked. Used for compliance investigations and workforce incident analysis."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:date ;
    cmm:physicalColumn "revocation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revocation Date" ;
    cmm:cimDatatype "Date" .
cmm:EmployeeQualification.revocationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revocation reason"@en ;
    rdfs:comment "Explanation for why the qualification was revoked, such as safety violation, failed reassessment, disciplinary action, or medical disqualification. Critical for audit trail and regulatory reporting."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "revocation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revocation Reason" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.sourceRecordReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source record reference"@en ;
    rdfs:comment "Unique identifier of this qualification record in the source operational system. Enables traceability back to the system of record for audit and troubleshooting."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_record_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Record Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the operational system from which this qualification record originated. Examples include SAP HCM, Learning Management System (LMS), or legacy training database. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.trainingProgramCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training program code"@en ;
    rdfs:comment "Code identifying the formal training program or apprenticeship that prepared the employee for this qualification. Links to training curriculum and course completion records."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "training_program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Training Program Code" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.unionClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union classification"@en ;
    rdfs:comment "Union job classification or trade designation associated with this qualification, as defined in the collective bargaining agreement. Examples include IBEW Journeyman Lineman, IBEW Substation Electrician, or Operating Engineers classifications."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Classification" ;
    cmm:cimDatatype "String" .
cmm:EmployeeQualification.voltageClassAuthorization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage class authorization"@en ;
    rdfs:comment "Voltage levels the employee is qualified to work on, expressed in kilovolts (kV). Examples include distribution (up to 35 kV), sub-transmission (35-115 kV), transmission (115-765 kV). Critical for lineman and substation operator qualifications."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_class_authorization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
