    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Notification Preference Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:NotificationPreference.supersededNotificationPreference a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded notification preference"@en ;
    rdfs:comment "Self-referencing FK on notification_preference (superseded_notification_preference_id)"@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range cmm:NotificationPreference ;
    cmm:physicalColumn "superseded_notification_preference_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_notification_preference_superseded_notification_preference_id" ;
    cmm:cimAssociation "CustomerNotification.CustomerNotification" .
cmm:NotificationPreference.channelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel type"@en ;
    rdfs:comment "The communication channel through which the notification is delivered."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.code a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "code"@en ;
    rdfs:comment "Compact alphanumeric code used to reference the notification preference in downstream systems."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "notification_preference_code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:NotificationPreference.complianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance flag"@en ;
    rdfs:comment "Indicates the regulatory regime governing this notification preference."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the preference record was first created in the system."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CustomerNotification.createdDateTime .
cmm:NotificationPreference.deliveryMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery method"@en ;
    rdfs:comment "Indicates whether the notification is sent automatically by the system or manually by an operator."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "delivery_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Detailed description of what the notification preference entails and when it is used."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "notification_preference_description" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:IdentifiedObject.description .
cmm:NotificationPreference.effectiveFrom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective from"@en ;
    rdfs:comment "Date on which the notification preference becomes active."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_from" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:NotificationPreference.effectiveUntil a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective until"@en ;
    rdfs:comment "Date after which the notification preference is no longer valid; null if open-ended."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_until" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:NotificationPreference.format a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "format"@en ;
    rdfs:comment "Specifies whether the notification content is formatted as HTML or plain text."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "format" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.isDefault a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is default"@en ;
    rdfs:comment "True if this preference is the default option for customers who have not selected a specific preference."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_default" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Boolean" .
cmm:NotificationPreference.isOptInRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is opt in required"@en ;
    rdfs:comment "True if customers must explicitly opt-in to receive notifications via this channel."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_opt_in_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Boolean" .
cmm:NotificationPreference.language a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "ISO 639-1 two-letter code representing the language of the notification content."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "language" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.maxRetryAttempts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max retry attempts"@en ;
    rdfs:comment "Maximum number of retry attempts if delivery fails."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:int ;
    cmm:physicalColumn "max_retry_attempts" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:NotificationPreference.name a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Human-readable name of the notification preference."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "notification_preference_name" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:IdentifiedObject.name .
cmm:NotificationPreference.priorityOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority order"@en ;
    rdfs:comment "Numeric rank used to order preferences when multiple are applicable; lower numbers indicate higher priority."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_order" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:NotificationPreference.regulatoryReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reference"@en ;
    rdfs:comment "Reference to the specific regulation or policy that mandates this notification preference."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:NotificationPreference.retryIntervalMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retry interval minutes"@en ;
    rdfs:comment "Number of minutes to wait between successive retry attempts."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:int ;
    cmm:physicalColumn "retry_interval_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:NotificationPreference.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current lifecycle status of the notification preference."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "notification_preference_status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CustomerNotification.status .
cmm:NotificationPreference.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to the preference record."@en ;
    rdfs:domain cmm:NotificationPreference ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .


#################################################################
# Subject area: demand
#################################################################

cmm:DrProgram a owl:Class ;
    rdfs:label "Dr Program"@en ;
    rdfs:comment "Master record for each Demand Response program offered by the utility, including direct load control, interruptible tariff, CPP, TOU, behavioral DR (with delivery channel, peer comparison methodology, gamification rules, and engagement scoring parameters), VPP aggregation, and wholesale market DR products. Captures program type, ISO/RTO registration, enrolled capacity targets, incentive structure, measurement and verification methodology, regulatory authorization (PUC/FERC), program lifecycle status, performance reporting obligations, and behavioral campaign parameters. SSOT for all DR program definitions including behavioral DR campaign configurations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:DemandResponseProgram ;
    cmm:cimExactMatch cim:DemandResponseProgram ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.program_management ;
    cmm:physicalTable "utility_cmm_silver.demand.dr_program" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-9; OpenADR 2.0b; FERC Order 2222 DR Program Registry; NERC Demand Response Availability Report" ;
    cmm:sourceObject "energy_utilities_ecm.demand.dr_program" ;
    owl:hasKey ( cmm:DrProgram.drProgramId ) .

cmm:DrProgram.drProgramId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dr program id"@en ;
    rdfs:comment "Unique identifier for the demand response program. Primary key."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:long ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Demand Response (DR) Program Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DrProgram.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: DR programs are designed within control area operational boundaries to meet reserve requirements and reliability standards. Needed for capacity planning, NERC reserve margin calculations, and coordina"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_control_area_id" ;
    cmm:cimAssociation "DemandResponseProgram.ControlArea" .
cmm:DrProgram.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: DR programs are managed as cost centers for budget tracking and expense allocation. Program_budget_annual and operational costs require cost center assignment for financial reporting and regulatory co"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_cost_center_id" ;
    cmm:cimAssociation "DemandResponseProgram.Organisation" .
cmm:DrProgram.equipmentVendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "equipment vendor"@en ;
    rdfs:comment "Foreign key linking to supply.vendor. Business justification: DR programs contract with vendors for equipment/services (smart thermostats, load control devices). Business process: vendor performance tracking, procurement management, warranty administration for p"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "equipment_vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Equipment Vendor Id (Foreign Key)" ;
    cmm:sourceColumn "vendor_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_equipment_vendor_id" ;
    cmm:cimAssociation "DemandResponseProgram.Organisation" .
cmm:DrProgram.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: DR programs are designed for specific geographic zones with zone-specific load characteristics, peak demand patterns, and capacity requirements. Essential for program design, enrollment targeting, and"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_forecast_zone_id" ;
    cmm:cimAssociation "DemandResponseProgram.LoadArea" .
cmm:DrProgram.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: DR programs require DER interconnection approval before enrollment eligibility. ISO/RTO capacity market registration tracking needs interconnection status verification. Program managers validate inter"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_interconnection_application_id" ;
    cmm:cimAssociation "DemandResponseProgram.Request" .
cmm:DrProgram.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: DR programs must comply with specific regulatory obligations (NERC reliability standards, FERC Order 2222, state PUC DR requirements). Essential for compliance tracking, audit evidence, and regulatory"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_obligation_id" ;
    cmm:cimAssociation "DemandResponseProgram.Document" .
cmm:DrProgram.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: DR programs generate revenue through capacity payments and incentive structures that must be allocated to profit centers for P&L reporting, FERC Form 1 functional classification, and rate case cost-be"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_profit_center_id" ;
    cmm:cimAssociation "DemandResponseProgram.Organisation" .
cmm:DrProgram.programManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "program manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: DR programs are managed by specific utility employees who design incentive structures, manage budgets, coordinate with ISO/RTOs, and ensure regulatory compliance. Program_manager_name denormalizes emp"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "program_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Program Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_program_manager_employee_id" ;
    cmm:cimAssociation "DemandResponseProgram.ErpPersonnel" .
cmm:DrProgram.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Foreign key linking to distribution.service_territory. Business justification: DR programs are designed, approved, and operated within specific service territories due to regulatory jurisdiction, franchise boundaries, tariff structures, and eligibility rules. Essential for progr"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_service_territory_id" ;
    cmm:cimAssociation "DemandResponseProgram.SubGeographicalRegion" .
cmm:DrProgram.transmissionPlanningStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission planning study"@en ;
    rdfs:comment "Foreign key linking to transmission.planning_study. Business justification: Transmission planning studies evaluate DR programs as non-wires alternatives to transmission upgrades. FERC Order 1000 and state IRP processes require utilities to assess DR capacity in transmission p"@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range cmm:PlanningStudy ;
    cmm:physicalColumn "transmission_planning_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Planning Study Id (Foreign Key)" ;
    cmm:sourceColumn "planning_study_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_program_transmission_planning_study_id" ;
    cmm:cimAssociation "DemandResponseProgram.Document" .
cmm:DrProgram.amiRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami required flag"@en ;
    rdfs:comment "Indicates whether customer must have Advanced Metering Infrastructure (smart meter) installed to participate in this demand response program. True for programs requiring interval data; False for programs using deemed savings or aggregated measurements."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ami_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrProgram.baselineAdjustmentCapPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline adjustment cap percent"@en ;
    rdfs:comment "Maximum percentage adjustment allowed to baseline calculation to account for day-of variations. Prevents gaming and ensures baseline accuracy."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_adjustment_cap_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Adjustment Cap Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DrProgram.baselineCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation method"@en ;
    rdfs:comment "Specific algorithm used to calculate customer baseline load for measurement and verification. High 10 of Last 10 averages the highest 10 days from the last 10 similar days; Average 5 of 10 averages middle 5 of last 10 days; Day Matching uses same day-of-week; Regression uses statistical model; Weather Normalized adjusts for temperature."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Method" ;
    cmm:validValues "high_10_of_last_10|average_5_of_10|day_matching|regression|weather_normalized" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.behavioralDrDeliveryChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "behavioral dr delivery channel"@en ;
    rdfs:comment "Primary communication channel used to deliver behavioral demand response messages and engagement content to customers. Applicable only to behavioral DR program types. Reference-value candidates: email|sms|mobile_app|web_portal|home_energy_report|in_home_display|none."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "behavioral_dr_delivery_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behavioral Demand Response (DR) Delivery Channel" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.behavioralDrEngagementScoringParameters a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "behavioral dr engagement scoring parameters"@en ;
    rdfs:comment "Parameters and weights used to calculate customer engagement scores in behavioral demand response programs, including message open rates, web portal logins, mobile app usage, survey responses, and behavioral action completion."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "behavioral_dr_engagement_scoring_parameters" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behavioral Demand Response (DR) Engagement Scoring Parameters" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.behavioralDrGamificationRules a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "behavioral dr gamification rules"@en ;
    rdfs:comment "Description of gamification elements used in behavioral demand response campaigns, including points systems, leaderboards, badges, challenges, and rewards structures designed to drive sustained engagement and load reduction."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "behavioral_dr_gamification_rules" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behavioral Demand Response (DR) Gamification Rules" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.behavioralDrPeerComparisonMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "behavioral dr peer comparison methodology"@en ;
    rdfs:comment "Methodology used to compare customer energy usage to peers in behavioral demand response campaigns. Neighbor Comparison uses geographic proximity; Similar Home Comparison uses home characteristics; Percentile Ranking shows position in distribution. None if peer comparison not used."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "behavioral_dr_peer_comparison_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Behavioral Demand Response (DR) Peer Comparison Methodology" ;
    cmm:validValues "neighbor_comparison|similar_home_comparison|percentile_ranking|none" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.costEffectivenessRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost effectiveness ratio"@en ;
    rdfs:comment "Calculated benefit-cost ratio for this demand response program using the specified cost-effectiveness test method. Values greater than 1.0 indicate program is cost-effective. Updated annually based on actual performance."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_effectiveness_ratio" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost-Effectiveness Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:DrProgram.costEffectivenessTestMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost effectiveness test method"@en ;
    rdfs:comment "Regulatory cost-effectiveness test used to evaluate this demand response program. Total Resource Cost (TRC) test includes all costs and benefits; Program Administrator Cost (PAC) test uses utility perspective; Ratepayer Impact Measure (RIM) test evaluates rate impacts; Participant Cost Test (PCT) evaluates customer economics; Societal Cost Test (SCT) includes externalities."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_effectiveness_test_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost-Effectiveness Test Method" ;
    cmm:validValues "trc|pac|rim|pct|sct" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this demand response program record was first created in the system."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DemandResponseProgram.createdDateTime .
cmm:DrProgram.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when the demand response program is scheduled to terminate. Null for open-ended programs."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:DrProgram.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when the demand response program becomes active and eligible for customer enrollment and event dispatch."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:DrProgram.eligibleCustomerSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligible customer segment"@en ;
    rdfs:comment "Customer segment(s) eligible to enroll in this demand response program. Segmentation based on rate class and usage characteristics."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligible_customer_segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligible Customer Segment" ;
    cmm:validValues "residential|commercial|industrial|agricultural|all_segments" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.enrolledCapacityActualMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled capacity actual mw"@en ;
    rdfs:comment "Current actual aggregate enrolled load reduction capacity in megawatts across all active customer enrollments in this program."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_capacity_actual_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity Actual in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrProgram.enrolledCapacityTargetMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled capacity target mw"@en ;
    rdfs:comment "Target aggregate load reduction capacity in megawatts that the utility aims to enroll in this demand response program. Used for resource adequacy planning and regulatory performance reporting."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_capacity_target_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity Target in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrProgram.eventNotificationLeadTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event notification lead time hours"@en ;
    rdfs:comment "Minimum number of hours advance notice provided to customers before a demand response event is dispatched. Regulatory requirement varies by program type and jurisdiction."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "event_notification_lead_time_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Notification Lead Time in Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:DrProgram.incentiveAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive amount"@en ;
    rdfs:comment "Base incentive amount paid to customers. Units depend on incentive_structure_type: dollars per year for fixed payment, dollars per kWh for per-kWh curtailed, dollars per kW-month for capacity payment."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrProgram.incentiveCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for incentive payments. USD for United States utilities."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Incentive Currency Code" ;
    cmm:validValues "USD" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:DrProgram.incentiveStructureType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive structure type"@en ;
    rdfs:comment "Classification of how customer incentives are calculated and paid. Fixed Payment provides flat annual amount; Per kWh Curtailed pays based on measured load reduction; Capacity Payment compensates for availability; Energy Payment compensates for actual curtailment; Bill Credit reduces customer bill; Tiered Incentive varies payment by performance level."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_structure_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Structure Type" ;
    cmm:validValues "fixed_payment|per_kwh_curtailed|capacity_payment|energy_payment|bill_credit|tiered_incentive" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.isoRtoName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto name"@en ;
    rdfs:comment "Name of the ISO or RTO where this demand response program is registered for wholesale market participation. None indicates retail-only program. Reference-value candidates: CAISO|ERCOT|MISO|PJM|NYISO|ISO_NE|SPP|none."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Name" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.isoRtoRegistrationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto registration number"@en ;
    rdfs:comment "Registration identifier assigned by the ISO or RTO for wholesale market participation. Required for programs that bid demand response capacity into day-ahead or real-time markets."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_registration_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Registration Identifier" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrProgram.maxEventDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max event duration hours"@en ;
    rdfs:comment "Maximum allowable duration in hours for a single demand response event under this program. Protects customers from excessive curtailment."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "max_event_duration_hours" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Event Duration in Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:DrProgram.maxEventHoursPerYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max event hours per year"@en ;
    rdfs:comment "Maximum cumulative hours of demand response events that can be dispatched in a calendar year. Protects customers from excessive annual curtailment burden."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "max_event_hours_per_year" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Event Hours Per Year" ;
    cmm:cimDatatype "Decimal" .
cmm:DrProgram.maxEventsPerYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max events per year"@en ;
    rdfs:comment "Maximum number of demand response events that can be called in a calendar year under this program. Regulatory limit to ensure customer participation remains voluntary and reasonable."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:int ;
    cmm:physicalColumn "max_events_per_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Events Per Year" ;
    cmm:cimDatatype "Integer" .
cmm:DrProgram.measurementVerificationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement verification methodology"@en ;
    rdfs:comment "Methodology used to calculate baseline load and measure actual load reduction during demand response events. Customer Baseline uses historical usage patterns; Meter Before-After compares pre-event and event-period readings; Control Group compares participants to non-participants; Regression Analysis uses statistical models; Deemed Savings applies fixed reduction values."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_verification_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement and Verification (M&V) Methodology" ;
    cmm:validValues "customer_baseline|meter_before_after|control_group|regression_analysis|deemed_savings" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.minimumLoadRequirementKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum load requirement kw"@en ;
    rdfs:comment "Minimum peak demand in kilowatts that a customer must have to be eligible for enrollment in this demand response program. Null if no minimum applies."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_load_requirement_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Load Requirement in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrProgram.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this demand response program record was last modified in the system."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DrProgram.optOutAllowedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out allowed flag"@en ;
    rdfs:comment "Indicates whether customers are allowed to opt out of individual demand response events without penalty. True for voluntary programs; False for firm interruptible tariffs."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "opt_out_allowed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Allowed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrProgram.optOutPenaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out penalty amount"@en ;
    rdfs:comment "Financial penalty assessed to customers who opt out of a demand response event when opt-out is allowed but discouraged. Null if no penalty applies."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "opt_out_penalty_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Penalty Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrProgram.performanceReportingFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance reporting frequency"@en ;
    rdfs:comment "Frequency at which program performance metrics must be reported to ISO/RTO and PUC. Event-based reporting required for wholesale market programs; periodic reporting for retail programs."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_reporting_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Reporting Frequency" ;
    cmm:validValues "monthly|quarterly|annual|event_based" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.performanceReportingObligation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance reporting obligation"@en ;
    rdfs:comment "Description of specific performance metrics and reporting obligations required by regulators and market operators, including enrolled capacity, event performance, customer participation rates, and measurement and verification results."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "performance_reporting_obligation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Reporting Obligation" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.programBudgetAnnual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program budget annual"@en ;
    rdfs:comment "Total annual budget allocated for this demand response program, including incentive payments, marketing, administration, measurement and verification, and technology costs."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "program_budget_annual" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Budget Annual" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:DrProgram.programCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program code"@en ;
    rdfs:comment "Externally-known unique business identifier for the DR program used in regulatory filings, ISO/RTO registration, and customer communications."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{3,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrProgram.programName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program name"@en ;
    rdfs:comment "Human-readable name of the demand response program as marketed to customers and reported to regulators."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Program Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DrProgram.programStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program status"@en ;
    rdfs:comment "Current lifecycle status of the demand response program. Draft indicates program design phase; Pending Approval awaits PUC/FERC authorization; Active means program is enrolling customers and dispatching events; Suspended indicates temporary halt; Closed means no new enrollments but existing customers remain; Retired indicates program termination."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Status" ;
    cmm:validValues "draft|pending_approval|active|suspended|closed|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:DemandResponseProgram.status .
cmm:DrProgram.programType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program type"@en ;
    rdfs:comment "Classification of the demand response program type. Direct Load Control (DLC) allows utility to remotely control customer devices; Interruptible Tariff provides bill credits for load curtailment; Critical Peak Pricing (CPP) charges higher rates during peak events; Time of Use (TOU) varies rates by time period; Behavioral DR uses engagement and gamification; Virtual Power Plant (VPP) aggregates distributed resources; Wholesale Market DR participates in ISO/RTO markets; Emergency DR responds to grid emergencies. Reference-value candidates: direct_load_control|interruptible_tariff|cpp|tou|behavioral_dr|vpp_aggregation|wholesale_market_dr|emergency_dr."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:DemandResponseProgram.kind .
cmm:DrProgram.regulatoryApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory approval date"@en ;
    rdfs:comment "Date when the PUC or FERC issued final approval for this demand response program to commence operations."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:date ;
    cmm:physicalColumn "regulatory_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:DrProgram.regulatoryAuthorizationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory authorization type"@en ;
    rdfs:comment "Type of regulatory authorization under which this demand response program operates. PUC Tariff for state-approved retail programs; FERC Tariff for wholesale programs; Pilot Program for experimental initiatives; Emergency Authorization for grid reliability programs; Market Rule for ISO/RTO market products."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_authorization_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Authorization Type" ;
    cmm:validValues "puc_tariff|ferc_tariff|pilot_program|emergency_authorization|market_rule" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.regulatoryDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory docket number"@en ;
    rdfs:comment "PUC or FERC docket number under which this demand response program was approved. Used for regulatory compliance tracking and audit trail."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrProgram.vppAggregationModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vpp aggregation model"@en ;
    rdfs:comment "Business model for aggregating distributed energy resources into a virtual power plant. Utility-Owned means utility directly controls customer devices; Third-Party Aggregator uses external aggregator; Hybrid combines both models. None if not a VPP program."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "vpp_aggregation_model" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Power Plant (VPP) Aggregation Model" ;
    cmm:validValues "utility_owned|third_party_aggregator|hybrid|none" ;
    cmm:cimDatatype "String" .
cmm:DrProgram.vppDispatchProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vpp dispatch protocol"@en ;
    rdfs:comment "Communication protocol used to dispatch demand response signals to distributed energy resources in virtual power plant programs. OpenADR is open standard; IEEE 2030.5 is smart grid standard; Proprietary uses vendor-specific protocol. None if not applicable."@en ;
    rdfs:domain cmm:DrProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "vpp_dispatch_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Power Plant (VPP) Dispatch Protocol" ;
    cmm:validValues "openadr|ieee_2030_5|proprietary|none" ;
    cmm:cimDatatype "String" .

cmm:DemandDrEnrollment a owl:Class ;
    rdfs:label "Demand Dr Enrollment"@en ;
    rdfs:comment "Master record capturing a customer account's enrollment in a specific DR program, including enrolled load capacity (kW), service point, meter, enrollment effective and expiration dates, enrollment channel, opt-out history, interruptible tariff agreement reference, and current enrollment status. SSOT for enrolled load capacity by customer and program. Supports ISO/RTO capacity reporting and PUC program participation audits."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.enrollment_operations ;
    cmm:physicalTable "utility_cmm_silver.demand.demand_dr_enrollment" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "OpenADR 2.0b; CIS DR Enrollment; SAP IS-U Device Management DR Flag" ;
    cmm:sourceObject "energy_utilities_ecm.demand.demand_dr_enrollment" ;
    owl:hasKey ( cmm:DemandDrEnrollment.demandDrEnrollmentId ) .

cmm:DemandDrEnrollment.demandDrEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand dr enrollment id"@en ;
    rdfs:comment "Unique identifier for the demand response enrollment record. Primary key for the DR enrollment entity."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "demand_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Demand Response (DR) Enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DemandDrEnrollment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account enrolled in the demand response program. Links to the customer account master record in the Customer Information System (CIS)."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Account Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:DemandDrEnrollment.aggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "Reference to the third-party demand response aggregator managing this customer enrollment on behalf of the utility. Null for direct utility-managed enrollments. Links to the aggregator master record defining aggregator contracts, settlement terms, and performance obligations."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Aggregator Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_aggregator_id" ;
    cmm:cimAssociation "Agreement.MarketParticipant" .
cmm:DemandDrEnrollment.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Foreign key linking to customer.customer_service_agreement. Business justification: DR enrollment must reference the specific service agreement governing rate schedule, service class, and contractual terms. Critical for tariff compliance, billing integration, and ensuring enrolled lo"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_customer_service_agreement_id" ;
    cmm:cimAssociation "Agreement.CustomerAgreement" .
cmm:DemandDrEnrollment.derInterconnectionPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection point"@en ;
    rdfs:comment "Foreign key linking to distribution.der_interconnection_point. Business justification: Premises with DER assets (solar, battery storage) enrolled in DR/VPP programs require linkage to their interconnection point for telemetry, dispatch control, baseline calculation, and settlement. Esse"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:DerInterconnectionPoint ;
    cmm:physicalColumn "der_interconnection_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Interconnection Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_der_interconnection_point_id" ;
    cmm:cimAssociation "Agreement.ConnectivityNode" .
cmm:DemandDrEnrollment.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: DR enrollment tracks specific DER system providing curtailment capability. Measurement & verification requires system nameplate capacity, inverter specifications, and export limits. Baseline calculati"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_der_system_id" ;
    cmm:cimAssociation "Agreement.PowerElectronicsConnection" .
cmm:DemandDrEnrollment.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Foreign key linking to distribution.transformer. Business justification: DR enrollments must track the distribution transformer serving the enrolled premise for capacity planning, hosting capacity analysis, and assessing grid impact during curtailment events. Essential for"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Id (Foreign Key)" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_distribution_transformer_id" ;
    cmm:cimAssociation "Agreement.PowerTransformer" .
cmm:DemandDrEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Reference to the specific demand response program in which the customer is enrolled. Links to the DR program master record defining program rules, incentives, and dispatch protocols."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Program Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_dr_program_id" ;
    cmm:cimAssociation "Agreement.DemandResponseProgram" .
cmm:DemandDrEnrollment.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Enrollments are aggregated by zone for ISO/RTO reporting, baseline calculation, and capacity market participation. Zone-level aggregation is required for settlement, performance reporting, and resourc"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_forecast_zone_id" ;
    cmm:cimAssociation "Agreement.LoadArea" .
cmm:DemandDrEnrollment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Customer DR enrollment requires completed interconnection for behind-the-meter DER. Enrollment verification validates interconnection approval status and export capacity limits. ISO/RTO registration a"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_interconnection_application_id" ;
    cmm:cimAssociation "Agreement.Request" .
cmm:DemandDrEnrollment.interruptibleTariffAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interruptible tariff agreement"@en ;
    rdfs:comment "Reference to the interruptible tariff agreement contract that governs the terms, conditions, and compensation for load curtailment. Links to the tariff agreement master record defining rate discounts, curtailment obligations, and penalty provisions."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:InterruptibleTariffAgreement ;
    cmm:physicalColumn "interruptible_tariff_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interruptible Tariff Agreement Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_interruptible_tariff_agreement_id" ;
    cmm:cimAssociation "Agreement.CustomerAgreement" .
cmm:DemandDrEnrollment.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Enrollments track specific equipment installed at customer premises (thermostats, control switches). Business process: asset tracking, warranty management, spare parts planning, equipment lifecycle ma"@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installed Equipment Material Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_material_master_id" ;
    cmm:cimAssociation "Agreement.ErpItemMaster" .
cmm:DemandDrEnrollment.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the Advanced Metering Infrastructure (AMI) meter device used to measure interval load data for baseline calculation and measurement and verification (M&V). Links to the meter device master record in Meter Data Management (MDM)."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_meter_id" ;
    cmm:cimAssociation "Agreement.Meter" .
cmm:DemandDrEnrollment.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Reference to the physical service delivery point where demand response load curtailment will be measured. Links to the service point master record in the Customer Information System (CIS)."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_demand_dr_enrollment_meter_point_id" ;
    cmm:cimAssociation "Agreement.UsagePoint" .
cmm:DemandDrEnrollment.averageCurtailmentKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average curtailment kw"@en ;
    rdfs:comment "The average actual load curtailment in kilowatts (kW) achieved by the customer across all participated DR events during the current enrollment period. Used for program performance analysis and capacity planning."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_curtailment_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Curtailment (Kilowatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DemandDrEnrollment.baselineAdjustmentEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline adjustment enabled flag"@en ;
    rdfs:comment "Indicates whether day-of or morning-of baseline adjustments are enabled for this enrollment to account for real-time load variations. True: adjustments are applied. False: unadjusted baseline is used for M&V."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "baseline_adjustment_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Adjustment Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DemandDrEnrollment.baselineCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation method"@en ;
    rdfs:comment "The methodology used to calculate the customer baseline load (CBL) for measurement and verification (M&V) of load curtailment performance. High X of Y: average of highest X days in prior Y days. Mid X of Y: average of middle X days in prior Y days. Regression: statistical regression model. Control Group: comparison to similar non-participating customers. Meter Before Meter After: direct comparison of meter readings."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Method" ;
    cmm:validValues "high_x_of_y|mid_x_of_y|regression|control_group|meter_before_meter_after" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.capacityMarketParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity market participation flag"@en ;
    rdfs:comment "Indicates whether this enrollment is registered to participate in the ISO/RTO capacity market and is eligible to receive capacity payments for committed load reduction. True: participating in capacity market. False: energy-only or retail program participation."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "capacity_market_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Market Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DemandDrEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this enrollment record was first created in the data platform. System-generated audit timestamp for data lineage and compliance."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:DemandDrEnrollment.directLoadControlEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "direct load control enabled flag"@en ;
    rdfs:comment "Indicates whether the utility has direct load control capability to remotely curtail customer load via smart thermostats, water heaters, or other controllable devices. True: DLC enabled. False: behavioral or manual curtailment only."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "direct_load_control_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Direct Load Control (DLC) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DemandDrEnrollment.enrolledLoadCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled load capacity kw"@en ;
    rdfs:comment "The committed load reduction capacity in kilowatts (kW) that the customer has enrolled to curtail during demand response events. This is the System of Record (SSOT) for enrolled capacity reported to ISO/RTO for capacity market settlements and to PUC for program performance audits."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_load_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Load Capacity (Kilowatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DemandDrEnrollment.enrollmentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment channel"@en ;
    rdfs:comment "The channel or method through which the customer enrolled in the demand response program. Web Portal: customer self-service online. Mobile App: enrollment via utility mobile application. Call Center: enrollment via customer service representative. Field Enrollment: enrollment by field agent or installer. Aggregator: enrollment through third-party demand response aggregator. Auto Enrollment: automatic enrollment based on rate class or program rules. Utility Initiated: proactive enrollment by utility for targeted customers. Reference-value candidates: web_portal|mobile_app|call_center|field_enrollment|aggregator|auto_enrollment|utility_initiated."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.enrollmentEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment effective date"@en ;
    rdfs:comment "The date on which the demand response enrollment becomes active and the customer becomes eligible to participate in DR events and receive incentive payments. Must align with program enrollment windows and ISO/RTO capacity commitment deadlines."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:DemandDrEnrollment.enrollmentExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment expiration date"@en ;
    rdfs:comment "The date on which the demand response enrollment expires and the customer is no longer eligible for DR event dispatch or incentive payments. Null for open-ended enrollments subject to annual renewal or customer opt-out."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:DemandDrEnrollment.enrollmentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment number"@en ;
    rdfs:comment "Business-facing unique enrollment number assigned to the customer for this DR program participation. Used in customer communications, billing statements, and regulatory reporting. Format: DR-XXXXXXXXXX."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Demand Response (DR) Enrollment Number" ;
    cmm:valuePattern "^DR-[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DemandDrEnrollment.enrollmentSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment source system"@en ;
    rdfs:comment "The name of the operational system of record from which this enrollment record originated. Examples: SAP IS-U, Oracle CC&B, proprietary DR management system, aggregator platform."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Source System" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.enrollmentSourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment source system code"@en ;
    rdfs:comment "The unique identifier of this enrollment record in the source operational system. Used for data lineage traceability and reconciliation with upstream systems."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Source System Identifier" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle status of the demand response enrollment. Pending: enrollment submitted but not yet active. Active: enrollment is in effect and customer is eligible for DR events. Suspended: temporarily inactive due to non-compliance or customer request. Terminated: enrollment ended by utility or customer. Expired: enrollment period ended. Opted Out: customer exercised opt-out right."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:validValues "pending|active|suspended|terminated|expired|opted_out" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:DemandDrEnrollment.enrollmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment timestamp"@en ;
    rdfs:comment "The date and time when the customer enrollment was submitted and recorded in the system. Represents the business event time of enrollment initiation, distinct from audit timestamps."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "enrollment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DemandDrEnrollment.isoRtoRegistrationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto registration number"@en ;
    rdfs:comment "The unique registration identifier assigned by the ISO or RTO for this demand response resource enrollment. Used for wholesale market participation, capacity market bidding, and settlement reconciliation with the ISO/RTO."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_registration_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Registration Identifier" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DemandDrEnrollment.lastOptOutDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last opt out date"@en ;
    rdfs:comment "The date of the most recent opt-out event when the customer declined to participate in a dispatched DR event. Null if the customer has never opted out during the current enrollment period."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_opt_out_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Opt-Out Date" ;
    cmm:cimDatatype "Date" .
cmm:DemandDrEnrollment.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time when this enrollment record was most recently modified in the data platform. System-generated audit timestamp for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DemandDrEnrollment.notificationLeadTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification lead time minutes"@en ;
    rdfs:comment "The minimum advance notice time in minutes required to notify the customer before a demand response event dispatch. Defined by program rules and customer agreement. Typical values range from 15 minutes to 24 hours."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "notification_lead_time_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Lead Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DemandDrEnrollment.notificationPreference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification preference"@en ;
    rdfs:comment "The customer preferred method for receiving demand response event notifications and dispatch alerts. Email: email notification. SMS: text message. Phone: automated phone call. Mobile App: push notification via utility mobile app. None: no notification requested."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_preference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Preference" ;
    cmm:validValues "email|sms|phone|mobile_app|none" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.optOutCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out count"@en ;
    rdfs:comment "The cumulative number of times the customer has exercised their opt-out right to decline participation in a dispatched DR event during the current enrollment period. Used to track customer engagement and enforce program opt-out limits."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "opt_out_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Count" ;
    cmm:cimDatatype "Integer" .
cmm:DemandDrEnrollment.participationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation rate percent"@en ;
    rdfs:comment "The percentage of dispatched DR events in which the customer successfully participated and achieved the required load curtailment during the current enrollment period. Calculated as (successful events / total dispatched events) * 100. Used for program performance reporting and customer incentive tier determination."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "participation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DemandDrEnrollment.pucReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reporting flag"@en ;
    rdfs:comment "Indicates whether this enrollment must be included in Public Utility Commission (PUC) demand response program participation and performance reports. True: include in PUC reporting. False: exclude from regulatory reporting."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DemandDrEnrollment.telemetryEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "telemetry enabled flag"@en ;
    rdfs:comment "Indicates whether real-time telemetry data from the customer meter or behind-the-meter (BTM) devices is enabled for this enrollment to support real-time dispatch verification and settlement. True: telemetry enabled. False: interval data only."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "telemetry_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Telemetry Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DemandDrEnrollment.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "The date on which the enrollment was terminated. Null for active, pending, or suspended enrollments. Populated when enrollment status transitions to terminated."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:DemandDrEnrollment.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "The reason code for enrollment termination when enrollment status is terminated. Customer Request: customer voluntarily withdrew. Non-Compliance: customer failed to meet program requirements. Program Ended: DR program was discontinued. Account Closed: customer account was closed. Moved: customer moved out of service territory. Aggregator Change: customer switched to different aggregator. Other: other termination reason. Reference-value candidates: customer_request|non_compliance|program_ended|account_closed|moved|aggregator_change|other."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Reason" ;
    cmm:cimDatatype "String" .
cmm:DemandDrEnrollment.totalIncentivePaymentsUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total incentive payments usd"@en ;
    rdfs:comment "The cumulative total of all incentive payments in United States Dollars (USD) paid to the customer for demand response participation during the current enrollment period. Includes capacity payments, energy payments, and performance bonuses."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_incentive_payments_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Incentive Payments (United States Dollars)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DemandDrEnrollment.vppEnrollmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vpp enrollment flag"@en ;
    rdfs:comment "Indicates whether this enrollment is part of a Virtual Power Plant (VPP) aggregation that dispatches distributed energy resources (DER) as a single coordinated resource. True: enrolled in VPP. False: standalone DR enrollment."@en ;
    rdfs:domain cmm:DemandDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vpp_enrollment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Power Plant (VPP) Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:DrEvent a owl:Class ;
    rdfs:label "Dr Event"@en ;
    rdfs:comment "Transactional record of each DR dispatch event issued by the utility, ISO/RTO, or aggregator, including event type (emergency, economic, test), triggering entity, dispatch timestamp, notification lead time, target curtailment MW, geographic scope (zone, feeder, substation), event duration, cancellation flag, and post-event status. Core operational record for DR event lifecycle management and OMS/ADMS integration."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:EndDeviceControl ;
    cmm:cimCloseMatch cim:EndDeviceControl ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.event_execution ;
    cmm:physicalTable "utility_cmm_silver.demand.dr_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; OpenADR 2.0b EiEvent; NERC Demand Response Event; ISO/RTO DR Dispatch Notification" ;
    cmm:sourceObject "energy_utilities_ecm.demand.dr_event" ;
    owl:hasKey ( cmm:DrEvent.drEventId ) .

cmm:DrEvent.drEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dr event id"@en ;
    rdfs:comment "Unique identifier for the demand response event. Primary key for the DR event record."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Demand Response (DR) Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:DrEvent.aggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "Reference to the third-party demand response aggregator managing this event on behalf of the utility or ISO/RTO, if applicable."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Aggregator ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_aggregator_id" ;
    cmm:cimAssociation "EndDeviceControl.MarketParticipant" .
cmm:DrEvent.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: DR events are subject to performance audits by ISO/RTO and regulatory bodies to verify curtailment delivery and baseline accuracy. Required for audit evidence collection, performance verification, and"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_audit_id" ;
    cmm:cimAssociation "EndDeviceControl.ActivityRecord" .
cmm:DrEvent.congestionEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "congestion event"@en ;
    rdfs:comment "Foreign key linking to transmission.congestion_event. Business justification: DR events are dispatched in direct response to transmission congestion events. Linking DR dispatch to the triggering congestion event enables cost-benefit analysis, settlement reconciliation, and regu"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:CongestionEvent ;
    cmm:physicalColumn "congestion_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Congestion Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_congestion_event_id" ;
    cmm:cimAssociation "EndDeviceControl.PSREvent" .
cmm:DrEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: DR events are dispatched to manage control area ACE and frequency deviations. Operators must track which control area initiated each event for NERC CPS1/CPS2 compliance reporting and real-time balanci"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_control_area_id" ;
    cmm:cimAssociation "EndDeviceControl.ControlArea" .
cmm:DrEvent.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: DR events incur operational costs (dispatch, settlement, M&V) that must be charged to cost centers. Total_incentive_payment represents expense requiring cost center assignment for budget variance anal"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_cost_center_id" ;
    cmm:cimAssociation "EndDeviceControl.Organisation" .
cmm:DrEvent.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: DR event dispatch targets specific DER systems for curtailment. VPP aggregation and DERMS integration require system-level identification for telemetry and control commands. Event performance measurem"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_der_system_id" ;
    cmm:cimAssociation "EndDeviceControl.PowerElectronicsConnection" .
cmm:DrEvent.dispatchOperatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch operator employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: DR events are dispatched by control room operators (employees) who make real-time decisions to trigger load curtailment based on grid conditions, market signals, or emergency situations. Critical for"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "dispatch_operator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dispatch Operator Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_dispatch_operator_employee_id" ;
    cmm:cimAssociation "EndDeviceControl.ErpPersonnel" .
cmm:DrEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the specific distribution substation targeted by this DR event, if geographic_scope is substation-level."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_distribution_substation_id" ;
    cmm:cimAssociation "EndDeviceControl.Substation" .
cmm:DrEvent.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "FK to demand.dr_program.dr_program_id — Every DR event is dispatched under a specific program. Required for program-level performance reporting and settlement."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_dr_program_id" ;
    cmm:cimAssociation "EndDeviceControl.DemandResponseProgram" .
cmm:DrEvent.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the specific distribution feeder targeted by this DR event, if geographic_scope is feeder-level."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_feeder_id" ;
    cmm:cimAssociation "EndDeviceControl.Feeder" .
cmm:DrEvent.isoRtoEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto event"@en ;
    rdfs:comment "The external event identifier assigned by the Independent System Operator (ISO) or Regional Transmission Organization (RTO) for market-based DR events, used for settlement reconciliation."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "iso_rto_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "ISO/RTO Event ID" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_iso_rto_event_id" ;
    cmm:cimAssociation "EndDeviceControl.Outage" .
cmm:DrEvent.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Event dispatch decisions require load forecasts to determine timing, magnitude, and necessity of curtailment. Operators compare forecasted peak load against available capacity to trigger DR events for"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_load_id" ;
    cmm:cimAssociation "EndDeviceControl.ConformLoadSchedule" .
cmm:DrEvent.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: DR events must comply with dispatch protocols mandated by regulatory obligations (e.g., NERC EOP-011 emergency operations, ISO/RTO market rules). Essential for event compliance validation, audit trail"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_obligation_id" ;
    cmm:cimAssociation "EndDeviceControl.Document" .
cmm:DrEvent.primaryDrProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary dr program"@en ;
    rdfs:comment "Reference to the parent demand response program under which this event was dispatched (e.g., CPP, TOU, direct load control, interruptible tariff)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "primary_dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Program ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_primary_dr_program_id" ;
    cmm:cimAssociation "EndDeviceControl.DemandResponseProgram" .
cmm:DrEvent.supportingVendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "supporting vendor"@en ;
    rdfs:comment "Foreign key linking to supply.vendor. Business justification: DR events may require vendor support services (dispatch coordination, technical support, equipment maintenance). Business process: vendor performance evaluation during events, service level agreement"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "supporting_vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supporting Vendor Id (Foreign Key)" ;
    cmm:sourceColumn "vendor_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_supporting_vendor_id" ;
    cmm:cimAssociation "EndDeviceControl.Organisation" .
cmm:DrEvent.toDrProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to dr program"@en ;
    rdfs:comment "FK to demand.dr_program.dr_program_id — Every DR event is dispatched under a specific program. This FK is required for program-level performance reporting and ISO/RTO settlement."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "to_dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_to_dr_program_id" ;
    cmm:cimAssociation "EndDeviceControl.DemandResponseProgram" .
cmm:DrEvent.transmissionOutage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission outage"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_outage. Business justification: DR events are called during transmission outages to manage system loading and prevent cascading failures. Emergency DR dispatch during N-1 or N-2 contingencies is standard grid operations. Links DR re"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:TransmissionOutage ;
    cmm:physicalColumn "transmission_outage_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Outage Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_transmission_outage_id" ;
    cmm:cimAssociation "EndDeviceControl.Outage" .
cmm:DrEvent.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Foreign key linking to transmission.path. Business justification: DR events are dispatched to relieve congestion on specific transmission paths. Operators call DR to manage path loading, avoid TLR procedures, and maintain ATC. Critical for congestion management and"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Path Id (Foreign Key)" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_transmission_path_id" ;
    cmm:cimAssociation "EndDeviceControl.TransmissionPath" .
cmm:DrEvent.triggeringOutageEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "triggering outage event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: DR events are frequently dispatched in response to grid emergencies that manifest as outage risks or actual supply shortfalls. Emergency operations centers coordinate DR dispatch with OMS to manage sy"@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "triggering_outage_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Triggering Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_triggering_outage_event_id" ;
    cmm:cimAssociation "EndDeviceControl.Outage" .
cmm:DrEvent.zone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "zone"@en ;
    rdfs:comment "Reference to the specific load zone or pricing zone targeted by this DR event, if geographic_scope is zone-level."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Zone ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_zone_id" ;
    cmm:cimAssociation "EndDeviceControl.LoadArea" .
cmm:DrEvent.actualCurtailmentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual curtailment mw"@en ;
    rdfs:comment "The actual load reduction in megawatts (MW) achieved during this DR event, calculated through baseline comparison and M&V processes."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_curtailment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Curtailment (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEvent.actualDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual duration minutes"@en ;
    rdfs:comment "The actual duration of the DR event in minutes, calculated from actual_start_timestamp to actual_end_timestamp, used for settlement."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DrEvent.actualEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual end timestamp"@en ;
    rdfs:comment "The actual date and time when load curtailment ended, used for M&V and settlement calculations."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "The actual date and time when load curtailment began, used for measurement and verification (M&V) and settlement calculations."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.baselineLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline load mw"@en ;
    rdfs:comment "The calculated baseline load in megawatts (MW) representing what the load would have been without the DR event, used as the reference for curtailment measurement."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEvent.baselineMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline methodology"@en ;
    rdfs:comment "The calculation method used to determine the baseline load for this event (e.g., 10-of-10, 5-of-10, regression-based, customer-specific), critical for M&V accuracy and settlement."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Methodology" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.cancellationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this DR event was cancelled before execution. True indicates the event was cancelled."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cancellation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrEvent.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text explanation of why the DR event was cancelled, used for operational review and reporting."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.cancellationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation timestamp"@en ;
    rdfs:comment "The date and time when the DR event was cancelled, if cancellation_flag is True."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cancellation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.complianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this DR event met all regulatory and contractual compliance requirements (notification timing, curtailment delivery, reporting)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this DR event record was first created in the system, used for audit trail and data lineage."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:EndDeviceControl.createdDateTime .
cmm:DrEvent.dispatchSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch source system"@en ;
    rdfs:comment "The operational system that originated the DR event dispatch (e.g., ADMS, DERMS, EMS, manual dispatch console), used for system integration tracking."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Source System" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.dispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch timestamp"@en ;
    rdfs:comment "The exact date and time when the DR event was dispatched or issued to participants. This is the official event start trigger time."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.durationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration minutes"@en ;
    rdfs:comment "The planned duration of the DR event in minutes, calculated as the difference between scheduled_start_timestamp and scheduled_end_timestamp."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DrEvent.eventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event number"@en ;
    rdfs:comment "Business-facing unique identifier or reference number for the DR event, used for external communication and reporting to ISO/RTO and customers."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DrEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the DR event: scheduled (future event), active (currently dispatched), completed (finished successfully), cancelled (terminated before start), aborted (terminated during execution), or pending (awaiting approval)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Status" ;
    cmm:validValues "scheduled|active|completed|cancelled|aborted|pending" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EndDeviceControl.status .
cmm:DrEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the DR event based on its purpose and trigger: emergency (grid reliability), economic (price-driven), test (program validation), scheduled (planned curtailment), voluntary (opt-in), or mandatory (contractual obligation)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Type" ;
    cmm:validValues "emergency|economic|test|scheduled|voluntary|mandatory" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:EndDeviceControl.kind .
cmm:DrEvent.geographicScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic scope"@en ;
    rdfs:comment "The geographic extent of the DR event: system_wide (entire service territory), zone (load zone or pricing zone), substation (specific substation), feeder (distribution feeder), or premise (individual customer site)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Scope" ;
    cmm:validValues "system_wide|zone|substation|feeder|premise" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this DR event record was last updated, used for audit trail and change tracking."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DrEvent.lmpAtDispatch a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp at dispatch"@en ;
    rdfs:comment "The locational marginal price in dollars per MWh at the relevant pricing node (PNode) at the time of event dispatch, used for economic DR event valuation."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lmp_at_dispatch" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) at Dispatch" ;
    cmm:cimDatatype "Decimal" .
cmm:DrEvent.marketProductType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market product type"@en ;
    rdfs:comment "The wholesale market product associated with this DR event (e.g., day-ahead energy, real-time energy, regulation, spinning reserve, non-spinning reserve), if dispatched through ISO/RTO markets."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_product_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Product Type" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special circumstances, or additional context about the DR event execution and outcomes."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DrEvent.notificationLeadTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification lead time minutes"@en ;
    rdfs:comment "The advance notice period in minutes provided to participants between notification and event start, measured as the difference between notification_timestamp and dispatch_timestamp."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "notification_lead_time_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Lead Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DrEvent.notificationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification timestamp"@en ;
    rdfs:comment "The date and time when participants were notified of the upcoming DR event, used to calculate notification lead time compliance."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "notification_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.optedOutCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opted out count"@en ;
    rdfs:comment "The number of enrolled customers who opted out of this specific DR event, tracked for program compliance and customer behavior analysis."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "opted_out_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opted Out Count" ;
    cmm:cimDatatype "Integer" .
cmm:DrEvent.participantCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participant count"@en ;
    rdfs:comment "The total number of customers or premises that participated in this DR event, used for program performance reporting."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "participant_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participant Count" ;
    cmm:cimDatatype "Integer" .
cmm:DrEvent.performanceRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance ratio"@en ;
    rdfs:comment "The ratio of actual curtailment to target curtailment expressed as a percentage (0-100), used to measure event effectiveness and participant compliance."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "performance_ratio" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:DrEvent.scheduledEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled end timestamp"@en ;
    rdfs:comment "The planned date and time when load curtailment is scheduled to end for this DR event."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "The planned date and time when load curtailment is scheduled to begin for this DR event."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEvent.settlementPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement price"@en ;
    rdfs:comment "The final price in dollars per MWh used for customer incentive payment settlement for this DR event, may differ from LMP based on program rules."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "settlement_price" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Price" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrEvent.targetCurtailmentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target curtailment mw"@en ;
    rdfs:comment "The target load reduction in megawatts (MW) requested for this DR event across all participating customers and assets."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_curtailment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Curtailment (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEvent.temperatureFahrenheit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature fahrenheit"@en ;
    rdfs:comment "The average ambient temperature in degrees Fahrenheit during the DR event, used for weather normalization in M&V calculations."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_fahrenheit" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature (Fahrenheit)" ;
    cmm:unitSymbol "degF" ;
    cmm:cimDatatype "Temperature" .
cmm:DrEvent.totalIncentivePayment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total incentive payment"@en ;
    rdfs:comment "The total incentive payment amount in dollars paid to all participants for this DR event, calculated based on actual curtailment and settlement price."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_incentive_payment" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Incentive Payment" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrEvent.triggeringEntity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering entity"@en ;
    rdfs:comment "The organization or system that initiated the DR event: utility (internal dispatch), ISO/RTO (market operator), aggregator (third-party DR provider), customer (self-curtailment), or system (automated trigger)."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_entity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Entity" ;
    cmm:validValues "utility|iso|rto|aggregator|customer|system" ;
    cmm:cimDatatype "String" .
cmm:DrEvent.vppDispatchFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vpp dispatch flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this DR event was dispatched as part of a virtual power plant (VPP) aggregation strategy."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vpp_dispatch_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Power Plant (VPP) Dispatch Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Description of the prevailing weather conditions during the DR event (e.g., extreme heat, cold snap, normal), used for baseline adjustment and event analysis."@en ;
    rdfs:domain cmm:DrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:DrEventParticipant a owl:Class ;
    rdfs:label "Dr Event Participant"@en ;
    rdfs:comment "Transactional record linking an enrolled customer, aggregated resource, or DLC device to a specific DR event, serving as the single authoritative response record across ALL DR program types. For direct load control: captures device commands (shed/restore/cycle with target setpoints), acknowledgment status, actual device response, load shed achieved, dispatch duration, and failure reasons. For behavioral DR: captures notification delivery confirmation, peer comparison data, engagement scoring, pre-event baseline consumption, actual consumption during event window, calculated reduction, and response classification. For interruptible tariff, VPP, and wholesale market dispatch: captures committed curtailment (kW), actual measured curtailment (kW), performance ratio, incentive payment eligibility, non-performance penalty flag, and M&V method applied. SSOT for per-resource event performance tracking across all DR program types including DLC device-level response and behavioral DR customer engagement."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.enrollment_operations ;
    cmm:physicalTable "utility_cmm_silver.demand.dr_event_participant" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OpenADR 2.0b; ISO/RTO DR Settlement Participant Record; FERC Order 745 Performance Measurement" ;
    cmm:sourceObject "energy_utilities_ecm.demand.dr_event_participant" ;
    owl:hasKey ( cmm:DrEventParticipant.drEventParticipantId ) .

cmm:DrEventParticipant.drEventParticipantId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dr event participant id"@en ;
    rdfs:comment "Unique identifier for the demand response event participant record. Primary key for this transactional entity linking a customer, aggregated resource, or Direct Load Control (DLC) device to a specific DR event."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:long ;
    cmm:physicalColumn "dr_event_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Demand Response (DR) Event Participant Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DrEventParticipant.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account participating in the DR event. Used for billing, incentive payment processing, and customer-level performance aggregation."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:DrEventParticipant.aggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "Reference to the third-party aggregator managing this participant resource. Used for wholesale market DR programs and aggregated DER portfolios. Null for utility-direct programs."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Aggregator Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_aggregator_id" ;
    cmm:cimAssociation "IdentifiedObject.MarketParticipant" .
cmm:DrEventParticipant.causedInterruption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "caused interruption"@en ;
    rdfs:comment "Foreign key linking to outage.interruption. Business justification: Direct load control actions during DR events can cause brief service interruptions to participating customers (cycling equipment, load shedding). Business process: Reconciling DR-induced interruptions"@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:CustomerInterruption ;
    cmm:physicalColumn "caused_interruption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Caused Interruption Id (Foreign Key)" ;
    cmm:sourceColumn "interruption_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_caused_interruption_id" ;
    cmm:cimAssociation "IdentifiedObject.Outage" .
cmm:DrEventParticipant.demandDrEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "demand dr enrollment"@en ;
    rdfs:comment "Reference to the customer enrollment record that authorized participation in this DR event. Links to the active enrollment in the DR program at the time of event dispatch."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "demand_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Enrollment Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_demand_dr_enrollment_id" ;
    cmm:cimAssociation "IdentifiedObject.Agreement" .
cmm:DrEventParticipant.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Participant-level performance measurement requires DER system technical specifications for baseline calculation and curtailment verification. Device command type and target setpoint validation depend"@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_der_system_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerElectronicsConnection" .
cmm:DrEventParticipant.directLoadControlDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "direct load control device"@en ;
    rdfs:comment "Reference to the specific Direct Load Control (DLC) device or Distributed Energy Resource (DER) that was dispatched during the event. Applicable for DLC programs, smart thermostats, battery storage, and VPP resources. Null for behavioral DR programs."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DirectLoadControlDevice ;
    cmm:physicalColumn "direct_load_control_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Device Identifier" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_direct_load_control_device_id" ;
    cmm:cimAssociation "IdentifiedObject.EndDevice" .
cmm:DrEventParticipant.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "FK to demand.dr_event.dr_event_id — Core header-line relationship. Every participant record must reference the event it responds to. Required for event-level curtailment aggregation."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_dr_event_id" ;
    cmm:cimAssociation "IdentifiedObject.EndDeviceControl" .
cmm:DrEventParticipant.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Compliance reporting and settlement require linking participant response to approved interconnection application for capacity verification. Incentive payment eligibility validation checks interconnect"@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_interconnection_application_id" ;
    cmm:cimAssociation "IdentifiedObject.Request" .
cmm:DrEventParticipant.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Participant-level performance measurement requires comparing actual response against forecasted baseline load for the event window. Essential for M&V, settlement calculation, and performance ratio det"@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_load_id" ;
    cmm:cimAssociation "IdentifiedObject.ConformLoadSchedule" .
cmm:DrEventParticipant.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the physical premise location where the DR event participation occurred. Used for geographic analysis, load zone aggregation, and distribution system impact assessment."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:DrEventParticipant.primaryDrEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary dr event"@en ;
    rdfs:comment "Reference to the parent DR event that this participant record is associated with. Links to the specific dispatch event across all DR program types (DLC, behavioral, interruptible, VPP, wholesale market)."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "primary_dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Event Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_primary_dr_event_id" ;
    cmm:cimAssociation "IdentifiedObject.EndDeviceControl" .
cmm:DrEventParticipant.toDrEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to dr event"@en ;
    rdfs:comment "FK to demand.dr_event.dr_event_id — Every participant response record must reference the event it responds to. This is the core header-to-line relationship for DR event performance tracking."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "to_dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_event_participant_to_dr_event_id" ;
    cmm:cimAssociation "IdentifiedObject.EndDeviceControl" .
cmm:DrEventParticipant.acknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the participant device or system acknowledged receipt of the dispatch command. Used to measure communication latency and confirm successful command delivery for DLC and VPP resources."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.actualLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual load kw"@en ;
    rdfs:comment "Measured actual load in kilowatts consumed by the participant during the DR event window. Sourced from Advanced Metering Infrastructure (AMI) interval data or SCADA telemetry for real-time measurement."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_load_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Load Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEventParticipant.baselineCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation method"@en ;
    rdfs:comment "Methodology used to calculate the baseline load for this participant. Common methods include high X of Y days, regression-based, or control group comparison. Must align with program rules and regulatory requirements for Measurement and Verification (M&V)."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Method" ;
    cmm:validValues "high_10_of_10|high_5_of_10|mid_4_of_6|regression|control_group|customer_baseline" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.baselineLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline load kw"@en ;
    rdfs:comment "Calculated baseline load in kilowatts representing what the participant would have consumed absent the DR event. Used as the reference point for measuring actual curtailment performance. Calculated using the baseline methodology specified in the program rules."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_load_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Load Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEventParticipant.committedCurtailmentKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "committed curtailment kw"@en ;
    rdfs:comment "Load reduction in kilowatts that the participant committed to provide during the DR event. Used for interruptible tariff, VPP, and wholesale market programs where participants bid or contract specific curtailment amounts."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "committed_curtailment_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Committed Curtailment Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEventParticipant.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this participant event record was first created in the system. Audit field for data lineage and record lifecycle tracking."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:DrEventParticipant.curtailmentDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment duration minutes"@en ;
    rdfs:comment "Total duration in minutes that the participant actively curtailed load during the DR event. Used for calculating energy reduction (kWh) and validating minimum participation requirements."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:int ;
    cmm:physicalColumn "curtailment_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DrEventParticipant.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Indicator of the quality and reliability of the meter data used for performance measurement. Flags estimated or missing interval data that may affect settlement accuracy and require manual review."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "verified|estimated|missing|suspect|adjusted" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.deviceCommandType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device command type"@en ;
    rdfs:comment "Type of control command issued to the DLC device or DER during the event. Applicable for direct load control programs. Null for behavioral and interruptible tariff programs."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_command_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Command Type" ;
    cmm:validValues "shed|restore|cycle|setpoint_adjust|charge|discharge" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.dispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch timestamp"@en ;
    rdfs:comment "Date and time when the DR event dispatch command was issued to this participant. Represents the moment the utility or aggregator initiated the curtailment request or device control signal."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.energyReductionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy reduction kwh"@en ;
    rdfs:comment "Total energy reduction in kilowatt-hours achieved by the participant during the DR event, calculated as measured curtailment (kW) multiplied by duration (hours). Used for program impact reporting and wholesale market settlement."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_reduction_kwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Reduction Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DrEventParticipant.engagementScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engagement score"@en ;
    rdfs:comment "Calculated engagement score for behavioral DR participants based on notification interaction (open, click, response). Used for segmentation, targeted messaging, and gamification strategies to improve participation rates."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "engagement_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Engagement Score" ;
    cmm:cimDatatype "Decimal" .
cmm:DrEventParticipant.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Categorized reason for participant non-response or under-performance during the DR event. Used for root cause analysis, device maintenance prioritization, and program improvement initiatives."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Reason" ;
    cmm:validValues "communication_failure|device_malfunction|customer_override|insufficient_load|weather_exception|system_error" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.incentivePaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive payment amount"@en ;
    rdfs:comment "Calculated incentive payment amount in local currency earned by the participant for this DR event based on measured curtailment, program rate structure, and performance ratio. Subject to final settlement and adjustment."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_payment_amount" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Payment Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrEventParticipant.incentivePaymentCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive payment currency"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for the incentive payment amount. Supports multi-currency operations for utilities operating across international jurisdictions."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_payment_currency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Incentive Payment Currency" ;
    cmm:validValues "USD|CAD|EUR|GBP|AUD" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:DrEventParticipant.incentivePaymentEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive payment eligible flag"@en ;
    rdfs:comment "Boolean indicator of whether this participant performance qualifies for incentive payment based on program rules, minimum performance thresholds, and compliance requirements. False indicates disqualification due to non-performance or rule violation."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "incentive_payment_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Payment Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrEventParticipant.measuredCurtailmentKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measured curtailment kw"@en ;
    rdfs:comment "Actual measured load reduction in kilowatts achieved by the participant during the DR event, calculated as baseline load minus actual load. This is the verified performance used for incentive payment calculation and program reporting."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "measured_curtailment_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measured Curtailment Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrEventParticipant.mvMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mv method"@en ;
    rdfs:comment "Measurement and Verification method applied to validate the participant curtailment performance. Determines the data sources and calculation approach used for performance settlement and regulatory reporting."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "mv_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement and Verification (M&V) Method" ;
    cmm:validValues "meter_before_after|meter_comparison|stipulated|engineering_estimate|telemetry" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.nonPerformancePenaltyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "non performance penalty flag"@en ;
    rdfs:comment "Boolean indicator of whether a penalty applies to this participant for failing to meet committed curtailment obligations. Applicable for interruptible tariff and wholesale market programs with contractual performance requirements."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "non_performance_penalty_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Performance Penalty Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DrEventParticipant.notificationChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification channel"@en ;
    rdfs:comment "Communication channel used to notify or dispatch this participant. For behavioral DR: notification method. For DLC: control protocol. Used for engagement analysis and communication effectiveness tracking."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Channel" ;
    cmm:validValues "email|sms|mobile_app|ivr|web_portal|direct_control" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.notificationDeliveryStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification delivery status"@en ;
    rdfs:comment "Status of the event notification delivery to the participant for behavioral DR programs. Tracks email, SMS, or mobile app notification delivery confirmation and engagement."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "notification_delivery_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Delivery Status" ;
    cmm:validValues "delivered|failed|pending|bounced|opened|clicked" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.optOutReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out reason"@en ;
    rdfs:comment "Participant-provided reason for opting out of the DR event. Used for customer satisfaction analysis and program design refinement to reduce opt-out frequency."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "opt_out_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Reason" ;
    cmm:validValues "comfort_concern|health_safety|business_operations|prior_commitment|no_reason_given" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.optOutTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out timestamp"@en ;
    rdfs:comment "Date and time when the participant exercised their opt-out right to decline participation in this specific DR event. Applicable for programs allowing per-event opt-out within contractual limits."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "opt_out_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.participantToEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participant to enrollment"@en ;
    rdfs:comment "FK to demand.dr_enrollment.dr_enrollment_id — Links event participation back to the enrolled resource. Required to validate that participants are enrolled and to track per-enrollment performance history."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:long ;
    cmm:physicalColumn "participant_to_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DrEventParticipant.participantType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participant type"@en ;
    rdfs:comment "Classification of the DR participant type indicating the program mechanism and dispatch method. Determines which performance metrics and measurement methods apply to this participation record."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "participant_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Participant Type" ;
    cmm:validValues "direct_load_control|behavioral|interruptible_tariff|vpp_resource|wholesale_market|aggregated_der" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:DrEventParticipant.participationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation status"@en ;
    rdfs:comment "Current lifecycle status of this participant record within the DR event. Tracks progression from dispatch through acknowledgment, response, and completion or failure. Reference-value candidates: dispatched|acknowledged|responding|completed|failed|opted_out|non_responsive."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "participation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Status" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.peerComparisonPercentile a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peer comparison percentile"@en ;
    rdfs:comment "Percentile ranking of this participant performance relative to similar participants in the same program cohort. Used for behavioral DR feedback and social comparison messaging (e.g., You performed better than 75% of your neighbors)."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:int ;
    cmm:physicalColumn "peer_comparison_percentile" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peer Comparison Percentile" ;
    cmm:cimDatatype "Integer" .
cmm:DrEventParticipant.penaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty amount"@en ;
    rdfs:comment "Calculated penalty amount in local currency assessed against the participant for non-performance or under-performance during the DR event. Applied per contractual terms for interruptible and wholesale market programs."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "penalty_amount" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DrEventParticipant.performanceRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance ratio"@en ;
    rdfs:comment "Ratio of measured curtailment to committed curtailment, expressed as a decimal (e.g., 0.95 for 95% performance). Used to assess participant compliance with contractual obligations and determine penalty or bonus payment eligibility."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "performance_ratio" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:DrEventParticipant.responseClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response classification"@en ;
    rdfs:comment "Categorical classification of the participant response quality based on performance ratio thresholds. Used for behavioral segmentation, program effectiveness analysis, and targeted engagement strategies."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "response_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Classification" ;
    cmm:validValues "full_response|partial_response|no_response|over_response|negative_response" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.responseEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response end timestamp"@en ;
    rdfs:comment "Date and time when the participant response concluded, either by event completion, restore command, or participant opt-out. Marks the end of the performance measurement window."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "response_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.responseStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response start timestamp"@en ;
    rdfs:comment "Date and time when the participant began actively responding to the DR event, as measured by load reduction or device state change. Marks the beginning of the performance measurement window."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "response_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.settlementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement status"@en ;
    rdfs:comment "Current status of the financial settlement process for this participant event record. Tracks progression from initial calculation through approval, payment, and any dispute resolution."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Status" ;
    cmm:validValues "pending|calculated|approved|paid|disputed|adjusted" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.settlementTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement timestamp"@en ;
    rdfs:comment "Date and time when the financial settlement for this participant event was finalized and approved for payment processing. Used for payment reconciliation and audit trail."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "settlement_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrEventParticipant.targetSetpointUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target setpoint unit"@en ;
    rdfs:comment "Unit of measure for the target setpoint value. Ensures correct interpretation of device control parameters across different resource types."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:string ;
    cmm:physicalColumn "target_setpoint_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Setpoint Unit of Measure" ;
    cmm:validValues "celsius|fahrenheit|kw|kw_per_hour|percent" ;
    cmm:cimDatatype "String" .
cmm:DrEventParticipant.targetSetpointValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target setpoint value"@en ;
    rdfs:comment "Target setpoint value commanded to the device during the DR event (e.g., thermostat temperature in degrees, battery discharge rate in kW). Applicable for DLC and VPP resources with adjustable setpoints."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_setpoint_value" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Setpoint Value" ;
    cmm:cimDatatype "Decimal" .
cmm:DrEventParticipant.toDrEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to dr enrollment"@en ;
    rdfs:comment "FK to demand.dr_enrollment.dr_enrollment_id — Every participant response must reference the enrollment that authorized participation. Required for incentive eligibility validation and capacity reporting."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_dr_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DrEventParticipant.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this participant event record was last modified. Audit field for tracking changes to performance metrics, settlement status, or data quality adjustments."@en ;
    rdfs:domain cmm:DrEventParticipant ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:LoadBaseline a owl:Class ;
    rdfs:label "Load Baseline"@en ;
    rdfs:comment "Calculated customer baseline load profile used as the reference point for measuring curtailment during DR events. Stores baseline methodology (e.g., 10-of-10, regression, weather-adjusted), baseline interval values (kWh per 15-min or hourly), calculation date, applicable event window, adjustment factors, and version history. SSOT for M&V baseline data required by ISO/RTO settlement and PUC program reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Curve ;
    cmm:cimExtends cim:Curve ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.event_execution ;
    cmm:physicalTable "utility_cmm_silver.demand.load_baseline" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NAESB WEQ-015; FERC Order 745 Baseline Methodology; ISO/RTO M&V Baseline Protocol" ;
    cmm:sourceObject "energy_utilities_ecm.demand.load_baseline" ;
    owl:hasKey ( cmm:LoadBaseline.loadBaselineId ) .

cmm:LoadBaseline.loadBaselineId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load baseline id"@en ;
    rdfs:comment "Unique identifier for the load baseline calculation record. Primary key for the load baseline entity."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:long ;
    cmm:physicalColumn "load_baseline_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Load Baseline Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:LoadBaseline.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Load baselines must be calculated within control area boundaries for accurate curtailment measurement in ISO/RTO settlements. Control area load forecasts and actual interchange schedules are used to v"@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_control_area_id" ;
    cmm:cimAssociation "Curve.ControlArea" .
cmm:LoadBaseline.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Baseline calculation for behind-the-meter DER requires system capacity and export capability from interconnection approval. ISO/RTO baseline methodology depends on interconnection configuration (expor"@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_der_system_id" ;
    cmm:cimAssociation "Curve.PowerElectronicsConnection" .
cmm:LoadBaseline.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Reference to the specific DR event for which this baseline is applicable. Null if this is a standing baseline not tied to a specific event."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Event Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_dr_event_id" ;
    cmm:cimAssociation "Curve.EndDeviceControl" .
cmm:LoadBaseline.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Reference to the Demand Response program under which this baseline is calculated. Links to the DR program master record."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Program Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_dr_program_id" ;
    cmm:cimAssociation "Curve.DemandResponseProgram" .
cmm:LoadBaseline.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Baselines are calculated using historical load patterns and must align with load forecasts for accuracy validation, adjustment factor calculation, and weather normalization. Critical for ISO/RTO basel"@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_load_id" ;
    cmm:cimAssociation "Curve.ConformLoadSchedule" .
cmm:LoadBaseline.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the Advanced Metering Infrastructure (AMI) meter device used to capture interval data for baseline calculation."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_meter_id" ;
    cmm:cimAssociation "Curve.Meter" .
cmm:LoadBaseline.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise where the baseline load is measured. Links to the premise master record."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_premise_id" ;
    cmm:cimAssociation "Curve.ServiceLocation" .
cmm:LoadBaseline.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer for whom this baseline load profile is calculated. Links to the customer master record in the Customer Information System (CIS)."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_profile_id" ;
    cmm:cimAssociation "Curve.Customer" .
cmm:LoadBaseline.supersededByBaselineLoadBaseline a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by baseline load baseline"@en ;
    rdfs:comment "Reference to the baseline record that supersedes this one. Null if this is the current active baseline. Used to maintain baseline version history."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range cmm:LoadBaseline ;
    cmm:physicalColumn "superseded_by_baseline_load_baseline_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By Baseline Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_load_baseline_superseded_by_baseline_load_baseline_id" ;
    cmm:cimAssociation "Curve.Curve" .
cmm:LoadBaseline.adjustmentFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment factor"@en ;
    rdfs:comment "Multiplicative adjustment factor applied to the baseline to account for day-of conditions (e.g., weather, operational changes). Typically ranges from 0.8 to 1.2. A value of 1.0 indicates no adjustment."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjustment_factor" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Adjustment Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadBaseline.adjustmentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment method"@en ;
    rdfs:comment "The method used to adjust the baseline for day-of conditions. Options include none (no adjustment), additive (add/subtract a fixed amount), multiplicative (apply a scaling factor), weather-normalized (adjust based on weather data), or pre-event-hours (adjust based on load in hours immediately before the event)."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "adjustment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Adjustment Method" ;
    cmm:validValues "none|additive|multiplicative|weather-normalized|pre-event-hours" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Timestamp when this baseline was approved for use. Required for regulatory audit trail and compliance reporting."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LoadBaseline.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Username or identifier of the person who approved this baseline for use in M&V calculations. Required for regulatory audit trail."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By User" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.baselineCalculationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation date"@en ;
    rdfs:comment "The date on which this baseline load profile was calculated. Used for version control and audit trail purposes."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_calculation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Date" ;
    cmm:cimDatatype "Date" .
cmm:LoadBaseline.baselineEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline effective date"@en ;
    rdfs:comment "The date from which this baseline load profile becomes effective for Measurement and Verification (M&V) purposes."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:LoadBaseline.baselineExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline expiration date"@en ;
    rdfs:comment "The date on which this baseline load profile expires and is no longer valid for M&V calculations. Null if the baseline remains valid until superseded."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:date ;
    cmm:physicalColumn "baseline_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:LoadBaseline.baselineLoadProfileJson a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline load profile json"@en ;
    rdfs:comment "JSON-encoded array of baseline load values (kWh) for each interval within the event window. Each element represents the expected load for a specific time interval. Format: [{\"interval_start\":\"2024-07-15T14:00:00\",\"load_kwh\":125.4},{\"interval_start\":\"2024-07-15T14:15:00\",\"load_kwh\":128.2}]."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_load_profile_json" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Load Profile JSON" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.baselineMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline methodology"@en ;
    rdfs:comment "The methodology used to calculate the customer baseline load. Common methods include 10-of-10 (average of 10 most recent similar days), high-10-of-10 (highest 10 days), mid-8-of-10 (middle 8 of 10), regression-based, weather-adjusted, or customer-specific algorithms approved by the ISO/RTO or PUC."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Methodology" ;
    cmm:validValues "10-of-10|high-10-of-10|mid-8-of-10|regression|weather-adjusted|customer-specific" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.baselineSourceDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline source days"@en ;
    rdfs:comment "Comma-separated list of dates (YYYY-MM-DD) used as source data for calculating this baseline. Provides traceability to the historical load data used in the calculation."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_source_days" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Source Days" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.baselineStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline status"@en ;
    rdfs:comment "Current lifecycle status of the baseline record. Indicates whether the baseline is in draft, pending approval, approved for use, actively in use, superseded by a newer version, or rejected."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Baseline Status" ;
    cmm:validValues "draft|pending-approval|approved|active|superseded|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Curve.status .
cmm:LoadBaseline.baselineToEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline to enrollment"@en ;
    rdfs:comment "FK to demand.dr_enrollment.dr_enrollment_id — Baselines are calculated per enrolled resource. Required for M&V — you cannot measure curtailment without linking baseline to the enrolled customer/resource."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:long ;
    cmm:physicalColumn "baseline_to_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:LoadBaseline.baselineVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline version"@en ;
    rdfs:comment "Version number of this baseline calculation. Increments with each recalculation or adjustment. Used for audit trail and historical comparison."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:int ;
    cmm:physicalColumn "baseline_version" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Version Number" ;
    cmm:cimDatatype "Integer" .
cmm:LoadBaseline.calculationEngine a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation engine"@en ;
    rdfs:comment "Name and version of the software system or calculation engine used to compute this baseline (e.g., Oracle MDM Baseline Calculator v3.2, Custom Python Engine v1.5). Used for audit and reproducibility."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_engine" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Engine" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this baseline record was first created in the system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Curve.createdDateTime .
cmm:LoadBaseline.dataQualityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "Quality score (0-100) indicating the reliability of the input meter data used for baseline calculation. Based on completeness, accuracy, and validation status of interval data."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Score" ;
    cmm:cimDatatype "Decimal" .
cmm:LoadBaseline.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "Method used to estimate missing interval data in the baseline calculation. Options include none (no estimation), linear interpolation, similar-day substitution, regression-based estimation, or carry-forward from previous interval."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Data Estimation Method" ;
    cmm:validValues "none|linear-interpolation|similar-day|regression|carry-forward" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.eventWindowEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event window end timestamp"@en ;
    rdfs:comment "The end timestamp of the DR event window for which this baseline applies. Defines the conclusion of the curtailment measurement period."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_window_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Window End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LoadBaseline.eventWindowStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event window start timestamp"@en ;
    rdfs:comment "The start timestamp of the DR event window for which this baseline applies. Defines the beginning of the curtailment measurement period."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_window_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Window Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LoadBaseline.exclusionDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exclusion days"@en ;
    rdfs:comment "Comma-separated list of dates (YYYY-MM-DD) that were excluded from the baseline calculation due to holidays, prior DR events, or anomalous load conditions."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "exclusion_days" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exclusion Days" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.intervalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval duration minutes"@en ;
    rdfs:comment "The duration of each interval in the baseline load profile, typically 15 or 60 minutes. Aligns with AMI meter reading intervals."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Duration in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:LoadBaseline.isoRtoSubmissionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto submission timestamp"@en ;
    rdfs:comment "Timestamp when this baseline was submitted to the ISO/RTO for settlement. Null if not yet submitted."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "iso_rto_submission_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Submission Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:LoadBaseline.isoRtoSubmittedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto submitted flag"@en ;
    rdfs:comment "Indicates whether this baseline has been submitted to the ISO/RTO for settlement purposes. True if submitted, False otherwise."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "iso_rto_submitted_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Submitted Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LoadBaseline.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "Username or identifier of the user or system process that last modified this baseline record. Required for audit trail."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this baseline record was last modified. Updated whenever any field in the record changes."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:LoadBaseline.missingIntervalCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "missing interval count"@en ;
    rdfs:comment "Number of intervals with missing or invalid meter data that were estimated or excluded from the baseline calculation. Used to assess baseline reliability."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:int ;
    cmm:physicalColumn "missing_interval_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Missing Interval Count" ;
    cmm:cimDatatype "Integer" .
cmm:LoadBaseline.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes documenting special circumstances, manual adjustments, or exceptions applied during baseline calculation. Used for audit trail and operational transparency."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Baseline Calculation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:LoadBaseline.peakBaselineDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak baseline demand kw"@en ;
    rdfs:comment "The maximum demand (kW) observed in the baseline load profile during the event window. Used for capacity-based DR program settlement."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_baseline_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Baseline Demand in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:LoadBaseline.pucReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reporting flag"@en ;
    rdfs:comment "Indicates whether this baseline is included in PUC program performance reporting. True if included, False otherwise."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LoadBaseline.temperatureSensitivityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature sensitivity flag"@en ;
    rdfs:comment "Indicates whether this customer's load is temperature-sensitive and requires weather-adjusted baseline methodology. True if temperature-sensitive, False otherwise."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "temperature_sensitivity_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature Sensitivity Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LoadBaseline.toDrEnrollment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to dr enrollment"@en ;
    rdfs:comment "FK to demand.dr_enrollment.dr_enrollment_id — Baselines are calculated per enrolled resource. Without this FK, you cannot match baselines to the correct customer enrollment for M&V calculations."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_dr_enrollment" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:LoadBaseline.totalBaselineEnergyKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total baseline energy kwh"@en ;
    rdfs:comment "The sum of all interval baseline load values across the entire event window, expressed in kilowatt-hours (kWh). Used for aggregate curtailment measurement."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_baseline_energy_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Baseline Energy in Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:LoadBaseline.weatherStationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather station code"@en ;
    rdfs:comment "Identifier of the weather station used for weather-adjusted baseline calculations. Links to external weather data sources (e.g., NOAA, local meteorological services)."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_station_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Station Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:LoadBaseline.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "Username or identifier of the user or system process that created this baseline record. Required for audit trail."@en ;
    rdfs:domain cmm:LoadBaseline ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:CurtailmentMeasurement a owl:Class ;
    rdfs:label "Curtailment Measurement"@en ;
    rdfs:comment "Post-event measurement record capturing actual load curtailment achieved by an enrolled resource during a DR event interval. Stores interval-level metered load (kWh/kW), baseline load, calculated curtailment (kW), data source (AMI, SCADA, estimated), validation status, VEE flags, and M&V method applied. Feeds DR settlement, incentive payment calculation, and ISO/RTO performance reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MeasurementValue ;
    cmm:cimExtends cim:MeasurementValue ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.event_execution ;
    cmm:physicalTable "utility_cmm_silver.demand.curtailment_measurement" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NAESB WEQ-015; Oracle MDM Interval Data; FERC Order 745 Measurement and Verification" ;
    cmm:sourceObject "energy_utilities_ecm.demand.curtailment_measurement" ;
    owl:hasKey ( cmm:CurtailmentMeasurement.curtailmentMeasurementId ) .

cmm:CurtailmentMeasurement.curtailmentMeasurementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment measurement id"@en ;
    rdfs:comment "Unique identifier for the curtailment measurement record. Primary key for post-event measurement records capturing actual load reduction achieved during a Demand Response (DR) event interval."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "curtailment_measurement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Curtailment Measurement ID" ;
    cmm:cimDatatype "Integer" .
cmm:CurtailmentMeasurement.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Measurement & verification data serves as primary audit evidence for DR performance audits. Essential for M&V audit support, compliance documentation, and providing granular interval data to auditors"@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_audit_id" ;
    cmm:cimAssociation "MeasurementValue.ActivityRecord" .
cmm:CurtailmentMeasurement.curtailmentDrEventParticipant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment dr event participant"@en ;
    rdfs:comment "FK to demand.dr_event_participant.dr_event_participant_id — Curtailment measurements are interval-level detail records for a participant's event performance. Required for M&V settlement calculations."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:DrEventParticipant ;
    cmm:physicalColumn "curtailment_dr_event_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "dr_event_participant_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_curtailment_dr_event_participant_id" ;
    cmm:cimAssociation "MeasurementValue.IdentifiedObject" .
cmm:CurtailmentMeasurement.curtailmentLoadBaseline a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment load baseline"@en ;
    rdfs:comment "FK to demand.load_baseline.load_baseline_id — Each curtailment measurement references the baseline used for comparison. Required for auditable M&V calculations."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:LoadBaseline ;
    cmm:physicalColumn "curtailment_load_baseline_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "load_baseline_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_curtailment_load_baseline_id" ;
    cmm:cimAssociation "MeasurementValue.Curve" .
cmm:CurtailmentMeasurement.demandDrEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "demand dr enrollment"@en ;
    rdfs:comment "Reference to the enrolled DR resource (customer premise, aggregated load zone, or DER asset) that participated in the curtailment event."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "demand_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Enrolled Resource ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_demand_dr_enrollment_id" ;
    cmm:cimAssociation "MeasurementValue.Agreement" .
cmm:CurtailmentMeasurement.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: Measurement & verification of curtailment performance requires DER system nameplate capacity, inverter specifications, and export limits from interconnection approval. Settlement quantity calculation"@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der System Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_der_system_id" ;
    cmm:cimAssociation "MeasurementValue.PowerElectronicsConnection" .
cmm:CurtailmentMeasurement.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Reference to the parent DR event during which this curtailment was measured. Links to the DR event dispatch record that triggered the load reduction."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_dr_event_id" ;
    cmm:cimAssociation "MeasurementValue.EndDeviceControl" .
cmm:CurtailmentMeasurement.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the user or system that validated this measurement record. Used for audit trail and accountability in the M&V process."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Validated By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_employee_id" ;
    cmm:cimAssociation "MeasurementValue.ErpPersonnel" .
cmm:CurtailmentMeasurement.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Curtailment measurements drive financial settlements with incentive_amount and penalty_amount requiring GL account posting for journal entries. Essential for accrual accounting, month-end close, and r"@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_gl_account_id" ;
    cmm:cimAssociation "MeasurementValue.ErpChartOfAccounts" .
cmm:CurtailmentMeasurement.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Identifier of the LMP pricing node or zone where this curtailment resource is located. Used for wholesale market settlement and valuation of the load reduction at the nodal or zonal LMP."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Locational Marginal Price (LMP) Node ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_lmp_price_id" ;
    cmm:cimAssociation "MeasurementValue.PnodeResults" .
cmm:CurtailmentMeasurement.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: M&V processes compare actual curtailment against forecasted load to calculate performance and settlement quantities. Required for ISO/RTO settlement, incentive payment calculation, and regulatory comp"@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_load_id" ;
    cmm:cimAssociation "MeasurementValue.ConformLoadSchedule" .
cmm:CurtailmentMeasurement.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the meter or metering point from which interval data was sourced for this measurement. May be an AMI meter, SCADA point, or aggregated virtual meter."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_meter_id" ;
    cmm:cimAssociation "MeasurementValue.Meter" .
cmm:CurtailmentMeasurement.toDrEventParticipant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to dr event participant"@en ;
    rdfs:comment "FK to demand.dr_event_participant.dr_event_participant_id — Curtailment measurements are taken per participant per event. This FK links measured load reduction to the specific participant response record."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:DrEventParticipant ;
    cmm:physicalColumn "to_dr_event_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_to_dr_event_participant_id" ;
    cmm:cimAssociation "MeasurementValue.IdentifiedObject" .
cmm:CurtailmentMeasurement.toLoadBaseline a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to load baseline"@en ;
    rdfs:comment "FK to demand.load_baseline.load_baseline_id — Each curtailment measurement references the baseline used to calculate the reduction. Required for M&V audit trail."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range cmm:LoadBaseline ;
    cmm:physicalColumn "to_load_baseline_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_curtailment_measurement_to_load_baseline_id" ;
    cmm:cimAssociation "MeasurementValue.Curve" .
cmm:CurtailmentMeasurement.baselineAdjustmentFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline adjustment factor"@en ;
    rdfs:comment "Multiplicative adjustment factor applied to the baseline to account for day-of conditions (weather, operational changes). Typically ranges from 0.8 to 1.2. A value of 1.0 indicates no adjustment."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_adjustment_factor" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Adjustment Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:CurtailmentMeasurement.baselineDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline demand kw"@en ;
    rdfs:comment "Calculated baseline power demand in kilowatts (kW) representing what the resource would have demanded absent the DR event. Used as the reference for curtailment calculation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Demand (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.baselineLoadKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline load kwh"@en ;
    rdfs:comment "Calculated baseline energy consumption in kilowatt-hours (kWh) representing what the resource would have consumed absent the DR event. Calculated using the baseline methodology specified in the DR program rules."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_load_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Load (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CurtailmentMeasurement.baselineMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline method code"@en ;
    rdfs:comment "Code identifying the baseline calculation methodology applied for this measurement. Common methods include High X of Y (e.g., average of highest 3 of last 10 similar days), Mid X of Y, regression-based, control group, meter-before, or customer-provided baseline."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Method Code" ;
    cmm:validValues "HIGH_X_OF_Y|MID_X_OF_Y|REGRESSION|CONTROL_GROUP|METER_BEFORE|CUSTOMER_BASELINE" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.bidQuantityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bid quantity kw"@en ;
    rdfs:comment "The bid quantity in kilowatts (kW) submitted by the resource or aggregator for this DR event interval. May differ from enrolled_capacity_kw if the resource bid a different amount for this specific event."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bid_quantity_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bid Quantity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this curtailment measurement record was first created in the system. Represents the initial calculation or data ingestion time."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.createdDateTime .
cmm:CurtailmentMeasurement.curtailmentKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment kw"@en ;
    rdfs:comment "Calculated load curtailment achieved during the interval in kilowatts (kW). Computed as baseline_demand_kw minus metered_demand_kw. Positive values indicate successful load reduction; negative values indicate load increase."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "curtailment_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.curtailmentKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment kwh"@en ;
    rdfs:comment "Calculated energy curtailment achieved during the interval in kilowatt-hours (kWh). Computed as baseline_load_kwh minus metered_load_kwh. Used for settlement and incentive payment calculation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "curtailment_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CurtailmentMeasurement.dataQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality code"@en ;
    rdfs:comment "Code indicating the quality status of the metered data. ACTUAL indicates raw meter data; ESTIMATED indicates VEE-filled gaps; VALIDATED indicates passed quality checks; SUSPECT indicates potential data issues; MISSING indicates no data received; REJECTED indicates failed validation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Code" ;
    cmm:validValues "ACTUAL|ESTIMATED|VALIDATED|SUSPECT|MISSING|REJECTED" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:CurtailmentMeasurement.dataSourceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source code"@en ;
    rdfs:comment "Code identifying the source of the metered load data. Values include AMI (Advanced Metering Infrastructure), SCADA (Supervisory Control and Data Acquisition), MANUAL (manual meter read), ESTIMATED (VEE-estimated), AGGREGATED (sum of multiple meters), or TELEMETRY (real-time sensor data)."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source Code" ;
    cmm:validValues "AMI|SCADA|MANUAL|ESTIMATED|AGGREGATED|TELEMETRY" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.enrolledCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled capacity kw"@en ;
    rdfs:comment "The enrolled or nominated load reduction capacity in kilowatts (kW) for this resource during the DR event. Represents the committed curtailment target used for performance evaluation and settlement."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.incentiveAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive amount"@en ;
    rdfs:comment "Calculated incentive payment amount in currency for this measurement interval. Computed as settlement_quantity_kw multiplied by incentive_rate_per_kwh and interval duration. Subject to program caps and adjustments."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CurtailmentMeasurement.incentiveRatePerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate per kwh"@en ;
    rdfs:comment "The incentive payment rate in currency per kilowatt-hour ($/kWh) applicable to this measurement interval. Rate may vary by time-of-use period, event type, or performance tier."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_rate_per_kwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Rate per kWh" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CurtailmentMeasurement.intervalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval duration minutes"@en ;
    rdfs:comment "Duration of the measurement interval in minutes. Common values are 5, 15, or 60 minutes depending on ISO/RTO market settlement rules and meter data granularity."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:CurtailmentMeasurement.intervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval end timestamp"@en ;
    rdfs:comment "End timestamp of the measurement interval during the DR event. Defines the boundary of the measurement period for load curtailment calculation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:CurtailmentMeasurement.intervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval start timestamp"@en ;
    rdfs:comment "Start timestamp of the measurement interval during the DR event. Typically aligned to 5-minute, 15-minute, or hourly intervals per ISO/RTO settlement rules."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:CurtailmentMeasurement.isoRtoMarketCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto market code"@en ;
    rdfs:comment "Code identifying the ISO/RTO wholesale market to which this curtailment measurement is reported for settlement. Values include CAISO, ERCOT, ISONE, MISO, NYISO, PJM, SPP, or NONE for retail-only programs. Reference-value candidates: CAISO|ERCOT|ISONE|MISO|NYISO|PJM|SPP|NONE."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_market_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Market Code" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.lmpPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price per mwh"@en ;
    rdfs:comment "The Locational Marginal Price in currency per megawatt-hour ($/MWh) at the resource location during this interval. Used to value the curtailment for wholesale market settlement or avoided cost calculation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lmp_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) per MWh" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CurtailmentMeasurement.measurementStatusCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement status code"@en ;
    rdfs:comment "Lifecycle status of the curtailment measurement record. PRELIMINARY indicates initial calculation; VALIDATED indicates passed M&V review; SETTLED indicates used for payment calculation; DISPUTED indicates under review; ADJUSTED indicates corrected after dispute; FINAL indicates locked for regulatory reporting."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_status_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Status Code" ;
    cmm:validValues "PRELIMINARY|VALIDATED|SETTLED|DISPUTED|ADJUSTED|FINAL" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.meteredDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metered demand kw"@en ;
    rdfs:comment "Actual power demand measured during the interval in kilowatts (kW). Represents the average or peak demand during the measurement period depending on metering configuration."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "metered_demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Metered Demand (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.meteredLoadKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metered load kwh"@en ;
    rdfs:comment "Actual energy consumption measured during the interval in kilowatt-hours (kWh). Sourced from AMI meter data, SCADA telemetry, or estimated via Validation Estimation and Editing (VEE) process."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "metered_load_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Metered Load (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CurtailmentMeasurement.mvMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mv method code"@en ;
    rdfs:comment "Code identifying the Measurement and Verification (M&V) protocol applied to validate the curtailment calculation. Common protocols include IPMVP Options A-D (International Performance Measurement and Verification Protocol) or utility-specific custom methods."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "mv_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement and Verification (M&V) Method Code" ;
    cmm:validValues "OPTION_A|OPTION_B|OPTION_C|OPTION_D|IPMVP|CUSTOM" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.penaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty amount"@en ;
    rdfs:comment "Penalty amount in currency assessed for under-performance or non-compliance during this interval. Applied when actual curtailment falls below minimum performance thresholds defined in the DR program agreement."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "penalty_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Penalty Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CurtailmentMeasurement.performanceRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance ratio"@en ;
    rdfs:comment "Ratio of actual curtailment achieved to the enrolled capacity or bid quantity for this resource during the interval. Calculated as curtailment_kw divided by enrolled_capacity_kw. Values above 1.0 indicate over-performance; below 1.0 indicate under-performance."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "performance_ratio" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:CurtailmentMeasurement.reportedToIsoFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported to iso flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement has been reported to the ISO/RTO for wholesale market settlement. True indicates the record was included in the ISO/RTO performance report; False indicates retail-only or not yet reported."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reported_to_iso_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported to ISO Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CurtailmentMeasurement.reportedToIsoTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported to iso timestamp"@en ;
    rdfs:comment "Timestamp when this measurement was submitted to the ISO/RTO for wholesale market settlement. Used for tracking reporting deadlines and settlement cycles."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "reported_to_iso_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reported to ISO Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:CurtailmentMeasurement.reportedToPucFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported to puc flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement has been included in regulatory reporting to the state Public Utility Commission (PUC). True indicates the record was included in DR program performance reports; False indicates not yet reported."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reported_to_puc_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported to Public Utility Commission (PUC) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CurtailmentMeasurement.settlementQuantityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement quantity kw"@en ;
    rdfs:comment "The final settled curtailment quantity in kilowatts (kW) used for incentive payment calculation. May differ from curtailment_kw after applying performance thresholds, caps, or adjustments per program rules."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "settlement_quantity_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Quantity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CurtailmentMeasurement.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this curtailment measurement record was last modified. Tracks revisions due to data corrections, dispute resolution, or re-calculation with updated baseline methods."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CurtailmentMeasurement.validatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validated timestamp"@en ;
    rdfs:comment "Timestamp when this measurement record was validated and approved for settlement. Marks the transition from preliminary to validated status in the measurement lifecycle."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "validated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:CurtailmentMeasurement.validationNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation notes"@en ;
    rdfs:comment "Free-text notes documenting validation findings, data quality issues, adjustments applied, or dispute resolution details for this measurement record. Used for audit trail and M&V documentation."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CurtailmentMeasurement.veeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee flag"@en ;
    rdfs:comment "Boolean flag indicating whether the metered data was processed through Validation Estimation and Editing (VEE) logic. True indicates VEE was applied to fill gaps or correct suspect data; False indicates raw meter data was used."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vee_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CurtailmentMeasurement.veeMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee method code"@en ;
    rdfs:comment "Code identifying the VEE estimation method applied when metered data was missing or suspect. Common methods include linear interpolation, historical average, similar day substitution, regression-based estimation, or NONE if no VEE was applied."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "vee_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Method Code" ;
    cmm:validValues "LINEAR_INTERPOLATION|HISTORICAL_AVERAGE|SIMILAR_DAY|REGRESSION|NONE" ;
    cmm:cimDatatype "String" .
cmm:CurtailmentMeasurement.weatherHumidityPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather humidity percent"@en ;
    rdfs:comment "Relative humidity percentage at the resource location during the measurement interval. Used for baseline adjustment in weather-sensitive load profiles."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weather_humidity_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Humidity (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CurtailmentMeasurement.weatherTemperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather temperature f"@en ;
    rdfs:comment "Ambient temperature in degrees Fahrenheit at the resource location during the measurement interval. Used for baseline adjustment and performance analysis. May be sourced from weather station data or utility weather service."@en ;
    rdfs:domain cmm:CurtailmentMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weather_temperature_f" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Temperature (Fahrenheit)" ;
    cmm:cimDatatype "Decimal" .

cmm:DrIncentivePayment a owl:Class ;
    rdfs:label "Dr Incentive Payment"@en ;
    rdfs:comment "Transactional record of all DR financial settlements and incentive payments, serving as the single authoritative financial record for the demand domain. Covers wholesale market settlement (ISO/RTO capacity and energy payments, LMP-based calculations, performance adjustments, settlement statement references, settlement period reconciliation) and retail-level incentive disbursements (capacity payments, energy payments, performance bonuses, penalty deductions). Captures settlement period, calculation basis, enrolled capacity, measured curtailment, gross and net amounts, aggregator share, utility net cost, payment approval status, disbursement reference, reconciliation status, and ISO/RTO settlement statement cross-reference. SSOT for ALL DR financial obligations — wholesale settlement, retail incentives, aggregator payments, customer disbursements, and settlement reconciliation with wholesale markets."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimBroadMatch cim:Transaction ;
    cmm:cimMappingLevel "broad" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:demand , cmmsa:demand.event_execution ;
    cmm:physicalTable "utility_cmm_silver.demand.dr_incentive_payment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "SAP IS-U FICA DR Payment; FERC Order 745 Compensation" ;
    cmm:sourceObject "energy_utilities_ecm.demand.dr_incentive_payment" ;
    owl:hasKey ( cmm:DrIncentivePayment.drIncentivePaymentId ) .

cmm:DrIncentivePayment.drIncentivePaymentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dr incentive payment id"@en ;
    rdfs:comment "Unique identifier for the demand response incentive payment transaction. Primary key for the DR incentive payment record."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:long ;
    cmm:physicalColumn "dr_incentive_payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Demand Response (DR) Incentive Payment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DrIncentivePayment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with this incentive payment for billing integration."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_account_id" ;
    cmm:cimAssociation "Transaction.CustomerAccount" .
cmm:DrIncentivePayment.aggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "Reference to the demand response aggregator managing the customer enrollment and receiving payment on behalf of enrolled customers."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Aggregator Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_aggregator_id" ;
    cmm:cimAssociation "Transaction.MarketParticipant" .
cmm:DrIncentivePayment.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Incentive payments are audited for accuracy and regulatory compliance, especially for cost recovery in rate cases. Required for financial audit trail, settlement verification, and demonstrating pruden"@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_audit_id" ;
    cmm:cimAssociation "Transaction.ActivityRecord" .
cmm:DrIncentivePayment.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Incentive payments are expenses charged to cost centers for budget tracking and variance analysis. Utility_net_cost requires cost center assignment to enable budget-to-actual reporting and cost alloca"@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_cost_center_id" ;
    cmm:cimAssociation "Transaction.Organisation" .
cmm:DrIncentivePayment.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "FK to demand.dr_event.dr_event_id — Incentive payments and settlements are calculated per event (or per settlement period covering events). This FK links financial obligations to the triggering event for reconciliation."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_dr_event_id" ;
    cmm:cimAssociation "Transaction.EndDeviceControl" .
cmm:DrIncentivePayment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "FK to demand.dr_program.dr_program_id — Payments are issued under program-specific incentive structures. Required for program-level financial reporting."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_dr_program_id" ;
    cmm:cimAssociation "Transaction.DemandResponseProgram" .
cmm:DrIncentivePayment.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: Payment calculations for energy-based DR programs use LMP forecasts for valuation and settlement pricing. Essential for economic dispatch decisions, participant compensation, and cost-effectiveness an"@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_energy_price_id" ;
    cmm:cimAssociation "Transaction.RegularIntervalSchedule" .
cmm:DrIncentivePayment.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Incentive payments must post to specific GL accounts (typically FERC 565 - Customer Assistance Expenses or similar) for financial statement preparation, journal entry creation, and regulatory reportin"@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_gl_account_id" ;
    cmm:cimAssociation "Transaction.ErpChartOfAccounts" .
cmm:DrIncentivePayment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Payment eligibility verification requires confirmed interconnection approval status. Capacity payments are tied to interconnection-approved export capacity limits. ISO/RTO settlement reconciliation va"@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_interconnection_application_id" ;
    cmm:cimAssociation "Transaction.Request" .
cmm:DrIncentivePayment.primaryDrEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary dr event"@en ;
    rdfs:comment "Reference to the specific demand response event that triggered this incentive payment."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "primary_dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
