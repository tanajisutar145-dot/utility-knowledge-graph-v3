cmm:SectionalizingDevice.installationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation type"@en ;
    rdfs:comment "Physical installation configuration of the device. Determines accessibility, maintenance procedures, and environmental protection requirements."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
