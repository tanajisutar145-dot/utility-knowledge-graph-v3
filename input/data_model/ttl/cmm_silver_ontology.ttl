cmm:ContractorWorker.ppeCertificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ppe certification status"@en ;
    rdfs:comment "Status of required Personal Protective Equipment certification for the contractor worker, including arc flash PPE, fall protection, and respiratory protection (current, expired, pending, not_required)."@en ;
