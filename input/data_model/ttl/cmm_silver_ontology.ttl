    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Event Review Status" ;
    cmm:validValues "not_started|in_progress|completed|findings_documented|action_items_assigned" ;
    cmm:cimDatatype "String" .
cmm:EmergencyStockEvent.regulatoryReportingRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting required flag"@en ;
    rdfs:comment "Indicates whether this emergency event requires formal reporting to state Public Utility Commission (PUC) or other regulatory bodies."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reporting_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmergencyStockEvent.restorationCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration completion date"@en ;
    rdfs:comment "Date when restoration activities were completed and normal operations resumed."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:date ;
    cmm:physicalColumn "restoration_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:EmergencyStockEvent.restorationCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration completion timestamp"@en ;
    rdfs:comment "Precise timestamp when restoration was completed, used for calculating restoration duration and performance metrics."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmergencyStockEvent.saidiImpactMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi impact minutes"@en ;
    rdfs:comment "Total customer-minutes of interruption attributed to this emergency event, used for reliability performance tracking."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_impact_minutes" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SAIDI (System Average Interruption Duration Index) Impact Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:EmergencyStockEvent.saifiImpactCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi impact count"@en ;
    rdfs:comment "Average number of interruptions per customer attributed to this emergency event, used for reliability performance tracking."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_impact_count" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SAIFI (System Average Interruption Frequency Index) Impact Count" ;
    cmm:cimDatatype "Decimal" .
cmm:EmergencyStockEvent.sourcingMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sourcing method"@en ;
    rdfs:comment "Method used to source and procure materials for the emergency event, indicating procurement execution strategy."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "sourcing_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sourcing Method" ;
    cmm:validValues "emergency_po|mutual_aid|spot_buy|existing_stock|vendor_consignment|expedited_contract" ;
    cmm:cimDatatype "String" .
cmm:EmergencyStockEvent.targetLeadTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target lead time hours"@en ;
    rdfs:comment "Target or planned lead time in hours for emergency material deployment, used for performance comparison."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "target_lead_time_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Lead Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:EmergencyStockEvent.totalEmergencySpend a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total emergency spend"@en ;
    rdfs:comment "Total financial expenditure for emergency material procurement and deployment, including all costs associated with this event."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_emergency_spend" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Emergency Spend" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:EmergencyStockEvent.totalQuantityRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total quantity requested"@en ;
    rdfs:comment "Aggregate quantity of materials requested across all line items for this emergency event."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_quantity_requested" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Quantity Requested" ;
    cmm:cimDatatype "Decimal" .
cmm:EmergencyStockEvent.triggeringIncidentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering incident reference"@en ;
    rdfs:comment "Reference identifier to the originating incident, outage event, or work order that triggered the emergency stock deployment."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_incident_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Incident Reference" ;
    cmm:cimDatatype "String" .
cmm:EmergencyStockEvent.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "Work Breakdown Structure element for capital project tracking if emergency materials are capitalized."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "WBS (Work Breakdown Structure) Element" ;
    cmm:cimDatatype "String" .
cmm:EmergencyStockEvent.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User ID or name of the person who created the emergency stock event record in the system."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:InventoryCount a owl:Class ;
    rdfs:label "Inventory Count"@en ;
    rdfs:comment "Physical inventory count records for utility warehouses and storerooms capturing periodic and cycle count results. Captures count identification (inventory document number, count date), location (plant, storage location), material details (material, book quantity, counted quantity, difference quantity, difference value), count workflow (status: not yet counted, counted, recounted, posted; counter ID, recount reason). Supports regulatory asset verification, insurance valuation, Sarbanes-Oxley inventory controls, and inventory accuracy KPIs for utility supply chain management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpInventoryCount ;
    cmm:cimExactMatch cim:ErpInventoryCount ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:supply , cmmsa:supply.inventory_control ;
    cmm:physicalTable "utility_cmm_silver.supply.inventory_count" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-10; SAP MM Physical Inventory (MI01/ISEG)" ;
    cmm:sourceObject "energy_utilities_ecm.supply.inventory_count" ;
    owl:hasKey ( cmm:InventoryCount.inventoryCountId ) .

cmm:InventoryCount.inventoryCountId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inventory count id"@en ;
    rdfs:comment "Unique identifier for the physical inventory count record. Primary key for the inventory count entity."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:long ;
    cmm:physicalColumn "inventory_count_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Inventory Count ID" ;
    cmm:cimDatatype "Integer" .
cmm:InventoryCount.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "The employee ID or user ID of the person who performed the physical count. Used for accountability and audit trail."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counter ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_employee_id" ;
    cmm:cimAssociation "ErpInventoryCount.ErpPersonnel" .
cmm:InventoryCount.inventoryMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inventory material master"@en ;
    rdfs:comment "Foreign key reference to the material master record being counted. Links to the material being inventoried."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "inventory_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_inventory_material_master_id" ;
    cmm:cimAssociation "ErpInventoryCount.ErpItemMaster" .
cmm:InventoryCount.inventoryWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inventory warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Inventory counts are performed at specific warehouses. N:1 relationship - many counts at one warehouse (periodic counts, cycle counts, spot counts). Adding warehouse_id FK enables JOIN to retrieve war"@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "inventory_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Warehouse Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_inventory_warehouse_id" ;
    cmm:cimAssociation "ErpInventoryCount.WorkLocation" .
cmm:InventoryCount.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "FK to supply.material_master.material_master_id — Physical inventory counts are performed per material. FK needed for count accuracy reconciliation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_material_master_id" ;
    cmm:cimAssociation "ErpInventoryCount.ErpItemMaster" .
cmm:InventoryCount.toMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to material master"@en ;
    rdfs:comment "FK to supply.material_master.material_master_id — Physical counts are per-material per-location. Required for inventory accuracy reconciliation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "to_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_to_material_master_id" ;
    cmm:cimAssociation "ErpInventoryCount.ErpItemMaster" .
cmm:InventoryCount.toWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to warehouse"@en ;
    rdfs:comment "FK to supply.warehouse.warehouse_id — Physical counts occur at specific warehouse/storage locations. Required for count scheduling and reconciliation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "to_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_to_warehouse_id" ;
    cmm:cimAssociation "ErpInventoryCount.WorkLocation" .
cmm:InventoryCount.warehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "warehouse"@en ;
    rdfs:comment "FK to supply.warehouse.warehouse_id — Counts are performed at specific warehouse locations. Required for location-level inventory accuracy KPIs."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_inventory_count_warehouse_id" ;
    cmm:cimAssociation "ErpInventoryCount.WorkLocation" .
cmm:InventoryCount.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which the count was approved for posting. Null if approval not required or not yet approved."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:InventoryCount.approvalRequiredIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required indicator"@en ;
    rdfs:comment "Flag indicating whether supervisor or management approval is required before posting the count differences, typically for high-value variances or regulatory compliance."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Required Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:InventoryCount.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "The user ID or employee ID of the supervisor or manager who approved the count posting. Null if approval not required or not yet approved."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.batchNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "batch number"@en ;
    rdfs:comment "The batch or lot number for batch-managed materials such as chemicals, fuel additives, or time-sensitive spare parts. Null for non-batch materials."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "batch_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Batch Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InventoryCount.bookQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book quantity"@en ;
    rdfs:comment "The system book quantity (expected quantity) in inventory records at the time of count. Used to calculate variance."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "book_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Book Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:InventoryCount.costCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "The cost center responsible for the inventory location or the cost center to which inventory variances will be posted. Used for financial accountability."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center" ;
    cmm:valuePattern "^[A-Z0-9]{10}$" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.countDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "count date"@en ;
    rdfs:comment "The date on which the physical inventory count was performed. Critical for regulatory compliance and inventory accuracy tracking."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:date ;
    cmm:physicalColumn "count_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Count Date" ;
    cmm:cimDatatype "Date" .
cmm:InventoryCount.countNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "count notes"@en ;
    rdfs:comment "Free-text notes or comments entered by the counter regarding count conditions, issues encountered, or explanations for variances."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "count_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Count Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:InventoryCount.countStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "count status"@en ;
    rdfs:comment "Current workflow status of the inventory count: not_yet_counted (document created but count pending), counted (initial count completed), recounted (variance recount performed), posted (differences posted to inventory), cancelled (count voided)."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "count_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Count Status" ;
    cmm:validValues "not_yet_counted|counted|recounted|posted|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpInventoryCount.status .
cmm:InventoryCount.countType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "count type"@en ;
    rdfs:comment "The type of inventory count performed: periodic (scheduled full count), cycle (rotating partial count), spot (ad-hoc verification), annual (year-end regulatory count), or emergency (post-storm restoration verification)."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "count_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Count Type" ;
    cmm:validValues "periodic|cycle|spot|annual|emergency" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ErpInventoryCount.kind .
cmm:InventoryCount.countedQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "counted quantity"@en ;
    rdfs:comment "The actual physical quantity counted during the inventory count. Compared against book quantity to identify discrepancies."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "counted_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Counted Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:InventoryCount.counterName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "counter name"@en ;
    rdfs:comment "The name of the employee who performed the physical count. Denormalized for reporting convenience."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "counter_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Counter Name" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when the inventory count document was created in the system. Critical for audit trail and regulatory compliance."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpInventoryCount.createdDateTime .
cmm:InventoryCount.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code for valuation amounts (e.g., USD, EUR, CAD)."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:InventoryCount.deletionIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deletion indicator"@en ;
    rdfs:comment "Flag indicating whether this inventory count record has been marked for deletion or cancellation. Soft delete for audit trail preservation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "deletion_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deletion Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:InventoryCount.differenceQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "difference quantity"@en ;
    rdfs:comment "The variance between counted quantity and book quantity (counted minus book). Positive indicates surplus, negative indicates shortage."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "difference_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Difference Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:InventoryCount.differenceValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "difference value"@en ;
    rdfs:comment "The financial value of the inventory variance (difference quantity multiplied by material price). Critical for Sarbanes-Oxley inventory controls and insurance valuation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "difference_value" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Difference Value" ;
    cmm:cimDatatype "Decimal" .
cmm:InventoryCount.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year in which the inventory count was performed. Part of the document key in SAP."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:valuePattern "^[0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.freezeBookInventoryIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "freeze book inventory indicator"@en ;
    rdfs:comment "Flag indicating whether the book inventory was frozen at the time of count creation to prevent movements during the count process. Best practice for accurate variance calculation."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "freeze_book_inventory_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Freeze Book Inventory Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:InventoryCount.glAccount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "The general ledger account to which inventory value and variances are posted. Critical for financial reporting and Sarbanes-Oxley compliance."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.inventoryDocumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inventory document number"@en ;
    rdfs:comment "The unique business identifier for the physical inventory document in SAP S/4HANA MM. Used for tracking and audit purposes."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "inventory_document_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inventory Document Number" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InventoryCount.materialDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material description"@en ;
    rdfs:comment "Short text description of the material being counted. Denormalized from material master for user readability in count reports."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Material Description" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.materialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material number"@en ;
    rdfs:comment "The SAP material number (business identifier) for the item being counted. Denormalized from material master for reporting convenience."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Material Number" ;
    cmm:valuePattern "^[A-Z0-9]{18}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InventoryCount.modifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by"@en ;
    rdfs:comment "The user ID of the person who last modified the inventory count record. Part of audit trail for change tracking."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "The date and time when the inventory count record was last modified. Tracks all changes for audit and compliance purposes."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InventoryCount.plantCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plant code"@en ;
    rdfs:comment "The SAP plant code identifying the utility facility or warehouse where the inventory count was performed. Represents generation plants, T&D warehouses, or service centers."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "plant_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Plant Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.postingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting date"@en ;
    rdfs:comment "The date on which the inventory count differences were posted to the financial and material ledgers. Null if count not yet posted."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:date ;
    cmm:physicalColumn "posting_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Date" ;
    cmm:cimDatatype "Date" .
cmm:InventoryCount.postingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "posting period"@en ;
    rdfs:comment "The fiscal period (1-12) in which the inventory differences were posted. Used for period-end closing and financial reporting."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:int ;
    cmm:physicalColumn "posting_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Posting Period" ;
    cmm:cimDatatype "Integer" .
cmm:InventoryCount.recountIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recount indicator"@en ;
    rdfs:comment "Flag indicating whether this count is a recount (true) or initial count (false). Recounts are triggered when variance exceeds tolerance thresholds."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "recount_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recount Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:InventoryCount.recountReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recount reason code"@en ;
    rdfs:comment "The reason code explaining why a recount was performed: variance_threshold (difference exceeded tolerance), audit_requirement (external audit request), quality_issue (suspected quality problem), system_error (suspected system issue), manual_request (supervisor override), regulatory (compliance requirement)."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "recount_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recount Reason Code" ;
    cmm:validValues "variance_threshold|audit_requirement|quality_issue|system_error|manual_request|regulatory" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "The serial number for serialized assets such as meters, transformers, or high-value generation equipment. Null for non-serialized materials."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:InventoryCount.specialStockIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "special stock indicator"@en ;
    rdfs:comment "Indicator for special stock types such as consignment stock, project stock, or customer stock. Blank for standard warehouse stock."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "special_stock_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Special Stock Indicator" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.stockType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stock type"@en ;
    rdfs:comment "The stock type or status of the inventory being counted: unrestricted (available for use), quality_inspection (pending QA), blocked (unusable), restricted (limited use), returns (vendor returns pending)."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "stock_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stock Type" ;
    cmm:validValues "unrestricted|quality_inspection|blocked|restricted|returns" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.storageLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage location"@en ;
    rdfs:comment "The specific storage location or storeroom within the plant where the material is physically stored and counted. Enables granular inventory tracking."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "storage_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storage Location" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "The unit of measure for the counted quantity (e.g., EA for each, FT for feet, GAL for gallons, TON for tons). ISO standard UOM codes."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:valuePattern "^[A-Z]{2,3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:InventoryCount.valuationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation amount"@en ;
    rdfs:comment "The total inventory value of the counted material at the time of count, calculated using standard or moving average price. Used for financial reporting."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "valuation_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Valuation Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InventoryCount.varianceTolerancePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance tolerance percent"@en ;
    rdfs:comment "The acceptable variance tolerance percentage for this material. Variances exceeding this threshold trigger recount or investigation workflows."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_tolerance_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Tolerance Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:InventoryCount.wbsElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wbs element"@en ;
    rdfs:comment "The WBS element for project-related inventory (e.g., capital construction projects, generation plant upgrades). Null for non-project inventory."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "wbs_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Breakdown Structure (WBS) Element" ;
    cmm:cimDatatype "String" .
cmm:InventoryCount.zeroCountIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "zero count indicator"@en ;
    rdfs:comment "Flag indicating whether the counted quantity was zero (material not found during physical count). Important for identifying potential shrinkage or theft."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "zero_count_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Zero Count Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:InventoryCount.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "The user ID of the person who created the inventory count document in the system. Part of audit trail for Sarbanes-Oxley compliance."@en ;
    rdfs:domain cmm:InventoryCount ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created By" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:SupplyAgreement a owl:Class ;
    rdfs:label "Supply Agreement"@en ;
    rdfs:comment "This association product represents the Supply Agreement between vendor and material_master. It captures the commercial and operational terms under which a specific vendor supplies a specific material to the utility. Each record links one vendor to one material_master with pricing, lead time, quality ratings, and procurement terms that exist only in the context of this vendor-material relationship. This is the operational SSOT for approved vendor lists (AVL), competitive sourcing decisions, and procurement execution.. Existence Justification: In utility supply chain operations, vendors supply multiple materials (transformers, conductors, meters, poles, fuel) and each material can be sourced from multiple approved vendors at different prices, lead times, and quality levels. Procurement teams actively manage vendor-material relationships through approved vendor lists (AVL), competitive bidding (RFQ), and sourcing strategies. This is a core operational M:N relationship central to supply chain management and emergency restoration planning."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:supply , cmmsa:supply.procurement_operations ;
    cmm:physicalTable "utility_cmm_silver.supply.supply_agreement" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.supply.supply_agreement" ;
    owl:hasKey ( cmm:SupplyAgreement.supplyAgreementId ) .

cmm:SupplyAgreement.supplyAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "supply agreement id"@en ;
    rdfs:comment "Primary key for supply_agreement"@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "supply_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "supply_agreement Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SupplyAgreement.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to the material being supplied under this agreement"@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supply Agreement - Material Master Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_supply_agreement_material_master_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpItemMaster" .
cmm:SupplyAgreement.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor who supplies this material under this agreement"@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supply Agreement - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_supply_agreement_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:SupplyAgreement.agreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement number"@en ;
    rdfs:comment "Primary key uniquely identifying each vendor-material supply agreement record"@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "agreement_number" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supply Agreement Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SupplyAgreement.agreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement status"@en ;
    rdfs:comment "Current lifecycle status of this supply agreement. ACTIVE=approved for procurement, INACTIVE=not currently used, PENDING=under evaluation, EXPIRED=contract ended, SUSPENDED=temporarily blocked."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:SupplyAgreement.contractReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract reference"@en ;
    rdfs:comment "Reference number or identifier of the master supply contract or blanket purchase agreement governing this vendor-material relationship, if applicable."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Reference" ;
    cmm:cimDatatype "String" .
cmm:SupplyAgreement.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this supply agreement record was created in the system. Audit trail for supply relationship establishment."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:SupplyAgreement.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the unit_price in this agreement. May differ from vendor default currency for specific materials or contracts."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:SupplyAgreement.deliveryRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery rating"@en ;
    rdfs:comment "On-time delivery performance score for this specific vendor-material combination. Scale 0-100. Reflects vendor reliability for this particular material, which may differ from their overall performance."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "delivery_rating" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Rating" ;
    cmm:cimDatatype "Decimal" .
cmm:SupplyAgreement.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date from which this supply agreement becomes valid and can be used for procurement. Supports time-based pricing and contract management."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:SupplyAgreement.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date on which this supply agreement expires and should no longer be used for new purchase orders. Null if no expiration. Supports contract lifecycle management."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:SupplyAgreement.lastPurchaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last purchase date"@en ;
    rdfs:comment "Date of the most recent purchase order issued to this vendor for this material. Used to track active vs dormant supply relationships."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_purchase_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Purchase Date" ;
    cmm:cimDatatype "Date" .
cmm:SupplyAgreement.lastPurchasePrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last purchase price"@en ;
    rdfs:comment "Actual unit price paid on the most recent purchase order for this vendor-material combination. Used for price variance analysis and trend tracking."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "last_purchase_price" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Purchase Price" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SupplyAgreement.lastUpdatedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated date"@en ;
    rdfs:comment "Timestamp of the most recent update to this supply agreement record. Tracks changes to pricing, terms, or ratings."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SupplyAgreement.leadTimeDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lead time days"@en ;
    rdfs:comment "Expected delivery lead time in calendar days from purchase order to goods receipt for this specific vendor-material combination. Varies by vendor capability and material complexity."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:int ;
    cmm:physicalColumn "lead_time_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lead Time Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:SupplyAgreement.maximumOrderQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum order quantity"@en ;
    rdfs:comment "Maximum quantity that can be ordered in a single purchase order from this vendor for this material, due to vendor capacity or logistics constraints. Expressed in materials base unit of measure."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_order_quantity" ;
    cmm:sqlDataType "DECIMAL(13,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Order Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:SupplyAgreement.minimumOrderQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum order quantity"@en ;
    rdfs:comment "Minimum quantity that must be ordered from this vendor for this material, expressed in the materials base unit of measure. Vendor-specific commercial term."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_order_quantity" ;
    cmm:sqlDataType "DECIMAL(13,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Order Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:SupplyAgreement.preferredVendorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preferred vendor flag"@en ;
    rdfs:comment "Indicates whether this vendor is the preferred source for this specific material based on price, quality, delivery performance, or strategic relationship. Used in automated sourcing decisions."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "preferred_vendor_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preferred Vendor Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SupplyAgreement.qualityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quality rating"@en ;
    rdfs:comment "Quality performance score for this specific vendor-material combination, based on defect rates, inspection results, and warranty claims. Scale 0-100. Tracked separately from overall vendor rating."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quality_rating" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quality Rating" ;
    cmm:cimDatatype "Decimal" .
cmm:SupplyAgreement.unitPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit price"@en ;
    rdfs:comment "Negotiated price per base unit of measure for this vendor-material combination. This price is specific to the vendor-material relationship and varies by vendor for the same material."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_price" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Price" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SupplyAgreement.vendorMaterialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor material number"@en ;
    rdfs:comment "The vendors own part number or catalog number for this material. Used for cross-referencing in purchase orders and vendor communications. Specific to each vendor-material pair."@en ;
    rdfs:domain cmm:SupplyAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_material_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Vendor Material Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .

cmm:ContractLineItem a owl:Class ;
    rdfs:label "Contract Line Item"@en ;
    rdfs:comment "This association product represents the contractual agreement between a specific material and a supplier contract. It captures the commercial terms, pricing, quantities, and delivery conditions that apply to the procurement of a specific material under a framework contract. Each record links one material to one supplier contract with attributes that exist only in the context of this specific material-contract relationship. Contract line items are referenced on purchase orders and used for price validation during invoice verification.. Existence Justification: In utility procurement operations, supplier contracts are framework agreements that cover multiple materials, and each material can be sourced from multiple suppliers under different contracts. Contract line items are actively managed operational entities that procurement teams create, update, and reference on purchase orders. Each line item captures material-specific commercial terms (price, quantities, lead times, delivery conditions) that exist only in the context of a specific material-contract pairing."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:supply , cmmsa:supply.procurement_operations ;
    cmm:physicalTable "utility_cmm_silver.supply.contract_line_item" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.supply.contract_line_item" ;
    owl:hasKey ( cmm:ContractLineItem.contractLineItemId ) .

cmm:ContractLineItem.contractLineItemId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract line item id"@en ;
    rdfs:comment "Unique identifier for this contract line item record. Primary key."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:long ;
    cmm:physicalColumn "contract_line_item_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contract Line Item ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContractLineItem.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to the material master record covered by this contract line item"@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contract Line Item - Material Master Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_contract_line_item_material_master_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpItemMaster" .
cmm:ContractLineItem.supplierContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "supplier contract"@en ;
    rdfs:comment "Foreign key linking to the supplier contract under which this material is procured"@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range cmm:SupplierContract ;
    cmm:physicalColumn "supplier_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contract Line Item - Supplier Contract Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_supply_contract_line_item_supplier_contract_id" ;
    cmm:cimAssociation "IdentifiedObject.Agreement" .
cmm:ContractLineItem.contractedQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted quantity"@en ;
    rdfs:comment "Total quantity of this material committed under this contract. For quantity contracts, this is the total quantity to be delivered over the contract term."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:ContractLineItem.contractedUnitPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted unit price"@en ;
    rdfs:comment "Negotiated price per unit of measure for this material under this contract. Used for purchase order price validation and invoice verification."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_unit_price" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Unit Price" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ContractLineItem.deliveryLeadTimeDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery lead time days"@en ;
    rdfs:comment "Expected number of calendar days from purchase order release to goods receipt for this material under this contract. May differ from the material master planned delivery time based on supplier-specific logistics."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:int ;
    cmm:physicalColumn "delivery_lead_time_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Lead Time Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:ContractLineItem.deliveryTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery terms"@en ;
    rdfs:comment "Specific delivery conditions and requirements for this material under this contract, including delivery location, packaging requirements, and delivery schedule constraints."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:string ;
    cmm:physicalColumn "delivery_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Terms" ;
    cmm:cimDatatype "String" .
cmm:ContractLineItem.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this contract line item expires and can no longer be used for procurement. May differ from the overall contract end date if materials are phased out or have different validity periods."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ContractLineItem.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this contract line item becomes effective and can be used for procurement. May differ from the overall contract start date if materials are phased in."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ContractLineItem.lineItemStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line item status"@en ;
    rdfs:comment "Current lifecycle state of this contract line item. ACTIVE items can be used for procurement, INACTIVE items are temporarily disabled, SUSPENDED items are on hold pending resolution, EXPIRED items have passed their end date, CANCELLED items have been terminated early."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:string ;
    cmm:physicalColumn "line_item_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Line Item Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:ContractLineItem.maximumOrderQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum order quantity"@en ;
    rdfs:comment "Maximum quantity that can be ordered per release or over the contract term for this material. Used to enforce contract quantity limits."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_order_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Order Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:ContractLineItem.minimumOrderQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum order quantity"@en ;
    rdfs:comment "Minimum quantity that must be ordered per release for this material under this contract. Enforces supplier minimum order requirements."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_order_quantity" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Order Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:ContractLineItem.priceEscalationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "price escalation percentage"@en ;
    rdfs:comment "Annual or periodic price increase percentage applied to this material under this contract. Used to calculate adjusted prices over the contract term based on escalation clauses."@en ;
    rdfs:domain cmm:ContractLineItem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "price_escalation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Price Escalation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .

cmm:ContractorCompany a owl:Class ;
    rdfs:label "Contractor Company"@en ;
    rdfs:comment "Master reference table for contractor_company. Referenced by contractor_company_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Organisation ;
    cmm:cimCloseMatch cim:Organisation ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:supply , cmmsa:supply.vendor_management ;
    cmm:physicalTable "utility_cmm_silver.supply.contractor_company" ;
