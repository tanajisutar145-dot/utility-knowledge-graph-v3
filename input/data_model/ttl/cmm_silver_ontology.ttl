cmm:TechnicalReview.ieee1547ComplianceVerified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee 1547 compliance verified"@en ;
    rdfs:comment "Indicates whether the proposed Distributed Energy Resource (DER) equipment and interconnection design comply with IEEE 1547 interconnection standards. True if compliance verified."@en ;
