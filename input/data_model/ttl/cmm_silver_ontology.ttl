    rdfs:comment "Boolean flag indicating whether the employee holds a leadership or supervisory role within the crew (e.g., crew lead, foreman). True if the employee is responsible for crew direction and safety oversight."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:boolean ;
