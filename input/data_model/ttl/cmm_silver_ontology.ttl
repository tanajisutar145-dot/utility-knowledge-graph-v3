cmm:FuelPriceAssumption.uraniumPricePerLbU3o8 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "uranium price per lb u3o8"@en ;
    rdfs:comment "Assumed price of uranium in US dollars per pound of U3O8. Used in nuclear generation cost modeling and fuel cycle economic analysis."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "uranium_price_per_lb_u3o8" ;
