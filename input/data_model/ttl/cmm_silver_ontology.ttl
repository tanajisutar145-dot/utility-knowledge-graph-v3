    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:string ;
    cmm:physicalColumn "body" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:MessageTemplate.channel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel"@en ;
    rdfs:comment "Medium through which the message is sent to customers."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:MessageTemplate.complianceRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance required"@en ;
    rdfs:comment "True if the template must meet specific regulatory disclosure requirements."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "compliance_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Boolean" .
cmm:MessageTemplate.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the template record was first created in the system."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
