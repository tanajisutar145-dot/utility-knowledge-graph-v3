    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Management Response" ;
    cmm:cimDatatype "String" .
cmm:Grievance.managementResponseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "management response date"@en ;
    rdfs:comment "Date management provided its written response to the grievance at the current step."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "management_response_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Management Response Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "User ID or system account that last modified this grievance record, for audit trail purposes."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:Grievance.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional notes, comments, or context regarding the grievance, its handling, or resolution."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Grievance Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:Grievance.precedentSettingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "precedent setting flag"@en ;
    rdfs:comment "Indicates whether this grievance or arbitration decision establishes a precedent for future CBA interpretation (True/False)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "precedent_setting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Precedent Setting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Grievance.remedyRequested a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remedy requested"@en ;
    rdfs:comment "Specific remedy or relief requested by the grievant or union (e.g., reinstatement, back pay, removal of discipline from record)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "remedy_requested" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remedy Requested" ;
    cmm:cimDatatype "String" .
cmm:Grievance.resolutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution date"@en ;
    rdfs:comment "Date the grievance was formally resolved, closed, or withdrawn."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "resolution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grievance Resolution Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.resolutionOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution outcome"@en ;
    rdfs:comment "Final resolution outcome of the grievance: granted (remedy provided), denied (grievance rejected), settled (mutual agreement), or withdrawn (grievant withdrew)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grievance Resolution Outcome" ;
    cmm:validValues "granted|denied|settled|withdrawn" ;
    cmm:cimDatatype "String" .
cmm:Grievance.settlementTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement terms"@en ;
    rdfs:comment "Detailed terms of the settlement agreement if the grievance was resolved through mutual agreement between the parties."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Terms" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:Grievance.step a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step"@en ;
    rdfs:comment "Current step in the multi-step grievance procedure as defined in the collective bargaining agreement (typically Step 1 through arbitration)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "step" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grievance Procedure Step" ;
    cmm:validValues "step_1|step_2|step_3|arbitration" ;
    cmm:cimDatatype "String" .
cmm:Grievance.step1HearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step 1 hearing date"@en ;
    rdfs:comment "Date of the Step 1 grievance hearing between the grievant, union representative, and first-level management."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "step_1_hearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step 1 Hearing Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.step2HearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step 2 hearing date"@en ;
    rdfs:comment "Date of the Step 2 grievance hearing with higher-level management if Step 1 did not resolve the grievance."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "step_2_hearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step 2 Hearing Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.step3HearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "step 3 hearing date"@en ;
    rdfs:comment "Date of the Step 3 grievance hearing with senior management or labor relations department if Step 2 did not resolve the grievance."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "step_3_hearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Step 3 Hearing Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.subject a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Primary subject matter category of the grievance for classification and trend analysis. Reference-value candidates: discipline|discharge|work_assignment|overtime|seniority|safety|wages|benefits|working_conditions|other."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "subject" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Grievance Subject Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.subject .
cmm:Grievance.timeLimitComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time limit compliance flag"@en ;
    rdfs:comment "Indicates whether the grievance was filed and processed within the time limits specified in the CBA (True/False). Non-compliance may render grievance invalid."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "time_limit_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Limit Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Grievance.unionLocal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union local"@en ;
    rdfs:comment "Union local chapter or bargaining unit that represents the grievant (e.g., IBEW Local 1245, UWUA Local 223)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_local" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Local" ;
    cmm:cimDatatype "String" .

cmm:JobRequisition a owl:Class ;
    rdfs:label "Job Requisition"@en ;
    rdfs:comment "Workforce hiring requisitions initiated by utility managers to fill open positions — covering both permanent hires and temporary/seasonal staffing needs. Captures requisition number, position, org unit, hiring manager, justification (backfill, new headcount, seasonal), required certifications, target hire date, approved headcount budget, recruitment status, and sourcing channel. Drives talent acquisition workflow and headcount tracking against authorized positions."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Request ;
    cmm:cimExtends cim:Request ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.job_requisition" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "SAP S/4HANA HCM Recruitment" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.job_requisition" ;
    owl:hasKey ( cmm:JobRequisition.jobRequisitionId ) .

cmm:JobRequisition.jobRequisitionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "job requisition id"@en ;
    rdfs:comment "Unique identifier for the job requisition record. Primary key for the job requisition entity."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:long ;
    cmm:physicalColumn "job_requisition_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Job Requisition Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:JobRequisition.jobOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "job org unit"@en ;
    rdfs:comment "Reference to the organizational unit (department, division, service center) where the position will be located. Links to organizational hierarchy for reporting and budget allocation."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "job_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Organizational Unit Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_job_requisition_job_org_unit_id" ;
    cmm:cimAssociation "Request.Organisation" .
cmm:JobRequisition.orgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "org unit"@en ;
    rdfs:comment "FK to workforce.org_unit.org_unit_id — Requisitions are raised within specific org units. This drives departmental hiring budget tracking and approval workflows."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_job_requisition_org_unit_id" ;
    cmm:cimAssociation "Request.Organisation" .
cmm:JobRequisition.primaryJobEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary job employee"@en ;
    rdfs:comment "Reference to the employee who initiated the requisition and will manage the new hire. Responsible for interview participation and final selection decision."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_job_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Hiring Manager Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_job_requisition_primary_job_employee_id" ;
    cmm:cimAssociation "Request.ErpPersonnel" .
cmm:JobRequisition.workforcePosition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "workforce position"@en ;
    rdfs:comment "FK to workforce.workforce_position.workforce_position_id — Job requisitions are opened to fill specific authorized positions. This link enables headcount tracking (authorized vs filled vs in-recruitment) and ensures requisitions align with approved position s"@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range cmm:WorkforcePosition ;
    cmm:physicalColumn "workforce_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_job_requisition_workforce_position_id" ;
    cmm:cimAssociation "Request.IdentifiedObject" .
cmm:JobRequisition.approvedHeadcountBudget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved headcount budget"@en ;
    rdfs:comment "Total annual budget allocated for this position including salary, benefits, and overhead. Used for financial planning and budget variance tracking."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_headcount_budget" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Headcount Budget" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:JobRequisition.backgroundCheckLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "background check level"@en ;
    rdfs:comment "Depth of pre-employment background screening required. NERC CIP PRA is most comprehensive, including criminal history, employment verification, and credit check for positions with CIP access."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "background_check_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Background Check Level" ;
    cmm:validValues "basic|standard|comprehensive|nerc_cip_pra" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.cdlClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cdl class"@en ;
    rdfs:comment "Required CDL class if CDL is mandatory. Class A for heavy combination vehicles, Class B for heavy straight vehicles, Class C for vehicles carrying hazardous materials or 16+ passengers."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "cdl_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Driver License (CDL) Class" ;
    cmm:validValues "A|B|C" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.cdlRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cdl required"@en ;
    rdfs:comment "Indicates whether a valid Commercial Driver License is required for the position. Common for field crew, meter reader, and equipment operator roles."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cdl_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commercial Driver License (CDL) Required" ;
    cmm:cimDatatype "Boolean" .
cmm:JobRequisition.costCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Financial cost center code to which the position salary and benefits will be charged. Used for budget tracking and labor cost allocation."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center" ;
    cmm:valuePattern "^[0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the requisition record was first created in the system. Used for audit trail and process analytics."@en ;
