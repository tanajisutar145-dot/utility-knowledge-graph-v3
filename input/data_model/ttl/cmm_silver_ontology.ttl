    cmm:businessTerm "Load Profile Type" ;
    cmm:validValues "flat|tou|cpp|rtp|critical_peak_rebate" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.lowIncomeAssistanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "low income assistance flag"@en ;
    rdfs:comment "Indicates whether the customer qualifies for and is enrolled in low income energy assistance programs such as LIHEAP or CARE."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "low_income_assistance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Low Income Assistance Program Flag" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.nemFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem flag"@en ;
    rdfs:comment "Indicates whether this service agreement participates in Net Energy Metering program for distributed generation customers with solar or other renewable energy systems."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.nemProgramType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem program type"@en ;
    rdfs:comment "Specific NEM program version and structure applicable to this agreement. Different versions have varying compensation rates and rules."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Type" ;
    cmm:validValues "nem_1_0|nem_2_0|nem_3_0|vnem|aggregated_nem" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.paperlessBillingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "paperless billing flag"@en ;
    rdfs:comment "Indicates whether the customer has opted for electronic invoice delivery instead of paper bills."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "paperless_billing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Paperless Billing Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.paymentArrangementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement flag"@en ;
    rdfs:comment "Indicates whether the customer has an active payment arrangement or installment plan for past due balances on this service agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "payment_arrangement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "Primary payment instrument the customer uses to pay invoices for this service agreement."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Default Payment Method" ;
    cmm:validValues "bank_draft|credit_card|check|cash|electronic_transfer|autopay" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.revenueClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revenue class"@en ;
    rdfs:comment "Revenue accounting classification for financial reporting and regulatory compliance. Determines how revenue is recognized and reported to FERC and state PUCs. Reference-value candidates: residential|small_commercial|large_commercial|industrial|agricultural|street_lighting|public_authority."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "revenue_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revenue Class" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.serviceVoltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage level"@en ;
    rdfs:comment "Voltage level at which electric service is delivered to the customer. Affects rate structure and delivery charges."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Level" ;
    cmm:validValues "secondary|primary|subtransmission|transmission" ;
    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.specialContractFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "special contract flag"@en ;
    rdfs:comment "Indicates whether this service agreement operates under a special negotiated contract with non-standard rates or terms, typically for large industrial customers."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "special_contract_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Special Contract Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.specialContractTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "special contract terms"@en ;
    rdfs:comment "Description of special contractual terms, pricing arrangements, or service level commitments that deviate from standard tariff schedules."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "special_contract_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Special Contract Terms" ;
