cmm:DerInstaller a owl:Class ;
    rdfs:label "Der Installer"@en ;
    rdfs:comment "Master record for a licensed DER installer or electrical contractor authorized to perform DER installations for interconnection applications submitted to the utility. Captures installer company name, license number, license type (C-10 electrical, C-46 solar, general contractor), license expiration date, NABCEP certification flag, insurance certificate status, bonding status, approved installer program enrollment (utility-specific), service territory coverage, and installer performance metrics (inspection pass rate, application completeness rate, average time-to-PTO). Enables the utility to pre-screen installer qualifications, track installer quality for streamlined review programs, and support regulatory reporting on installer compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:OrganisationRole ;
    cmm:cimCloseMatch cim:OrganisationRole ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.der_installer" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "DER Installer / Electrical Contractor Registry" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.der_installer" ;
    owl:hasKey ( cmm:DerInstaller.derInstallerId ) .

cmm:DerInstaller.derInstallerId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der installer id"@en ;
    rdfs:comment "Unique identifier for the DER installer or electrical contractor record. Primary key."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_installer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Installer ID" ;
    cmm:cimDatatype "Integer" .
cmm:DerInstaller.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Indicates whether the installer is currently active and eligible to submit interconnection applications. Inactive status may result from expired credentials, program suspension, or voluntary withdrawal."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Installer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInstaller.applicationCompletenessRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application completeness rate percent"@en ;
    rdfs:comment "Percentage of interconnection applications submitted by this installer that were complete and did not require resubmission due to missing or incorrect information. Measures installer quality and process adherence."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "application_completeness_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Completeness Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DerInstaller.approvedInstallerProgramFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved installer program flag"@en ;
    rdfs:comment "Indicates whether the installer is enrolled in the utilitys approved installer program, which may provide streamlined interconnection review and expedited processing."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approved_installer_program_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Installer Program Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInstaller.averageTimeToPtoDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average time to pto days"@en ;
    rdfs:comment "Average number of days from interconnection application submission to PTO issuance for installations completed by this installer. Lower values indicate higher installer efficiency and quality."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_time_to_pto_days" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Time to Permission to Operate (PTO) in Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:DerInstaller.backgroundCheckDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "background check date"@en ;
    rdfs:comment "Date the most recent background check was completed for the installer."@en ;
    rdfs:domain cmm:DerInstaller ; rdfs:range xsd:date ;
    cmm:physicalColumn "background_check_date" ;
