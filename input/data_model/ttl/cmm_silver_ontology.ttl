    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Feeder.status .
cmm:Feeder.originatesFromSubstation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "originates from substation"@en ;
    rdfs:comment "FK to distribution.substation.substation_id — Every distribution feeder emanates from a substation bus. This is the foundational topological relationship — load flow analysis, fault isolation, and FLISR all require knowing which substation source"@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:long ;
    cmm:physicalColumn "originates_from_substation" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:Feeder.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Ownership classification indicating whether the feeder is wholly utility-owned, jointly owned with another entity, or owned by a third party."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|joint_owned|third_party" ;
    cmm:cimDatatype "String" .
cmm:Feeder.peakLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak load mw"@en ;
    rdfs:comment "Historical peak load demand observed on the feeder expressed in megawatts, used for capacity planning and load management."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:Feeder.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration of the feeder indicating whether it operates as a three-phase, single-phase, or two-phase circuit."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "three_phase|single_phase|two_phase" ;
    cmm:cimDatatype "String" .
cmm:Feeder.protectionScheme a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection scheme"@en ;
    rdfs:comment "Description of the protective relay and circuit breaker coordination scheme applied to the feeder for fault detection, isolation, and system protection."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "protection_scheme" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Scheme" ;
    cmm:cimDatatype "String" .
cmm:Feeder.ratedCapacityMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated capacity mva"@en ;
    rdfs:comment "Maximum rated capacity of the feeder expressed in megavolt-amperes, representing the thermal and electrical limits of the circuit under normal operating conditions."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_capacity_mva" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Capacity (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:Feeder.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "Public Utility Commission or regulatory body with jurisdiction over this feeder for rate-making and service quality standards."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:Feeder.saidiYtdMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi ytd minutes"@en ;
    rdfs:comment "Year-to-date SAIDI reliability metric for this feeder, representing the average outage duration per customer served, expressed in minutes."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_ytd_minutes" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Year-to-Date (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:Feeder.saifiYtdCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi ytd count"@en ;
    rdfs:comment "Year-to-date SAIFI reliability metric for this feeder, representing the average number of interruptions per customer served."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_ytd_count" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Year-to-Date (Count)" ;
    cmm:cimDatatype "Decimal" .
cmm:Feeder.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Geographic service area or territory designation served by this feeder, used for operational planning and regulatory reporting."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:Feeder.substationBusCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation bus code"@en ;
    rdfs:comment "Identifier of the specific bus or breaker position within the substation from which the feeder originates."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_bus_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substation Bus Identifier" ;
    cmm:cimDatatype "String" .
cmm:Feeder.voltVarOptimizationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var optimization enabled"@en ;
    rdfs:comment "Indicates whether the feeder participates in automated volt-VAR optimization for voltage regulation and reactive power management."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "volt_var_optimization_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization (VVO) Enabled" ;
    cmm:cimDatatype "Boolean" .

cmm:DistributionSubstation a owl:Class ;
    rdfs:label "Distribution Substation"@en ;
    rdfs:comment "Master record for distribution substations (typically 33kV/11kV or 11kV/LV) that step down transmission voltage for last-mile delivery. Captures substation name, location (GIS coordinates), voltage levels, transformer bank configuration, bus arrangement, SCADA RTU identifiers, ADMS node reference, rated capacity (MVA), commissioning date, ownership type, and operational status. Distinct from transmission substations owned by the transmission domain. SSOT for distribution substation identity and electrical configuration in the distribution network topology."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Substation ;
    cmm:cimExactMatch cim:Substation ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.distribution_substation" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13 CDPSM; IEC CIM Substation / GE PowerOn ADMS Node" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.distribution_substation" ;
    owl:hasKey ( cmm:DistributionSubstation.distributionSubstationId ) .

cmm:DistributionSubstation.distributionSubstationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation id"@en ;
    rdfs:comment "Unique identifier for the distribution substation. Primary key. MASTER_RESOURCE role entity."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:long ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distribution Substation ID" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSubstation.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Substations operate within balancing authority control areas for ACE calculation, interchange scheduling, and frequency regulation. Required for NERC CPS1/CPS2 compliance reporting and real-time balan"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_control_area_id" ;
    cmm:cimAssociation "Substation.ControlArea" .
cmm:DistributionSubstation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Substations are major capital facilities with dedicated cost centers for maintenance, operations, and regulatory cost tracking. Required for annual budget planning, FERC Form 1 functional cost allocat"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_cost_center_id" ;
    cmm:cimAssociation "Substation.Organisation" .
cmm:DistributionSubstation.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Substations are major load aggregation points and primary geographic units for load forecasting. Substation capacity planning and transformer sizing depend on load forecasts prepared at the substation"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_forecast_zone_id" ;
    cmm:cimAssociation "Substation.LoadArea" .
cmm:DistributionSubstation.managerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Substations require designated managers for operational accountability, safety compliance, maintenance coordination, and regulatory reporting. Standard utility practice assigns a responsible engineer/"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_manager_employee_id" ;
    cmm:cimAssociation "Substation.ErpPersonnel" .
cmm:DistributionSubstation.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: Substations are BES facilities requiring NERC CIP-002 through CIP-014 compliance tracking. CIP impact ratings, security perimeters, and cyber asset inventories are mandatory for substations meeting BE"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_nerc_cip_asset_id" ;
    cmm:cimAssociation "Substation.Asset" .
cmm:DistributionSubstation.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Distribution substations receive power from transmission substations via step-down transformers. This is the fundamental grid topology relationship required for outage coordination, voltage management"@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_substation_transmission_substation_id" ;
    cmm:cimAssociation "Substation.Substation" .
cmm:DistributionSubstation.addressLine1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line1"@en ;
    rdfs:comment "Primary street address of the substation facility (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Address Line 1" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:DistributionSubstation.addressLine2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line2"@en ;
    rdfs:comment "Secondary address information such as building number, suite, or unit (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Address Line 2" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:DistributionSubstation.admsNodeReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adms node reference"@en ;
    rdfs:comment "Node identifier in the ADMS (GE PowerOn ADMS) representing this substation in the distribution network model for outage management and FLISR automation."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "adms_node_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ADMS (Advanced Distribution Management System) Node Reference" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.assetCriticalityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset criticality score"@en ;
    rdfs:comment "Numerical score (1-100) representing the criticality of this substation to grid reliability and customer service, used for risk-based asset management."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:int ;
    cmm:physicalColumn "asset_criticality_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Criticality Score" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSubstation.averageLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average load mw"@en ;
    rdfs:comment "Average demand load in megawatts (MW) served by this substation over a defined period (typically annual), used for utilization analysis."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Load (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DistributionSubstation.busArrangement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bus arrangement"@en ;
    rdfs:comment "Electrical bus topology: single-bus, double-bus, ring-bus, breaker-and-half, or main-and-transfer. Impacts reliability and switching flexibility."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "bus_arrangement" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bus Arrangement" ;
    cmm:validValues "single_bus|double_bus|ring_bus|breaker_and_half|main_and_transfer" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.city a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "city"@en ;
    rdfs:comment "City or municipality where the substation is located (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "City" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.name .
cmm:DistributionSubstation.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the substation was first placed into commercial operation and energized for customer service."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:DistributionSubstation.countryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "country code"@en ;
    rdfs:comment "Three-letter ISO 3166-1 alpha-3 country code where the substation is located (e.g., USA, CAN, MEX)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "country_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Country Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.country .
cmm:DistributionSubstation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this substation record was first created in the system (audit trail)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Substation.createdDateTime .
cmm:DistributionSubstation.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the operational system of record that is the authoritative source for this substation data (e.g., GE PowerOn ADMS, Esri ArcGIS, Ventyx Asset Suite)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.decommissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decommissioning date"@en ;
    rdfs:comment "Date when the substation was permanently retired from service and de-energized. Null if still in service."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:date ;
    cmm:physicalColumn "decommissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Decommissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:DistributionSubstation.derInterconnectionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection flag"@en ;
    rdfs:comment "Indicates whether this substation has interconnected DER (solar, wind, battery storage) on its feeders requiring DERMS coordination."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_interconnection_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER (Distributed Energy Resource) Interconnection Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionSubstation.emergencyContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency contact phone"@en ;
    rdfs:comment "Primary emergency contact phone number for this substation facility (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "emergency_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emergency Contact Phone" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:DistributionSubstation.flisrEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr enabled flag"@en ;
    rdfs:comment "Indicates whether this substation is equipped with automated FLISR capability for self-healing grid operations via ADMS."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR (Fault Location Isolation and Service Restoration) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionSubstation.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique feature identifier in the Esri ArcGIS Utility Network for geospatial asset location and network topology modeling."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "GIS (Geographic Information System) Feature ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:DistributionSubstation.lastMajorUpgradeDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last major upgrade date"@en ;
    rdfs:comment "Date of the most recent major capital upgrade or refurbishment (transformer replacement, bus reconfiguration, SCADA modernization)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_major_upgrade_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Major Upgrade Date" ;
    cmm:cimDatatype "Date" .
cmm:DistributionSubstation.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this substation record was last modified in the system (audit trail)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DistributionSubstation.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate (WGS84 decimal degrees) of the substation location for GIS mapping and outage analysis."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DistributionSubstation.loadFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load factor percent"@en ;
    rdfs:comment "Ratio of average load to peak load expressed as a percentage, indicating how efficiently the substation capacity is utilized."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Factor Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DistributionSubstation.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate (WGS84 decimal degrees) of the substation location for GIS mapping and outage analysis."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DistributionSubstation.maintenanceZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance zone"@en ;
    rdfs:comment "Maintenance planning zone or district responsible for O&M (Operations and Maintenance) activities at this substation."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Zone" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.numberOfFeeders a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of feeders"@en ;
    rdfs:comment "Count of distribution feeders originating from this substation serving downstream customers and load zones."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_feeders" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Feeders" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionSubstation.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current lifecycle state of the substation: in-service (active), out-of-service (offline), under-construction (not yet commissioned), decommissioned (retired), standby (backup), or maintenance (temporary outage)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|under_construction|decommissioned|standby|maintenance" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Substation.status .
cmm:DistributionSubstation.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Legal ownership classification: utility-owned (owned by the distribution utility), third-party-owned (IPP or DER owner), joint-venture, leased, or municipal (public entity)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|third_party_owned|joint_venture|leased|municipal" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.peakLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak load mw"@en ;
    rdfs:comment "Historical peak demand load in megawatts (MW) recorded at this substation, used for capacity planning and load forecasting."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Load (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DistributionSubstation.postalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "postal code"@en ;
    rdfs:comment "Postal or ZIP code of the substation location (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "postal_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Postal Code" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:StreetAddress.postalCode .
cmm:DistributionSubstation.primaryVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary voltage kv"@en ;
    rdfs:comment "Incoming high-side voltage level in kilovolts (e.g., 33kV, 11kV) from the transmission or sub-transmission network."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "primary_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Voltage (kV - Kilovolt)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DistributionSubstation.ratedCapacityMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated capacity mva"@en ;
    rdfs:comment "Total nameplate capacity of the substation transformer bank in megavolt-amperes (MVA). Principal quantitative fact for capacity planning and load balancing."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_capacity_mva" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Capacity (MVA - Megavolt-Ampere)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:DistributionSubstation.reliabilityIndexCaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index caidi minutes"@en ;
    rdfs:comment "Customer Average Interruption Duration Index in minutes for this substation service area, reported to PUC for reliability compliance."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_index_caidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CAIDI (Customer Average Interruption Duration Index) Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DistributionSubstation.reliabilityIndexSaidiMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index saidi minutes"@en ;
    rdfs:comment "System Average Interruption Duration Index in minutes for this substation service area, reported to PUC for reliability compliance."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_index_saidi_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SAIDI (System Average Interruption Duration Index) Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DistributionSubstation.reliabilityIndexSaifiCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reliability index saifi count"@en ;
    rdfs:comment "System Average Interruption Frequency Index (number of interruptions per customer) for this substation service area, reported to PUC for reliability compliance."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reliability_index_saifi_count" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SAIFI (System Average Interruption Frequency Index) Count" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionSubstation.scadaRtuCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada rtu code"@en ;
    rdfs:comment "Identifier of the SCADA Remote Terminal Unit installed at this substation for real-time monitoring and control via OSIsoft PI or equivalent."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_rtu_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) RTU (Remote Terminal Unit) ID" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.secondaryVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "secondary voltage kv"@en ;
    rdfs:comment "Outgoing low-side voltage level in kilovolts (e.g., 11kV, 0.4kV) for distribution feeders and customer service."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "secondary_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Secondary Voltage (kV - Kilovolt)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DistributionSubstation.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Name or code of the service territory or franchise area served by this substation, as defined by PUC (Public Utility Commission) boundaries."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.stateProvince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state province"@en ;
    rdfs:comment "State, province, or region where the substation is located (organizational contact data, business-confidential)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "state_province" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "State or Province" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:DistributionSubstation.substationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation code"@en ;
    rdfs:comment "Externally-known unique business identifier or asset tag for the substation used in operational systems (SCADA, ADMS, GIS)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Substation Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DistributionSubstation.substationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation name"@en ;
    rdfs:comment "Human-readable name or designation of the distribution substation (e.g., 'Main Street Substation', 'Industrial Park Sub')."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Substation Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DistributionSubstation.substationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation type"@en ;
    rdfs:comment "Classification of the substation by its primary function: step-down (voltage transformation), switching (circuit reconfiguration), distribution (last-mile delivery hub), or collector (renewable energy aggregation)."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Substation Type" ;
    cmm:validValues "step_down|switching|distribution|collector" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Substation.kind .
cmm:DistributionSubstation.transformerConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transformer configuration"@en ;
    rdfs:comment "Winding configuration of the transformer bank: delta-wye, wye-wye, delta-delta, wye-delta, open-delta, or scott-t. Determines phase shift and grounding."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:string ;
    cmm:physicalColumn "transformer_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transformer Configuration" ;
    cmm:validValues "delta_wye|wye_wye|delta_delta|wye_delta|open_delta|scott_t" ;
    cmm:cimDatatype "String" .
cmm:DistributionSubstation.voltVarOptimizationEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var optimization enabled flag"@en ;
    rdfs:comment "Indicates whether this substation participates in volt-VAR optimization (VVO) for voltage regulation and reactive power management."@en ;
    rdfs:domain cmm:DistributionSubstation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "volt_var_optimization_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization Enabled Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:DistributionTransformer a owl:Class ;
    rdfs:label "Distribution Transformer"@en ;
    rdfs:comment "Master record for pole-mounted and pad-mounted distribution transformers that step down medium voltage to low voltage for customer service. Captures transformer serial number, kVA rating, primary/secondary voltage, phase configuration (single/three-phase), installation type (overhead/padmount/vault), GIS location, feeder assignment, service territory, manufacturer, installation date, condition rating, and ADMS asset reference. SSOT for distribution transformer identity, electrical ratings, and network placement. Supports load analysis, transformer loading studies, and voltage complaint investigation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PowerTransformer ;
    cmm:cimExactMatch cim:PowerTransformer ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.transformer" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13 CDPSM (TransformerTank); IEC CIM PowerTransformer / Ventyx Asset Suite" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.transformer" ;
    owl:hasKey ( cmm:DistributionTransformer.transformerId ) .

cmm:DistributionTransformer.transformerId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transformer id"@en ;
    rdfs:comment "Primary key for transformer"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:long ;
    cmm:physicalColumn "transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Transformer Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionTransformer.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation that serves the feeder supplying this transformer. Used for network topology analysis and outage root cause investigation."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_distribution_substation_id" ;
    cmm:cimAssociation "PowerTransformer.Substation" .
cmm:DistributionTransformer.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: Distribution transformers containing PCB-contaminated oil require EPA TSCA permits and tracking. The pcb_contaminated_flag attribute signals regulatory applicability; linking to environmental_permit e"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Environmental Permit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_environmental_permit_id" ;
    cmm:cimAssociation "PowerTransformer.Document" .
cmm:DistributionTransformer.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Distribution transformers are installed on feeders. This relationship is essential for load analysis (aggregating transformer loads to feeder level), outage impact assessment, and capacity planning."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_feeder_id" ;
    cmm:cimAssociation "PowerTransformer.Feeder" .
cmm:DistributionTransformer.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Distribution transformers are capitalized assets requiring fixed asset registry tracking for depreciation, FERC account classification, RAB inclusion, and rate base valuation. Core to utility asset ac"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_fixed_asset_id" ;
    cmm:cimAssociation "PowerTransformer.FinancialInfo" .
cmm:DistributionTransformer.inspectorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inspector employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Distribution transformers require periodic inspection by qualified field personnel per OSHA and utility safety standards. Tracking the inspector enables quality assurance, certification verification,"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "inspector_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Inspector Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_inspector_employee_id" ;
    cmm:cimAssociation "PowerTransformer.ErpPersonnel" .
cmm:DistributionTransformer.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Transformers are procured physical assets requiring material master linkage for lifecycle cost tracking, warranty management, spare parts planning, and standardization programs. Essential for asset ma"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_material_master_id" ;
    cmm:cimAssociation "PowerTransformer.ErpItemMaster" .
cmm:DistributionTransformer.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "FK to distribution.service_territory"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_service_territory_id" ;
    cmm:cimAssociation "PowerTransformer.SubGeographicalRegion" .
cmm:DistributionTransformer.transformerFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transformer feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit that supplies power to this transformer. Used for load analysis, outage impact assessment, and SAIDI/SAIFI/CAIDI reliability index calculations."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "transformer_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_transformer_feeder_id" ;
    cmm:cimAssociation "PowerTransformer.Feeder" .
cmm:DistributionTransformer.transformerOnFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transformer_on_feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Distribution transformers are assigned to feeders. This FK supports transformer loading studies, voltage complaint investigation, and outage impact assessment (how many transformers/customers affected"@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "transformer_on_feeder" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_transformer_transformer_on_feeder" ;
    cmm:cimAssociation "PowerTransformer.Feeder" .
cmm:DistributionTransformer.admsDeviceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adms device code"@en ;
    rdfs:comment "Unique device identifier in the GE PowerOn ADMS for real-time monitoring, FLISR automation, and volt-VAR optimization. Links transformer to SCADA telemetry and control functions."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "adms_device_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Distribution Management System (ADMS) Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.assetTag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset tag"@en ;
    rdfs:comment "Utility-assigned asset identification tag for internal tracking and field identification. Used by field crews and asset management systems."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_tag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Tag Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DistributionTransformer.conditionRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition rating"@en ;
    rdfs:comment "Overall physical and operational condition assessment based on inspection findings, test results, and maintenance history. Used for capital planning and replacement prioritization."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "condition_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Rating" ;
    cmm:validValues "excellent|good|fair|poor|critical" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.coolingClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cooling class"@en ;
    rdfs:comment "Cooling method classification per IEEE standards. ONAN = Oil Natural Air Natural (self-cooled), ONAF = Oil Natural Air Forced (fan-cooled), dry types use air cooling. Affects loading capability and maintenance requirements."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "cooling_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cooling Class" ;
    cmm:validValues "ONAN|ONAF|OFAF|OFWF|dry_type_AA|dry_type_FA" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this transformer record was first created in the system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PowerTransformer.createdDateTime .
cmm:DistributionTransformer.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
    rdfs:comment "Business criticality classification based on number of customers served, load importance, and redundancy availability. Critical assets receive priority for maintenance and replacement."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Rating" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.customersServedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers served count"@en ;
    rdfs:comment "Number of customer accounts receiving service from this transformer. Used for outage impact assessment and SAIDI/SAIFI/CAIDI reliability index calculations for PUC reporting."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_served_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Served Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionTransformer.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique identifier linking this transformer to its corresponding feature in the Esri ArcGIS Utility Network. Enables spatial analysis, network tracing, and integration with ADMS."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Feature ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:DistributionTransformer.healthIndexScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "health index score"@en ;
    rdfs:comment "Calculated asset health score (0-100) based on age, condition, loading, maintenance history, and failure risk factors. Higher scores indicate better health. Used for investment prioritization and risk management."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "health_index_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Health Index Score" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.impedancePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impedance percent"@en ;
    rdfs:comment "Transformer impedance expressed as a percentage of rated voltage. Used for short-circuit calculations, protective device coordination, and fault current analysis."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "impedance_percent" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impedance Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DistributionTransformer.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date the transformer was installed and placed into service at its current location. Used for warranty tracking, maintenance scheduling, and asset lifecycle management."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:DistributionTransformer.installationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation type"@en ;
    rdfs:comment "Physical installation configuration of the transformer indicating mounting method and accessibility. Overhead units are pole-mounted, padmount units are ground-level enclosures, vault units are below-grade in concrete vaults."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Type" ;
    cmm:validValues "overhead|padmount|vault|subsurface|platform" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.insulationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insulation type"@en ;
    rdfs:comment "Dielectric insulation medium used in the transformer. Mineral oil is traditional, ester fluids are environmentally friendly, dry types use air or resin insulation. Impacts fire safety and environmental compliance."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "insulation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Insulation Type" ;
    cmm:validValues "mineral_oil|silicone_oil|ester_fluid|dry_type|gas_insulated" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.kvaRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "kva rating"@en ;
    rdfs:comment "Nameplate power capacity rating of the transformer in kilovolt-amperes. Represents the maximum continuous load the transformer can serve under standard operating conditions. Critical for load analysis and transformer loading studies."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "kva_rating" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Kilovolt-Ampere (kVA) Rating" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent field inspection or condition assessment. Used to track inspection compliance and schedule next inspection per maintenance program."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:DistributionTransformer.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the transformer location in decimal degrees. Used for GIS mapping, outage analysis, and field crew dispatch via Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DistributionTransformer.loadLossWatts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load loss watts"@en ;
    rdfs:comment "Winding resistance loss in watts at rated load. Used for energy efficiency analysis, loss accounting, and total cost of ownership calculations."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_loss_watts" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Loss (Watts)" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.loadTapChangerEquipped a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load tap changer equipped"@en ;
    rdfs:comment "Indicates whether the transformer is equipped with a load tap changer for automatic voltage regulation under load. True for LTC-equipped units, false for fixed-tap units."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "load_tap_changer_equipped" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Tap Changer (LTC) Equipped" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionTransformer.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the transformer location in decimal degrees. Used for GIS mapping, outage analysis, and field crew dispatch via Esri ArcGIS Utility Network."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DistributionTransformer.manufactureYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacture year"@en ;
    rdfs:comment "Year the transformer was manufactured. Used for age-based asset management, depreciation calculations, and end-of-life planning."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:int ;
    cmm:physicalColumn "manufacture_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manufacture Year" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionTransformer.nextInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection date"@en ;
    rdfs:comment "Scheduled date for the next routine inspection or condition assessment. Driven by maintenance program intervals and regulatory requirements."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:DistributionTransformer.noLoadLossWatts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "no load loss watts"@en ;
    rdfs:comment "Core loss or excitation loss in watts when the transformer is energized but not loaded. Used for energy efficiency analysis and loss accounting."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "no_load_loss_watts" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "No-Load Loss (Watts)" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.oilVolumeGallons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oil volume gallons"@en ;
    rdfs:comment "Total volume of insulating oil in gallons for liquid-filled transformers. Used for oil sampling scheduling, spill containment planning, and environmental compliance."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "oil_volume_gallons" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Oil Volume (Gallons)" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the transformer in the distribution network. In-service units are actively serving load, standby units are energized but not loaded, retired units are permanently removed from service."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|standby|retired|under_test|failed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PowerTransformer.status .
cmm:DistributionTransformer.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Legal ownership classification of the transformer asset. Utility-owned assets are maintained by the utility, customer-owned assets are maintained by the customer but may be utility-monitored."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|third_party|joint_ownership" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.pcbContaminatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pcb contaminated flag"@en ;
    rdfs:comment "Indicates whether the transformer contains or is contaminated with PCBs above regulatory thresholds. True for PCB-contaminated units requiring special handling per EPA regulations."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pcb_contaminated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Polychlorinated Biphenyl (PCB) Contaminated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionTransformer.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Number of electrical phases the transformer is designed to handle. Single-phase units serve residential and small commercial loads, three-phase units serve larger commercial and industrial customers."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase" ;
    cmm:cimDatatype "String" .
cmm:DistributionTransformer.primaryVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary voltage kv"@en ;
    rdfs:comment "Rated primary winding voltage in kilovolts. Typically medium voltage (4.16 kV, 12.47 kV, 13.2 kV, 13.8 kV, 23 kV, 34.5 kV) from the distribution feeder."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "primary_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DistributionTransformer.replacementCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replacement cost usd"@en ;
    rdfs:comment "Estimated current replacement cost in US dollars including equipment, installation, and removal. Used for capital planning, insurance valuation, and asset valuation."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "replacement_cost_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Replacement Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DistributionTransformer.scadaMonitoredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada monitored flag"@en ;
    rdfs:comment "Indicates whether the transformer is equipped with SCADA telemetry for real-time monitoring of load, voltage, and status. True for monitored assets, false for non-monitored."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_monitored_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Monitored Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionTransformer.secondaryVoltageV a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "secondary voltage v"@en ;
    rdfs:comment "Rated secondary winding voltage in volts. Typically low voltage for customer service (120V, 240V, 208V, 480V). Used for voltage complaint investigation and service quality analysis."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "secondary_voltage_v" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Secondary Voltage (V)" ;
    cmm:unitSymbol "V" ;
    cmm:cimDatatype "Voltage" .
cmm:DistributionTransformer.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Manufacturer-assigned serial number uniquely identifying the physical transformer unit. Used for warranty tracking, maintenance history, and asset verification."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transformer Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:DistributionTransformer.tapPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tap position"@en ;
    rdfs:comment "Current tap position setting for voltage adjustment. Positive values indicate voltage boost, negative values indicate voltage buck. Used for voltage regulation analysis."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:int ;
    cmm:physicalColumn "tap_position" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tap Position" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionTransformer.transformerType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transformer type"@en ;
    rdfs:comment "Functional classification of the transformer based on its electrical purpose and configuration within the distribution network."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "transformer_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transformer Type" ;
    cmm:validValues "distribution|network|step_down|step_up|autotransformer|regulator" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PowerTransformer.kind .
cmm:DistributionTransformer.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this transformer record was last modified. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DistributionTransformer.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer warranty coverage expires. Used for warranty claim eligibility and maintenance cost planning."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:DistributionTransformer.weightPounds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weight pounds"@en ;
    rdfs:comment "Total weight of the transformer in pounds. Used for transportation planning, pole loading calculations, and installation equipment sizing."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "weight_pounds" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weight (Pounds)" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionTransformer.windingConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "winding configuration"@en ;
    rdfs:comment "Electrical connection arrangement of primary and secondary windings. Determines voltage transformation characteristics, grounding requirements, and harmonic performance."@en ;
    rdfs:domain cmm:DistributionTransformer ; rdfs:range xsd:string ;
    cmm:physicalColumn "winding_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Winding Configuration" ;
    cmm:validValues "delta_delta|delta_wye|wye_delta|wye_wye|open_delta|open_wye" ;
    cmm:cimDatatype "String" .

cmm:SectionalizingDevice a owl:Class ;
    rdfs:label "Sectionalizing Device"@en ;
    rdfs:comment "Master record for distribution network sectionalizing and protection devices including reclosers, sectionalizers, fuses, load break switches, and automated switches. Captures device type, manufacturer, model, rated voltage and current, interrupting capacity, automation capability (manual/automated/FLISR-enabled), GIS location, feeder segment assignment, SCADA point reference, communication protocol, and operational status. SSOT for all switchable and protective devices on the distribution network. Critical for FLISR automation, fault isolation, and protection coordination in GE PowerOn ADMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ProtectedSwitch ;
    cmm:cimCloseMatch cim:ProtectedSwitch ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.sectionalizing_device" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13 (Recloser/Sectionaliser/Fuse); IEC CIM ProtectedSwitch / GE PowerOn ADMS FLISR Device" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.sectionalizing_device" ;
    owl:hasKey ( cmm:SectionalizingDevice.sectionalizingDeviceId ) .

cmm:SectionalizingDevice.sectionalizingDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device id"@en ;
    rdfs:comment "Unique identifier for the sectionalizing device. Primary key for the sectionalizing device master record."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:long ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Sectionalizing Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:SectionalizingDevice.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation that serves the feeder where this device is installed. Used for hierarchical network topology and outage impact analysis."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_distribution_substation_id" ;
    cmm:cimAssociation "ProtectedSwitch.Substation" .
cmm:SectionalizingDevice.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Sectionalizing devices are installed on specific feeders. This FK is required for FLISR automation, protection coordination, and switching order generation."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_feeder_id" ;
    cmm:cimAssociation "ProtectedSwitch.Feeder" .
cmm:SectionalizingDevice.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Reclosers, switches, and circuit breakers are capitalized distribution assets tracked in fixed asset registry for depreciation, FERC reporting, and regulatory asset base valuation. Essential for rate"@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_fixed_asset_id" ;
    cmm:cimAssociation "ProtectedSwitch.FinancialInfo" .
cmm:SectionalizingDevice.flisrZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "flisr zone"@en ;
    rdfs:comment "Identifier of the FLISR automation zone where this device participates. Used by ADMS to execute automated fault isolation and service restoration sequences."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "flisr_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "FLISR (Fault Location Isolation and Service Restoration) Zone ID" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_flisr_zone_id" ;
    cmm:cimAssociation "ProtectedSwitch.LoadArea" .
cmm:SectionalizingDevice.maintainerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "maintainer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Sectionalizing devices (reclosers, switches, breakers) require assigned maintenance personnel for testing, operation verification, and reliability assurance. Critical for FLISR performance, protection"@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "maintainer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Maintainer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_maintainer_employee_id" ;
    cmm:cimAssociation "ProtectedSwitch.ErpPersonnel" .
cmm:SectionalizingDevice.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Switches, reclosers, and circuit breakers are procured equipment requiring material master linkage for spare parts inventory planning, equipment standardization, replacement cost estimation, and emerg"@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_material_master_id" ;
    cmm:cimAssociation "ProtectedSwitch.ErpItemMaster" .
cmm:SectionalizingDevice.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: Automated sectionalizing devices with SCADA control in substations are BES Cyber Assets under NERC CIP-005 and CIP-007. Tracking CIP applicability, security controls, and patch management for these de"@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_nerc_cip_asset_id" ;
    cmm:cimAssociation "ProtectedSwitch.Asset" .
cmm:SectionalizingDevice.sectionalizingFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit where this device is installed. Links device to circuit topology for load flow and reliability analysis."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "sectionalizing_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_sectionalizing_device_sectionalizing_feeder_id" ;
    cmm:cimAssociation "ProtectedSwitch.Feeder" .
cmm:SectionalizingDevice.assetConditionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset condition score"@en ;
    rdfs:comment "Quantitative assessment of device condition based on inspections, testing, and operational history. Scale typically 0-100 with higher scores indicating better condition."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_condition_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Score" ;
    cmm:cimDatatype "Decimal" .
cmm:SectionalizingDevice.automationCapability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "automation capability"@en ;
    rdfs:comment "Level of automation and remote control capability. FLISR-enabled devices support Fault Location Isolation and Service Restoration automation schemes in ADMS."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "automation_capability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automation Capability" ;
    cmm:validValues "manual|automated|flisr_enabled|scada_controlled|remote_controlled" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.capitalCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital cost usd"@en ;
    rdfs:comment "Original capital cost of the device in US dollars. Used for asset valuation, depreciation, and rate base calculations."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capital_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SectionalizingDevice.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the device was commissioned and placed into active service. May differ from installation date due to testing and acceptance procedures."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:SectionalizingDevice.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "Communication protocol used for remote monitoring and control. Examples: DNP3, IEC 61850, Modbus, proprietary protocols."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.controlMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Current control mode setting for automated devices. Determines whether device responds to remote commands or operates autonomously."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Mode" ;
    cmm:validValues "local|remote|automatic|disabled" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this device record was first created in the system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ProtectedSwitch.createdDateTime .
cmm:SectionalizingDevice.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
    rdfs:comment "Business criticality classification based on number of customers served, load importance, and redundancy. Used for prioritizing maintenance and replacement investments."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Rating" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.currentPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current position"@en ;
    rdfs:comment "Real-time or last-known position of the switching device. Updated by SCADA telemetry or field crew reports."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "current_position" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Position" ;
    cmm:validValues "open|closed|unknown" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.deviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device name"@en ;
    rdfs:comment "Human-readable name or label for the sectionalizing device. Often includes location reference or circuit designation for field identification."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Device Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:SectionalizingDevice.deviceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device number"@en ;
    rdfs:comment "Externally-known unique identifier or asset tag for the sectionalizing device. Used for field operations, work orders, and asset tracking. Typically assigned by utility asset management system."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Device Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SectionalizingDevice.deviceSubtype a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device subtype"@en ;
    rdfs:comment "Detailed subclassification of the device type. Examples: hydraulic recloser, electronic recloser, expulsion fuse, current-limiting fuse, gang-operated switch."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_subtype" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Subtype" ;
    cmm:cimDatatype "String" .
cmm:SectionalizingDevice.deviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:comment "Classification of the sectionalizing device by functional type. Determines protection coordination strategy and operational characteristics. Reference-value candidates: recloser|sectionalizer|fuse|load_break_switch|automated_switch|circuit_breaker|disconnect_switch."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Device Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ProtectedSwitch.kind .
cmm:SectionalizingDevice.expectedServiceLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expected service life years"@en ;
    rdfs:comment "Expected useful service life of the device in years. Used for asset replacement planning and depreciation calculations."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "expected_service_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expected Service Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:SectionalizingDevice.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique identifier linking this device to its corresponding feature in the GIS utility network model. Enables spatial analysis and network tracing in Esri ArcGIS."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "GIS (Geographic Information System) Feature ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:SectionalizingDevice.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the device was installed in the distribution network. Used for asset age calculation and depreciation."@en ;
    rdfs:domain cmm:SectionalizingDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
