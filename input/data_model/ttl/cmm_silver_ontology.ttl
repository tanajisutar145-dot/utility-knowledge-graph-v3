cmm:TopologySnapshot.topologyChangeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology change flag"@en ;
    rdfs:comment "Boolean indicator showing whether the network topology changed compared to the previous snapshot. True indicates a switching operation or connectivity change occurred."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "topology_change_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
