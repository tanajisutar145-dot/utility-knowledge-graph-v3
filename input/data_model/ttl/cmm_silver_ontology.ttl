    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmissionsReport.measuredEmissionQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measured emission quantity"@en ;
    rdfs:comment "The measured quantity of emissions for the specified pollutant during the reporting period, expressed in tons."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "measured_emission_quantity" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measured Emission Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReport.monitoringMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monitoring methodology"@en ;
    rdfs:comment "The methodology used to measure emissions: CEMS (Continuous Emissions Monitoring System), PEMS (Predictive Emissions Monitoring System), Alternative monitoring, Fuel Sampling, or Mass Balance calculation."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "monitoring_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monitoring Methodology" ;
    cmm:validValues "CEMS|PEMS|Alternative|Fuel Sampling|Mass Balance" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.operatingHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating hours"@en ;
    rdfs:comment "The total number of operating hours for the plant unit during the reporting period."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "operating_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:EmissionsReport.orisplCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "orispl code"@en ;
    rdfs:comment "The unique EPA-assigned ORISPL code identifying the power plant facility for regulatory reporting purposes."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "orispl_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Office of Regulatory Information Systems Plant Location (ORISPL) Code" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.plantUnitIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plant unit identifier"@en ;
    rdfs:comment "The specific unit identifier within the generation facility that produced the emissions (e.g., boiler number, turbine identifier)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
