cmm:ComplianceViolation.penaltyAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty amount"@en ;
    rdfs:comment "Monetary fine or penalty assessed for the violation (gross amount)."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "penalty_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ComplianceViolation.penaltyCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "penalty currency"@en ;
