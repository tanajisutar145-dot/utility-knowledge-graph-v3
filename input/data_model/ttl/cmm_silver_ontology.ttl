cmm:ComplianceException.escalationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "escalation date"@en ;
    rdfs:comment "Date on which the exception was escalated to a higher authority or self-report process, if applicable."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:date ;
    cmm:physicalColumn "escalation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
