    rdfs:comment "Date of the most recent vulnerability assessment performed on this asset, as required under CIP-007 and CIP-010."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_vulnerability_assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Vulnerability Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:NercCipAsset.macAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mac address"@en ;
    rdfs:comment "MAC address of the network interface. Used for device identification and access control under CIP-005 and CIP-007."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "mac_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "MAC (Media Access Control) Address" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.manufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer"@en ;
    rdfs:comment "Manufacturer or vendor of the asset hardware or software (e.g., GE, Siemens, ABB, Cisco, OSIsoft)."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Manufacturer" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Manufacturer.name .
cmm:NercCipAsset.modelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model number"@en ;
    rdfs:comment "Model or part number of the asset. Used for vulnerability assessment and patch management under CIP-007."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Model Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:NercCipAsset.networkZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network zone"@en ;
    rdfs:comment "Logical network zone or segment where the asset resides (e.g., Control Network, Corporate Network, DMZ). Used for ESP boundary definition."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Zone" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.nextCipAssessmentDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next cip assessment due date"@en ;
    rdfs:comment "Date by which the next CIP impact assessment or classification review must be completed. CIP-002 requires reassessment within 15 calendar months of the previous assessment."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_cip_assessment_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next CIP (Critical Infrastructure Protection) Assessment Due Date" ;
    cmm:cimDatatype "Date" .
cmm:NercCipAsset.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional notes, comments, or context regarding the CIP classification, assessment, or compliance status of this asset."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:NercCipAsset.removableMediaControlsRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removable media controls required"@en ;
    rdfs:comment "Indicates whether this asset requires CIP-011 removable media controls (USB drives, CDs, external hard drives)."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "removable_media_controls_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Removable Media Controls Required" ;
    cmm:cimDatatype "Boolean" .
cmm:NercCipAsset.routableProtocolEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "routable protocol enabled"@en ;
    rdfs:comment "Indicates whether the asset uses routable protocols (TCP/IP) that require Electronic Access Point (EAP) controls under CIP-005."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "routable_protocol_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Routable Protocol Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:NercCipAsset.transientCyberAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transient cyber asset"@en ;
    rdfs:comment "Indicates whether this is a transient cyber asset (e.g., laptop, tablet, removable media) used for diagnostic testing, maintenance, or troubleshooting, subject to CIP-010 transient device controls."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "transient_cyber_asset" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transient Cyber Asset" ;
    cmm:cimDatatype "Boolean" .
cmm:NercCipAsset.updatedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated by"@en ;
    rdfs:comment "User ID or name of the person who last updated this CIP asset record. Required for audit trail and accountability."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "updated_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Updated By" ;
    cmm:cimDatatype "String" .
cmm:NercCipAsset.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this CIP asset record was last modified. Required for audit trail and change tracking under CIP-010."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:EmissionsReport a owl:Class ;
    rdfs:label "Emissions Report"@en ;
    rdfs:comment "Periodic emissions compliance report submitted to the EPA and state environmental agencies, covering SO2, NOx, CO2, mercury, and particulate matter emissions from generation facilities. Captures reporting period, facility (plant unit), pollutant type, measured emission quantity (tons), applicable emission limit, compliance margin, monitoring methodology (CEMS or alternative), and submission status. Supports EPA Clean Air Act Title IV Acid Rain Program, CSAPR, and state RPS compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.emissions_report" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EPA 40 CFR Part 75; EPA CAMD (Clean Air Markets Division); EPA eGRID; 40 CFR Part 75" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.emissions_report" ;
    owl:hasKey ( cmm:EmissionsReport.emissionsReportId ) .

cmm:EmissionsReport.emissionsReportId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions report id"@en ;
    rdfs:comment "Unique identifier for the emissions compliance report. Primary key for the emissions report entity."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "emissions_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Emissions Report ID" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReport.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Emissions monitoring and reporting costs (CEMS equipment, lab analysis, reporting labor) are allocated to plant/facility cost centers. Link enables tracking compliance costs by operating unit and supp"@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:EmissionsReport.emissionsObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emissions obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each emissions report fulfills a specific regulatory obligation (e.g., EPA Title V reporting, state emissions reporting). Many reports can fulfill one obligation (1:N). Adding obligation_id FK links t"@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "emissions_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_emissions_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EmissionsReport.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "FK to compliance.environmental_permit.environmental_permit_id — Emissions reports are submitted under specific environmental permits (e.g., Title V permits). This link enables permit-level compliance tracking."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_environmental_permit_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EmissionsReport.generationForecastInterval a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generation forecast interval"@en ;
    rdfs:comment "Foreign key linking to forecast.generation_forecast_interval. Business justification: Emissions reports reference generation forecasts for allowance planning and compliance margin calculation. Forward-looking emissions compliance requires forecasted generation dispatch to ensure suffic"@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:GenerationForecastInterval ;
    cmm:physicalColumn "generation_forecast_interval_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Forecast Interval Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_generation_forecast_interval_id" ;
    cmm:cimAssociation "Document.RegularTimePoint" .
cmm:EmissionsReport.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "FK to compliance.obligation.obligation_id — Emissions reports are submitted to fulfill EPA emissions reporting obligations. Links environmental reporting to the obligation registry."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EmissionsReport.originalReportEmissionsReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original report emissions report"@en ;
    rdfs:comment "Reference to the original emissions report ID if this is an amended report. Null for original submissions."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:EmissionsReport ;
    cmm:physicalColumn "original_report_emissions_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Report ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_original_report_emissions_report_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EmissionsReport.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Identifier of the generation facility (plant unit) that produced the emissions being reported."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:EmissionsReport.preparerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "preparer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: EPA emissions reports require certified preparer per 40 CFR Part 75. Replaces denormalized fields with FK to enable preparer certification tracking, workload management, and audit trail for regulatory"@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "preparer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_emissions_report_preparer_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:EmissionsReport.allowancesHeld a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowances held"@en ;
    rdfs:comment "The number of emission allowances held by the facility for the pollutant type at the end of the reporting period, applicable to cap-and-trade programs."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "allowances_held" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowances Held" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReport.allowancesUsed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allowances used"@en ;
    rdfs:comment "The number of emission allowances used (surrendered) to cover emissions during the reporting period, applicable to cap-and-trade programs."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:int ;
    cmm:physicalColumn "allowances_used" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allowances Used" ;
    cmm:cimDatatype "Integer" .
cmm:EmissionsReport.amendmentIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amendment indicator"@en ;
    rdfs:comment "Boolean flag indicating whether this report is an amendment to a previously submitted report (True) or an original submission (False)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "amendment_indicator" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amendment Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:EmissionsReport.amendmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amendment reason"@en ;
    rdfs:comment "Explanation of the reason for amending the original emissions report, if applicable."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "amendment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Amendment Reason" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.applicableEmissionLimit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable emission limit"@en ;
    rdfs:comment "The regulatory emission limit applicable to this facility and pollutant type for the reporting period, expressed in the same unit as measured emissions."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicable_emission_limit" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Emission Limit" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReport.authorizedRepresentativeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized representative name"@en ;
    rdfs:comment "The name of the designated authorized representative who certifies the accuracy of the emissions report on behalf of the facility."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_representative_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Representative Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.cemsCertificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cems certification status"@en ;
    rdfs:comment "The certification status of the CEMS equipment used for emissions monitoring, if applicable."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "cems_certification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Continuous Emissions Monitoring System (CEMS) Certification Status" ;
    cmm:validValues "Certified|Provisional|Decertified|Not Applicable" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.certificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification date"@en ;
    rdfs:comment "The date when the authorized representative certified the emissions report as accurate and complete."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "certification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Certification Date" ;
    cmm:cimDatatype "Date" .
cmm:EmissionsReport.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Additional comments, notes, or explanatory information related to the emissions report."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:EmissionsReport.complianceMargin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance margin"@en ;
    rdfs:comment "The difference between the applicable emission limit and the measured emission quantity. Positive values indicate compliance; negative values indicate exceedance."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "compliance_margin" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Margin" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReport.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "The overall compliance status of the facility for this emissions report: Compliant (within limits), Non-Compliant (exceeded limits), Pending Review, or Conditional (compliant with conditions)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:validValues "Compliant|Non-Compliant|Pending Review|Conditional" ;
    cmm:cimDatatype "String" .
cmm:EmissionsReport.correctiveActionPlan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
