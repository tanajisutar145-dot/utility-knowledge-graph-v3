cmm:EmployeeQualification.qualificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualification number"@en ;
    rdfs:comment "Business identifier for the qualification record, used for external reference and tracking in workforce management systems."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "qualification_number" ;
