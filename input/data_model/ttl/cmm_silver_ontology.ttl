cmm:NercCipAsset.decommissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decommission date"@en ;
    rdfs:comment "Date the asset was decommissioned or removed from CIP scope. Used to track when CIP obligations cease."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:date ;
    cmm:physicalColumn "decommission_date" ;
