    cmm:businessTerm "Regulation Reserve (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "Primary regulatory jurisdiction governing this control area (e.g., FERC, state PUC, provincial authority)."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
