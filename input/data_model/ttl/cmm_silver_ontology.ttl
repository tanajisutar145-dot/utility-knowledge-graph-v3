cmm:CostResponsibility.utilityCostSharePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility cost share percentage"@en ;
    rdfs:comment "Percentage of total cost assigned to the utility (0.00 to 100.00). Provides proportional view of utility responsibility."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_cost_share_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
