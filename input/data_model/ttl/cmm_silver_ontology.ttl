    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AssetInspection.overallConditionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "overall condition score"@en ;
    rdfs:comment "Overall asset condition rating on a 1-5 scale per IEEE/IEC standards (1=excellent, 2=good, 3=fair, 4=poor, 5=very poor/critical)."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:int ;
    cmm:physicalColumn "overall_condition_score" ;
