cmm:OutagePathImpact a owl:Class ;
    rdfs:label "Outage Path Impact"@en ;
    rdfs:comment "This association product represents the operational impact event between transmission outages and transmission paths. It captures the specific effect each outage has on each affected transmission path, including ATC reductions, timing, and RTO notification requirements. Each record links one transmission outage to one impacted path with attributes that exist only in the context of this specific outage-path impact relationship. This is a core operational and compliance entity required for NERC reliability reporting and RTO/ISO coordination.. Existence Justification: In transmission operations, a single outage event (line trip, transformer failure, planned maintenance) simultaneously impacts multiple transmission paths by reducing their Available Transfer Capability, and each path experiences impacts from multiple different outages over time. RTOs and ISOs require utilities to report path-specific ATC impacts for reliability coordination and NERC compliance, making this a core operational relationship that transmission operators actively manage and monitor in real-time."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.planning_studies ;
    cmm:physicalTable "utility_cmm_silver.transmission.outage_path_impact" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.outage_path_impact" ;
    owl:hasKey ( cmm:OutagePathImpact.outagePathImpactId ) .

cmm:OutagePathImpact.outagePathImpactId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage path impact id"@en ;
    rdfs:comment "Primary key for the outage_path_impact association"@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:long ;
    cmm:physicalColumn "outage_path_impact_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Outage Path Impact - Outage Path Impact Id" ;
    cmm:cimDatatype "Integer" .
cmm:OutagePathImpact.transmissionOutage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission outage"@en ;
    rdfs:comment "Foreign key linking to the transmission outage event that caused the path impact"@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range cmm:TransmissionOutage ;
    cmm:physicalColumn "transmission_outage_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Path Impact - Transmission Outage Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_outage_path_impact_transmission_outage_id" ;
    cmm:cimAssociation "IdentifiedObject.Outage" .
cmm:OutagePathImpact.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Foreign key linking to the transmission path that was impacted by the outage"@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Path Impact - Transmission Path Id" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_outage_path_impact_transmission_path_id" ;
    cmm:cimAssociation "IdentifiedObject.TransmissionPath" .
cmm:OutagePathImpact.affectedTransmissionPaths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected transmission paths"@en ;
    rdfs:comment "Comma-separated list of transmission paths or flowgates impacted by the outage. Critical for congestion management and market operations. [Moved from transmission_outage: This denormalized STRING attribute (comma-separated list) is the smoking gun proving the M:N relationship exists but is improperly modeled. It should be removed from transmission_outage and replaced by proper normalized records in the outage_path_impact association table.]"@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_transmission_paths" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Transmission Paths" ;
    cmm:cimDatatype "String" .
cmm:OutagePathImpact.atcImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc impact mw"@en ;
    rdfs:comment "Reduction in Available Transfer Capability in megawatts for this specific path caused by this specific outage. This is path-specific and varies by outage-path combination based on the electrical topology and contingency analysis."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "atc_impact_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Transfer Capability Impact" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:OutagePathImpact.contingencyImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency impact flag"@en ;
    rdfs:comment "Indicates whether this path impact is a direct result of the outage (false) or a contingency-based impact where the path becomes limiting under N-1 or N-2 analysis (true)."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Impact Indicator" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePathImpact.impactDurationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact duration hours"@en ;
    rdfs:comment "Total duration in hours that this specific path experienced reduced transfer capability due to this outage, calculated from impact start to impact end."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "impact_duration_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impact Duration" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:OutagePathImpact.impactEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact end timestamp"@en ;
    rdfs:comment "Date and time when this specific path's transfer capability was restored to normal following the outage resolution or system reconfiguration."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "impact_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impact End Time" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePathImpact.impactStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact start timestamp"@en ;
    rdfs:comment "Date and time when this specific path began experiencing reduced transfer capability due to the outage. May differ from outage start if path impact is contingency-based or delayed."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "impact_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impact Start Time" ;
    cmm:cimDatatype "DateTime" .
cmm:OutagePathImpact.restorationPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration priority"@en ;
    rdfs:comment "Priority level for restoring transfer capability on this specific path, which may differ from the overall outage restoration priority based on path criticality and current system conditions."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Path Restoration Priority" ;
    cmm:cimDatatype "String" .
cmm:OutagePathImpact.rtoNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto notification required"@en ;
    rdfs:comment "Indicates whether this specific path impact requires notification to the RTO/ISO based on the magnitude of ATC reduction and path criticality thresholds defined in operating agreements."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rto_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTO Notification Required" ;
    cmm:cimDatatype "Boolean" .
cmm:OutagePathImpact.ttcReductionMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ttc reduction mw"@en ;
    rdfs:comment "Reduction in Total Transfer Capability in megawatts for this path due to this outage. Used in transmission reliability analysis and NERC reporting."@en ;
    rdfs:domain cmm:OutagePathImpact ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ttc_reduction_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Transfer Capability Reduction" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .

cmm:TransformerVendorService a owl:Class ;
    rdfs:label "Transformer Vendor Service"@en ;
    rdfs:comment "This association product represents the service and warranty relationship between power transformers and vendors. It captures the multi-vendor service ecosystem where a single transformer receives services from multiple specialized vendors (OEM for warranty, oil testing labs, bushing manufacturers, local contractors) and each vendor services many transformers. Each record links one power transformer to one vendor with warranty terms, service contract details, and service history that exist only in the context of this specific transformer-vendor relationship.. Existence Justification: In energy utilities transmission operations, a single power transformer receives specialized services from multiple vendors simultaneously: the OEM handles warranty and major repairs, oil testing laboratories perform dissolved gas analysis, bushing manufacturers provide component-specific maintenance, and local contractors handle routine servicing. Each vendor services many transformers across the utility's transmission network. The utility actively manages these multi-vendor service relationships, tracking warranty coverage, service contracts, maintenance schedules, and vendor performance on a per-transformer, per-vendor basis."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.asset_management ;
    cmm:physicalTable "utility_cmm_silver.transmission.transformer_vendor_service" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.transformer_vendor_service" ;
    owl:hasKey ( cmm:TransformerVendorService.transformerVendorServiceId ) .

cmm:TransformerVendorService.transformerVendorServiceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transformer vendor service id"@en ;
    rdfs:comment "Primary key for the transformer-vendor service relationship record"@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:long ;
    cmm:physicalColumn "transformer_vendor_service_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Transformer Vendor Service ID" ;
    cmm:cimDatatype "Integer" .
cmm:TransformerVendorService.powerTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power transformer"@en ;
    rdfs:comment "Foreign key linking to the power transformer asset receiving service from this vendor"@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range cmm:PowerTransformer ;
    cmm:physicalColumn "power_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transformer Vendor Service - Power Transformer Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transformer_vendor_service_power_transformer_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerTransformer" .
cmm:TransformerVendorService.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor providing service to this transformer"@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transformer Vendor Service - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transformer_vendor_service_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:TransformerVendorService.lastServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last service date"@en ;
    rdfs:comment "Date of the most recent service performed by this vendor on this transformer. Used to track service history by vendor."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Service Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.nextServiceDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next service due date"@en ;
    rdfs:comment "Scheduled date for the next service to be performed by this vendor on this transformer. Used for maintenance planning and vendor coordination."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_service_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Service Due Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.relationshipEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship end date"@en ;
    rdfs:comment "Date when this vendor stopped providing services for this transformer, if applicable. Null for active relationships."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "relationship_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relationship End Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.relationshipStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship start date"@en ;
    rdfs:comment "Date when this vendor began providing services for this specific transformer. Used for vendor performance tracking and relationship history."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "relationship_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relationship Start Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.relationshipStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship status"@en ;
    rdfs:comment "Current status of this transformer-vendor service relationship. Active relationships are eligible for service scheduling."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:string ;
    cmm:physicalColumn "relationship_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relationship Status" ;
    cmm:cimDatatype "String" .
cmm:TransformerVendorService.serviceContractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service contract end date"@en ;
    rdfs:comment "End date of the service contract for this transformer-vendor relationship. Used for contract renewal planning."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_contract_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Contract End Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.serviceContractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service contract number"@en ;
    rdfs:comment "Unique identifier for the service contract between the utility and this vendor for this specific transformer. Links to procurement system contract records."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TransformerVendorService.serviceContractStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service contract start date"@en ;
    rdfs:comment "Start date of the service contract for this transformer-vendor relationship."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_contract_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Contract Start Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.serviceFrequencyDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service frequency days"@en ;
    rdfs:comment "Contracted service frequency in days for this vendor-transformer relationship. For example, oil testing labs may perform dissolved gas analysis every 180 days."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:int ;
    cmm:physicalColumn "service_frequency_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Frequency Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:TransformerVendorService.totalServiceCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total service cost"@en ;
    rdfs:comment "Cumulative cost of all services performed by this vendor on this transformer. Used for cost tracking and vendor performance analysis."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_service_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Service Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TransformerVendorService.totalServiceCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total service count"@en ;
    rdfs:comment "Cumulative count of service events performed by this vendor on this transformer. Used for vendor performance evaluation."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:int ;
    cmm:physicalColumn "total_service_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Service Count" ;
    cmm:cimDatatype "Integer" .
cmm:TransformerVendorService.vendorRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vendor role"@en ;
    rdfs:comment "The specific role this vendor plays for this transformer. A transformer has multiple vendors in different roles: OEM for warranty and major repairs, oil testing lab for dissolved gas analysis, bushing manufacturer for bushing maintenance, local service contractors for routine maintenance."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:string ;
    cmm:physicalColumn "vendor_role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vendor Role" ;
    cmm:cimDatatype "String" .
cmm:TransformerVendorService.warrantyEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty end date"@en ;
    rdfs:comment "End date of warranty coverage provided by this vendor for this transformer. Used to track warranty expiration and plan for post-warranty service contracts."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty End Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.warrantyStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty start date"@en ;
    rdfs:comment "Start date of warranty coverage provided by this vendor for this transformer. Typically applies to OEM vendor role."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Start Date" ;
    cmm:cimDatatype "Date" .
cmm:TransformerVendorService.warrantyTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty terms"@en ;
    rdfs:comment "Detailed warranty terms and conditions specific to this transformer-vendor relationship, including coverage scope, exclusions, and claim procedures."@en ;
    rdfs:domain cmm:TransformerVendorService ; rdfs:range xsd:string ;
    cmm:physicalColumn "warranty_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Terms" ;
    cmm:cimDatatype "String" .

cmm:PathReservation a owl:Class ;
    rdfs:label "Path Reservation"@en ;
    rdfs:comment "This association product represents the contractual reservation of transmission capacity on specific paths under OATT transmission service agreements. It captures the allocation of contracted MW capacity across transmission paths, priority rankings for curtailment, and effective periods for each path reservation. Each record links one transmission service agreement to one path with attributes that exist only in the context of this capacity reservation relationship. This is the SSOT for ATC calculation, TLR implementation, and OASIS posting compliance under FERC pro forma OATT requirements.. Existence Justification: In FERC-regulated transmission operations, a single transmission service agreement commonly reserves capacity across multiple transmission paths (e.g., a long-haul PTP agreement traversing multiple flowgates), and a single transmission path hosts capacity reservations from multiple customer agreements simultaneously. Transmission providers must actively manage these path-level reservations to calculate Available Transfer Capability (ATC), implement Transmission Loading Relief (TLR) during congestion, and post capacity availability to OASIS for regulatory compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TransmissionReservation ;
    cmm:cimCloseMatch cim:TransmissionReservation ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::InfEnergyScheduling" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.service_operations ;
    cmm:physicalTable "utility_cmm_silver.transmission.path_reservation" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.path_reservation" ;
    owl:hasKey ( cmm:PathReservation.pathReservationId ) .

cmm:PathReservation.pathReservationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "path reservation id"@en ;
    rdfs:comment "Unique identifier for this transmission service path reservation record. Primary key."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:long ;
    cmm:physicalColumn "path_reservation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Path Reservation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PathReservation.transmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path"@en ;
    rdfs:comment "Foreign key linking to the transmission path on which capacity is reserved"@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Path Reservation - Transmission Path Id" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_path_reservation_transmission_path_id" ;
    cmm:cimAssociation "TransmissionReservation.TransmissionPath" .
cmm:PathReservation.transmissionServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission service agreement"@en ;
    rdfs:comment "Foreign key linking to the transmission service agreement that reserves capacity on this path"@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range cmm:TransmissionServiceAgreement ;
    cmm:physicalColumn "transmission_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Path Reservation - Transmission Agreement Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_path_reservation_transmission_service_agreement_id" ;
    cmm:cimAssociation "TransmissionReservation.Agreement" .
cmm:PathReservation.allocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation percentage"@en ;
    rdfs:comment "Percentage of the agreement's total contracted capacity allocated to this specific path."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Path Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PathReservation.atcImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc impact mw"@en ;
    rdfs:comment "Impact of this reservation on Available Transfer Capability calculation for this path. Represents the reduction in available capacity due to this firm reservation."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "atc_impact_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ATC Impact Megawatts" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:PathReservation.curtailmentPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment priority"@en ;
    rdfs:comment "Priority ranking for this specific path reservation during TLR (Transmission Loading Relief) events. Lower numbers indicate higher priority and later curtailment."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:int ;
    cmm:physicalColumn "curtailment_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailment Priority Ranking" ;
    cmm:cimDatatype "Integer" .
cmm:PathReservation.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this path reservation expires or was terminated. Nullable for active reservations."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reservation Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:PathReservation.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this path reservation becomes effective. May differ from agreement term start if paths are added during agreement lifecycle."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reservation Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:PathReservation.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this path reservation record, supporting audit trail and change tracking."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PathReservation.oasisPostingRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oasis posting required flag"@en ;
    rdfs:comment "Indicates whether this path reservation must be posted to OASIS (Open Access Same-Time Information System) for FERC transparency compliance."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "oasis_posting_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OASIS Posting Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PathReservation.pathUtilizationFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "path utilization factor"@en ;
    rdfs:comment "Historical or projected utilization factor for this path reservation, representing actual usage relative to reserved capacity. Used for ATC forecasting and capacity planning."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "path_utilization_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Path Utilization Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:PathReservation.reservationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation status"@en ;
    rdfs:comment "Current operational status of this path reservation: active (in use), suspended (temporarily inactive), curtailed (reduced due to TLR), expired (term ended), terminated (cancelled before term end)."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reservation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reservation Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TransmissionReservation.status .
cmm:PathReservation.reservedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reserved capacity mw"@en ;
    rdfs:comment "Amount of transmission capacity in megawatts reserved on this specific path under this agreement. May differ from total contracted capacity if agreement spans multiple paths."@en ;
    rdfs:domain cmm:PathReservation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reserved_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reserved Capacity Megawatts" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .

cmm:SubstationMaintenanceContract a owl:Class ;
    rdfs:label "Substation Maintenance Contract"@en ;
    rdfs:comment "This association product represents the maintenance contract between a transmission substation and a vendor. It captures the commercial and service-level terms governing maintenance services provided by a specific vendor to a specific substation. Each record links one transmission substation to one vendor with contract-specific attributes including service scope, contract value, response time SLAs, and vendor preference ranking for that substation.. Existence Justification: In energy utilities transmission operations, substations require specialized maintenance services from multiple vendors simultaneously (transformer maintenance, protection testing, vegetation management, civil/structural, SCADA/telecom). Each vendor serves multiple substations across the transmission network. The business actively manages these maintenance contracts as distinct operational entities with substation-vendor-specific terms including service scope, contract value, response time SLAs, and performance tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.planning_studies ;
    cmm:physicalTable "utility_cmm_silver.transmission.substation_maintenance_contract" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.substation_maintenance_contract" ;
    owl:hasKey ( cmm:SubstationMaintenanceContract.substationMaintenanceContractId ) .

cmm:SubstationMaintenanceContract.substationMaintenanceContractId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation maintenance contract id"@en ;
    rdfs:comment "Unique surrogate identifier for this substation maintenance contract record. Primary key for the association."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:long ;
    cmm:physicalColumn "substation_maintenance_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Substation Maintenance Contract ID" ;
    cmm:cimDatatype "Integer" .
cmm:SubstationMaintenanceContract.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to the transmission substation receiving maintenance services under this contract"@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Maintenance Contract - Transmission Substation Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_substation_maintenance_contract_transmission_substation_id" ;
    cmm:cimAssociation "IdentifiedObject.Substation" .
cmm:SubstationMaintenanceContract.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor providing maintenance services under this contract"@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Maintenance Contract - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_substation_maintenance_contract_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:SubstationMaintenanceContract.annualContractValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual contract value"@en ;
    rdfs:comment "Total annual contract value in USD for maintenance services provided by this vendor to this substation. Used for budget allocation and cost tracking by substation-vendor pair."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_contract_value" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Contract Value" ;
    cmm:cimDatatype "Decimal" .
cmm:SubstationMaintenanceContract.contractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract end date"@en ;
    rdfs:comment "Expiration or termination date of the maintenance contract. Null for open-ended contracts. Used to track contract renewal cycles and vendor transitions."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Contract End Date" ;
    cmm:cimDatatype "Date" .
cmm:SubstationMaintenanceContract.contractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract number"@en ;
    rdfs:comment "Business identifier for this maintenance contract. May be assigned by procurement or legal systems. Used for contract document retrieval and invoice reconciliation."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SubstationMaintenanceContract.contractStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract start date"@en ;
    rdfs:comment "Effective start date of the maintenance contract between this vendor and this substation. Defines when the vendor's service obligations begin."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Contract Start Date" ;
    cmm:cimDatatype "Date" .
cmm:SubstationMaintenanceContract.contractStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract status"@en ;
    rdfs:comment "Current lifecycle status of this maintenance contract. Active = services being provided, expired = contract ended, suspended = temporarily paused, pending_renewal = in negotiation, terminated = cancelled before end date."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:SubstationMaintenanceContract.lastPerformanceReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last performance review date"@en ;
    rdfs:comment "Date of the most recent performance evaluation of this vendor's service delivery at this substation. Used to track vendor management cadence and inform renewal decisions."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_performance_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Performance Review Date" ;
    cmm:cimDatatype "Date" .
cmm:SubstationMaintenanceContract.lastPerformanceScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last performance score"@en ;
    rdfs:comment "Most recent performance evaluation score (0-100) for this vendor's work at this substation. Aggregates quality, timeliness, safety, and responsiveness dimensions specific to this substation-vendor relationship."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "last_performance_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Performance Score" ;
    cmm:cimDatatype "Decimal" .
cmm:SubstationMaintenanceContract.preferredVendorRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preferred vendor rank"@en ;
    rdfs:comment "Ranking of this vendor's preference for this specific substation (1 = primary, 2 = backup, etc.). Reflects vendor performance history, proximity, and specialized capability for this substation's equipment configuration."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "preferred_vendor_rank" ;
    cmm:sqlDataType "INTEGER" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preferred Vendor Rank" ;
    cmm:cimDatatype "String" .
cmm:SubstationMaintenanceContract.responseTimeSlaHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response time sla hours"@en ;
    rdfs:comment "Contractual service level agreement for vendor response time in hours for emergency calls from this substation. SLA may vary by substation criticality and vendor capability."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "response_time_sla_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Time SLA Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:SubstationMaintenanceContract.serviceScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service scope"@en ;
    rdfs:comment "Classification of the maintenance service type covered by this contract. Defines the specialized work this vendor performs at this substation. Multiple vendors may serve the same substation for different service scopes."@en ;
    rdfs:domain cmm:SubstationMaintenanceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Scope" ;
    cmm:cimDatatype "String" .

