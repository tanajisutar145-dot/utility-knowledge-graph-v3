cmm:ForecastRun a owl:Class ;
    rdfs:label "Forecast Run"@en ;
    rdfs:comment "Transactional entity capturing the execution record of a forecast model run, including run timestamp, triggering event (scheduled, manual, event-triggered), input data snapshot reference, model version used, run duration, convergence status, and output validation flags. Provides operational lineage and auditability for all forecast outputs. Enables traceability from forecast interval values back to the specific model run and input data used, supporting regulatory and operational audit requirements."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:forecast , cmmsa:forecast.generation_modeling ;
    cmm:physicalTable "utility_cmm_silver.forecast.forecast_run" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Forecast Model Execution Log; EMS Forecast Run" ;
    cmm:sourceObject "energy_utilities_ecm.forecast.forecast_run" ;
    owl:hasKey ( cmm:ForecastRun.forecastRunId ) .

cmm:ForecastRun.forecastRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast run id"@en ;
    rdfs:comment "Unique identifier for the forecast model run execution record. Primary key for the run entity."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "forecast_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Forecast Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.baselineRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "baseline run"@en ;
    rdfs:comment "Reference to a previous forecast run used as the baseline for comparison or delta analysis, supporting forecast accuracy assessment and model improvement."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range cmm:ForecastRun ;
    cmm:physicalColumn "baseline_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Baseline Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_forecast_run_baseline_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ForecastRun.forecastModel a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast model"@en ;
    rdfs:comment "Reference to the specific forecast model configuration used for this run, linking to the model registry."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range cmm:ForecastModel ;
    cmm:physicalColumn "forecast_model_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Model Identifier (ID)" ;
    cmm:sourceColumn "model_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_forecast_run_forecast_model_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:ForecastRun.primaryForecastEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary forecast employee"@en ;
    rdfs:comment "Identifier of the user or system account that initiated the forecast run for manual or event-triggered executions, supporting audit and accountability requirements."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_forecast_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Initiated By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_forecast_run_primary_forecast_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ForecastRun.supersededByRunForecastRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by run forecast run"@en ;
    rdfs:comment "Reference to a subsequent forecast run that supersedes this run, establishing forecast version lineage and supporting operational decision-making with the most current forecast."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range cmm:ForecastRun ;
    cmm:physicalColumn "superseded_by_run_forecast_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_forecast_run_superseded_by_run_forecast_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ForecastRun.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Timestamp when the forecast run output was approved for publication, establishing the approval audit trail."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRun.computeClusterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compute cluster code"@en ;
    rdfs:comment "Identifier of the computational cluster or resource pool used to execute the forecast run, supporting performance analysis and resource allocation optimization."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "compute_cluster_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compute Cluster Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.configurationParameters a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "configuration parameters"@en ;
    rdfs:comment "JSON or structured text representation of the model configuration parameters and hyperparameters used for this forecast run, enabling full reproducibility and parameter sensitivity analysis."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "configuration_parameters" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Configuration Parameters" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.convergenceIterations a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "convergence iterations"@en ;
    rdfs:comment "Number of computational iterations required for the forecast model to reach convergence or the maximum iteration limit, used for performance tuning and model diagnostics."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "convergence_iterations" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Convergence Iterations" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.convergenceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "convergence status"@en ;
    rdfs:comment "Indicator of whether the forecast model achieved mathematical convergence within acceptable tolerance thresholds, critical for assessing forecast reliability and model stability."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "convergence_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Convergence Status" ;
    cmm:validValues "converged|not_converged|partial_convergence|timeout" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.convergenceTolerance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "convergence tolerance"@en ;
    rdfs:comment "The mathematical tolerance threshold used to determine model convergence, typically expressed as a percentage or absolute error metric."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "convergence_tolerance" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Convergence Tolerance" ;
    cmm:cimDatatype "Decimal" .
cmm:ForecastRun.cpuHoursConsumed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpu hours consumed"@en ;
    rdfs:comment "Total computational resource consumption measured in CPU hours for this forecast run, used for cost allocation and capacity planning."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cpu_hours_consumed" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Central Processing Unit (CPU) Hours Consumed" ;
    cmm:cimDatatype "Decimal" .
cmm:ForecastRun.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the forecast run record was first created in the system, supporting audit trail and data lineage requirements."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:ForecastRun.durationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration seconds"@en ;
    rdfs:comment "Total elapsed time in seconds for the forecast run execution, calculated from start to end timestamp for performance monitoring and capacity planning."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "duration_seconds" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Run Duration in Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:ForecastRun.endTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end timestamp"@en ;
    rdfs:comment "Timestamp when the forecast model run execution completed or terminated, used to calculate run duration and performance metrics."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Run End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ForecastRun.errorMessage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "error message"@en ;
    rdfs:comment "Detailed error message or exception information captured if the forecast run failed or encountered critical issues, supporting troubleshooting and root cause analysis."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "error_message" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Error Message" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.executionEnvironment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution environment"@en ;
    rdfs:comment "The computational environment where the forecast run was executed, distinguishing between production forecasts and test or validation runs."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "execution_environment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Environment" ;
    cmm:validValues "production|staging|development|test|validation" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.forecastEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast end timestamp"@en ;
    rdfs:comment "The ending timestamp of the forecast period that this run produces predictions for, defining the last interval of the forecast output."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "forecast_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRun.forecastHorizonHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast horizon hours"@en ;
    rdfs:comment "The time span in hours that this forecast run covers from the forecast start time, defining the look-ahead period for operational planning and dispatch decisions."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "forecast_horizon_hours" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Horizon in Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:ForecastRun.forecastStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast start timestamp"@en ;
    rdfs:comment "The beginning timestamp of the forecast period that this run produces predictions for, defining the first interval of the forecast output."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "forecast_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRun.forecastType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast type"@en ;
    rdfs:comment "Classification of the forecast domain this run produces, distinguishing between load forecasting, generation forecasting, renewable intermittency prediction, price forecasting, and demand response forecasting."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "forecast_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Forecast Type" ;
    cmm:validValues "load|generation|renewable|price|demand_response" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:ForecastRun.geographicScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic scope"@en ;
    rdfs:comment "The geographic or electrical network level at which this forecast run operates, defining the spatial granularity of forecast outputs."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Scope" ;
    cmm:validValues "system|zone|substation|feeder|service_territory" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.inputDataSnapshotCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "input data snapshot code"@en ;
    rdfs:comment "Reference identifier to the specific snapshot of input data used for this forecast run, enabling full traceability and reproducibility of forecast results by linking to historical, weather, and operational data versions."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "input_data_snapshot_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Input Data Snapshot Identifier (ID)" ;
    cmm:valuePattern "^[A-Z0-9_-]{10,50}$" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.intervalResolutionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval resolution minutes"@en ;
    rdfs:comment "The temporal granularity of forecast intervals produced by this run, typically 5, 15, 30, or 60 minutes for operational forecasting aligned with market and dispatch intervals."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_resolution_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Resolution in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ForecastRun.memoryPeakGb a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "memory peak gb"@en ;
    rdfs:comment "Peak memory utilization in gigabytes during forecast run execution, used for resource sizing and performance optimization."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "memory_peak_gb" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Memory Peak in Gigabytes (GB)" ;
    cmm:cimDatatype "Decimal" .
cmm:ForecastRun.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when the forecast run record was last modified, tracking updates to status, validation results, or metadata throughout the run lifecycle."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ForecastRun.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments about the forecast run, capturing operational context, special conditions, or analyst observations relevant to forecast interpretation."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ForecastRun.outputRecordCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "output record count"@en ;
    rdfs:comment "Total number of forecast interval records produced by this run, used for completeness verification and data quality monitoring."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "output_record_count" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Output Record Count" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.outputValidationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "output validation status"@en ;
    rdfs:comment "Result of automated validation checks applied to forecast output data, including range checks, consistency checks, and business rule validation to ensure forecast quality before publication."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "output_validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Output Validation Status" ;
    cmm:validValues "passed|failed|warning|not_validated" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.publishedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "published flag"@en ;
    rdfs:comment "Indicator of whether this forecast run output has been published for operational use by dispatch, trading, and planning systems."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "published_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Published Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRun.publishedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "published timestamp"@en ;
    rdfs:comment "Timestamp when the forecast run output was published and made available to downstream operational systems and users."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "published_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Published Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRun.runNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run number"@en ;
    rdfs:comment "Business-friendly identifier for the forecast run, typically formatted as a human-readable code for operational reference and audit trails."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Run Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ForecastRun.runStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run status"@en ;
    rdfs:comment "Current lifecycle status of the forecast run execution, tracking progression from initiation through completion or failure states."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Run Status" ;
    cmm:validValues "pending|running|completed|failed|cancelled|partial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:ForecastRun.runToModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run to model"@en ;
    rdfs:comment "FK to forecast.forecast_model.forecast_model_id — Every forecast run execution must reference the model version used. Core lineage FK for auditability."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "run_to_model" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.runType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run type"@en ;
    rdfs:comment "Classification of the forecast run execution trigger mechanism, distinguishing between automated scheduled runs, manual operator-initiated runs, event-driven runs, historical backfills, reforecasts, and validation runs."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Run Type" ;
    cmm:validValues "scheduled|manual|event_triggered|backfill|reforecast|validation" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:ForecastRun.startTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start timestamp"@en ;
    rdfs:comment "Timestamp when the forecast model run execution began, marking the initiation of the computational process."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Run Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ForecastRun.triggeredByEvent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggered by event"@en ;
    rdfs:comment "Description or identifier of the specific event that triggered this forecast run for event-driven executions, such as significant weather changes, grid events, or market conditions."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggered_by_event" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggered By Event" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.validationErrorCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation error count"@en ;
    rdfs:comment "Total number of validation errors detected in the forecast output, used to assess data quality and determine if manual review or rerun is required."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "validation_error_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Error Count" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.validationWarningCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation warning count"@en ;
    rdfs:comment "Total number of validation warnings detected in the forecast output, indicating potential quality issues that do not prevent publication but require attention."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "validation_warning_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Warning Count" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRun.warningMessage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warning message"@en ;
    rdfs:comment "Warning messages or alerts generated during forecast run execution that do not prevent completion but indicate potential quality or performance issues."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "warning_message" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warning Message" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.weatherDataSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather data source"@en ;
    rdfs:comment "Identification of the weather data provider or service used as input for this forecast run, such as NOAA, Weather Underground, or proprietary weather services."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_data_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Data Source" ;
    cmm:cimDatatype "String" .
cmm:ForecastRun.weatherScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather scenario"@en ;
    rdfs:comment "Classification of the weather conditions or scenario used in the forecast model run, supporting sensitivity analysis and scenario planning for weather-dependent load and renewable generation forecasting. Reference-value candidates: actual|normal|hot|cold|extreme_heat|extreme_cold|high_wind|low_wind."@en ;
    rdfs:domain cmm:ForecastRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Scenario" ;
    cmm:cimDatatype "String" .

cmm:ForecastRevision a owl:Class ;
    rdfs:label "Forecast Revision"@en ;
    rdfs:comment "Transactional audit record capturing each revision to a published forecast value, including original value, revised value, revision timestamp, reason code (weather update, unit trip, demand response activation, market signal), and authorizing analyst. Maintains complete version history of forecast updates throughout the operating day or planning cycle. Required for NERC/FERC regulatory compliance, post-event root cause analysis, and real-time operations audit. Supports intra-day forecast evolution tracking critical for dispatch and trading decisions."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:forecast , cmmsa:forecast.generation_modeling ;
    cmm:physicalTable "utility_cmm_silver.forecast.revision" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Forecast Revision Audit; EMS Forecast Update" ;
    cmm:sourceObject "energy_utilities_ecm.forecast.revision" ;
    owl:hasKey ( cmm:ForecastRevision.revisionId ) .

cmm:ForecastRevision.revisionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision id"@en ;
    rdfs:comment "Primary key for revision"@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:long ;
    cmm:physicalColumn "revision_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Revision Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRevision.forecastRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast run"@en ;
    rdfs:comment "Reference to the parent forecast that was revised. Links to the original forecast entity (load, generation, or other forecast type)."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range cmm:ForecastRun ;
    cmm:physicalColumn "forecast_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_revision_forecast_run_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ForecastRevision.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Forecast revisions are spatially scoped to forecast zones. The zone table defines geographic boundaries and aggregation levels. Adding forecast_zone_id FK allows retrieval of zone_code, zone_name, and"@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_revision_forecast_zone_id" ;
    cmm:cimAssociation "ActivityRecord.LoadArea" .
cmm:ForecastRevision.revisionApprovedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "revision approved by user employee"@en ;
    rdfs:comment "Employee identifier or username of the supervisor who approved the forecast revision, if approval was required. Null if no approval was needed."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "revision_approved_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approved By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_revision_revision_approved_by_user_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ForecastRevision.revisionEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "revision employee"@en ;
    rdfs:comment "Employee identifier or username of the analyst or operator who authorized and executed the forecast revision. Required for accountability and audit compliance."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "revision_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Authorizing Analyst Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_revision_revision_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:ForecastRevision.supersededByRevision a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by revision"@en ;
    rdfs:comment "Reference to a subsequent revision that supersedes this revision. Null if this is the current active revision. Enables complete version history tracking."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range cmm:ForecastRevision ;
    cmm:physicalColumn "superseded_by_revision_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By Revision Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_revision_superseded_by_revision_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:ForecastRevision.affectedIntervalEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected interval end"@en ;
    rdfs:comment "End timestamp of the forecast interval affected by this revision. Defines the end of the time window impacted by the forecast change."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "affected_interval_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRevision.affectedIntervalStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected interval start"@en ;
    rdfs:comment "Start timestamp of the forecast interval affected by this revision. Defines the beginning of the time window impacted by the forecast change."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "affected_interval_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRevision.approvalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required flag"@en ;
    rdfs:comment "Indicates whether the revision required supervisory approval before being applied. True if approval was required, false if analyst had authority to revise independently."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the forecast revision was approved by a supervisor, if approval was required. Null if no approval was needed."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRevision.authorizingAnalystName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorizing analyst name"@en ;
    rdfs:comment "Full name of the analyst or operator who authorized the forecast revision. Supports human-readable audit trails and operational accountability."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorizing_analyst_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorizing Analyst Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.confidenceLevelPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level percent"@en ;
    rdfs:comment "Statistical confidence level of the revised forecast value, expressed as a percentage (e.g., 95.00 for 95% confidence). Indicates forecast reliability."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_level_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidence Level Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ForecastRevision.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this revision record was first created in the system. Audit field for data lineage and compliance."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:ForecastRevision.dataSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source"@en ;
    rdfs:comment "Source system or data feed that triggered or provided input for the forecast revision (e.g., SCADA, weather service, market operator, EMS)."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.demandResponseEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response event flag"@en ;
    rdfs:comment "Indicates whether the revision was triggered by activation or curtailment of a demand response program. True if DR-related, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.dispatchAdjustmentRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch adjustment required flag"@en ;
    rdfs:comment "Indicates whether the forecast revision requires immediate adjustment to generation dispatch schedules. True if dispatch change needed, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispatch_adjustment_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Adjustment Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.forecastHorizonHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast horizon hours"@en ;
    rdfs:comment "Number of hours ahead from the revision timestamp to the affected forecast interval. Indicates whether this is a short-term operational forecast revision or longer-term planning revision."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "forecast_horizon_hours" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Horizon Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:ForecastRevision.forecastType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecast type"@en ;
    rdfs:comment "Type of forecast being revised: load forecast, generation forecast, renewable intermittency forecast, demand response forecast, price forecast, or interchange forecast."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "forecast_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecast Type" ;
    cmm:validValues "load|generation|renewable|demand_response|price|interchange" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.geographicScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic scope"@en ;
    rdfs:comment "Geographic or operational scope of the forecast being revised: balancing authority area, control area, load zone, substation, or system-wide."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Scope" ;
    cmm:validValues "balancing_authority|control_area|zone|substation|system_wide" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this revision record was last modified. Audit field for tracking changes to revision metadata or status."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ForecastRevision.marketImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market impact flag"@en ;
    rdfs:comment "Indicates whether the forecast revision has material impact on energy market operations, trading positions, or dispatch decisions. True if market-impacting, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "market_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.modelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Version identifier of the forecasting model or algorithm that generated the revised forecast value, if applicable. Supports model performance tracking and audit."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Model Version" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ProductAssetModel.modelVersion .
cmm:ForecastRevision.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional free-text notes or comments about the forecast revision. Provides supplementary context for operational review and post-event analysis."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Revision Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ForecastRevision.ofRun a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "of run"@en ;
    rdfs:comment "FK to forecast.run_log.run_log_id — Revisions modify outputs of a specific forecast run. Must trace back to the original run for audit trail."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:long ;
    cmm:physicalColumn "of_run" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRevision.originalValueMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original value mw"@en ;
    rdfs:comment "Original forecasted value in megawatts before the revision was applied. Preserved for audit trail and variance analysis."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_value_mw" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Original Value Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ForecastRevision.reasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason code"@en ;
    rdfs:comment "Standardized code indicating the reason for the forecast revision: weather update, generation unit trip, unit return to service, demand response program activation, market price signal change, actual load deviation from forecast, forecast model update, or manual operator override. Reference-value candidates: weather_update|unit_trip|unit_return|demand_response_activation|market_signal|load_deviation|forecast_model_update|operator_override."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revision Reason Code" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.reasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reason description"@en ;
    rdfs:comment "Detailed free-text explanation of the reason for the forecast revision. Provides context beyond the standardized reason code for post-event root cause analysis."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revision Reason Description" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.regulatoryReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable flag"@en ;
    rdfs:comment "Indicates whether the forecast revision must be reported to regulatory authorities (NERC, FERC, or state PUC). True if reportable, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.revisedValueMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revised value mw"@en ;
    rdfs:comment "Updated forecasted value in megawatts after the revision. Represents the new forecast value that supersedes the original."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "revised_value_mw" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revised Value Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ForecastRevision.revisionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision method"@en ;
    rdfs:comment "Method by which the revision was generated: automated (system-generated based on rules or model updates), manual (analyst-initiated), or hybrid (system-suggested with analyst approval)."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revision Method" ;
    cmm:validValues "automated|manual|hybrid" ;
    cmm:cimDatatype "String" .
cmm:ForecastRevision.revisionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision status"@en ;
    rdfs:comment "Current status of the forecast revision in its lifecycle: pending approval, approved, applied to operational forecast, superseded by later revision, or rejected."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:string ;
    cmm:physicalColumn "revision_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Revision Status" ;
    cmm:validValues "pending|approved|applied|superseded|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:ForecastRevision.revisionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision timestamp"@en ;
    rdfs:comment "Date and time when the forecast revision was made. Critical for intra-day forecast evolution tracking and real-time operations audit."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "revision_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revision Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ForecastRevision.sequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sequence number"@en ;
    rdfs:comment "Sequential number indicating the order of revisions for a given forecast. First revision is 1, second is 2, etc. Enables tracking of revision history chronology."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:int ;
    cmm:physicalColumn "sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Revision Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:ForecastRevision.unitOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit outage flag"@en ;
    rdfs:comment "Indicates whether the revision was triggered by a generation unit outage (forced or scheduled). True if outage-related, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "unit_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ForecastRevision.varianceMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance mw"@en ;
    rdfs:comment "Difference between revised and original values in megawatts (revised minus original). Positive indicates upward revision, negative indicates downward revision."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_mw" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ForecastRevision.variancePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance percent"@en ;
    rdfs:comment "Percentage change from original to revised value. Calculated as (variance / original_value) * 100. Enables relative impact assessment."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_percent" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ForecastRevision.weatherEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather event flag"@en ;
    rdfs:comment "Indicates whether the revision was triggered by a significant weather event or weather forecast update. True if weather-related, false otherwise."@en ;
    rdfs:domain cmm:ForecastRevision ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "weather_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Event Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:ResourceAdequacyAssessment a owl:Class ;
    rdfs:label "Resource Adequacy Assessment"@en ;
    rdfs:comment "Master entity capturing periodic resource adequacy assessments evaluating whether the utility has sufficient generation and demand response capacity to meet forecasted peak demand with required reserve margins. Stores assessment period, planning reserve margin (%), loss-of-load expectation (LOLE in days/year), expected unserved energy (EUE in MWh/year), capacity surplus/deficit (MW), and compliance status against NERC and RTO standards. Filed with NERC and state PUC."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:forecast , cmmsa:forecast.resource_planning ;
    cmm:physicalTable "utility_cmm_silver.forecast.resource_adequacy_assessment" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC LTRA; NERC Resource Adequacy Assessment; RTO Capacity Adequacy Report" ;
    cmm:sourceObject "energy_utilities_ecm.forecast.resource_adequacy_assessment" ;
    owl:hasKey ( cmm:ResourceAdequacyAssessment.resourceAdequacyAssessmentId ) .

cmm:ResourceAdequacyAssessment.resourceAdequacyAssessmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resource adequacy assessment id"@en ;
    rdfs:comment "Unique identifier for the resource adequacy assessment record. Primary key for this entity."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "resource_adequacy_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Resource Adequacy Assessment Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ResourceAdequacyAssessment.capacityRequirement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity requirement"@en ;
    rdfs:comment "FK to forecast.capacity_requirement.capacity_requirement_id — Resource adequacy assessments evaluate whether capacity meets requirements. This is the core RA compliance relationship."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "capacity_requirement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_capacity_requirement_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ResourceAdequacyAssessment.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Resource adequacy assessments are performed at control area level for NERC compliance, reserve margin verification, and loss-of-load-expectation calculations. Balancing authorities must demonstrate ad"@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_control_area_id" ;
    cmm:cimAssociation "Document.ControlArea" .
cmm:ResourceAdequacyAssessment.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Resource adequacy assessments evaluate capacity sufficiency for a geographic area. The zone table defines forecast zones with peak load, installed capacity, and renewable penetration. Adding forecast_"@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_forecast_zone_id" ;
    cmm:cimAssociation "Document.LoadArea" .
cmm:ResourceAdequacyAssessment.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "FK to forecast.irp_scenario.irp_scenario_id — Resource adequacy assessments may be performed for specific IRP scenarios. FK enables scenario-specific adequacy evaluation."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ResourceAdequacyAssessment.resourceCapacityRequirement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "resource capacity requirement"@en ;
    rdfs:comment "FK to forecast.capacity_requirement.capacity_requirement_id — Resource adequacy assessments evaluate compliance against capacity requirements. FK is required for NERC reliability compliance tracking."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "resource_capacity_requirement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_resource_capacity_requirement_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ResourceAdequacyAssessment.resourceRaAgainstCapacityReq a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "resource_ra_against_capacity_req"@en ;
    rdfs:comment "FK to forecast.capacity_requirement.capacity_requirement_id — Resource adequacy assessments evaluate compliance against capacity requirement targets. FK enables compliance status determination."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "resource_ra_against_capacity_req" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_resource_ra_against_capacity_req" ;
    cmm:cimAssociation "Document.Document" .
cmm:ResourceAdequacyAssessment.responsibleOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible org unit"@en ;
    rdfs:comment "Foreign key linking to workforce.org_unit. Business justification: Resource adequacy assessments are owned by specific organizational units (resource adequacy department, planning department) for NERC and PUC compliance. Required for regulatory accountability, depart"@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "responsible_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Org Unit Id (Foreign Key)" ;
    cmm:sourceColumn "org_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_responsible_org_unit_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:ResourceAdequacyAssessment.supersededByAssessmentResourceAdequacyAssessment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by assessment resource adequacy assessment"@en ;
    rdfs:comment "Identifier of the newer resource adequacy assessment that supersedes this assessment. Used to maintain assessment version history and lineage. Null if this is the current active assessment."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range cmm:ResourceAdequacyAssessment ;
    cmm:physicalColumn "superseded_by_assessment_resource_adequacy_assessment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By Assessment Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_resource_adequacy_assessment_superseded_by_assessment_resource_adequacy_assessment_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ResourceAdequacyAssessment.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Name or identifier of the individual or role who approved this resource adequacy assessment for internal use or regulatory submission. Typically a senior executive or planning director."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time when this resource adequacy assessment was formally approved by the designated authority for internal use or regulatory submission."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ResourceAdequacyAssessment.assessmentCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment completion timestamp"@en ;
    rdfs:comment "Date and time when the resource adequacy assessment was completed and finalized for internal approval or regulatory submission."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "assessment_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ResourceAdequacyAssessment.assessmentIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment identifier"@en ;
    rdfs:comment "Externally-known business identifier or reference number for this resource adequacy assessment, used in regulatory filings and communications with NERC, RTO, and state PUC."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Business Identifier" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.assessmentMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment methodology"@en ;
    rdfs:comment "Methodology used to conduct the resource adequacy assessment: deterministic (fixed reserve margin approach), probabilistic (LOLE/EUE Monte Carlo simulation), hybrid (combination of both methods). Determines calculation approach and reliability metrics."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Methodology" ;
    cmm:validValues "deterministic|probabilistic|hybrid" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.assessmentPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment period end date"@en ;
    rdfs:comment "End date of the planning period covered by this resource adequacy assessment. Defines the conclusion of the forecast horizon for capacity evaluation."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:ResourceAdequacyAssessment.assessmentPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment period start date"@en ;
    rdfs:comment "Start date of the planning period covered by this resource adequacy assessment. Defines the beginning of the forecast horizon for capacity evaluation."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assessment_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assessment Period Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ResourceAdequacyAssessment.assessmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment status"@en ;
    rdfs:comment "Current lifecycle status of the resource adequacy assessment: draft (in preparation), under_review (internal or regulatory review), approved (finalized internally), filed (submitted to regulatory bodies), superseded (replaced by newer assessment)."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assessment Status" ;
    cmm:validValues "draft|under_review|approved|filed|superseded" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:ResourceAdequacyAssessment.assessmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment type"@en ;
    rdfs:comment "Type or category of resource adequacy assessment: seasonal (summer/winter peak), annual (full year), long-term (multi-year IRP), or special (event-driven or ad-hoc)."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assessment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assessment Type" ;
    cmm:validValues "seasonal|annual|long_term|special" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:ResourceAdequacyAssessment.assessmentUsesPeakDemand a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assessment uses peak demand"@en ;
    rdfs:comment "FK to forecast.peak_demand_forecast.peak_demand_forecast_id — RA assessments use peak demand forecasts as the demand-side input to reserve margin calculations."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:long ;
    cmm:physicalColumn "assessment_uses_peak_demand" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ResourceAdequacyAssessment.availableGenerationCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "available generation capacity mw"@en ;
    rdfs:comment "Total available generation capacity in megawatts (MW) from all owned and contracted generation resources, accounting for planned outages, derates, and seasonal availability."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "available_generation_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Generation Capacity (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.capacityMarketPurchasesMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity market purchases mw"@en ;
    rdfs:comment "Generation capacity in megawatts (MW) procured through capacity markets, bilateral contracts, or power purchase agreements (PPA) to meet resource adequacy requirements. Supplements owned generation."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_market_purchases_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Market Purchases (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.capacitySurplusDeficitMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity surplus deficit mw"@en ;
    rdfs:comment "Net capacity surplus (positive value) or deficit (negative value) in megawatts (MW), calculated as the difference between available capacity and the capacity required to meet peak demand plus required reserves. Indicates whether additional capacity procurement or retirement is needed."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_surplus_deficit_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Surplus or Deficit (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Compliance status of the resource adequacy assessment against NERC, RTO, and state PUC reserve margin and reliability standards: compliant (meets all requirements), non_compliant (fails to meet one or more requirements), conditional (meets requirements under specific assumptions), pending_review (awaiting regulatory determination)."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:validValues "compliant|non_compliant|conditional|pending_review" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "Username or identifier of the system user who created this resource adequacy assessment record. Audit trail for accountability and compliance."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this resource adequacy assessment record was first created in the system. Audit trail for data lineage and compliance."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:ResourceAdequacyAssessment.demandResponseCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response capacity mw"@en ;
    rdfs:comment "Total demand response capacity in megawatts (MW) available for peak load reduction, including interruptible load programs, direct load control, and voluntary curtailment programs."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_response_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Capacity (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.derPenetrationPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der penetration percent"@en ;
    rdfs:comment "Percentage of peak demand served by Distributed Energy Resources (DER) including rooftop solar, battery storage, and behind-the-meter generation. Impacts net load forecast and capacity credit calculations."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "der_penetration_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Penetration Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ResourceAdequacyAssessment.economicScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "economic scenario"@en ;
    rdfs:comment "Economic growth scenario assumed in the load forecast for this resource adequacy assessment: base (expected growth), high_growth (accelerated economic expansion), low_growth (slower expansion), recession (economic contraction). Impacts demand forecast and capacity requirements."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "economic_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Economic Scenario" ;
    cmm:validValues "base|high_growth|low_growth|recession" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.electricVehicleLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "electric vehicle load mw"@en ;
    rdfs:comment "Incremental peak demand in megawatts (MW) from electric vehicle (EV) charging load forecasted for the assessment period. Increases total capacity requirement."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "electric_vehicle_load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Electric Vehicle (EV) Load (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.energyEfficiencyAdjustmentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy efficiency adjustment mw"@en ;
    rdfs:comment "Peak demand reduction in megawatts (MW) attributed to energy efficiency programs and measures implemented during the assessment period. Reduces net capacity requirement."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_efficiency_adjustment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Efficiency Adjustment (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.expectedUnservedEnergyMwhPerYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expected unserved energy mwh per year"@en ;
    rdfs:comment "Expected Unserved Energy (EUE) metric expressed in megawatt-hours per year (MWh/year), representing the expected amount of energy demand that cannot be served due to generation capacity shortfalls. Complements LOLE by quantifying the magnitude of potential shortfalls."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "expected_unserved_energy_mwh_per_year" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expected Unserved Energy (EUE) Megawatt-Hours (MWh) per Year" ;
    cmm:cimDatatype "Decimal" .
cmm:ResourceAdequacyAssessment.filedWithNercFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filed with nerc flag"@en ;
    rdfs:comment "Boolean flag indicating whether this resource adequacy assessment has been filed with NERC as part of mandatory reliability reporting requirements. True if filed, False if not filed."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "filed_with_nerc_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filed with North American Electric Reliability Corporation (NERC) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ResourceAdequacyAssessment.filedWithPucFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filed with puc flag"@en ;
    rdfs:comment "Boolean flag indicating whether this resource adequacy assessment has been filed with the state Public Utility Commission (PUC) as part of integrated resource planning or rate case proceedings. True if filed, False if not filed."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "filed_with_puc_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filed with Public Utility Commission (PUC) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ResourceAdequacyAssessment.forcedOutageRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forced outage rate percent"@en ;
    rdfs:comment "Average forced outage rate percentage assumed for the generation fleet in this assessment, representing the probability that a generating unit is unavailable due to unplanned outages. Used in probabilistic reliability calculations."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forced_outage_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forced Outage Rate Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ResourceAdequacyAssessment.forecastedPeakDemandMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "forecasted peak demand mw"@en ;
    rdfs:comment "Forecasted peak demand in megawatts (MW) for the assessment period, representing the highest expected load the utility must serve. Critical input for capacity adequacy calculations."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "forecasted_peak_demand_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Forecasted Peak Demand (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "Username or identifier of the system user who last modified this resource adequacy assessment record. Audit trail for accountability and compliance."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this resource adequacy assessment record was last updated or modified. Audit trail for data lineage and compliance."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ResourceAdequacyAssessment.lossOfLoadExpectationDaysPerYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "loss of load expectation days per year"@en ;
    rdfs:comment "Loss of Load Expectation (LOLE) metric expressed in days per year, representing the expected number of days per year when available generation capacity is insufficient to meet demand. Industry standard reliability target is typically 0.1 days/year (one day in ten years)."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "loss_of_load_expectation_days_per_year" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Loss of Load Expectation (LOLE) Days per Year" ;
    cmm:cimDatatype "Decimal" .
cmm:ResourceAdequacyAssessment.modelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model version"@en ;
    rdfs:comment "Version identifier of the resource adequacy model, simulation tool, or analytical framework used to perform this assessment. Enables traceability and reproducibility."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Model Version" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ProductAssetModel.modelVersion .
cmm:ResourceAdequacyAssessment.nercFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc filing date"@en ;
    rdfs:comment "Date when this resource adequacy assessment was officially filed with NERC for compliance and reliability reporting purposes. Null if not yet filed."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "nerc_filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:ResourceAdequacyAssessment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes, comments, or explanatory information about this resource adequacy assessment, including assumptions, limitations, special conditions, or regulatory feedback. Supports documentation and audit trail."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assessment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ResourceAdequacyAssessment.peakDemandTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand timestamp"@en ;
    rdfs:comment "Forecasted date and time when the peak demand is expected to occur during the assessment period. Used for operational planning and dispatch scheduling."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "peak_demand_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ResourceAdequacyAssessment.plannedCapacityAdditionsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned capacity additions mw"@en ;
    rdfs:comment "Total planned generation capacity additions in megawatts (MW) expected to come online during the assessment period, including new builds, repowering projects, and capacity purchases. Increases available capacity."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_capacity_additions_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Capacity Additions (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.plannedCapacityRetirementsMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned capacity retirements mw"@en ;
    rdfs:comment "Total planned generation capacity retirements in megawatts (MW) expected during the assessment period, including plant closures, decommissioning, and end-of-life retirements. Reduces available capacity."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planned_capacity_retirements_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Capacity Retirements (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ResourceAdequacyAssessment.planningReserveMarginPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning reserve margin percent"@en ;
    rdfs:comment "Planning reserve margin expressed as a percentage, representing the amount of generation capacity above forecasted peak demand required to ensure reliability. Calculated as ((Available Capacity - Peak Demand) / Peak Demand) * 100. Regulatory requirement varies by RTO and state PUC."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "planning_reserve_margin_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Reserve Margin Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ResourceAdequacyAssessment.pucFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc filing date"@en ;
    rdfs:comment "Date when this resource adequacy assessment was officially filed with the state Public Utility Commission (PUC) as part of regulatory proceedings. Null if not yet filed."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "puc_filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:ResourceAdequacyAssessment.renewablePenetrationPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable penetration percent"@en ;
    rdfs:comment "Percentage of total generation capacity from renewable energy sources (wind, solar, hydro, biomass) in the resource mix for this assessment period. Impacts capacity factor assumptions and intermittency risk."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "renewable_penetration_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Penetration Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ResourceAdequacyAssessment.requiredReserveMarginPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required reserve margin percent"@en ;
    rdfs:comment "Minimum planning reserve margin percentage mandated by NERC, RTO, or state PUC for this assessment period. Benchmark against which actual reserve margin is evaluated for compliance."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "required_reserve_margin_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required Reserve Margin Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ResourceAdequacyAssessment.rtoIsoRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso region"@en ;
    rdfs:comment "Regional Transmission Organization (RTO) or Independent System Operator (ISO) region for which this resource adequacy assessment applies (e.g., PJM, MISO, CAISO, ERCOT, SPP, NYISO, ISO-NE). Determines applicable reliability standards and reserve margin requirements."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Region" ;
    cmm:cimDatatype "String" .
cmm:ResourceAdequacyAssessment.weatherScenario a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather scenario"@en ;
    rdfs:comment "Weather scenario or climate condition assumed in the resource adequacy assessment: normal (typical weather patterns), extreme_heat (high cooling demand), extreme_cold (high heating demand), drought (reduced hydro availability), high_wind (increased wind generation), low_wind (reduced wind generation). Critical for stress-testing capacity adequacy."@en ;
    rdfs:domain cmm:ResourceAdequacyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_scenario" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Scenario" ;
    cmm:validValues "normal|extreme_heat|extreme_cold|drought|high_wind|low_wind" ;
    cmm:cimDatatype "String" .

cmm:ScenarioFuelPrice a owl:Class ;
    rdfs:label "Scenario Fuel Price"@en ;
    rdfs:comment "This association product represents the assignment of fuel price assumptions to IRP scenarios with scenario-specific overrides and effective periods. It captures the operational practice of applying reusable fuel price assumption libraries across multiple planning scenarios while allowing scenario-specific adjustments. Each record links one fuel_price_assumption to one irp_scenario with effective dates, price overrides, escalation adjustments, and sensitivity flags that exist only in the context of this scenario-specific application.. Existence Justification: In utility IRP planning, fuel price assumptions are maintained as a reusable library that planners actively assign to multiple scenarios with scenario-specific overrides, effective periods, and sensitivity variants. A single fuel price assumption (e.g., 'EIA AEO 2024 Reference Case Natural Gas') is applied across multiple scenarios (Base, High Growth, Low Carbon), and each scenario uses multiple fuel price assumptions (natural gas, coal, uranium) with scenario-specific adjustments. The business explicitly manages these assignments as operational records, tracking which assumptions are active in which scenarios, with what overrides, and over what time periods."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:forecast , cmmsa:forecast.resource_planning ;
    cmm:physicalTable "utility_cmm_silver.forecast.scenario_fuel_price" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.forecast.scenario_fuel_price" ;
    owl:hasKey ( cmm:ScenarioFuelPrice.scenarioFuelPriceId ) .

cmm:ScenarioFuelPrice.scenarioFuelPriceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario fuel price id"@en ;
    rdfs:comment "Unique identifier for this scenario-specific fuel price assignment. Primary key."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:long ;
    cmm:physicalColumn "scenario_fuel_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Scenario Fuel Price Assignment ID" ;
    cmm:cimDatatype "Integer" .
cmm:ScenarioFuelPrice.fuelPriceAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel price assumption"@en ;
    rdfs:comment "Foreign key linking to the fuel price assumption record being applied to this scenario"@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range cmm:FuelPriceAssumption ;
    cmm:physicalColumn "fuel_price_assumption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scenario Fuel Price - Fuel Price Assumption Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_scenario_fuel_price_fuel_price_assumption_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ScenarioFuelPrice.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to the IRP scenario to which this fuel price assumption is applied"@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scenario Fuel Price - Irp Scenario Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_forecast_scenario_fuel_price_irp_scenario_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ScenarioFuelPrice.assignedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned by"@en ;
    rdfs:comment "Name or identifier of the planner or analyst who assigned this fuel price assumption to the scenario. Supports audit trail and accountability for scenario configuration."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:string ;
    cmm:physicalColumn "assigned_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assigned By" ;
    cmm:cimDatatype "String" .
cmm:ScenarioFuelPrice.assignedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned timestamp"@en ;
    rdfs:comment "Date and time when this fuel price assumption was assigned to the scenario. Supports audit trail and version control for scenario configuration."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "assigned_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ScenarioFuelPrice.assignmentNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment notes"@en ;
    rdfs:comment "Free-text notes explaining the rationale for this specific fuel price assignment or any scenario-specific adjustments made. Captures planning judgment and scenario design decisions."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ScenarioFuelPrice.assignmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment status"@en ;
    rdfs:comment "Lifecycle status of this fuel price assignment within the scenario. Tracks whether this assignment is currently active in scenario modeling or has been superseded by updated assumptions."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Status" ;
    cmm:cimDatatype "String" .
cmm:ScenarioFuelPrice.escalationRateOverridePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "escalation rate override percent"@en ;
    rdfs:comment "Scenario-specific override for the annual escalation rate, expressed as a percentage. Enables testing different fuel price escalation trajectories across scenarios while preserving the base assumption."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "escalation_rate_override_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Escalation Rate Override Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ScenarioFuelPrice.scenarioEffectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario effective end date"@en ;
    rdfs:comment "End date when this fuel price assumption ceases to be effective within the context of this specific scenario. Supports scenario-specific temporal application of fuel price libraries."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:date ;
    cmm:physicalColumn "scenario_effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scenario Effective End Date" ;
    cmm:cimDatatype "Date" .
cmm:ScenarioFuelPrice.scenarioEffectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario effective start date"@en ;
    rdfs:comment "Start date when this fuel price assumption becomes effective within the context of this specific scenario. Allows different scenarios to apply the same base assumption over different time periods."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:date ;
    cmm:physicalColumn "scenario_effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scenario Effective Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ScenarioFuelPrice.scenarioPriceOverride a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario price override"@en ;
    rdfs:comment "Scenario-specific override price that replaces the base fuel price assumption for this particular scenario. Allows planners to test scenario-specific fuel price variations without modifying the master assumption record."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "scenario_price_override" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scenario Price Override" ;
    cmm:cimDatatype "Decimal" .
cmm:ScenarioFuelPrice.sensitivityCaseFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sensitivity case flag"@en ;
    rdfs:comment "Boolean flag indicating whether this fuel price assignment represents a sensitivity case (high/low price variant) rather than the base case for the scenario. Supports sensitivity analysis and risk assessment."@en ;
    rdfs:domain cmm:ScenarioFuelPrice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sensitivity_case_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sensitivity Case Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:PlanningPeriod a owl:Class ;
    rdfs:label "Planning Period"@en ;
    rdfs:comment "Master reference table for planning_period. Referenced by planning_period_id."@en ;
