cmm:ClusterStudyGroup.networkUpgradesDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrades description"@en ;
    rdfs:comment "Detailed description of the network upgrades identified as necessary by the cluster study. Includes equipment additions, replacements, and system modifications required for safe interconnection."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
