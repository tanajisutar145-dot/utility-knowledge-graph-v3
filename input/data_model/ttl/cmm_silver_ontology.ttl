cmm:LaborCostAllocation a owl:Class ;
    rdfs:label "Labor Cost Allocation"@en ;
    rdfs:comment "Transactional records allocating employee and contractor labor costs to specific cost objects — work orders (asset maintenance, capital construction), outage restoration events, demand response program delivery, and overhead cost centers. Captures employee/contractor, hours, labor rate, total cost, cost object type, cost object reference, allocation date, and capitalization vs. O&M expense classification. Feeds SAP S/4HANA plant maintenance and project accounting for CAPEX/OPEX reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:LaborItem ;
    cmm:cimCloseMatch cim:LaborItem ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.cost_allocation ;
    cmm:physicalTable "utility_cmm_silver.workforce.labor_cost_allocation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-6; SAP S/4HANA CO-PA Cost Object Controlling; FERC USOA Labor Accounts" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.labor_cost_allocation" ;
    owl:hasKey ( cmm:LaborCostAllocation.laborCostAllocationId ) .

cmm:LaborCostAllocation.laborCostAllocationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor cost allocation id"@en ;
    rdfs:comment "Unique identifier for the labor cost allocation record. Primary key."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:long ;
    cmm:physicalColumn "labor_cost_allocation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Labor Cost Allocation ID" ;
    cmm:cimDatatype "Integer" .
cmm:LaborCostAllocation.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Identifier of the capital construction project to which labor cost is allocated. Null if allocated to a different cost object type."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_capital_project_id" ;
    cmm:cimAssociation "LaborItem.Project" .
cmm:LaborCostAllocation.contractorWorker a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor worker"@en ;
    rdfs:comment "Identifier of the contractor whose labor cost is being allocated. Null if the allocation is for an employee. References the contractor master."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:ContractorWorker ;
    cmm:physicalColumn "contractor_worker_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contractor ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_contractor_worker_id" ;
    cmm:cimAssociation "LaborItem.Person" .
cmm:LaborCostAllocation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Code of the overhead cost center to which labor cost is allocated. Null if allocated to a specific work order, project, or event."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_cost_center_id" ;
    cmm:cimAssociation "LaborItem.Organisation" .
cmm:LaborCostAllocation.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Identifier of the field crew or work team to which the employee or contractor was assigned during this allocation period."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_crew_id" ;
    cmm:cimAssociation "LaborItem.Crew" .
cmm:LaborCostAllocation.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the employee whose labor cost is being allocated. References the workforce employee master."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_employee_id" ;
    cmm:cimAssociation "LaborItem.ErpPersonnel" .
cmm:LaborCostAllocation.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Identifier of the outage restoration event to which labor cost is allocated. Null if allocated to a different cost object type."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_event_id" ;
    cmm:cimAssociation "LaborItem.Outage" .
cmm:LaborCostAllocation.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Identifier of the work order to which labor cost is allocated. Null if allocated to a different cost object type."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order (WO) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_labor_cost_allocation_work_order_id" ;
    cmm:cimAssociation "LaborItem.Work" .
cmm:LaborCostAllocation.activityType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "activity type"@en ;
    rdfs:comment "Type of work activity performed during the allocated labor hours. Used for labor productivity analysis and cost benchmarking. Reference-value candidates: maintenance|construction|inspection|emergency_restoration|meter_reading|vegetation_management|engineering|administrative|training|safety_compliance."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "activity_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Activity Type" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.allocationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation date"@en ;
    rdfs:comment "The date on which the labor cost allocation is recorded. Represents the business event date for the allocation."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "allocation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Date" ;
    cmm:cimDatatype "Date" .
cmm:LaborCostAllocation.allocationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation status"@en ;
    rdfs:comment "Current status of the labor cost allocation record in the workflow. Approved allocations are posted to SAP S/4HANA financial accounting."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Status" ;
    cmm:validValues "draft|approved|posted|reversed|disputed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:LaborItem.status .
cmm:LaborCostAllocation.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the labor cost allocation was approved by the supervisor or project manager. Null if not yet approved."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:LaborCostAllocation.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "User ID or name of the supervisor or manager who approved this labor cost allocation. Null if not yet approved."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.baseWageRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base wage rate"@en ;
    rdfs:comment "The base hourly wage rate for the employee or contractor, excluding benefits and burden. Expressed in USD per hour."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_wage_rate" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Wage Rate" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:LaborCostAllocation.burdenRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "burden rate"@en ;
    rdfs:comment "The hourly burden rate applied to this allocation, covering benefits, payroll taxes, insurance, and overhead. Expressed in USD per hour."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "burden_rate" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Burden Rate" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:LaborCostAllocation.businessUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business unit"@en ;
    rdfs:comment "Business unit or operating division responsible for this labor cost allocation (e.g., Transmission, Distribution, Generation)."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Unit" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.costElement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost element"@en ;
    rdfs:comment "SAP Controlling cost element code representing the type of labor cost (e.g., direct labor, indirect labor, contractor labor)."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_element" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Element" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.costObjectType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost object type"@en ;
    rdfs:comment "Type of cost object to which labor is allocated. Determines which cost object reference field is populated."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_object_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Object Type" ;
    cmm:validValues "work_order|capital_project|outage_event|cost_center|demand_response_program|overhead" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this labor cost allocation record was first created in the system."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:LaborItem.createdDateTime .
cmm:LaborCostAllocation.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the labor cost. Typically USD for US-based utilities."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:LaborCostAllocation.doubleTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "double time hours"@en ;
    rdfs:comment "Number of double-time hours worked for this allocation, typically at 2x regular rate per union agreements or emergency restoration work."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "double_time_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Double Time Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:LaborCostAllocation.expenseClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expense classification"@en ;
    rdfs:comment "Classification of the labor cost as Capital Expenditure (CAPEX) or Operational Expenditure (OPEX) for financial reporting and regulatory accounting."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "expense_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expense Classification" ;
    cmm:validValues "capex|opex" ;
    cmm:cimDatatype "String" .
cmm:LaborCostAllocation.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code to which this labor cost is posted for regulatory financial reporting."@en ;
    rdfs:domain cmm:LaborCostAllocation ; rdfs:range xsd:string ;
