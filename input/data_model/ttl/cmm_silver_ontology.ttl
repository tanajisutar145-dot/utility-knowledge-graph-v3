cmm:DerSystem.inverterManufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter manufacturer"@en ;
    rdfs:comment "Name of the company that manufactured the inverter equipment used in the DER system."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
