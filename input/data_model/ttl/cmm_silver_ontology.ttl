cmm:InspectionMilestone.contractorPresentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor present flag"@en ;
    rdfs:comment "Indicates whether the installation contractor or electrician was present during the inspection. True if present, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contractor_present_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
