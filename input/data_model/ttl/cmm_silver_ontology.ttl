    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:string ;
    cmm:physicalColumn "penalty_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ComplianceViolation.recordAuditCreated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record audit created"@en ;
    rdfs:comment "Timestamp when the violation record was first created in the system."@en ;
    rdfs:domain cmm:ComplianceViolation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_audit_created" ;
    cmm:sqlDataType "TIMESTAMP" ;
