    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ContractorWorker.workLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location code"@en ;
    rdfs:comment "Primary utility facility or service territory code where the contractor worker is assigned (e.g., generating station, substation, district office, or regional operations center)."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
