cmm:CreditMemo a owl:Class ;
    rdfs:label "Credit Memo"@en ;
    rdfs:comment "Master reference table for credit_memo. Referenced by credit_memo_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpReceivable ;
    cmm:cimCloseMatch cim:ErpReceivable ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.credit_memo" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10" ;
    cmm:sourceObject "energy_utilities_ecm.billing.credit_memo" ;
    owl:hasKey ( cmm:CreditMemo.creditMemoId ) .

cmm:CreditMemo.creditMemoId a owl:DatatypeProperty , owl:FunctionalProperty ;
