cmm:ContractorCompany.parentContractorCompany a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent contractor company"@en ;
    rdfs:comment "Self-referencing FK on contractor_company (parent_contractor_company_id)"@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range cmm:ContractorCompany ;
    cmm:physicalColumn "parent_contractor_company_id" ;
    cmm:sqlDataType "BIGINT" ;
