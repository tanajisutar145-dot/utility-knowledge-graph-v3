cmm:RateSchedule.netMeteringEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering eligible"@en ;
    rdfs:comment "Indicates whether customers on this rate schedule are eligible for net energy metering programs for distributed generation."@en ;
