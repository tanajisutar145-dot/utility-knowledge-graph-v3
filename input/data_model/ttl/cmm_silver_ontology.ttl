cmm:SafetyIncident.sapName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap name"@en ;
    rdfs:comment "Name of the Substance Abuse Professional assigned to the employee for evaluation and treatment. Confidential per DOT privacy requirements."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "sap_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SAP (Substance Abuse Professional) Name" ;
    cmm:sensitivity "confidential" ;
