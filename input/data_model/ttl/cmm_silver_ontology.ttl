cmm:BillingRun.billingPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing period end date"@en ;
    rdfs:comment "End date of the billing period covered by this run, defining the conclusion of the consumption or service period being invoiced."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:BillingRun.billingPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing period start date"@en ;
    rdfs:comment "Start date of the billing period covered by this run, defining the beginning of the consumption or service period being invoiced."@en ;
    rdfs:domain cmm:BillingRun ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Period Start Date" ;
