cmm:PowerPlant.renewableEnergyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable energy flag"@en ;
    rdfs:comment "Indicates whether the facility qualifies as a renewable energy resource under state Renewable Portfolio Standard (RPS) programs."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "renewable_energy_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PowerPlant.scadaSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada system code"@en ;
    rdfs:comment "Unique identifier for the plant in the SCADA or Energy Management System (EMS) used for real-time monitoring and control."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) System Identifier" ;
