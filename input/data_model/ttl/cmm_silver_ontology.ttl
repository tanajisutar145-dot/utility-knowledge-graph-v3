cmm:ComplianceException a owl:Class ;
    rdfs:label "Compliance Exception"@en ;
    rdfs:comment "Record of identified compliance exceptions, gaps, or near-misses discovered through internal monitoring, control testing, or operational review before they become formal violations or enforcement actions. Captures exception type, associated obligation or standard, discovery date, discovery method (internal audit, self-monitoring, employee report), risk severity, business unit responsible, and remediation action taken. Supports a proactive compliance culture and feeds the self-report workflow when escalation is warranted."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.exception" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC CMEP Self-Monitoring; SOX Deficiency Tracking; EPA Compliance Monitoring" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.exception" ;
    owl:hasKey ( cmm:ComplianceException.exceptionId ) .

cmm:ComplianceException.exceptionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception id"@en ;
    rdfs:comment "Primary key for exception"@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:long ;
    cmm:physicalColumn "exception_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Exception Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ComplianceException.correctiveActionPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Foreign key reference to the formal corrective action plan (CAP) created to address this exception, if one was required."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "corrective_action_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Corrective Action Plan Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_exception_corrective_action_plan_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ComplianceException.exceptionObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "exception obligation"@en ;
    rdfs:comment "Foreign key reference to the specific compliance obligation or regulatory standard associated with this exception."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "exception_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Obligation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_exception_exception_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ComplianceException.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "FK to compliance.obligation.obligation_id — Compliance exceptions are identified against specific obligations. This FK enables obligation-level exception tracking and feeds the self-report workflow."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_exception_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ComplianceException.previousException a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "previous exception"@en ;
    rdfs:comment "Foreign key reference to the prior exception record if this is a recurrence, enabling trend analysis and repeat-issue tracking."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range cmm:ComplianceException ;
    cmm:physicalColumn "previous_exception_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Previous Exception Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_exception_previous_exception_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ComplianceException.responsibleOwnerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible owner employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Compliance exceptions require employee ownership for remediation accountability. Replaces text field with FK to enable exception workload tracking, escalation paths, and performance management for com"@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "responsible_owner_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Owner Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_exception_responsible_owner_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:ComplianceException.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this exception record is currently active and open, or has been archived or closed."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ComplianceException.boardNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board notification date"@en ;
    rdfs:comment "Date on which the Board of Directors or executive leadership was notified of the exception, if applicable."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_notification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Notification Date" ;
    cmm:cimDatatype "Date" .
cmm:ComplianceException.boardReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board reporting flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this exception is material enough to require reporting to the Board of Directors or executive leadership."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "board_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ComplianceException.closureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure date"@en ;
    rdfs:comment "Date on which the exception was formally closed after successful remediation and verification."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:date ;
    cmm:physicalColumn "closure_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closure Date" ;
    cmm:cimDatatype "Date" .
cmm:ComplianceException.closureNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure notes"@en ;
    rdfs:comment "Additional notes or comments documenting the closure rationale, lessons learned, or any residual considerations."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:string ;
    cmm:physicalColumn "closure_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Closure Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ComplianceException.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp indicating when this exception record was first created in the system."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:ComplianceException.discoveryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discovery date"@en ;
    rdfs:comment "Date on which the compliance exception was identified or discovered through monitoring, audit, or operational review."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:date ;
    cmm:physicalColumn "discovery_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Discovery Date" ;
    cmm:cimDatatype "Date" .
cmm:ComplianceException.discoveryMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discovery method"@en ;
    rdfs:comment "Method or process by which the exception was discovered: internal audit, self-monitoring, control testing, employee report, management review, external audit, system alert, or operational review. Reference-value candidates: internal_audit|self_monitoring|control_testing|employee_report|management_review|external_audit|system_alert|operational_review."@en ;
    rdfs:domain cmm:ComplianceException ; rdfs:range xsd:string ;
    cmm:physicalColumn "discovery_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
