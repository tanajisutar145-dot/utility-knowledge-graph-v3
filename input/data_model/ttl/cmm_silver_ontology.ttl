cmm:FuelPriceAssumption.sensitivityLowPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sensitivity low price"@en ;
    rdfs:comment "Lower bound fuel price for sensitivity analysis and risk assessment. Represents pessimistic or low-price scenario for stress testing generation economics and resource selection."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "sensitivity_low_price" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
