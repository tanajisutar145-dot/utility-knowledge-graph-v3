cmm:OrgUnit.workScheduleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work schedule type"@en ;
    rdfs:comment "Standard work schedule type for the organizational unit (e.g., standard business hours, shift work, rotating shifts, on-call, flexible, 24x7 operations)."@en ;
