cmm:DrAggregator.settlementFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement frequency"@en ;
    rdfs:comment "Frequency at which demand response performance settlements and incentive payments are calculated and paid to the aggregator."@en ;
