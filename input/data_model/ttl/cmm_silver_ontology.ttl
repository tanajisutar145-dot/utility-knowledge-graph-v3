    cmm:cimDatatype "String" .
cmm:CostCenter.functionalAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area code"@en ;
    rdfs:comment "Functional area classification for cost-of-service studies and regulatory reporting. Aligns with FERC functional classifications (Production, Transmission, Distribution, Customer Service, Administrative & General)."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.hierarchyAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy area code"@en ;
    rdfs:comment "Standard hierarchy area for organizational reporting. Defines the cost center hierarchy structure for management reporting and cost rollups."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "hierarchy_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
