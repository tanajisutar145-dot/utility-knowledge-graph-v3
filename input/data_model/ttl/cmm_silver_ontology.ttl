cmm:EmissionsReport.emissionRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emission rate"@en ;
    rdfs:comment "The calculated emission rate for the pollutant, typically expressed as pounds per MMBtu or tons per MWh, depending on the regulatory program."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:decimal ;
