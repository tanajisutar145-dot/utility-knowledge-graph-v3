    cmm:validValues "compliant|minor_violation|major_violation|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this permit record was last modified. Tracks changes to permit status, conditions, or administrative data for compliance audit purposes."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
