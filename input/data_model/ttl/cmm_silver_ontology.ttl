    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_sox_control_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:TaxProvision.taxJournalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tax journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Tax provisions generate journal entries for current and deferred tax expense postings. Required for tax close process and FERC Form 1 tax schedules."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "tax_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "journal_entry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_tax_journal_entry_id" ;
    cmm:cimAssociation "Document.ErpJournal" .
cmm:TaxProvision.toJournalEntry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to journal entry"@en ;
    rdfs:comment "FK to finance.journal_entry.journal_entry_id — Tax provisions are posted as journal entries for current tax expense, deferred tax movements, and ADIT adjustments. This FK enables tax-to-GL reconciliation and FERC Form 1 tax schedule preparation."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range cmm:JournalEntry ;
    cmm:physicalColumn "to_journal_entry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_tax_provision_to_journal_entry_id" ;
    cmm:cimAssociation "Document.ErpJournal" .
cmm:TaxProvision.aditBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adit balance"@en ;
    rdfs:comment "The net accumulated deferred income tax balance (DTL minus DTA) used in regulatory rate base calculations per FERC requirements."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adit_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Deferred Income Tax (ADIT) Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TaxProvision.aditMovement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adit movement"@en ;
    rdfs:comment "The change in ADIT balance during the fiscal period, critical for regulatory asset base (RAB) adjustments and rate case filings."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adit_movement" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Deferred Income Tax (ADIT) Movement" ;
    cmm:cimDatatype "Decimal" .
cmm:TaxProvision.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which this tax provision record was formally approved by the reviewer."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:TaxProvision.auditStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit status"@en ;
    rdfs:comment "The current status of external audit review for this tax provision record."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:string ;
    cmm:physicalColumn "audit_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Audit Status" ;
    cmm:validValues "not_audited|in_progress|completed|accepted|disputed" ;
    cmm:cimDatatype "String" .
cmm:TaxProvision.auditorNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auditor notes"@en ;
    rdfs:comment "Notes or comments from external auditors regarding this tax provision record, including any adjustments or findings."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:string ;
    cmm:physicalColumn "auditor_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Auditor Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:TaxProvision.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this tax provision record was first created in the system."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
