    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Network Segments" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.applicableTariffReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable tariff reference"@en ;
    rdfs:comment "Reference to the utility tariff or interconnection procedures document governing the cluster study process. Identifies the regulatory framework and rules applied."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_tariff_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Tariff Reference" ;
