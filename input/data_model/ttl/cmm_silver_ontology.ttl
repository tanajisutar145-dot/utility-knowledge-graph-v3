cmm:RateSchedule.rateClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate class"@en ;
    rdfs:comment "Customer class or segment to which this rate schedule applies. Defines the primary customer category for rate applicability."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|municipal|street_lighting" ;
    cmm:cimDatatype "String" .
cmm:RateSchedule.rateCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate code"@en ;
    rdfs:comment "Business identifier for the rate schedule used in billing systems and customer communications. Externally-known unique code for this tariff rate schedule."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
