cmm:NemCredit.creditStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit status"@en ;
    rdfs:comment "Current lifecycle status of the NEM credit transaction in the billing and accounts receivable system."@en ;
