cmm:DrIncentivePayment.actualLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual load kw"@en ;
    rdfs:comment "The measured actual load in kilowatts during the demand response event. Used to calculate curtailment performance."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_load_kw" ;
