cmm:TaxProvision.deferredTaxLiability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deferred tax liability"@en ;
    rdfs:comment "The cumulative balance of deferred tax liabilities arising from temporary differences that will result in future tax payments."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deferred_tax_liability" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
