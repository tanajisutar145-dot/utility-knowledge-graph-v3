cmm:RateSchedule.maximumUsageKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum usage kwh"@en ;
    rdfs:comment "Maximum monthly energy usage in kilowatt-hours for customer eligibility. Null if no maximum applies."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_usage_kwh" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
