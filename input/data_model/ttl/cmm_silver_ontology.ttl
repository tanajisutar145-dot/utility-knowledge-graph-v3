    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:DrIncentivePayment.curtailmentDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailment duration minutes"@en ;
