    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Transaction.status .
cmm:NemCredit.creditTransactionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit transaction number"@en ;
