    cmm:fkConstraint "fk_asset_inspection_inspection_employee_id" ;
    cmm:cimAssociation "InspectionDataSet.ErpPersonnel" .
cmm:AssetInspection.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Identifier of the utility asset being inspected (generation unit, transmission tower, distribution pole, transformer, switchgear, protection relay, substation equipment, fleet vehicle, or facility)."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
