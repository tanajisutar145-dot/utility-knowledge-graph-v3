cmm:JobRequisition.requisitionClosedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition closed date"@en ;
    rdfs:comment "Date when the requisition was closed (filled, cancelled, or withdrawn). Used to calculate time-to-fill metrics."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:date ;
    cmm:physicalColumn "requisition_closed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
