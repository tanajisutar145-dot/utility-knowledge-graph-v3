    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Correspondence Direction Type" ;
    cmm:validValues "inbound|outbound" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:RegulatoryCorrespondence.correspondenceWithAgency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "correspondence with agency"@en ;
    rdfs:comment "FK to compliance.regulatory_agency.regulatory_agency_id — All regulatory correspondence is exchanged with a specific agency. Essential FK for correspondence management."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:long ;
