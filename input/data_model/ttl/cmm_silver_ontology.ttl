cmm:DunningSchedule.maxAttempts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "max attempts"@en ;
    rdfs:comment "Maximum number of times this dunning step may be repeated before moving to the next level."@en ;
    rdfs:domain cmm:DunningSchedule ; rdfs:range xsd:int ;
