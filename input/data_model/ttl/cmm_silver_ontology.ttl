cmm:EnforcementAction.recordSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record source system"@en ;
    rdfs:comment "Name or code of the source system from which this enforcement action record originated (e.g., Compliance Management System, Legal Case Management System)."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
