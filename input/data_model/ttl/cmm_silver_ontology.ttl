cmm:SelfReport.violationSeverityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation severity level"@en ;
    rdfs:comment "Assessment of the severity of the alleged violation based on regulatory severity level definitions, particularly for NERC standards."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_severity_level" ;
    cmm:sqlDataType "STRING" ;
