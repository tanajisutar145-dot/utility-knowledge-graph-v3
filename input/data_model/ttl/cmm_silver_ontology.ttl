cmm:TaxProvision.effectiveTaxRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective tax rate"@en ;
    rdfs:comment "The actual tax rate after adjustments for permanent differences, credits, and other items, expressed as a decimal. Key metric for FERC Form 1 and rate case filings."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "effective_tax_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Effective Tax Rate (ETR)" ;
