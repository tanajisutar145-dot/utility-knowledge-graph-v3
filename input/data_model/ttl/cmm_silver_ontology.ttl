cmm:EmergencyStockEvent.declaredEmergencyTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "declared emergency timestamp"@en ;
    rdfs:comment "Precise timestamp when the emergency was declared, critical for SAIDI/SAIFI restoration performance tracking and regulatory reporting."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "declared_emergency_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Declared Emergency Timestamp" ;
