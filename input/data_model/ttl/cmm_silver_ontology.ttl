cmm:ClusterStudyGroup.loadFlowAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load flow analysis performed flag"@en ;
    rdfs:comment "Indicates whether load flow analysis was performed as part of the cluster study. True if steady-state power flow and voltage profile were evaluated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "load_flow_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Flow Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ClusterStudyGroup.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when the cluster study group record was last modified. Audit trail for data lineage and change tracking."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ClusterStudyGroup.networkUpgradeCostEstimateAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrade cost estimate amount"@en ;
    rdfs:comment "Total estimated cost for all network upgrades identified in the cluster study. Represents the capital investment required to enable interconnection of the cluster group capacity."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "network_upgrade_cost_estimate_amount" ;
