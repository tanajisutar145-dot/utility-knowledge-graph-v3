cmm:CostCenter.departmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "department code"@en ;
    rdfs:comment "Department or organizational unit code to which this cost center belongs. Used for organizational reporting and workforce management."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "department_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
