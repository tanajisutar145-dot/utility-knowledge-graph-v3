cmm:ContractorCompany.bankRoutingNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank routing number"@en ;
    rdfs:comment "Routing number (or equivalent) for the contractor's bank."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_routing_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ContractorCompany.bondAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bond amount"@en ;
    rdfs:comment "Monetary value of the performance bond issued for the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bond_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
