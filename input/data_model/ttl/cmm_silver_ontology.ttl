cmm:DrIncentivePayment.aggregatorSharePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator share percentage"@en ;
    rdfs:comment "Percentage of the gross payment retained by the aggregator as commission for program management and customer enrollment services."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "aggregator_share_percentage" ;
