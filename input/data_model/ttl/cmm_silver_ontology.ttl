cmm:EmergencyStockEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the emergency event that triggered material procurement or stock deployment."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
