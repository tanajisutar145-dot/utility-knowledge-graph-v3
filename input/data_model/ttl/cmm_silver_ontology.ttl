    cmm:physicalColumn "inverter_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inverter Type" ;
    cmm:validValues "string|micro|central|hybrid" ;
    cmm:cimDatatype "String" .
cmm:DerSystem.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this DER system record was last modified or updated."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DerSystem.nameplateCapacityKwAc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity kw ac"@en ;
    rdfs:comment "Maximum continuous AC power output rating of the DER system in kilowatts as measured at the point of interconnection."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_kw_ac" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
