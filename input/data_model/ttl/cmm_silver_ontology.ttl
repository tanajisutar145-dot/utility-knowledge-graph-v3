    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Primary Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:LocationAssignment.effectiveStartTs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start ts"@en ;
    rdfs:comment "Start of validity of the assignment."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "effective_start_ts" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "close" ;
