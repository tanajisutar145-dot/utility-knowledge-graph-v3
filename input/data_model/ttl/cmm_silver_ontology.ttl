cmm:TaxProvision.excessAditAmortization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "excess adit amortization"@en ;
    rdfs:comment "The amount of excess ADIT amortized during the fiscal period per average rate assumption method (ARAM) or other IRS-approved method."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "excess_adit_amortization" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
