cmm:SelfReport.reportNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report number"@en ;
    rdfs:comment "Externally-known unique reference number assigned to this self-report submission, typically following format SPV-YYYY-NNNNNN for tracking and regulatory correspondence."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "report_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Self-Report Reference Number" ;
    cmm:valuePattern "^SPV-[0-9]{4}-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:SelfReport.reportStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report status"@en ;
    rdfs:comment "Current lifecycle status of the self-report in the regulatory review and resolution process."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "report_status" ;
    cmm:sqlDataType "STRING" ;
