cmm:ProtectionEvent a owl:Class ;
    rdfs:label "Protection Event"@en ;
    rdfs:comment "Transactional record of protection system operations (relay trips, recloser operations, breaker failure initiations) detected on the transmission and distribution network. Captures event timestamp, protection device reference, relay type (distance, overcurrent, differential, pilot), trip zone, fault type (single-line-to-ground, phase-to-phase, three-phase), fault current magnitude (amps), fault location (miles from terminal), clearing time (cycles), reclose attempt status, and associated NERC PRC standard applicability. SSOT for protection system event records used in NERC PRC-004 relay misoperation analysis, post-fault review, and protection coordination studies."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.protection_event" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC PRC-004" ;
    cmm:sourceObject "energy_utilities_ecm.grid.protection_event" ;
    owl:hasKey ( cmm:ProtectionEvent.protectionEventId ) .

cmm:ProtectionEvent.protectionEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection event id"@en ;
    rdfs:comment "Unique identifier for the protection system event record. Primary key for the protection event entity."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "protection_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Protection Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:ProtectionEvent.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: Protection system misoperations are auditable findings under NERC PRC-004. When auditors identify a misoperation during compliance reviews, the finding must link to the specific protection event for e"@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_audit_finding_id" ;
    cmm:cimAssociation "PSREvent.Document" .
cmm:ProtectionEvent.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Reference to the balancing authority control area responsible for the electrical system where the event occurred."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_control_area_id" ;
    cmm:cimAssociation "PSREvent.ControlArea" .
cmm:ProtectionEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the substation where the protection event occurred. Links to the physical location of the protection system."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_distribution_substation_id" ;
    cmm:cimAssociation "PSREvent.Substation" .
cmm:ProtectionEvent.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Protection relay trips causing equipment damage (fault current, breaker failure) trigger emergency material deployment for restoration. Links protection event to emergency procurement, mutual aid requ"@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_emergency_stock_event_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:ProtectionEvent.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the control room operator who acknowledged or responded to the protection event."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_employee_id" ;
    cmm:cimAssociation "PSREvent.ErpPersonnel" .
cmm:ProtectionEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Reference to the EMS alarm record generated by this protection event, linking to operator notification and acknowledgment workflow."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Alarm ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_ems_alarm_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:ProtectionEvent.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — Protection system operations occur at specific locations in the network model. Linking to EMS node enables correlation with state estimation results and contingency analysis for post-fault review."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_ems_node_id" ;
    cmm:cimAssociation "PSREvent.TopologicalNode" .
cmm:ProtectionEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Protection relay operations cause customer outages. Essential for root cause analysis, misoperation investigation, NERC PRC-004 compliance reporting, and correlating transmission events with distribut"@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:ProtectionEvent.protectionDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "protection device"@en ;
    rdfs:comment "Reference to the protection device (relay, recloser, breaker) that detected and initiated the protection operation."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:ProtectionDevice ;
    cmm:physicalColumn "protection_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Protection Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_protection_device_id" ;
    cmm:cimAssociation "PSREvent.ProtectionEquipment" .
cmm:ProtectionEvent.protectionScadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "protection scada point"@en ;
    rdfs:comment "Reference to the SCADA telemetry point that captured the protection event data from the relay or RTU."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "protection_scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "SCADA Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_protection_scada_point_id" ;
    cmm:cimAssociation "PSREvent.Measurement" .
cmm:ProtectionEvent.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Protection relay operations are tied to specific relay assets. NERC PRC-004 misoperation investigations require linking events to asset maintenance records, inspection history, and firmware versions."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_registry_id" ;
    cmm:cimAssociation "PSREvent.Asset" .
cmm:ProtectionEvent.safetyIncident a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident"@en ;
    rdfs:comment "Foreign key linking to workforce.safety_incident. Business justification: Protection events (relay trips, breaker failures) can cause or result from safety incidents. Linking enables equipment failure vs. human error root cause analysis for NERC PRC compliance."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:SafetyIncident ;
    cmm:physicalColumn "safety_incident_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Safety Incident Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_safety_incident_id" ;
    cmm:cimAssociation "PSREvent.Incident" .
cmm:ProtectionEvent.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "FK to grid.scada_point.scada_point_id — Protection relay operations are detected via SCADA status points. Linking protection events to their associated SCADA points enables correlation with telemetry data for fault analysis."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_scada_point_id" ;
    cmm:cimAssociation "PSREvent.Measurement" .
cmm:ProtectionEvent.initiatingProtectionEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "initiating protection event"@en ;
    rdfs:comment "Self-referencing FK on protection_event (initiating_protection_event_id)"@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range cmm:ProtectionEvent ;
    cmm:physicalColumn "initiating_protection_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_protection_event_initiating_protection_event_id" ;
    cmm:cimAssociation "PSREvent.PSREvent" .
cmm:ProtectionEvent.balancingAuthorityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority code"@en ;
    rdfs:comment "NERC-registered balancing authority code responsible for the area where the protection event occurred."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority Code" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.breakerOperationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "breaker operation status"@en ;
    rdfs:comment "Outcome of the circuit breaker operation command issued by the protection relay, indicating whether the breaker successfully interrupted the fault."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "breaker_operation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Circuit Breaker Operation Status" ;
    cmm:validValues "successful_trip|failed_to_trip|breaker_failure|trip_coil_supervision_alarm|slow_trip|partial_trip" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.clearingTimeCycles a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing time cycles"@en ;
    rdfs:comment "Time elapsed from fault initiation to circuit breaker interruption, measured in power system cycles (60 Hz = 16.67 ms per cycle). Critical for coordination studies."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "clearing_time_cycles" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Clearing Time (Cycles)" ;
    cmm:cimDatatype "Decimal" .
cmm:ProtectionEvent.correctiveActionDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action description"@en ;
    rdfs:comment "Detailed description of the corrective actions taken or planned to prevent recurrence of similar protection events."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Description" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.correctiveActionRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action required flag"@en ;
    rdfs:comment "Indicates whether corrective actions (relay setting changes, equipment repairs, vegetation clearance) are required based on investigation findings."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "corrective_action_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this protection event record was first created in the data system."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PSREvent.createdDateTime .
cmm:ProtectionEvent.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Estimated number of customer accounts that experienced a service interruption as a result of this protection event."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:ProtectionEvent.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that provided the protection event data (e.g., GE PowerOn ADMS, SEL relay, ABB MicroSCADA, OSIsoft PI)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.disturbanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance flag"@en ;
    rdfs:comment "Indicates whether this protection event was part of a larger system disturbance involving multiple facilities or widespread impact."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disturbance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Disturbance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.eventTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event timestamp"@en ;
    rdfs:comment "Precise date and time when the protection system operation was initiated, typically synchronized to GPS time for accurate sequence-of-events analysis."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Event Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ProtectionEvent.faultCurrentMagnitudeAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault current magnitude amps"@en ;
    rdfs:comment "Peak magnitude of the fault current measured by the protection relay at the time of the event, expressed in amperes."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_current_magnitude_amps" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Current Magnitude (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:ProtectionEvent.faultLocationMiles a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault location miles"@en ;
    rdfs:comment "Estimated distance from the relay terminal to the fault location, measured in miles along the protected line or feeder."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_location_miles" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location (Miles)" ;
    cmm:unitSymbol "mi" ;
    cmm:cimDatatype "Length" .
cmm:ProtectionEvent.faultType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault type"@en ;
    rdfs:comment "Classification of the electrical fault that triggered the protection operation, indicating the phases involved and whether ground was involved. Reference-value candidates: single_line_to_ground|line_to_line|double_line_to_ground|three_phase|phase_to_phase|phase_a_to_ground|phase_b_to_ground|phase_c_to_ground|phase_ab|phase_bc|phase_ca."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Type" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.initiatingCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating cause"@en ;
    rdfs:comment "Root cause or trigger for the protection operation (e.g., lightning strike, equipment failure, vegetation contact, animal contact, insulator flashover, human error)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Event Initiating Cause" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.initiatingCauseCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "initiating cause category"@en ;
    rdfs:comment "High-level classification of the root cause for analytics and trending purposes. Reference-value candidates: weather|equipment_failure|vegetation|animal|human_error|unknown|planned_operation."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "initiating_cause_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Initiating Cause Category" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.investigationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation required flag"@en ;
    rdfs:comment "Indicates whether this protection event requires formal engineering investigation per utility protection system review procedures or NERC PRC-004 requirements."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "investigation_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigation Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.investigationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation status"@en ;
    rdfs:comment "Current status of the protection event investigation workflow, tracking progress from initiation to closure."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "investigation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigation Status" ;
    cmm:validValues "not_required|pending|in_progress|completed|closed" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Date and time when this protection event record was most recently modified, tracking investigation updates and status changes."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ProtectionEvent.loadInterruptedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load interrupted mw"@en ;
    rdfs:comment "Amount of electrical load that was interrupted by the protection operation, measured in megawatts (MW)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_interrupted_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Interrupted (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ProtectionEvent.misoperationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "misoperation flag"@en ;
    rdfs:comment "Indicates whether the protection operation has been classified as a misoperation per NERC PRC-004 criteria (failure to operate, slow operation, or unnecessary operation)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "misoperation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection System Misoperation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.misoperationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "misoperation type"@en ;
    rdfs:comment "Classification of the misoperation if the misoperation flag is true, per NERC PRC-004 definitions."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "misoperation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection System Misoperation Type" ;
    cmm:validValues "not_applicable|failure_to_operate|slow_operation|unnecessary_operation|correct_operation" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.nercPrcStandardApplicability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc prc standard applicability"@en ;
    rdfs:comment "Identifies which NERC Protection and Control (PRC) reliability standards apply to this event (e.g., PRC-004, PRC-005, PRC-023, PRC-025)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_prc_standard_applicability" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC PRC Standard Applicability" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "North American Electric Reliability Corporation regional entity with jurisdiction over the location of the event. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|TRE|SPP."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Region" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this protection event meets NERC criteria for mandatory reporting to the Electric Reliability Organization (ERO)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional context, operator observations, or engineering comments related to the protection event."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Protection Event Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ProtectionEvent.operatorAcknowledgedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator acknowledged flag"@en ;
    rdfs:comment "Indicates whether a control room operator has reviewed and acknowledged the protection event in the EMS or SCADA system."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_acknowledged_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Acknowledged Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ProtectionEvent.operatorAcknowledgmentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator acknowledgment timestamp"@en ;
    rdfs:comment "Date and time when the control room operator acknowledged the protection event alarm."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "operator_acknowledgment_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Acknowledgment Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ProtectionEvent.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Total duration of the customer outage from protection event initiation to full service restoration, measured in minutes."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ProtectionEvent.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name used to archive time-series data associated with this protection event for long-term analytics and post-event review."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Name" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.protectedElementName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protected element name"@en ;
    rdfs:comment "Business name or identifier of the specific electrical equipment that was protected (e.g., line name, feeder ID, transformer designation)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "protected_element_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protected Element Name" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.protectedElementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protected element type"@en ;
    rdfs:comment "Classification of the electrical equipment protected by the relay that operated (transmission line, distribution feeder, transformer, generator, etc.). Reference-value candidates: transmission_line|distribution_feeder|transformer|generator|bus|capacitor_bank|reactor|cable."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "protected_element_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protected Element Type" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.recloseAttemptStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reclose attempt status"@en ;
    rdfs:comment "Status of the automatic reclosing sequence following the initial trip, indicating whether the line was successfully re-energized or locked out."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "reclose_attempt_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Reclose Attempt Status" ;
    cmm:validValues "not_applicable|reclose_successful|reclose_failed|lockout|reclose_in_progress|reclose_blocked" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.recloseShotNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reclose shot number"@en ;
    rdfs:comment "Sequential number of the reclosing attempt (1 for first shot, 2 for second shot, etc.). Null if no reclose was attempted."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "reclose_shot_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reclose Shot Number" ;
    cmm:cimDatatype "Integer" .
cmm:ProtectionEvent.relayFunctionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relay function code"@en ;
    rdfs:comment "IEEE device function number identifying the specific protection function that operated (e.g., 21 for distance, 50 for instantaneous overcurrent, 51 for time overcurrent, 87 for differential)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "relay_function_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relay Function Code" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.relayType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relay type"@en ;
    rdfs:comment "Classification of the protection relay that operated, indicating the protection principle used (distance, overcurrent, differential, pilot scheme, etc.). Reference-value candidates: distance|overcurrent|differential|pilot|ground_fault|directional|voltage|frequency|transformer|generator|motor|bus|breaker_failure."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "relay_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relay Type" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.restorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration timestamp"@en ;
    rdfs:comment "Date and time when electrical service was fully restored following the protection event. Null if restoration is still in progress."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ProtectionEvent.tripZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trip zone"@en ;
    rdfs:comment "The protection zone or stage that initiated the trip (e.g., Zone 1, Zone 2, Zone 3 for distance relays; instantaneous, time-delayed for overcurrent relays)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "trip_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Trip Zone" ;
    cmm:cimDatatype "String" .
cmm:ProtectionEvent.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level of the protected equipment where the event occurred, expressed in kilovolts (kV)."@en ;
    rdfs:domain cmm:ProtectionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (Kilovolts)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:ContingencyElement a owl:Class ;
    rdfs:label "Contingency Element"@en ;
    rdfs:comment "This association product represents the participation of specific transmission and generation assets in NERC-mandated contingency analysis scenarios. It captures the element-specific attributes that exist only in the context of a contingency case definition, including removal sequence, pre/post-contingency loading conditions, and criticality ranking. Each record links one contingency scenario to one physical asset that is removed or affected in that scenario, supporting NERC TPL compliance evidence and EMS contingency analysis execution.. Existence Justification: In utility grid operations, contingency analysis scenarios (N-1, N-2) are defined by specifying which physical assets (transmission lines, generators, transformers) are removed from service and in what sequence. A single contingency case removes multiple assets (e.g., N-2 removes two elements), and each physical asset participates in multiple contingency definitions across different scenarios. Grid operators actively manage these contingency-asset associations as part of NERC TPL compliance, updating element sequences, criticality rankings, and monitoring thresholds based on seasonal conditions and system topology changes."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ContingencyEquipment ;
    cmm:cimExactMatch cim:ContingencyEquipment ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Contingency" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.contingency_element" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.grid.contingency_element" ;
    owl:hasKey ( cmm:ContingencyElement.contingencyElementId ) .

cmm:ContingencyElement.contingencyElementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency element id"@en ;
    rdfs:comment "Unique identifier for this contingency-asset association record. Primary key for the contingency_element association."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:long ;
    cmm:physicalColumn "contingency_element_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contingency Element ID" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyElement.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to the contingency case definition in the EMS contingency analysis catalog"@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Element - Contingency Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_element_contingency_id" ;
    cmm:cimAssociation "ContingencyEquipment.Contingency" .
cmm:ContingencyElement.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the physical asset (transmission line, generator, transformer) that is removed or affected in this contingency scenario"@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Element - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_element_registry_id" ;
    cmm:cimAssociation "ContingencyEquipment.Asset" .
cmm:ContingencyElement.correctiveActionRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action required flag"@en ;
    rdfs:comment "Boolean flag indicating whether operator intervention or remedial action scheme (RAS) activation is required for this asset in this contingency scenario to maintain system reliability."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "corrective_action_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ContingencyElement.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "Username or identifier of the grid operations engineer or system administrator who created this contingency element association. Used for accountability and audit purposes."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Created By User" ;
    cmm:cimDatatype "String" .
cmm:ContingencyElement.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this contingency-asset association was first created in the EMS contingency catalog. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ContingencyEquipment.createdDateTime .
cmm:ContingencyElement.criticalityRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rank"@en ;
    rdfs:comment "Numerical ranking (1 = most critical) of this asset's importance within this specific contingency scenario based on its impact to system stability, voltage profile, and thermal limits. Rank is contingency-specific, not a global asset criticality score."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:int ;
    cmm:physicalColumn "criticality_rank" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Criticality Rank" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyElement.elementRemovalOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element removal order"@en ;
    rdfs:comment "Classification of the removal order for this element in the contingency: PRIMARY (first element removed in N-1), SECONDARY (second element in N-2), TERTIARY (third element in N-3), or SIMULTANEOUS (removed at same time as other elements). Used for NERC category classification."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_removal_order" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Removal Order Classification" ;
    cmm:cimDatatype "String" .
cmm:ContingencyElement.elementRoleInContingency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element role in contingency"@en ;
    rdfs:comment "Role of this asset in the contingency analysis: OUTAGED_ELEMENT (asset is removed), MONITORED_ELEMENT (asset is monitored for violations but not removed), AFFECTED_ELEMENT (asset experiences loading or voltage changes due to outage of other elements)."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_role_in_contingency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Role in Contingency" ;
    cmm:cimDatatype "String" .
cmm:ContingencyElement.elementSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element sequence"@en ;
    rdfs:comment "Sequential order in which this asset is removed in the contingency scenario. Critical for N-2 and cascading outage analysis where removal order affects system response. Value 1 indicates primary element, 2 indicates secondary element in multi-element contingencies."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:int ;
    cmm:physicalColumn "element_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Removal Sequence" ;
    cmm:cimDatatype "Integer" .
cmm:ContingencyElement.lastAnalysisTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last analysis timestamp"@en ;
    rdfs:comment "Timestamp of the most recent EMS contingency analysis execution that evaluated this specific asset in this contingency scenario. Used for data freshness validation and audit trail."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_analysis_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Analysis Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ContingencyElement.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "Username or identifier of the user who most recently modified this contingency element association. Used for accountability and audit trail."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:ContingencyElement.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to this contingency element record (sequence change, status update, criticality re-ranking). Used for change tracking and data lineage."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ContingencyElement.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current lifecycle status of this asset's participation in this contingency definition: ACTIVE (included in analysis), INACTIVE (temporarily excluded), EXCLUDED (permanently removed from scenario), UNDER_REVIEW (pending engineering validation)."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contingency Element Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ContingencyEquipment.status .
cmm:ContingencyElement.postContingencyLoadingPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post contingency loading percent"@en ;
    rdfs:comment "Loading level of this specific asset (if not removed) or affected neighboring assets as a percentage of rated capacity after the contingency event. Used to identify thermal overload violations and system stress points."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_contingency_loading_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Contingency Loading Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ContingencyElement.preContingencyLoadingPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre contingency loading percent"@en ;
    rdfs:comment "Loading level of this specific asset as a percentage of its rated capacity immediately before the contingency event, based on the base case state estimation. Used to assess whether the asset was already stressed before removal."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_contingency_loading_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Contingency Loading Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ContingencyElement.violationDetectedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation detected flag"@en ;
    rdfs:comment "Boolean flag indicating whether this specific asset experienced a thermal overload or voltage violation in the most recent contingency analysis run. Used for targeted corrective action planning."@en ;
    rdfs:domain cmm:ContingencyElement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "violation_detected_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Detected Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:ControlAreaObligation a owl:Class ;
    rdfs:label "Control Area Obligation"@en ;
    rdfs:comment "This association product represents the applicability and compliance tracking relationship between a balancing authority control area and a specific regulatory obligation. It captures which NERC reliability standards, FERC requirements, and other regulatory obligations apply to each control area, along with the compliance status, assessment history, and evidence location for that specific control area-obligation pair. Each record links one control area to one obligation with attributes that exist only in the context of this applicability determination and compliance tracking relationship.. Existence Justification: In energy utility operations, each balancing authority control area must comply with multiple NERC reliability standards (BAL-001 through BAL-006 for balancing, TOP standards for transmission operations, IRO standards for reliability coordination, MOD standards for modeling), FERC regulations, and state PUC requirements. Conversely, each regulatory obligation applies to multiple control areas across the utility's operational footprint. The business actively manages this relationship through compliance tracking workflows, audit preparation, evidence collection, and regulatory reporting processes."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.control_area_obligation" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.grid.control_area_obligation" ;
    owl:hasKey ( cmm:ControlAreaObligation.controlAreaObligationId ) .

cmm:ControlAreaObligation.controlAreaObligationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control area obligation id"@en ;
    rdfs:comment "Unique identifier for this control area-obligation applicability and compliance tracking record. Primary key for the association."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:long ;
    cmm:physicalColumn "control_area_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Control Area Obligation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ControlAreaObligation.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to the balancing authority control area subject to this compliance obligation"@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Obligation - Control Area Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_obligation_control_area_id" ;
    cmm:cimAssociation "IdentifiedObject.ControlArea" .
cmm:ControlAreaObligation.mitigationPlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "mitigation plan"@en ;
    rdfs:comment "Reference to the mitigation plan record if non-compliance or partial compliance has been identified for this control area-obligation pair and a formal mitigation plan is in place."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range cmm:CorrectiveActionPlan ;
    cmm:physicalColumn "mitigation_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Mitigation Plan Identifier" ;
    cmm:sourceColumn "corrective_action_plan_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_obligation_mitigation_plan_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ControlAreaObligation.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to the regulatory compliance obligation that applies to this control area"@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Obligation - Obligation Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_control_area_obligation_obligation_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ControlAreaObligation.applicabilityDetermination a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicability determination"@en ;
    rdfs:comment "Determination of whether this specific obligation applies to this specific control area, based on operational scope, asset type, and regulatory jurisdiction analysis. Values: applicable, not-applicable, conditionally-applicable, under-review."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicability_determination" ;
