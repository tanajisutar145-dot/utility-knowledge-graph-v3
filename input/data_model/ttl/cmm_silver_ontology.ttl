cmm:DrAggregator.telemetryIntervalMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "telemetry interval minutes"@en ;
    rdfs:comment "Frequency in minutes at which telemetry data must be transmitted from aggregated customer sites to the utility or ISO/RTO (e.g., 5-minute intervals)."@en ;
