cmm:TechnicalReview.reviewToApplication a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review to application"@en ;
    rdfs:comment "FK to interconnection.interconnection_application.interconnection_application_id — Technical reviews are conducted FOR a specific interconnection application. One application may have multiple sequential reviews. This is the core workflow FK — without it, review results cannot be as"@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:long ;
    cmm:physicalColumn "review_to_application" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:TechnicalReview.reviewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review type"@en ;
    rdfs:comment "Classification of the technical review being conducted. Determines the scope, depth, and screening criteria applied during the review process."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:string ;
    cmm:physicalColumn "review_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Technical Review Type" ;
    cmm:validValues "initial_completeness_check|supplemental_review|independent_study|fast_track_screen|detailed_study|witness_test_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:TechnicalReview.reviewerNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer notes"@en ;
    rdfs:comment "Internal notes and observations from the reviewing engineer. May include technical details, coordination notes, or follow-up items for internal use."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:string ;
    cmm:physicalColumn "reviewer_notes" ;
