    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DrIncentivePayment.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Username or identifier of the person who approved this incentive payment for disbursement."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By User" ;
    cmm:cimDatatype "String" .
cmm:DrIncentivePayment.baselineLoadKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline load kw"@en ;
    rdfs:comment "The calculated baseline load in kilowatts representing the customers expected consumption without demand response curtailment. Used for measurement and verification (M&V) calculations."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_load_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Load (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DrIncentivePayment.calculationBasis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "calculation basis"@en ;
    rdfs:comment "Detailed description of the calculation methodology used for this payment, including baseline calculation method, M&V approach, and rate application logic."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "calculation_basis" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Calculation Basis Description" ;
