    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_document_primary_application_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:ApplicationDocument.supersededByDocumentApplicationDocument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded by document application document"@en ;
    rdfs:comment "Reference to the newer document that replaces this document when a revised version is submitted."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range cmm:ApplicationDocument ;
    cmm:physicalColumn "superseded_by_document_application_document_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Superseded By Document Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_document_superseded_by_document_application_document_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ApplicationDocument.tertiaryApplicationModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary application modified by user employee"@en ;
    rdfs:comment "Reference to the user or system account that last modified the document record in the interconnection application system."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range cmm:Employee ;
