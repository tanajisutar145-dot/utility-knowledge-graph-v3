cmm:EnvironmentalPermit.permitStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permit status"@en ;
    rdfs:comment "Current lifecycle status of the environmental permit. Active permits authorize operations; expired or suspended permits require immediate remediation to avoid enforcement action."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "permit_status" ;
