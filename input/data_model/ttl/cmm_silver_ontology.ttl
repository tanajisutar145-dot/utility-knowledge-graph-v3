cmm:TrainingRecord a owl:Class ;
    rdfs:label "Training Record"@en ;
    rdfs:comment "Transactional record of compliance training assignments and completions for utility personnel, covering NERC CIP security awareness training, FERC Standards of Conduct training, OSHA safety training, environmental compliance training, and SOX ethics and anti-fraud training. Captures training course, assigned personnel role, training delivery method, assigned date, completion date, assessment score, and certification expiry. Supports NERC CIP-004 personnel training evidence requirements."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.training_record" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC PER-005; NERC CIP-004-6 Personnel and Training; OSHA Training Requirements" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.training_record" ;
    owl:hasKey ( cmm:TrainingRecord.trainingRecordId ) .

cmm:TrainingRecord.trainingRecordId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "training record id"@en ;
    rdfs:comment "Primary key for training_record"@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range xsd:long ;
    cmm:physicalColumn "training_record_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Training Record Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:TrainingRecord.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Unique identifier of the utility employee or contractor assigned to complete this training."@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Employee ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_training_record_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:TrainingRecord.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Unique identifier of the regulatory obligation that mandates this training requirement."@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_training_record_obligation_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:TrainingRecord.primaryProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary program"@en ;
    rdfs:comment "FK to compliance.program.program_id — Training records are associated with specific compliance programs (NERC CIP, SOX, OSHA). This FK enables program-level training compliance tracking."@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range cmm:ComplianceProgram ;
    cmm:physicalColumn "primary_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_training_record_primary_program_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:TrainingRecord.trainingCourse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "training course"@en ;
    rdfs:comment "Unique identifier of the compliance training course assigned."@en ;
    rdfs:domain cmm:TrainingRecord ; rdfs:range cmm:TrainingCourse ;
    cmm:physicalColumn "training_course_id" ;
    cmm:sqlDataType "BIGINT" ;
