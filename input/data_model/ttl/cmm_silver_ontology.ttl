cmm:EnvironmentalPermit a owl:Class ;
    rdfs:label "Environmental Permit"@en ;
    rdfs:comment "Master record for all environmental operating permits held by the utility, including EPA Title V air permits, NPDES water discharge permits, RCRA hazardous waste permits, and state-issued environmental authorizations. Captures permit number, issuing agency, permitted facility, permit type, issuance date, expiration date, renewal status, permitted emission or discharge limits, and permit conditions. SSOT for environmental permit portfolio management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.environmental_permit" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "EPA Title V; EPA Title V Operating Permit; NPDES Permit; RCRA Permit" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.environmental_permit" ;
    owl:hasKey ( cmm:EnvironmentalPermit.environmentalPermitId ) .

cmm:EnvironmentalPermit.environmentalPermitId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit id"@en ;
    rdfs:comment "Primary key for environmental_permit"@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:long ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Environmental Permit Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EnvironmentalPermit.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Environmental permits authorize capital projects (generation facilities, transmission lines, substations). Permit conditions often drive project costs (emissions controls, environmental mitigation). L"@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_environmental_permit_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:EnvironmentalPermit.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the environmental compliance officer responsible for managing this permit and ensuring ongoing compliance with permit conditions."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Officer ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_environmental_permit_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:EnvironmentalPermit.environmentalObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each environmental permit fulfills a specific regulatory obligation (e.g., EPA Title V air permit, NPDES water discharge permit). Many permits can fulfill one obligation (1:N). Adding obligation_id FK"@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "environmental_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_environmental_permit_environmental_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EnvironmentalPermit.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "FK to compliance.obligation.obligation_id — Environmental permits create compliance obligations (permit conditions become obligations). Links permit portfolio to the obligation registry."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_environmental_permit_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:EnvironmentalPermit.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Identifier of the generation, transmission, or distribution facility covered by this environmental permit. Links permit to the physical asset location where environmental compliance is enforced."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Permitted Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_environmental_permit_power_plant_id" ;
    cmm:cimAssociation "Document.Plant" .
cmm:EnvironmentalPermit.appealStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "appeal status"@en ;
    rdfs:comment "Status of any administrative or judicial appeal of permit conditions. Appeals can delay permit effectiveness or result in modified conditions."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "appeal_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permit Appeal Status" ;
    cmm:validValues "no_appeal|appeal_pending|appeal_resolved|appeal_upheld" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this permit record was first created in the compliance management system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:EnvironmentalPermit.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system from which this permit record was ingested (e.g., SAP EHS, environmental compliance database, regulatory agency portal). Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "The date the environmental permit becomes legally binding and enforceable. May differ from issuance date if permit includes a delayed effective date provision."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Permit Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:EnvironmentalPermit.enforcementActionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enforcement action flag"@en ;
    rdfs:comment "Indicates whether this permit is currently subject to an active enforcement action, consent decree, or compliance order from the regulatory agency."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "enforcement_action_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enforcement Action Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EnvironmentalPermit.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "The date the environmental permit expires and must be renewed. Operating beyond expiration without renewal constitutes a violation subject to enforcement action and penalties."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Permit Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:EnvironmentalPermit.facilityEpaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility epa code"@en ;
    rdfs:comment "The unique EPA facility identification number assigned to the permitted facility. Used for all federal environmental reporting including emissions inventories and discharge monitoring reports."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_epa_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility EPA (Environmental Protection Agency) Identification Number" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.facilityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility name"@en ;
    rdfs:comment "Name of the utility facility covered by this environmental permit. Typically a power generation plant, substation, or operations center subject to environmental regulation."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permitted Facility Name" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.issuanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuance date"@en ;
    rdfs:comment "The date the environmental permit was officially issued by the regulatory agency. Marks the beginning of the permit term and the effective date for permit conditions."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "issuance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permit Issuance Date" ;
    cmm:cimDatatype "Date" .
cmm:EnvironmentalPermit.issuingAgency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing agency"@en ;
    rdfs:comment "Name of the federal, state, or local regulatory agency that issued the environmental permit. Typically EPA for federal permits or state environmental protection agency for state-delegated programs."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_agency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Regulatory Agency" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.issuingAgencyJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issuing agency jurisdiction"@en ;
    rdfs:comment "The governmental jurisdiction level of the issuing agency. Determines the regulatory authority hierarchy and appeal process for permit conditions."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:string ;
    cmm:physicalColumn "issuing_agency_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issuing Agency Jurisdiction Level" ;
    cmm:validValues "federal|state|local" ;
    cmm:cimDatatype "String" .
cmm:EnvironmentalPermit.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent regulatory agency inspection of the permitted facility for compliance with permit conditions. Inspections may be routine or triggered by complaints or violations."@en ;
    rdfs:domain cmm:EnvironmentalPermit ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Regulatory Inspection Date" ;
