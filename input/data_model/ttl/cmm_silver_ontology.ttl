cmm:DistributionFlisrEvent a owl:Class ;
    rdfs:label "Distribution Flisr Event"@en ;
    rdfs:comment "Transactional record capturing Fault Location, Isolation, and Service Restoration (FLISR) automation events triggered by GE PowerOn ADMS. Captures event timestamp, triggering fault indicator, faulted segment identified, isolation devices operated, restoration switching sequence executed, customers affected before and after restoration, restoration time (seconds), FLISR algorithm version, and outcome status. SSOT for FLISR automation event history. Critical for SAIDI/SAIFI/CAIDI reliability index calculation, FLISR performance benchmarking, and PUC reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.distribution_flisr_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; GE PowerOn ADMS FLISR / IEEE 1366 Reliability Indices" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.distribution_flisr_event" ;
    owl:hasKey ( cmm:DistributionFlisrEvent.distributionFlisrEventId ) .

cmm:DistributionFlisrEvent.distributionFlisrEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution flisr event id"@en ;
    rdfs:comment "Unique identifier for the FLISR automation event record. Primary key."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "distribution_flisr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distribution Fault Location, Isolation, and Service Restoration (FLISR) Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.distributionNetworkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution network segment"@en ;
    rdfs:comment "Identifier of the distribution network segment (feeder section) identified by FLISR algorithm as containing the fault. References GIS utility network topology."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "distribution_network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Faulted Distribution Segment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_distribution_network_segment_id" ;
    cmm:cimAssociation "PSREvent.EquipmentContainer" .
cmm:DistributionFlisrEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation serving the affected feeder. Used for substation-level outage aggregation and reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_distribution_substation_id" ;
    cmm:cimAssociation "PSREvent.Substation" .
cmm:DistributionFlisrEvent.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the ADMS operator who intervened in the FLISR sequence, if operator override occurred. Null for fully automated events."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_employee_id" ;
    cmm:cimAssociation "PSREvent.ErpPersonnel" .
cmm:DistributionFlisrEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: FLISR automation events trigger EMS alarms that grid operators monitor for real-time situational awareness, disturbance analysis, and NERC compliance reporting. Critical for integrated distribution-tr"@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_ems_alarm_id" ;
    cmm:cimAssociation "PSREvent.ActivityRecord" .
cmm:DistributionFlisrEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Identifier of the parent outage event record in the Outage Management System (OMS) that this FLISR event is associated with. Links FLISR automation to broader outage lifecycle."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:DistributionFlisrEvent.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the primary distribution feeder on which the FLISR event occurred. Used for feeder-level reliability analysis and SAIDI/SAIFI calculation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_feeder_id" ;
    cmm:cimAssociation "PSREvent.Feeder" .
cmm:DistributionFlisrEvent.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "FK to distribution.network_segment.network_segment_id — FLISR events identify a faulted segment. The description mentions 'faulted segment identified'. Critical for fault isolation logic and reliability reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_network_segment_id" ;
    cmm:cimAssociation "PSREvent.EquipmentContainer" .
cmm:DistributionFlisrEvent.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Identifier linking this FLISR event to a declared storm event, if the fault occurred during a major weather event. Used for storm impact aggregation and mutual aid reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_flisr_event_storm_event_id" ;
    cmm:cimAssociation "PSREvent.Incident" .
cmm:DistributionFlisrEvent.caidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caidi contribution minutes"@en ;
    rdfs:comment "Calculated contribution of this FLISR event to the CAIDI reliability index, in minutes. Computed as total customer-minutes / customers affected. Measures average restoration time per affected customer."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "caidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Average Interruption Duration Index (CAIDI) Contribution in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DistributionFlisrEvent.communicationFailureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication failure flag"@en ;
    rdfs:comment "Indicates whether communication failures with field devices occurred during the FLISR sequence. True if communication issues impacted automation; false otherwise."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "communication_failure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Failure Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionFlisrEvent.customersAffectedInitial a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected initial"@en ;
    rdfs:comment "Number of customer meters that lost service when the fault occurred and before FLISR restoration actions. Used for SAIFI numerator calculation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_initial" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Initial Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.customersAffectedPostRestoration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected post restoration"@en ;
    rdfs:comment "Number of customer meters that remain without service after FLISR restoration sequence completed. Represents customers on the isolated faulted segment awaiting manual repair."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_post_restoration" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Post-Restoration Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.customersRestoredCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored count"@en ;
    rdfs:comment "Number of customer meters that had service restored by FLISR automation (initial affected minus post-restoration affected). Measures FLISR effectiveness in minimizing outage scope."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.derImpactedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der impacted count"@en ;
    rdfs:comment "Number of Distributed Energy Resource (DER) installations (solar, storage, generators) affected by the FLISR event. Used for DER impact analysis and IEEE 1547 compliance reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "der_impacted_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Impacted Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current lifecycle status of the FLISR automation event. Tracks progression from initiation through completion or failure."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "FLISR Event Status" ;
    cmm:validValues "initiated|in_progress|completed|failed|partially_completed|aborted" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.status .
cmm:DistributionFlisrEvent.eventTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event timestamp"@en ;
    rdfs:comment "Date and time when the FLISR automation event was triggered by the Advanced Distribution Management System (ADMS). Represents the real-world moment the fault was detected and FLISR sequence initiated."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Event Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionFlisrEvent.failureReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure reason"@en ;
    rdfs:comment "Detailed explanation of why FLISR automation failed or was aborted, if applicable. Captures system errors, communication failures, operator intervention reasons, or topology constraints."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Failure Reason" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.faultCurrentAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault current amps"@en ;
    rdfs:comment "Magnitude of fault current measured at the triggering fault indicator, in amperes. Used for fault severity analysis and protective device coordination validation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_current_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Current in Amperes" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:DistributionFlisrEvent.faultType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault type"@en ;
    rdfs:comment "Classification of the fault condition that triggered FLISR. Permanent faults require manual repair; temporary faults may clear after isolation; transient faults clear on recloser operation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Type Classification" ;
    cmm:validValues "permanent|temporary|transient" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.flisrAlgorithmVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr algorithm version"@en ;
    rdfs:comment "Version identifier of the FLISR algorithm logic deployed in ADMS at the time of this event. Used for performance trending and algorithm tuning analysis."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_algorithm_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Algorithm Version" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.flisrEventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr event number"@en ;
    rdfs:comment "Business identifier for the FLISR event, typically generated by GE PowerOn ADMS. Used for external reference and operational tracking."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "FLISR Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DistributionFlisrEvent.flisrOutcomeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr outcome status"@en ;
    rdfs:comment "Final outcome classification of the FLISR automation attempt. Full success indicates all restoration actions completed; partial success indicates some customers restored; failed indicates no restoration achieved."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "flisr_outcome_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Outcome Status" ;
    cmm:validValues "full_success|partial_success|failed|aborted_operator|aborted_system" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.isolationDevicesOperated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation devices operated"@en ;
    rdfs:comment "Comma-separated list of switching device IDs (reclosers, sectionalizers, automated switches) that were operated to isolate the faulted segment. Captures the isolation sequence executed by FLISR."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "isolation_devices_operated" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Devices Operated" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.isolationTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "isolation time seconds"@en ;
    rdfs:comment "Elapsed time in seconds from fault detection to completion of fault isolation switching. Subset of total restoration time, measures speed of fault containment."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "isolation_time_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Isolation Time in Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:DistributionFlisrEvent.loadTransferredKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load transferred kw"@en ;
    rdfs:comment "Amount of electrical load in kilowatts transferred to alternate feeders during FLISR restoration. Used for load balancing analysis and feeder capacity validation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_transferred_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Transferred in Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DistributionFlisrEvent.majorEventExclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event exclusion flag"@en ;
    rdfs:comment "Indicates whether this FLISR event qualifies for exclusion from reliability indices under IEEE 1366 Major Event Day criteria. True if excluded; false if included in normal reliability calculations."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_exclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionFlisrEvent.operatorOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override flag"@en ;
    rdfs:comment "Indicates whether a human operator intervened to override or abort the automated FLISR sequence. True if operator action occurred; false if fully automated."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionFlisrEvent.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Indicates whether this FLISR event meets the threshold criteria for mandatory reporting to the state Public Utility Commission. True if reportable; false otherwise."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionFlisrEvent.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this FLISR event record was first created in the data system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionFlisrEvent.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Timestamp when this FLISR event record was last modified in the data system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionFlisrEvent.restorationDevicesOperated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration devices operated"@en ;
    rdfs:comment "Comma-separated list of switching device IDs operated to restore service to de-energized segments downstream of the fault. Captures the restoration switching sequence executed by FLISR."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "restoration_devices_operated" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Devices Operated" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.restorationTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration time seconds"@en ;
    rdfs:comment "Elapsed time in seconds from fault detection to completion of FLISR restoration switching sequence. Critical metric for CAIDI calculation and FLISR performance benchmarking."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "restoration_time_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Time in Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:DistributionFlisrEvent.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "Calculated contribution of this FLISR event to the SAIDI reliability index, in customer-minutes. Computed as (customers affected × duration) / total customers served. Critical for PUC reliability reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DistributionFlisrEvent.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "Calculated contribution of this FLISR event to the SAIFI reliability index. Computed as customers affected / total customers served. Critical for PUC reliability reporting."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionFlisrEvent.scadaAlarmCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada alarm count"@en ;
    rdfs:comment "Number of SCADA alarms generated during the FLISR event. High alarm counts may indicate cascading issues or communication problems."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "scada_alarm_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Alarm Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifier of the source system that generated this FLISR event record, typically GE PowerOn ADMS. Used for data lineage and multi-system integration scenarios."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Identifier" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.switchingOperationsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching operations count"@en ;
    rdfs:comment "Total number of switching device operations (open/close commands) executed during the FLISR sequence. Used for device wear analysis and maintenance planning."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "switching_operations_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Operations Count" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionFlisrEvent.topologyValidationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology validation status"@en ;
    rdfs:comment "Status of network topology validation performed by ADMS before executing FLISR switching. Invalid topology may prevent or abort FLISR automation."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "topology_validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Topology Validation Status" ;
    cmm:validValues "valid|invalid|uncertain|not_checked" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.triggeringFaultIndicatorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "triggering fault indicator code"@en ;
    rdfs:comment "Identifier of the fault indicator device (FCI or FPI) that detected the fault condition and triggered the FLISR automation sequence. Links to SCADA point or asset registry."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "triggering_fault_indicator_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Triggering Fault Indicator ID" ;
    cmm:cimDatatype "String" .
cmm:DistributionFlisrEvent.voltageSagPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage sag percent"@en ;
    rdfs:comment "Percentage voltage drop observed during the fault condition, relative to nominal voltage. Indicates severity of power quality disturbance."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_sag_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Sag Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DistributionFlisrEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Prevailing weather condition at the time of the FLISR event, if available from weather data integration. Used for fault cause correlation and storm impact analysis. Reference-value candidates: clear|rain|snow|ice|wind|lightning|fog|extreme_heat."@en ;
    rdfs:domain cmm:DistributionFlisrEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition at Event Time" ;
    cmm:cimDatatype "String" .

cmm:VoltVarAction a owl:Class ;
    rdfs:label "Volt Var Action"@en ;
    rdfs:comment "Transactional record for Volt-VAR Optimization (VVO) control actions executed by GE PowerOn ADMS on the distribution network. Captures action timestamp, control zone, device operated (capacitor bank, voltage regulator, LTC transformer), setpoint before and after, voltage profile improvement (pu), reactive power reduction (MVAr), energy loss reduction (kWh), optimization objective (conservation voltage reduction/power factor correction), and execution mode (automatic/manual). SSOT for VVO operational action history. Supports CVR program performance measurement and energy loss reduction reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.volt_var_action" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEEE 1547; GE PowerOn ADMS Volt-VAR Optimization / IEC 61968" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.volt_var_action" ;
    owl:hasKey ( cmm:VoltVarAction.voltVarActionId ) .

cmm:VoltVarAction.voltVarActionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var action id"@en ;
    rdfs:comment "Unique identifier for the Volt-VAR Optimization control action record. Primary key."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:long ;
    cmm:physicalColumn "volt_var_action_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Volt-VAR Action ID" ;
    cmm:cimDatatype "Integer" .
cmm:VoltVarAction.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation serving the control zone where the action occurred."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_distribution_substation_id" ;
    cmm:cimAssociation "ActivityRecord.Substation" .
cmm:VoltVarAction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the system operator who initiated or approved the VVO action (for manual or advisory modes). Null for fully automatic actions."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operator ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:VoltVarAction.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit on which the VVO action was performed."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_feeder_id" ;
    cmm:cimAssociation "ActivityRecord.Feeder" .
cmm:VoltVarAction.loadZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load zone"@en ;
    rdfs:comment "FK to distribution.load_zone.load_zone_id — VVO actions are executed within a control zone. The description mentions 'control zone'. Critical for volt-VAR optimization tracking."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "load_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_load_zone_id" ;
    cmm:cimAssociation "ActivityRecord.SubLoadArea" .
cmm:VoltVarAction.voltLoadZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "volt load zone"@en ;
    rdfs:comment "Identifier of the distribution control zone where the VVO action was executed. Links to the geographic/electrical zone managed by ADMS."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "volt_load_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Zone ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_volt_load_zone_id" ;
    cmm:cimAssociation "ActivityRecord.SubLoadArea" .
cmm:VoltVarAction.voltVarDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "volt var device"@en ;
    rdfs:comment "Unique identifier of the distribution device operated during this action (capacitor bank, voltage regulator, LTC transformer, or other VVO-capable device)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:VoltVarDevice ;
    cmm:physicalColumn "volt_var_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_volt_var_device_id" ;
    cmm:cimAssociation "ActivityRecord.RegulatingCondEq" .
cmm:VoltVarAction.voltVvoActionInZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "volt_vvo_action_in_zone"@en ;
    rdfs:comment "FK to distribution.load_zone.load_zone_id — VVO actions are dispatched per control zone. This FK links operational actions to the load zone they optimize, supporting CVR program performance measurement by zone."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "volt_vvo_action_in_zone" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_volt_vvo_action_in_zone" ;
    cmm:cimAssociation "ActivityRecord.SubLoadArea" .
cmm:VoltVarAction.voltVvoActionTargetsZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "volt_vvo_action_targets_zone"@en ;
    rdfs:comment "FK to distribution.load_zone.load_zone_id — VVO control actions are dispatched per control zone. The load_zone FK identifies which zone the optimization action targets, enabling zone-level VVO performance analysis."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range cmm:LoadZone ;
    cmm:physicalColumn "volt_vvo_action_targets_zone" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_action_volt_vvo_action_targets_zone" ;
    cmm:cimAssociation "ActivityRecord.SubLoadArea" .
cmm:VoltVarAction.actionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action status"@en ;
    rdfs:comment "Outcome status of the VVO action execution: successful, failed, partial (some devices operated), aborted (cancelled mid-execution), or pending."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Action Status" ;
    cmm:validValues "successful|failed|partial|aborted|pending" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:VoltVarAction.actionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action timestamp"@en ;
    rdfs:comment "Date and time when the VVO control action was executed on the distribution network. Principal business event timestamp for this transaction."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "action_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VoltVarAction.actionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action type"@en ;
    rdfs:comment "Classification of the VVO action: voltage regulation, reactive power compensation, power factor correction, Conservation Voltage Reduction (CVR), energy loss reduction, or combined optimization."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "action_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Action Type" ;
    cmm:validValues "voltage_regulation|reactive_power_compensation|power_factor_correction|cvr|loss_reduction|combined" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:VoltVarAction.affectedCustomerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected customer count"@en ;
    rdfs:comment "Number of customer premises affected by the VVO action within the control zone."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "affected_customer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Customer Count" ;
    cmm:cimDatatype "Integer" .
cmm:VoltVarAction.approvalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required flag"@en ;
    rdfs:comment "Indicates whether operator approval was required before executing this VVO action (True/False)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarAction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this VVO action record was first created in the system. Audit trail field."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:VoltVarAction.cvrFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cvr factor"@en ;
    rdfs:comment "CVR factor achieved by the action: ratio of percent change in demand to percent change in voltage. Typical range 0.5 to 1.5."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cvr_factor" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Conservation Voltage Reduction (CVR) Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.demandReductionKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand reduction kw"@en ;
    rdfs:comment "Peak demand reduction achieved by the VVO action (typically through CVR), measured in kilowatts (kW)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_reduction_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Reduction (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:VoltVarAction.derActiveFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der active flag"@en ;
    rdfs:comment "Indicates whether Distributed Energy Resources (solar, wind, storage) were actively generating/discharging in the control zone during the VVO action (True/False)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarAction.derImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der impact mw"@en ;
    rdfs:comment "Estimated impact of DER generation/discharge on the VVO optimization, measured in megawatts (MW). Null if no DER active."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "der_impact_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Impact (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:VoltVarAction.deviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device name"@en ;
    rdfs:comment "Human-readable name or label of the device operated (e.g., 'CAP-BANK-12A-01', 'REG-SUBSTATION-5')."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Name" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.deviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:comment "Type of distribution device operated: capacitor bank, voltage regulator, Load Tap Changer (LTC) transformer, switched capacitor, static VAR compensator, or other VVO-capable equipment."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Type" ;
    cmm:validValues "capacitor_bank|voltage_regulator|ltc_transformer|switched_capacitor|static_var_compensator|other" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.energyLossReductionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy loss reduction kwh"@en ;
    rdfs:comment "Estimated energy loss reduction achieved by the VVO action over the optimization period, measured in kilowatt-hours (kWh)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_loss_reduction_kwh" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Loss Reduction (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:VoltVarAction.executionDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution duration seconds"@en ;
    rdfs:comment "Time taken to execute the VVO action from command initiation to device confirmation, measured in seconds."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "execution_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:VoltVarAction.executionMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution mode"@en ;
    rdfs:comment "Mode in which the VVO action was executed: automatic (ADMS-initiated), manual (operator-initiated), scheduled (pre-planned), or advisory (recommended but not executed)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "execution_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Mode" ;
    cmm:validValues "automatic|manual|scheduled|advisory" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.loadLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load level"@en ;
    rdfs:comment "Distribution load level at the time of the VVO action: light, medium, heavy, or peak. Used for optimization performance analysis."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Level" ;
    cmm:validValues "light|medium|heavy|peak" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.optimizationDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "optimization duration seconds"@en ;
    rdfs:comment "Time duration over which the VVO optimization was calculated and applied, measured in seconds."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:int ;
    cmm:physicalColumn "optimization_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Optimization Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:VoltVarAction.optimizationObjective a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "optimization objective"@en ;
    rdfs:comment "Primary objective of the VVO action: Conservation Voltage Reduction (CVR), power factor correction, loss minimization, voltage profile improvement, peak demand reduction, or multi-objective optimization."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "optimization_objective" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Optimization Objective" ;
    cmm:validValues "cvr|power_factor_correction|loss_minimization|voltage_profile_improvement|peak_demand_reduction|multi_objective" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.powerFactorAfter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor after"@en ;
    rdfs:comment "Power factor in the control zone after the VVO action (ratio of real power to apparent power, range 0.0 to 1.0)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_after" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor After" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.powerFactorBefore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor before"@en ;
    rdfs:comment "Power factor in the control zone before the VVO action (ratio of real power to apparent power, range 0.0 to 1.0)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_before" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor Before" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.powerFactorImprovement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor improvement"@en ;
    rdfs:comment "Improvement in power factor achieved by the VVO action. Positive value indicates power factor increased (closer to unity)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor_improvement" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor Improvement" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.reactivePowerAfterMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power after mvar"@en ;
    rdfs:comment "Reactive power flow in the control zone after the VVO action, measured in Megavolt-Amperes Reactive (MVAr)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_after_mvar" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power After (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:VoltVarAction.reactivePowerBeforeMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power before mvar"@en ;
    rdfs:comment "Reactive power flow in the control zone before the VVO action, measured in Megavolt-Amperes Reactive (MVAr)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_before_mvar" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power Before (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:VoltVarAction.reactivePowerReductionMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power reduction mvar"@en ;
    rdfs:comment "Reduction in reactive power flow achieved by the VVO action, measured in MVAr. Positive value indicates successful VAR reduction."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_reduction_mvar" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power Reduction (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:VoltVarAction.scadaCommandCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada command code"@en ;
    rdfs:comment "SCADA system command identifier that initiated the device operation. Links to SCADA command log."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_command_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Command ID" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.setpointAfter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "setpoint after"@en ;
    rdfs:comment "Device setpoint value after the VVO action was executed. Units depend on device type."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "setpoint_after" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Setpoint After" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.setpointBefore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "setpoint before"@en ;
    rdfs:comment "Device setpoint value before the VVO action (tap position for LTC/regulator, switch state for capacitor, VAR output for SVC). Units depend on device type."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "setpoint_before" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Setpoint Before" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.setpointUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "setpoint unit"@en ;
    rdfs:comment "Unit of measure for the setpoint values: tap position (integer), switch state (on/off), MVAr, kVAr, percent, or per-unit (pu)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "setpoint_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Setpoint Unit of Measure" ;
    cmm:validValues "tap_position|switch_state|mvar|kvar|percent|pu" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name of the source system that generated this VVO action record (e.g., 'GE PowerOn ADMS', 'OSIsoft PI', 'Manual Entry')."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this VVO action record was last updated. Audit trail field."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:VoltVarAction.violationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation description"@en ;
    rdfs:comment "Description of any voltage or operational violations detected (e.g., 'Voltage exceeded upper limit at node XYZ', 'Device operation count exceeded daily limit'). Null if no violations."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "violation_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Description" ;
    cmm:cimDatatype "String" .
cmm:VoltVarAction.violationDetectedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation detected flag"@en ;
    rdfs:comment "Indicates whether any voltage or operational violations were detected during or after the VVO action (True/False)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "violation_detected_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Detected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarAction.voltageAfterPu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage after pu"@en ;
    rdfs:comment "Average voltage profile in the control zone after the VVO action, measured in per-unit (pu) relative to nominal voltage."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_after_pu" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage After (Per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.voltageBeforePu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage before pu"@en ;
    rdfs:comment "Average voltage profile in the control zone before the VVO action, measured in per-unit (pu) relative to nominal voltage."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_before_pu" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Before (Per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.voltageImprovementPu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage improvement pu"@en ;
    rdfs:comment "Change in voltage profile achieved by the VVO action, measured in per-unit (pu). Positive value indicates voltage increase, negative indicates reduction (CVR)."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_improvement_pu" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Improvement (Per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:VoltVarAction.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather condition at the time of the VVO action (e.g., 'clear', 'rain', 'snow', 'high_wind'). Used for performance correlation analysis."@en ;
    rdfs:domain cmm:VoltVarAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:CapacitorBank a owl:Class ;
    rdfs:label "Capacitor Bank"@en ;
    rdfs:comment "Master record for shunt capacitor banks installed on the distribution network for reactive power compensation and voltage support. Captures bank identifier, rated kVAr, voltage rating, number of steps, switching type (fixed/switched/automated), control mode (time/voltage/VAr/temperature), GIS location, feeder and phase assignment, SCADA point reference, installation date, and operational status. Managed through GE PowerOn ADMS for volt-VAR optimization."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:LinearShuntCompensator ;
    cmm:cimExactMatch cim:LinearShuntCompensator ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.capacitor_bank" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13; IEC CIM ShuntCompensator / GE PowerOn ADMS VVO Device" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.capacitor_bank" ;
    owl:hasKey ( cmm:CapacitorBank.capacitorBankId ) .

cmm:CapacitorBank.capacitorBankId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacitor bank id"@en ;
    rdfs:comment "Unique identifier for the capacitor bank asset. Primary key for the capacitor bank master record."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:long ;
    cmm:physicalColumn "capacitor_bank_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capacitor Bank Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CapacitorBank.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the parent distribution substation serving the feeder on which this capacitor bank is installed."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_distribution_substation_id" ;
    cmm:cimAssociation "LinearShuntCompensator.Substation" .
cmm:CapacitorBank.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the distribution feeder circuit to which this capacitor bank is connected for load balancing and voltage support."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_feeder_id" ;
    cmm:cimAssociation "LinearShuntCompensator.Feeder" .
cmm:CapacitorBank.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Capacitor banks are capitalized distribution assets requiring fixed asset registry tracking for depreciation, FERC account classification, and RAB inclusion. Essential for regulatory asset base report"@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_fixed_asset_id" ;
    cmm:cimAssociation "LinearShuntCompensator.FinancialInfo" .
cmm:CapacitorBank.flisrZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "flisr zone"@en ;
    rdfs:comment "Reference to the FLISR automation zone in which this capacitor bank operates for coordinated fault isolation and service restoration."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "flisr_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Zone Identifier (ID)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_flisr_zone_id" ;
    cmm:cimAssociation "LinearShuntCompensator.LoadArea" .
cmm:CapacitorBank.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Capacitor banks are procured volt-var control equipment requiring material master linkage for maintenance parts planning, replacement cost tracking, and equipment standardization. Supports power quali"@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_material_master_id" ;
    cmm:cimAssociation "LinearShuntCompensator.ErpItemMaster" .
cmm:CapacitorBank.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: SCADA-controlled capacitor banks in substations can be BES Cyber Assets requiring CIP compliance when they impact BES reliability. The scada_point_id and volt_var_optimization_enabled attributes indic"@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_nerc_cip_asset_id" ;
    cmm:cimAssociation "LinearShuntCompensator.Asset" .
cmm:CapacitorBank.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "SCADA system telemetry point reference for real-time monitoring and remote control of the capacitor bank through the Distribution Management System (DMS) or Advanced Distribution Management System (ADMS)."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_scada_point_id" ;
    cmm:cimAssociation "LinearShuntCompensator.Measurement" .
cmm:CapacitorBank.technicianEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "technician employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Capacitor banks require assigned technicians for switching operations, maintenance testing, and control system verification. Essential for volt-var optimization programs, power factor correction, and"@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "technician_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Technician Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_capacitor_bank_technician_employee_id" ;
    cmm:cimAssociation "LinearShuntCompensator.ErpPersonnel" .
cmm:CapacitorBank.acquisitionCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition cost"@en ;
    rdfs:comment "Total cost incurred to acquire and install the capacitor bank, including equipment, labor, and materials."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Acquisition Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" ;
    cmm:cimCloseMatch cim:Asset.purchasePrice .
cmm:CapacitorBank.ambientTemperatureRatingC a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature rating c"@en ;
    rdfs:comment "Maximum ambient temperature rating in degrees Celsius at which the capacitor bank can safely operate per manufacturer specifications."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_rating_c" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature Rating (Celsius)" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacitorBank.assetConditionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset condition score"@en ;
    rdfs:comment "Quantitative health index or condition score (typically 0-100) representing the current physical and operational condition of the capacitor bank based on inspection and diagnostic data."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_condition_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Score" ;
    cmm:cimDatatype "Decimal" .
cmm:CapacitorBank.bankName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank name"@en ;
    rdfs:comment "Human-readable name or designation of the capacitor bank, typically including location or circuit reference."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Capacitor Bank Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CapacitorBank.bankNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank number"@en ;
    rdfs:comment "Business identifier or asset tag assigned to the capacitor bank for operational reference and field identification."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Capacitor Bank Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapacitorBank.bankType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank type"@en ;
    rdfs:comment "Classification of the capacitor bank switching capability: fixed (always on), switched (manual or remote control), or automated (SCADA-controlled for volt-VAR optimization)."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Capacitor Bank Type" ;
    cmm:validValues "fixed|switched|automated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:LinearShuntCompensator.kind .
cmm:CapacitorBank.controlMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Primary control strategy governing capacitor bank switching operations: time-based scheduling, voltage-based, VAr-based, temperature-based, power factor correction, or manual operation."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Mode" ;
    cmm:validValues "time|voltage|var|temperature|power_factor|manual" ;
    cmm:cimDatatype "String" .
cmm:CapacitorBank.controlVoltageV a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control voltage v"@en ;
    rdfs:comment "Control circuit voltage in volts required for operating the capacitor bank switching mechanism and control relays."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "control_voltage_v" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Voltage (V)" ;
    cmm:unitSymbol "V" ;
    cmm:cimDatatype "Voltage" .
cmm:CapacitorBank.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this capacitor bank record was first created in the system."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:LinearShuntCompensator.createdDateTime .
cmm:CapacitorBank.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
    rdfs:comment "Business criticality classification of the capacitor bank based on its impact on system reliability, voltage support, and customer service."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Criticality Rating" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:CapacitorBank.fuseRatingAmperes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuse rating amperes"@en ;
    rdfs:comment "Current rating in amperes of the protective fuses installed to protect the capacitor bank from overcurrent and fault conditions."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fuse_rating_amperes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuse Rating (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:CapacitorBank.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique feature identifier in the utility GIS system linking the capacitor bank to the geospatial network model and asset location database."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Feature Identifier (ID)" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:CapacitorBank.inServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "in service date"@en ;
    rdfs:comment "Date when the capacitor bank was placed into active service and began providing reactive power compensation to the distribution network."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:date ;
    cmm:physicalColumn "in_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "In-Service Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:CapacitorBank.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the capacitor bank was installed and commissioned in the distribution network."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:CapacitorBank.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent preventive or corrective maintenance activity performed on the capacitor bank."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacitorBank.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the capacitor bank installation location in decimal degrees for GIS mapping and spatial analysis."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:CapacitorBank.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the capacitor bank installation location in decimal degrees for GIS mapping and spatial analysis."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:CapacitorBank.nextInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection date"@en ;
    rdfs:comment "Planned date for the next routine inspection of the capacitor bank per the utility maintenance schedule."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Scheduled Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacitorBank.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for capturing additional operational notes, special instructions, or historical information about the capacitor bank."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CapacitorBank.numberOfSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of steps"@en ;
    rdfs:comment "Count of discrete switching steps or stages available in the capacitor bank for granular reactive power control. Single-step banks have a value of 1."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_steps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Switching Steps" ;
    cmm:cimDatatype "Integer" .
cmm:CapacitorBank.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the capacitor bank in the distribution network lifecycle."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|maintenance|retired|planned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:LinearShuntCompensator.status .
cmm:CapacitorBank.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Classification of asset ownership indicating whether the capacitor bank is owned by the utility, customer, third party, or leased."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|third_party|leased" ;
    cmm:cimDatatype "String" .
cmm:CapacitorBank.phaseConnection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase connection"@en ;
    rdfs:comment "Electrical phase configuration indicating which phase(s) of the distribution circuit the capacitor bank is connected to for reactive power compensation. Reference-value candidates: three_phase|phase_a|phase_b|phase_c|phase_ab|phase_bc|phase_ca."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_connection" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Connection Configuration" ;
    cmm:cimDatatype "String" .
cmm:CapacitorBank.poleNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pole number"@en ;
    rdfs:comment "Identifier of the distribution pole or structure on which the capacitor bank is mounted, used for field location and maintenance planning."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "pole_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Pole Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapacitorBank.purchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order number"@en ;
    rdfs:comment "Procurement purchase order number under which the capacitor bank was acquired."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Purchase Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapacitorBank.ratedKvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated kvar"@en ;
    rdfs:comment "Nameplate reactive power rating of the capacitor bank in kilovolt-amperes reactive, representing the total reactive power compensation capacity."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_kvar" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Kilovolt-Ampere Reactive (kVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ReactivePower" .
cmm:CapacitorBank.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by the manufacturer for individual unit identification and warranty tracking."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:CapacitorBank.switchingDeviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching device type"@en ;
    rdfs:comment "Type of switching mechanism used to energize and de-energize the capacitor bank for reactive power control."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Device Type" ;
    cmm:validValues "vacuum_switch|oil_switch|sf6_breaker|contactor|relay" ;
    cmm:cimDatatype "String" .
cmm:CapacitorBank.switchingOperationsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching operations count"@en ;
    rdfs:comment "Total number of switching operations (on/off cycles) performed by the capacitor bank since installation, used for condition monitoring and maintenance planning."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:int ;
    cmm:physicalColumn "switching_operations_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Switching Operations Count" ;
    cmm:cimDatatype "Integer" .
cmm:CapacitorBank.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this capacitor bank record was last modified in the system."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CapacitorBank.voltVarOptimizationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var optimization enabled"@en ;
    rdfs:comment "Indicates whether this capacitor bank is integrated into the ADMS volt-VAR optimization control scheme for automated voltage and reactive power management."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "volt_var_optimization_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Optimization (VVO) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapacitorBank.voltageRatingKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage rating kv"@en ;
    rdfs:comment "Nominal voltage rating of the capacitor bank in kilovolts, indicating the distribution voltage level at which the bank operates."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_rating_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Rating (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:CapacitorBank.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer warranty coverage for the capacitor bank expires."@en ;
    rdfs:domain cmm:CapacitorBank ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:VoltVarDevice a owl:Class ;
    rdfs:label "Volt Var Device"@en ;
    rdfs:comment "Master record for all voltage and reactive power regulation devices deployed on distribution feeders, including shunt capacitor banks, step-voltage regulators, and load tap changer (LTC) transformers. Captures device identifier, device type (capacitor_bank/step_regulator/LTC), rated capacity (kVAr or kVA), voltage rating, control mode (time/voltage/VAr/temperature/bandwidth), switching type (fixed/switched/automated), tap range and setpoints, GIS location, feeder and phase assignment, SCADA point reference, installation date, and operational status. SSOT for all volt-VAR optimization devices on the distribution network. Integral to VVO dispatch, conservation voltage reduction (CVR) programs, and ANSI C84.1 voltage compliance. Managed through GE PowerOn ADMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:RegulatingCondEq ;
    cmm:cimCloseMatch cim:RegulatingCondEq ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Wires" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.volt_var_device" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 61968-13; IEC CIM TapChanger / GE PowerOn ADMS VVO Device" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.volt_var_device" ;
    owl:hasKey ( cmm:VoltVarDevice.voltVarDeviceId ) .

cmm:VoltVarDevice.voltVarDeviceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var device id"@en ;
    rdfs:comment "Primary key for volt_var_device"@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:long ;
    cmm:physicalColumn "volt_var_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Volt Var Device Identifier" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" .
cmm:VoltVarDevice.controlEngineerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control engineer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Voltage regulators and var devices require designated control engineers for setpoint management, CVR optimization, and performance tuning. Critical for volt-var optimization programs, conservation vol"@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "control_engineer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Engineer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_device_control_engineer_employee_id" ;
    cmm:cimAssociation "RegulatingCondEq.ErpPersonnel" .
cmm:VoltVarDevice.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation that serves the feeder on which this device is located. Used for hierarchical network modeling and regional voltage management strategies."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_device_distribution_substation_id" ;
    cmm:cimAssociation "RegulatingCondEq.Substation" .
cmm:VoltVarDevice.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit on which this volt-VAR device is installed. Links the device to the distribution network topology for load flow analysis, outage management, and VVO optimization."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_device_feeder_id" ;
    cmm:cimAssociation "RegulatingCondEq.Feeder" .
cmm:VoltVarDevice.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Voltage regulators and reactive power control devices are capitalized assets tracked in fixed asset registry for depreciation, FERC reporting, and RAB valuation. Core to utility asset accounting and r"@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_device_fixed_asset_id" ;
    cmm:cimAssociation "RegulatingCondEq.FinancialInfo" .
cmm:VoltVarDevice.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Voltage regulators and reactive power devices are physical assets requiring material master linkage for procurement tracking, spare parts management, lifecycle costing, and equipment standardization."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_volt_var_device_material_master_id" ;
    cmm:cimAssociation "RegulatingCondEq.ErpItemMaster" .
cmm:VoltVarDevice.assetCriticality a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset criticality"@en ;
    rdfs:comment "Risk-based classification of the device importance to grid reliability and customer service. Critical devices serve large customer populations or critical infrastructure, high criticality devices impact significant load, medium and low criticality devices have localized impact. Used for maintenance prioritization and spare parts stocking."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_criticality" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Criticality" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.bandwidthVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bandwidth voltage kv"@en ;
    rdfs:comment "Voltage deadband or tolerance range within which the device will not initiate tap changes or switching operations, expressed in kilovolts. Prevents excessive switching due to minor voltage fluctuations. Typical values are 1.0 to 2.0 kV."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bandwidth_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bandwidth Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltVarDevice.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the device was tested, verified, and placed into active service. May differ from installation date if testing and acceptance procedures span multiple days. Used for warranty start date and performance baseline establishment."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:VoltVarDevice.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "Communication protocol used for SCADA integration and remote control. DNP3 and Modbus are legacy protocols, IEC 61850 is the modern standard for substation automation, proprietary protocols are vendor-specific, and none indicates no remote communication capability."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:validValues "dnp3|modbus|iec61850|proprietary|none" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.controlMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Operating control strategy for the volt-VAR device. Time-based uses scheduled switching, voltage-based responds to local voltage measurements, VAR-based responds to reactive power flow, temperature-based adjusts for ambient conditions, bandwidth control maintains voltage within a deadband, and remote SCADA enables centralized dispatch from ADMS."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Mode" ;
    cmm:validValues "time_based|voltage_based|var_based|temperature_based|bandwidth_control|remote_scada" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this volt-VAR device record was first created in the system. Used for data lineage, audit trails, and record lifecycle tracking."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:RegulatingCondEq.createdDateTime .
cmm:VoltVarDevice.cvrEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cvr enabled flag"@en ;
    rdfs:comment "Boolean indicator of whether this device participates in conservation voltage reduction programs that intentionally lower distribution voltage to reduce energy consumption. True indicates the device is included in CVR dispatch strategies, false indicates exclusion from CVR operations."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cvr_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CVR (Conservation Voltage Reduction) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarDevice.deviceIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device identifier"@en ;
    rdfs:comment "Externally-known unique identifier for the volt-VAR device, typically assigned by the utility and used in SCADA systems, field operations, and ADMS integration. May be asset tag, equipment number, or SCADA point reference."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Device Identifier" ;
    cmm:valuePattern "^[A-Z0-9]{6,20}$" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.deviceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device name"@en ;
    rdfs:comment "Human-readable name or label for the volt-VAR device, often including location or feeder reference for operational identification."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Device Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:VoltVarDevice.deviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:comment "Classification of the volt-VAR device by technology and function. Capacitor banks provide reactive power support, step regulators adjust voltage levels, LTC (Load Tap Changer) transformers provide dynamic voltage control, static VAR compensators offer fast reactive power injection, and synchronous condensers provide rotating reactive power reserves."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Device Type" ;
    cmm:validValues "capacitor_bank|step_regulator|ltc_transformer|static_var_compensator|synchronous_condenser" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:RegulatingCondEq.kind .
cmm:VoltVarDevice.expectedUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expected useful life years"@en ;
    rdfs:comment "Estimated operational lifespan of the device in years, based on manufacturer specifications and utility experience. Used for depreciation schedules, capital planning, and asset replacement forecasting."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "expected_useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expected Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:VoltVarDevice.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique identifier linking this volt-VAR device to its corresponding feature in the utility GIS system (Esri ArcGIS Utility Network). Enables spatial queries, network tracing, and integration between ADMS and GIS for topology-aware VVO."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "GIS (Geographic Information System) Feature ID" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:VoltVarDevice.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the volt-VAR device was installed and commissioned on the distribution network. Used for age-based maintenance scheduling, depreciation calculations, and asset replacement planning."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:VoltVarDevice.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent preventive or corrective maintenance activity performed on the device. Used for maintenance interval tracking and reliability analysis."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:VoltVarDevice.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to this device record. Used for change tracking, data quality monitoring, and synchronization with upstream systems."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:VoltVarDevice.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the device installation location in decimal degrees. Used for GIS mapping, spatial analysis, outage visualization, and field crew dispatch."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:VoltVarDevice.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the device installation location in decimal degrees. Used for GIS mapping, spatial analysis, outage visualization, and field crew dispatch."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:VoltVarDevice.nextMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next maintenance date"@en ;
    rdfs:comment "Scheduled date for the next planned maintenance activity. Derived from maintenance plan intervals and last maintenance date. Used for work order generation and resource planning."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:VoltVarDevice.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for operational notes, special instructions, configuration details, or historical context relevant to the device. Used by field crews, engineers, and operations staff for knowledge capture."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:VoltVarDevice.numberOfSteps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of steps"@en ;
    rdfs:comment "Total number of discrete tap positions or switching steps available on the device. For step regulators and LTCs, this defines the granularity of voltage adjustment. Typical values range from 16 to 33 steps. For capacitor banks, this represents the number of switchable stages."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_steps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Steps" ;
    cmm:cimDatatype "Integer" .
cmm:VoltVarDevice.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current lifecycle state of the volt-VAR device indicating availability for grid operations. In-service devices are actively controlled by VVO algorithms, out-of-service devices are temporarily unavailable, maintenance indicates scheduled work, testing indicates commissioning or validation, retired indicates permanent removal, and standby indicates reserve capacity."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|maintenance|testing|retired|standby" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:RegulatingCondEq.status .
cmm:VoltVarDevice.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Classification of asset ownership. Utility-owned devices are capitalized on the utility balance sheet, customer-owned devices (behind-the-meter DER) are not, third-party-owned devices may be under PPA or service agreements, and leased devices have specific accounting treatment."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "utility_owned|customer_owned|third_party_owned|leased" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase assignment of the volt-VAR device on the distribution circuit. Three-phase devices serve balanced loads, single-phase devices serve lateral taps, and two-phase devices serve open-wye or open-delta configurations. Critical for unbalanced load flow analysis. Reference-value candidates: three_phase|single_phase_a|single_phase_b|single_phase_c|two_phase_ab|two_phase_bc|two_phase_ac."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.ratedCapacityKva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated capacity kva"@en ;
    rdfs:comment "Nameplate apparent power capacity of the device in kilovolt-amperes (kVA). Applicable primarily to voltage regulators and LTC transformers. Used for thermal loading calculations and capacity planning."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_capacity_kva" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Capacity (kVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ApparentPower" .
cmm:VoltVarDevice.ratedCapacityKvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated capacity kvar"@en ;
    rdfs:comment "Nameplate reactive power capacity of the device in kilovolt-amperes reactive (kVAr). For capacitor banks, this is the total reactive power injection capability. For regulators and LTCs, this represents the maximum reactive power handling capability. Critical for VVO optimization calculations and grid planning."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_capacity_kvar" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Capacity (kVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ReactivePower" .
cmm:VoltVarDevice.remoteControlEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remote control enabled flag"@en ;
    rdfs:comment "Boolean indicator of whether the device can be operated remotely via SCADA or ADMS. True indicates remote control capability is active, false indicates local-only or manual operation. Critical for FLISR automation and real-time grid optimization."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "remote_control_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Control Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarDevice.scadaPointReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada point reference"@en ;
    rdfs:comment "SCADA system tag or point identifier used to monitor and control this device in real-time. Links the device to telemetry streams for voltage, current, tap position, and switch status. Essential for ADMS integration and remote operations."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_point_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Point Reference" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by the manufacturer to this specific device unit. Used for warranty claims, maintenance history tracking, and asset lifecycle management."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:VoltVarDevice.switchingType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching type"@en ;
    rdfs:comment "Switching capability classification. Fixed devices are permanently connected, switched devices can be manually operated, and automated devices support remote control via SCADA or ADMS for real-time VVO and FLISR operations."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switching Type" ;
    cmm:validValues "fixed|switched|automated" ;
    cmm:cimDatatype "String" .
cmm:VoltVarDevice.tapRangePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tap range percent"@en ;
    rdfs:comment "Total voltage adjustment range available through tap changing, expressed as a percentage of nominal voltage. Typical ranges are ±10% or ±5%. Used by VVO algorithms to determine available voltage control authority."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tap_range_percent" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tap Range (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:VoltVarDevice.timeDelaySeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time delay seconds"@en ;
    rdfs:comment "Intentional delay period before the device responds to a control signal or voltage deviation, expressed in seconds. Prevents nuisance operations during transient conditions. Typical values range from 15 to 120 seconds."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:int ;
    cmm:physicalColumn "time_delay_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Delay (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:VoltVarDevice.voltageRatingKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage rating kv"@en ;
    rdfs:comment "Nominal voltage level at which the device operates, expressed in kilovolts (kV). Typical distribution voltages include 4.16, 12.47, 13.2, 13.8, 23, 34.5 kV. Essential for network topology modeling and voltage compliance verification per ANSI C84.1."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_rating_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Rating (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltVarDevice.voltageSetpointKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage setpoint kv"@en ;
    rdfs:comment "Target voltage level that the device is configured to maintain, expressed in kilovolts. For voltage regulators and LTCs, this is the desired output voltage. For capacitor banks with voltage control, this is the threshold for switching. Updated by VVO optimization and CVR programs."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_setpoint_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Setpoint (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:VoltVarDevice.vvoEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vvo enabled flag"@en ;
    rdfs:comment "Boolean indicator of whether this device is actively participating in automated volt-VAR optimization algorithms executed by the ADMS. True indicates the device accepts remote control commands for voltage and reactive power management, false indicates manual-only operation."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vvo_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VVO (Volt-VAR Optimization) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VoltVarDevice.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer warranty coverage ends. Used for maintenance cost forecasting and replacement planning decisions."@en ;
    rdfs:domain cmm:VoltVarDevice ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:DistributionReliabilityEvent a owl:Class ;
    rdfs:label "Distribution Reliability Event"@en ;
    rdfs:comment "Transactional record for distribution reliability interruption events used to calculate IEEE 1366 reliability indices (SAIDI, SAIFI, CAIDI, MAIFI) for PUC reporting. Captures event identifier, event type (sustained/momentary/planned), cause code per IEEE 1366 Appendix (equipment failure/weather/animal/vegetation/scheduled/unknown), affected feeder and segment, number of customers interrupted, customer-minutes interrupted (CMI), event start and restoration timestamps, duration (minutes), major event day (MED) threshold flag, and IEEE 1366 2.5-beta exclusion flag. SSOT for PUC reliability reporting and IEEE 1366 index calculation. Supports annual reliability filings, worst-performing feeder analysis, and reliability improvement program tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Outage ;
    cmm:cimCloseMatch cim:Outage ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.distribution_reliability_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "Incident.Location" ;
    cmm:standardReference "IEEE 1366; IEEE 1366 / PUC Reliability Reporting / GE PowerOn OMS" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.distribution_reliability_event" ;
    owl:hasKey ( cmm:DistributionReliabilityEvent.distributionReliabilityEventId ) .

cmm:DistributionReliabilityEvent.distributionReliabilityEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution reliability event id"@en ;
    rdfs:comment "Unique identifier for the distribution reliability interruption event. Primary key for IEEE 1366 reliability index calculation and PUC reporting."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "distribution_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Reliability Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionReliabilityEvent.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Identifier of the distribution substation serving the affected feeder. Used for substation-level reliability aggregation and asset performance correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_distribution_substation_id" ;
    cmm:cimAssociation "Outage.Substation" .
cmm:DistributionReliabilityEvent.emergencyStockEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency stock event"@en ;
    rdfs:comment "Foreign key linking to supply.emergency_stock_event. Business justification: Major reliability events (storms, cascading failures) trigger emergency material deployment for restoration. Links outage events to emergency stock for cost allocation, FEMA reimbursement tracking, re"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:EmergencyStockEvent ;
    cmm:physicalColumn "emergency_stock_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Stock Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_emergency_stock_event_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:DistributionReliabilityEvent.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Distribution reliability events generate EMS alarms for grid operator awareness during major outages. Required for integrated outage management systems (OMS-EMS integration) and regulatory SAIDI/SAIFI"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_ems_alarm_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:DistributionReliabilityEvent.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder (primary circuit) affected by the reliability event. Used for worst-performing feeder analysis and targeted reliability improvement programs."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_feeder_id" ;
    cmm:cimAssociation "Outage.Feeder" .
cmm:DistributionReliabilityEvent.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: Major distribution reliability events escalate to grid-level reliability events for transmission-impacting outages. Required for NERC OE-417 reporting, major event day classification, and integrated r"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_grid_reliability_event_id" ;
    cmm:cimAssociation "Outage.PSREvent" .
cmm:DistributionReliabilityEvent.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "Foreign key linking to distribution.network_segment. Business justification: Reliability events (interruptions) occur on specific network segments. Currently reliability_event has segment_id as STRING, but this should be a proper FK to network_segment.network_segment_id for re"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Network Segment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_network_segment_id" ;
    cmm:cimAssociation "Outage.EquipmentContainer" .
cmm:DistributionReliabilityEvent.omsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "oms event"@en ;
    rdfs:comment "Source system identifier from the Outage Management System (OMS) or ADMS. Used for cross-system reconciliation and audit trail back to operational systems."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "oms_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Management System (OMS) Event ID" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_oms_event_id" ;
    cmm:cimAssociation "Outage.Outage" .
cmm:DistributionReliabilityEvent.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Reliability events are aggregated into IEEE 1366 reports and PUC performance filings. The puc_reportable_flag indicates filing requirement; linking events to filings enables automated report generatio"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_regulatory_filing_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:DistributionReliabilityEvent.respondingCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responding crew"@en ;
    rdfs:comment "Foreign key linking to workforce.crew. Business justification: Reliability events track which crew responded for performance metrics, labor cost allocation, crew efficiency analysis, and storm restoration reporting. Essential for PUC reporting, mutual aid cost re"@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "responding_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responding Crew Id (Foreign Key)" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_responding_crew_id" ;
    cmm:cimAssociation "Outage.Crew" .
cmm:DistributionReliabilityEvent.scadaAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada alarm"@en ;
    rdfs:comment "SCADA alarm identifier that triggered the reliability event detection. Used for SCADA integration validation and event correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "scada_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Alarm ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_scada_alarm_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:DistributionReliabilityEvent.sectionalizingDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sectionalizing device"@en ;
    rdfs:comment "Identifier of the specific protective device that operated during the event. Links to asset registry for device maintenance history and performance tracking."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:SectionalizingDevice ;
    cmm:physicalColumn "sectionalizing_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Protective Device ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_sectionalizing_device_id" ;
    cmm:cimAssociation "Outage.ProtectedSwitch" .
cmm:DistributionReliabilityEvent.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Foreign key reference to the storm event record if this reliability event was part of a larger storm or weather system. Enables storm-level reliability aggregation and mutual aid analysis."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_distribution_reliability_event_storm_event_id" ;
    cmm:cimAssociation "Outage.Incident" .
cmm:DistributionReliabilityEvent.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Root cause classification per IEEE 1366 Appendix categories: equipment failure, weather, animal contact, vegetation, vehicle accident, scheduled maintenance, unknown, or other utility-specific cause codes."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cause Code" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Detailed narrative description of the root cause of the reliability event, including specific equipment failures, weather conditions, or external factors."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cause Description" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.crewArrivalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew arrival timestamp"@en ;
    rdfs:comment "Date and time when field crew arrived at the fault location. Used to calculate crew travel time and on-site restoration duration."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_arrival_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.crewDispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatch timestamp"@en ;
    rdfs:comment "Date and time when field crew was dispatched to investigate and repair the fault. Used to calculate crew response time and restoration performance metrics."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "crew_dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.criticalCustomerAffectedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical customer affected flag"@en ;
    rdfs:comment "Boolean indicator whether any critical customers (hospitals, emergency services, water treatment, etc.) were affected by the interruption. Used for priority restoration and regulatory notification."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_customer_affected_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Customer Affected Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionReliabilityEvent.customerMinutesInterrupted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer minutes interrupted"@en ;
    rdfs:comment "Total customer-minutes of interruption calculated as customers_interrupted × duration_minutes. Used to calculate SAIDI (System Average Interruption Duration Index) per IEEE 1366."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "customer_minutes_interrupted" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Minutes Interrupted (CMI)" ;
    cmm:cimDatatype "Decimal" .
cmm:DistributionReliabilityEvent.customersInterrupted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers interrupted"@en ;
    rdfs:comment "Total number of customer accounts experiencing service interruption during this event. Used to calculate SAIFI (System Average Interruption Frequency Index) per IEEE 1366."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_interrupted" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Interrupted" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionReliabilityEvent.customersRestoredByFlisr a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers restored by flisr"@en ;
    rdfs:comment "Number of customers automatically restored by FLISR automation without manual crew intervention. Used to quantify FLISR benefit and avoided customer-minutes interrupted."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_restored_by_flisr" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Restored by FLISR" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionReliabilityEvent.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the operational system that originated this reliability event record (e.g., GE PowerOn ADMS, OSIsoft PI, SAP IS-U). Used for data lineage and source system reconciliation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.durationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration minutes"@en ;
    rdfs:comment "Total duration of the interruption event in minutes, calculated as the difference between restoration_timestamp and event_start_timestamp. Used for IEEE 1366 sustained vs. momentary classification."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:DistributionReliabilityEvent.energyNotServedMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy not served mwh"@en ;
    rdfs:comment "Total energy not delivered to customers in megawatt-hours (MWh) due to the interruption, calculated as load_interrupted_mw × duration_hours. Used for economic impact analysis and PUC reporting."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_not_served_mwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Not Served (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:DistributionReliabilityEvent.equipmentAgeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment age years"@en ;
    rdfs:comment "Age in years of the failed equipment at the time of the event. Used for asset health correlation and age-based replacement program justification."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "equipment_age_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Age (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:DistributionReliabilityEvent.equipmentFailed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment failed"@en ;
    rdfs:comment "Type of distribution equipment that failed and caused the interruption (e.g., transformer, conductor, insulator, pole, underground cable). Used for asset failure analysis and replacement prioritization."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_failed" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Failed" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.estimatedRestorationTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated restoration time"@en ;
    rdfs:comment "Initial estimated time of restoration communicated to customers and regulators when the event began. Used to measure ERT accuracy and customer communication effectiveness."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "estimated_restoration_time" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Restoration Time (ERT)" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.eventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event number"@en ;
    rdfs:comment "Business identifier for the reliability event, typically generated by the Outage Management System (OMS) or Advanced Distribution Management System (ADMS). Used for external reporting and cross-system correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DistributionReliabilityEvent.eventStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event start timestamp"@en ;
    rdfs:comment "Date and time when the reliability event began (first customer interruption detected). Captured from SCADA, AMI, or customer call-in data via OMS/ADMS."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "event_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event type"@en ;
    rdfs:comment "Classification of the interruption event per IEEE 1366 definitions: sustained (>5 minutes), momentary (≤5 minutes), or planned (scheduled maintenance outage)."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Type" ;
    cmm:validValues "sustained|momentary|planned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Outage.type .
cmm:DistributionReliabilityEvent.exclusionReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exclusion reason"@en ;
    rdfs:comment "Detailed explanation of why the event is excluded from IEEE 1366 reliability index calculations, if ieee_1366_exclusion_flag is true. References specific IEEE 1366 exclusion criteria."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "exclusion_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exclusion Reason" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.faultLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the fault location in decimal degrees. Used for spatial reliability analysis and vegetation management correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Fault Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DistributionReliabilityEvent.faultLocationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault location description"@en ;
    rdfs:comment "Textual description of the physical location where the fault occurred (e.g., street address, pole number, landmark). Used for crew dispatch and asset maintenance correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "fault_location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Description" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.faultLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fault longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the fault location in decimal degrees. Used for spatial reliability analysis and vegetation management correlation."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "fault_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Fault Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DistributionReliabilityEvent.flisrOperatedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr operated flag"@en ;
    rdfs:comment "Boolean indicator whether FLISR automation successfully operated to isolate the fault and restore service to unaffected customers. Used to measure FLISR effectiveness and MAIFI (Momentary Average Interruption Frequency Index) reduction."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "flisr_operated_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fault Location Isolation and Service Restoration (FLISR) Operated Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionReliabilityEvent.flisrOperationTimeSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flisr operation time seconds"@en ;
    rdfs:comment "Time in seconds for FLISR automation to isolate the fault and restore service to unaffected segments. Used to measure FLISR performance and reduction in customer-minutes interrupted."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "flisr_operation_time_seconds" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FLISR Operation Time (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:DistributionReliabilityEvent.ieee1366ExclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee 1366 exclusion flag"@en ;
    rdfs:comment "Boolean indicator whether this event should be excluded from IEEE 1366 reliability index calculations per standard exclusion criteria (e.g., loss of supply, prearranged interruption, customer-owned equipment failure)."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ieee_1366_exclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1366 Exclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionReliabilityEvent.loadInterruptedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load interrupted mw"@en ;
    rdfs:comment "Total electrical load in megawatts (MW) interrupted during the event, captured from SCADA or estimated from customer count and load profiles. Used for energy not served (ENS) calculations."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_interrupted_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Interrupted (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DistributionReliabilityEvent.majorEventDayFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "major event day flag"@en ;
    rdfs:comment "Boolean indicator whether this event occurred on a Major Event Day per IEEE 1366 2.5-beta method. Major Event Days are excluded from annual reliability index calculations to prevent catastrophic events from skewing performance metrics."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "major_event_day_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Major Event Day (MED) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionReliabilityEvent.protectiveDeviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protective device type"@en ;
    rdfs:comment "Type of protective device that operated to isolate the fault (e.g., recloser, circuit breaker, fuse, sectionalizer). Used for protective device performance analysis and coordination studies."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "protective_device_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protective Device Type" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.pucReportDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc report date"@en ;
    rdfs:comment "Date when the reliability event was reported to the Public Utility Commission, if puc_reportable_flag is true. Used to track regulatory reporting compliance."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:date ;
    cmm:physicalColumn "puc_report_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PUC Report Date" ;
    cmm:cimDatatype "Date" .
cmm:DistributionReliabilityEvent.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Boolean indicator whether this event must be reported to the state Public Utility Commission per regulatory requirements. Typically true for sustained interruptions affecting a threshold number of customers."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DistributionReliabilityEvent.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Date and time when this reliability event record was first created in the data warehouse. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Date and time when this reliability event record was last modified. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.repairDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "repair description"@en ;
    rdfs:comment "Detailed description of the repair work performed by field crew to restore service, including equipment replaced, temporary repairs, or permanent fixes."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "repair_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Repair Description" ;
    cmm:cimDatatype "String" .
cmm:DistributionReliabilityEvent.restorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration timestamp"@en ;
    rdfs:comment "Date and time when service was fully restored to all affected customers. Used to calculate event duration and customer-minutes interrupted."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:DistributionReliabilityEvent.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) of the distribution circuit affected by the event (e.g., 12.47, 13.2, 34.5). Used for voltage-class reliability analysis."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DistributionReliabilityEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather conditions at the time of the event (e.g., thunderstorm, ice storm, high winds, lightning, normal). Used for weather-related reliability analysis and correlation with cause codes."@en ;
    rdfs:domain cmm:DistributionReliabilityEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:FeederLoadReading a owl:Class ;
    rdfs:label "Feeder Load Reading"@en ;
    rdfs:comment "Transactional record for interval load measurements at feeder head and key monitoring points on the distribution network, sourced from SCADA/OSIsoft PI historian or similar data historian. Captures reading timestamp, feeder or segment identifier, measurement point type (feeder head/midpoint/tie point), active power (MW), reactive power (MVAr), apparent power (MVA), current (A per phase), voltage (kV per phase), power factor, temperature, and data quality flag. SSOT for distribution-level load telemetry distinct from AMI meter interval data owned by the metering domain. Supports load balancing, capacity planning, peak demand analysis, volt-VAR optimization feedback, and normal/emergency rating calculations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AnalogValue ;
    cmm:cimCloseMatch cim:AnalogValue ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.network_operations ;
    cmm:physicalTable "utility_cmm_silver.distribution.feeder_load_reading" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61970-301 Meas; OSIsoft PI Historian / SCADA ICCP / IEC 61968 MDM" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.feeder_load_reading" ;
    owl:hasKey ( cmm:FeederLoadReading.feederLoadReadingId ) .

cmm:FeederLoadReading.feederLoadReadingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder load reading id"@en ;
    rdfs:comment "Unique identifier for the feeder load reading record. Primary key for this transactional measurement event."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "feeder_load_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Feeder Load Reading ID" ;
    cmm:cimDatatype "Integer" .
cmm:FeederLoadReading.distributionFlisrEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution flisr event"@en ;
    rdfs:comment "Identifier linking this reading to a FLISR automation event if the reading was captured during an automated switching sequence. Null if no FLISR event was active."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:DistributionFlisrEvent ;
    cmm:physicalColumn "distribution_flisr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "FLISR (Fault Location, Isolation, and Service Restoration) Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_distribution_flisr_event_id" ;
    cmm:cimAssociation "AnalogValue.PSREvent" .
cmm:FeederLoadReading.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Identifier linking this reading to an outage event if the reading was captured during or immediately after an outage. Null if no outage was active at reading time."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_event_id" ;
    cmm:cimAssociation "AnalogValue.Outage" .
cmm:FeederLoadReading.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Actual feeder load readings must be compared against load forecasts for accuracy measurement and model calibration. Essential for forecast accuracy tracking, MAPE calculation, model validation, and co"@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_load_id" ;
    cmm:cimAssociation "AnalogValue.ConformLoadSchedule" .
cmm:FeederLoadReading.measurementPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "measurement point"@en ;
    rdfs:comment "Unique identifier for the specific monitoring point on the feeder where the reading was captured (e.g., feeder head, midpoint sensor, tie point). Corresponds to SCADA tag or PI point identifier."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "measurement_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Measurement Point ID" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_measurement_point_id" ;
    cmm:cimAssociation "AnalogValue.UsagePoint" .
cmm:FeederLoadReading.primaryFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder or circuit segment where the load measurement was taken. Links to the feeder asset in the distribution network topology."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "primary_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder ID" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_primary_feeder_id" ;
    cmm:cimAssociation "AnalogValue.Feeder" .
cmm:FeederLoadReading.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Foreign key linking to grid.state_estimation_run. Business justification: Feeder load measurements provide boundary condition inputs to transmission state estimators for distribution-transmission interface modeling. Essential for accurate voltage/power flow analysis and con"@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimation Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_state_estimation_run_id" ;
    cmm:cimAssociation "AnalogValue.ActivityRecord" .
cmm:FeederLoadReading.tertiaryFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — Feeder load readings are measurements taken at feeder head or monitoring points. The feeder FK is essential for associating readings with the correct feeder for load analysis and capacity planning."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "tertiary_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_feeder_load_reading_tertiary_feeder_id" ;
    cmm:cimAssociation "AnalogValue.Feeder" .
cmm:FeederLoadReading.activePowerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active power mw"@en ;
    rdfs:comment "Real power measured in megawatts (MW) at the monitoring point. Represents the actual power flowing through the feeder segment at the reading timestamp. Used for load balancing and capacity planning."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "active_power_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Power (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FeederLoadReading.ambientTemperatureCelsius a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ambient temperature celsius"@en ;
    rdfs:comment "Ambient temperature in degrees Celsius at or near the monitoring point. Used for thermal rating adjustments and equipment derating calculations under high-temperature conditions."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ambient_temperature_celsius" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ambient Temperature (Celsius)" ;
    cmm:unitSymbol "degC" ;
    cmm:cimDatatype "Temperature" .
cmm:FeederLoadReading.apparentPowerMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apparent power mva"@en ;
    rdfs:comment "Apparent power measured in megavolt-amperes (MVA) at the monitoring point. Represents the total power (vector sum of active and reactive power) and is used for equipment rating and capacity calculations."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "apparent_power_mva" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apparent Power (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:FeederLoadReading.currentPhaseAAmperes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current phase a amperes"@en ;
    rdfs:comment "Current measured on Phase A conductor in amperes at the monitoring point. Used for load balancing across phases and thermal limit monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_phase_a_amperes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phase A (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:FeederLoadReading.currentPhaseBAmperes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current phase b amperes"@en ;
    rdfs:comment "Current measured on Phase B conductor in amperes at the monitoring point. Used for load balancing across phases and thermal limit monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_phase_b_amperes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phase B (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:FeederLoadReading.currentPhaseCAmperes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current phase c amperes"@en ;
    rdfs:comment "Current measured on Phase C conductor in amperes at the monitoring point. Used for load balancing across phases and thermal limit monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_phase_c_amperes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phase C (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:FeederLoadReading.dataQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality flag"@en ;
    rdfs:comment "Quality indicator for the reading. Good indicates validated data; suspect indicates data outside normal range but not rejected; bad indicates failed validation; estimated indicates imputed value; missing indicates no data received. Aligns with VEE (Validation, Estimation, and Editing) processes."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_quality_flag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Flag" ;
    cmm:validValues "good|suspect|bad|estimated|missing" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:FeederLoadReading.dataRetentionCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data retention category"@en ;
    rdfs:comment "Classification determining the retention period for this reading. Operational (1-2 years); regulatory (5-7 years per FERC/PUC requirements); historical (10+ years for trend analysis); archive (permanent retention for critical events)."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_retention_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Retention Category" ;
    cmm:validValues "operational|regulatory|historical|archive" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.dataSourceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source type"@en ;
    rdfs:comment "Classification of the data acquisition method. SCADA realtime indicates live telemetry; historian archive indicates retrieved from PI or similar historian; manual entry indicates operator-entered value; estimated indicates calculated/imputed value."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source Type" ;
    cmm:validValues "scada_realtime|historian_archive|manual_entry|estimated" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.derGenerationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der generation flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether DER generation (solar, wind, battery storage) was active on this feeder segment at the time of reading. Used for DER impact analysis and reverse power flow detection."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_generation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER (Distributed Energy Resource) Generation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FeederLoadReading.emergencyRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emergency rating mva"@en ;
    rdfs:comment "Emergency short-term thermal rating of the feeder segment in MVA. Represents the maximum load that can be carried for a limited duration (typically 15 minutes to 4 hours) during contingency conditions."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emergency_rating_mva" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emergency Rating (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:FeederLoadReading.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "Method used to estimate the reading value if actual data was missing or invalid. None indicates no estimation was performed; other values indicate the specific estimation algorithm applied per MDM VEE rules."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Method" ;
    cmm:validValues "none|linear_interpolation|historical_average|similar_day|regression_model" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.frequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency hz"@en ;
    rdfs:comment "System frequency measured in hertz at the monitoring point. Nominal value is 60 Hz in North America; deviations indicate grid stability issues and are monitored per NERC reliability standards."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_hz" ;
    cmm:sqlDataType "DECIMAL(6,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:FeederLoadReading.loadingPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "loading percentage"@en ;
    rdfs:comment "Percentage of normal rating currently being utilized, calculated as (apparent_power_mva / normal_rating_mva) * 100. Key metric for capacity planning and identifying overloaded feeders."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "loading_percentage" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Loading Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:FeederLoadReading.measurementPointType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement point type"@en ;
    rdfs:comment "Classification of the monitoring location on the distribution network. Feeder head represents the substation exit point; midpoint and tie point represent intermediate monitoring locations; recloser, capacitor bank, and regulator represent device-level monitoring points."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_point_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Point Type" ;
    cmm:validValues "feeder_head|midpoint|tie_point|recloser|capacitor_bank|regulator" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.normalRatingMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal rating mva"@en ;
    rdfs:comment "Normal continuous thermal rating of the feeder segment in MVA under standard ambient conditions. Used to calculate loading percentage and identify overload conditions."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normal_rating_mva" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Rating (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:FeederLoadReading.peakDemandFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this reading occurred during a system peak demand period. Used for peak demand analysis and capacity planning studies."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "peak_demand_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FeederLoadReading.piPointName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi point name"@en ;
    rdfs:comment "OSIsoft PI point tag name or equivalent historian tag identifier for this measurement. Provides traceability back to the source SCADA tag in the historian system."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_point_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PI (Plant Information) Point Name" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "Ratio of active power to apparent power (dimensionless, range -1.0 to +1.0). Indicates the efficiency of power delivery and is a key input for volt-VAR optimization and capacitor bank control."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:FeederLoadReading.reactivePowerMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power mvar"@en ;
    rdfs:comment "Reactive power measured in megavolt-amperes reactive (MVAr) at the monitoring point. Critical for volt-VAR optimization and power factor management on the distribution network."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_mvar" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power (MVAr)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:FeederLoadReading.readingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reading timestamp"@en ;
    rdfs:comment "Date and time when the load measurement was recorded by the SCADA system or data historian. Represents the actual event time of the observation, distinct from record creation time."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "reading_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reading Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:FeederLoadReading.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this record was first inserted into the lakehouse silver layer. Distinct from reading_timestamp which represents the actual measurement event time. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:FeederLoadReading.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Timestamp when this record was last modified in the lakehouse silver layer. Updated when VEE processes revise data quality flags or estimation values. Used for change tracking and audit trail."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeasurementValue.timeStamp .
cmm:FeederLoadReading.reversePowerFlowFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reverse power flow flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether power was flowing in the reverse direction (from customer premises back to substation) at the time of reading. Indicates high DER penetration or net export conditions."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reverse_power_flow_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reverse Power Flow Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FeederLoadReading.scadaSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada source system"@en ;
    rdfs:comment "Name or identifier of the SCADA system or data historian that originated this reading (e.g., OSIsoft PI, GE iFIX, Schneider ClearSCADA). Used for data lineage and troubleshooting."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Source System" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of the VEE (Validation, Estimation, and Editing) process for this reading. Validated indicates the reading passed all quality checks; pending indicates awaiting validation; failed indicates rejected by validation rules; bypassed indicates validation was skipped."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Status" ;
    cmm:validValues "validated|pending|failed|bypassed" ;
    cmm:cimDatatype "String" .
cmm:FeederLoadReading.voltagePhaseAKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage phase a kv"@en ;
    rdfs:comment "Voltage measured on Phase A in kilovolts at the monitoring point. Critical for voltage regulation and ANSI C84.1 compliance monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_phase_a_kv" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phase A (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:FeederLoadReading.voltagePhaseBKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage phase b kv"@en ;
    rdfs:comment "Voltage measured on Phase B in kilovolts at the monitoring point. Critical for voltage regulation and ANSI C84.1 compliance monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_phase_b_kv" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phase B (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:FeederLoadReading.voltagePhaseCKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage phase c kv"@en ;
    rdfs:comment "Voltage measured on Phase C in kilovolts at the monitoring point. Critical for voltage regulation and ANSI C84.1 compliance monitoring."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_phase_c_kv" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phase C (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:FeederLoadReading.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "General weather condition at the time of reading. Used for correlating load patterns with weather events and for storm impact analysis. Reference-value candidates: clear|cloudy|rain|snow|storm|extreme_heat|extreme_cold."@en ;
    rdfs:domain cmm:FeederLoadReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:DerInterconnectionPoint a owl:Class ;
    rdfs:label "Der Interconnection Point"@en ;
    rdfs:comment "Master record for the physical point of interconnection (POI) where a Distributed Energy Resource connects to the distribution network. Captures POI identifier, DER type (solar PV/battery/EV charger/CHP/wind), nameplate capacity (kW), inverter type and settings, interconnection voltage level, feeder and segment assignment, GIS location, NEM eligibility, anti-islanding protection scheme, DERMS reference, IEEE 1547 compliance status, and interconnection agreement status. SSOT for DER physical connection points on the distribution network. Supports hosting capacity analysis, DERMS integration, reverse power flow monitoring, and state interconnection rule compliance (e.g., Rule 21, SB 700)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ConnectivityNode ;
    cmm:cimCloseMatch cim:ConnectivityNode ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.der_interconnection_point" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEEE 1547 (RPA/PCC); IEEE 1547 / IEC CIM PowerElectronicsConnection / DERMS POI" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.der_interconnection_point" ;
    owl:hasKey ( cmm:DerInterconnectionPoint.derInterconnectionPointId ) .

cmm:DerInterconnectionPoint.derInterconnectionPointId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection point id"@en ;
    rdfs:comment "Unique identifier for the physical point of interconnection where a DER connects to the distribution network. Primary key for the DER interconnection point master record."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_interconnection_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Interconnection Point Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DerInterconnectionPoint.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: DER interconnection studies, inspections, and ongoing monitoring incur costs tracked to cost centers for potential cost recovery in rates or DER program cost allocation. Required for regulatory cost r"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_cost_center_id" ;
    cmm:cimAssociation "ConnectivityNode.Organisation" .
cmm:DerInterconnectionPoint.derNetworkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der network segment"@en ;
    rdfs:comment "Reference to the specific segment of the feeder where the DER connects. Used for granular hosting capacity analysis and voltage profile management."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "der_network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Segment Identifier" ;
    cmm:sourceColumn "network_segment_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_der_network_segment_id" ;
    cmm:cimAssociation "ConnectivityNode.EquipmentContainer" .
cmm:DerInterconnectionPoint.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Reference to the distribution substation serving this interconnection point. Used for substation-level DER aggregation and transformer loading analysis."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Substation Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_distribution_substation_id" ;
    cmm:cimAssociation "ConnectivityNode.Substation" .
cmm:DerInterconnectionPoint.environmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: DER installations require environmental permits for land use, stormwater management, and emissions (for fossil-fuel DER). Interconnection approval processes verify permit compliance before permission"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Environmental Permit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_environmental_permit_id" ;
    cmm:cimAssociation "ConnectivityNode.Document" .
cmm:DerInterconnectionPoint.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — DER interconnection points are assigned to feeders. This FK supports hosting capacity analysis (how much DER can this feeder absorb?) and reverse power flow monitoring."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_feeder_id" ;
    cmm:cimAssociation "ConnectivityNode.Feeder" .
cmm:DerInterconnectionPoint.forecastRenewable a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast renewable"@en ;
    rdfs:comment "Foreign key linking to forecast.forecast_renewable. Business justification: DER interconnection points are the physical assets for which renewable generation forecasts are prepared. Essential for DER dispatch, hosting capacity analysis, grid impact studies, and managing distr"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:ForecastRenewable ;
    cmm:physicalColumn "forecast_renewable_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Renewable Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_forecast_renewable_id" ;
    cmm:cimAssociation "ConnectivityNode.RegularIntervalSchedule" .
cmm:DerInterconnectionPoint.interconnectionEngineerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection engineer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: DER interconnections require designated engineers for technical review, IEEE 1547 compliance verification, hosting capacity analysis, and ongoing performance monitoring. Regulatory requirement under s"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "interconnection_engineer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Engineer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_interconnection_engineer_employee_id" ;
    cmm:cimAssociation "ConnectivityNode.ErpPersonnel" .
cmm:DerInterconnectionPoint.inverterMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inverter material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: DER inverters and interconnection equipment are procured materials requiring material master linkage for approved equipment lists, warranty tracking, and standardization. Supports DER interconnection"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "inverter_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Inverter Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_inverter_material_master_id" ;
    cmm:cimAssociation "ConnectivityNode.ErpItemMaster" .
cmm:DerInterconnectionPoint.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to metering.meter. Business justification: DER interconnection points require dedicated revenue-quality metering for net metering billing, export credit calculation, IEEE 1547 compliance monitoring, and interconnection agreement validation. Re"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_meter_id" ;
    cmm:cimAssociation "ConnectivityNode.Meter" .
cmm:DerInterconnectionPoint.ppa a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa"@en ;
    rdfs:comment "Foreign key linking to trading.ppa. Business justification: DER facilities often operate under power purchase agreements. Interconnection points track the physical delivery infrastructure for PPA generation, essential for contract compliance, settlement reconc"@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:TradingPpa ;
    cmm:physicalColumn "ppa_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ppa Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_ppa_id" ;
    cmm:cimAssociation "ConnectivityNode.Agreement" .
cmm:DerInterconnectionPoint.primaryFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary feeder"@en ;
    rdfs:comment "Reference to the distribution feeder circuit to which this DER is connected. Critical for hosting capacity analysis, reverse power flow monitoring, and feeder-level DER aggregation."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "primary_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_primary_feeder_id" ;
    cmm:cimAssociation "ConnectivityNode.Feeder" .
cmm:DerInterconnectionPoint.primaryNetworkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary network segment"@en ;
    rdfs:comment "FK to distribution.network_segment.network_segment_id — DER interconnection points connect at specific network segments. Segment-level assignment is needed for detailed hosting capacity analysis and voltage impact studies."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "primary_network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_primary_network_segment_id" ;
    cmm:cimAssociation "ConnectivityNode.EquipmentContainer" .
cmm:DerInterconnectionPoint.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Reference to the SCADA telemetry point monitoring this DER interconnection. Links to real-time power flow, voltage, and status data in the distribution management system."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_scada_point_id" ;
    cmm:cimAssociation "ConnectivityNode.Measurement" .
cmm:DerInterconnectionPoint.servicePoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service point"@en ;
    rdfs:comment "Reference to the customer service point (meter location) associated with this DER interconnection. Links DER to billing, metering, and customer account systems."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "service_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point Identifier" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_service_point_id" ;
    cmm:cimAssociation "ConnectivityNode.UsagePoint" .
cmm:DerInterconnectionPoint.tertiaryFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary feeder"@en ;
    rdfs:comment "FK to distribution.feeder.feeder_id — DER interconnection points are located on specific feeders. This FK is required for hosting capacity analysis, reverse power flow monitoring, and feeder-level DER penetration tracking."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "tertiary_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_der_interconnection_point_tertiary_feeder_id" ;
    cmm:cimAssociation "ConnectivityNode.Feeder" .
cmm:DerInterconnectionPoint.antiIslandingProtection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "anti islanding protection"@en ;
    rdfs:comment "Type of anti-islanding protection implemented to prevent the DER from energizing a de-energized section of the grid. Required by IEEE 1547 for all grid-connected DERs."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "anti_islanding_protection" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Anti-Islanding Protection Scheme" ;
    cmm:validValues "passive|active|hybrid" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date the DER system was commissioned and tested for proper operation. Precedes permission to operate and marks completion of installation."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:DerInterconnectionPoint.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this DER interconnection point record was first created in the system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ConnectivityNode.createdDateTime .
cmm:DerInterconnectionPoint.decommissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decommissioning date"@en ;
    rdfs:comment "Date the DER was permanently disconnected from the grid and removed from service. Triggers termination of interconnection agreement and NEM enrollment."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "decommissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Decommissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:DerInterconnectionPoint.derSubtype a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der subtype"@en ;
    rdfs:comment "Detailed classification of the DER technology, such as lithium-ion battery, rooftop solar, ground-mount solar, Level 2 EV charger, DC fast charger, natural gas CHP, etc."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_subtype" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Subtype" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.derType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der type"@en ;
    rdfs:comment "Classification of the distributed energy resource technology connected at this point. Determines applicable interconnection standards, protection requirements, and DERMS control capabilities. Reference-value candidates: solar_pv|battery_storage|ev_charger|chp|wind|fuel_cell|microgrid."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ConnectivityNode.kind .
cmm:DerInterconnectionPoint.dermsDeviceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derms device code"@en ;
    rdfs:comment "Unique identifier for this DER in the DERMS platform. Used for real-time monitoring, dispatch commands, and aggregation into virtual power plants."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "derms_device_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource Management System (DERMS) Device Identifier" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.dermsIntegrationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derms integration enabled"@en ;
    rdfs:comment "Indicates whether this DER is integrated with the utility DERMS for monitoring and control. True enables participation in demand response, VPP aggregation, and grid services programs."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "derms_integration_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource Management System (DERMS) Integration Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInterconnectionPoint.exportCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export capacity kw"@en ;
    rdfs:comment "Maximum power the DER is authorized to export to the distribution grid in kilowatts. May be less than nameplate capacity due to interconnection agreement limits or hosting capacity constraints."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "export_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerInterconnectionPoint.exportLimitControlMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export limit control method"@en ;
    rdfs:comment "Method used to enforce export capacity limits: inverter setpoint, revenue-grade meter with control, or DERMS dispatch. Determines compliance verification approach."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "export_limit_control_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Limit Control Method" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.frequencyWattControlEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency watt control enabled"@en ;
    rdfs:comment "Indicates whether the DER inverter is configured to provide frequency-watt droop control for grid frequency support. Category B IEEE 1547 capability for frequency stability."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "frequency_watt_control_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Frequency-Watt Control Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInterconnectionPoint.gisFeatureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis feature code"@en ;
    rdfs:comment "Unique identifier for the DER interconnection point in the utility GIS system. Links to network topology, asset location, and spatial analysis tools."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_feature_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Feature Identifier" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:DerInterconnectionPoint.hostingCapacityImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hosting capacity impact mw"@en ;
    rdfs:comment "Estimated impact of this DER on the feeder hosting capacity in megawatts. Used for cumulative hosting capacity tracking and interconnection queue management."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hosting_capacity_impact_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hosting Capacity Impact (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerInterconnectionPoint.ieee1547Category a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee 1547 category"@en ;
    rdfs:comment "IEEE 1547 classification based on DER capabilities. Category A: basic interconnection functions. Category B: advanced grid support functions including voltage/frequency ride-through and reactive power control."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ieee_1547_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1547 DER Category" ;
    cmm:validValues "category_a|category_b" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.ieee1547ComplianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee 1547 compliance status"@en ;
    rdfs:comment "Certification status indicating whether the DER interconnection meets IEEE 1547 standard requirements for grid interconnection and interoperability. Grandfathered indicates pre-2018 installations under prior standards."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ieee_1547_compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IEEE 1547 Compliance Status" ;
    cmm:validValues "compliant|non_compliant|pending_verification|grandfathered" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.interconnectionAgreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement number"@en ;
    rdfs:comment "Unique identifier for the legal interconnection agreement between the utility and the DER owner. References the contract governing technical requirements, liability, and operational terms."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interconnection Agreement Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DerInterconnectionPoint.interconnectionAgreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection agreement status"@en ;
    rdfs:comment "Current status of the interconnection agreement in its approval and execution lifecycle. Executed status required before DER can be energized."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "interconnection_agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Agreement Status" ;
    cmm:validValues "pending|approved|executed|expired|terminated" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.interconnectionApplicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application date"@en ;
    rdfs:comment "Date the customer submitted the interconnection application to the utility. Used for queue management and regulatory timeline compliance tracking."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "interconnection_application_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Application Date" ;
    cmm:cimDatatype "Date" .
cmm:DerInterconnectionPoint.interconnectionApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection approval date"@en ;
    rdfs:comment "Date the utility approved the interconnection application after technical review and impact studies. Marks transition from pending to approved status."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "interconnection_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:DerInterconnectionPoint.interconnectionVoltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection voltage level kv"@en ;
    rdfs:comment "Distribution system voltage level at which the DER connects, typically 0.12 kV (120V), 0.24 kV (240V), 0.48 kV (480V), 4.16 kV, 12.47 kV, or 34.5 kV. Determines applicable interconnection standards and protection requirements."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interconnection_voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:DerInterconnectionPoint.inverterSerialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter serial number"@en ;
    rdfs:comment "Unique serial number of the inverter unit. Used for asset tracking, warranty claims, and field service management."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "inverter_serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inverter Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:DerInterconnectionPoint.inverterType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter type"@en ;
    rdfs:comment "Classification of the inverter technology used to convert DC power to AC for grid interconnection. Determines control capabilities, grid support functions, and IEEE 1547 compliance requirements."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "inverter_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inverter Type" ;
    cmm:validValues "string|central|micro|hybrid|battery_integrated" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the DER interconnection point in decimal degrees. Used for GIS mapping, spatial analysis, and solar irradiance modeling."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:DerInterconnectionPoint.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the DER interconnection point in decimal degrees. Used for GIS mapping, spatial analysis, and solar irradiance modeling."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:DerInterconnectionPoint.nameplateCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity kw"@en ;
    rdfs:comment "Maximum rated power output of the DER in kilowatts as specified by the manufacturer. Critical for hosting capacity analysis, interconnection approval, and grid impact studies."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Nameplate Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerInterconnectionPoint.nemEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem eligible"@en ;
    rdfs:comment "Indicates whether this DER interconnection qualifies for net energy metering under state tariffs. True if the DER meets NEM program requirements for capacity, technology type, and customer class."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Eligible" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInterconnectionPoint.nemProgramType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem program type"@en ;
    rdfs:comment "Specific NEM program under which this DER is enrolled, such as NEM 2.0, NEM 3.0, virtual net metering, or aggregate net metering. Determines compensation rates and billing treatment."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Program Type" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional information about the interconnection point, such as special operating conditions, equipment modifications, or field observations."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interconnection Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DerInterconnectionPoint.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the DER interconnection point in its lifecycle. Active indicates the DER is energized and may export/import power; pending_approval indicates interconnection application under review."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "active|inactive|pending_approval|commissioned|decommissioned|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ConnectivityNode.status .
cmm:DerInterconnectionPoint.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Classification of DER ownership structure. Determines billing treatment, incentive eligibility, and operational control rights."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER Ownership Type" ;
    cmm:validValues "customer_owned|third_party_owned|utility_owned|community_solar" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.permissionToOperateDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permission to operate date"@en ;
    rdfs:comment "Date the utility granted permission for the DER to begin exporting power to the grid. Follows successful inspection and commissioning. Required for NEM billing start."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "permission_to_operate_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Date" ;
    cmm:cimDatatype "Date" .
cmm:DerInterconnectionPoint.phaseConnection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase connection"@en ;
    rdfs:comment "Electrical phase configuration of the interconnection. Single-phase for residential; three-phase for commercial/industrial. Impacts load balancing and voltage regulation."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_connection" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Connection Type" ;
    cmm:validValues "single_phase|three_phase_wye|three_phase_delta" ;
    cmm:cimDatatype "String" .
cmm:DerInterconnectionPoint.poiName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi name"@en ;
    rdfs:comment "Descriptive name for the interconnection point, typically including customer name or site identifier for operational reference."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Point of Interconnection (POI) Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:DerInterconnectionPoint.poiNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi number"@en ;
    rdfs:comment "Business identifier for the point of interconnection assigned by the utility. Used in interconnection agreements, DERMS integration, and regulatory filings."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Point of Interconnection (POI) Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:DerInterconnectionPoint.premiseId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "premise id"@en ;
    rdfs:comment "Reference to the customer premise where the DER is installed. Used for customer communication, site access coordination, and premise-level energy analytics."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:long ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Premise Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DerInterconnectionPoint.reversePowerFlowEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reverse power flow enabled"@en ;
    rdfs:comment "Indicates whether this DER is authorized to export power back to the grid (reverse power flow). False for load-only or self-consumption-only installations."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reverse_power_flow_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reverse Power Flow Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:DerInterconnectionPoint.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this DER interconnection point record was last modified. Used for change tracking and data synchronization."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DerInterconnectionPoint.voltVarControlEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "volt var control enabled"@en ;
    rdfs:comment "Indicates whether the DER inverter is configured to provide autonomous volt-VAR control for voltage regulation. Category B IEEE 1547 capability supporting grid voltage stability."@en ;
    rdfs:domain cmm:DerInterconnectionPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "volt_var_control_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Volt-VAR Control Enabled" ;
    cmm:cimDatatype "Boolean" .

cmm:ServiceTerritory a owl:Class ;
    rdfs:label "Service Territory"@en ;
    rdfs:comment "Master reference record defining geographic franchise areas within which the utility holds the obligation to serve. Captures territory identifier, territory name, regulatory jurisdiction (state PUC), geographic boundary (GIS polygon), voltage service levels, customer count, total connected load (MW), associated substations, and franchise agreement reference. Used as a grouping dimension for PUC reliability reporting (SAIDI/SAIFI by territory), load planning, rate case filings, and regulatory compliance. SSOT for service territory boundaries in the distribution network."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:SubGeographicalRegion ;
    cmm:cimCloseMatch cim:SubGeographicalRegion ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.asset_management ;
    cmm:physicalTable "utility_cmm_silver.distribution.service_territory" ;
    cmm:dataClassification "reference_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "PUC Franchise Territory / Esri ArcGIS Service Territory" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.service_territory" ;
    owl:hasKey ( cmm:ServiceTerritory.serviceTerritoryId ) .

cmm:ServiceTerritory.serviceTerritoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory id"@en ;
    rdfs:comment "Unique identifier for the service territory. Primary key."@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Service Territory Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ServiceTerritory.emergencyResponsePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "emergency response plan"@en ;
    rdfs:comment "Identifier for the emergency response and storm restoration plan specific to this territory."@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:EmergencyResponsePlan ;
    cmm:physicalColumn "emergency_response_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Emergency Response Plan Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_territory_emergency_response_plan_id" ;
    cmm:cimAssociation "SubGeographicalRegion.Document" .
cmm:ServiceTerritory.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Service territories are top-level geographic planning units; forecast zones are typically subdivisions or aggregations within territories. Required for IRP filings, regulatory reporting, territorial l"@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_territory_forecast_zone_id" ;
    cmm:cimAssociation "SubGeographicalRegion.LoadArea" .
cmm:ServiceTerritory.operatingOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operating org unit"@en ;
    rdfs:comment "Foreign key linking to workforce.org_unit. Business justification: Service territories map to organizational units for management structure, cost center allocation, union jurisdiction, and operational accountability. Fundamental for financial reporting, labor cost al"@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "operating_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operating Org Unit Id (Foreign Key)" ;
    cmm:sourceColumn "org_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_territory_operating_org_unit_id" ;
    cmm:cimAssociation "SubGeographicalRegion.Organisation" .
cmm:ServiceTerritory.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Service territories are the primary geographic/functional units for revenue and cost tracking, directly mapping to profit center structures for regulatory reporting, rate case revenue requirement allo"@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_territory_profit_center_id" ;
    cmm:cimAssociation "SubGeographicalRegion.Organisation" .
cmm:ServiceTerritory.rateCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case"@en ;
    rdfs:comment "Foreign key linking to compliance.rate_case. Business justification: Service territories define the geographic and customer scope for rate cases. Rate base, revenue requirements, and rate design are calculated per service territory. Essential for linking territory-leve"@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:RateCase ;
    cmm:physicalColumn "rate_case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Case Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_service_territory_rate_case_id" ;
    cmm:cimAssociation "SubGeographicalRegion.Document" .
cmm:ServiceTerritory.serviceLevelAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service level agreement"@en ;
    rdfs:comment "Identifier for the Service Level Agreement (SLA) defining performance commitments for this territory."@en ;
    rdfs:domain cmm:ServiceTerritory ; rdfs:range cmm:ServiceLevelAgreement ;
    cmm:physicalColumn "service_level_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
