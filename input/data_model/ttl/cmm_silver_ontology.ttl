cmm:TransmissionOutage.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when the outage record was last modified. Tracks changes to outage status, duration, or other attributes throughout the lifecycle."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:TransmissionOutage.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Operating voltage level in kilovolts of the transmission facility experiencing the outage. Determines BES classification and reporting requirements."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level Kilovolts (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:TransmissionOutage.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather conditions at the time of the outage (e.g., clear, rain, snow, ice, wind, lightning). Important for cause analysis and predictive modeling."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.windSpeedMph a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "wind speed mph"@en ;
    rdfs:comment "Wind speed in miles per hour at the time of the outage. Critical for weather-related outage analysis and line rating calculations."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
