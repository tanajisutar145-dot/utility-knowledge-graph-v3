cmm:ApplicationDocument a owl:Class ;
    rdfs:label "Application Document"@en ;
    rdfs:comment "Record of documents submitted or issued as part of an interconnection application package. Captures document type (single-line diagram, site plan, equipment specification sheet, inverter datasheet, UL 1741 certification, load calculation, executed agreement, insurance certificate, permit, as-built drawing), document name, file reference, submission date, submitted by (applicant or utility), document status (received, under review, accepted, rejected, superseded), rejection reason, and required resubmission deadline. Manages the document lifecycle for interconnection application completeness determination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimCloseMatch cim:Document ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.application_management ;
    cmm:physicalTable "utility_cmm_silver.interconnection.application_document" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Interconnection Application Document Package" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.application_document" ;
    owl:hasKey ( cmm:ApplicationDocument.applicationDocumentId ) .

cmm:ApplicationDocument.applicationDocumentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application document id"@en ;
    rdfs:comment "Unique identifier for the interconnection application document record. Primary key."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range xsd:long ;
    cmm:physicalColumn "application_document_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Application Document Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ApplicationDocument.evidenceRecord a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evidence record"@en ;
    rdfs:comment "Foreign key linking to compliance.evidence_record. Business justification: Key interconnection documents (UL 1741 certifications, witness test reports, as-built drawings, protection settings) serve as compliance evidence for regulatory audits verifying interconnection standa"@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range cmm:EvidenceRecord ;
    cmm:physicalColumn "evidence_record_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Evidence Record Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_document_evidence_record_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ApplicationDocument.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Reference to the parent interconnection application to which this document belongs. Links document to the application package."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Identifier (ID)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_application_document_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:ApplicationDocument.primaryApplicationEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary application employee"@en ;
    rdfs:comment "Reference to the utility engineer or reviewer who performed the technical or administrative review of the document."@en ;
    rdfs:domain cmm:ApplicationDocument ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_application_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
