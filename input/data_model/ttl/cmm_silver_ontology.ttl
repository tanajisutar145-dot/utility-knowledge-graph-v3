    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_trade_id" ;
    cmm:cimAssociation "CustomerBillingInfo.Trade" .
cmm:CustomerInvoice.adjustmentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjustment amount"@en ;
    rdfs:comment "Total adjustments applied to the invoice including credits, refunds, billing corrections, and dispute resolutions. Positive for credits, negative for additional charges."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:decimal ;
