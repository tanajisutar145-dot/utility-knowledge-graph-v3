cmm:PowerPlant.derFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der flag"@en ;
    rdfs:comment "Indicates whether the facility is classified as a Distributed Energy Resource (DER) connected at distribution voltage levels."@en ;
