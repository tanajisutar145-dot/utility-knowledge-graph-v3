cmm:EnforcementAction.violationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation start date"@en ;
    rdfs:comment "Start date of the period during which the alleged violation occurred or non-compliance existed."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:date ;
    cmm:physicalColumn "violation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Period Start Date" ;
