    cmm:cimDatatype "String" .
cmm:IncentiveProgram.incentiveRateUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate unit"@en ;
    rdfs:comment "Unit of measure for the incentive rate value (e.g., USD_per_kW, USD_per_MWh, USD_per_REC, percent, USD for fixed amounts)."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_rate_unit" ;
