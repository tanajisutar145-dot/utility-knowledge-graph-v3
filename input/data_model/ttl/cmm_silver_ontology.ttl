    rdfs:label "source point of receipt"@en ;
    rdfs:comment "Designated point of receipt (POR) or source location where power enters the transmission system under this agreement."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_point_of_receipt" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
