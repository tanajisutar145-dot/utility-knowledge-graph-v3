    rdfs:label "validation error count"@en ;
    rdfs:comment "Number of validation errors or inconsistencies detected in this topology snapshot during quality checks."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:int ;
    cmm:physicalColumn "validation_error_count" ;
