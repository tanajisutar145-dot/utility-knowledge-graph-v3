cmm:DrIncentivePayment.primaryDrEventParticipant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary dr event participant"@en ;
    rdfs:comment "FK to demand.dr_event_participant.dr_event_participant_id — Incentive payments are calculated based on participant performance in events. Required for financial reconciliation and customer payment accuracy."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrEventParticipant ;
    cmm:physicalColumn "primary_dr_event_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
