cmm:EmergencyStockEvent.lessonsLearnedSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lessons learned summary"@en ;
    rdfs:comment "Summary of key lessons learned from the emergency event and material deployment, used for continuous improvement of supply chain resilience."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "lessons_learned_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Lessons Learned Summary" ;
