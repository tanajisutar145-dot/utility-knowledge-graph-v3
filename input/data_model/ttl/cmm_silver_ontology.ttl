cmm:ContractorCompany.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of the contractor with industry regulations."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.contractorType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor type"@en ;
    rdfs:comment "Category describing the primary business focus of the contractor."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "contractor_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Organisation.kind .
cmm:ContractorCompany.countryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "country code"@en ;
    rdfs:comment "Three-letter ISO country code of the contractor's primary address."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "country_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.country .
cmm:ContractorCompany.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the contractor record was first created in the system."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Organisation.createdDateTime .
cmm:ContractorCompany.creditRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit rating"@en ;
    rdfs:comment "Credit rating assigned to the contractor by a rating agency."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.effectiveFrom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective from"@en ;
    rdfs:comment "Date when the contractor relationship becomes effective."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_from" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:ContractorCompany.effectiveUntil a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective until"@en ;
    rdfs:comment "Date when the contractor relationship ends or is scheduled to end (null if open-ended)."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_until" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:ContractorCompany.email a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "email"@en ;
    rdfs:comment "General email address for the contractor company."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "email" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_email" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "ElectronicAddress.email1" .
cmm:ContractorCompany.esgScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "esg score"@en ;
    rdfs:comment "Overall ESG rating for the contractor company."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "esg_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
