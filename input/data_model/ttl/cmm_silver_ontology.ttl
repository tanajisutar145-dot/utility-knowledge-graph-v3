    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RateSchedule.customerChargeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer charge amount"@en ;
    rdfs:comment "Fixed monthly customer charge in dollars applicable under this rate schedule. Covers meter reading, billing, and basic service costs."@en ;
