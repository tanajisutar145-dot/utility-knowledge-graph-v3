cmm:ControlArea.geographicBoundaryDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic boundary description"@en ;
    rdfs:comment "Textual description of the geographic and electrical boundaries defining the control area's operational footprint."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_boundary_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Boundary Description" ;
    cmm:cimDatatype "String" .
cmm:ControlArea.installedGenerationCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installed generation capacity mw"@en ;
    rdfs:comment "Total installed generation capacity in megawatts available within the control area boundaries."@en ;
