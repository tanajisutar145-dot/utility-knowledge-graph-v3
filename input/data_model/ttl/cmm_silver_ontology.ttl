cmm:Contingency.voltageViolationHighKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violation high kv"@en ;
    rdfs:comment "Upper voltage limit in kilovolts (kV) above which a voltage violation is flagged for this contingency."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:decimal ;
