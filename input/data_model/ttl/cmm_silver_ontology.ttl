cmm:ServicePoint a owl:Class ;
    rdfs:label "Service Point"@en ;
    rdfs:comment "Master reference table for service_point. Referenced by service_point_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:UsagePoint ;
    cmm:cimCloseMatch cim:UsagePoint ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.meter_management ;
    cmm:physicalTable "utility_cmm_silver.metering.service_point" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "UsagePoint.UsagePointLocation" ;
    cmm:standardReference "IEC 61968-9" ;
    cmm:sourceObject "energy_utilities_ecm.metering.service_point" ;
    owl:hasKey ( cmm:ServicePoint.servicePointId ) .

