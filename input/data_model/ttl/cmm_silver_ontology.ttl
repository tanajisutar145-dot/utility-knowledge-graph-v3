cmm:AncillaryServiceOffer.offerIntervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer interval start timestamp"@en ;
    rdfs:comment "Start date and time of the operating interval for which the ancillary service is offered."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "offer_interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AncillaryServiceOffer.offerNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer number"@en ;
    rdfs:comment "External business identifier for the ancillary service offer as assigned by the ISO/RTO or internal trading system."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "offer_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Offer Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AncillaryServiceOffer.offerPriceCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer price currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the offer price (USD for United States Dollar, CAD for Canadian Dollar, MXN for Mexican Peso)."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "offer_price_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Offer Price Currency Code" ;
    cmm:validValues "USD|CAD|MXN" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:AncillaryServiceOffer.offerPricePerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer price per mw"@en ;
    rdfs:comment "The price in dollars per megawatt ($/MW) for capacity-based ancillary services such as spinning reserve or non-spinning reserve."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "offer_price_per_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Price per Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceOffer.offerPricePerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer price per mwh"@en ;
    rdfs:comment "The price in dollars per megawatt-hour ($/MWh) for energy-based ancillary services such as regulation up or regulation down."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "offer_price_per_mwh" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Price per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:AncillaryServiceOffer.offerRevisionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer revision number"@en ;
    rdfs:comment "Sequential revision number for this ancillary service offer, incremented each time the offer is modified and resubmitted before the market closes."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:int ;
    cmm:physicalColumn "offer_revision_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Revision Number" ;
    cmm:cimDatatype "Integer" .
cmm:AncillaryServiceOffer.offerSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer source system"@en ;
    rdfs:comment "Name or identifier of the source system from which the ancillary service offer originated (e.g., OpenLink Endur, ABB Ability Symphony Plus, manual entry)."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "offer_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Source System" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceOffer.offerStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer status"@en ;
    rdfs:comment "Current lifecycle status of the ancillary service offer: draft, submitted, accepted, rejected, partially awarded, withdrawn, or expired. Reference-value candidates: draft|submitted|accepted|rejected|partially_awarded|withdrawn|expired."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "offer_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Offer Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ResourceBid.status .
cmm:AncillaryServiceOffer.offerSubmissionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer submission timestamp"@en ;
    rdfs:comment "Date and time when the ancillary service offer was submitted to the ISO/RTO market. Principal business event timestamp for this transaction."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "offer_submission_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Submission Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AncillaryServiceOffer.offeredCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offered capacity mw"@en ;
    rdfs:comment "The capacity in megawatts (MW) that the generating unit is offering for the specified ancillary service."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "offered_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offered Capacity (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceOffer.pricingNode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pricing node"@en ;
    rdfs:comment "The pricing node or location identifier within the ISO/RTO market where the generating unit is interconnected and the ancillary service is offered."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "pricing_node" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode)" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceOffer.rampRateMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate mw per min"@en ;
    rdfs:comment "The rate at which the generating unit can increase or decrease output, measured in megawatts per minute (MW/min), relevant for regulation and spinning reserve services."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate (MW per Minute - Megawatt per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:AncillaryServiceOffer.rejectionReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rejection reason code"@en ;
    rdfs:comment "Code indicating the reason the ancillary service offer was rejected by the ISO/RTO, if applicable (e.g., insufficient capacity, late submission, technical constraint violation)."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "rejection_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rejection Reason Code" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceOffer.rejectionReasonDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rejection reason description"@en ;
    rdfs:comment "Detailed textual description of why the ancillary service offer was rejected by the ISO/RTO, if applicable."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "rejection_reason_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rejection Reason Description" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceOffer.responseTimeMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response time minutes"@en ;
    rdfs:comment "The time in minutes required for the generating unit to respond and deliver the offered ancillary service capacity from the time of dispatch signal."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "response_time_minutes" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Time (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:AncillaryServiceOffer.selfScheduleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "self schedule flag"@en ;
    rdfs:comment "Boolean flag indicating whether this ancillary service offer is a self-schedule (fixed commitment) rather than an economic offer subject to market clearing."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "self_schedule_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Schedule Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AncillaryServiceOffer.serviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service type"@en ;
    rdfs:comment "Type of ancillary service being offered: regulation up, regulation down, spinning reserve, non-spinning reserve, reactive power, or voltage support."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Ancillary Service Type" ;
    cmm:validValues "regulation_up|regulation_down|spinning_reserve|non_spinning_reserve|reactive_power|voltage_support" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ResourceBid.type .
cmm:AncillaryServiceOffer.tradingDeskCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading desk code"@en ;
    rdfs:comment "Identifier of the internal trading desk or energy trading team responsible for submitting this ancillary service offer."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:long ;
    cmm:physicalColumn "trading_desk_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trading Desk ID" ;
    cmm:cimDatatype "Integer" .

cmm:CapacityMarketOffer a owl:Class ;
    rdfs:label "Capacity Market Offer"@en ;
    rdfs:comment "Records of capacity market offers and awards for generating units participating in ISO/RTO forward capacity markets (PJM RPM, ISO-NE FCA, MISO PRCP). Captures auction year, delivery year, offered capacity (MW), offer price ($/MW-day), cleared capacity (MW), clearing price ($/MW-day), capacity performance obligations, penalty exposure, and net capacity revenue ($). Supports generation revenue planning and CAPEX justification."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Bid ;
    cmm:cimCloseMatch cim:Bid ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::ParticipantInterfaces" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.operations_scheduling ;
    cmm:physicalTable "utility_cmm_silver.generation.capacity_market_offer" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 62325-301; PJM RPM / ISO-NE FCA / MISO PRCP Capacity Market" ;
    cmm:sourceObject "energy_utilities_ecm.generation.capacity_market_offer" ;
    owl:hasKey ( cmm:CapacityMarketOffer.capacityMarketOfferId ) .

cmm:CapacityMarketOffer.capacityMarketOfferId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity market offer id"@en ;
    rdfs:comment "Unique identifier for the capacity market offer record. Primary key for this entity."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range xsd:long ;
    cmm:physicalColumn "capacity_market_offer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capacity Market Offer Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityMarketOffer.capacityGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity generating unit"@en ;
    rdfs:comment "Reference to the generating unit participating in the capacity market auction. Links to the generation asset registry."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "capacity_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generating Unit Identifier (ID)" ;
    cmm:sourceColumn "generating_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_capacity_generating_unit_id" ;
    cmm:cimAssociation "Bid.GeneratingUnit" .
cmm:CapacityMarketOffer.capacityObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity obligation"@en ;
    rdfs:comment "Foreign key linking to trading.capacity_obligation. Business justification: Capacity offers are submitted to satisfy specific capacity obligations. Essential for tracking how LSE capacity obligations are met through capacity market participation."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:CapacityObligation ;
    cmm:physicalColumn "capacity_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_capacity_obligation_id" ;
    cmm:cimAssociation "Bid.Document" .
cmm:CapacityMarketOffer.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Capacity market offers are control-area or RTO-wide for resource adequacy. Required for capacity auction clearing and obligation tracking."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_control_area_id" ;
    cmm:cimAssociation "Bid.ControlArea" .
cmm:CapacityMarketOffer.drCapacityRegistration a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr capacity registration"@en ;
    rdfs:comment "Foreign key linking to demand.dr_capacity_registration. Business justification: Capacity markets clear both generation and demand response resources together. Market operators need to link supply-side and demand-side capacity offers for auction clearing, settlement, and performan"@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:DrCapacityRegistration ;
    cmm:physicalColumn "dr_capacity_registration_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Capacity Registration Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_dr_capacity_registration_id" ;
    cmm:cimAssociation "Bid.RegisteredLoad" .
cmm:CapacityMarketOffer.fromGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "from generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Capacity market offers are based on a specific generating unit's demonstrated capability. Without this FK, capacity obligations cannot be traced to the unit responsible for delivery."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "from_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_from_generating_unit_id" ;
    cmm:cimAssociation "Bid.GeneratingUnit" .
cmm:CapacityMarketOffer.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Capacity market participation governed by ISO/RTO tariffs, FERC orders, and must-offer obligations. Essential for MOPR compliance, market rule adherence, offer cap validation, and audit defense of cap"@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_obligation_id" ;
    cmm:cimAssociation "Bid.Document" .
cmm:CapacityMarketOffer.primaryGeneratingUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary generating unit"@en ;
    rdfs:comment "FK to generation.generating_unit.generating_unit_id — Capacity market offers and awards are per generating unit. generating_unit_id is required for capacity revenue planning and performance obligation tracking."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range cmm:GeneratingUnit ;
    cmm:physicalColumn "primary_generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_capacity_market_offer_primary_generating_unit_id" ;
    cmm:cimAssociation "Bid.GeneratingUnit" .
cmm:CapacityMarketOffer.auctionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction date"@en ;
    rdfs:comment "Date on which the capacity auction was conducted and results were determined."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range xsd:date ;
    cmm:physicalColumn "auction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
