    cmm:cimCloseMatch cim:Transaction.createdDateTime .
cmm:DrIncentivePayment.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this payment record (e.g., USD, CAD)."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
