cmm:CapexExpenditure.documentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The date of the source document (e.g., invoice, receipt) that originated this expenditure transaction. May differ from posting date."@en ;
    rdfs:domain cmm:CapexExpenditure ; rdfs:range xsd:date ;
    cmm:physicalColumn "document_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Date" ;
