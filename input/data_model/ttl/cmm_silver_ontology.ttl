    cmm:businessTerm "Safety Clearance Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TransmissionOutage.scheduledEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled end timestamp"@en ;
    rdfs:comment "Originally planned restoration date and time for planned outages. Used to track schedule adherence and identify extensions."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionOutage.scheduledStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start timestamp"@en ;
    rdfs:comment "Originally planned start date and time for planned outages. Used to track schedule adherence and coordination accuracy."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:TransmissionOutage.startTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start timestamp"@en ;
    rdfs:comment "Date and time when the transmission facility was taken out of service or when the forced outage occurred. Used for duration calculations and reliability reporting."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:TransmissionOutage.switchingOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switching order number"@en ;
    rdfs:comment "Switching order number authorizing the isolation and restoration of the transmission facility. Critical for operational safety and coordination."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "switching_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Switching Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TransmissionOutage.temperatureF a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature f"@en ;
    rdfs:comment "Ambient temperature in Fahrenheit at the time of the outage. Used for equipment performance analysis and thermal rating assessments."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_f" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
