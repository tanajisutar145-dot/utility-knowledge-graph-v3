cmm:SparePartsInventory.materialGroupCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material group code"@en ;
    rdfs:comment "Hierarchical classification code grouping similar materials for procurement, reporting, and spend analysis. Examples include electrical components, mechanical parts, safety equipment, or consumables."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_group_code" ;
