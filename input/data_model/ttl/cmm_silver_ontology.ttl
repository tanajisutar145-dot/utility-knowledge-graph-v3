cmm:FuelPriceAssumption.sensitivityHighPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sensitivity high price"@en ;
    rdfs:comment "Upper bound fuel price for sensitivity analysis and risk assessment. Represents optimistic or high-price scenario for stress testing generation economics and resource selection."@en ;
    rdfs:domain cmm:FuelPriceAssumption ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "sensitivity_high_price" ;
