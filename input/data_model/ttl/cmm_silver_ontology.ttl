cmm:ControlArea.nominalFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal frequency hz"@en ;
    rdfs:comment "Target system frequency for this control area in Hertz, typically 60.00 Hz in North America or 50.00 Hz in other regions."@en ;
