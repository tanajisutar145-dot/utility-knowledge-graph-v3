cmm:TaxProvision.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "The three-letter ISO 4217 currency code in which all monetary amounts in this tax provision record are denominated (e.g., USD)."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:TaxProvision.currentTaxExpense a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current tax expense"@en ;
    rdfs:comment "The portion of total income tax expense that is currently payable to tax authorities for the fiscal period."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:decimal ;
