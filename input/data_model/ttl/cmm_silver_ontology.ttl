cmm:BillingServiceAgreement.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when the billing service agreement becomes active and billing begins. Aligns with service connection or move-in date."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
