cmm:SubstationScenarioPlan a owl:Class ;
    rdfs:label "Substation Scenario Plan"@en ;
    rdfs:comment "This association product represents the planning relationship between distribution substations and IRP scenarios. It captures scenario-specific capacity expansion plans, upgrade schedules, and capital investment forecasts for each substation across different planning futures (base case, high growth, accelerated decarbonization). Each record links one distribution substation to one IRP scenario with year-by-year planning data that exists only in the context of that specific scenario-substation combination. Enables comparison of substation investment needs across alternative futures for regulatory IRP filings.. Existence Justification: In IRP planning, each distribution substation can appear in multiple scenario plans (base case, high growth, accelerated decarbonization), and each IRP scenario models capacity expansion needs for multiple substations across the service territory. Planning teams actively create and manage scenario-specific substation investment plans with year-by-year capacity additions, capital expenditure forecasts, and load projections that vary by scenario assumptions. This is an operational planning relationship, not an analytical correlation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:distribution , cmmsa:distribution.reliability_planning ;
    cmm:physicalTable "utility_cmm_silver.distribution.substation_scenario_plan" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.distribution.substation_scenario_plan" ;
    owl:hasKey ( cmm:SubstationScenarioPlan.substationScenarioPlanId ) .

cmm:SubstationScenarioPlan.substationScenarioPlanId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation scenario plan id"@en ;
    rdfs:comment "Unique identifier for this substation-scenario planning record. Primary key."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "substation_scenario_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Substation Scenario Plan ID" ;
    cmm:cimDatatype "Integer" .
cmm:SubstationScenarioPlan.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Foreign key linking to the distribution substation being planned for in this scenario"@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Scenario Plan - Distribution Substation Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_substation_scenario_plan_distribution_substation_id" ;
    cmm:cimAssociation "IdentifiedObject.Substation" .
cmm:SubstationScenarioPlan.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to the IRP scenario containing this substation plan"@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation Scenario Plan - Irp Scenario Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_distribution_substation_scenario_plan_irp_scenario_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:SubstationScenarioPlan.capacityUtilizationPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity utilization pct"@en ;
    rdfs:comment "Forecasted capacity utilization percentage for this substation in this scenario year (load_forecast_mw / total_capacity_mva). Used to identify capacity constraints and trigger investment decisions."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_utilization_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Utilization Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:SubstationScenarioPlan.capitalExpenditureUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital expenditure usd"@en ;
    rdfs:comment "Estimated capital expenditure in US dollars for substation upgrades or expansions in this scenario year. Used for NPV analysis and rate case planning."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capital_expenditure_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure USD" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SubstationScenarioPlan.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this substation scenario plan record was created in the IRP planning system."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:SubstationScenarioPlan.deferralOpportunity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deferral opportunity"@en ;
    rdfs:comment "Identified non-wires alternative or demand-side solution that could defer traditional substation investment in this scenario (e.g., 'Battery storage', 'Demand response program', 'Energy efficiency', 'None')."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "deferral_opportunity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deferral Opportunity" ;
    cmm:cimDatatype "String" .
cmm:SubstationScenarioPlan.investmentTrigger a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investment trigger"@en ;
    rdfs:comment "Business rule or condition that triggers capital investment in this scenario (e.g., 'Utilization exceeds 80%', 'Load growth exceeds 5% annually', 'Reliability standard violation', 'None')."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "investment_trigger" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investment Trigger" ;
    cmm:cimDatatype "String" .
cmm:SubstationScenarioPlan.lastUpdatedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated date"@en ;
    rdfs:comment "Timestamp when this substation scenario plan record was last modified by planning staff."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Date" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SubstationScenarioPlan.loadForecastMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load forecast mw"@en ;
    rdfs:comment "Forecasted peak load in megawatts (MW) for this substation in this scenario year, reflecting scenario-specific load growth assumptions (electrification, DER penetration, demand response)."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_forecast_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Forecast MW" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:SubstationScenarioPlan.planStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan status"@en ;
    rdfs:comment "Lifecycle status of this substation plan within the scenario: draft (initial planning), under_review (stakeholder review), approved (included in final IRP), deferred (postponed to later year), cancelled (no longer needed)."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Plan Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:SubstationScenarioPlan.plannedCapacityAdditionsMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned capacity additions mva"@en ;
    rdfs:comment "Planned transformer capacity additions or upgrades for this substation in this scenario year, measured in megavolt-amperes (MVA). Zero if no expansion planned."@en ;
    rdfs:domain cmm:SubstationScenarioPlan ; rdfs:range xsd:decimal ;
