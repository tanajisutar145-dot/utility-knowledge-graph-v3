    cmm:businessTerm "Capacity Auction Name" ;
    cmm:cimDatatype "String" .
cmm:CapacityMarketOffer.auctionYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction year"@en ;
    rdfs:comment "Calendar year in which the capacity auction was conducted."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range xsd:int ;
    cmm:physicalColumn "auction_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Year" ;
    cmm:cimDatatype "Integer" .
cmm:CapacityMarketOffer.avoidableCostRatePerMwDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "avoidable cost rate per mw day"@en ;
    rdfs:comment "Unit-specific avoidable cost rate used to determine the offer floor for existing resources under market power mitigation rules, expressed in dollars per megawatt per day ($/MW-day)."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "avoidable_cost_rate_per_mw_day" ;
