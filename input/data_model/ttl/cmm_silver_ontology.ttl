cmm:SparePartsInventory.lastPurchaseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last purchase date"@en ;
    rdfs:comment "Date when the material was most recently purchased via a purchase order. Used for inventory aging analysis and procurement pattern tracking."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_purchase_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Purchase Date" ;
    cmm:cimDatatype "Date" .
cmm:SparePartsInventory.lastPurchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last purchase order number"@en ;
    rdfs:comment "Most recent purchase order number used to procure this material. Provides audit trail and reference for pricing, lead time, and supplier performance analysis."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Purchase Order Number" ;
    cmm:cimDatatype "String" ;
