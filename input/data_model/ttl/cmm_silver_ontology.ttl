cmm:EmissionsReport.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this emissions report record was last modified in the system."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
