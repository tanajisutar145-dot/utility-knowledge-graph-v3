cmm:ControlAreaObligation.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this control area-obligation applicability record was created in the compliance management system."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Creation Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:ControlAreaObligation.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date on which this obligation became applicable to this control area, which may differ from the obligations general effective date based on control area commissioning or operational changes."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Applicability Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ControlAreaObligation.evidenceLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "evidence location"@en ;
    rdfs:comment "Reference to the storage location, document management system path, or evidence repository where compliance evidence for this control area-obligation pair is maintained for audit defense."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "evidence_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Evidence Location Reference" ;
    cmm:cimDatatype "String" .
cmm:ControlAreaObligation.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date on which this obligation ceased or will cease to apply to this control area, due to control area decommissioning, regulatory changes, or scope modifications. Null if still applicable."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Applicability Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ControlAreaObligation.lastAssessmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last assessment date"@en ;
    rdfs:comment "Date of the most recent compliance assessment or audit for this control area-obligation pair."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_assessment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Assessment Date" ;
    cmm:cimDatatype "Date" .
cmm:ControlAreaObligation.lastAuditFinding a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last audit finding"@en ;
    rdfs:comment "Summary of the most recent audit finding or assessment result for this control area-obligation pair, including any deficiencies identified or corrective actions required."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_audit_finding" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Audit Finding" ;
    cmm:cimDatatype "String" .
cmm:ControlAreaObligation.lastUpdatedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated date"@en ;
    rdfs:comment "Timestamp when this control area-obligation compliance record was last updated."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_date" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ControlAreaObligation.nextDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next due date"@en ;
    rdfs:comment "Next scheduled date by which compliance evidence or reporting is due for this specific control area-obligation combination."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
