    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_correspondence_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Correspondence Reference" ;
    cmm:cimDatatype "String" .
cmm:EnforcementAction.responsibleFacilityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "responsible facility code"@en ;
    rdfs:comment "Code or identifier of the specific facility, plant, substation, or asset where the alleged violation occurred."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "responsible_facility_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Responsible Facility Code" ;
    cmm:cimDatatype "String" .
cmm:EnforcementAction.selfReportCreditFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "self report credit flag"@en ;
    rdfs:comment "Boolean indicator of whether the utility received penalty mitigation credit for self-reporting the violation to the regulator (True = credit received, False = no credit)."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "self_report_credit_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Report Credit Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EnforcementAction.settlementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement flag"@en ;
    rdfs:comment "Boolean indicator of whether the enforcement action was resolved through a settlement agreement between the utility and the regulatory agency (True = settled, False = not settled)."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "settlement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Agreement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EnforcementAction.settlementTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement terms"@en ;
    rdfs:comment "Summary of key terms and conditions agreed upon in the settlement, including penalty reduction, compliance commitments, and remedial actions."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_terms" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Agreement Terms" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:EnforcementAction.violatedStandardCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violated standard code"@en ;
    rdfs:comment "Code or identifier of the specific regulatory standard, rule, or requirement that was allegedly violated (e.g., NERC CIP-007-6, FERC Order 888, EPA 40 CFR Part 60, OSHA 29 CFR 1910)."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:string ;
    cmm:physicalColumn "violated_standard_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violated Standard Code" ;
    cmm:cimDatatype "String" .
cmm:EnforcementAction.violationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "violation end date"@en ;
    rdfs:comment "End date of the period during which the alleged violation occurred or non-compliance was remediated."@en ;
    rdfs:domain cmm:EnforcementAction ; rdfs:range xsd:date ;
    cmm:physicalColumn "violation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Violation Period End Date" ;
