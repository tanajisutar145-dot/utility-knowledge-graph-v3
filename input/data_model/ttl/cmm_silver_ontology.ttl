    cmm:businessTerm "Auction Date" ;
    cmm:cimDatatype "Date" .
cmm:CapacityMarketOffer.auctionName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction name"@en ;
    rdfs:comment "Name or identifier of the specific capacity auction (e.g., PJM RPM Base Residual Auction, ISO-NE Forward Capacity Auction)."@en ;
    rdfs:domain cmm:CapacityMarketOffer ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
