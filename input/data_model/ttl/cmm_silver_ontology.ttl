cmm:UnionAgreement a owl:Class ;
    rdfs:label "Union Agreement"@en ;
    rdfs:comment "Master records of collective bargaining agreements (CBAs) between the utility and labor unions (IBEW, UWUA, and others) covering field crews, plant operators, and other bargaining unit employees, plus the full grievance lifecycle under each CBA. CBA records capture union name, local number, agreement effective/expiration dates, covered job classifications, wage scales, overtime rules, call-out provisions, storm duty obligations, grievance procedure definitions, and arbitration terms. Grievance records capture grievance number, filing date, grievant employee, union local, alleged CBA violation, grievance step (Step 1 through arbitration), management response, resolution outcome, settlement terms, and arbitration award details. SSOT for all CBA terms and grievance lifecycle tracking. Drives payroll rules, scheduling constraints, labor cost modeling, and labor relations compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.union_agreement" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IBEW/UWUA Collective Bargaining Agreement" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.union_agreement" ;
    owl:hasKey ( cmm:UnionAgreement.unionAgreementId ) .

cmm:UnionAgreement.unionAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union agreement id"@en ;
    rdfs:comment "Unique identifier for the collective bargaining agreement record. Primary key."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "union_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Union Agreement ID" ;
    cmm:cimDatatype "Integer" .
cmm:UnionAgreement.primarySuccessorAgreementUnionAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary successor agreement union agreement"@en ;
    rdfs:comment "Reference to the collective bargaining agreement that supersedes this agreement upon expiration."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range cmm:UnionAgreement ;
    cmm:physicalColumn "primary_successor_agreement_union_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Successor Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_union_agreement_primary_successor_agreement_union_agreement_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:UnionAgreement.agreementName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement name"@en ;
    rdfs:comment "Descriptive name of the collective bargaining agreement, typically including union name and bargaining unit."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Agreement Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:UnionAgreement.agreementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement number"@en ;
    rdfs:comment "Externally-known unique identifier for the collective bargaining agreement, typically formatted as CBA-XXXXXX."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Collective Bargaining Agreement (CBA) Number" ;
    cmm:valuePattern "^CBA-[0-9]{6}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:UnionAgreement.agreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement status"@en ;
    rdfs:comment "Current lifecycle status of the collective bargaining agreement. Reference-value candidates: draft|negotiation|ratified|active|expired|terminated|superseded."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:UnionAgreement.agreementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement type"@en ;
    rdfs:comment "Classification of the collective bargaining agreement document type."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Type" ;
    cmm:validValues "master|supplemental|memorandum_of_understanding|side_letter|extension" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.type .
cmm:UnionAgreement.arbitrationCostSharing a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration cost sharing"@en ;
    rdfs:comment "Method for allocating arbitration costs between the utility and union."@en ;
    rdfs:domain cmm:UnionAgreement ; rdfs:range xsd:string ;
