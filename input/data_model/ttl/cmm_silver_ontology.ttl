cmm:PostalAddress.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Source system or application that created or maintains this address record (e.g., SAP IS-U, Oracle CC&B, GIS, MDM)."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Source System" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Unique identifier for this address in the source system of record. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Source System Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.stateProvinceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state province code"@en ;
    rdfs:comment "Two-letter state or province code (e.g., CA for California, ON for Ontario)."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "state_province_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State or Province Code" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.timeZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time zone"@en ;
    rdfs:comment "IANA time zone identifier for the address location (e.g., America/New_York, America/Los_Angeles). Used for Time of Use (TOU) rate scheduling and Demand Response (DR) event timing."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "time_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Zone" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.uspsStandardizedAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usps standardized address"@en ;
    rdfs:comment "USPS-standardized full address string in CASS-certified format for delivery accuracy."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "usps_standardized_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "United States Postal Service (USPS) Standardized Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.uspsValidationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usps validation status"@en ;
    rdfs:comment "Status of USPS address validation: validated (confirmed by USPS), invalid (rejected by USPS), not_validated (not yet checked), corrected (USPS suggested correction applied), or ambiguous (multiple matches found)."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "usps_validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "United States Postal Service (USPS) Validation Status" ;
    cmm:validValues "validated|invalid|not_validated|corrected|ambiguous" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.verificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification date"@en ;
    rdfs:comment "Date when the address was last verified or validated through USPS, field inspection, or customer confirmation."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:date ;
    cmm:physicalColumn "verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:PostalAddress.verificationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verification method"@en ;
    rdfs:comment "Method used to verify the address: usps_api (USPS web service), field_inspection (physical site visit), customer_confirmation (customer-provided), gis_validation (GIS system match), or third_party_service (external validation service)."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "verification_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Verification Method" ;
    cmm:validValues "usps_api|field_inspection|customer_confirmation|gis_validation|third_party_service" ;
    cmm:cimDatatype "String" .

cmm:AccountPremiseLink a owl:Class ;
    rdfs:label "Account Premise Link"@en ;
    rdfs:comment "Association entity and SSOT for all relationships between customer accounts and premises, including active service relationships, landlord-tenant relationships, and property management roles. Stores link start date, link end date, link type (primary service, secondary service, landlord-of-record, property manager, master-metered tenant), landlord account reference, tenant account reference, move-in/move-out order references, vacancy billing flag, notification authorization flag, and link status. Enables historical tracking of which accounts have been served at a given premise, supports premise-to-account resolution for outage notifications and field operations, manages multi-family residential and commercial property management scenarios, and tracks landlord-tenant billing and notification workflows. SSOT for all account-to-premise and landlord-tenant relationship data."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.account_management ;
    cmm:physicalTable "utility_cmm_silver.customer.account_premise_link" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "SAP IS-U Connection Object / Oracle CC&B Account-Premise Relationship" ;
    cmm:sourceObject "energy_utilities_ecm.customer.account_premise_link" ;
    owl:hasKey ( cmm:AccountPremiseLink.accountPremiseLinkId ) .

cmm:AccountPremiseLink.accountPremiseLinkId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account premise link id"@en ;
    rdfs:comment "Unique identifier for the account-premise relationship record. Primary key for the account_premise_link entity."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:long ;
    cmm:physicalColumn "account_premise_link_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Account Premise Link Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:AccountPremiseLink.accountPremise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account premise"@en ;
    rdfs:comment "Reference to the service premise associated with this account. Links to the premise entity representing the physical service location."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "account_premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier (ID)" ;
    cmm:sourceColumn "premise_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_account_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:AccountPremiseLink.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Reference to the formal service agreement governing this account-premise relationship. Links to the contract or service agreement entity."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_customer_service_agreement_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAgreement" .
cmm:AccountPremiseLink.forwardingAddress a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forwarding address"@en ;
    rdfs:comment "Reference to the forwarding address for final bill delivery and correspondence after account-premise relationship termination. Used in move-out processing."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:PostalAddress ;
    cmm:physicalColumn "forwarding_address_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forwarding Address Identifier (ID)" ;
    cmm:sourceColumn "address_id" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_forwarding_address_id" ;
    cmm:cimAssociation "IdentifiedObject.StreetAddress" .
cmm:AccountPremiseLink.primaryAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary account"@en ;
    rdfs:comment "Reference to the customer account associated with this premise. Links to the account entity in the Customer Information System (CIS)."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "primary_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_primary_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:AccountPremiseLink.primaryAccountMoveOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary account move order"@en ;
    rdfs:comment "Reference to the service order that initiated this account-premise relationship. Links to the move-in or service connection order."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:MoveOrder ;
    cmm:physicalColumn "primary_account_move_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Move-In Order Identifier (ID)" ;
    cmm:sourceColumn "move_order_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_primary_account_move_order_id" ;
    cmm:cimAssociation "IdentifiedObject.Work" .
cmm:AccountPremiseLink.tertiaryTenantAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary tenant account"@en ;
    rdfs:comment "Reference to the tenant account when this link represents a landlord-of-record relationship. Used to track tenant accounts associated with a landlord premise. Null for non-landlord relationships."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "tertiary_tenant_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Tenant Account Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_tertiary_tenant_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:AccountPremiseLink.toPremise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to premise"@en ;
    rdfs:comment "FK to customer.premise.premise_id — The association entity must reference the premise it links. account_premise_link.premise_id → premise.premise_id."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "to_premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_account_premise_link_to_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:AccountPremiseLink.billingResponsibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing responsibility flag"@en ;
    rdfs:comment "Indicates whether this account has billing responsibility for the premise. In master-metered or landlord scenarios, multiple accounts may be linked to a premise but only one has billing responsibility."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billing_responsibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Responsibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.contactPreference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contact preference"@en ;
    rdfs:comment "Preferred communication channel for outage notifications and service alerts for this account-premise relationship. Used by OMS and customer engagement systems."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "contact_preference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contact Preference" ;
    cmm:validValues "email|sms|phone|mail|mobile_app|none" ;
    cmm:cimDatatype "String" .
cmm:AccountPremiseLink.depositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit amount"@en ;
    rdfs:comment "Security deposit amount collected for this account-premise relationship. Null if no deposit was required. Expressed in local currency."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AccountPremiseLink.depositRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit required flag"@en ;
    rdfs:comment "Indicates whether a security deposit was required for this account-premise relationship based on credit classification and service territory regulations."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "deposit_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.derEnrolledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der enrolled flag"@en ;
    rdfs:comment "Indicates whether this account-premise relationship is enrolled in a Distributed Energy Resource (DER) program such as demand response, virtual power plant, or distributed generation program."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_enrolled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Enrolled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.finalBillFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final bill flag"@en ;
    rdfs:comment "Indicates whether a final bill has been issued for this account-premise relationship upon termination. Used in move-out and service disconnection workflows."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "final_bill_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Bill Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.linkCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link created timestamp"@en ;
    rdfs:comment "Timestamp when this account-premise link record was first created in the Customer Information System (CIS). Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "link_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Link Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AccountPremiseLink.linkEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link end date"@en ;
    rdfs:comment "Date when the account-premise relationship was terminated. Represents move-out date or service disconnection date. Null for active relationships."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:date ;
    cmm:physicalColumn "link_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Link End Date" ;
    cmm:cimDatatype "Date" .
cmm:AccountPremiseLink.linkModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link modified timestamp"@en ;
    rdfs:comment "Timestamp when this account-premise link record was last modified. Used for audit trail and change tracking in customer relationship management."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "link_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Link Modified Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AccountPremiseLink.linkNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link notes"@en ;
    rdfs:comment "Free-text notes and comments regarding this account-premise relationship. Used by customer service representatives to document special circumstances, arrangements, or historical context."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "link_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Link Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AccountPremiseLink.linkStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link start date"@en ;
    rdfs:comment "Date when the account-premise relationship became effective. Represents move-in date or service initiation date for the account at this premise."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:date ;
    cmm:physicalColumn "link_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Link Start Date" ;
    cmm:cimDatatype "Date" .
cmm:AccountPremiseLink.linkStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link status"@en ;
    rdfs:comment "Current lifecycle status of the account-premise relationship. Indicates whether the link is currently in effect or has been terminated."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "link_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Account Premise Link Status" ;
    cmm:validValues "active|inactive|pending|suspended|terminated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:AccountPremiseLink.linkTerminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link termination reason"@en ;
    rdfs:comment "Reason code for termination of the account-premise relationship. Provides business context for why the link was ended. Null for active relationships."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "link_termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Link Termination Reason" ;
    cmm:validValues "customer_move_out|service_disconnection|account_closure|property_sale|lease_expiration|death" ;
    cmm:cimDatatype "String" .
cmm:AccountPremiseLink.linkType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "link type"@en ;
    rdfs:comment "Classification of the relationship between the account and premise. Defines the role and responsibility of the account holder at the service location."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "link_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Account Premise Link Type" ;
    cmm:validValues "primary_service|secondary_service|landlord_of_record|property_manager|master_metered_tenant|billing_contact" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:AccountPremiseLink.masterMeteredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "master metered flag"@en ;
    rdfs:comment "Indicates whether this relationship involves a master-metered configuration where a single meter serves multiple tenant accounts. Common in multi-family residential and commercial properties."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "master_metered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Master Metered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.nemParticipantFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem participant flag"@en ;
    rdfs:comment "Indicates whether this account-premise relationship involves a Net Energy Metering (NEM) participant with Behind the Meter (BTM) generation. Used to identify customers with distributed energy resources."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_participant_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Participant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.notificationAuthorizationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notification authorization flag"@en ;
    rdfs:comment "Indicates whether the account holder has authorized receipt of outage notifications and service alerts for this premise. Used by Outage Management System (OMS) for customer communication."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "notification_authorization_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Notification Authorization Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AccountPremiseLink.occupancyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "occupancy type"@en ;
    rdfs:comment "Classification of the occupancy status for this account-premise relationship. Indicates whether the account holder is an owner, tenant, or if the premise is vacant."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "occupancy_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Occupancy Type" ;
    cmm:validValues "owner_occupied|tenant_occupied|vacant|seasonal|under_construction" ;
    cmm:cimDatatype "String" .
cmm:AccountPremiseLink.prioritySequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority sequence"@en ;
    rdfs:comment "Numeric ranking of this account-premise link when multiple accounts are associated with a single premise. Used to determine primary contact for outage notifications and field operations."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Priority Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:AccountPremiseLink.propertyManagementCompanyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "property management company code"@en ;
    rdfs:comment "Reference to the property management company responsible for this premise when the link type is property manager. Used in commercial and multi-family property management scenarios."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:long ;
    cmm:physicalColumn "property_management_company_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Property Management Company Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:AccountPremiseLink.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifier of the operational system of record that originated this account-premise link. Used for data lineage and integration troubleshooting."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_IS_U|ORACLE_CCB|LEGACY_CIS|MANUAL_ENTRY" ;
    cmm:cimDatatype "String" .
cmm:AccountPremiseLink.sourceSystemKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system key"@en ;
    rdfs:comment "Original primary key or unique identifier from the source system. Used for data reconciliation and bidirectional synchronization with operational systems."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_key" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Key" ;
    cmm:cimDatatype "String" .
cmm:AccountPremiseLink.vacancyBillingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vacancy billing flag"@en ;
    rdfs:comment "Indicates whether vacancy billing is active for this account-premise relationship. When true, the landlord or property manager is billed for usage during tenant vacancy periods."@en ;
    rdfs:domain cmm:AccountPremiseLink ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vacancy_billing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vacancy Billing Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:CreditProfile a owl:Class ;
    rdfs:label "Credit Profile"@en ;
    rdfs:comment "Master entity capturing the credit classification and financial risk attributes of a customer account as managed within the CIS. Stores credit class code (excellent, good, fair, poor, new), credit score band, deposit requirement flag, deposit amount, deposit type (cash, surety bond, letter of credit), deposit waiver reason, credit review date, number of late payments in rolling 12 months, disconnection history count, bankruptcy flag, low-income program enrollment flag, and collections stage. Sourced from SAP IS-U FICA credit management and Oracle CC&B credit configuration. Used by billing and collections domains for deposit calculation, disconnection eligibility, and payment arrangement qualification."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.account_management ;
    cmm:physicalTable "utility_cmm_silver.customer.credit_profile" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "SAP IS-U FICA Credit Management / Oracle CC&B Credit Profile" ;
    cmm:sourceObject "energy_utilities_ecm.customer.credit_profile" ;
    owl:hasKey ( cmm:CreditProfile.creditProfileId ) .

cmm:CreditProfile.creditProfileId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit profile id"@en ;
    rdfs:comment "Unique identifier for the credit profile record. Primary key for the credit profile entity."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:long ;
    cmm:physicalColumn "credit_profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Credit Profile Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CreditProfile.creditAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "credit account"@en ;
    rdfs:comment "Reference to the customer account to which this credit profile applies. Links credit assessment to the billing account in CIS (SAP IS-U or Oracle CC&B)."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "credit_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier (ID)" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_credit_profile_credit_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:CreditProfile.toAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to account"@en ;
    rdfs:comment "FK to customer.account.account_id — Credit classification is assessed per account. credit_profile.account_id → account.account_id."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "to_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_credit_profile_to_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:CreditProfile.averageMonthlyPaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average monthly payment amount"@en ;
    rdfs:comment "Average monthly payment amount over the past 12 months. Used for deposit calculation and payment arrangement sizing."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_monthly_payment_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Monthly Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditProfile.bankruptcyDischargeDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy discharge date"@en ;
    rdfs:comment "Date the bankruptcy was discharged or dismissed. Credit profile may be eligible for upgrade after discharge and demonstration of payment performance."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "bankruptcy_discharge_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bankruptcy Discharge Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.bankruptcyFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy filing date"@en ;
    rdfs:comment "Date of the most recent bankruptcy filing. Used to determine if bankruptcy is still active and impacts credit classification duration."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "bankruptcy_filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bankruptcy Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.bankruptcyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy flag"@en ;
    rdfs:comment "Indicates whether the customer has an active or recent bankruptcy filing. Impacts collections strategy and may trigger automatic deposit requirement per PUC rules."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "bankruptcy_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bankruptcy Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.brokenArrangementCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "broken arrangement count"@en ;
    rdfs:comment "Number of payment arrangements that were broken (customer failed to make scheduled payments). Impacts future payment arrangement eligibility and credit classification."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:int ;
    cmm:physicalColumn "broken_arrangement_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Broken Payment Arrangement Count" ;
    cmm:cimDatatype "Integer" .
cmm:CreditProfile.collectionsStage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collections stage"@en ;
    rdfs:comment "Current stage in the collections process for past-due balances. Drives automated dunning notices, disconnection scheduling, and external collections referral. Reference-value candidates: current|reminder|final_notice|disconnection_pending|disconnected|write_off|legal_action."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "collections_stage" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collections Stage" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this credit profile record was first created in the CIS. Required for audit trail and data lineage."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Credit Profile Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:CreditProfile.creditClassCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit class code"@en ;
    rdfs:comment "Credit classification code assigned to the customer account based on payment history, credit score, and risk assessment. Determines deposit requirements and collection strategies."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_class_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Class Code" ;
    cmm:validValues "excellent|good|fair|poor|new|unrated" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.creditFreezeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit freeze flag"@en ;
    rdfs:comment "Indicates whether the customer has placed a credit freeze with the credit bureaus, preventing external credit checks. Requires manual credit assessment process."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "credit_freeze_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Freeze Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.creditLimitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit limit amount"@en ;
    rdfs:comment "Maximum outstanding balance allowed before service disconnection or additional deposit requirement is triggered. Based on credit class and deposit on file."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_limit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Limit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditProfile.creditProfileStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit profile status"@en ;
    rdfs:comment "Current status of the credit profile record. Active profiles are used for deposit and collections decisions; under_review profiles are pending credit reassessment."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_profile_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Credit Profile Status" ;
    cmm:validValues "active|inactive|suspended|under_review" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CreditProfile.creditReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit review date"@en ;
    rdfs:comment "Date of the most recent credit review or reassessment. Credit profiles are typically reviewed annually or upon significant payment events (late payments, disconnection, bankruptcy)."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "credit_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Review Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.creditScoreBand a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit score band"@en ;
    rdfs:comment "Credit score range band obtained from external credit bureau (Experian, Equifax, TransUnion). Used for initial credit classification and deposit determination."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_score_band" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Score Band" ;
    cmm:validValues "300-579|580-669|670-739|740-799|800-850|not_available" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.depositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit amount"@en ;
    rdfs:comment "Security deposit amount required from the customer, typically calculated as 2-3 months of estimated billing. Null if no deposit is required."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditProfile.depositRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit required flag"@en ;
    rdfs:comment "Indicates whether a security deposit is required for this account based on credit classification and PUC regulations."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "deposit_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.depositType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit type"@en ;
    rdfs:comment "Type of security deposit instrument held for the account. Cash deposits are held in trust accounts; surety bonds and letters of credit are third-party guarantees."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Type" ;
    cmm:validValues "cash|surety_bond|letter_of_credit|guarantee|none" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.depositWaiverReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit waiver reason"@en ;
    rdfs:comment "Reason code for waiving the security deposit requirement. Regulatory exemptions include low-income program enrollment, medical necessity, and senior citizen status per PUC rules. Reference-value candidates: excellent_credit|existing_customer|low_income_program|senior_citizen|medical_necessity|regulatory_exemption|none."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_waiver_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Waiver Reason" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.disconnectionHistoryCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnection history count"@en ;
    rdfs:comment "Total number of service disconnections for non-payment in the account history. Indicates chronic payment issues and impacts credit classification."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:int ;
    cmm:physicalColumn "disconnection_history_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnection History Count" ;
    cmm:cimDatatype "Integer" .
cmm:CreditProfile.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date this credit profile became effective. Credit profiles are versioned; this date marks the start of this version's validity period."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Credit Profile Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CreditProfile.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date this credit profile version expires or is superseded by a new version. Null for the current active credit profile."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Credit Profile Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CreditProfile.externalCreditBureau a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "external credit bureau"@en ;
    rdfs:comment "Credit bureau used to obtain the credit score and credit report for this customer. Required for FCRA compliance and dispute resolution."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "external_credit_bureau" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "External Credit Bureau" ;
    cmm:validValues "experian|equifax|transunion|none" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.externalCreditCheckDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "external credit check date"@en ;
    rdfs:comment "Date the external credit bureau check was performed. Credit checks are typically performed at account establishment and periodically for high-risk accounts."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "external_credit_check_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "External Credit Check Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.highestPastDueAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "highest past due amount"@en ;
    rdfs:comment "Highest past-due balance amount in the account history. Indicates maximum payment risk exposure and informs deposit amount calculation."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "highest_past_due_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Highest Past Due Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditProfile.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to this credit profile record. Tracks credit reassessments, manual overrides, and system updates."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Credit Profile Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CreditProfile.latePaymentCount12m a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "late payment count 12m"@en ;
    rdfs:comment "Number of late payments (payments received after due date) in the rolling 12-month period. Key metric for credit class downgrade and disconnection eligibility."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:int ;
    cmm:physicalColumn "late_payment_count_12m" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Late Payment Count (12 Months)" ;
    cmm:cimDatatype "Integer" .
cmm:CreditProfile.lowIncomeProgramFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "low income program flag"@en ;
    rdfs:comment "Indicates whether the customer is enrolled in a low-income assistance program (LIHEAP, state-specific programs). Enrollment may waive deposit requirements and provide disconnection protections."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "low_income_program_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Low-Income Program Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.manualOverrideBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manual override by"@en ;
    rdfs:comment "User ID or name of the credit management staff member who performed the manual override. Required for audit trail and SOX compliance."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "manual_override_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manual Override Performed By" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.manualOverrideDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manual override date"@en ;
    rdfs:comment "Date the manual credit classification override was performed. Required for audit trail and regulatory compliance."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "manual_override_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manual Override Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.manualOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manual override flag"@en ;
    rdfs:comment "Indicates whether the credit classification was manually overridden by credit management staff. Overrides require supervisor approval and documented justification."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "manual_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manual Credit Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.manualOverrideReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manual override reason"@en ;
    rdfs:comment "Free-text justification for manual credit classification override. Required for audit trail and regulatory compliance."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:string ;
    cmm:physicalColumn "manual_override_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manual Credit Override Reason" ;
    cmm:cimDatatype "String" .
cmm:CreditProfile.nextReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next review date"@en ;
    rdfs:comment "Scheduled date for the next periodic credit review. Typically set 12 months from the last review date or earlier if triggered by payment issues."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Credit Review Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditProfile.paymentArrangementCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement count"@en ;
    rdfs:comment "Total number of payment arrangements or installment plans established for this account. Excessive arrangements may indicate chronic payment issues and impact credit classification."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:int ;
    cmm:physicalColumn "payment_arrangement_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement Count" ;
    cmm:cimDatatype "Integer" .
cmm:CreditProfile.paymentArrangementEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement eligible flag"@en ;
    rdfs:comment "Indicates whether the account is eligible for a payment arrangement or installment plan based on credit class, payment history, and PUC regulations."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "payment_arrangement_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditProfile.returnedPaymentCount12m a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "returned payment count 12m"@en ;
    rdfs:comment "Number of returned payments (NSF checks, ACH returns, declined credit cards) in the rolling 12-month period. Indicates payment reliability issues and may trigger deposit requirement."@en ;
    rdfs:domain cmm:CreditProfile ; rdfs:range xsd:int ;
    cmm:physicalColumn "returned_payment_count_12m" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Returned Payment Count (12 Months)" ;
    cmm:cimDatatype "Integer" .

cmm:CustomerSegment a owl:Class ;
    rdfs:label "Customer Segment"@en ;
    rdfs:comment "Reference entity defining market segmentation classifications applied to customer accounts for rate design, demand response targeting, regulatory reporting, and marketing programs. Captures segment code, segment name, segment tier (residential low-use, residential high-use, small commercial, medium commercial, large commercial, industrial, agricultural, municipal), load profile class, AMI penetration flag, DER adoption flag, EV ownership flag, segment effective date, and segment expiration date. Used by billing, demand response, and regulatory reporting domains to classify accounts for tariff application, program eligibility, and FERC/PUC reporting breakdowns."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.account_management ;
    cmm:physicalTable "utility_cmm_silver.customer.segment" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "NAICS; SIC; Oracle CC&B Customer Class / SAP IS-U Customer Group" ;
    cmm:sourceObject "energy_utilities_ecm.customer.segment" ;
    owl:hasKey ( cmm:CustomerSegment.segmentId ) .

cmm:CustomerSegment.segmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment id"@en ;
    rdfs:comment "Primary key for segment"@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:long ;
    cmm:physicalColumn "segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Segment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerSegment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "FK to customer.account.account_id — Segments classify accounts for rate design, DR targeting, and regulatory reporting. Required for tariff application and program eligibility determination. Note: this may be a many-to-many via an impli"@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_segment_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:CustomerSegment.planningAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "planning assumption"@en ;
    rdfs:comment "Foreign key linking to forecast.planning_assumption. Business justification: Customer segments (residential, commercial, industrial) are the foundation for load growth assumptions in IRP filings and long-term planning. Regulatory filings require traceability from segment chara"@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range cmm:PlanningAssumption ;
    cmm:physicalColumn "planning_assumption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Growth Assumption Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_segment_planning_assumption_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:CustomerSegment.accountCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "account count"@en ;
    rdfs:comment "Current number of active customer accounts assigned to this segment. Updated periodically from CIS systems for segment size tracking and program capacity planning."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:int ;
    cmm:physicalColumn "account_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Account Count" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerSegment.amiPenetrationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami penetration flag"@en ;
    rdfs:comment "Indicates whether this segment has significant AMI (Advanced Metering Infrastructure) deployment, enabling interval data collection and time-of-use rate programs. True if AMI penetration exceeds utility-defined threshold (typically 75%+)."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ami_penetration_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Penetration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.annualEnergySalesMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual energy sales mwh"@en ;
    rdfs:comment "Total annual energy sales in megawatt-hours for all accounts in this segment. Key metric for load forecasting, resource planning (IRP), and regulatory sales reporting."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_energy_sales_mwh" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Energy Sales Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CustomerSegment.annualRevenueUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual revenue usd"@en ;
    rdfs:comment "Total annual billed revenue in US dollars for all accounts in this segment. Used for revenue forecasting, rate design impact analysis, and regulatory reporting. Aggregated from billing system revenue data."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_revenue_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Revenue United States Dollars (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerSegment.averageMonthlyConsumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average monthly consumption kwh"@en ;
    rdfs:comment "Typical average monthly electricity consumption in kilowatt-hours for accounts in this segment. Used for load forecasting, rate design analysis, and program targeting. Calculated from historical MDM interval and register data."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_monthly_consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Monthly Consumption Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CustomerSegment.averagePeakDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average peak demand kw"@en ;
    rdfs:comment "Typical peak demand in kilowatts for accounts in this segment. Relevant for commercial and industrial segments with demand-based rate components. Null for residential segments without demand metering."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_peak_demand_kw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Average Peak Demand Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CustomerSegment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this segment classification record was first created in the system. Supports audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:CustomerSegment.creditRiskTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit risk tier"@en ;
    rdfs:comment "Aggregate credit risk classification for accounts in this segment based on historical payment performance, deposit requirements, and collections activity. Used for deposit policy and collections strategy segmentation."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_risk_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Risk Tier" ;
    cmm:validValues "low|medium|high|very_high" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.criticalInfrastructureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical infrastructure flag"@en ;
    rdfs:comment "Indicates whether this segment includes critical infrastructure customers (hospitals, emergency services, water treatment) requiring priority restoration during outages and enhanced service reliability."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_infrastructure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Infrastructure Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.demandResponseEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response eligible flag"@en ;
    rdfs:comment "Indicates whether accounts in this segment are eligible for demand response programs (CPP, TOU, direct load control). Eligibility based on load characteristics, metering capability, and regulatory program rules."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.derAdoptionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der adoption flag"@en ;
    rdfs:comment "Indicates whether this segment has notable DER (Distributed Energy Resource) adoption including solar PV, battery storage, or other behind-the-meter generation. Used to identify segments eligible for NEM (Net Energy Metering) and interconnection programs."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_adoption_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Adoption Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this segment classification expires or is superseded. Null for currently active segments. Supports historical segment analysis and regulatory reporting for prior periods."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CustomerSegment.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this segment classification becomes effective for customer account assignment and rate application. Supports temporal segmentation changes driven by rate case approvals or program launches."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CustomerSegment.evOwnershipFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ev ownership flag"@en ;
    rdfs:comment "Indicates whether this segment has significant electric vehicle ownership, making them candidates for EV-specific time-of-use rates and managed charging programs."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ev_ownership_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Electric Vehicle (EV) Ownership Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.interruptibleServiceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interruptible service flag"@en ;
    rdfs:comment "Indicates whether accounts in this segment are on interruptible rate schedules, allowing the utility to curtail service during peak demand or emergency conditions in exchange for discounted rates."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "interruptible_service_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interruptible Service Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this segment classification record was last updated. Tracks changes to segment definitions, eligibility rules, or statistical attributes."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CustomerSegment.loadFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load factor percent"@en ;
    rdfs:comment "Average load factor (ratio of average load to peak load) for this segment, expressed as percentage. Indicates load shape characteristics and efficiency of capacity utilization. Higher values indicate flatter, more efficient load profiles."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Factor Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CustomerSegment.loadProfileClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile class"@en ;
    rdfs:comment "Load profile classification code used for non-interval meter customers to estimate hourly consumption patterns. References standard load shapes maintained in MDM systems for settlement and forecasting purposes."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Profile Class" ;
    cmm:valuePattern "^[A-Z0-9_]{1,10}$" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.lowIncomeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "low income flag"@en ;
    rdfs:comment "Indicates whether this segment represents low-income customers eligible for special rate assistance programs, payment plans, or energy efficiency subsidies as defined by state PUC income thresholds."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "low_income_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Low Income Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.marketingProgramEligibility a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "marketing program eligibility"@en ;
    rdfs:comment "Comma-separated list of marketing and customer program codes that accounts in this segment are eligible for (e.g., energy efficiency rebates, solar incentives, EV charging programs). Used for targeted campaign management."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "marketing_program_eligibility" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Marketing Program Eligibility" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.netMeteringEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering eligible flag"@en ;
    rdfs:comment "Indicates whether accounts in this segment are eligible for NEM (Net Energy Metering) programs allowing customer-owned generation to offset consumption. Subject to state interconnection rules and capacity caps."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "net_metering_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.rateScheduleCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule category"@en ;
    rdfs:comment "High-level rate schedule category that this segment typically maps to for tariff application. Used by billing systems to determine applicable rate structures and riders. Reference-value candidates: residential|general_service|large_power|industrial|agricultural|municipal|lighting|standby|interruptible."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Category" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.regulatoryReportingClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting class"@en ;
    rdfs:comment "Standardized customer class code used for FERC Form 1, EIA-861, and state PUC regulatory reporting. Maps segment to required reporting categories for revenue, sales, and customer count statistics."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_reporting_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Class" ;
    cmm:valuePattern "^[A-Z0-9_]{1,20}$" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.rpsEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps eligible flag"@en ;
    rdfs:comment "Indicates whether accounts in this segment are subject to state RPS (Renewable Portfolio Standard) requirements or eligible for voluntary green power programs. Used for renewable energy allocation and REC (Renewable Energy Certificate) tracking."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rps_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.seasonalVariationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seasonal variation flag"@en ;
    rdfs:comment "Indicates whether this segment exhibits significant seasonal consumption variation (e.g., residential cooling load in summer, agricultural irrigation in growing season). Used for seasonal rate design and forecasting adjustments."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "seasonal_variation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Seasonal Variation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerSegment.segmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment code"@en ;
    rdfs:comment "Short alphanumeric code uniquely identifying the segment classification (e.g., RES_LOW, COM_MED, IND_LARGE). Used as business identifier in CIS systems (SAP IS-U, Oracle CC&B) for rate schedule assignment and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Segment Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerSegment.segmentDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment description"@en ;
    rdfs:comment "Detailed business description of the segment characteristics, typical customer profiles, usage patterns, and program applicability. Provides context for business users and supports segment definition documentation."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Segment Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CustomerSegment.segmentName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment name"@en ;
    rdfs:comment "Full descriptive name of the customer segment (e.g., Residential Low-Use, Small Commercial, Large Industrial). Human-readable label for business users and customer-facing communications."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Segment Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CustomerSegment.segmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment status"@en ;
    rdfs:comment "Current lifecycle status of the segment classification. Active segments are available for customer assignment; pending segments await regulatory approval; retired segments are maintained for historical reporting only."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Segment Status" ;
    cmm:validValues "active|inactive|pending|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:CustomerSegment.segmentTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "segment tier"@en ;
    rdfs:comment "Primary market segmentation tier defining the customer class and usage profile. Drives rate schedule eligibility, demand response program targeting, and regulatory reporting breakdowns for FERC and state PUC filings. Reference-value candidates: residential_low_use|residential_high_use|small_commercial|medium_commercial|large_commercial|industrial|agricultural|municipal|street_lighting|other."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "segment_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Segment Tier" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Geographic service territory or operating division code where this segment classification applies. Supports multi-jurisdiction utilities with territory-specific segmentation rules."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:valuePattern "^[A-Z0-9_]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Operational system of record that originated or maintains this segment classification (e.g., SAP IS-U, Oracle CC&B, custom segmentation engine). Supports data lineage and reconciliation."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_ISU|ORACLE_CCB|MDM|CUSTOM|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:CustomerSegment.timeOfUseEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time of use eligible flag"@en ;
    rdfs:comment "Indicates whether accounts in this segment are eligible for TOU (Time of Use) rate schedules with differentiated pricing by time period. Requires AMI metering capability and regulatory approval."@en ;
    rdfs:domain cmm:CustomerSegment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "time_of_use_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time of Use (TOU) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:CustomerServiceRequest a owl:Class ;
    rdfs:label "Customer Service Request"@en ;
    rdfs:comment "Transactional entity capturing customer-initiated service requests processed through CIS channels including start service, stop service, transfer service, meter re-read, high bill inquiry, payment arrangement request, medical baseline application, and DER interconnection inquiry. Stores request type, request channel (web, IVR, call center, mobile app, walk-in), request date and time, requested effective date, assigned work order reference, resolution status, resolution date, and resolution notes. Sourced from Oracle CC&B Service Request and SAP IS-U Service Order."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Request ;
    cmm:cimCloseMatch cim:Request ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.customer_service_request" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-8; Oracle CC&B Service Request / SAP IS-U Service Order" ;
    cmm:sourceObject "energy_utilities_ecm.customer.customer_service_request" ;
    owl:hasKey ( cmm:CustomerServiceRequest.customerServiceRequestId ) .

cmm:CustomerServiceRequest.customerServiceRequestId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer service request id"@en ;
    rdfs:comment "Unique identifier for the service request. Primary key for the service request entity."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:long ;
    cmm:physicalColumn "customer_service_request_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Service Request ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerServiceRequest.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with this service request. Links to the account master data in CIS."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_account_id" ;
    cmm:cimAssociation "Request.CustomerAccount" .
cmm:CustomerServiceRequest.contact a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contact"@en ;
    rdfs:comment "Foreign key linking to customer.contact. Business justification: Service request has embedded contact fields (contact_name, contact_phone, contact_email) that should be normalized to reference the contact table. This establishes which contact point the service requ"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:CustomerContact ;
    cmm:physicalColumn "contact_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contact Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_contact_id" ;
    cmm:cimAssociation "Request.ElectronicAddress" .
cmm:CustomerServiceRequest.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Service request costs (labor, materials, vehicle) are allocated to cost centers for activity-based costing and budget tracking. Essential for field service cost management and variance analysis. Real"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_cost_center_id" ;
    cmm:cimAssociation "Request.Organisation" .
cmm:CustomerServiceRequest.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Foreign key linking to customer.customer_service_agreement. Business justification: Service request should reference the specific service agreement it pertains to. Currently service_request has account_id and premise_id but no service_agreement_id. This FK establishes which service a"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_customer_service_agreement_id" ;
    cmm:cimAssociation "Request.CustomerAgreement" .
cmm:CustomerServiceRequest.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Service requests for DER installation, maintenance, inspection, and troubleshooting require direct linkage to the specific DER asset for work order management, compliance tracking, and customer servic"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_der_registry_id" ;
    cmm:cimAssociation "Request.PowerElectronicsConnection" .
cmm:CustomerServiceRequest.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Foreign key linking to distribution.transformer. Business justification: Transformer-specific service requests (load investigations, failure analysis, maintenance) require direct transformer reference for asset work order integration, capacity planning, and reliability tra"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Id (Foreign Key)" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_distribution_transformer_id" ;
    cmm:cimAssociation "Request.PowerTransformer" .
cmm:CustomerServiceRequest.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Service requests for voltage issues, power quality problems, or outage inquiries often originate from specific EMS alarms. Links customer-facing operations to grid operations for root cause analysis a"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_ems_alarm_id" ;
    cmm:cimAssociation "Request.ActivityRecord" .
cmm:CustomerServiceRequest.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Field service dispatch and crew routing require direct feeder context for switching order coordination, outage correlation, and SCADA-based fault location. Feeder-level assignment is operationally dis"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_feeder_id" ;
    cmm:cimAssociation "Request.Feeder" .
cmm:CustomerServiceRequest.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Service requests for DER system modifications, disconnections, export limit changes, or metering troubleshooting must reference the interconnection application for system specifications, approval hist"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_interconnection_application_id" ;
    cmm:cimAssociation "Request.Request" .
cmm:CustomerServiceRequest.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Field service work orders often collect costs via internal orders before settlement to assets (capitalized) or expense accounts. Critical for capital vs. expense classification and work order costing."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_internal_order_id" ;
    cmm:cimAssociation "Request.ErpProjectAccounting" .
cmm:CustomerServiceRequest.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to metering.meter. Business justification: Field service requests for meter testing, replacement, or investigation require direct meter reference. Supports work order dispatch, asset lifecycle management, and customer complaint resolution work"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_meter_id" ;
    cmm:cimAssociation "Request.Meter" .
cmm:CustomerServiceRequest.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise where the requested service will be performed. Links to premise master data."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_premise_id" ;
    cmm:cimAssociation "Request.ServiceLocation" .
cmm:CustomerServiceRequest.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Service requests often target specific customer-visible assets (streetlight, meter socket, service drop, pole guy wire). Essential for field service dispatch, asset maintenance triggering, and custome"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_registry_id" ;
    cmm:cimAssociation "Request.Asset" .
cmm:CustomerServiceRequest.warehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Field service requests require material dispatch from specific warehouses for repairs, installations, and maintenance. Operations teams need to track which warehouse fulfilled material requirements fo"@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Warehouse Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_warehouse_id" ;
    cmm:cimAssociation "Request.WorkLocation" .
cmm:CustomerServiceRequest.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the field work order created to fulfill this service request. Links to work management system for field execution tracking."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_service_request_work_order_id" ;
    cmm:cimAssociation "Request.Work" .
cmm:CustomerServiceRequest.actualCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual cost"@en ;
    rdfs:comment "Actual cost incurred to complete the service request. Populated after work completion for cost tracking and billing."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Service Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerServiceRequest.appointmentRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "appointment required flag"@en ;
    rdfs:comment "Indicates whether the service request requires scheduling a customer appointment for premise access. True for inside-meter work."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "appointment_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Appointment Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerServiceRequest.appointmentWindowEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "appointment window end"@en ;
    rdfs:comment "End of the scheduled appointment window for customer availability. Defines the time range for field technician arrival."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "appointment_window_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Appointment Window End" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerServiceRequest.appointmentWindowStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "appointment window start"@en ;
    rdfs:comment "Start of the scheduled appointment window for customer availability. Used for field dispatch coordination."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "appointment_window_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Appointment Window Start" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerServiceRequest.assignedTo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned to"@en ;
    rdfs:comment "Name or identifier of the CSR, team, or field technician assigned to handle this service request."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "assigned_to" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assigned To" ;
    cmm:cimDatatype "String" .
cmm:CustomerServiceRequest.billableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billable flag"@en ;
    rdfs:comment "Indicates whether the service request will result in a charge to the customer. True for billable services, false for no-charge requests."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerServiceRequest.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Reason code or description explaining why the service request was cancelled. Null for non-cancelled requests."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:CustomerServiceRequest.completedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completed date"@en ;
    rdfs:comment "Date when the service request was fully resolved and closed. Null for requests still in progress."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "completed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Request Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerServiceRequest.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this service request record was first created in the lakehouse silver layer. Audit trail for data ingestion."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Request.createdDateTime .
cmm:CustomerServiceRequest.customerSatisfactionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer satisfaction score"@en ;
    rdfs:comment "Customer satisfaction rating provided after service completion, typically on a 1-5 or 1-10 scale. Used for CRM and quality tracking."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_satisfaction_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Satisfaction Score" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerServiceRequest.estimatedCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated cost"@en ;
    rdfs:comment "Estimated cost to fulfill the service request, including labor, materials, and equipment. Used for customer notification and approval."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Service Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerServiceRequest.priority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Priority level assigned to the service request based on urgency, customer class, or regulatory requirements. Drives work order scheduling."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Request Priority" ;
    cmm:validValues "emergency|high|normal|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:CustomerServiceRequest.requestChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request channel"@en ;
    rdfs:comment "Channel through which the customer initiated the service request. Tracks customer engagement interface for multi-channel analytics."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Request Channel" ;
    cmm:validValues "web|mobile_app|ivr|call_center|walk_in|email" ;
    cmm:cimDatatype "String" .
cmm:CustomerServiceRequest.requestDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request date"@en ;
    rdfs:comment "Date when the service request was submitted by the customer or created in the CIS system."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "request_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Request Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerServiceRequest.requestDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request description"@en ;
    rdfs:comment "Detailed description of the service request provided by the customer or CSR. Free-text field capturing specific customer needs or issues."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service Request Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CustomerServiceRequest.requestNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request number"@en ;
    rdfs:comment "Business-facing unique identifier for the service request, displayed to customers and CSRs. Externally visible request tracking number."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Request Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerServiceRequest.requestStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request status"@en ;
    rdfs:comment "Current lifecycle status of the service request. Tracks progression from initiation through resolution or cancellation."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Request Status" ;
    cmm:validValues "pending|in_progress|completed|cancelled|on_hold|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.status .
cmm:CustomerServiceRequest.requestTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request timestamp"@en ;
    rdfs:comment "Precise date and time when the service request was created in the system. Principal business event timestamp for the transaction."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "request_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Request Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerServiceRequest.requestType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "request type"@en ;
    rdfs:comment "Category of service request initiated by the customer. Defines the nature of the requested action or inquiry. Reference-value candidates: start_service|stop_service|transfer_service|meter_reread|high_bill_inquiry|payment_arrangement|medical_baseline|der_interconnection|service_upgrade|outage_report|billing_dispute|name_change|other."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "request_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Request Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.type .
cmm:CustomerServiceRequest.requestedEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested effective date"@en ;
    rdfs:comment "Date requested by the customer for the service action to take effect. For start/stop/transfer requests, this is the desired service date."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "requested_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerServiceRequest.resolutionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution notes"@en ;
    rdfs:comment "Notes documenting how the service request was resolved, actions taken, or reasons for cancellation. Populated upon request closure."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Resolution Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:CustomerServiceRequest.scheduledDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled date"@en ;
    rdfs:comment "Date scheduled by the utility for field work or service action. May differ from requested effective date based on operational constraints."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Service Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerServiceRequest.slaMetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla met flag"@en ;
    rdfs:comment "Indicates whether the service request was completed within the SLA target timeframe. Used for performance reporting."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_met_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerServiceRequest.slaTargetHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla target hours"@en ;
    rdfs:comment "Target number of hours for service request resolution as defined by utility SLA or regulatory requirements."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:int ;
    cmm:physicalColumn "sla_target_hours" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Target Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:CustomerServiceRequest.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Originating system that created the service request record. Identifies the CIS or channel system of record."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "oracle_ccb|sap_isu|mobile_app|ivr|web_portal|call_center" ;
    cmm:cimDatatype "String" .
cmm:CustomerServiceRequest.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Unique identifier of the service request in the source system. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System ID" ;
    cmm:cimDatatype "String" .
cmm:CustomerServiceRequest.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this service request record was last modified in the lakehouse silver layer. Tracks data refresh cycles."@en ;
    rdfs:domain cmm:CustomerServiceRequest ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:CustomerInteraction a owl:Class ;
    rdfs:label "Customer Interaction"@en ;
    rdfs:comment "Transactional entity capturing all multi-channel customer engagement interactions including inbound calls, outbound calls, web chat sessions, email exchanges, IVR self-service completions, mobile app sessions, and in-person visits. Stores interaction date and time, channel type, interaction category (billing inquiry, outage report, payment, complaint, general inquiry), agent ID, call duration, IVR containment flag, sentiment classification, case reference, and interaction outcome. Supports CRM analytics and regulatory complaint tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.interaction" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Oracle CC&B Customer Contact / SAP IS-U Interaction Record" ;
    cmm:sourceObject "energy_utilities_ecm.customer.interaction" ;
    owl:hasKey ( cmm:CustomerInteraction.interactionId ) .

cmm:CustomerInteraction.interactionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interaction id"@en ;
    rdfs:comment "Unique surrogate identifier for each customer interaction record in the CIS/CRM platform. Primary key for the interaction entity."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:long ;
    cmm:physicalColumn "interaction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Interaction ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInteraction.case a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "case"@en ;
    rdfs:comment "Reference to the CRM case or service request created or updated as a result of this interaction. Nullable when the interaction does not generate a case."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerCase ;
    cmm:physicalColumn "case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Case ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_case_id" ;
    cmm:cimAssociation "ActivityRecord.TroubleTicket" .
cmm:CustomerInteraction.complaint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "complaint"@en ;
    rdfs:comment "Foreign key linking to customer.complaint. Business justification: Interaction currently has complaint_flag (BOOLEAN) and regulatory_complaint_reference (STRING) which are denormalized. This should be replaced with a proper FK to complaint. Many interactions can refe"@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerComplaint ;
    cmm:physicalColumn "complaint_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Complaint Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_complaint_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:CustomerInteraction.customerServiceRequest a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service request"@en ;
    rdfs:comment "Foreign key linking to customer.service_request. Business justification: Interaction currently has service_request_number (STRING) which is a denormalized reference. This should be replaced with a proper FK to service_request. Many interactions can reference one service re"@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerServiceRequest ;
    cmm:physicalColumn "customer_service_request_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Request Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_customer_service_request_id" ;
    cmm:cimAssociation "ActivityRecord.Request" .
cmm:CustomerInteraction.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the customer service representative or agent who handled this interaction. Null for fully automated IVR or self-service interactions."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Agent ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:CustomerInteraction.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Contact centers link customer service interactions to specific outage events for ETR inquiries, complaint tracking, and regulatory reporting on outage communication quality. The existing outage_event_"@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_event_id" ;
    cmm:cimAssociation "ActivityRecord.Outage" .
cmm:CustomerInteraction.interactionAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interaction account"@en ;
    rdfs:comment "Reference to the utility service account associated with this interaction. A customer may have multiple accounts (residential, commercial, NEM/BTM). Links to the account master."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "interaction_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_interaction_account_id" ;
    cmm:cimAssociation "ActivityRecord.CustomerAccount" .
cmm:CustomerInteraction.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer who initiated or was the subject of this interaction. Links to the customer master record in the Customer Information System (CIS)."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_profile_id" ;
    cmm:cimAssociation "ActivityRecord.Customer" .
cmm:CustomerInteraction.toAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to account"@en ;
    rdfs:comment "FK to customer.account.account_id — Customer interactions are associated with an account for CRM tracking. interaction.account_id → account.account_id."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "to_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_interaction_to_account_id" ;
    cmm:cimAssociation "ActivityRecord.CustomerAccount" .
cmm:CustomerInteraction.agentQueue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agent queue"@en ;
    rdfs:comment "The call center queue or skill group to which this interaction was routed (e.g., 'billing', 'technical_support', 'collections', 'spanish_language', 'commercial_accounts'). Used for workforce management and routing optimization analytics."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "agent_queue" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agent Queue" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.callbackScheduledTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "callback scheduled timestamp"@en ;
    rdfs:comment "Date and time scheduled for a return call to the customer when interaction_outcome is 'callback_scheduled'. Null when no callback was arranged."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "callback_scheduled_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Callback Scheduled Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerInteraction.channelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel type"@en ;
    rdfs:comment "The communication channel through which the customer interaction occurred. Supports omni-channel CRM analytics and channel cost allocation. IVR (Interactive Voice Response) interactions are self-service completions without agent involvement. Reference-value candidates: inbound_call|outbound_call|web_chat|email|ivr|mobile_app|in_person."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Channel Type" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.complaintFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint flag"@en ;
    rdfs:comment "Indicates whether this interaction was classified as a formal customer complaint. True = complaint. Drives regulatory complaint tracking and reporting to State Public Utility Commissions (PUCs) as required by retail rate regulation."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "complaint_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Complaint Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.contactCenterSite a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contact center site"@en ;
    rdfs:comment "Identifier for the physical or virtual contact center site that handled this interaction (e.g., 'Phoenix_AZ', 'Virtual_Home_Agent', 'Offshore_Partner_Manila'). Supports site-level performance benchmarking and cost allocation."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "contact_center_site" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contact Center Site" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this interaction record was first created in the source CIS/CRM system. Serves as the audit creation timestamp for data lineage and Silver layer ingestion tracking."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:CustomerInteraction.customerSatisfactionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer satisfaction score"@en ;
    rdfs:comment "Post-interaction customer satisfaction score collected via IVR survey, email survey, or SMS (typically 1–5 scale). Null when no survey response was received. Supports CRM analytics and PUC service quality reporting."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_satisfaction_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Satisfaction Score (CSAT)" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInteraction.demandResponseEnrollmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response enrollment flag"@en ;
    rdfs:comment "Indicates whether the customer enrolled in or modified a Demand Response (DR) or energy efficiency program during this interaction. True = DR enrollment action taken. Supports DERMS integration and regulatory DR program reporting."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_enrollment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.direction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "Indicates whether the interaction was initiated by the customer (inbound) or by the utility (outbound, e.g., proactive outage notification, collections call, demand response enrollment outreach)."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Direction" ;
    cmm:validValues "inbound|outbound" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.durationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration seconds"@en ;
    rdfs:comment "Total elapsed time of the interaction in seconds from start to end. For calls, this is the total call handle time including hold time. Used for SLA compliance measurement and workforce management analytics."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:int ;
    cmm:physicalColumn "duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:CustomerInteraction.endTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end timestamp"@en ;
    rdfs:comment "Date and time when the customer interaction concluded (call disconnected, chat session closed, email response sent, visit ended). Used to compute handle time and duration metrics."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CustomerInteraction.escalationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "escalation flag"@en ;
    rdfs:comment "Indicates whether this interaction was escalated to a supervisor, specialist team, or regulatory complaint handler during or after the session. True = escalated. Supports regulatory complaint tracking required by PUC reporting."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "escalation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Escalation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.escalationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "escalation reason"@en ;
    rdfs:comment "Free-text or coded reason for escalation when escalation_flag is True (e.g., 'customer_requested_supervisor', 'regulatory_complaint', 'unresolved_billing_dispute'). Required for PUC complaint tracking and quality assurance."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "escalation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Escalation Reason" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.firstContactResolutionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "first contact resolution flag"@en ;
    rdfs:comment "Indicates whether the customer's issue was fully resolved during this single interaction without requiring a follow-up contact. True = resolved at first contact. Key CRM KPI and PUC service quality metric."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "first_contact_resolution_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "First Contact Resolution (FCR) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.holdDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hold duration seconds"@en ;
    rdfs:comment "Total time in seconds the customer was placed on hold during a call interaction. Contributes to customer experience scoring and agent performance metrics. Applicable primarily to inbound and outbound call channels."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:int ;
    cmm:physicalColumn "hold_duration_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hold Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:CustomerInteraction.interactionCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interaction category"@en ;
    rdfs:comment "High-level business category classifying the primary purpose of the interaction. 'outage_report' links to OMS event tracking. 'meter_inquiry' relates to AMI/MDM data. 'billing_inquiry' is the most frequent category in utility CRM. Reference-value candidates: billing_inquiry|outage_report|payment|complaint|general_inquiry|service_request|meter_inquiry|demand_response|new_service|disconnect_request."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "interaction_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.kind .
cmm:CustomerInteraction.interactionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interaction date"@en ;
    rdfs:comment "Calendar date on which the interaction occurred, derived from interaction_start_timestamp. Stored as a separate DATE field to support efficient date-partitioned queries, daily reporting, and regulatory complaint date tracking."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:date ;
    cmm:physicalColumn "interaction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerInteraction.interactionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interaction status"@en ;
    rdfs:comment "Current lifecycle status of the interaction record. 'abandoned' applies to IVR or chat sessions where the customer disconnected before resolution. 'escalated' indicates transfer to a higher-tier agent or supervisor."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "interaction_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction Status" ;
    cmm:validValues "open|in_progress|completed|abandoned|escalated|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:CustomerInteraction.ivrContainmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ivr containment flag"@en ;
    rdfs:comment "Indicates whether the customer's need was fully resolved within the IVR self-service system without requiring transfer to a live agent. True = IVR-contained; False = transferred to agent or unresolved. Key metric for IVR optimization and cost-to-serve analysis."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ivr_containment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interactive Voice Response (IVR) Containment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.ivrMenuPath a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ivr menu path"@en ;
    rdfs:comment "Sequence of IVR menu selections made by the customer during the interaction (e.g., '1>3>2' representing the menu tree traversal). Used for IVR design optimization and self-service analytics."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "ivr_menu_path" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interactive Voice Response (IVR) Menu Path" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.languageCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "language code"@en ;
    rdfs:comment "ISO 639-1 language code for the language used during the interaction (e.g., 'en', 'es', 'zh-TW'). Supports multilingual service analytics and compliance with state language access requirements for utility customers."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "language_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Language Code" ;
    cmm:valuePattern "^[a-z]{2}(-[A-Z]{2})?$" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.nemInquiryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem inquiry flag"@en ;
    rdfs:comment "Indicates whether this interaction involved a Net Energy Metering (NEM) inquiry, application, or billing question related to a customer's behind-the-meter (BTM) distributed energy resource (DER) such as rooftop solar. Supports NEM program analytics."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_inquiry_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Inquiry Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes entered by the agent summarizing the interaction, customer concerns, actions taken, and follow-up commitments. Confidential as may contain sensitive account or personal context. Stored in Oracle CC&B or SAP IS-U CRM activity log."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction Notes" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CustomerInteraction.outcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outcome"@en ;
    rdfs:comment "The result or disposition of the interaction at its conclusion. 'follow_up_required' triggers a subsequent outbound contact. 'callback_scheduled' indicates a scheduled return call was arranged. Used for first-contact resolution (FCR) measurement."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Outcome" ;
    cmm:validValues "resolved|unresolved|follow_up_required|escalated|callback_scheduled" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.paymentArrangementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement flag"@en ;
    rdfs:comment "Indicates whether a payment arrangement or deferred payment plan was established during this interaction. True = payment arrangement created. Supports collections analytics and FICA (Financial Customer Accounting) integration in SAP IS-U."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "payment_arrangement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Arrangement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.referenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reference number"@en ;
    rdfs:comment "Externally visible alphanumeric reference number assigned to this interaction, communicated to the customer as a confirmation or tracking number (e.g., from Oracle CC&B or SAP IS-U interaction log)."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerInteraction.sentimentClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sentiment classification"@en ;
    rdfs:comment "Customer sentiment assessed during or after the interaction, derived from speech analytics, text analysis, or agent classification. Supports CRM analytics, churn risk modeling, and regulatory complaint identification. 'highly_negative' may trigger proactive follow-up."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "sentiment_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sentiment Classification" ;
    cmm:validValues "positive|neutral|negative|highly_negative" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the operational system of record from which this interaction record originated (e.g., SAP IS-U CRM, Oracle CC&B, Genesys telephony platform). Supports data lineage and Silver layer reconciliation."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "SAP_ISU|ORACLE_CCB|SALESFORCE|GENESYS|AVAYA|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.sourceSystemInteractionReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system interaction reference"@en ;
    rdfs:comment "The native interaction identifier from the originating source system (e.g., Oracle CC&B interaction log ID, SAP IS-U activity number, Genesys call GUID). Enables traceability back to the system of record for audit and reconciliation."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_interaction_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Interaction ID" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.startTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start timestamp"@en ;
    rdfs:comment "Date and time when the customer interaction began (call connected, chat session opened, email received, in-person visit commenced). Principal business event timestamp per TRANSACTION_HEADER role. Stored in ISO 8601 format yyyy-MM-ddTHH:mm:ss.SSSXXX."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Interaction Start Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CustomerInteraction.subcategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subcategory"@en ;
    rdfs:comment "Granular sub-classification of the interaction within its category (e.g., 'high_bill_dispute' under billing_inquiry, 'payment_arrangement' under payment, 'tree_contact' under outage_report). Supports root-cause analytics and agent training."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:string ;
    cmm:physicalColumn "subcategory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interaction Subcategory" ;
    cmm:cimDatatype "String" .
cmm:CustomerInteraction.surveyResponseFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "survey response flag"@en ;
    rdfs:comment "Indicates whether the customer completed a post-interaction satisfaction survey. True = survey completed. Used to calculate survey response rates and validate CSAT score population."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "survey_response_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Survey Response Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.touRateInquiryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou rate inquiry flag"@en ;
    rdfs:comment "Indicates whether the interaction involved a Time-of-Use (TOU) or Critical Peak Pricing (CPP) rate plan inquiry, enrollment, or change request. Supports rate analytics and AMI-enabled pricing program adoption tracking."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "tou_rate_inquiry_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Rate Inquiry Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerInteraction.transferCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transfer count"@en ;
    rdfs:comment "Number of times the interaction was transferred between agents, queues, or departments during a single session. High transfer counts indicate routing inefficiency and negatively impact customer satisfaction scores."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:int ;
    cmm:physicalColumn "transfer_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transfer Count" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInteraction.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to this interaction record in the source system. Used for incremental data pipeline processing and audit trail compliance."@en ;
    rdfs:domain cmm:CustomerInteraction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:CustomerComplaint a owl:Class ;
    rdfs:label "Customer Complaint"@en ;
    rdfs:comment "Transactional entity capturing formal customer complaints filed through regulatory channels (PUC/PSC), internal escalation paths, or third-party mediators. Stores complaint date, complaint type (billing dispute, service quality, outage response, disconnection, rate dispute, discrimination, safety), complaint source (customer direct, PUC referral, BBB, social media, legislative inquiry), assigned resolution owner, regulatory docket number, PUC/PSC case reference, resolution deadline, resolution date, resolution type (upheld, dismissed, settled, withdrawn), customer satisfaction outcome, and escalation tier. Required for FERC, PUC, and state PSC regulatory reporting on complaint volumes, resolution rates, and response times."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.complaint" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Oracle CC&B Case / SAP IS-U Complaint Management" ;
    cmm:sourceObject "energy_utilities_ecm.customer.complaint" ;
    owl:hasKey ( cmm:CustomerComplaint.complaintId ) .

cmm:CustomerComplaint.complaintId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint id"@en ;
    rdfs:comment "Unique surrogate identifier for each formal customer complaint record in the Customer Information System (CIS). Primary key for the complaint data product."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:long ;
    cmm:physicalColumn "complaint_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Complaint ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerComplaint.complaintAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "complaint account"@en ;
    rdfs:comment "Reference to the utility service account associated with the complaint. A customer may have multiple accounts; this identifies the specific account under dispute."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "complaint_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_complaint_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:CustomerComplaint.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Complaint resolution costs (investigation time, remediation work, customer credits) are allocated to cost centers for cost-of-quality tracking and regulatory compliance reporting. Real business proces"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CustomerComplaint.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Reference to the specific service agreement (rate schedule, tariff contract, or NEM agreement) under which the complaint arises. Relevant for rate dispute, NEM, and DER-related complaints."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_customer_service_agreement_id" ;
    cmm:cimAssociation "Document.CustomerAgreement" .
cmm:CustomerComplaint.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Complaints about DER performance, interconnection issues, NEM billing disputes, or export credit discrepancies require tracking the specific DER asset for root cause analysis, regulatory reporting, an"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_der_registry_id" ;
    cmm:cimAssociation "Document.PowerElectronicsConnection" .
cmm:CustomerComplaint.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the internal employee or team responsible for resolving the complaint. Used for workload management, SLA accountability, and performance reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned Resolution Owner ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CustomerComplaint.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Customer complaints about power quality, voltage sags, or flickering frequently reference specific EMS alarms. Essential for root cause investigation, regulatory response documentation, and PUC case e"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_ems_alarm_id" ;
    cmm:cimAssociation "Document.ActivityRecord" .
cmm:CustomerComplaint.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the outage event in the Outage Management System (OMS) that is the subject of or contributed to the complaint. Populated for outage_response and service_quality complaint types to enable cross-domain analysis."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_event_id" ;
    cmm:cimAssociation "Document.Outage" .
cmm:CustomerComplaint.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Power quality complaints, voltage deviation issues, and outage-related complaints are investigated and resolved at feeder level. Direct feeder link supports reliability root cause analysis, SAIDI/SAIF"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_feeder_id" ;
    cmm:cimAssociation "Document.Feeder" .
cmm:CustomerComplaint.gridReliabilityEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid reliability event"@en ;
    rdfs:comment "Foreign key linking to grid.grid_reliability_event. Business justification: Formal customer complaints reference NERC-reportable reliability events for regulatory filings, customer communication, and claims processing. Direct operational link required for OE-417 reporting and"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:GridReliabilityEvent ;
    cmm:physicalColumn "grid_reliability_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Reliability Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_grid_reliability_event_id" ;
    cmm:cimAssociation "Document.PSREvent" .
cmm:CustomerComplaint.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Complaints about interconnection process delays, queue position disputes, export limitations, or metering accuracy must reference the specific application for regulatory reporting (PUC case tracking)"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:CustomerComplaint.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the Advanced Metering Infrastructure (AMI) meter associated with the complaint. Populated for meter accuracy, estimated read, or AMI-related complaints to enable cross-domain investigation with the MDM system."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_meter_id" ;
    cmm:cimAssociation "Document.Meter" .
cmm:CustomerComplaint.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise (physical location) related to the complaint, such as the address experiencing a service quality issue or outage-related grievance."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_premise_id" ;
    cmm:cimAssociation "Document.ServiceLocation" .
cmm:CustomerComplaint.priorComplaint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "prior complaint"@en ;
    rdfs:comment "Reference to the most recent prior complaint from the same customer on the same issue, when is_repeat_complaint is true. Enables complaint chain analysis and chronic issue identification."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CustomerComplaint ;
    cmm:physicalColumn "prior_complaint_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Prior Complaint ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_prior_complaint_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:CustomerComplaint.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer who filed the complaint. Links to the customer master record in the CIS (SAP IS-U or Oracle CC&B)."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_profile_id" ;
    cmm:cimAssociation "Document.Customer" .
cmm:CustomerComplaint.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Customer complaints frequently reference specific problematic assets (noisy transformer, leaning pole, damaged streetlight). Critical for asset condition monitoring, failure pattern analysis, and regu"@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_registry_id" ;
    cmm:cimAssociation "Document.Asset" .
cmm:CustomerComplaint.toAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to account"@en ;
    rdfs:comment "FK to customer.account.account_id — Complaints are filed by/about a customer account. complaint.account_id → account.account_id. Required for PUC regulatory reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "to_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_complaint_to_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:CustomerComplaint.assignedDepartment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assigned department"@en ;
    rdfs:comment "Name or code of the internal department or business unit assigned ownership of the complaint resolution (e.g., Customer Service, Billing, Regulatory Affairs, Field Operations)."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "assigned_department" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assigned Department" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.billingDisputeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing dispute amount"@en ;
    rdfs:comment "Monetary amount in dispute for billing-related complaints, expressed in the local currency (USD). Populated only when complaint_type is billing_dispute or rate_dispute. Used for financial impact analysis and regulatory reporting on disputed revenue."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "billing_dispute_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Dispute Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerComplaint.complaintDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint description"@en ;
    rdfs:comment "Full narrative text of the complaint as submitted by the customer or regulatory body. Contains the customer's account of the issue, relevant dates, and requested remedy. Treated as confidential due to potential inclusion of sensitive account details."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "complaint_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Complaint Description" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CustomerComplaint.complaintNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint number"@en ;
    rdfs:comment "Externally visible, human-readable complaint reference number assigned at intake. Used in all customer-facing correspondence, regulatory filings, and PUC/PSC docket cross-references. Format: CMP-YYYY-NNNNNNN."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "complaint_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Number" ;
    cmm:valuePattern "^CMP-[0-9]{4}-[0-9]{7}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerComplaint.complaintSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint source"@en ;
    rdfs:comment "Channel or originating party through which the complaint was received. Distinguishes internally filed complaints from those escalated via regulatory bodies (PUC referral), third-party mediators (BBB), or legislative offices."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "complaint_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Complaint Source" ;
    cmm:validValues "customer_direct|puc_referral|bbb|social_media|legislative_inquiry|ombudsman" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.complaintStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint status"@en ;
    rdfs:comment "Current lifecycle state of the complaint within the resolution workflow. Drives SLA monitoring, regulatory reporting, and workload management for the customer service and regulatory affairs teams. Reference-value candidates: open|under_review|pending_customer|escalated|resolved|closed|withdrawn."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "complaint_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CustomerComplaint.complaintType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "complaint type"@en ;
    rdfs:comment "Primary classification of the complaint subject matter. Drives routing, regulatory reporting, and resolution workflow. Reference-value candidates: billing_dispute|service_quality|outage_response|disconnection|rate_dispute|discrimination|safety|meter_accuracy|net_energy_metering|demand_response|deposit_dispute|other."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "complaint_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:CustomerComplaint.contactChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contact channel"@en ;
    rdfs:comment "Channel through which the customer submitted the complaint to the utility (distinct from complaint_source which identifies the originating party). Used for multi-channel engagement analytics and CRM reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "contact_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contact Channel" ;
    cmm:validValues "phone|email|web_portal|in_person|mail|mobile_app" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the complaint record was first created in the CIS or data platform. Audit trail field for data lineage and SOX internal controls. Distinct from filed_timestamp which captures the business event time."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:CustomerComplaint.creditIssuedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit issued amount"@en ;
    rdfs:comment "Monetary credit applied to the customer's account as part of the complaint resolution, expressed in USD. Tracks financial remedies granted to customers and supports revenue adjustment reporting and SOX controls."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_issued_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Issued Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerComplaint.customerSatisfactionOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer satisfaction outcome"@en ;
    rdfs:comment "Categorical outcome of the customer's satisfaction assessment following complaint resolution. Derived from post-resolution survey or follow-up contact. Complements the numeric satisfaction score for reporting and segmentation."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_satisfaction_outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Satisfaction Outcome" ;
    cmm:validValues "satisfied|neutral|dissatisfied|no_response" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.customerSatisfactionScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer satisfaction score"@en ;
    rdfs:comment "Post-resolution satisfaction rating provided by the customer, typically on a 1–5 or 1–10 scale. Captured via follow-up survey after complaint closure. Used for service quality analytics and CRM performance reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_satisfaction_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Satisfaction Score" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerComplaint.customerSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer segment"@en ;
    rdfs:comment "Classification of the customer's service segment at the time of complaint filing. Used for regulatory reporting breakdowns (e.g., low-income customer complaints, NEM participant disputes) and service quality analytics by segment."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "customer_segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Segment" ;
    cmm:validValues "residential|commercial|industrial|nem_participant|der_enrolled|low_income" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.escalationTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "escalation tier"@en ;
    rdfs:comment "Escalation level of the complaint within the internal resolution hierarchy. Tier 1 is front-line customer service; Tier 2 is supervisor/specialist; Tier 3 is executive or legal; Regulatory indicates PUC/PSC or FERC involvement."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "escalation_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Escalation Tier" ;
    cmm:validValues "tier_1|tier_2|tier_3|regulatory" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.filedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filed timestamp"@en ;
    rdfs:comment "Date and time when the complaint was formally received and logged in the CIS. This is the principal business event timestamp used to calculate regulatory response deadlines and SLA compliance."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "filed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Complaint Filed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerComplaint.firstResponseTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "first response timestamp"@en ;
    rdfs:comment "Date and time when the utility first acknowledged or responded to the complaint. Used to measure initial response time against regulatory and SLA targets."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "first_response_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "First Response Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerComplaint.isRegulatoryFormal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is regulatory formal"@en ;
    rdfs:comment "Indicates whether the complaint has been formally filed with or referred by a regulatory authority (PUC, PSC, FERC). Formal regulatory complaints trigger mandatory response timelines and are included in regulatory reporting submissions."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_regulatory_formal" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Regulatory Formal Complaint Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerComplaint.isRepeatComplaint a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is repeat complaint"@en ;
    rdfs:comment "Indicates whether this complaint is a repeat filing by the same customer for the same or substantially similar issue within a defined lookback period. Used to identify chronic service failures and customers at risk of regulatory escalation."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_repeat_complaint" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Repeat Complaint Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerComplaint.isSafetyRelated a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is safety related"@en ;
    rdfs:comment "Indicates whether the complaint involves a safety concern (e.g., downed power lines, gas leak, electrical hazard, unsafe disconnection). Safety-related complaints require immediate escalation and are subject to OSHA and NERC CIP reporting obligations."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_safety_related" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Is Safety-Related Complaint Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerComplaint.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to the complaint record in the CIS or data platform. Used for incremental data pipeline processing, audit trails, and SOX internal controls."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CustomerComplaint.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for internal case notes, follow-up actions, and investigative findings recorded by the assigned resolution owner throughout the complaint lifecycle. Not shared externally."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:CustomerComplaint.priority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Business priority assigned to the complaint based on regulatory sensitivity, safety risk, customer segment, or escalation source. Drives SLA response time targets and resource allocation."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Priority" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:CustomerComplaint.pucCaseReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc case reference"@en ;
    rdfs:comment "Official case or docket number assigned by the state Public Utility Commission (PUC) or Public Service Commission (PSC) when the complaint is filed through or referred to the regulatory body. Required for regulatory reporting and docket tracking."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_case_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Case Reference" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.regulatoryDocketNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory docket number"@en ;
    rdfs:comment "Formal docket or proceeding number assigned by FERC, state PUC/PSC, or other regulatory authority for complaints that escalate to formal regulatory proceedings. Distinct from the PUC case reference which may be an informal tracking number."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_docket_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Regulatory Docket Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CustomerComplaint.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "State or federal regulatory jurisdiction governing the complaint (e.g., state abbreviation for PUC/PSC jurisdiction, or 'FERC' for federal wholesale market complaints). Required for multi-state utility regulatory reporting segmentation."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.resolutionDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution description"@en ;
    rdfs:comment "Narrative explanation of the actions taken and outcome achieved to resolve the complaint. Documents the remedy offered, root cause identified, and any corrective actions applied to the customer's account or service."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Description" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.resolutionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution due date"@en ;
    rdfs:comment "Deadline by which the complaint must be fully resolved, as defined by regulatory mandate, internal SLA policy, or PUC/PSC order. Distinct from the initial response due date."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:date ;
    cmm:physicalColumn "resolution_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Due Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerComplaint.resolutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution timestamp"@en ;
    rdfs:comment "Date and time when the complaint was formally resolved and closed. Used to calculate total resolution cycle time for regulatory reporting on complaint resolution rates and response times."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "resolution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Complaint Resolution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CustomerComplaint.resolutionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution type"@en ;
    rdfs:comment "Outcome classification of the complaint resolution. Indicates whether the complaint was upheld in the customer's favor, dismissed, settled by mutual agreement, withdrawn by the customer, referred to another authority, or partially upheld."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Type" ;
    cmm:validValues "upheld|dismissed|settled|withdrawn|referred|partially_upheld" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.responseDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response due date"@en ;
    rdfs:comment "Deadline by which the utility must provide an initial response to the complaint, as mandated by state PUC/PSC service standards or FERC regulations. Used for SLA compliance monitoring and regulatory reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:date ;
    cmm:physicalColumn "response_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Response Due Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerComplaint.rootCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause code"@en ;
    rdfs:comment "Standardized code identifying the underlying root cause of the complaint (e.g., billing system error, meter read failure, field crew delay, tariff misapplication). Used for trend analysis, process improvement, and regulatory root cause reporting. Reference-value candidates: billing_system_error|meter_read_failure|field_crew_delay|tariff_misapplication|estimated_read|disconnection_error|payment_processing|communication_failure|equipment_failure|other."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "root_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerComplaint.slaResolutionMet a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla resolution met"@en ;
    rdfs:comment "Indicates whether the utility met the regulatory or internal SLA target for full complaint resolution. Derived at record closure from resolution_timestamp vs. resolution_due_date. Key metric for PUC/PSC complaint resolution rate reporting."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_resolution_met" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Resolution Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerComplaint.slaResponseMet a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla response met"@en ;
    rdfs:comment "Indicates whether the utility met the regulatory or internal SLA target for initial response to the complaint. Derived at record closure from first_response_timestamp vs. response_due_date. Used for SLA compliance reporting to PUC/PSC."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_response_met" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Response Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerComplaint.subject a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Brief, structured subject line summarizing the nature of the complaint. Used for search, reporting, and initial triage by customer service representatives."@en ;
    rdfs:domain cmm:CustomerComplaint ; rdfs:range xsd:string ;
    cmm:physicalColumn "subject" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Complaint Subject" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.subject .

cmm:CustomerEnrollment a owl:Class ;
    rdfs:label "Customer Enrollment"@en ;
    rdfs:comment "Transactional entity and SSOT for all customer program participation across the utility. Captures enrollments in demand response (DR), time-of-use (TOU) rate plans, critical peak pricing (CPP) tariffs, budget billing, auto-pay, paperless billing, Net Energy Metering (NEM 1.0/2.0/3.0/NEM-ST) including interconnection application date, approval date, permission-to-operate date, installed capacity (kW-DC), inverter type, technology type (PV, wind, CHP), export compensation rate, annual true-up month, and cumulative export credits. Captures DER/VPP aggregation program enrollments including DER asset type (rooftop solar, battery storage, EV charger, smart thermostat, generator), DER registration ID, DERMS system reference, aggregator name, VPP program code, telemetry availability flag, communication protocol (IEEE 2030.5, OpenADR, Modbus), and dispatch authorization level. Captures medical baseline allowance certifications including certification type (life support, medical baseline allowance), qualifying condition, physician certification date, certification expiration, renewal reminder date, approved additional baseline kWh per day, and life-support equipment type (oxygen concentrator, dialysis, ventilator). Captures low-income assistance program enrollments (LIHEAP, CARE, FERA), green energy programs, EV charging incentive programs, and arrearage management plans. Stores program code, enrollment date, enrollment channel, enrollment status, effective start and end dates, opt-out date and reason, and all program-specific eligibility and technical attributes. Supports FERC Order 2222 compliance, PUC medical baseline tariff compliance, disconnection protection rules, and regulatory reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.customer_enrollment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Oracle CC&B Program Subscription / SAP IS-U Program Enrollment" ;
    cmm:sourceObject "energy_utilities_ecm.customer.customer_enrollment" ;
    owl:hasKey ( cmm:CustomerEnrollment.customerEnrollmentId ) .

cmm:CustomerEnrollment.customerEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer enrollment id"@en ;
    rdfs:comment "Unique surrogate identifier for each customer program enrollment record in the utility's Customer Information System (CIS). Primary key for the enrollment entity."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "customer_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Enrollment ID" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerEnrollment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the utility service account under which the enrollment is registered. A customer may have multiple accounts (premises) with independent enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:CustomerEnrollment.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Foreign key linking to customer.customer_service_agreement. Business justification: Enrollment represents program participation and should reference the specific service agreement under which the customer is enrolled. Currently enrollment has account_id and premise_id but no service_"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_customer_service_agreement_id" ;
    cmm:cimAssociation "Agreement.CustomerAgreement" .
cmm:CustomerEnrollment.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "The unique registration identifier assigned to the customer's DER asset in the utility's Distributed Energy Resource Management System (DERMS). Used for dispatch, telemetry, and FERC Order 2222 aggregation tracking."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Registration ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_der_registry_id" ;
    cmm:cimAssociation "Agreement.PowerElectronicsConnection" .
cmm:CustomerEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to demand.dr_program. Business justification: Customer DR program enrollment requires proper FK to dr_program for tracking enrollment terms, incentive structures, and regulatory compliance. Currently uses denormalized program_code/name. Essential"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_dr_program_id" ;
    cmm:cimAssociation "Agreement.DemandResponseProgram" .
cmm:CustomerEnrollment.financialAssistanceProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "financial assistance program"@en ;
    rdfs:comment "Foreign key linking to billing.assistance_program. Business justification: Low-income and medical baseline enrollments must reference the authoritative financial assistance program in billing to ensure correct discount application, verify eligibility criteria match, and supp"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:AssistanceProgram ;
    cmm:physicalColumn "financial_assistance_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Financial Assistance Program Id (Foreign Key)" ;
    cmm:sourceColumn "assistance_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_financial_assistance_program_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:CustomerEnrollment.incentiveProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "incentive program"@en ;
    rdfs:comment "Foreign key linking to renewable.incentive_program. Business justification: Customer enrollments in solar, storage, and renewable incentive programs require direct linkage for payment processing, compliance verification, budget tracking, and regulatory reporting. Essential fo"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:IncentiveProgram ;
    cmm:physicalColumn "incentive_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Incentive Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_incentive_program_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:CustomerEnrollment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Customer DER program enrollments (NEM, demand response, VPP) originate from interconnection applications; tracking the originating application enables program eligibility verification, capacity valida"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_interconnection_application_id" ;
    cmm:cimAssociation "Agreement.Request" .
cmm:CustomerEnrollment.interconnectionAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: DER enrollments must reference the interconnection asset (inverter, generation equipment, storage system) for NEM export tracking, Rule 21 compliance, and grid impact studies. Mandated by interconnect"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "interconnection_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_interconnection_asset_registry_id" ;
    cmm:cimAssociation "Agreement.Asset" .
cmm:CustomerEnrollment.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: DER/NEM program enrollments require specific equipment installations (inverters, smart meters, interconnection hardware). Tracking approved equipment specifications ensures regulatory compliance, warr"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_material_master_id" ;
    cmm:cimAssociation "Agreement.ErpItemMaster" .
cmm:CustomerEnrollment.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Foreign key linking to metering.meter. Business justification: NEM and DER program enrollments require specific meter configurations (bidirectional metering, interval data collection). Supports interconnection approval workflows, export credit calculations, and r"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_meter_id" ;
    cmm:cimAssociation "Agreement.Meter" .
cmm:CustomerEnrollment.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the physical service premise (metered location) associated with this enrollment. Required for NEM, DER, and demand response programs tied to a specific service point."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_premise_id" ;
    cmm:cimAssociation "Agreement.ServiceLocation" .
cmm:CustomerEnrollment.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer account holder enrolled in the program. Links to the master customer record in the CIS (SAP IS-U or Oracle CC&B)."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_profile_id" ;
    cmm:cimAssociation "Agreement.Customer" .
cmm:CustomerEnrollment.vppConfiguration a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vpp configuration"@en ;
    rdfs:comment "Foreign key linking to renewable.vpp_configuration. Business justification: Customer DER enrollments in VPP programs require tracking which VPP configuration the asset participates in for dispatch authorization, performance incentives, capacity payments, and ISO/RTO settlemen"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range cmm:VppConfiguration ;
    cmm:physicalColumn "vpp_configuration_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vpp Configuration Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_enrollment_vpp_configuration_id" ;
    cmm:cimAssociation "Agreement.EndDeviceGroup" .
cmm:CustomerEnrollment.additionalBaselineKwhPerDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "additional baseline kwh per day"@en ;
    rdfs:comment "The approved additional daily energy allowance in kilowatt-hours (kWh/day) granted to the customer under the medical baseline program, above the standard baseline allocation. Used in billing rate calculations."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "additional_baseline_kwh_per_day" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Additional Baseline Allowance (kWh/Day)" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerEnrollment.aggregatorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator name"@en ;
    rdfs:comment "The name of the third-party aggregator managing the customer's DER asset within a Virtual Power Plant (VPP) or demand response aggregation program. Required for FERC Order 2222 compliance and aggregator settlement."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "aggregator_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Aggregator Name" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.annualTrueUpMonth a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual true up month"@en ;
    rdfs:comment "The calendar month (1–12) in which the customer's annual NEM true-up billing cycle is settled. Determines when net export credits are reconciled against consumption charges for the 12-month period."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "annual_true_up_month" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual True-Up Month" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerEnrollment.approvedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved date"@en ;
    rdfs:comment "The date on which the enrollment application was formally approved by the utility or regulatory authority. Relevant for NEM interconnection approvals, medical baseline certifications, and low-income program eligibility approvals."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "approved_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.arrearageForgivenessAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrearage forgiveness amount"@en ;
    rdfs:comment "Total amount of past-due balance forgiven under an arrearage management program. [Moved from assistance_program: Arrearage forgiveness is applied at enrollment time and varies by account based on outstanding balance, making it enrollment-specific.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "arrearage_forgiveness_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arrearage Forgiveness Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerEnrollment.arrearageForgivenessDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrearage forgiveness date"@en ;
    rdfs:comment "Date when the arrearage forgiveness was applied to the customer account. [Moved from assistance_program: The date arrearage forgiveness was applied is specific to each enrollment instance.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "arrearage_forgiveness_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arrearage Forgiveness Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.arrearagePlanBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrearage plan balance"@en ;
    rdfs:comment "The outstanding balance (in USD) enrolled in the customer's Arrearage Management Plan (AMP). Tracks the deferred debt amount being managed under the structured repayment program. Null for non-AMP enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "arrearage_plan_balance" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arrearage Management Plan Balance ($)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerEnrollment.certificationExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certification expiration date"@en ;
    rdfs:comment "The date on which the medical baseline or life-support certification expires and must be renewed. Used to trigger renewal reminder notifications and manage disconnection protection eligibility."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "certification_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Certification Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.channel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel"@en ;
    rdfs:comment "The channel through which the customer enrolled in the program. Supports multi-channel engagement analytics and channel effectiveness reporting. Reference-value candidates: web|mobile_app|ivr|call_center|field_agent|mail|third_party|auto_enrolled."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "The communication protocol used for telemetry and dispatch signaling between the utility/DERMS and the customer's DER device. Determines interoperability requirements for demand response and VPP dispatch."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:validValues "IEEE_2030.5|OpenADR_2.0a|OpenADR_2.0b|Modbus|DNP3|other" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when the enrollment record was first created in the system. Audit trail field for data lineage, regulatory compliance, and SOX internal controls."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:CustomerEnrollment.cumulativeExportCredits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative export credits"@en ;
    rdfs:comment "The running balance of net energy export credits (in kWh) accumulated by the customer under the NEM program since the last annual true-up. Used for billing reconciliation and NEM settlement calculations."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_export_credits" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Export Credits (kWh)" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerEnrollment.demandResponseProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response program"@en ;
    rdfs:comment "Code identifying the Demand Response (DR) program in which this account is enrolled, such as interruptible load, direct load control, or automated demand response. Null if not enrolled. Drives DR dispatch eligibility and incentive payment calculations. Reference-value candidates: interruptible_load|direct_load_control|auto_dr|peak_time_rebate|emergency_dr|none. [Moved from account: This code identifies a single DR program but does not support enrollment in multiple DR programs simultaneously, nor does it capture enrollment dates, participation level, or tier. Should be replaced by enrollment records linking to DR program records.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "demand_response_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Program Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.derEnrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der enrollment status"@en ;
    rdfs:comment "Enrollment status of this account in a Distributed Energy Resource Management System (DERMS) or Virtual Power Plant (VPP) program. Enrolled accounts may have their DER assets dispatched by the utility or grid operator for demand response, frequency regulation, or capacity services. [Moved from account: This status field indicates DER program enrollment status but belongs to the specific account-program enrollment relationship, not to the account itself. An account may be enrolled in multiple DER programs with different statuses. Should be captured as enrollment.status for DER program enrollments.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Enrollment Status" ;
    cmm:validValues "not_enrolled|pending|enrolled|suspended|terminated" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.derTechnologyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der technology type"@en ;
    rdfs:comment "The technology type of the customer's Distributed Energy Resource (DER) asset enrolled in the program. Used for DERMS registration, VPP aggregation, and FERC Order 2222 compliance reporting. Reference-value candidates: pv_solar|wind|chp|battery_storage|ev_charger|smart_thermostat|generator|fuel_cell."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "der_technology_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Technology Type" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.disconnectionProtected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnection protected"@en ;
    rdfs:comment "Indicates whether the customer's account is protected from service disconnection due to medical baseline, life-support, or low-income program enrollment. True = disconnection protection active; False = no protection. Critical for collections and field operations."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disconnection_protected" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnection Protection Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerEnrollment.discountPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "discount percentage"@en ;
    rdfs:comment "Percentage discount applied to the customer bill under the assistance program (e.g., 20.00 for 20% discount). [Moved from assistance_program: While programs may have standard discount rates, the actual discount applied can vary by account based on rate class, usage tier, or household size, making it enrollment-specific.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "discount_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Discount Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CustomerEnrollment.dispatchAuthorizationLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch authorization level"@en ;
    rdfs:comment "The level of dispatch authority granted by the customer for their DER asset in demand response or VPP programs. 'full_auto' = utility can dispatch without customer action; 'semi_auto' = customer notified before dispatch; 'manual' = customer initiates; 'opt_in_only' = customer must opt in per event."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_authorization_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Authorization Level" ;
    cmm:validValues "full_auto|semi_auto|manual|opt_in_only" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date on which the enrollment ceases to be effective. Null for open-ended enrollments. Used for term-limited programs, certification expirations, and contract end dates."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CustomerEnrollment.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date on which the enrollment becomes operationally effective and the customer begins receiving program benefits, rates, or obligations. May differ from enrollment_date due to billing cycle alignment or approval processing."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:CustomerEnrollment.eligibilityVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verification date"@en ;
    rdfs:comment "Date when customer eligibility was verified for the assistance program. [Moved from assistance_program: Verification date varies by enrollment instance based on when the customer submitted documentation.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "eligibility_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.eligibilityVerificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility verification status"@en ;
    rdfs:comment "Current status of the customer eligibility verification process for the assistance program. [Moved from assistance_program: Verification status is specific to each account's enrollment application and documentation submission.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligibility_verification_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Verification Status" ;
    cmm:validValues "pending|verified|rejected|expired|under_review" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "The calendar date on which the customer submitted or was enrolled in the program. Represents the principal business event date (application/enrollment action date), distinct from the effective start date when benefits begin."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle state of the enrollment record. 'pending' = application submitted, awaiting approval; 'active' = currently participating; 'suspended' = temporarily paused (e.g., medical review); 'cancelled' = voluntarily withdrawn; 'expired' = past effective end date; 'rejected' = application denied."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:validValues "pending|active|suspended|cancelled|expired|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:CustomerEnrollment.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date when the enrollment expires and requires re-certification or renewal. [Moved from assistance_program: Enrollment expiration is specific to each account-program enrollment, not to the program definition.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:CustomerEnrollment.exportCompensationRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "export compensation rate"@en ;
    rdfs:comment "The per-kilowatt-hour ($/kWh) rate at which the utility compensates the customer for net energy exported to the grid under the NEM tariff. Rate is locked at enrollment for grandfathered NEM versions. Null for non-NEM enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "export_compensation_rate" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Export Compensation Rate ($/kWh)" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_financial" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerEnrollment.greenEnergyPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "green energy percentage"@en ;
    rdfs:comment "The percentage of the customer's energy supply sourced from renewable energy under a green energy program enrollment (0–100%). Used for Renewable Energy Certificate (REC) allocation and Renewable Portfolio Standard (RPS) compliance reporting."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "green_energy_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Green Energy Subscription Percentage (%)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CustomerEnrollment.householdSize a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "household size"@en ;
    rdfs:comment "Number of individuals in the customer household used for eligibility determination. [Moved from assistance_program: Household size is captured at enrollment time for eligibility determination and may change between recertifications, making it enrollment-specific.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "household_size" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Household Size" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerEnrollment.incomeVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "income verification date"@en ;
    rdfs:comment "The date on which the customer's income eligibility was last verified for low-income assistance programs (CARE, FERA, LIHEAP). Used for periodic re-certification compliance and audit trails."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "income_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Income Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.installedCapacityKwDc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installed capacity kw dc"@en ;
    rdfs:comment "The nameplate DC capacity in kilowatts (kW-DC) of the customer's installed distributed generation or storage system. Used for NEM eligibility sizing, export limit calculations, and DERMS registration. Applicable to NEM and DER/VPP enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "installed_capacity_kw_dc" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installed Capacity (kW-DC)" ;
    cmm:cimDatatype "Decimal" .
cmm:CustomerEnrollment.interconnectionApplicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application date"@en ;
    rdfs:comment "The date on which the customer submitted the interconnection application for a distributed generation system (e.g., rooftop solar, battery storage). Applicable to NEM and DER enrollments. Required for FERC Order 2222 and state PUC interconnection tracking."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "interconnection_application_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Application Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.inverterType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inverter type"@en ;
    rdfs:comment "The type of inverter installed with the customer's solar PV or battery storage system. Relevant for NEM technical review, grid interconnection safety assessment, and DERMS telemetry compatibility."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "inverter_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inverter Type" ;
    cmm:validValues "string|microinverter|power_optimizer|hybrid|battery_inverter" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.lastRecertificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last recertification date"@en ;
    rdfs:comment "Date of the most recent eligibility recertification completed by the customer. [Moved from assistance_program: Recertification history is specific to each account's enrollment, not to the program.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_recertification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Recertification Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The timestamp when the enrollment record was most recently modified. Used for change data capture (CDC), audit trails, and downstream incremental processing in the Databricks Silver layer."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CustomerEnrollment.lifeSupportEquipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "life support equipment type"@en ;
    rdfs:comment "The type of electrically powered life-support medical equipment used by the customer or household member. Determines disconnection protection rules and priority restoration status during outages. Null for non-life-support enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "life_support_equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Life-Support Equipment Type" ;
    cmm:validValues "oxygen_concentrator|dialysis|ventilator|infusion_pump|other" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.lowIncomeProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "low income program"@en ;
    rdfs:comment "Code identifying the low-income assistance program in which this account is enrolled, such as CARE (California Alternate Rates for Energy), FERA (Family Electric Rate Assistance), LIHEAP, or utility-specific low-income discount programs. Drives rate discounts and disconnection protections. Reference-value candidates: care|fera|liheap|utility_discount|none. [Moved from account: This code identifies a single low-income program (CARE/FERA) but does not support enrollment in multiple assistance programs, nor does it capture enrollment date, eligibility verification date, tier assignment, or recertification schedule. Should be replaced by enrollment records.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "low_income_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Low Income Assistance Program Code" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.medCertificationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "med certification type"@en ;
    rdfs:comment "The type of medical program certification for the customer. 'life_support' = customer or household member depends on electrically powered life-support equipment; 'medical_baseline_allowance' = customer qualifies for additional baseline energy allowance due to medical condition. Null for non-medical enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "med_certification_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Certification Type" ;
    cmm:validValues "life_support|medical_baseline_allowance" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.medicalBaseline a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical baseline"@en ;
    rdfs:comment "Indicates whether this account has been approved for a Medical Baseline Allowance, providing additional low-cost energy allocation to customers with qualifying medical conditions that require life-support equipment or climate control. Governs disconnection protections and rate adjustments per PUC rules. [Moved from account: This boolean flag indicates medical baseline approval but does not capture approval date, expiration date, recertification schedule, or participation level. Should be replaced by enrollment records linking to the Medical Baseline Program with full lifecycle attributes.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "medical_baseline" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Baseline Allowance Flag" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerEnrollment.monthlyCreditAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monthly credit amount"@en ;
    rdfs:comment "Fixed monthly credit amount applied to the customer bill under the assistance program. [Moved from assistance_program: The monthly credit amount may vary by enrollment based on account characteristics, usage patterns, or tiered benefit structures.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "monthly_credit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monthly Credit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerEnrollment.nemParticipant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem participant"@en ;
    rdfs:comment "Indicates whether this account is enrolled in a Net Energy Metering (NEM) program, meaning the customer has behind-the-meter generation (typically solar PV) and receives bill credits for excess energy exported to the grid. Drives bidirectional metering requirements and NEM tariff application. [Moved from account: This boolean flag indicates NEM program participation but does not capture which NEM program, enrollment dates, or participation level. The flag should be replaced by enrollment records in the enrollment association that link to specific NEM program records with full lifecycle tracking.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_participant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Participant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerEnrollment.nemVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem version"@en ;
    rdfs:comment "The version of the Net Energy Metering tariff under which the customer is enrolled. Determines export compensation rate structure and true-up methodology. Null for non-NEM enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "nem_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Version" ;
    cmm:validValues "NEM-1.0|NEM-2.0|NEM-3.0|NEM-ST" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.optOutDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out date"@en ;
    rdfs:comment "The date on which the customer voluntarily opted out of the program. Null if the customer has not opted out. Distinct from effective_end_date which may be system-driven."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "opt_out_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.optOutReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out reason"@en ;
    rdfs:comment "Reason code for the customer's voluntary withdrawal from the program. Used for churn analysis, program improvement, and regulatory reporting. Reference-value candidates: customer_request|moved|rate_change|financial_hardship|program_change|ineligible|other."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "opt_out_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Reason" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.permissionToOperateDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "permission to operate date"@en ;
    rdfs:comment "The date on which the utility granted Permission to Operate (PTO) for the customer's distributed energy resource (DER) system. Marks the official start of NEM or DER export eligibility."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "permission_to_operate_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.physicianCertificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "physician certification date"@en ;
    rdfs:comment "The date on which a licensed physician certified the customer's medical condition for the medical baseline allowance or life-support program. Required for PUC medical tariff compliance."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "physician_certification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Physician Certification Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.qualifyingCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualifying condition"@en ;
    rdfs:comment "The medical condition or diagnosis that qualifies the customer for the medical baseline allowance or life-support program. Protected Health Information (PHI) — classified as restricted. Null for non-medical enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "qualifying_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Qualifying Medical Condition" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_health" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.recertificationDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "recertification due date"@en ;
    rdfs:comment "Date by which the customer must complete eligibility recertification to maintain program enrollment. [Moved from assistance_program: Recertification cycles are specific to each enrollment instance based on initial enrollment date and program rules.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "recertification_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Recertification Due Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.renewalReminderDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal reminder date"@en ;
    rdfs:comment "The date on which the utility should send a renewal reminder notification to the customer for medical baseline or life-support certification renewal. Typically set a defined number of days before certification_expiration_date."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "renewal_reminder_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Reminder Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerEnrollment.telemetryAvailable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "telemetry available"@en ;
    rdfs:comment "Indicates whether real-time telemetry data is available from the customer's DER device for DERMS monitoring and dispatch. True = telemetry enabled; False = no real-time telemetry (manual or estimated dispatch)."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "telemetry_available" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Telemetry Availability Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerEnrollment.totalBenefitReceivedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total benefit received amount"@en ;
    rdfs:comment "Cumulative total benefit amount the customer has received to date under the current enrollment. [Moved from assistance_program: This is a cumulative metric specific to each account's enrollment, tracking total benefits received to date for this enrollment instance.]"@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_benefit_received_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Benefit Received Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerEnrollment.touRatePlanCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou rate plan code"@en ;
    rdfs:comment "The specific Time-of-Use (TOU) or Critical Peak Pricing (CPP) rate plan code assigned to the customer under this enrollment. Maps to the tariff schedule in the billing system. Null for non-rate-plan enrollments."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_rate_plan_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Rate Plan Code" ;
    cmm:cimDatatype "String" .
cmm:CustomerEnrollment.vppProgramCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vpp program code"@en ;
    rdfs:comment "The utility-assigned code for the Virtual Power Plant (VPP) aggregation program in which the customer's DER is enrolled. Used for dispatch scheduling, settlement, and FERC Order 2222 reporting."@en ;
    rdfs:domain cmm:CustomerEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "vpp_program_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Virtual Power Plant (VPP) Program Code" ;
    cmm:cimDatatype "String" .

cmm:MoveOrder a owl:Class ;
    rdfs:label "Move Order"@en ;
    rdfs:comment "Transactional entity capturing move-in, move-out, and transfer-of-service orders that initiate or terminate service at a premise. Stores order type (move-in, move-out, transfer), requested date, actual effective date, prior account reference, new account reference, premise reference, meter read date at move, final read value, deposit disposition, and order status. Sourced from SAP IS-U Move-In/Move-Out and Oracle CC&B Start/Stop Service. Triggers meter read scheduling and final bill generation in downstream domains."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Work ;
    cmm:cimCloseMatch cim:Work ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.service_delivery ;
    cmm:physicalTable "utility_cmm_silver.customer.move_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-8; SAP IS-U Move-In/Move-Out / Oracle CC&B Start-Stop Service" ;
    cmm:sourceObject "energy_utilities_ecm.customer.move_order" ;
    owl:hasKey ( cmm:MoveOrder.moveOrderId ) .

cmm:MoveOrder.moveOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "move order id"@en ;
    rdfs:comment "Unique surrogate identifier for the move order record in the Silver layer lakehouse. Primary key for this entity."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "move_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Move Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:MoveOrder.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Foreign key linking to customer.customer_service_agreement. Business justification: Move order (move-in, move-out, transfer) should reference the service agreement being initiated or terminated. Currently move_order has account_id and premise_id but no service_agreement_id. This FK e"@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_customer_service_agreement_id" ;
    cmm:cimAssociation "Work.CustomerAgreement" .
cmm:MoveOrder.fieldOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "field order"@en ;
    rdfs:comment "Reference to the field work order created in the asset/workforce management system (Ventyx Asset Suite) to execute the physical service connection, disconnection, or meter read associated with this move order. Links the CIS move order to the field operations domain."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:FieldOrder ;
    cmm:physicalColumn "field_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Field Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_field_order_id" ;
    cmm:cimAssociation "Work.WorkTask" .
cmm:MoveOrder.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the meter device installed at the service point at the time of the move order. Used to schedule move-in/move-out meter reads and link final read values to the correct device record in the Metering domain."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_meter_id" ;
    cmm:cimAssociation "Work.Meter" .
cmm:MoveOrder.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Reference to the specific service point (metering point / point of delivery) at the premise where service is being initiated or terminated. A premise may have multiple service points (e.g., electric and gas)."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_meter_point_id" ;
    cmm:cimAssociation "Work.UsagePoint" .
cmm:MoveOrder.moveAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "move account"@en ;
    rdfs:comment "FK to customer.account.account_id — Move orders initiate/terminate service for an account. move_order.account_id → account.account_id."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "move_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_move_account_id" ;
    cmm:cimAssociation "Work.CustomerAccount" .
cmm:MoveOrder.movePremise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "move premise"@en ;
    rdfs:comment "Reference to the service premise (physical location) at which the move order is being executed. Central linkage to the premise master record for address, meter, and distribution asset context."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "move_premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:sourceColumn "premise_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_move_premise_id" ;
    cmm:cimAssociation "Work.ServiceLocation" .
cmm:MoveOrder.primaryMovePriorAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary move prior account"@en ;
    rdfs:comment "Reference to the existing service account being closed or vacated as part of this move order. Populated for move-out and transfer order types. Used to trigger final bill generation and deposit disposition in the billing domain."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "primary_move_prior_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Prior Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_primary_move_prior_account_id" ;
    cmm:cimAssociation "Work.CustomerAccount" .
cmm:MoveOrder.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer party initiating the move order. Links to the customer master record in the Customer domain. For a transfer, this is the incoming customer (move-in party)."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_profile_id" ;
    cmm:cimAssociation "Work.Customer" .
cmm:MoveOrder.tertiaryMovePriorOccupantAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tertiary move prior occupant account"@en ;
    rdfs:comment "Reference to the account of the previous occupant at the premise, if known at the time of the move-in order. Used to coordinate final bill issuance for the departing customer and to identify any outstanding balance or deposit transfer obligations."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "tertiary_move_prior_occupant_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Prior Occupant Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_tertiary_move_prior_occupant_account_id" ;
    cmm:cimAssociation "Work.CustomerAccount" .
cmm:MoveOrder.toPremise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to premise"@en ;
    rdfs:comment "FK to customer.premise.premise_id — Move orders reference the premise where service starts/stops. move_order.premise_id → premise.premise_id."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "to_premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_move_order_to_premise_id" ;
    cmm:cimAssociation "Work.ServiceLocation" .
cmm:MoveOrder.budgetBillingEnrolled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget billing enrolled"@en ;
    rdfs:comment "Indicates whether the customer is enrolled in a budget billing (levelized payment) plan at the time of the move order. When true, the final bill calculation must account for any budget billing true-up balance upon move-out."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "budget_billing_enrolled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Budget Billing Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Free-text or coded reason explaining why the move order was cancelled or rejected. Populated only when order_status is 'cancelled' or 'rejected'. Used for operational quality analysis and customer service improvement."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.channel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel"@en ;
    rdfs:comment "The customer engagement channel through which the move order was submitted. Supports multi-channel analytics and CRM reporting. Reference-value candidates: web_portal|mobile_app|call_center|walk_in|field_crew|ivr|third_party."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Order Submission Channel" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.completionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "completion timestamp"@en ;
    rdfs:comment "The date and time when the move order was fully completed and all downstream actions (meter read, billing, account activation/deactivation) were confirmed. Distinct from effective_date (the business date of service change) and submitted_timestamp (when the order was placed)."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Order Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MoveOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Audit timestamp recording when this move order record was first created in the Silver layer data store. Distinct from submitted_timestamp which reflects the business event time."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Work.createdDateTime .
cmm:MoveOrder.creditCheckRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit check required"@en ;
    rdfs:comment "Indicates whether a credit check was required for this move-in or transfer order based on the customer's credit classification or account history. When true, the move order may be held pending credit review and deposit determination per SAP IS-U FICA or Oracle CC&B Collections rules."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "credit_check_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Check Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.creditCheckStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit check status"@en ;
    rdfs:comment "The outcome of the credit check performed for this move order. Not_required: credit check was not triggered. Passed: customer met credit criteria. Failed: customer did not meet criteria (deposit required). Pending: check in progress. Waived: credit check bypassed per business rules (e.g., existing customer in good standing)."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_check_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Check Status" ;
    cmm:validValues "not_required|passed|failed|pending|waived" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code applicable to all monetary amounts on this move order (deposit_amount, final_bill_amount). Typically USD for North American utilities. Supports multi-currency operations for utilities with international operations."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:MoveOrder.demandResponseEnrolled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response enrolled"@en ;
    rdfs:comment "Indicates whether the customer or premise is enrolled in a Demand Response (DR) program at the time of the move order. When true, the DR program administrator must be notified to update enrollment records and avoid erroneous dispatch signals."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_enrolled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.depositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit amount"@en ;
    rdfs:comment "The monetary value of the security deposit associated with the prior or new account at the time of the move order. Used to determine deposit disposition (refund, transfer, or application to final bill balance) upon move-out or transfer."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Security Deposit Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MoveOrder.depositDisposition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit disposition"@en ;
    rdfs:comment "The outcome or planned treatment of the security deposit upon move-out or transfer. Refund: returned to customer. Applied_to_balance: offset against outstanding final bill. Transferred: moved to new account. Forfeited: retained by utility per tariff terms. Pending: disposition not yet determined."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "deposit_disposition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Disposition" ;
    cmm:validValues "refund|applied_to_balance|transferred|forfeited|pending" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.derEnrolled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der enrolled"@en ;
    rdfs:comment "Indicates whether the premise associated with this move order has an active Distributed Energy Resource (DER) enrollment (e.g., battery storage, EV charger, demand response program). When true, triggers DERMS notification and DER agreement review upon move-out or transfer."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_enrolled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Enrollment Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "The actual date on which the service change (move-in, move-out, or transfer) became effective at the premise. Used as the billing boundary date for final bill generation and new account activation. May differ from requested_date due to scheduling constraints or field execution timing."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Service Change Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:MoveOrder.finalBillAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final bill amount"@en ;
    rdfs:comment "The total monetary amount of the final bill generated as a result of the move-out or transfer order. Represents the net amount owed by or to the customer after applying the final meter read, applicable tariff rates, taxes, and deposit disposition."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "final_bill_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Bill Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MoveOrder.finalReadValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final read value"@en ;
    rdfs:comment "The meter register reading (in kWh or applicable unit) captured at the time of the move order. For move-out, this is the closing read used to calculate the final bill. For move-in, this is the opening read establishing the new billing baseline."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "final_read_value" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Meter Read Value" ;
    cmm:cimDatatype "Decimal" .
cmm:MoveOrder.landlordNotificationRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "landlord notification required"@en ;
    rdfs:comment "Indicates whether the property owner or landlord must be notified of the service change per tariff rules or regulatory requirements. Relevant for rental properties where the landlord has a standing notification agreement with the utility."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "landlord_notification_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Landlord Notification Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.landlordNotifiedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "landlord notified date"@en ;
    rdfs:comment "The date on which the landlord or property owner was notified of the service change associated with this move order. Populated only when landlord_notification_required is true. Used for regulatory compliance documentation."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "landlord_notified_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Landlord Notified Date" ;
    cmm:cimDatatype "Date" .
cmm:MoveOrder.medicalBaseline a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medical baseline"@en ;
    rdfs:comment "Indicates whether the customer has an approved medical baseline allowance (life support or medical necessity designation) that requires special handling during service disconnection or move-out. When true, additional notification and regulatory compliance steps are required before service termination."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "medical_baseline" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Medical Baseline Allowance Flag" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.meterReadDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read date"@en ;
    rdfs:comment "The date on which the meter was physically or remotely read in connection with this move order. Used as the billing cut-off date for the final bill (move-out) or the start-of-service read date (move-in). Sourced from Oracle Utilities MDM or SAP IS-U Device Management."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "meter_read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Move Meter Read Date" ;
    cmm:cimDatatype "Date" .
cmm:MoveOrder.nemParticipant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem participant"@en ;
    rdfs:comment "Indicates whether the customer associated with this move order is enrolled in a Net Energy Metering (NEM) program, typically due to rooftop solar or other behind-the-meter (BTM) generation. When true, triggers specialized NEM billing and interconnection review processes upon move-in or move-out."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_participant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Participant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MoveOrder.orderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order number"@en ;
    rdfs:comment "Externally-known business identifier for the move order, assigned by the source system (SAP IS-U or Oracle CC&B). Used for customer-facing correspondence and cross-system reconciliation."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Move Order Number" ;
    cmm:valuePattern "^MO-[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MoveOrder.orderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:comment "Current lifecycle state of the move order workflow. Pending: submitted but not yet processed. In_progress: actively being executed (meter read scheduled, field crew dispatched). Completed: service change fully effected. Cancelled: withdrawn before execution. Rejected: failed validation or business rules."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Move Order Status" ;
    cmm:validValues "pending|in_progress|completed|cancelled|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Work.status .
cmm:MoveOrder.orderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "order type"@en ;
    rdfs:comment "Classifies the nature of the service order: move_in (new service activation at a premise), move_out (service termination at a premise), transfer (simultaneous move-out and move-in for a change of occupant), reconnect (restoration of previously disconnected service), or disconnect (non-payment or voluntary disconnection). Reference-value candidates: move_in|move_out|transfer|reconnect|disconnect."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Move Order Type" ;
    cmm:validValues "move_in|move_out|transfer|reconnect|disconnect" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Work.type .
cmm:MoveOrder.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "The tariff rate schedule code assigned to the new service account upon move-in or transfer. Determines the billing rate class (e.g., residential, small commercial, large industrial, TOU, CPP). Sourced from the applicable PUC-approved tariff."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.readType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read type"@en ;
    rdfs:comment "Indicates how the move-order meter read was obtained: actual (field technician physical read), estimated (calculated based on usage history when actual read is unavailable), AMI_remote (automated read via Advanced Metering Infrastructure), or customer_self_read (customer-reported reading)."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Type" ;
    cmm:validValues "actual|estimated|AMI_remote|customer_self_read" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.readUnitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read unit of measure"@en ;
    rdfs:comment "The unit of measure for the final_read_value. Typically kWh for electric meters, but may be therms, CCF, or MCF for gas service points. Ensures correct interpretation of the meter read value across commodity types."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Unit of Measure" ;
    cmm:validValues "kWh|MWh|kW|therm|CCF|MCF" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:MoveOrder.remarks a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remarks"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or exceptions associated with this move order. May include field crew instructions, customer-specific handling notes, or escalation details entered by customer service representatives."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "remarks" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Move Order Remarks" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:MoveOrder.requestedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested date"@en ;
    rdfs:comment "The date the customer requested the service change to take effect. This is the customer-stated desired effective date, which may differ from the actual effective date after scheduling and field execution."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "requested_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Service Change Date" ;
    cmm:cimDatatype "Date" .
cmm:MoveOrder.scheduledReadDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled read date"@en ;
    rdfs:comment "The date on which the meter read associated with this move order is scheduled to be performed. May differ from meter_read_date (actual read date) if the read is rescheduled or delayed. Used for field crew scheduling and MDM read request management."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Meter Read Date" ;
    cmm:cimDatatype "Date" .
cmm:MoveOrder.serviceClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service class"@en ;
    rdfs:comment "Customer service classification at the time of the move order, determining applicable tariff, billing rules, and regulatory reporting category. Residential, small commercial, large commercial, industrial, agricultural, or lighting."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Class" ;
    cmm:validValues "residential|small_commercial|large_commercial|industrial|agricultural|lighting" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Code identifying the utility's regulated service territory within which the premise is located. Used for regulatory reporting to State PUCs, FERC Form 1 filings, and NERC reliability reporting. Determines applicable tariff jurisdiction."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Identifies the operational system of record from which this move order record was sourced. SAP_IS-U: SAP Industry Solution for Utilities. Oracle_CCB: Oracle Utilities Customer Care and Billing. Manual: entered directly into the data platform. Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "SAP_IS-U|Oracle_CCB|manual" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.sourceSystemOrderReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system order reference"@en ;
    rdfs:comment "The native primary key or order identifier from the originating operational system (SAP IS-U or Oracle CC&B). Enables traceability back to the source system record for audit, reconciliation, and issue resolution."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_order_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Order ID" ;
    cmm:cimDatatype "String" .
cmm:MoveOrder.submittedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "submitted timestamp"@en ;
    rdfs:comment "The date and time when the move order was first submitted into the CIS system (SAP IS-U or Oracle CC&B). Represents the principal business event timestamp for order creation. Used for SLA tracking and order aging analysis."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "submitted_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Order Submitted Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MoveOrder.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Audit timestamp recording when this move order record was most recently modified in the Silver layer data store. Used for change data capture and incremental processing."@en ;
    rdfs:domain cmm:MoveOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:ThirdPartyAuthorization a owl:Class ;
    rdfs:label "Third Party Authorization"@en ;
    rdfs:comment "Master entity and SSOT for all customer-granted authorizations, explicit consent events, and data-sharing permissions. Captures third-party access authorizations including authorized party name, authorization type (view-only, full access, notification-only, landlord, property manager, aggregator, DERMS provider), and authorization scope. Captures all consent events including consent for data sharing, marketing communications, Green Button data access, electronic signature agreements, and third-party aggregator authorization. Stores consent type and version, consent channel (web portal, mobile app, IVR, paper, written, electronic, verbal with recording reference), consent date and time, consent text version reference, IP address or session token, authorization start and end dates, revocation/withdrawal date and reason. Required for FERC Order 2222 DER aggregator access, Green Button data sharing compliance, GDPR, CCPA, and state PUC data privacy requirements."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.account_management ;
    cmm:physicalTable "utility_cmm_silver.customer.third_party_authorization" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NAESB REQ.21 ESPI (Green Button); Oracle CC&B Third Party Access / Green Button Connect My Data" ;
    cmm:sourceObject "energy_utilities_ecm.customer.third_party_authorization" ;
    owl:hasKey ( cmm:ThirdPartyAuthorization.thirdPartyAuthorizationId ) .

cmm:ThirdPartyAuthorization.thirdPartyAuthorizationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "third party authorization id"@en ;
    rdfs:comment "Unique surrogate identifier for each third-party authorization or consent record. Primary key for the third_party_authorization data product within the customer domain SSOT."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:long ;
    cmm:physicalColumn "third_party_authorization_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Third-Party Authorization ID" ;
    cmm:cimDatatype "Integer" .
cmm:ThirdPartyAuthorization.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "FK to customer.account.account_id — Third-party authorizations are granted per account. third_party_authorization.account_id → account.account_id."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:ThirdPartyAuthorization.customerEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer enrollment"@en ;
    rdfs:comment "Reference to the DER program enrollment record associated with this authorization. Populated when the authorization grants a DERMS provider or aggregator access to dispatch or monitor a customer's distributed energy resource (solar, battery, EV charger, etc.)."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:CustomerEnrollment ;
    cmm:physicalColumn "customer_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Enrollment ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_customer_enrollment_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:ThirdPartyAuthorization.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Identifier of the demand response program for which this authorization grants aggregator or DERMS provider access. Links the authorization to a specific DR or Virtual Power Plant (VPP) program managed by the utility or ISO/RTO."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Program ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_dr_program_id" ;
    cmm:cimAssociation "Agreement.DemandResponseProgram" .
cmm:ThirdPartyAuthorization.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Employee or agent identifier of the utility customer service representative who processed or witnessed this authorization on behalf of the customer (e.g., for paper, verbal, or IVR-assisted consents). Null for fully self-service digital consents."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Authorized By Agent ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_employee_id" ;
    cmm:cimAssociation "Agreement.ErpPersonnel" .
cmm:ThirdPartyAuthorization.fercAggregator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ferc aggregator"@en ;
    rdfs:comment "FERC-registered identifier for the demand response or DER aggregator authorized under FERC Order 2222. Required when authorization_type is 'aggregator' or 'derms_provider'. Enables regulatory traceability of aggregator participation in wholesale markets."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:DrAggregator ;
    cmm:physicalColumn "ferc_aggregator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Aggregator ID" ;
    cmm:sourceColumn "aggregator_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_ferc_aggregator_id" ;
    cmm:cimAssociation "Agreement.MarketParticipant" .
cmm:ThirdPartyAuthorization.notificationPreference a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "notification preference"@en ;
    rdfs:comment "Foreign key linking to customer.notification_preference. Business justification: Third-party authorizations reference a notification preference code; replace with FK to notification_preference to normalize and give inbound link to notification_preference."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:NotificationPreference ;
    cmm:physicalColumn "notification_preference_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Notification Preference Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_notification_preference_id" ;
    cmm:cimAssociation "Agreement.CustomerNotification" .
cmm:ThirdPartyAuthorization.ppaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa contract"@en ;
    rdfs:comment "Foreign key linking to renewable.ppa_contract. Business justification: Third-party PPA agreements require explicit customer authorization for data sharing, billing coordination, and account access. Critical for community solar subscriptions and third-party ownership mode"@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ppa Contract Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_ppa_contract_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:ThirdPartyAuthorization.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise (physical location) covered by this authorization. Relevant for landlord, property manager, and aggregator authorizations scoped to a specific service address."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_premise_id" ;
    cmm:cimAssociation "Agreement.ServiceLocation" .
cmm:ThirdPartyAuthorization.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer account holder who granted this authorization or consent. Links to the master customer record in the CIS (SAP IS-U / Oracle CC&B)."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_profile_id" ;
    cmm:cimAssociation "Agreement.Customer" .
cmm:ThirdPartyAuthorization.thirdAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "third account"@en ;
    rdfs:comment "Reference to the specific utility service account to which this authorization applies. A customer may have multiple accounts (residential, commercial, NEM, DER-enrolled) and authorizations are scoped at the account level."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "third_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_third_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:ThirdPartyAuthorization.toAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to account"@en ;
    rdfs:comment "FK to customer.account.account_id — Authorizations and consent records are granted by a customer account. Required for FERC Order 2222 aggregator access, Green Button compliance, and CCPA/GDPR data sharing."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "to_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_third_party_authorization_to_account_id" ;
    cmm:cimAssociation "Agreement.CustomerAccount" .
cmm:ThirdPartyAuthorization.authorizationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization number"@en ;
    rdfs:comment "Externally-known business identifier for this authorization record, used in customer correspondence, audit trails, and regulatory submissions. Formatted as AUTH- followed by a 10-digit sequence."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Authorization Number" ;
    cmm:valuePattern "^AUTH-[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ThirdPartyAuthorization.authorizationScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization scope"@en ;
    rdfs:comment "Textual description of the specific data, services, or actions covered by this authorization. Examples include: interval usage data, billing history, account balance, demand response enrollment, Green Button data, DER dispatch commands. Captures the granular scope agreed to by the customer."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Scope" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.authorizationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization status"@en ;
    rdfs:comment "Current lifecycle state of the authorization record. Active indicates the authorization is in force; pending indicates awaiting customer confirmation; suspended indicates temporarily paused; revoked indicates customer-initiated withdrawal; expired indicates the authorization end date has passed."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Authorization Status" ;
    cmm:validValues "active|pending|suspended|revoked|expired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.status .
cmm:ThirdPartyAuthorization.authorizationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorization type"@en ;
    rdfs:comment "Categorical classification of the access level or relationship type granted to the third party. Determines what actions the authorized party may perform: view_only (read-only data access), full_access (read and transact), notification_only (receive alerts), landlord (property owner access), property_manager (delegated property management), aggregator (demand response or VPP aggregator per FERC Order 2222), derms_provider (Distributed Energy Resource Management System provider access). Reference-value candidates: view_only|full_access|notification_only|landlord|property_manager|aggregator|derms_provider."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorization_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Authorization Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Agreement.type .
cmm:ThirdPartyAuthorization.authorizedPartyIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized party identifier"@en ;
    rdfs:comment "External registration or license number identifying the authorized third party, such as a FERC-registered aggregator ID, state PUC license number, or business registration number. Used for regulatory verification and audit."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_party_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Party Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.authorizedPartyName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized party name"@en ;
    rdfs:comment "Legal name of the third party (individual, company, or organization) to whom access or authority has been granted. May be a landlord, property management company, demand response aggregator, DERMS provider, or other authorized entity."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_party_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Party Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.authorizedPartyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "authorized party type"@en ;
    rdfs:comment "Classification of the authorized third party entity type. Distinguishes between individual persons (e.g., family member, tenant), commercial companies (e.g., property management firm), aggregators (demand response or VPP aggregators per FERC Order 2222), government agencies, and non-profit organizations."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "authorized_party_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorized Party Type" ;
    cmm:validValues "individual|company|aggregator|government|non_profit|other" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.ccpaApplicable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ccpa applicable"@en ;
    rdfs:comment "Indicates whether this authorization record is subject to CCPA consumer rights obligations (right to know, right to delete, right to opt-out of sale). Relevant for California utility customers and California-regulated service territories."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ccpa_applicable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "California Consumer Privacy Act (CCPA) Applicable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.consentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent channel"@en ;
    rdfs:comment "The channel or medium through which the customer provided consent or authorization. Captures: web_portal (online self-service), mobile_app (utility mobile application), ivr (Interactive Voice Response system), paper (physical form), written (written correspondence), electronic (email or e-sign), verbal (recorded phone call). Required for regulatory proof of consent method. Reference-value candidates: web_portal|mobile_app|ivr|paper|written|electronic|verbal."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "consent_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Channel" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.consentTextReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent text reference"@en ;
    rdfs:comment "Document reference or URL pointing to the exact consent language text presented to the customer. Used for legal and regulatory audit to confirm the precise wording agreed to at the time of consent."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "consent_text_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Text Reference" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.consentTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent timestamp"@en ;
    rdfs:comment "The exact date and time (with timezone) at which the customer provided consent or authorization. This is the principal real-world event time for the consent act, distinct from the record creation audit timestamp. Critical for GDPR, CCPA, and state PUC compliance audit trails."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "consent_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ThirdPartyAuthorization.consentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent type"@en ;
    rdfs:comment "Classification of the consent event captured in this record. Covers: data_sharing (general data access consent), marketing (communications consent), green_button (Green Button Connect My Data consent), electronic_signature (e-sign agreement), aggregator (third-party aggregator authorization), der_enrollment (DER program enrollment consent), nem_participation (Net Energy Metering participation consent). Reference-value candidates: data_sharing|marketing|green_button|electronic_signature|aggregator|der_enrollment|nem_participation|demand_response."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "consent_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Type" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.consentVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consent version"@en ;
    rdfs:comment "Version identifier of the consent text or terms presented to the customer at the time of consent capture. Enables tracking of which version of the consent language was agreed to, supporting regulatory audit and re-consent workflows when terms change."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "consent_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Consent Version" ;
    cmm:valuePattern "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time at which this authorization record was first created in the system. Audit timestamp for data lineage and regulatory record-keeping. Distinct from consent_timestamp, which captures the real-world consent event time."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:ThirdPartyAuthorization.dataAccessEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data access end date"@en ;
    rdfs:comment "The latest date through which data may be accessed by the authorized third party. Defines the forward boundary of the data sharing window. Distinct from effective_end_date, which governs the authorization itself; this field governs the data time range."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "data_access_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Access End Date" ;
    cmm:cimDatatype "Date" .
cmm:ThirdPartyAuthorization.dataAccessStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data access start date"@en ;
    rdfs:comment "The earliest date from which historical usage or account data may be accessed by the authorized third party under this authorization. Defines the lookback window for Green Button data sharing, aggregator access, and DERMS data feeds."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "data_access_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Access Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ThirdPartyAuthorization.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date on which this authorization or consent expires and the authorized party's access terminates. Nullable for open-ended authorizations. When populated, the system must enforce access revocation on or after this date."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Authorization Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:ThirdPartyAuthorization.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date on which this authorization or consent becomes effective and the authorized party may begin exercising the granted access or permissions. May differ from consent_timestamp if a future start date was agreed."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Authorization Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:ThirdPartyAuthorization.electronicSignatureReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "electronic signature reference"@en ;
    rdfs:comment "Reference identifier for the electronic signature record associated with this authorization, stored in the e-signature platform. Provides legal proof of customer agreement for electronically executed authorizations. Populated when consent_channel is 'electronic' or 'electronic_signature'."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "electronic_signature_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Electronic Signature Reference" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.gdprApplicable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gdpr applicable"@en ;
    rdfs:comment "Indicates whether this authorization record is subject to GDPR data subject rights obligations (right to access, right to erasure, right to portability). Relevant for utility customers in GDPR-applicable jurisdictions."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "gdpr_applicable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Data Protection Regulation (GDPR) Applicable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.greenButtonEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "green button enabled"@en ;
    rdfs:comment "Indicates whether this authorization enables Green Button Connect My Data (CMD) access for the authorized third party. When true, the authorized party may retrieve interval energy usage data via the Green Button API. Supports DOE Green Button initiative compliance."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "green_button_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Green Button Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.ipAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ip address"@en ;
    rdfs:comment "IP address of the device from which the customer submitted the consent or authorization via a digital channel (web portal or mobile app). Used for fraud detection, audit trail, and regulatory proof of digital consent. Null for non-digital channels (paper, IVR, verbal)."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "ip_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IP Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_ip" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.lastReviewedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last reviewed date"@en ;
    rdfs:comment "The most recent date on which the customer confirmed, reviewed, or re-consented to this authorization. Used to track the currency of consent and trigger re-consent workflows when the review interval has elapsed."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_reviewed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Reviewed Date" ;
    cmm:cimDatatype "Date" .
cmm:ThirdPartyAuthorization.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "The date and time at which this authorization record was most recently modified in the system. Supports change data capture, audit trails, and incremental lakehouse processing."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ThirdPartyAuthorization.marketingConsent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "marketing consent"@en ;
    rdfs:comment "Indicates whether the customer has provided explicit consent to receive marketing communications from the utility or its authorized partners. Distinct from data sharing consent. Required for GDPR Article 6 and CCPA opt-in/opt-out compliance."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "marketing_consent" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Marketing Communications Consent Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.nemParticipant a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem participant"@en ;
    rdfs:comment "Indicates whether this authorization is associated with a Net Energy Metering (NEM) enrolled customer account. When true, the authorization may cover behind-the-meter (BTM) generation data sharing with aggregators or DERMS providers."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_participant" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Participant Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.paperFormReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "paper form reference"@en ;
    rdfs:comment "Document management reference or scan identifier for the physical paper authorization form submitted by the customer. Populated when consent_channel is 'paper' or 'written'. Enables retrieval of the original signed document for audit."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "paper_form_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Paper Form Reference" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.pucJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc jurisdiction"@en ;
    rdfs:comment "Two-letter US state code identifying the state Public Utility Commission (PUC) jurisdiction governing this authorization. Determines which state-specific data privacy and customer authorization rules apply. Required for multi-state utility operations."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "puc_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Jurisdiction" ;
    cmm:valuePattern "^[A-Z]{2}$" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.renewalFrequencyDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal frequency days"@en ;
    rdfs:comment "Number of days between required authorization renewals when renewal_required is true. Common values are 365 (annual) or 730 (biennial) per state PUC requirements. Drives automated renewal reminder workflows in the CIS."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:int ;
    cmm:physicalColumn "renewal_frequency_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Frequency Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:ThirdPartyAuthorization.renewalRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewal required"@en ;
    rdfs:comment "Indicates whether this authorization requires periodic renewal by the customer. When true, the system must generate renewal notifications before the effective_end_date. Supports compliance with state PUC rules requiring periodic re-consent for ongoing data sharing."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "renewal_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewal Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ThirdPartyAuthorization.revocationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revocation date"@en ;
    rdfs:comment "The date on which the customer withdrew or revoked this authorization prior to its scheduled end date. Populated only when the customer initiates early termination. Triggers downstream access revocation in CIS, DERMS, and Green Button systems."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:date ;
    cmm:physicalColumn "revocation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Revocation Date" ;
    cmm:cimDatatype "Date" .
cmm:ThirdPartyAuthorization.revocationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revocation reason"@en ;
    rdfs:comment "Reason code explaining why this authorization was revoked or withdrawn. Supports regulatory reporting and customer service analytics. Values: customer_request (voluntary withdrawal), account_closure (account terminated), fraud_reported (suspected unauthorized access), regulatory_order (PUC or FERC directive), system_expiry (automated expiry), other."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "revocation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Authorization Revocation Reason" ;
    cmm:validValues "customer_request|account_closure|fraud_reported|regulatory_order|system_expiry|other" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.sessionToken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "session token"@en ;
    rdfs:comment "Authenticated session token or transaction reference from the digital channel (web portal or mobile app) at the time of consent capture. Provides a cryptographic audit trail linking the consent event to a verified authenticated session. Null for non-digital channels."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "session_token" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Session Token" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The operational system of record from which this authorization record originated. Identifies whether the record was created in SAP IS-U, Oracle CC&B, the customer web portal, mobile app, IVR system, or via manual data entry. Supports data lineage and reconciliation."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:validValues "sap_isu|oracle_ccb|web_portal|mobile_app|ivr|manual_entry" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.sourceSystemReferenceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system reference code"@en ;
    rdfs:comment "The native identifier of this authorization record in the originating operational system (SAP IS-U or Oracle CC&B). Enables bidirectional traceability between the lakehouse silver layer and the CIS system of record."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_reference_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Reference ID" ;
    cmm:cimDatatype "String" .
cmm:ThirdPartyAuthorization.verbalRecordingReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "verbal recording reference"@en ;
    rdfs:comment "Reference identifier for the call recording in which verbal consent was captured (e.g., IVR or agent-assisted phone call). Links to the call recording archive for regulatory audit. Populated only when consent_channel is 'verbal' or 'ivr'."@en ;
    rdfs:domain cmm:ThirdPartyAuthorization ; rdfs:range xsd:string ;
    cmm:physicalColumn "verbal_recording_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Verbal Recording Reference" ;
    cmm:cimDatatype "String" .

cmm:IncentiveEnrollment a owl:Class ;
    rdfs:label "Incentive Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment contract between a utility customer account and a renewable energy incentive program. It captures the application, approval, payment tracking, and compliance verification lifecycle for each account's participation in each incentive program. Each record links one account to one incentive program with attributes that exist only in the context of this specific enrollment relationship, including application details, approved funding amounts, payment schedules, disbursement tracking, and ongoing compliance status.. Existence Justification: In utility renewable energy operations, a customer account can simultaneously participate in multiple incentive programs (e.g., a residential customer with solar PV enrolled in both an ITC rebate program and an SREC program, plus a separate battery storage incentive). Conversely, each incentive program serves hundreds or thousands of customer accounts. The utility actively manages these enrollments as operational business entities, tracking application workflows, approval processes, payment disbursements, compliance verification, and budget allocation for each account-program combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.incentive_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.customer.incentive_enrollment" ;
    owl:hasKey ( cmm:IncentiveEnrollment.incentiveEnrollmentId ) .

cmm:IncentiveEnrollment.incentiveEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive enrollment id"@en ;
    rdfs:comment "Unique surrogate identifier for this incentive program enrollment record. Primary key for the association."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "incentive_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Incentive Enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:IncentiveEnrollment.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Foreign key linking to the utility customer account enrolled in the incentive program"@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Incentive Enrollment - Account Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_incentive_enrollment_account_id" ;
    cmm:cimAssociation "IdentifiedObject.CustomerAccount" .
cmm:IncentiveEnrollment.renewableIncentiveProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable incentive program"@en ;
    rdfs:comment "Foreign key linking to the renewable energy incentive program in which the account is enrolled"@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range cmm:IncentiveProgram ;
    cmm:physicalColumn "renewable_incentive_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Incentive Enrollment - Renewable Incentive Program Id" ;
    cmm:sourceColumn "incentive_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_incentive_enrollment_renewable_incentive_program_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:IncentiveEnrollment.applicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application date"@en ;
    rdfs:comment "Date when the customer submitted the application for this incentive program. Used for determining eligibility windows and processing timelines."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "application_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.applicationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application number"@en ;
    rdfs:comment "Externally-known unique application number assigned when the customer applied for this specific incentive program. Used for customer communication and regulatory tracking."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Application Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:IncentiveEnrollment.applicationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application status"@en ;
    rdfs:comment "Current status of the incentive program application for this account-program enrollment. Tracks the application lifecycle from submission through final disposition."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Status" ;
    cmm:cimDatatype "String" .
cmm:IncentiveEnrollment.approvedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved amount"@en ;
    rdfs:comment "Total dollar amount of incentive funding approved for this specific account-program enrollment in USD. Represents the committed program budget allocation for this participant."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Incentive Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IncentiveEnrollment.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of this account with the requirements of this specific incentive program. Tracks whether the participant is meeting ongoing program obligations such as REC transfer, interconnection standards, or reporting requirements."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:cimDatatype "String" .
cmm:IncentiveEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this enrollment record was first created in the system. Used for audit tracking and data lineage."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Creation Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:IncentiveEnrollment.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date when the account was officially enrolled in the incentive program following application approval. Marks the start of the enrollment relationship."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle status of this account's enrollment in this incentive program. Governs whether payments can be processed and compliance is being monitored."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:IncentiveEnrollment.installedSystemSizeKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installed system size kw"@en ;
    rdfs:comment "Actual installed capacity in kilowatts (kW) of the renewable energy system for which this account is receiving incentives under this program. Used for calculating incentive amounts and verifying eligibility."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "installed_system_size_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installed System Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:IncentiveEnrollment.interconnectionApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection approval date"@en ;
    rdfs:comment "Date when utility interconnection approval was granted for the renewable energy system associated with this enrollment. Required for programs where requires_interconnection_approval is true."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "interconnection_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interconnection Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.lastComplianceVerificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last compliance verification date"@en ;
    rdfs:comment "Date when compliance with program requirements was last verified for this enrollment. Used for tracking ongoing compliance monitoring schedules."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_compliance_verification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Compliance Verification Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this enrollment record was last updated. Used for change tracking and data synchronization."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:IncentiveEnrollment.lastPaymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last payment date"@en ;
    rdfs:comment "Date of the most recent incentive payment disbursed to this account for this program enrollment. Used for payment tracking and schedule management."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Payment Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.nextPaymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next payment date"@en ;
    rdfs:comment "Date when the next incentive payment is scheduled to be disbursed to this account for this program enrollment, based on the payment_schedule and compliance_status."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Scheduled Payment Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveEnrollment.paymentSchedule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment schedule"@en ;
    rdfs:comment "Schedule on which incentive payments will be disbursed to this account for this program enrollment. Determines payment frequency and timing for this specific enrollment."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_schedule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Schedule" ;
    cmm:cimDatatype "String" .
cmm:IncentiveEnrollment.recTransferAgreementSigned a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec transfer agreement signed"@en ;
    rdfs:comment "Indicates whether the customer has signed the Renewable Energy Certificate (REC) transfer agreement required for this program enrollment. Required for programs where requires_rec_transfer is true."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_transfer_agreement_signed" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "REC Transfer Agreement Signed" ;
    cmm:cimDatatype "Boolean" .
cmm:IncentiveEnrollment.remainingBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remaining balance"@en ;
    rdfs:comment "Remaining dollar amount of approved incentive funding that has not yet been paid to this account for this program enrollment in USD. Calculated as approved_amount minus total_paid_amount."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "remaining_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remaining Incentive Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IncentiveEnrollment.technologyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technology type"@en ;
    rdfs:comment "Specific renewable energy technology type for which this account is receiving incentives under this program enrollment. Must match one of the eligible_technology_types for the program."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "technology_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technology Type" ;
    cmm:cimDatatype "String" .
cmm:IncentiveEnrollment.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "Date when this account's enrollment in this incentive program was terminated, either due to program completion, non-compliance, or voluntary withdrawal. Null for active enrollments."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:IncentiveEnrollment.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "Reason code or description explaining why this enrollment was terminated. Examples include program_completed, non_compliance, customer_withdrawal, program_expired, system_decommissioned."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Reason" ;
    cmm:cimDatatype "String" .
cmm:IncentiveEnrollment.totalPaidAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total paid amount"@en ;
    rdfs:comment "Cumulative dollar amount of incentive payments that have been disbursed to this account for this program enrollment to date in USD. Used for budget tracking and payment reconciliation."@en ;
    rdfs:domain cmm:IncentiveEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_paid_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Paid Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:PremiseAssetConnection a owl:Class ;
    rdfs:label "Premise Asset Connection"@en ;
    rdfs:comment "This association product represents the physical service connection between a premise and utility assets. It captures the operational topology of how distribution assets (transformers, poles, service vaults) deliver electric service to customer premises. Each record links one premise to one asset with connection-specific attributes including service voltage, capacity allocation, connection dates, and metering configuration that exist only in the context of this service relationship.. Existence Justification: In utility distribution operations, a single premise is routinely served by multiple physical assets: a primary distribution transformer, potentially a secondary/backup transformer for redundancy, service poles, service vaults, and switchgear. Conversely, a single distribution transformer typically serves 5-50 premises (residential) or multiple commercial premises. The service connection topology is actively managed by distribution engineering and outage management teams, with connection-specific data including service voltage, capacity allocation, connection/disconnection dates, metering point configuration, and connection status (active/backup/temporary)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.service_delivery ;
    cmm:physicalTable "utility_cmm_silver.customer.premise_asset_connection" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.customer.premise_asset_connection" ;
    owl:hasKey ( cmm:PremiseAssetConnection.premiseAssetConnectionId ) .

cmm:PremiseAssetConnection.premiseAssetConnectionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "premise asset connection id"@en ;
    rdfs:comment "Primary key for the premise_asset_connection association"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:long ;
    cmm:physicalColumn "premise_asset_connection_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Premise Asset Connection - Premise Asset Connection Id" ;
    cmm:cimDatatype "Integer" .
cmm:PremiseAssetConnection.meteringPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "metering point"@en ;
    rdfs:comment "Identifier of the specific metering point or meter socket associated with this premise-asset connection. Links to metering infrastructure for billing and load monitoring"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "metering_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Metering Point Identifier" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_premise_asset_connection_metering_point_id" ;
    cmm:cimAssociation "IdentifiedObject.UsagePoint" .
cmm:PremiseAssetConnection.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to the premise receiving utility service"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Asset Connection - Premise Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_premise_asset_connection_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:PremiseAssetConnection.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to the utility asset providing service"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Asset Connection - Asset Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_premise_asset_connection_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:PremiseAssetConnection.capacityAllocationKva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity allocation kva"@en ;
    rdfs:comment "Allocated transformer capacity in kilovolt-amperes (kVA) reserved for this premise on this asset. Used for load planning and capacity management when multiple premises share a transformer"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_allocation_kva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Allocation" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ApparentPower" .
cmm:PremiseAssetConnection.connectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection date"@en ;
    rdfs:comment "Date when this premise was physically connected to this specific asset for service delivery"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:date ;
    cmm:physicalColumn "connection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Connection Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseAssetConnection.connectionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection status"@en ;
    rdfs:comment "Current operational status of this service connection (active and energized, inactive/disconnected, temporarily suspended, or pending activation)"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "connection_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Connection Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:PremiseAssetConnection.connectionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "connection type"@en ;
    rdfs:comment "Classification of the service connection relationship (primary service path, secondary/redundant path, backup connection, or temporary connection during maintenance)"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:string ;
    cmm:physicalColumn "connection_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Connection Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:PremiseAssetConnection.disconnectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnection date"@en ;
    rdfs:comment "Date when this premise was disconnected from this specific asset (due to asset retirement, premise reconfiguration, or grid topology changes). Null if connection is currently active"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:date ;
    cmm:physicalColumn "disconnection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnection Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseAssetConnection.serviceVoltage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage"@en ;
    rdfs:comment "Actual voltage delivered at this specific premise-asset connection point in volts. May differ from premise service_voltage_class due to transformer configuration or multi-voltage service"@en ;
    rdfs:domain cmm:PremiseAssetConnection ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "service_voltage" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage" ;
    cmm:cimDatatype "Decimal" .

cmm:PremiseServiceContract a owl:Class ;
    rdfs:label "Premise Service Contract"@en ;
    rdfs:comment "This association product represents the service contract relationship between a premise and a vendor. It captures vendor-provided maintenance and service agreements for specific premises, including HVAC maintenance, generator service, substation maintenance, and emergency restoration services. Each record links one premise to one vendor with contract-specific terms, SLAs, service scope, and commercial terms that exist only in the context of this contractual relationship.. Existence Justification: In utility operations, large commercial and industrial premises routinely have multiple concurrent service contracts with different vendors (e.g., one vendor for HVAC maintenance, another for generator service, a third for substation maintenance). Simultaneously, each vendor serves multiple premises across the utility's service territory. The business actively manages these service contracts as operational entities with contract-specific terms, SLAs, service scopes, and performance tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.service_delivery ;
    cmm:physicalTable "utility_cmm_silver.customer.premise_service_contract" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.customer.premise_service_contract" ;
    owl:hasKey ( cmm:PremiseServiceContract.premiseServiceContractId ) .

cmm:PremiseServiceContract.premiseServiceContractId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "premise service contract id"@en ;
    rdfs:comment "Unique identifier for this premise-vendor service contract record. Primary key."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:long ;
    cmm:physicalColumn "premise_service_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Premise Service Contract ID" ;
    cmm:cimDatatype "Integer" .
cmm:PremiseServiceContract.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to the premise receiving vendor services under this contract"@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Service Contract - Premise Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_premise_service_contract_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:PremiseServiceContract.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor providing services under this contract"@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Service Contract - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_premise_service_contract_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:PremiseServiceContract.autoRenewalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto renewal flag"@en ;
    rdfs:comment "Indicates whether this service contract automatically renews at the end of the contract term unless explicitly cancelled. Used for contract management and renewal tracking."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_renewal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto Renewal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PremiseServiceContract.billingFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing frequency"@en ;
    rdfs:comment "Frequency at which the vendor invoices for services under this contract. Defines the billing cycle for this premise-vendor service relationship."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "billing_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Frequency" ;
    cmm:cimDatatype "String" .
cmm:PremiseServiceContract.contractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract end date"@en ;
    rdfs:comment "Expiration or termination date of the service contract. Used for contract renewal tracking and vendor performance evaluation scheduling."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract End Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseServiceContract.contractStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract start date"@en ;
    rdfs:comment "Effective start date of the service contract. Defines when vendor service obligations begin for this premise."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Start Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseServiceContract.contractStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract status"@en ;
    rdfs:comment "Current lifecycle status of the service contract. ACTIVE = contract in force, EXPIRED = contract term ended, TERMINATED = contract cancelled before end date, SUSPENDED = services temporarily halted, PENDING_RENEWAL = approaching expiration and under renewal negotiation."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Contract Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:PremiseServiceContract.contractValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract value"@en ;
    rdfs:comment "Total monetary value of the service contract in the vendor's currency. Represents the committed spend for vendor services at this premise over the contract period. Used for budget tracking and vendor spend analysis."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contract_value" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Value" ;
    cmm:cimDatatype "Decimal" .
cmm:PremiseServiceContract.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this service contract record was created in the system."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:PremiseServiceContract.lastServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last service date"@en ;
    rdfs:comment "Date of the most recent service visit or maintenance activity performed by the vendor at this premise under this contract. Used for service frequency tracking and compliance monitoring."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Service Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseServiceContract.nextScheduledServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next scheduled service date"@en ;
    rdfs:comment "Date of the next planned preventive maintenance or service visit by the vendor at this premise. Used for service scheduling and coordination."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_scheduled_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Scheduled Service Date" ;
    cmm:cimDatatype "Date" .
cmm:PremiseServiceContract.primaryContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact name"@en ;
    rdfs:comment "Name of the vendor's primary service contact assigned to this premise. The technician or account manager responsible for service delivery at this specific location."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Contact Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" .
cmm:PremiseServiceContract.primaryContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary contact phone"@en ;
    rdfs:comment "Phone number of the vendor's primary service contact for this premise. Used for emergency service requests and routine coordination."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "primary_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Primary Contact Phone" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:PremiseServiceContract.responseTimeSlaHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "response time sla hours"@en ;
    rdfs:comment "Service Level Agreement response time in hours. Defines the maximum time the vendor has to respond to a service request or emergency call for this premise. Used for SLA compliance monitoring."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "response_time_sla_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Response Time SLA Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:PremiseServiceContract.serviceContractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service contract number"@en ;
    rdfs:comment "Business identifier for the service contract as assigned by procurement or vendor management. Externally known contract reference number used in invoicing and service tickets."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:PremiseServiceContract.serviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service type"@en ;
    rdfs:comment "Classification of the service provided under this contract. Defines the scope of vendor responsibilities for this premise (e.g., HVAC maintenance, generator service, substation maintenance, emergency restoration)."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:PremiseServiceContract.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this service contract record was last modified."@en ;
    rdfs:domain cmm:PremiseServiceContract ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:CustomerDrEnrollment a owl:Class ;
    rdfs:label "Customer Dr Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment contract between a premise and a demand response program. It captures premise-specific participation terms, load capacity commitments, telemetry configuration, and baseline methodology overrides. Each record links one premise to one DR program with attributes that exist only in the context of this enrollment relationship. SSOT for all premise-level DR participation tracking.. Existence Justification: In utility demand response operations, premises participate in multiple DR programs simultaneously (e.g., a commercial premise enrolled in both an interruptible tariff program and a behavioral DR campaign), and each DR program enrolls thousands of premises across the service territory. The enrollment relationship is an operational business entity that DR program managers actively create, monitor, and terminate, with premise-specific attributes like committed load capacity, telemetry configuration, and baseline methodology overrides."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.customer_dr_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.customer.customer_dr_enrollment" ;
    owl:hasKey ( cmm:CustomerDrEnrollment.customerDrEnrollmentId ) .

cmm:CustomerDrEnrollment.customerDrEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer dr enrollment id"@en ;
    rdfs:comment "Primary key for customer_dr_enrollment"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "customer_dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "customer_dr_enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerDrEnrollment.drEnrollment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr enrollment"@en ;
    rdfs:comment "Unique surrogate identifier for this demand response enrollment record. Primary key."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range cmm:DemandDrEnrollment ;
    cmm:physicalColumn "dr_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "DR Enrollment Identifier" ;
    cmm:sourceColumn "demand_dr_enrollment_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_dr_enrollment_dr_enrollment_id" ;
    cmm:cimAssociation "IdentifiedObject.Agreement" .
cmm:CustomerDrEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to the demand response program in which the premise is enrolled"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment - Dr Program Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_dr_enrollment_dr_program_id" ;
    cmm:cimAssociation "IdentifiedObject.DemandResponseProgram" .
cmm:CustomerDrEnrollment.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Foreign key linking to the premise enrolled in the demand response program"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Enrollment - Premise Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_customer_customer_dr_enrollment_premise_id" ;
    cmm:cimAssociation "IdentifiedObject.ServiceLocation" .
cmm:CustomerDrEnrollment.baselineCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline calculation method"@en ;
    rdfs:comment "Premise-specific override of the baseline calculation methodology used for this enrollment. Allows individual premises to use different baseline methods than the program default when justified by meter configuration, load volatility, or regulatory requirements. If null, inherits from dr_program.baseline_calculation_method."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "baseline_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Calculation Method" ;
    cmm:cimDatatype "String" .
cmm:CustomerDrEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this enrollment record was created in the system"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IdentifiedObject.createdDateTime .
cmm:CustomerDrEnrollment.demandResponseEnrolled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response enrolled"@en ;
    rdfs:comment "Indicates whether the premise is currently enrolled in a utility Demand Response (DR) or load control program. Supports DR dispatch eligibility, load curtailment planning, and RTO/ISO demand response market participation reporting. [Moved from premise: This boolean flag on premise indicates whether the premise is enrolled in ANY DR program. This is a derived/aggregated attribute that can be calculated from the existence of active dr_enrollment records. It does not belong on the premise master record—it should be derived from the enrollment association. Removing this flag enforces single source of truth in the enrollment table.]"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_enrolled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Enrolled" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerDrEnrollment.enrolledLoadCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled load capacity kw"@en ;
    rdfs:comment "Premise-specific committed load reduction capacity in kilowatts for this enrollment. Represents the load curtailment the premise has agreed to provide when DR events are dispatched. Aggregated across all enrollments to calculate program-level enrolled_capacity_actual_mw."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_load_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Load Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:CustomerDrEnrollment.enrollmentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment channel"@en ;
    rdfs:comment "Channel through which this premise was enrolled in the DR program. Used for marketing attribution, enrollment cost analysis, and channel effectiveness measurement."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:cimDatatype "String" .
cmm:CustomerDrEnrollment.enrollmentEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment effective date"@en ;
    rdfs:comment "Date when this premise enrollment becomes active and the premise is eligible for DR event dispatch and incentive payments. Must fall within the parent dr_program effective date range."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerDrEnrollment.enrollmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment end date"@en ;
    rdfs:comment "Date when this premise enrollment terminates. Null for open-ended enrollments. Used to track enrollment history and calculate active enrollment counts."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment End Date" ;
    cmm:cimDatatype "Date" .
cmm:CustomerDrEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle status of this enrollment. Active indicates premise is eligible for dispatch. Suspended indicates temporary ineligibility (e.g., equipment failure, customer request). Terminated indicates permanent end. Pending Activation indicates enrollment approved but not yet effective."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:CustomerDrEnrollment.incentiveOverrideAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive override amount"@en ;
    rdfs:comment "Premise-specific incentive amount override. If populated, this value supersedes the program-level dr_program.incentive_amount for this enrollment. Used for negotiated rates with large commercial/industrial customers or pilot program participants. Null indicates use of program default."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_override_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Override Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CustomerDrEnrollment.participationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation rate percent"@en ;
    rdfs:comment "Historical participation rate percentage for this premise across past DR events in this program. Calculated as (number of events participated / number of events dispatched) * 100. Used for performance tracking, incentive adjustments, and enrollment retention analysis."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "participation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Rate Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CustomerDrEnrollment.telemetryEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "telemetry enabled flag"@en ;
    rdfs:comment "Indicates whether real-time telemetry data (AMI interval data, DER telemetry, or SCADA signals) is enabled for this premise enrollment. Required for direct load control programs and VPP aggregation. Determines whether premise participates in automated dispatch or manual notification-based DR."@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "telemetry_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Telemetry Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CustomerDrEnrollment.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this enrollment record was last modified"@en ;
    rdfs:domain cmm:CustomerDrEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:CustomerCase a owl:Class ;
    rdfs:label "Customer Case"@en ;
    rdfs:comment "Master reference table for case. Referenced by case_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TroubleTicket ;
    cmm:cimCloseMatch cim:TroubleTicket ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.customer_engagement ;
    cmm:physicalTable "utility_cmm_silver.customer.case" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-8" ;
    cmm:sourceObject "energy_utilities_ecm.customer.case" ;
    owl:hasKey ( cmm:CustomerCase.caseId ) .

cmm:CustomerCase.caseId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "case id"@en ;
    rdfs:comment "Primary key for case"@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range xsd:long ;
    cmm:physicalColumn "case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Case Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerCase.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the individual support agent assigned to the case."@en ;
    rdfs:domain cmm:CustomerCase ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
