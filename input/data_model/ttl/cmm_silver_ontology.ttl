    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "File Format" ;
    cmm:cimDatatype "String" .
cmm:ApplicationDocument.fileName a owl:DatatypeProperty , owl:FunctionalProperty ;
