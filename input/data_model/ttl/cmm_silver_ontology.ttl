cmm:UnitCertificationRequirement.mandatoryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mandatory flag"@en ;
    rdfs:comment "Indicates whether this certification is absolutely mandatory (regulatory requirement) or recommended (best practice) for personnel working with this generating unit in the specified role."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mandatory_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mandatory Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:UnitCertificationRequirement.nercCipRequirementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip requirement flag"@en ;
    rdfs:comment "Indicates whether this certification requirement is driven by NERC CIP (Critical Infrastructure Protection) standards for cyber security and physical access to bulk electric system assets. True when the generating unit is classified as a BES Cyber Asset and personnel require CIP-specific clearances."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_cip_requirement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC CIP Requirement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:UnitCertificationRequirement.regulatoryCitation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory citation"@en ;
    rdfs:comment "Specific regulation, NERC standard, OSHA rule, or state PUC order that mandates this certification for this unit type or voltage class. Provides traceability for compliance audits."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_citation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Citation" ;
    cmm:cimDatatype "String" .
cmm:UnitCertificationRequirement.requiredForRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "required for role"@en ;
    rdfs:comment "The operational role or job function for which this certification is required when working with this specific generating unit. Determines which personnel must hold this certification based on their interaction with the unit."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:string ;
    cmm:physicalColumn "required_for_role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Required For Role" ;
    cmm:cimDatatype "String" .
cmm:UnitCertificationRequirement.requirementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requirement status"@en ;
    rdfs:comment "Current lifecycle status of this certification requirement. ACTIVE = currently enforced, PENDING = future requirement, SUPERSEDED = replaced by newer requirement, WAIVED = exception granted, GRANDFATHERED = existing personnel exempt."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:string ;
    cmm:physicalColumn "requirement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Requirement Status" ;
