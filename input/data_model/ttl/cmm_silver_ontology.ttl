    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_mutual_aid_deployment_event_id" ;
    cmm:cimAssociation "Assignment.Outage" .
cmm:MutualAidDeployment.mutualAidAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid agreement"@en ;
    rdfs:comment "Identifier of the mutual aid agreement or compact under which the deployment was authorized (e.g., EEI Mutual Assistance Agreement, regional compact)."@en ;
