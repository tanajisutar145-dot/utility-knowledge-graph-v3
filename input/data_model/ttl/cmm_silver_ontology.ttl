    cmm:businessTerm "Emission Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:EmissionsReport.emissionUnitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emission unit of measure"@en ;
    rdfs:comment "The unit of measure for the reported emission quantity (typically tons, but may include pounds or kilograms for certain pollutants)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "emission_unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Emission Unit of Measure" ;
    cmm:validValues "tons|pounds|kilograms" ;
    cmm:cimDatatype "String" ;
