    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:Terminal.sequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sequence number"@en ;
    rdfs:comment "Orientation/sequence of the terminal on the equipment (1, 2, ...)."@en ;
