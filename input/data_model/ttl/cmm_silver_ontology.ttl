cmm:SafetyIncident.locationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location description"@en ;
    rdfs:comment "Textual description of where the incident occurred (e.g., substation yard, transmission line mile marker, generation plant turbine hall, customer premise, public road)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
