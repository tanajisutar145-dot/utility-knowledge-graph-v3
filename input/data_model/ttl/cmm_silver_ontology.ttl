cmm:EmissionsReport.reportSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "report submission date"@en ;
    rdfs:comment "The date when the emissions report was submitted to the regulatory agency (EPA or state environmental agency)."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "report_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Report Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:EmissionsReport.reportingPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reporting period end date"@en ;
    rdfs:comment "The end date of the emissions reporting period covered by this report."@en ;
    rdfs:domain cmm:EmissionsReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "reporting_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
