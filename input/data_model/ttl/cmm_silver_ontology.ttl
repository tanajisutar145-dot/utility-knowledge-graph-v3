# Utility CMM-aligned Canonical Data Model (Silver) v1.0.0 | source: Databricks lakehouse-industry-data-models energy_utilities v1 ECM | generated 2026-10-13
# Utility CMM canonical silver ontology (OWL 2 DL-compatible). One class per canonical table, one property per column.
# Classes specialise IEC CIM (CIM100) classes; properties carry CIM attribute mappings; FKs are object properties.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix cim: <http://iec.ch/TC57/CIM100#> .
@prefix cmm: <http://www.utility-cmm.org/ontology/silver#> .
@prefix cmmsa: <http://www.utility-cmm.org/ontology/silver/subject-area#> .


<http://www.utility-cmm.org/ontology/silver> a owl:Ontology ;
    dcterms:title "Utility CMM-aligned Canonical Silver Ontology"@en ;
    dcterms:description "OWL ontology of the Utility Common Mapping Model (CMM) canonical silver data model. Every class is aligned to the IEC TC57 Common Information Model (IEC 61970-301, IEC 61968-11, IEC 62325-301) and every property to a CIM attribute or a CMM extension. Derived from the Databricks Energy & Utilities Expanded Coverage Model (ECM) v1."@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://www.utility-cmm.org/ontology/silver/1.0.0> ;
    owl:imports <http://www.utility-cmm.org/ontology/cim-subset> , <http://www.utility-cmm.org/ontology/silver/subject-areas> ;
    dcterms:source "https://github.com/databricks-industry-solutions/lakehouse-industry-data-models/tree/main/data-models/energy_utilities/v1/ecm" ;
    dcterms:created "2026-10-13"^^xsd:date ;
    vann:preferredNamespacePrefix "cmm" ;
    vann:preferredNamespaceUri "http://www.utility-cmm.org/ontology/silver#" .

cmm:cimExactMatch a owl:AnnotationProperty ; rdfs:label "CIM exact match"@en ; rdfs:subPropertyOf skos:exactMatch .
cmm:cimCloseMatch a owl:AnnotationProperty ; rdfs:label "CIM close match"@en ; rdfs:subPropertyOf skos:closeMatch .
cmm:cimBroadMatch a owl:AnnotationProperty ; rdfs:label "CIM broad match"@en ; rdfs:subPropertyOf skos:broadMatch .
cmm:cimExtends a owl:AnnotationProperty ; rdfs:label "CMM extension of CIM class"@en .
cmm:cimMappingLevel a owl:AnnotationProperty ; rdfs:label "CIM mapping level"@en .
cmm:cimPackage a owl:AnnotationProperty ; rdfs:label "CIM package"@en .
cmm:cimStandard a owl:AnnotationProperty ; rdfs:label "IEC standard"@en .
cmm:cimAssociation a owl:AnnotationProperty ; rdfs:label "CIM association role"@en .
cmm:cimLocationRole a owl:AnnotationProperty ; rdfs:label "CIM Location association"@en .
cmm:cimDatatype a owl:AnnotationProperty ; rdfs:label "CIM datatype"@en .
cmm:unitSymbol a owl:AnnotationProperty ; rdfs:label "CIM UnitSymbol"@en .
cmm:unitMultiplier a owl:AnnotationProperty ; rdfs:label "CIM UnitMultiplier"@en .
cmm:physicalTable a owl:AnnotationProperty ; rdfs:label "physical table"@en .
cmm:physicalColumn a owl:AnnotationProperty ; rdfs:label "physical column"@en .
cmm:sqlDataType a owl:AnnotationProperty ; rdfs:label "SQL data type"@en .
cmm:sourceObject a owl:AnnotationProperty ; rdfs:label "source object"@en .
cmm:sourceColumn a owl:AnnotationProperty ; rdfs:label "source column"@en .
cmm:dataClassification a owl:AnnotationProperty ; rdfs:label "data classification"@en .
cmm:sensitivity a owl:AnnotationProperty ; rdfs:label "sensitivity / PII tag"@en .
cmm:businessTerm a owl:AnnotationProperty ; rdfs:label "business glossary term"@en .
cmm:standardReference a owl:AnnotationProperty ; rdfs:label "standard reference"@en .
cmm:validValues a owl:AnnotationProperty ; rdfs:label "valid values"@en .
cmm:valuePattern a owl:AnnotationProperty ; rdfs:label "value pattern"@en .
cmm:fkConstraint a owl:AnnotationProperty ; rdfs:label "foreign key constraint"@en .
cmm:nullable a owl:AnnotationProperty ; rdfs:label "nullable"@en .

cmm:CanonicalEntity a owl:Class ;
    rdfs:subClassOf cim:IdentifiedObject ;
    rdfs:label "Canonical Entity"@en ;
    rdfs:comment "Root of all CMM canonical silver entities. Every instance is a CIM IdentifiedObject identified by cim:IdentifiedObject.mRID and carries the CMM silver envelope (lineage, soft delete, data quality, load timestamps)."@en .

cmm:hasLocation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has location"@en ;
    rdfs:comment "Link from a locatable canonical entity to its canonical CIM Location (column gis_location_id). Specialises CIM PowerSystemResource.Location / Asset.Location / UsagePoint.UsagePointLocation / BaseWork.WorkLocation."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range cmm:GisLocation ;
    cmm:physicalColumn "gis_location_id" ; cmm:sqlDataType "BIGINT" ; cmm:cimAssociation "PowerSystemResource.Location" .

cmm:CanonicalEntity.srcSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "src system code"@en ;
    rdfs:comment "Code of the system of record that supplied this row (e.g. SAP_ISU, ORACLE_CCB, VENTYX_EAM, ESRI_UN, OSI_PI). CIM Name.NameType.NameTypeAuthority equivalent."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:string ;
    cmm:physicalColumn "cmm_src_system_code" ; cmm:sqlDataType "STRING" ; cmm:nullable false .
cmm:CanonicalEntity.srcRecordKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "src record key"@en ;
    rdfs:comment "Natural/business key of the record in the source system (lineage key, CIM Name.name for NameType = source key)."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:string ;
    cmm:physicalColumn "cmm_src_record_key" ; cmm:sqlDataType "STRING" ; cmm:nullable false .
cmm:CanonicalEntity.rowHash a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "row hash"@en ;
    rdfs:comment "SHA-256 hash of all business columns; used for change detection in MERGE (SCD1 with Change Data Feed history)."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:string ;
    cmm:physicalColumn "cmm_row_hash" ; cmm:sqlDataType "STRING" ; cmm:nullable true .
cmm:CanonicalEntity.isDeleted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is deleted"@en ;
    rdfs:comment "Soft-delete indicator propagated from source deletes (TRUE = logically deleted)."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cmm_is_deleted" ; cmm:sqlDataType "BOOLEAN" ; cmm:nullable false .
cmm:CanonicalEntity.dqStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dq status"@en ;
    rdfs:comment "Data quality outcome of silver validation for this row. Valid values are `PASS|WARN|FAIL`."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:string ;
    cmm:physicalColumn "cmm_dq_status" ; cmm:sqlDataType "STRING" ; cmm:nullable true .
cmm:CanonicalEntity.batchId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "batch id"@en ;
    rdfs:comment "Pipeline run / batch identifier that last wrote this row (lineage)."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:string ;
    cmm:physicalColumn "cmm_batch_id" ; cmm:sqlDataType "STRING" ; cmm:nullable true .
cmm:CanonicalEntity.insertTs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "insert ts"@en ;
    rdfs:comment "UTC timestamp when the row was first inserted into the silver layer."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cmm_insert_ts" ; cmm:sqlDataType "TIMESTAMP" ; cmm:nullable false .
cmm:CanonicalEntity.updateTs a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "update ts"@en ;
    rdfs:comment "UTC timestamp when the row was last updated in the silver layer."@en ;
    rdfs:domain cmm:CanonicalEntity ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "cmm_update_ts" ; cmm:sqlDataType "TIMESTAMP" ; cmm:nullable false .


#################################################################
# Subject area: asset
#################################################################

cmm:AssetRegistry a owl:Class ;
    rdfs:label "Asset Registry"@en ;
    rdfs:comment "Master record for all utility physical assets including generation units, transmission towers, distribution poles, transformers, switchgear, protection relays, substation equipment, fleet vehicles, and facilities. Captures asset identity, classification, installation details, location (GIS coordinates), manufacturer, model, serial number, commissioning date, rated capacity, voltage class, asset condition rating, operational status, regulatory classification, and RAB (Regulatory Asset Base) inclusion flag. SSOT for asset identity across the enterprise, sourced from Ventyx Asset Suite EAM."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Asset ;
    cmm:cimExactMatch cim:Asset ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.asset_registry ;
    cmm:physicalTable "utility_cmm_silver.asset.registry" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Asset.Location" ;
    cmm:standardReference "ISO 55000; Ventyx Asset Suite — Asset Master / IEC 61968 Asset" ;
    cmm:sourceObject "energy_utilities_ecm.asset.registry" ;
    owl:hasKey ( cmm:AssetRegistry.registryId ) .

cmm:AssetRegistry.registryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "registry id"@en ;
    rdfs:comment "Unique identifier for the asset registry record. Primary key for the asset registry product."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:long ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Registry ID" ;
    cmm:cimDatatype "Integer" .
cmm:AssetRegistry.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Foreign key linking to asset.asset_class. Business justification: asset_registry currently has asset_class (STRING) attribute storing class name/code. This should be normalized to FK pointing to asset_class reference table. The asset_class product is the authoritati"@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_registry_class_id" ;
    cmm:cimAssociation "Asset.AssetInfo" .
cmm:AssetRegistry.manufacturerVendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer vendor"@en ;
    rdfs:comment "Foreign key linking to supply.vendor. Business justification: Assets have OEM manufacturers tracked as vendors for warranty claims, technical support, and spare parts procurement. Formalizes manufacturer field into vendor master for supplier performance tracking"@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "manufacturer_vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Manufacturer Vendor Id (Foreign Key)" ;
    cmm:sourceColumn "vendor_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_registry_manufacturer_vendor_id" ;
    cmm:cimAssociation "Asset.Organisation" .
cmm:AssetRegistry.parentAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent asset registry"@en ;
    rdfs:comment "Reference to the parent asset in a hierarchical asset structure (e.g., a relay's parent transformer, a component's parent assembly). Enables bill-of-materials and asset hierarchy navigation."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "parent_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Parent Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_registry_parent_asset_registry_id" ;
    cmm:cimAssociation "Asset.Asset" .
cmm:AssetRegistry.acquisitionCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition cost"@en ;
    rdfs:comment "Original purchase or construction cost of the asset in USD. Used for depreciation calculations and financial reporting."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Acquisition Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" ;
    cmm:cimCloseMatch cim:Asset.purchasePrice .
cmm:AssetRegistry.assetClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "High-level classification of the asset type based on utility functional area. Used for portfolio segmentation and regulatory reporting. Reference-value candidates: generation|transmission|distribution|substation|protection|metering|fleet|facility."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.assetConditionRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset condition rating"@en ;
    rdfs:comment "Current physical and operational condition assessment of the asset based on inspection and testing. Drives maintenance prioritization and replacement planning."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_condition_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Condition Rating" ;
    cmm:validValues "excellent|good|fair|poor|critical" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.assetName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset name"@en ;
    rdfs:comment "Human-readable name or title of the asset for identification and reporting purposes."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Name" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.assetTag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset tag"@en ;
    rdfs:comment "Externally-known unique asset identifier assigned by the utility for tracking and identification purposes. Used across maintenance, inventory, and financial systems."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_tag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Tag Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AssetRegistry.assetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset type"@en ;
    rdfs:comment "Detailed asset type within the asset class (e.g., power transformer, circuit breaker, transmission tower, distribution pole, generation turbine, relay). Reference-value candidates: power_transformer|circuit_breaker|transmission_tower|distribution_pole|generation_turbine|combustion_turbine|steam_turbine|relay|capacitor_bank|voltage_regulator|recloser|sectionalizer|switchgear|substation_battery|diesel_generator|service_vehicle|bucket_truck|operations_center|warehouse."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Type" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.bookValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book value"@en ;
    rdfs:comment "Current net book value of the asset after accumulated depreciation. Updated periodically based on depreciation schedules."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "book_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Book Value" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetRegistry.capacityUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity unit"@en ;
    rdfs:comment "Unit of measure for the rated capacity field (Megawatt, Megavolt-Ampere, Kilovolt, Kilovolt-Ampere, Ampere, Kiloampere)."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "capacity_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Unit of Measure" ;
    cmm:validValues "MW|MVA|kV|kVA|A|kA" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "Date when the asset was placed into service and became operational. Used for depreciation calculations and lifecycle planning."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:AssetRegistry.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this asset registry record was first created in the system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Asset.createdDateTime .
cmm:AssetRegistry.criticalityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality score"@en ;
    rdfs:comment "Numerical score (typically 1-10) representing the asset's criticality to grid reliability and customer service. Used for maintenance prioritization and risk assessment."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:int ;
    cmm:physicalColumn "criticality_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Score" ;
    cmm:cimDatatype "Integer" .
cmm:AssetRegistry.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the source system that provided this asset record (e.g., Ventyx Asset Suite, SAP PM, GIS). Used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Accounting method used to calculate depreciation for this asset class. Typically prescribed by regulatory authority."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|units_of_production|regulatory" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.environmentalComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental compliance flag"@en ;
    rdfs:comment "Indicates whether this asset is subject to EPA environmental regulations (e.g., emissions monitoring, hazardous materials handling, PCB transformer tracking)."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "environmental_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetRegistry.failureRiskCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure risk category"@en ;
    rdfs:comment "Risk category for asset failure based on condition, age, and operational stress. Drives preventive maintenance and replacement strategies."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_risk_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Risk Category" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for financial classification of the asset. Required for regulatory financial reporting and rate case filings."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3}(\\.[0-9]{1,2})?$" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the asset was physically installed at its location, which may precede commissioning date."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:LifecycleDate.installationDate .
cmm:AssetRegistry.lastInspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last inspection date"@en ;
    rdfs:comment "Date of the most recent formal inspection or condition assessment performed on the asset."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_inspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Inspection Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetRegistry.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent completed maintenance work order for this asset. Used to calculate next maintenance due dates."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetRegistry.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this asset registry record was most recently modified. Used for change tracking and data synchronization."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AssetRegistry.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the asset location in decimal degrees. Used for GIS mapping and outage analysis."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude Coordinate" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:AssetRegistry.locationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location description"@en ;
    rdfs:comment "Human-readable description of the asset's physical location (e.g., substation name, pole number, facility address)."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Location Description" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the asset location in decimal degrees. Used for GIS mapping and outage analysis."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude Coordinate" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:AssetRegistry.maintenanceStrategy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance strategy"@en ;
    rdfs:comment "Assigned maintenance approach for this asset based on criticality, failure modes, and cost-benefit analysis. Determines work order generation rules."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_strategy" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Strategy" ;
    cmm:validValues "reactive|preventive|predictive|condition_based|run_to_failure" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.modelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model number"@en ;
    rdfs:comment "Manufacturer's model or part number for the asset. Used for spare parts procurement and technical specifications lookup."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Model Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AssetRegistry.nercCriticalAssetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc critical asset flag"@en ;
    rdfs:comment "Indicates whether this asset is designated as a NERC Critical Cyber Asset or Critical Infrastructure Protection (CIP) asset, requiring enhanced security and compliance controls."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_critical_asset_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Critical Asset Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetRegistry.nextInspectionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next inspection due date"@en ;
    rdfs:comment "Scheduled date for the next required inspection based on regulatory requirements or maintenance strategy."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_inspection_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Inspection Due Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetRegistry.nextMaintenanceDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next maintenance due date"@en ;
    rdfs:comment "Scheduled date for the next planned maintenance activity based on maintenance strategy and interval rules."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_maintenance_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Maintenance Due Date" ;
    cmm:cimDatatype "Date" .
cmm:AssetRegistry.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the asset in its lifecycle. Determines availability for grid operations and maintenance planning."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|standby|retired|under_construction|commissioned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.status .
cmm:AssetRegistry.ownershipType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership type"@en ;
    rdfs:comment "Legal ownership classification of the asset. Determines financial treatment, maintenance responsibility, and regulatory reporting requirements."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Type" ;
    cmm:validValues "owned|leased|joint_ownership|customer_owned|third_party" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.rabInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion flag"@en ;
    rdfs:comment "Indicates whether this asset is included in the Regulatory Asset Base for rate-making purposes. Critical for CAPEX planning and rate case preparation."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetRegistry.ratedCapacity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rated capacity"@en ;
    rdfs:comment "Nameplate capacity or rating of the asset in its primary unit of measure (MW for generation, MVA for transformers, kV for voltage equipment). Critical for grid planning and load management."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rated_capacity" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rated Capacity" ;
    cmm:cimDatatype "Decimal" .
cmm:AssetRegistry.recordActiveFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record active flag"@en ;
    rdfs:comment "Indicates whether this asset registry record is currently active and valid. Used for soft deletes and historical record retention."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "record_active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetRegistry.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "Date when the asset was permanently removed from service and retired. Triggers final depreciation and asset disposal processes."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:AssetRegistry.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by the manufacturer to this specific asset unit. Critical for warranty tracking and asset identity verification."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Serial Number" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:Asset.serialNumber .
cmm:AssetRegistry.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Utility service territory or operating region where the asset is located. Used for regulatory reporting and operational planning."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:AssetRegistry.usefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "useful life years"@en ;
    rdfs:comment "Expected useful life of the asset in years as determined by engineering standards or regulatory guidance. Used for depreciation and replacement planning."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:int ;
    cmm:physicalColumn "useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:AssetRegistry.voltageClassKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage class kv"@en ;
    rdfs:comment "Nominal voltage class of the asset in kilovolts. Used for grid segmentation and equipment compatibility analysis."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_class_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Voltage Class (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:AssetRegistry.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer's warranty coverage expires. Important for maintenance cost planning and vendor claims."@en ;
    rdfs:domain cmm:AssetRegistry ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:AssetHierarchy a owl:Class ;
    rdfs:label "Asset Hierarchy"@en ;
    rdfs:comment "Defines the parent-child structural hierarchy of utility assets, enabling roll-up from component level (e.g., circuit breaker trip coil) to equipment level (e.g., 132kV circuit breaker) to functional location (e.g., substation bay 3) to facility (e.g., Northside 132kV Substation) to network segment (e.g., Northern Transmission Zone). Each hierarchy record captures parent asset reference, child asset reference, hierarchy level, hierarchy type (functional location, linear asset, electrical connectivity), and effective date range. Supports CAPEX/OPEX cost roll-up, condition aggregation, RAB valuation at any hierarchy level, and regulatory reporting by network segment. Aligned with Ventyx Asset Suite functional location structure, SAP S/4HANA Plant Maintenance hierarchy, and IEC 61968 CIM asset model."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AssetContainer ;
    cmm:cimCloseMatch cim:AssetContainer ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.asset_registry ;
    cmm:physicalTable "utility_cmm_silver.asset.hierarchy" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "ISO 14224 taxonomy; Ventyx Asset Suite — Functional Location / SAP PM Functional Location" ;
    cmm:sourceObject "energy_utilities_ecm.asset.hierarchy" ;
    owl:hasKey ( cmm:AssetHierarchy.hierarchyId ) .

cmm:AssetHierarchy.hierarchyId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy id"@en ;
    rdfs:comment "Unique identifier for the asset hierarchy relationship record. Primary key for the asset hierarchy product."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:long ;
    cmm:physicalColumn "hierarchy_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Hierarchy Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:AssetHierarchy.childAssetAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "child asset asset registry"@en ;
    rdfs:comment "Reference to the child asset in the hierarchy structure. Links to the asset registry for the lower-level asset (e.g., equipment, component, device)."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "child_asset_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Child Asset Identifier (ID)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_hierarchy_child_asset_asset_registry_id" ;
    cmm:cimAssociation "AssetContainer.Asset" .
cmm:AssetHierarchy.hierarchyEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy employee"@en ;
    rdfs:comment "Identifier of the user or system account that created this hierarchy relationship record. Used for audit trail and data governance. Links to enterprise identity management system."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "hierarchy_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_hierarchy_hierarchy_employee_id" ;
    cmm:cimAssociation "AssetContainer.ErpPersonnel" .
cmm:AssetHierarchy.hierarchyLastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy last modified by user employee"@en ;
    rdfs:comment "Identifier of the user or system account that last modified this hierarchy relationship record. Used for audit trail and change tracking. Links to enterprise identity management system."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "hierarchy_last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_hierarchy_hierarchy_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "AssetContainer.ErpPersonnel" .
cmm:AssetHierarchy.hierarchyRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy registry"@en ;
    rdfs:comment "Reference to the parent asset in the hierarchy structure. Links to the asset registry for the higher-level asset (e.g., substation, facility, network segment)."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "hierarchy_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Parent Asset Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_hierarchy_hierarchy_registry_id" ;
    cmm:cimAssociation "AssetContainer.Asset" .
cmm:AssetHierarchy.costAllocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation percentage"@en ;
    rdfs:comment "Percentage of OPEX and CAPEX costs allocated to this hierarchical relationship. Used when a child asset serves multiple parent facilities or network segments and costs must be apportioned. Value between 0.00 and 100.00. Supports regulatory cost allocation and rate case preparation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cost_allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:AssetHierarchy.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this hierarchy relationship record was first created in the system. Used for audit trail, data lineage tracking, and regulatory compliance. Immutable after initial creation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AssetContainer.createdDateTime .
cmm:AssetHierarchy.criticalityInheritedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality inherited flag"@en ;
    rdfs:comment "Indicates whether the child asset inherits the criticality classification from the parent asset in the hierarchy. True means child criticality is derived from parent (e.g., all equipment in a critical substation is critical). False means child has independent criticality assessment. Used for risk-based maintenance prioritization and outage impact analysis."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "criticality_inherited_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Inherited Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetHierarchy.depth a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depth"@en ;
    rdfs:comment "Total depth of the hierarchy tree from this relationship to the deepest leaf node. Used for hierarchy complexity analysis and query optimization. Updated when child relationships are added or removed."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:int ;
    cmm:physicalColumn "depth" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hierarchy Depth" ;
    cmm:cimDatatype "Integer" .
cmm:AssetHierarchy.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this hierarchical relationship ended or was superseded. Null for currently active relationships. Supports historical hierarchy reconstruction for regulatory reporting, asset lifecycle analysis, and audit trails."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:AssetHierarchy.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this hierarchical relationship became active. Supports temporal hierarchy tracking for asset relocations, network reconfigurations, and organizational restructuring. Used for point-in-time hierarchy queries and historical CAPEX/OPEX roll-up."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:AssetHierarchy.functionalLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional location code"@en ;
    rdfs:comment "Structured functional location identifier from the enterprise asset management system representing the hierarchical path (e.g., NORTH-SUB132-BAY03-CB01). Aligns with SAP S/4HANA Plant Maintenance functional location structure and Ventyx Asset Suite location hierarchy. Used for work order assignment, maintenance planning, and cost center allocation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Location Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.geographicZoneCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic zone code"@en ;
    rdfs:comment "Geographic or service territory zone identifier for the hierarchical relationship. Used for regional reporting, storm response planning, mutual aid coordination, and geographic cost allocation. Aligns with GIS-based service territory boundaries."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "geographic_zone_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Zone Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.hierarchyLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy level"@en ;
    rdfs:comment "Numeric level in the hierarchy tree structure where level 1 is the top-most parent (e.g., network segment, region) and higher numbers represent deeper nesting (e.g., level 5 might be a component within equipment within a bay within a substation within a zone). Supports depth-based queries and roll-up aggregations."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:int ;
    cmm:physicalColumn "hierarchy_level" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hierarchy Level" ;
    cmm:cimDatatype "Integer" .
cmm:AssetHierarchy.hierarchyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hierarchy type"@en ;
    rdfs:comment "Classification of the hierarchical relationship type. Functional location represents organizational structure (e.g., substation > bay > equipment). Electrical connectivity represents electrical network topology. Linear asset represents sequential physical assets (e.g., transmission line spans). Spatial containment represents physical location nesting. Logical grouping represents business-defined asset groups. System subsystem represents system decomposition."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "hierarchy_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Hierarchy Type" ;
    cmm:validValues "functional_location|electrical_connectivity|linear_asset|spatial_containment|logical_grouping|system_subsystem" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AssetContainer.type .
cmm:AssetHierarchy.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when this hierarchy relationship record was last modified. Updated whenever any attribute changes. Used for audit trail, change detection, and incremental data processing."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AssetHierarchy.maintenanceResponsibilityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance responsibility code"@en ;
    rdfs:comment "Code identifying the organizational unit or crew responsible for maintenance of assets in this hierarchical relationship. Used for work order routing, preventive maintenance scheduling, and O&M cost tracking. May differ from parent asset responsibility for shared or outsourced maintenance scenarios."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_responsibility_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Responsibility Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.networkSegmentCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network segment code"@en ;
    rdfs:comment "Business identifier for the top-level network segment or zone in the hierarchy (e.g., Northern Transmission Zone, Metro Distribution Area). Used for regulatory reporting by network segment, RAB valuation aggregation, and CAPEX/OPEX planning at the network level."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_segment_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Segment Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.outageImpactPropagationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage impact propagation flag"@en ;
    rdfs:comment "Indicates whether an outage of the parent asset automatically impacts the child asset in this hierarchical relationship. True means child is dependent on parent (e.g., feeder outage when substation is out). False means child can operate independently. Used for outage management, customer impact analysis, and SAIDI/SAIFI calculation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "outage_impact_propagation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Impact Propagation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetHierarchy.ownershipPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership percentage"@en ;
    rdfs:comment "Percentage of ownership or allocation of the child asset to this parent relationship. Used for jointly-owned assets, shared facilities, or cost allocation scenarios where a single asset may have multiple parent relationships with fractional ownership. Value between 0.00 and 100.00. Null for full ownership (100%)."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ownership_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ownership Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:AssetHierarchy.path a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "path"@en ;
    rdfs:comment "Materialized path representation of the full hierarchical lineage from root to this relationship (e.g., /REGION_NORTH/ZONE_132KV/SUB_NORTHSIDE/BAY_03/). Enables efficient ancestor and descendant queries without recursive joins. Updated when hierarchy structure changes."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "path" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hierarchy Path" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.planningAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning area code"@en ;
    rdfs:comment "Integrated resource planning area or load zone identifier for the hierarchical relationship. Used for CAPEX planning, load forecasting aggregation, and IRP scenario modeling. Aligns with transmission planning zones and distribution planning areas."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "planning_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Area Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.rabAllocationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab allocation flag"@en ;
    rdfs:comment "Indicates whether this hierarchical relationship is used for RAB valuation roll-up and regulatory rate base calculations. True means the relationship is included in RAB aggregation. False means the relationship is excluded (e.g., non-regulated assets, assets under construction). Critical for regulatory financial reporting and rate case preparation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_allocation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Allocation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetHierarchy.relationshipNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship notes"@en ;
    rdfs:comment "Free-text notes documenting special conditions, exceptions, or business context for this hierarchical relationship. May include reasons for non-standard configurations, temporary arrangements during capital projects, or regulatory reporting exceptions."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "relationship_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Relationship Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AssetHierarchy.relationshipSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship sequence"@en ;
    rdfs:comment "Ordinal position of the child asset among siblings under the same parent. Used for ordered hierarchies such as linear assets (transmission tower sequence along a line) or bay numbering within a substation. Null for unordered hierarchies."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:int ;
    cmm:physicalColumn "relationship_sequence" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relationship Sequence Number" ;
    cmm:cimDatatype "Integer" .
cmm:AssetHierarchy.relationshipStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "relationship status"@en ;
    rdfs:comment "Current lifecycle status of the hierarchical relationship. Active indicates the relationship is currently in effect. Inactive indicates the relationship has been terminated. Pending indicates a planned future relationship. Superseded indicates the relationship was replaced by a newer configuration. Planned indicates a relationship scheduled for future capital projects."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "relationship_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Relationship Status" ;
    cmm:validValues "active|inactive|pending|superseded|planned" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.scadaAggregationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada aggregation flag"@en ;
    rdfs:comment "Indicates whether SCADA measurements from child assets are aggregated to the parent level in this hierarchy. True means real-time data is rolled up (e.g., substation total load from individual feeders). False means no aggregation. Used for EMS and DMS real-time monitoring and control."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_aggregation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Aggregation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetHierarchy.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Identifier of the operational system of record that is the authoritative source for this hierarchy relationship (e.g., VENTYX_ASSET_SUITE, SAP_PM, ARCGIS_UTILITY_NETWORK). Used for data lineage tracking, reconciliation, and master data management. Critical for multi-system integration scenarios."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.sourceSystemRecordCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record code"@en ;
    rdfs:comment "Primary key or unique identifier of this hierarchy relationship record in the source operational system. Used for bidirectional traceability, data synchronization, and issue resolution. Enables drill-back to source system for detailed investigation."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:AssetHierarchy.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts for electrical connectivity hierarchies. Represents the voltage class of the hierarchical relationship (e.g., 500kV transmission, 132kV sub-transmission, 11kV distribution). Used for network topology analysis and voltage-based asset segmentation. Null for non-electrical hierarchies."@en ;
    rdfs:domain cmm:AssetHierarchy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV - Kilovolt)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:AssetClass a owl:Class ;
    rdfs:label "Asset Class"@en ;
    rdfs:comment "Reference classification taxonomy for utility asset types defining asset class codes, asset category (generation, transmission, distribution, metering, fleet, facility), voltage class, technology type (CCGT, wind turbine, overhead line, underground cable, power transformer, circuit breaker, etc.), expected useful life, standard depreciation method, and applicable NERC/IEC/IEEE standards. Drives depreciation schedules, maintenance strategies, and regulatory reporting groupings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AssetInfo ;
    cmm:cimExtends cim:AssetInfo ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.asset_registry ;
    cmm:physicalTable "utility_cmm_silver.asset.class" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "ISO 14224; Ventyx Asset Suite — Asset Class / IEC 61968 AssetInfo" ;
    cmm:sourceObject "energy_utilities_ecm.asset.class" ;
    owl:hasKey ( cmm:AssetClass.classId ) .

cmm:AssetClass.classId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "class id"@en ;
    rdfs:comment "Unique identifier for the asset class record. Primary key."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:long ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Class Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:AssetClass.standardMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "standard material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Asset classes define standard material types for procurement planning and inventory stocking strategies. Utilities standardize materials by asset class for economies of scale and interoperability—crit"@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "standard_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Standard Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_class_standard_material_master_id" ;
    cmm:cimAssociation "AssetInfo.ErpItemMaster" .
cmm:AssetClass.annualOmCostPerUnitUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual om cost per unit usd"@en ;
    rdfs:comment "Standard annual Operations and Maintenance cost per asset unit in this class. Includes routine maintenance, inspections, and minor repairs. Used for OPEX budgeting and lifecycle cost analysis."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_om_cost_per_unit_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Operations and Maintenance (O&M) Cost Per Unit (USD - United States Dollar)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AssetClass.assetCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset category"@en ;
    rdfs:comment "High-level functional category of the asset class within the utility value chain. Determines applicable regulatory frameworks and operational management systems. Reference-value candidates: generation|transmission|distribution|metering|fleet|facility|substation|protection|scada."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Category" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.assetClassCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class code"@en ;
    rdfs:comment "Standardized alphanumeric code uniquely identifying the asset class within the utility's asset taxonomy. Used for regulatory reporting and financial accounting groupings."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,12}$" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.assetClassName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset class name"@en ;
    rdfs:comment "Full descriptive name of the asset class (e.g., 'Combined Cycle Gas Turbine', 'Power Transformer 230kV', 'Underground Distribution Cable')."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_class_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Class Name" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.assetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset type"@en ;
    rdfs:comment "Specific technology or equipment type within the asset category (e.g., 'CCGT', 'Wind Turbine', 'Overhead Line', 'Underground Cable', 'Circuit Breaker', 'Relay')."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Type" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.capacityRatingMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity rating mw"@en ;
    rdfs:comment "Nameplate capacity rating in megawatts for generation assets or power handling capacity for transmission/distribution equipment. Null for non-power assets."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_rating_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Rating (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AssetClass.capitalExpenditureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital expenditure flag"@en ;
    rdfs:comment "Indicates whether acquisition of assets in this class is typically capitalized (true) or expensed as Operations and Maintenance (OPEX) (false) per accounting policies."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "capital_expenditure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.classStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "class status"@en ;
    rdfs:comment "Current lifecycle status of this asset class definition in the utility's asset taxonomy. Only active classes are available for new asset registration."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "class_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Asset Class Status" ;
    cmm:validValues "active|inactive|deprecated|proposed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AssetInfo.status .
cmm:AssetClass.conditionAssessmentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition assessment method"@en ;
    rdfs:comment "Primary technique(s) used for condition-based health assessment of assets in this class. Supports predictive maintenance and asset replacement prioritization. Reference-value candidates: visual_inspection|diagnostic_testing|dissolved_gas_analysis|thermography|partial_discharge|vibration_analysis|oil_analysis."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "condition_assessment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Assessment Method" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this asset class record was first created in the system. Supports audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AssetInfo.createdDateTime .
cmm:AssetClass.criticalityRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality rating"@en ;
    rdfs:comment "Standard criticality classification for assets in this class based on impact to grid reliability, customer service, and safety. Influences maintenance prioritization and spare parts stocking."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Rating" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.cybersecurityClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cybersecurity classification"@en ;
    rdfs:comment "NERC Critical Infrastructure Protection (CIP) cybersecurity impact classification for assets in this class. Determines required cyber controls and monitoring."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "cybersecurity_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cybersecurity Classification" ;
    cmm:validValues "high_impact|medium_impact|low_impact|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Standard accounting depreciation method applied to assets in this class for financial reporting and Regulatory Asset Base (RAB) valuation."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|sum_of_years_digits|units_of_production" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.distributedEnergyResourceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distributed energy resource flag"@en ;
    rdfs:comment "Indicates whether assets in this class are Distributed Energy Resources requiring integration with Distributed Energy Resource Management System (DERMS) and Advanced Distribution Management System (ADMS)."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "distributed_energy_resource_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date when this asset class definition became effective for use in asset registry and capital planning. Supports historical asset classification tracking."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:AssetClass.environmentalImpactCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "environmental impact category"@en ;
    rdfs:comment "Classification of potential environmental impact from operation or failure of assets in this class. Drives EPA compliance requirements and environmental monitoring protocols."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "environmental_impact_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Environmental Impact Category" ;
    cmm:validValues "high|medium|low|none" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.expectedUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expected useful life years"@en ;
    rdfs:comment "Standard expected service life in years for this asset class. Used for depreciation calculations, capital planning, and replacement forecasting."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:int ;
    cmm:physicalColumn "expected_useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Expected Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:AssetClass.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date when this asset class definition was retired or superseded. Null for currently active asset classes. Supports asset taxonomy version control."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:AssetClass.failureModeProfile a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure mode profile"@en ;
    rdfs:comment "Typical failure modes and mechanisms for assets in this class (e.g., 'insulation degradation', 'mechanical wear', 'corrosion'). Informs reliability-centered maintenance strategies."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_mode_profile" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Mode Profile" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for capitalization and depreciation reporting. Maps asset class to regulatory accounting categories."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:valuePattern "^[0-9]{3,6}$" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.gisLayerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gis layer name"@en ;
    rdfs:comment "Standard GIS feature class or layer name in Esri ArcGIS Utility Network where assets of this class are spatially represented for network modeling and outage analysis."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "gis_layer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Geographic Information System (GIS) Layer Name" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:AssetClass.gridModernizationCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid modernization category"@en ;
    rdfs:comment "Classification of assets in this class within utility grid modernization and smart grid investment programs. Used for capital planning and regulatory cost recovery filings."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "grid_modernization_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grid Modernization Category" ;
    cmm:validValues "advanced_metering|distribution_automation|grid_sensors|energy_storage|ev_infrastructure|legacy" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.hazardousMaterialFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazardous material flag"@en ;
    rdfs:comment "Indicates whether assets in this class contain or use hazardous materials (e.g., PCBs in transformers, SF6 in switchgear) requiring special handling and disposal procedures."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "hazardous_material_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazardous Material Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.iecStandardReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iec standard reference"@en ;
    rdfs:comment "Applicable IEC international standard(s) governing design, testing, and operation of assets in this class (e.g., 'IEC 60076' for power transformers)."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "iec_standard_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "International Electrotechnical Commission (IEC) Standard Reference" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.ieeeStandardReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ieee standard reference"@en ;
    rdfs:comment "Applicable IEEE standard(s) for equipment specifications, testing, and maintenance practices (e.g., 'IEEE C57.12.00' for transformers)."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "ieee_standard_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Institute of Electrical and Electronics Engineers (IEEE) Standard Reference" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.inspectionFrequencyMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection frequency months"@en ;
    rdfs:comment "Standard interval in months between scheduled inspections for assets in this class. Null if inspection frequency is condition-based rather than time-based."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:int ;
    cmm:physicalColumn "inspection_frequency_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Frequency (Months)" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:AssetClass.interoperabilityStandard a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interoperability standard"@en ;
    rdfs:comment "Communication protocol or interoperability standard for assets in this class (e.g., 'DNP3', 'IEC 61850', 'Modbus', 'IEEE 2030.5'). Ensures integration with utility control systems."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "interoperability_standard" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interoperability Standard" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this asset class record. Supports change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AssetClass.maintenanceStrategy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance strategy"@en ;
    rdfs:comment "Standard maintenance approach for assets in this class. Drives work order scheduling, inspection intervals, and Operations and Maintenance (O&M) cost planning."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_strategy" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Strategy" ;
    cmm:validValues "preventive|predictive|condition_based|run_to_failure|reliability_centered" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.manufacturerDiversityRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer diversity required flag"@en ;
    rdfs:comment "Indicates whether reliability standards or utility policy require multiple manufacturers for assets in this class to mitigate common-mode failure risk."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "manufacturer_diversity_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Manufacturer Diversity Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.meanTimeBetweenFailuresHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mean time between failures hours"@en ;
    rdfs:comment "Industry-standard or utility-specific average operating hours between failures for assets in this class. Used for reliability modeling and spare parts planning."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mean_time_between_failures_hours" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mean Time Between Failures (MTBF) Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:AssetClass.meanTimeToRepairHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mean time to repair hours"@en ;
    rdfs:comment "Average time in hours required to restore an asset in this class to service following a failure. Includes diagnosis, parts procurement, repair, and testing time."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mean_time_to_repair_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mean Time To Repair (MTTR) Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:AssetClass.nercAssetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc asset type"@en ;
    rdfs:comment "NERC-defined asset type classification for bulk electric system reliability reporting and Critical Infrastructure Protection (CIP) compliance."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Asset Type" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.obsolescenceRiskRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obsolescence risk rating"@en ;
    rdfs:comment "Assessment of technology obsolescence and spare parts availability risk for assets in this class. High risk indicates limited vendor support or discontinued product lines."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "obsolescence_risk_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Obsolescence Risk Rating" ;
    cmm:validValues "high|medium|low|none" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether assets in this class are eligible for inclusion in the Regulatory Asset Base for rate recovery and Return on Equity (ROE) calculation."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.renewableEnergyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable energy flag"@en ;
    rdfs:comment "Indicates whether assets in this class are renewable energy generation or Distributed Energy Resource (DER) equipment eligible for Renewable Energy Certificate (REC) generation and Renewable Portfolio Standard (RPS) compliance."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "renewable_energy_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.replacementLeadTimeMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replacement lead time months"@en ;
    rdfs:comment "Typical procurement and installation lead time in months for new assets in this class. Critical for capital project planning and long-lead equipment identification."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:int ;
    cmm:physicalColumn "replacement_lead_time_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Replacement Lead Time (Months)" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:AssetClass.safetyClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety classification"@en ;
    rdfs:comment "Primary safety hazard category for work on assets in this class. Determines required safety training, personal protective equipment (PPE), and work clearance procedures."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Classification" ;
    cmm:validValues "high_voltage|confined_space|elevated_work|heavy_equipment|standard" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.scadaMonitoringRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada monitoring required flag"@en ;
    rdfs:comment "Indicates whether assets in this class require real-time SCADA monitoring and integration with Energy Management System (EMS) or Distribution Management System (DMS)."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_monitoring_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Monitoring Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AssetClass.sparePartsStockingStrategy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts stocking strategy"@en ;
    rdfs:comment "Standard inventory management approach for spare parts supporting assets in this class. Balances inventory carrying costs against outage risk and restoration time."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "spare_parts_stocking_strategy" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Spare Parts Stocking Strategy" ;
    cmm:validValues "critical_spare|insurance_spare|consignment|just_in_time|no_stock" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.standardUnitCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "standard unit cost usd"@en ;
    rdfs:comment "Baseline unit acquisition cost in USD for assets in this class. Used for capital budgeting, business case analysis, and Regulatory Asset Base (RAB) valuation. Excludes installation and commissioning costs."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "standard_unit_cost_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Standard Unit Cost (USD - United States Dollar)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AssetClass.technologyGeneration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technology generation"@en ;
    rdfs:comment "Technology vintage or generation for assets in this class (e.g., 'Gen 1', 'Gen 2', 'Legacy', 'Current', 'Next-Gen'). Tracks technology evolution and obsolescence risk."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:string ;
    cmm:physicalColumn "technology_generation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technology Generation" ;
    cmm:cimDatatype "String" .
cmm:AssetClass.voltageClassKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage class kv"@en ;
    rdfs:comment "Nominal voltage rating in kilovolts for electrical assets. Null for non-electrical assets (fleet, facilities). Determines applicable safety and maintenance protocols."@en ;
    rdfs:domain cmm:AssetClass ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_class_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Voltage Class (kV - Kilovolt)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .

cmm:WorkOrder a owl:Class ;
    rdfs:label "Work Order"@en ;
    rdfs:comment "Core transactional record for all planned and unplanned maintenance activities on utility assets. Captures work order number, type (preventive, corrective, emergency, inspection, capital project), priority, originating asset, work description, assigned crew/contractor, scheduled start and completion dates, actual start and completion dates, labor hours, material costs, total O&M cost, work order status, safety permit references, and closure codes. Sourced from Ventyx Asset Suite Work Management module and SAP S/4HANA Plant Maintenance (PM) orders."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Work ;
    cmm:cimExactMatch cim:Work ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.work_order" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "BaseWork.WorkLocation" ;
    cmm:standardReference "IEC 61968-6; Ventyx Asset Suite — Work Order / SAP PM Order" ;
    cmm:sourceObject "energy_utilities_ecm.asset.work_order" ;
    owl:hasKey ( cmm:WorkOrder.workOrderId ) .

cmm:WorkOrder.workOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order id"@en ;
    rdfs:comment "Unique identifier for the work order. Primary key for the work order entity."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:cimDatatype "Integer" .
cmm:WorkOrder.assetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset registry"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Every work order is executed against a specific asset. This is the most fundamental FK in any EAM system — work orders without asset references are unroutable and uncosted."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_asset_registry_id" ;
    cmm:cimAssociation "Work.Asset" .
cmm:WorkOrder.assignedCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assigned crew"@en ;
    rdfs:comment "Reference to the internal utility crew or work group assigned to execute this work order. May be null if work is assigned to an external contractor."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "assigned_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned Crew ID" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_assigned_crew_id" ;
    cmm:cimAssociation "Work.Crew" .
cmm:WorkOrder.complianceObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Work orders are frequently driven by regulatory compliance obligations (NERC CIP maintenance requirements, environmental permit conditions, safety inspection mandates). Compliance-driven maintenance s"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "compliance_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Obligation Id (Foreign Key)" ;
    cmm:sourceColumn "obligation_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_compliance_obligation_id" ;
    cmm:cimAssociation "Work.Document" .
cmm:WorkOrder.contractorWorker a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contractor worker"@en ;
    rdfs:comment "Reference to the external contractor or service provider assigned to execute this work order. May be null if work is performed by internal crews."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:ContractorWorker ;
    cmm:physicalColumn "contractor_worker_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned Contractor ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_contractor_worker_id" ;
    cmm:cimAssociation "Work.Person" .
cmm:WorkOrder.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Financial cost center code to which this work order cost is allocated. Used for departmental budgeting, OPEX vs CAPEX classification, and regulatory reporting."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_cost_center_id" ;
    cmm:cimAssociation "Work.Organisation" .
cmm:WorkOrder.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Maintenance and repair work orders issued against DER assets for O&M cost tracking, warranty claim documentation, and reliability metrics (SAIDI/SAIFI). Critical for performance guarantee compliance i"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_der_registry_id" ;
    cmm:cimAssociation "Work.PowerElectronicsConnection" .
cmm:WorkOrder.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the supervisor or manager responsible for approving and overseeing this work order. Used for approval workflow and accountability."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisor ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_employee_id" ;
    cmm:cimAssociation "Work.ErpPersonnel" .
cmm:WorkOrder.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Reference to the distribution or transmission circuit affected by this work order. Used for outage impact analysis and load transfer planning."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Circuit ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_feeder_id" ;
    cmm:cimAssociation "Work.Feeder" .
cmm:WorkOrder.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "General ledger account code for financial posting of work order costs. Aligns with FERC Uniform System of Accounts for utility financial reporting."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_gl_account_id" ;
    cmm:cimAssociation "Work.ErpChartOfAccounts" .
cmm:WorkOrder.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Work orders are created to perform interconnection-related construction (meter installation, service upgrades, POI modifications) and inspection support activities. Essential for tracking utility labo"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_interconnection_application_id" ;
    cmm:cimAssociation "Work.Request" .
cmm:WorkOrder.maintenancePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance plan"@en ;
    rdfs:comment "FK to asset.maintenance_plan.maintenance_plan_id — Preventive work orders are generated from maintenance plans. This FK enables tracking of PM compliance rates and plan execution history."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:MaintenancePlan ;
    cmm:physicalColumn "maintenance_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_maintenance_plan_id" ;
    cmm:cimAssociation "Work.Procedure" .
cmm:WorkOrder.materialPurchaseOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material purchase order"@en ;
    rdfs:comment "Foreign key linking to supply.purchase_order. Business justification: Work orders often trigger direct material procurement for non-stock items or emergency purchases. Links work order to originating PO for cost tracking, capex/opex classification, and regulatory cost r"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:PurchaseOrder ;
    cmm:physicalColumn "material_purchase_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Purchase Order Id (Foreign Key)" ;
    cmm:sourceColumn "purchase_order_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_material_purchase_order_id" ;
    cmm:cimAssociation "Work.ErpPurchaseOrder" .
cmm:WorkOrder.parentWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent work order"@en ;
    rdfs:comment "Reference to a parent work order if this is a child or sub-work order. Used for complex projects broken into multiple work packages."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "parent_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Parent Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_parent_work_order_id" ;
    cmm:cimAssociation "Work.Work" .
cmm:WorkOrder.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the utility asset (generation unit, transformer, transmission tower, distribution pole, switchgear, protection relay, substation equipment, fleet vehicle, or facility) that is the subject of this work order."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_registry_id" ;
    cmm:cimAssociation "Work.Asset" .
cmm:WorkOrder.toMaintenancePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to maintenance plan"@en ;
    rdfs:comment "FK to asset.maintenance_plan.maintenance_plan_id — Preventive maintenance work orders are auto-generated from maintenance plans. The FK traces which plan triggered the work order for compliance tracking and schedule adherence reporting."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:MaintenancePlan ;
    cmm:physicalColumn "to_maintenance_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_to_maintenance_plan_id" ;
    cmm:cimAssociation "Work.Procedure" .
cmm:WorkOrder.transmissionLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission line"@en ;
    rdfs:comment "Foreign key linking to transmission.line. Business justification: Maintenance work orders on transmission lines (conductor replacement, tower repair, insulator replacement, vegetation management) require direct linkage to the specific line for work planning, outage"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:TransmissionLine ;
    cmm:physicalColumn "transmission_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Line Id (Foreign Key)" ;
    cmm:sourceColumn "line_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_transmission_line_id" ;
    cmm:cimAssociation "Work.Line" .
cmm:WorkOrder.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Work orders for transmission substation maintenance (transformer servicing, breaker testing, relay calibration) require direct linkage to the specific transmission substation for work scheduling, outa"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_transmission_substation_id" ;
    cmm:cimAssociation "Work.Substation" .
cmm:WorkOrder.workMaintenancePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work maintenance plan"@en ;
    rdfs:comment "Reference to the preventive maintenance schedule or plan that generated this work order. Used for PM compliance tracking and maintenance strategy optimization."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range cmm:MaintenancePlan ;
    cmm:physicalColumn "work_maintenance_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preventive Maintenance (PM) Schedule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_work_order_work_maintenance_plan_id" ;
    cmm:cimAssociation "Work.Procedure" .
cmm:WorkOrder.actualCompletionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion timestamp"@en ;
    rdfs:comment "Actual date and time when work was completed and asset returned to service. Used for outage duration reporting, SAIDI/SAIFI calculation, and maintenance cycle analysis."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_completion_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkOrder.actualStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start timestamp"@en ;
    rdfs:comment "Actual date and time when work commenced on site. Used for labor tracking, outage duration calculation, and performance analysis."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "actual_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkOrder.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "Name of the person who approved the work order for execution. Used for audit trail and authorization verification."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved By" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Date and time when the work order was approved for execution. Used for approval cycle time analysis and audit trail."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkOrder.asset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Every work order must reference the asset it is performed against. This is the most fundamental FK in asset management — without it, maintenance costs cannot be attributed to assets, and asset history"@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:WorkOrder.capexFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex flag"@en ;
    rdfs:comment "Indicates whether this work order represents capital expenditure (true) or operational expenditure (false). Capital work orders contribute to RAB valuation and depreciation schedules."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "capex_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkOrder.closedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closed timestamp"@en ;
    rdfs:comment "Date and time when the work order was administratively closed and finalized. Used for cycle time analysis and completion reporting."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "closed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkOrder.closureCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure code"@en ;
    rdfs:comment "Standardized code indicating the reason and manner of work order closure. Used for completion analysis, deferral tracking, and maintenance effectiveness metrics."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "closure_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closure Code" ;
    cmm:validValues "completed_as_planned|completed_with_variance|deferred|cancelled_duplicate|cancelled_not_required|cancelled_no_access" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.closureNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure notes"@en ;
    rdfs:comment "Detailed narrative notes entered by the crew or supervisor upon work order completion, documenting work performed, findings, issues encountered, and recommendations for future maintenance."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "closure_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Closure Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:WorkOrder.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the work order record was first created in the system. Used for work order aging analysis and backlog tracking."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Work.createdDateTime .
cmm:WorkOrder.equipmentCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment cost"@en ;
    rdfs:comment "Cost of specialized equipment, tools, and machinery rental or usage allocated to this work order. Includes bucket trucks, cranes, diagnostic equipment, and specialized tooling."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "equipment_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WorkOrder.failureMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure mode"@en ;
    rdfs:comment "For corrective and emergency work orders, describes the observed failure or defect mode (e.g., insulation breakdown, mechanical wear, corrosion, overheating, control malfunction) that triggered the work order."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Mode" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.laborCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor cost"@en ;
    rdfs:comment "Total labor cost including wages, benefits, and contractor fees for this work order. Used for O&M cost tracking and rate case justification."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WorkOrder.laborHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor hours"@en ;
    rdfs:comment "Total labor hours expended on this work order across all crew members and contractors. Used for OPEX tracking, productivity analysis, and cost allocation."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Labor Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:WorkOrder.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the work site in decimal degrees. Used for crew dispatch optimization, GIS integration, and spatial analysis."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:WorkOrder.locationDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location description"@en ;
    rdfs:comment "Textual description of the work site location including street address, nearest intersection, substation name, or geographic landmark to assist crew dispatch and navigation."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Location Description" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the work site in decimal degrees. Used for crew dispatch optimization, GIS integration, and spatial analysis."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:WorkOrder.materialCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material cost"@en ;
    rdfs:comment "Total cost of materials, spare parts, and consumables used in this work order. Sourced from inventory withdrawals and purchase orders. Used for OPEX and CAPEX tracking."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "material_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Material Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WorkOrder.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when the work order record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:WorkOrder.outageRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage required flag"@en ;
    rdfs:comment "Indicates whether this work order requires a planned outage or de-energization of the asset or circuit. Used for outage coordination and customer notification."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "outage_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkOrder.priority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Business priority level indicating urgency and resource allocation precedence. Critical for emergency outages, high for reliability-impacting work, medium for routine preventive maintenance, low for deferred work."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:WorkOrder.regulatoryReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable flag"@en ;
    rdfs:comment "Indicates whether this work order must be reported to regulatory authorities (PUC, NERC, FERC) due to safety incidents, major equipment failures, or compliance events."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkOrder.requesterContact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requester contact"@en ;
    rdfs:comment "Phone number or email address of the work order requester for follow-up communication and status updates."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "requester_contact" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requester Contact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.requesterName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requester name"@en ;
    rdfs:comment "Name of the person or department that originated the work order request. Used for accountability and follow-up communication."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "requester_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requester Name" ;
    cmm:cimDatatype "String" .
cmm:WorkOrder.safetyPermitNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety permit number"@en ;
    rdfs:comment "Reference number for the safety work permit or clearance authorization required before work can commence. Ensures compliance with OSHA and utility safety protocols."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_permit_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Safety Permit Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WorkOrder.scheduledCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled completion date"@en ;
    rdfs:comment "Planned date when work is scheduled to be completed. Used for outage window planning and service restoration commitments."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:WorkOrder.scheduledStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled start date"@en ;
    rdfs:comment "Planned date when work is scheduled to begin. Used for resource planning, outage coordination, and customer notification."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Start Date" ;
    cmm:cimDatatype "Date" .
cmm:WorkOrder.toAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Every work order is raised against a specific asset. This is the most fundamental transactional-to-master FK in any EAM system. Without it, work orders are orphaned."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:WorkOrder.totalCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total cost"@en ;
    rdfs:comment "Total cost of the work order including labor, materials, equipment, and contractor fees. Used for OPEX reporting, RAB valuation, and regulatory rate case filings."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Operations and Maintenance (O&M) Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:WorkOrder.warrantyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty flag"@en ;
    rdfs:comment "Indicates whether this work order is covered under manufacturer or contractor warranty. Used for cost recovery and warranty claim tracking."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "warranty_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:WorkOrder.workOrderDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order description"@en ;
    rdfs:comment "Detailed narrative description of the work to be performed, including scope, specific tasks, safety considerations, and any special instructions for the crew or contractor."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Work Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:WorkOrder.workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order number"@en ;
    rdfs:comment "Externally visible business identifier for the work order, used for tracking and communication across systems and with contractors."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Number" ;
    cmm:valuePattern "^WO-[0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WorkOrder.workOrderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order status"@en ;
    rdfs:comment "Current lifecycle state of the work order. Draft (created but not approved), approved (authorized for scheduling), scheduled (crew assigned and date set), in_progress (work underway), on_hold (temporarily suspended), completed (work finished pending closure), closed (administratively finalized), cancelled (work not performed). Reference-value candidates: draft|approved|scheduled|in_progress|on_hold|completed|closed|cancelled."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Work.status .
cmm:WorkOrder.workOrderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order type"@en ;
    rdfs:comment "Classification of the work order by maintenance strategy: preventive (scheduled maintenance), corrective (repair of known defect), emergency (unplanned urgent repair), inspection (condition assessment), capital_project (major upgrade or replacement), or condition_assessment (detailed asset evaluation)."@en ;
    rdfs:domain cmm:WorkOrder ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Work Order Type" ;
    cmm:validValues "preventive|corrective|emergency|inspection|capital_project|condition_assessment" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Work.type .

cmm:MaintenancePlan a owl:Class ;
    rdfs:label "Maintenance Plan"@en ;
    rdfs:comment "Preventive and predictive maintenance strategy definition for an asset class or individual asset. Captures maintenance plan type (time-based, condition-based, usage-based), maintenance cycle (e.g., annual, 5-year), task list reference, required materials, estimated labor hours, regulatory compliance driver (e.g., NERC FAC-003, OSHA), last execution date, next due date, and plan active status. Drives automatic work order generation in Ventyx Asset Suite and SAP PM."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Procedure ;
    cmm:cimCloseMatch cim:Procedure ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.maintenance_plan" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-6; RCM (SAE JA1011); Ventyx Asset Suite — Preventive Maintenance Plan / SAP PM Maintenance Plan" ;
    cmm:sourceObject "energy_utilities_ecm.asset.maintenance_plan" ;
    owl:hasKey ( cmm:MaintenancePlan.maintenancePlanId ) .

cmm:MaintenancePlan.maintenancePlanId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance plan id"@en ;
    rdfs:comment "Unique identifier for the maintenance plan record. Primary key."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "maintenance_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Maintenance Plan ID" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.assetClass a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "FK to asset.asset_class.asset_class_id — Maintenance plans are often defined at the asset class level (e.g., all 132kV power transformers get DGA every 2 years). This FK enables class-level maintenance strategy inheritance."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "asset_class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_asset_class_id" ;
    cmm:cimAssociation "Procedure.AssetInfo" .
cmm:MaintenancePlan.assetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset registry"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Maintenance plans are defined for specific assets or asset classes. The asset-level FK enables automatic work order generation for the correct asset."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_asset_registry_id" ;
    cmm:cimAssociation "Procedure.Asset" .
cmm:MaintenancePlan.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Reference to the asset class or equipment category for which this maintenance plan is defined. Used for template-based maintenance strategies applied across multiple assets of the same type."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_class_id" ;
    cmm:cimAssociation "Procedure.AssetInfo" .
cmm:MaintenancePlan.complianceObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Maintenance plans implement regulatory requirements (NERC PRC-005 protection system maintenance, FERC gas pipeline integrity management, environmental permit conditions). Linking plans to obligations"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "compliance_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Obligation Id (Foreign Key)" ;
    cmm:sourceColumn "obligation_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_compliance_obligation_id" ;
    cmm:cimAssociation "Procedure.Document" .
cmm:MaintenancePlan.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Financial cost center to which maintenance costs (labor, materials, contractors) are charged. Used for OPEX tracking, departmental budgeting, and RAB (Regulatory Asset Base) cost allocation."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_cost_center_id" ;
    cmm:cimAssociation "Procedure.Organisation" .
cmm:MaintenancePlan.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Preventive maintenance schedules for DER equipment (inverter inspections, battery health checks, panel cleaning) required for warranty compliance, performance guarantee tracking in PPAs, and interconn"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_der_registry_id" ;
    cmm:cimAssociation "Procedure.PowerElectronicsConnection" .
cmm:MaintenancePlan.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Foreign key linking to distribution.transformer. Business justification: Transformer maintenance plans (oil sampling, dissolved gas analysis, thermography, load tap changer servicing) are mandated by IEEE/NETA standards and insurance requirements. Links preventive maintena"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Id (Foreign Key)" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_distribution_transformer_id" ;
    cmm:cimAssociation "Procedure.PowerTransformer" .
cmm:MaintenancePlan.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Preventive maintenance plans are organized by feeder for patrol inspections, vegetation management, reliability-centered maintenance programs, and regulatory compliance. Enables automated work order g"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_feeder_id" ;
    cmm:cimAssociation "Procedure.Feeder" .
cmm:MaintenancePlan.primaryMaintenanceEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary maintenance employee"@en ;
    rdfs:comment "Reference to the maintenance planner or engineer responsible for managing this maintenance plan, including plan updates, work order review, and execution oversight."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_maintenance_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Planner ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_primary_maintenance_employee_id" ;
    cmm:cimAssociation "Procedure.ErpPersonnel" .
cmm:MaintenancePlan.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the specific asset (generation unit, transformer, transmission tower, distribution pole, switchgear, protection relay, substation equipment, fleet vehicle, or facility) to which this maintenance plan applies. Links to the asset registry."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_registry_id" ;
    cmm:cimAssociation "Procedure.Asset" .
cmm:MaintenancePlan.responsibleCrew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible crew"@en ;
    rdfs:comment "Reference to the maintenance crew or work center assigned to execute work orders generated by this plan. Used for resource capacity planning and crew scheduling."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "responsible_crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Crew ID" ;
    cmm:sourceColumn "crew_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_responsible_crew_id" ;
    cmm:cimAssociation "Procedure.Crew" .
cmm:MaintenancePlan.serviceSupplierContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service supplier contract"@en ;
    rdfs:comment "Foreign key linking to supply.supplier_contract. Business justification: Recurring maintenance services (vegetation management, transformer oil analysis, substation cleaning) are often contracted. Links maintenance plan to service contract for cost forecasting, contractor"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:SupplierContract ;
    cmm:physicalColumn "service_supplier_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Supplier Contract Id (Foreign Key)" ;
    cmm:sourceColumn "supplier_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_service_supplier_contract_id" ;
    cmm:cimAssociation "Procedure.Agreement" .
cmm:MaintenancePlan.standardMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "standard material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Preventive maintenance plans specify standard materials (oils, filters, consumables) for bill-of-materials planning and auto-generation of material requisitions. Essential for MRP planning, inventory"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "standard_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Standard Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_standard_material_master_id" ;
    cmm:cimAssociation "Procedure.ErpItemMaster" .
cmm:MaintenancePlan.transmissionLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission line"@en ;
    rdfs:comment "Foreign key linking to transmission.line. Business justification: Transmission line maintenance plans (patrol inspections, ROW clearing, structure inspections, conductor monitoring) are line-specific. Utilities schedule preventive maintenance by line for NERC compli"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:TransmissionLine ;
    cmm:physicalColumn "transmission_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Line Id (Foreign Key)" ;
    cmm:sourceColumn "line_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_transmission_line_id" ;
    cmm:cimAssociation "Procedure.Line" .
cmm:MaintenancePlan.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Preventive maintenance plans for substation equipment (transformer oil analysis, breaker testing, relay calibration, battery testing) are organized by substation. Utilities schedule and track maintena"@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_maintenance_plan_transmission_substation_id" ;
    cmm:cimAssociation "Procedure.Substation" .
cmm:MaintenancePlan.autoGenerateWorkOrderFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto generate work order flag"@en ;
    rdfs:comment "Indicates whether work orders are automatically created by the system when the maintenance plan becomes due (True) or require manual initiation by a planner (False)."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_generate_work_order_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Generate Work Order Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MaintenancePlan.complianceMandatoryFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance mandatory flag"@en ;
    rdfs:comment "Indicates whether this maintenance plan is legally or regulatorily mandated (True) or discretionary for asset optimization (False). Mandatory plans cannot be deferred without regulatory approval."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "compliance_mandatory_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Mandatory Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MaintenancePlan.conditionTriggerParameter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition trigger parameter"@en ;
    rdfs:comment "For condition-based maintenance plans, the specific asset health parameter or SCADA measurement that triggers maintenance (e.g., oil_dielectric_strength, vibration_amplitude, temperature_differential, partial_discharge_level). Empty for time-based plans."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "condition_trigger_parameter" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Trigger Parameter" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.conditionTriggerThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition trigger threshold"@en ;
    rdfs:comment "Numeric threshold value for the condition trigger parameter. When the monitored parameter exceeds (or falls below) this threshold, maintenance is triggered. Empty for time-based plans."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "condition_trigger_threshold" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Trigger Threshold" ;
    cmm:cimDatatype "Decimal" .
cmm:MaintenancePlan.conditionTriggerUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "condition trigger unit"@en ;
    rdfs:comment "Unit of measure for the condition trigger threshold (e.g., kV, ppm, mm/s, degrees_celsius, percent). Empty for time-based plans."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "condition_trigger_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Condition Trigger Unit of Measure" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this maintenance plan record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Procedure.createdDateTime .
cmm:MaintenancePlan.cycleIntervalUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle interval unit"@en ;
    rdfs:comment "Unit of measure for the maintenance interval: calendar units (days, weeks, months, years), operational hours, operational cycles, or energy production (MWh for generation assets). Reference-value candidates: days|weeks|months|years|hours|cycles|mwh."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_interval_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Cycle Interval Unit" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.cycleIntervalValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle interval value"@en ;
    rdfs:comment "Numeric value representing the maintenance interval (e.g., 12 for annual, 5 for five-year). Used in conjunction with cycle_interval_unit to calculate next due date."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "cycle_interval_value" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Cycle Interval Value" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.cycleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cycle type"@en ;
    rdfs:comment "Frequency or trigger pattern for maintenance execution. Time-based cycles are calendar-driven; on-condition cycles are triggered by asset health thresholds; on-demand cycles are manually initiated. Reference-value candidates: daily|weekly|monthly|quarterly|semi_annual|annual|biennial|five_year|ten_year|on_condition|on_demand."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "cycle_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Cycle Type" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date when this maintenance plan is scheduled to expire or be retired. Nullable for ongoing plans. Used for asset decommissioning or maintenance strategy transitions."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:MaintenancePlan.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date when this maintenance plan becomes active and begins generating work orders. Used for phased rollout of new maintenance strategies or asset commissioning."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:MaintenancePlan.estimatedContractorCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated contractor cost usd"@en ;
    rdfs:comment "Estimated cost of external contractor services required for maintenance execution, expressed in US dollars. Used for OPEX budgeting and procurement planning."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_contractor_cost_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Contractor Cost (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MaintenancePlan.estimatedLaborHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated labor hours"@en ;
    rdfs:comment "Estimated total labor hours required to complete all tasks defined in the maintenance plan. Used for crew scheduling, OPEX forecasting, and resource capacity planning."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_labor_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Labor Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:MaintenancePlan.estimatedMaterialCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated material cost usd"@en ;
    rdfs:comment "Estimated total cost of spare parts, consumables, and materials required for maintenance execution, expressed in US dollars. Used for OPEX budgeting and inventory planning."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_material_cost_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Material Cost (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:MaintenancePlan.functionalLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional location"@en ;
    rdfs:comment "Hierarchical location identifier in the asset management system representing the physical or logical location of the asset (e.g., substation, plant, transmission line section). Used for geographic and organizational reporting."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Location" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.lastExecutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last execution date"@en ;
    rdfs:comment "Date when maintenance activities under this plan were last completed. Used to calculate the next due date for time-based and usage-based maintenance cycles."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_execution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Execution Date" ;
    cmm:cimDatatype "Date" .
cmm:MaintenancePlan.lastExecutionWorkOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last execution work order number"@en ;
    rdfs:comment "Work order number of the most recent maintenance execution under this plan. Provides traceability to historical maintenance records and completion documentation."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_execution_work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Execution Work Order Number" ;
    cmm:valuePattern "^WO-[A-Z0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MaintenancePlan.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this maintenance plan record was most recently updated. Used for change tracking and audit compliance."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:MaintenancePlan.leadTimeDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lead time days"@en ;
    rdfs:comment "Number of days before the scheduled due date that the work order should be generated, allowing time for planning, material procurement, crew scheduling, and outage coordination."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "lead_time_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Lead Time (Days)" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.maintenanceStrategy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance strategy"@en ;
    rdfs:comment "High-level maintenance philosophy applied to the asset: preventive (scheduled), predictive (condition monitoring), reliability-centered (RCM analysis-driven), risk-based (prioritized by failure impact), or run-to-failure (no proactive maintenance)."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_strategy" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maintenance Strategy" ;
    cmm:validValues "preventive|predictive|reliability_centered|risk_based|run_to_failure" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.nextDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next due date"@en ;
    rdfs:comment "Calculated date when the next maintenance execution is scheduled or required. System-calculated based on last execution date, cycle interval, and usage/condition triggers."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Due Date" ;
    cmm:cimDatatype "Date" .
cmm:MaintenancePlan.nextScheduledWorkOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next scheduled work order number"@en ;
    rdfs:comment "Work order number of the upcoming maintenance execution that has been generated but not yet completed. Empty if no future work order has been created."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "next_scheduled_work_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Next Scheduled Work Order Number" ;
    cmm:valuePattern "^WO-[A-Z0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MaintenancePlan.outageRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage required flag"@en ;
    rdfs:comment "Indicates whether execution of this maintenance plan requires taking the asset out of service (True) or can be performed while the asset is energized or in standby (False). Critical for outage coordination and reliability planning."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "outage_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MaintenancePlan.planAssetClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan asset class"@en ;
    rdfs:comment "FK to asset.asset_class.asset_class_id — Maintenance plans are typically defined at the asset class level (all 132kV transformers get the same PM plan). This FK enables plan-to-class association."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "plan_asset_class" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.planDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan description"@en ;
    rdfs:comment "Detailed textual description of the maintenance plan objectives, scope, and special instructions. Provides context for planners and technicians executing the work."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Maintenance Plan Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:MaintenancePlan.planName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan name"@en ;
    rdfs:comment "Descriptive name of the maintenance plan for human identification and reporting purposes."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Maintenance Plan Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:MaintenancePlan.planNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan number"@en ;
    rdfs:comment "Business identifier for the maintenance plan, externally visible and used in work order generation and asset management reporting."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Maintenance Plan Number" ;
    cmm:valuePattern "^MP-[A-Z0-9]{8,12}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MaintenancePlan.planStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan status"@en ;
    rdfs:comment "Current lifecycle status of the maintenance plan. Active plans generate work orders automatically; suspended plans are temporarily paused; inactive plans are disabled but retained for historical reference; retired plans are archived."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Maintenance Plan Status" ;
    cmm:validValues "draft|active|suspended|inactive|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Procedure.status .
cmm:MaintenancePlan.planType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plan type"@en ;
    rdfs:comment "Classification of the maintenance strategy: time-based (calendar-driven), condition-based (triggered by asset condition thresholds), usage-based (driven by operational hours or cycles), predictive (AI/ML-driven forecasting), regulatory (compliance-mandated), or corrective (reactive repair)."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "plan_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Maintenance Plan Type" ;
    cmm:validValues "time_based|condition_based|usage_based|predictive|regulatory|corrective" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Procedure.type .
cmm:MaintenancePlan.planningPlantCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planning plant code"@en ;
    rdfs:comment "Organizational unit responsible for maintenance planning and execution. Aligns with SAP PM planning plant structure for multi-site utility operations."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "planning_plant_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planning Plant Code" ;
    cmm:valuePattern "^PP-[A-Z0-9]{4,8}$" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.priority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Business priority level for maintenance execution. Critical plans address safety or regulatory compliance; high priority plans prevent major outages; medium and low priority plans optimize asset performance and lifecycle cost."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Maintenance Plan Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:MaintenancePlan.regulatoryDriver a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory driver"@en ;
    rdfs:comment "Specific regulatory standard, code, or compliance requirement that mandates this maintenance plan (e.g., NERC FAC-003 Transmission Vegetation Management, NERC PRC-005 Protection System Maintenance, OSHA 1910.269 Electric Power Generation). Empty if not compliance-driven."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_driver" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Compliance Driver" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.safetyRequirements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety requirements"@en ;
    rdfs:comment "Specific safety protocols, personal protective equipment (PPE), lockout/tagout (LOTO) procedures, or clearance requirements mandated for maintenance execution under this plan. Ensures OSHA 1910.269 compliance."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "safety_requirements" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Requirements" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.schedulingWindowDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduling window days"@en ;
    rdfs:comment "Allowable time window (in days) after the due date within which maintenance can be performed without being considered overdue. Provides scheduling flexibility for resource optimization and outage coordination."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:int ;
    cmm:physicalColumn "scheduling_window_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduling Window (Days)" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.taskListReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "task list reference"@en ;
    rdfs:comment "Reference code to the detailed task list or work instruction document that defines the specific maintenance activities, inspection points, and procedures to be executed under this plan."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "task_list_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Task List Reference" ;
    cmm:valuePattern "^TL-[A-Z0-9]{6,10}$" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.toAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Maintenance plans are assigned to specific assets or asset classes. The FK to asset_registry enables plan-to-asset resolution for work order generation."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:MaintenancePlan.usageTriggerParameter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usage trigger parameter"@en ;
    rdfs:comment "For usage-based maintenance plans, the operational metric that triggers maintenance (e.g., operating hours for turbines, breaker operations for circuit breakers, MWh generated for generators). Empty for time-based and condition-based plans."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "usage_trigger_parameter" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Usage Trigger Parameter" ;
    cmm:validValues "operating_hours|start_stop_cycles|mwh_generated|breaker_operations|tap_changer_operations" ;
    cmm:cimDatatype "String" .
cmm:MaintenancePlan.usageTriggerThreshold a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "usage trigger threshold"@en ;
    rdfs:comment "Numeric threshold value for the usage trigger parameter. When cumulative usage since last maintenance reaches this threshold, maintenance is triggered. Empty for time-based and condition-based plans."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "usage_trigger_threshold" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Usage Trigger Threshold" ;
    cmm:cimDatatype "Decimal" .
cmm:MaintenancePlan.workOrderType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work order type"@en ;
    rdfs:comment "Classification of work orders automatically generated by this maintenance plan. Determines work order routing, approval workflows, and cost accounting treatment in Ventyx Asset Suite and SAP PM. Reference-value candidates: preventive_maintenance|predictive_maintenance|inspection|calibration|testing|overhaul|refurbishment."@en ;
    rdfs:domain cmm:MaintenancePlan ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_order_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Order Type" ;
    cmm:cimDatatype "String" .

cmm:FailureEvent a owl:Class ;
    rdfs:label "Failure Event"@en ;
    rdfs:comment "Records of asset failures, forced outages, and equipment breakdowns including failure date and time, failure mode (electrical, mechanical, thermal, insulation, corrosion, external damage), failure cause, affected asset, associated outage reference, repair action taken, root cause analysis findings, failure cost, and SAIDI/SAIFI impact contribution. Supports reliability-centered maintenance (RCM) analysis and NERC reliability reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:FailureEvent ;
    cmm:cimExactMatch cim:FailureEvent ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.failure_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "ISO 14224; NERC GADS; Ventyx Asset Suite — Failure Record / IEEE 762 Generating Unit Reliability" ;
    cmm:sourceObject "energy_utilities_ecm.asset.failure_event" ;
    owl:hasKey ( cmm:FailureEvent.failureEventId ) .

cmm:FailureEvent.failureEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure event id"@en ;
    rdfs:comment "Unique identifier for the asset failure event record. Primary key."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "failure_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Failure Event ID" ;
    cmm:cimDatatype "Integer" .
cmm:FailureEvent.assetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset registry"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Failure events must reference the failed asset for reliability analysis, MTBF calculations, and NERC reporting. Core FK for RCM analysis."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_asset_registry_id" ;
    cmm:cimAssociation "FailureEvent.Asset" .
cmm:FailureEvent.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: DER equipment failures (inverter trips, battery faults, turbine blade damage) tracked for reliability analysis, warranty claims, RPS compliance reporting, and NERC event reporting. Required for root c"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_der_registry_id" ;
    cmm:cimAssociation "FailureEvent.PowerElectronicsConnection" .
cmm:FailureEvent.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Foreign key linking to distribution.transformer. Business justification: Transformer failures are major reliability events requiring detailed tracking for warranty claims, manufacturer defect analysis, fleet health assessment, and replacement prioritization. Essential for"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Id (Foreign Key)" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_distribution_transformer_id" ;
    cmm:cimAssociation "FailureEvent.PowerTransformer" .
cmm:FailureEvent.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Foreign key linking to demand.dr_event. Business justification: Asset failures may be triggered by DR events (transformer overload during rapid load restoration, relay misoperation during curtailment) or cause DR event cancellation. Reliability engineers analyze c"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Dr Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_dr_event_id" ;
    cmm:cimAssociation "FailureEvent.EndDeviceControl" .
cmm:FailureEvent.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the associated outage event if the failure caused a customer outage. Links to outage management system."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_event_id" ;
    cmm:cimAssociation "FailureEvent.Outage" .
cmm:FailureEvent.failedComponentMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "failed component material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Failure events identify specific failed components for reliability analysis, warranty claims, and defect tracking. Links failure to material master for supplier quality management, mean-time-between-f"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "failed_component_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Failed Component Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_failed_component_material_master_id" ;
    cmm:cimAssociation "FailureEvent.ErpItemMaster" .
cmm:FailureEvent.failureWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "failure work order"@en ;
    rdfs:comment "Reference to the corrective maintenance work order created to address the failure."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "failure_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order ID" ;
    cmm:sourceColumn "work_order_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_failure_work_order_id" ;
    cmm:cimAssociation "FailureEvent.Work" .
cmm:FailureEvent.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Failure events must be attributed to feeders for IEEE 1366 reliability reporting (SAIDI/SAIFI/CAIDI), root cause analysis, worst-performing feeder identification, and targeted reliability improvement"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_feeder_id" ;
    cmm:cimAssociation "FailureEvent.Feeder" .
cmm:FailureEvent.primaryWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary work order"@en ;
    rdfs:comment "FK to asset.work_order.work_order_id — Failure events typically generate corrective work orders. Linking failure to repair enables cost-of-failure analysis and RCM."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "primary_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_primary_work_order_id" ;
    cmm:cimAssociation "FailureEvent.Work" .
cmm:FailureEvent.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the asset that experienced the failure. Links to the asset registry in Ventyx Asset Suite."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_registry_id" ;
    cmm:cimAssociation "FailureEvent.Asset" .
cmm:FailureEvent.selfReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "self report"@en ;
    rdfs:comment "Foreign key linking to compliance.self_report. Business justification: Certain asset failures trigger mandatory self-reporting to NERC (bulk electric system events) or state regulators (major outages, safety incidents). Direct link enables regulatory incident reporting w"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:SelfReport ;
    cmm:physicalColumn "self_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Self Report Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_self_report_id" ;
    cmm:cimAssociation "FailureEvent.Document" .
cmm:FailureEvent.toWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to work order"@en ;
    rdfs:comment "FK to asset.work_order.work_order_id — Failure events typically generate corrective work orders. The FK links the failure to its remediation for root cause analysis and cost tracking."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "to_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_to_work_order_id" ;
    cmm:cimAssociation "FailureEvent.Work" .
cmm:FailureEvent.transmissionLine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission line"@en ;
    rdfs:comment "Foreign key linking to transmission.line. Business justification: Equipment failures on transmission lines must be tracked to the specific line for reliability analysis (SAIDI/SAIFI metrics), root cause analysis, NERC reporting, and maintenance optimization. Essenti"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:TransmissionLine ;
    cmm:physicalColumn "transmission_line_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Line Id (Foreign Key)" ;
    cmm:sourceColumn "line_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_transmission_line_id" ;
    cmm:cimAssociation "FailureEvent.Line" .
cmm:FailureEvent.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Substation equipment failures require linkage to the specific substation for reliability metrics, outage analysis, root cause investigation, and regulatory reporting. Utilities track failure history b"@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_failure_event_transmission_substation_id" ;
    cmm:cimAssociation "FailureEvent.Substation" .
cmm:FailureEvent.affectedComponent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected component"@en ;
    rdfs:comment "Specific component or subsystem of the asset that failed (e.g., transformer winding, circuit breaker mechanism)."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_component" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Component" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.assetAgeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "asset age years"@en ;
    rdfs:comment "Age of the asset in years at the time of failure. Used for age-based reliability analysis."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "asset_age_years" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Asset Age (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:FailureEvent.caidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "caidi contribution minutes"@en ;
    rdfs:comment "Contribution of this failure event to the overall CAIDI reliability metric for the reporting period."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "caidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Average Interruption Duration Index (CAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:FailureEvent.correctiveActionPlan a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action plan"@en ;
    rdfs:comment "Description of preventive measures and process improvements to prevent recurrence of similar failures."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_action_plan" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Plan" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this failure event record was first created in the asset management system."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FailureEvent.createdDateTime .
cmm:FailureEvent.customersAffectedCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customers affected count"@en ;
    rdfs:comment "Number of customers who experienced service interruption due to this failure. Used for SAIFI calculation."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "customers_affected_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customers Affected Count" ;
    cmm:cimDatatype "Integer" .
cmm:FailureEvent.detectionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "detection timestamp"@en ;
    rdfs:comment "Date and time when the failure was detected by SCADA, protection relays, or field personnel."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "detection_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Detection Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FailureEvent.energyNotSuppliedMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy not supplied mwh"@en ;
    rdfs:comment "Total energy in megawatt-hours that could not be delivered to customers due to the failure."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_not_supplied_mwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Not Supplied (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:FailureEvent.failureAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Every failure event must reference the failed asset. Critical for reliability analysis, MTBF calculations, and NERC reporting."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "failure_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:FailureEvent.failureCauseCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure cause code"@en ;
    rdfs:comment "Standardized code identifying the root cause of the failure per utility taxonomy."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Cause Code" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.failureCauseDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure cause description"@en ;
    rdfs:comment "Detailed narrative description of the failure cause including contributing factors and conditions."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Cause Description" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.failureCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure cost amount"@en ;
    rdfs:comment "Total cost of the failure including repair labor, materials, equipment replacement, and lost revenue."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "failure_cost_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Cost Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FailureEvent.failureCostCurrency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure cost currency"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the failure cost amount."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_cost_currency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Failure Cost Currency" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:FailureEvent.failureLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure location"@en ;
    rdfs:comment "Physical location or component within the asset where the failure occurred."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Location" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.failureMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure mode"@en ;
    rdfs:comment "Primary mode of failure categorizing the physical mechanism of breakdown."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_mode" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Mode" ;
    cmm:validValues "electrical|mechanical|thermal|insulation|corrosion|external_damage" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.failureNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure number"@en ;
    rdfs:comment "Business identifier for the failure event, typically auto-generated by the asset management system."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Failure Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FailureEvent.failureStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure status"@en ;
    rdfs:comment "Current lifecycle status of the failure event record in the asset management workflow."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Failure Event Status" ;
    cmm:validValues "open|under_investigation|rca_in_progress|resolved|closed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FailureEvent.status .
cmm:FailureEvent.failureTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure timestamp"@en ;
    rdfs:comment "Date and time when the asset failure occurred. Critical for reliability analysis and SAIDI/SAIFI calculations."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "failure_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Failure Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FailureEvent.failureType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "failure type"@en ;
    rdfs:comment "Classification of the failure event by operational impact and planning status."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "failure_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Failure Type" ;
    cmm:validValues "forced_outage|planned_outage|degraded_operation|partial_failure" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FailureEvent.type .
cmm:FailureEvent.investigatedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigated by"@en ;
    rdfs:comment "Name or identifier of the engineer or team responsible for investigating the failure."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "investigated_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Investigated By" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent preventive or corrective maintenance performed on the asset prior to failure."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:FailureEvent.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp when this failure event record was most recently modified."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FailureEvent.loadInterruptedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load interrupted mw"@en ;
    rdfs:comment "Amount of electrical load in megawatts that was interrupted by the failure event."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_interrupted_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Interrupted (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FailureEvent.nercReportSubmittedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc report submitted date"@en ;
    rdfs:comment "Date when the NERC reliability report was submitted for this failure event, if applicable."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:date ;
    cmm:physicalColumn "nerc_report_submitted_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Report Submitted Date" ;
    cmm:cimDatatype "Date" .
cmm:FailureEvent.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether this failure event meets NERC reporting thresholds for reliability compliance."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FailureEvent.operatingHoursAtFailure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operating hours at failure"@en ;
    rdfs:comment "Cumulative operating hours of the asset at the time of failure. Used for MTBF analysis."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "operating_hours_at_failure" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operating Hours at Failure" ;
    cmm:cimDatatype "Decimal" .
cmm:FailureEvent.outageDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage duration minutes"@en ;
    rdfs:comment "Total duration of the forced outage in minutes from failure to restoration. Used for SAIDI calculation."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outage_duration_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:FailureEvent.pucReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "puc reportable flag"@en ;
    rdfs:comment "Indicates whether this failure event must be reported to the state Public Utility Commission."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "puc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Public Utility Commission (PUC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FailureEvent.repairActionTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "repair action taken"@en ;
    rdfs:comment "Description of the corrective action performed to restore the asset to service."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "repair_action_taken" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Repair Action Taken" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.reportedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reported by"@en ;
    rdfs:comment "Name or identifier of the person or system that reported the failure event."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "reported_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reported By" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.restorationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "restoration timestamp"@en ;
    rdfs:comment "Date and time when the asset was restored to normal operation following repair."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "restoration_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Restoration Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:FailureEvent.rootCauseAnalysisCompletedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause analysis completed flag"@en ;
    rdfs:comment "Indicates whether a formal root cause analysis has been completed for this failure event."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "root_cause_analysis_completed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Analysis (RCA) Completed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FailureEvent.rootCauseAnalysisFindings a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "root cause analysis findings"@en ;
    rdfs:comment "Summary of root cause analysis findings including identified systemic issues and contributing factors."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "root_cause_analysis_findings" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Root Cause Analysis (RCA) Findings" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.saidiContributionMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saidi contribution minutes"@en ;
    rdfs:comment "Contribution of this failure event to the overall SAIDI reliability metric for the reporting period."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saidi_contribution_minutes" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Duration Index (SAIDI) Contribution (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:FailureEvent.saifiContribution a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "saifi contribution"@en ;
    rdfs:comment "Contribution of this failure event to the overall SAIFI reliability metric for the reporting period."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "saifi_contribution" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Average Interruption Frequency Index (SAIFI) Contribution" ;
    cmm:cimDatatype "Decimal" .
cmm:FailureEvent.severityLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "severity level"@en ;
    rdfs:comment "Severity classification based on safety risk, customer impact, and asset damage extent."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "severity_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Severity Level" ;
    cmm:validValues "critical|major|moderate|minor" ;
    cmm:cimDatatype "String" .
cmm:FailureEvent.toAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Failure events record which asset failed. Without this FK, reliability analysis (MTBF, failure rate by asset class) is impossible."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:FailureEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather conditions at the time of failure (e.g., storm, lightning, high wind, ice) if weather-related."@en ;
    rdfs:domain cmm:FailureEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:CapitalProject a owl:Class ;
    rdfs:label "Capital Project"@en ;
    rdfs:comment "Capital expenditure project record for new asset construction, major refurbishment, or network augmentation. Captures project number, project name, project type (new build, replacement, upgrade, compliance), sponsoring business unit, project manager, approved CAPEX budget, committed spend, actual spend to date, project phase (feasibility, design, procurement, construction, commissioning, closeout), planned in-service date, actual in-service date, CPCN reference, and RAB eligibility flag. Sourced from SAP S/4HANA Project System (PS) and Ventyx Asset Suite."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Project ;
    cmm:cimCloseMatch cim:Project ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.project_finance ;
    cmm:physicalTable "utility_cmm_silver.asset.capital_project" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-6; SAP S/4HANA Project System / Ventyx Asset Suite — Capital Project" ;
    cmm:sourceObject "energy_utilities_ecm.asset.capital_project" ;
    owl:hasKey ( cmm:CapitalProject.capitalProjectId ) .

cmm:CapitalProject.capitalProjectId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital project id"@en ;
    rdfs:comment "Unique identifier for the capital expenditure project. Primary key for the capital project entity."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:long ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Capital Project ID" ;
    cmm:cimDatatype "Integer" .
cmm:CapitalProject.assetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset registry"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Capital projects create or refurbish assets. Linking project to resulting asset enables CAPEX-to-RAB traceability and in-service date tracking."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_asset_registry_id" ;
    cmm:cimAssociation "Project.Asset" .
cmm:CapitalProject.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Capital projects track costs by cost center for budget control, variance analysis, and FERC account allocation in rate base filings. New FK needed; removes denormalized cost_center string."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_cost_center_id" ;
    cmm:cimAssociation "Project.Organisation" .
cmm:CapitalProject.cpcnApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn application"@en ;
    rdfs:comment "Foreign key linking to compliance.cpcn_application. Business justification: Major capital projects require Certificate of Public Convenience and Necessity approval from state regulators. Tracking which CPCN application authorized each project is essential for regulatory compl"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:CpcnApplication ;
    cmm:physicalColumn "cpcn_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cpcn Application Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_cpcn_application_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:CapitalProject.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Foreign key linking to distribution.distribution_substation. Business justification: Substation capital projects (transformer additions, bus upgrades, protection modernization, capacity expansion) are major utility investments requiring detailed tracking for FERC/PUC reporting, RAB in"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_distribution_substation_id" ;
    cmm:cimAssociation "Project.Substation" .
cmm:CapitalProject.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Capital projects for feeder upgrades (reconductoring, capacity expansion, automation, undergrounding) require feeder attribution for investment planning, rate case justification, RAB tracking, and rel"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_feeder_id" ;
    cmm:cimAssociation "Project.Feeder" .
cmm:CapitalProject.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Capital projects are planned and justified based on specific IRP scenarios. Project timing, scope, and budget are driven by IRP load growth, capacity needs, and retirement assumptions. Standard utilit"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_irp_scenario_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:CapitalProject.masterSupplierContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "master supplier contract"@en ;
    rdfs:comment "Foreign key linking to supply.supplier_contract. Business justification: Large capital projects often use frame contracts for multi-year procurement of standardized equipment (transformers, poles, conductors). Links project to master supply agreement for pricing validation"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:SupplierContract ;
    cmm:physicalColumn "master_supplier_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Master Supplier Contract Id (Foreign Key)" ;
    cmm:sourceColumn "supplier_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_master_supplier_contract_id" ;
    cmm:cimAssociation "Project.Agreement" .
cmm:CapitalProject.primaryEquipmentMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary equipment material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Capital projects specify primary equipment being installed (transformer model, circuit breaker type) for asset registry creation and depreciation setup. Links project to material master for standardiz"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "primary_equipment_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Primary Equipment Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_primary_equipment_material_master_id" ;
    cmm:cimAssociation "Project.ErpItemMaster" .
cmm:CapitalProject.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Capital projects allocate to profit centers for business unit P&L tracking, rate base segmentation by service territory, and regulatory jurisdiction reporting. New FK needed for financial consolidatio"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_profit_center_id" ;
    cmm:cimAssociation "Project.Organisation" .
cmm:CapitalProject.projectManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "project manager employee"@en ;
    rdfs:comment "Employee identifier for the project manager, linking to the workforce management system."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "project_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Manager Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_project_manager_employee_id" ;
    cmm:cimAssociation "Project.ErpPersonnel" .
cmm:CapitalProject.rateCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case"@en ;
    rdfs:comment "Foreign key linking to compliance.rate_case. Business justification: Capital projects are justified and approved for cost recovery in rate cases. Utilities must track which rate case authorized capital investments for regulatory accounting, prudency reviews, and rate b"@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range cmm:RateCase ;
    cmm:physicalColumn "rate_case_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Case Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_capital_project_rate_case_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:CapitalProject.actualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion date"@en ;
    rdfs:comment "Actual date when the capital project completed all construction and commissioning activities."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.actualInServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual in service date"@en ;
    rdfs:comment "Actual date when the asset or infrastructure resulting from the capital project was placed into operational service and began providing utility function."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_in_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual In-Service Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.actualSpendToDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual spend to date"@en ;
    rdfs:comment "Cumulative actual capital expenditure incurred and paid to date for the project, including all invoiced and settled costs."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_spend_to_date" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Spend to Date" ;
    cmm:cimDatatype "Decimal" .
cmm:CapitalProject.actualStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual start date"@en ;
    rdfs:comment "Actual date when the capital project execution activities commenced."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.approvedCapexBudget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved capex budget"@en ;
    rdfs:comment "Total capital expenditure budget approved for the project by the appropriate governance authority. Represents the authorized spending limit."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_capex_budget" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Capital Expenditure (CAPEX) Budget" ;
    cmm:cimDatatype "Decimal" .
cmm:CapitalProject.budgetCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this capital project record."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "budget_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Budget Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CapitalProject.capacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity mw"@en ;
    rdfs:comment "Rated capacity in megawatts for generation or transmission projects. Represents the power handling capability of the infrastructure being built or upgraded."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CapitalProject.committedSpend a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "committed spend"@en ;
    rdfs:comment "Total amount of capital expenditure committed through purchase orders, contracts, and other binding obligations, but not yet paid."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "committed_spend" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Committed Spend" ;
    cmm:cimDatatype "Decimal" .
cmm:CapitalProject.contractorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contractor name"@en ;
    rdfs:comment "Name of the primary contractor or engineering-procurement-construction (EPC) firm executing the capital project."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "contractor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contractor Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.cpcnReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn reference number"@en ;
    rdfs:comment "Reference number for the Certificate of Public Convenience and Necessity issued by the state Public Utility Commission authorizing the capital project. Required for major utility infrastructure investments."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "cpcn_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certificate of Public Convenience and Necessity (CPCN) Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapitalProject.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the capital project record was first created in the system."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Project.createdDateTime .
cmm:CapitalProject.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Accounting depreciation method to be applied to the assets resulting from the capital project once placed in service."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|units_of_production|regulatory" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.estimatedUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated useful life years"@en ;
    rdfs:comment "Expected useful life in years for the assets resulting from the capital project, used for depreciation and asset management planning."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_useful_life_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:CapitalProject.fercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reportable flag"@en ;
    rdfs:comment "Indicates whether the capital project must be reported to FERC for regulatory oversight and rate case proceedings."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapitalProject.fundingSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "funding source"@en ;
    rdfs:comment "Primary source of capital funding for the project: internal cash reserves, debt financing, equity issuance, government grants, customer contributions, or rate recovery mechanisms."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "funding_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Funding Source" ;
    cmm:validValues "internal_cash|debt_financing|equity|grants|customer_contributions|rate_recovery" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when the capital project record was last updated or modified."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CapitalProject.nercComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc compliance flag"@en ;
    rdfs:comment "Indicates whether the capital project is subject to NERC reliability standards and compliance requirements."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapitalProject.plannedCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned completion date"@en ;
    rdfs:comment "Target date for the capital project to complete all construction and commissioning activities."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.plannedInServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned in service date"@en ;
    rdfs:comment "Target date for the asset or infrastructure resulting from the capital project to be placed into operational service."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_in_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned In-Service Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.plannedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned start date"@en ;
    rdfs:comment "Planned date for the capital project to commence execution activities."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Start Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.projectAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Capital projects create or refurbish assets. The link from project to resulting asset(s) is required for CAPEX-to-RAB traceability and commissioning workflows."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:long ;
    cmm:physicalColumn "project_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CapitalProject.projectCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project category"@en ;
    rdfs:comment "High-level asset category that the capital project targets: generation units, transmission infrastructure, distribution network, substation equipment, facilities, fleet vehicles, or IT infrastructure. Reference-value candidates: generation|transmission|distribution|substation|facilities|fleet|it_infrastructure."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.kind .
cmm:CapitalProject.projectCloseoutDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project closeout date"@en ;
    rdfs:comment "Date when the capital project was formally closed out, including final cost reconciliation, asset capitalization, and administrative closure."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:date ;
    cmm:physicalColumn "project_closeout_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Closeout Date" ;
    cmm:cimDatatype "Date" .
cmm:CapitalProject.projectDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project description"@en ;
    rdfs:comment "Detailed narrative description of the capital project scope, objectives, deliverables, and expected benefits."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Project Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:CapitalProject.projectJustification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project justification"@en ;
    rdfs:comment "Primary business driver or justification for the capital project: reliability improvement, capacity expansion, regulatory compliance, safety enhancement, operational efficiency, customer service improvement, or environmental requirement. Reference-value candidates: reliability|capacity|compliance|safety|efficiency|customer_service|environmental."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_justification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Justification" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.projectName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project name"@en ;
    rdfs:comment "Human-readable name or title of the capital project describing its purpose and scope."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Project Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:CapitalProject.projectNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project number"@en ;
    rdfs:comment "Externally-known unique business identifier for the capital project, typically assigned by the ERP system. Used for cross-system reference and reporting."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CapitalProject.projectPhase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project phase"@en ;
    rdfs:comment "Current execution phase of the capital project within the project delivery lifecycle."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_phase" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Phase" ;
    cmm:validValues "feasibility|design|procurement|construction|commissioning|closeout" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Terminal.phases .
cmm:CapitalProject.projectPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project priority"@en ;
    rdfs:comment "Business priority level assigned to the capital project for resource allocation and scheduling decisions."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Priority" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:CapitalProject.projectStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project status"@en ;
    rdfs:comment "Current lifecycle status of the capital project indicating its phase in the project delivery workflow. Reference-value candidates: feasibility|design|approved|procurement|construction|commissioning|closeout|cancelled|on_hold."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.status .
cmm:CapitalProject.projectType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project type"@en ;
    rdfs:comment "Classification of the capital project by its primary purpose: new asset construction, asset replacement, system upgrade, major refurbishment, regulatory compliance, or network augmentation."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "project_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Project Type" ;
    cmm:validValues "new_build|replacement|upgrade|refurbishment|compliance|augmentation" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Project.type .
cmm:CapitalProject.rabAllocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab allocation percentage"@en ;
    rdfs:comment "Percentage of the project capital expenditure that is eligible for inclusion in the Regulatory Asset Base. May be less than 100% if only portions are rate-recoverable."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rab_allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CapitalProject.rabEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab eligible flag"@en ;
    rdfs:comment "Indicates whether the capital expenditure from this project is eligible for inclusion in the Regulatory Asset Base for rate recovery purposes."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CapitalProject.riskLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk level"@en ;
    rdfs:comment "Overall risk assessment level for the capital project considering technical, financial, regulatory, and execution risks."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "risk_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Level" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.serviceTerritory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Geographic service territory or region where the capital project assets will be located and provide utility service."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the source system from which the capital project record originated: SAP Project System, Ventyx Asset Suite, SAP S/4HANA, or manual entry."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "SAP_PS|VENTYX|S4HANA|MANUAL" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.sourceSystemRecordCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record code"@en ;
    rdfs:comment "Unique identifier for the capital project record in the source system, used for data lineage and reconciliation."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record ID" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.sponsoringBusinessUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sponsoring business unit"@en ;
    rdfs:comment "The business unit or division that owns and sponsors the capital project, responsible for funding and business case justification."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:string ;
    cmm:physicalColumn "sponsoring_business_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sponsoring Business Unit" ;
    cmm:cimDatatype "String" .
cmm:CapitalProject.toAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Capital projects create or refurbish assets. The FK links project spend to the resulting asset for RAB capitalization and commissioning tracking."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:long ;
    cmm:physicalColumn "to_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:CapitalProject.varianceToBudget a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance to budget"@en ;
    rdfs:comment "Calculated variance between actual spend to date and approved CAPEX budget. Positive values indicate over-budget, negative values indicate under-budget."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_to_budget" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance to Budget" ;
    cmm:cimDatatype "Decimal" .
cmm:CapitalProject.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Primary voltage level in kilovolts for electrical infrastructure projects. Applicable to transmission, distribution, and substation projects."@en ;
    rdfs:domain cmm:CapitalProject ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:DepreciationSchedule a owl:Class ;
    rdfs:label "Depreciation Schedule"@en ;
    rdfs:comment "Asset depreciation schedule defining the financial depreciation profile for each utility asset or asset class. Captures depreciation method (straight-line, declining balance, units of production), useful life (years), salvage value, annual depreciation charge, accumulated depreciation, net book value, regulatory depreciation rate (as approved by PUC), and RAB depreciation treatment. Supports CAPEX/OPEX planning, regulatory asset base (RAB) valuation, and SOX-compliant financial reporting. Sourced from SAP S/4HANA Fixed Asset Accounting (FI-AA)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:FinancialInfo ;
    cmm:cimCloseMatch cim:FinancialInfo ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.asset_registry ;
    cmm:physicalTable "utility_cmm_silver.asset.depreciation_schedule" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "FERC USoA; SAP S/4HANA FI-AA — Asset Depreciation Area / IAS 16 Property Plant Equipment" ;
    cmm:sourceObject "energy_utilities_ecm.asset.depreciation_schedule" ;
    owl:hasKey ( cmm:DepreciationSchedule.depreciationScheduleId ) .

cmm:DepreciationSchedule.depreciationScheduleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation schedule id"@en ;
    rdfs:comment "Unique identifier for the depreciation schedule record. Primary key for the depreciation schedule entity."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "depreciation_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Depreciation Schedule ID" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.assetClass a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "FK to asset.asset_class.asset_class_id — Depreciation methods and useful life defaults are driven by asset class. This FK enables class-level depreciation policy inheritance."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "asset_class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_asset_class_id" ;
    cmm:cimAssociation "FinancialInfo.AssetInfo" .
cmm:DepreciationSchedule.assetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset registry"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Depreciation schedules are defined per asset. Without this FK, depreciation charges cannot be allocated to specific assets for RAB valuation and financial reporting."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_asset_registry_id" ;
    cmm:cimAssociation "FinancialInfo.Asset" .
cmm:DepreciationSchedule.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Foreign key linking to asset.asset_class. Business justification: depreciation_schedule has both asset_registry_id (for asset-specific schedules) and asset_class_code (STRING) for class-level depreciation schedules. The asset_class_code should be normalized to FK as"@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_class_id" ;
    cmm:cimAssociation "FinancialInfo.AssetInfo" .
cmm:DepreciationSchedule.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "User ID of the person or system account that created this depreciation schedule record."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_employee_id" ;
    cmm:cimAssociation "FinancialInfo.ErpPersonnel" .
cmm:DepreciationSchedule.lastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user employee"@en ;
    rdfs:comment "User ID of the person or system account that last modified this depreciation schedule record."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "FinancialInfo.ErpPersonnel" .
cmm:DepreciationSchedule.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the utility asset (generation unit, transformer, transmission tower, distribution pole, switchgear, protection relay, substation equipment, fleet vehicle, or facility) to which this depreciation schedule applies."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_depreciation_schedule_registry_id" ;
    cmm:cimAssociation "FinancialInfo.Asset" .
cmm:DepreciationSchedule.accountingPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounting period"@en ;
    rdfs:comment "Accounting period (month) within the fiscal year to which this depreciation schedule record applies. Typically 1-12."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "accounting_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounting Period" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.accumulatedDepreciation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated depreciation"@en ;
    rdfs:comment "Total depreciation expense recognized to date since the asset was placed in service. Increases each period by the depreciation charge."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accumulated_depreciation" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Depreciation" ;
    cmm:cimDatatype "Decimal" .
cmm:DepreciationSchedule.accumulatedDepreciationGlAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated depreciation gl account code"@en ;
    rdfs:comment "General ledger account code for the accumulated depreciation contra-asset account on the balance sheet."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "accumulated_depreciation_gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Depreciation General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.acquisitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition date"@en ;
    rdfs:comment "Date the asset was acquired or placed in service. Marks the start of the depreciation period."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "acquisition_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Acquisition Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.purchaseDate .
cmm:DepreciationSchedule.annualDepreciationCharge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual depreciation charge"@en ;
    rdfs:comment "Annual depreciation expense allocated to the asset under the selected depreciation method. For straight-line: depreciable base divided by useful life years."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_depreciation_charge" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Depreciation Charge" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:DepreciationSchedule.businessAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business area code"@en ;
    rdfs:comment "Business area or operating segment (e.g., generation, transmission, distribution, retail) to which this asset and its depreciation expense are allocated."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Area Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.capexOpexClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capex opex classification"@en ;
    rdfs:comment "Classification of the asset as capital expenditure (CAPEX) or operational expenditure (OPEX) for financial planning and regulatory reporting purposes. CAPEX assets are capitalized and depreciated; OPEX items are expensed immediately."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "capex_opex_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Expenditure (CAPEX) / Operational Expenditure (OPEX) Classification" ;
    cmm:validValues "capex|opex" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "Company code or legal entity to which this depreciation schedule belongs. Supports multi-entity utility holding companies."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.costCenterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center code"@en ;
    rdfs:comment "Cost center to which depreciation expense is allocated for internal management accounting and OPEX tracking."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this depreciation schedule record was first created in the source system."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FinancialInfo.createdDateTime .
cmm:DepreciationSchedule.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this depreciation schedule (e.g., USD, EUR, GBP)."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:DepreciationSchedule.depreciableBase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciable base"@en ;
    rdfs:comment "Amount subject to depreciation, calculated as original cost minus salvage value. Used as the basis for annual depreciation charge calculation."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "depreciable_base" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciable Base" ;
    cmm:cimDatatype "Decimal" .
cmm:DepreciationSchedule.depreciationAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation area code"@en ;
    rdfs:comment "Code identifying the depreciation area or ledger (e.g., book depreciation, tax depreciation, regulatory depreciation) to which this schedule applies. Utilities often maintain parallel depreciation schedules for different reporting purposes."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Area Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.depreciationAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Depreciation schedules must reference the asset being depreciated. Required for RAB valuation and financial reporting."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "depreciation_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.depreciationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation end date"@en ;
    rdfs:comment "Date on which depreciation calculation ends for this asset. Typically the date the asset is fully depreciated, retired, or disposed of."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "depreciation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation End Date" ;
    cmm:cimDatatype "Date" .
cmm:DepreciationSchedule.depreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation method"@en ;
    rdfs:comment "Method used to calculate depreciation expense over the asset's useful life. Straight-line is most common for utility assets; units of production may be used for generation equipment; regulatory composite may be mandated by PUC for rate-regulated assets."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Method" ;
    cmm:validValues "straight_line|declining_balance|units_of_production|sum_of_years_digits|regulatory_composite" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.depreciationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation start date"@en ;
    rdfs:comment "Date on which depreciation calculation begins for this asset. Typically the placed-in-service date or the first day of the following month."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "depreciation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Depreciation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:DepreciationSchedule.depreciationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation status"@en ;
    rdfs:comment "Current status of the depreciation schedule. Active indicates ongoing depreciation; fully depreciated indicates the asset has reached its salvage value; suspended indicates temporary halt; retired/disposed indicates asset is no longer in service."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "depreciation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Depreciation Status" ;
    cmm:validValues "active|fully_depreciated|suspended|retired|disposed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FinancialInfo.status .
cmm:DepreciationSchedule.depreciationToAsset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "depreciation to asset"@en ;
    rdfs:comment "FK to asset.asset_registry.asset_registry_id — Each depreciation schedule is assigned to a specific asset for financial reporting, RAB valuation, and SOX compliance. This is a mandatory FK for fixed asset accounting."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:long ;
    cmm:physicalColumn "depreciation_to_asset" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "Fiscal year to which this depreciation schedule record applies. Enables year-over-year tracking of depreciation expense and accumulated depreciation."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.functionalAreaCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "functional area code"@en ;
    rdfs:comment "Functional area (e.g., operations, maintenance, administration) to which depreciation expense is allocated for cost analysis."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "functional_area_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Functional Area Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.glAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account code"@en ;
    rdfs:comment "General ledger account code to which depreciation expense is posted. Typically a depreciation expense account in the income statement."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "gl_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Account Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.impairmentIndicatorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impairment indicator flag"@en ;
    rdfs:comment "Indicates whether the asset has been identified as potentially impaired (carrying value may exceed recoverable amount). Triggers impairment testing under GAAP ASC 360."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "impairment_indicator_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Impairment Indicator Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DepreciationSchedule.lastDepreciationRunDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last depreciation run date"@en ;
    rdfs:comment "Date of the most recent depreciation calculation run for this asset. Used to track depreciation processing and ensure timely financial close."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_depreciation_run_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Depreciation Run Date" ;
    cmm:cimDatatype "Date" .
cmm:DepreciationSchedule.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this depreciation schedule record was last modified in the source system."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:DepreciationSchedule.netBookValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net book value"@en ;
    rdfs:comment "Current carrying value of the asset on the balance sheet, calculated as original cost minus accumulated depreciation. Also known as book value or carrying amount."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_book_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Book Value (NBV)" ;
    cmm:cimDatatype "Decimal" .
cmm:DepreciationSchedule.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments regarding this depreciation schedule, including adjustments, regulatory guidance, or special circumstances."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Depreciation Schedule Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DepreciationSchedule.originalCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original cost"@en ;
    rdfs:comment "Original acquisition or construction cost of the asset, including capitalized installation, engineering, and AFUDC (Allowance for Funds Used During Construction). Basis for depreciation calculation."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Original Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" ;
    cmm:cimCloseMatch cim:Asset.purchasePrice .
cmm:DepreciationSchedule.placedInServiceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "placed in service date"@en ;
    rdfs:comment "Date the asset was placed into operational service and began generating revenue or providing utility function. Depreciation typically begins on this date."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:date ;
    cmm:physicalColumn "placed_in_service_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Placed in Service Date" ;
    cmm:cimDatatype "Date" .
cmm:DepreciationSchedule.rabDepreciationTreatment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab depreciation treatment"@en ;
    rdfs:comment "Treatment of this asset's depreciation in the Regulatory Asset Base (RAB) for rate-making purposes. Determines whether depreciation expense is recoverable through customer rates."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rab_depreciation_treatment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Depreciation Treatment" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:validValues "included|excluded|deferred|accelerated|regulatory_lag" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.rabInclusionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rab inclusion flag"@en ;
    rdfs:comment "Indicates whether this asset is included in the Regulatory Asset Base (RAB) for rate-making purposes. True if included; false if excluded."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rab_inclusion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Asset Base (RAB) Inclusion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DepreciationSchedule.regulatoryDepreciationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory depreciation rate percent"@en ;
    rdfs:comment "Depreciation rate (as a percentage of original cost) approved by the Public Utility Commission (PUC) for rate-making purposes. May differ from book depreciation rate."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "regulatory_depreciation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(7,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Depreciation Rate (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DepreciationSchedule.remainingUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remaining useful life years"@en ;
    rdfs:comment "Estimated remaining useful life of the asset in years as of the current reporting period. Calculated as original useful life minus elapsed time since placed in service."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "remaining_useful_life_years" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remaining Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.salvageValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "salvage value"@en ;
    rdfs:comment "Estimated residual value of the asset at the end of its useful life. Subtracted from original cost to determine depreciable base."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "salvage_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Salvage Value" ;
    cmm:cimDatatype "Decimal" .
cmm:DepreciationSchedule.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the source system from which this depreciation schedule record originated (e.g., SAP_S4HANA, VENTYX_ASSET_SUITE)."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.sourceSystemRecordCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system record code"@en ;
    rdfs:comment "Unique identifier of this depreciation schedule record in the source system. Enables traceability and reconciliation."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_record_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Record ID" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.taxDepreciationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax depreciation method"@en ;
    rdfs:comment "Depreciation method used for tax reporting purposes. May differ from book depreciation method. MACRS (Modified Accelerated Cost Recovery System) is common in the US."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "tax_depreciation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Depreciation Method" ;
    cmm:validValues "macrs|straight_line|declining_balance|bonus_depreciation|section_179" ;
    cmm:cimDatatype "String" .
cmm:DepreciationSchedule.taxUsefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax useful life years"@en ;
    rdfs:comment "Useful life of the asset for tax depreciation purposes, as defined by tax regulations. May differ from book useful life."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "tax_useful_life_years" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tax Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:DepreciationSchedule.usefulLifeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "useful life years"@en ;
    rdfs:comment "Expected useful life of the asset in years, as determined by engineering assessment and regulatory guidance. Used to calculate annual depreciation charge under straight-line or declining balance methods."@en ;
    rdfs:domain cmm:DepreciationSchedule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "useful_life_years" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Useful Life (Years)" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .

cmm:SparePartsInventory a owl:Class ;
    rdfs:label "Spare Parts Inventory"@en ;
    rdfs:comment "Inventory management for spare parts, consumables, and critical spares held for utility asset maintenance and emergency restoration. Captures material master data (number, description, asset class applicability, criticality classification), stocking details (location, quantity on hand, min stock, reorder point, lead time), valuation (unit cost, total inventory value), and supplier references. Also records material issue and return transactions against work orders including issue date, quantity, receiving technician, and cost allocation. Supports O&M material cost tracking, inventory replenishment triggers, and critical spare availability assurance. Sourced from Ventyx Asset Suite Inventory module and SAP S/4HANA Materials Management (MM)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ErpInventory ;
    cmm:cimCloseMatch cim:ErpInventory ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfERPSupport" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.spare_parts_inventory" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-10; Ventyx Asset Suite — Inventory / SAP MM Material Master" ;
    cmm:sourceObject "energy_utilities_ecm.asset.spare_parts_inventory" ;
    owl:hasKey ( cmm:SparePartsInventory.sparePartsInventoryId ) .

cmm:SparePartsInventory.sparePartsInventoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts inventory id"@en ;
    rdfs:comment "Unique identifier for the spare parts inventory record. Primary key for the spare parts inventory product."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:long ;
    cmm:physicalColumn "spare_parts_inventory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Spare Parts Inventory ID" ;
    cmm:cimDatatype "Integer" .
cmm:SparePartsInventory.assetClass a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "asset class"@en ;
    rdfs:comment "FK to asset.asset_class.asset_class_id — Spare parts are stocked for specific asset classes (e.g., bushings for 132kV transformers). This FK enables parts applicability lookup during work order planning."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "asset_class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_spare_parts_inventory_asset_class_id" ;
    cmm:cimAssociation "ErpInventory.AssetInfo" .
cmm:SparePartsInventory.class a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "class"@en ;
    rdfs:comment "Foreign key linking to asset.asset_class. Business justification: spare_parts_inventory has asset_class_applicability (STRING) which appears to store which asset class(es) the spare part is applicable to. This should be normalized to FK asset_class_id → asset_class."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range cmm:AssetClass ;
    cmm:physicalColumn "class_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Class Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_spare_parts_inventory_class_id" ;
    cmm:cimAssociation "ErpInventory.AssetInfo" .
cmm:SparePartsInventory.directLoadControlDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "direct load control device"@en ;
    rdfs:comment "Foreign key linking to demand.direct_load_control_device. Business justification: Spare parts inventory for DLC devices (communication modules, control relays, thermostats) supports DR program reliability. Warehouse management links spare parts to device models for reorder point ca"@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range cmm:DirectLoadControlDevice ;
    cmm:physicalColumn "direct_load_control_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Direct Load Control Device Id (Foreign Key)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_spare_parts_inventory_direct_load_control_device_id" ;
    cmm:cimAssociation "ErpInventory.EndDevice" .
cmm:SparePartsInventory.primarySpareEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary spare employee"@en ;
    rdfs:comment "System user identifier of the person who created the spare parts inventory record in the enterprise asset management system."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_spare_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_asset_spare_parts_inventory_primary_spare_employee_id" ;
    cmm:cimAssociation "ErpInventory.ErpPersonnel" .
cmm:SparePartsInventory.abcClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "abc classification"@en ;
    rdfs:comment "Inventory classification based on value and usage frequency. A items are high-value or high-usage requiring tight control and frequent review, B items are moderate-value with standard controls, C items are low-value with minimal controls. Used for cycle counting frequency and inventory management prioritization."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "abc_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ABC Classification" ;
    cmm:validValues "A|B|C" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.binLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bin location"@en ;
    rdfs:comment "Specific bin, shelf, or rack location within the stocking location where the material is stored. Supports warehouse picking and cycle counting operations."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "bin_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bin Location" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the spare parts inventory record was first created in the system. Supports audit trail and data lineage requirements."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ErpInventory.createdDateTime .
cmm:SparePartsInventory.criticalityClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "criticality classification"@en ;
    rdfs:comment "Business criticality rating of the spare part based on impact to operations if unavailable. Critical items are essential for emergency restoration and grid reliability, high items support major assets, medium items are standard maintenance spares, and low items are non-essential consumables."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "criticality_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Criticality Classification" ;
    cmm:validValues "critical|high|medium|low" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the unit cost valuation (e.g., USD, CAD, EUR, GBP)."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:SparePartsInventory.hazardousMaterialFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hazardous material flag"@en ;
    rdfs:comment "Indicates whether the material is classified as hazardous and requires special handling, storage, and disposal procedures per OSHA and EPA regulations. True if hazardous, False if non-hazardous."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "hazardous_material_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hazardous Material Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SparePartsInventory.lastIssueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last issue date"@en ;
    rdfs:comment "Date when the material was most recently issued from inventory to a work order or maintenance activity. Used for inventory turnover analysis and obsolescence management."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_issue_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Issue Date" ;
    cmm:cimDatatype "Date" .
cmm:SparePartsInventory.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Date and time when the spare parts inventory record was most recently updated. Supports change tracking and audit compliance."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
