cmm:CollectionsCase a owl:Class ;
    rdfs:label "Collections Case"@en ;
    rdfs:comment "Master and transactional entity representing collections cases and their associated dunning notices for customer accounts with delinquent balances. At the case level: captures case open date, delinquent amount, collections stage, assigned collector, escalation history, disconnect status, reconnect conditions, write-off eligibility, and case resolution outcome. At the notice level: captures dunning level (first notice, final notice, disconnect warning, disconnect order), issue date, past-due amount, response deadline, delivery channel (mail, email, SMS, door hanger), and resulting action taken. Managed within SAP IS-U FICA dunning program and Oracle CC&B collections workflow. SSOT for all collections activity and dunning communications supporting SOX AR aging and bad debt controls."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.payment_collections ;
    cmm:physicalTable "utility_cmm_silver.billing.collections" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "Collections Case / Delinquency Case" ;
    cmm:sourceObject "energy_utilities_ecm.billing.collections" ;
    owl:hasKey ( cmm:CollectionsCase.collectionsId ) .

cmm:CollectionsCase.collectionsId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collections id"@en ;
    rdfs:comment "Primary key for collections"@en ;
    rdfs:domain cmm:CollectionsCase ; rdfs:range xsd:long ;
    cmm:physicalColumn "collections_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Collections Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CollectionsCase.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with this collections case."@en ;
    rdfs:domain cmm:CollectionsCase ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_collections_account_id" ;
    cmm:cimAssociation "Document.CustomerAccount" .
cmm:CollectionsCase.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the collections agent or team member assigned to manage this case."@en ;
    rdfs:domain cmm:CollectionsCase ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Assigned Collector ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_collections_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CollectionsCase.paymentArrangement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment arrangement"@en ;
    rdfs:comment "Reference to the payment arrangement or installment plan established to resolve this collections case."@en ;
    rdfs:domain cmm:CollectionsCase ; rdfs:range cmm:PaymentArrangement ;
    cmm:physicalColumn "payment_arrangement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Arrangement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_collections_payment_arrangement_id" ;
    cmm:cimAssociation "Document.AuxiliaryAgreement" .
cmm:CollectionsCase.bankruptcyFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bankruptcy filing date"@en ;
    rdfs:comment "Date when the customer filed for bankruptcy protection."@en ;
    rdfs:domain cmm:CollectionsCase ; rdfs:range xsd:date ;
