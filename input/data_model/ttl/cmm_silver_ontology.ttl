    rdfs:comment "Current compliance standing of the desk."@en ;
    rdfs:domain cmm:TradingDesk ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
