#################################################################
# Subject area: compliance
#################################################################

cmm:ComplianceObligation a owl:Class ;
    rdfs:label "Compliance Obligation"@en ;
    rdfs:comment "Master registry of all regulatory compliance obligations applicable to the utility, including NERC CIP standards, FERC tariff requirements, PUC service territory rules, EPA emissions limits, OSHA safety mandates, SOX internal controls, CPCN conditions, and NERC reliability standard sub-requirements. Each obligation record captures the governing body, regulatory citation, effective dates, applicability scope (generation, transmission, distribution, trading), compliance frequency, responsible organizational unit, violation risk factor (VRF), violation severity level (VSL) where applicable, and current compliance status. Serves as the SSOT for what the utility is required to do and by when, and drives audit preparation, evidence collection workflows, risk assessment prioritization, and regulatory filing schedules."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.obligation" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC Reliability Standards; NERC CIP/TPL/FAC Standards Registry; FERC OATT Obligations" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.obligation" ;
    owl:hasKey ( cmm:ComplianceObligation.obligationId ) .

cmm:ComplianceObligation.obligationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obligation id"@en ;
    rdfs:comment "Unique identifier for the regulatory compliance obligation record."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:long ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Obligation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ComplianceObligation.responsibleOrganizationUnitOrgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible organization unit org unit"@en ;
    rdfs:comment "Foreign key linking to workforce.org_unit. Business justification: Regulatory obligations are assigned to organizational units for compliance accountability and resource planning. Replaces text field with FK to enable departmental obligation portfolio management and"@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "responsible_organization_unit_org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Organization Unit Org Unit Id (Foreign Key)" ;
    cmm:sourceColumn "org_unit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_obligation_responsible_organization_unit_org_unit_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:ComplianceObligation.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Indicates whether this obligation is currently active and enforceable (True/False). Inactive obligations are retained for historical reference."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ComplianceObligation.applicabilityScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicability scope"@en ;
    rdfs:comment "Business function or operational area to which the obligation applies (generation, transmission, distribution, trading, retail, wholesale, enterprise-wide, specific facility, specific asset class). Reference-value candidates: generation|transmission|distribution|trading|retail|wholesale|enterprise_wide|specific_facility|specific_asset_class."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicability_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicability Scope" ;
    cmm:cimDatatype "String" .
cmm:ComplianceObligation.boardReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board reporting flag"@en ;
    rdfs:comment "Indicates whether compliance status for this obligation must be reported to the Board of Directors (True/False)."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "board_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ComplianceObligation.complianceFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance frequency"@en ;
    rdfs:comment "Frequency at which compliance with the obligation must be demonstrated or reported (continuous, daily, weekly, monthly, quarterly, semi-annual, annual, biennial, triennial, event-driven, one-time). Reference-value candidates: continuous|daily|weekly|monthly|quarterly|semi_annual|annual|biennial|triennial|event_driven|one_time."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Frequency" ;
    cmm:cimDatatype "String" .
cmm:ComplianceObligation.complianceNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance notes"@en ;
    rdfs:comment "Free-text field for additional notes, context, or guidance related to compliance with this obligation."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Compliance Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ComplianceObligation.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of the utility with respect to this obligation (compliant, non-compliant, in-progress, not-applicable, under-review, remediation-required)."@en ;
    rdfs:domain cmm:ComplianceObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Status" ;
    cmm:validValues "compliant|non_compliant|in_progress|not_applicable|under_review|remediation_required" ;
    cmm:cimDatatype "String" .
cmm:ComplianceObligation.controlEffectivenessRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control effectiveness rating"@en ;
    rdfs:comment "Assessment of the effectiveness of internal controls in place to ensure compliance with this obligation (effective, needs-improvement, ineffective, not-assessed)."@en ;
