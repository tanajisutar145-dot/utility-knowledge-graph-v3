    cmm:businessTerm "FEMA (Federal Emergency Management Agency) Reimbursement Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmergencyStockEvent.glAccount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "General Ledger account code to which emergency procurement costs are posted."@en ;
    rdfs:domain cmm:EmergencyStockEvent ; rdfs:range xsd:string ;
