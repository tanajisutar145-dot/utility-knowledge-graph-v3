cmm:Flowgate a owl:Class ;
    rdfs:label "Flowgate"@en ;
    rdfs:comment "Master reference table for flowgate. Referenced by flowgate_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Flowgate ;
    cmm:cimExactMatch cim:Flowgate ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC62325::ReferenceData" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.asset_management ;
    cmm:physicalTable "utility_cmm_silver.transmission.flowgate" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "IEC 62325-301; NERC" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.flowgate" ;
    owl:hasKey ( cmm:Flowgate.flowgateId ) .

