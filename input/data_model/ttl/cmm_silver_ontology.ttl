cmm:OrgUnit.unitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit type"@en ;
    rdfs:comment "Classification of the organizational unit type within the utility structure (e.g., division, department, work group, cost center, crew, team, plant, station). Reference-value candidates: division|department|work_group|cost_center|crew|team|plant|station."@en ;
    rdfs:domain cmm:OrgUnit ; rdfs:range xsd:string ;
