    cmm:cimDatatype "Boolean" .
cmm:BillingServiceAgreement.demandMeteredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand metered flag"@en ;
    rdfs:comment "Indicates whether this service agreement includes demand metering and demand charges based on peak kW usage."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_metered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Metered Flag" ;
