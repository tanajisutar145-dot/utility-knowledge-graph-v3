cmm:MeteringDrEnrollment.meteringDrEnrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "metering dr enrollment status"@en ;
    rdfs:comment "Current lifecycle status of this enrollment. Active indicates eligible for event dispatch; Pending indicates enrollment submitted but not yet effective; Suspended indicates temporarily ineligible; Withdrawn indicates customer-initiated termination; Expired indicates program end date reached."@en ;
    rdfs:domain cmm:MeteringDrEnrollment ; rdfs:range xsd:string ;
