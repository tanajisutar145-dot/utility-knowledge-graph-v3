cmm:TaxProvision.soxCertificationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox certification flag"@en ;
    rdfs:comment "Indicates whether this tax provision record has been reviewed and certified under SOX internal control procedures (True) or not (False)."@en ;
    rdfs:domain cmm:TaxProvision ; rdfs:range xsd:boolean ;
