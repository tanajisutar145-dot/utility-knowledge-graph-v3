cmm:SelfReport.regulatoryResponseDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory response date"@en ;
    rdfs:comment "Date when the regulatory authority provided formal response, acknowledgment, or determination regarding the self-report."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "regulatory_response_date" ;
