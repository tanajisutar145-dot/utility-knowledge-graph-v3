cmm:InspectionMilestone.correctiveActionDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective action due date"@en ;
    rdfs:comment "The deadline by which corrective actions must be completed and verified, typically set by the inspector or regulatory timeline."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "corrective_action_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Action Due Date" ;
    cmm:cimDatatype "Date" .
cmm:InspectionMilestone.correctiveActionsRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrective actions required"@en ;
    rdfs:comment "Specific corrective actions or remediation steps required to address identified deficiencies before the milestone can be marked as passed."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "corrective_actions_required" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrective Actions Required" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this inspection milestone record was first created in the system."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:InspectionMilestone.customerPresentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer present flag"@en ;
    rdfs:comment "Indicates whether the customer or their authorized representative was present during the inspection. True if present, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "customer_present_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Present Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.deficienciesIdentified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deficiencies identified"@en ;
    rdfs:comment "Detailed description of any deficiencies, non-compliance issues, or corrective actions identified during the inspection. Null if inspection passed without issues."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "deficiencies_identified" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deficiencies Identified" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.documentRepositoryPath a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "document repository path"@en ;
    rdfs:comment "File path or URI to the document repository location where inspection photos, reports, and supporting documentation are stored."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "document_repository_path" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Document Repository Path" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.inspectionChecklistTemplateCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection checklist template code"@en ;
    rdfs:comment "Reference to the standardized inspection checklist template used for this milestone type, ensuring consistent evaluation criteria across inspections."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:long ;
    cmm:physicalColumn "inspection_checklist_template_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Checklist Template Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:InspectionMilestone.inspectionDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection duration minutes"@en ;
    rdfs:comment "The total duration of the inspection or site visit in minutes, used for resource planning and efficiency analysis."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:int ;
    cmm:physicalColumn "inspection_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:InspectionMilestone.inspectionLocationAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection location address"@en ;
    rdfs:comment "The physical address where the inspection or site visit was conducted, typically the customer's service address or DER installation site."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_location_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Location Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.inspectionLocationGisCoordinates a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection location gis coordinates"@en ;
    rdfs:comment "The GIS coordinates (latitude, longitude) of the inspection site, used for mapping, routing, and spatial analysis. Typically stored as a comma-separated string or WKT format."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_location_gis_coordinates" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Location Geographic Information System (GIS) Coordinates" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Location.geoInfoReference .
cmm:InspectionMilestone.inspectionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection notes"@en ;
    rdfs:comment "Free-text field for inspector notes, observations, and additional context captured during the inspection or milestone verification."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspection Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:InspectionMilestone.inspectionResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection result"@en ;
    rdfs:comment "Outcome of the inspection milestone. Values: pass (all requirements met), fail (deficiencies identified, corrective action required), conditional_pass (passed with minor conditions or follow-up required), not_applicable (milestone waived or not required for this application)."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspection_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspection Result" ;
    cmm:validValues "pass|fail|conditional_pass|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.inspectorCertificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspector certification number"@en ;
    rdfs:comment "Professional certification or license number of the inspector, required for regulatory compliance and quality assurance."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspector_certification_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inspector Certification Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InspectionMilestone.inspectorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspector name"@en ;
    rdfs:comment "Full name of the inspector who performed the milestone verification, captured for audit and accountability purposes."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "inspector_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inspector Name" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this inspection milestone record was last updated or modified."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InspectionMilestone.milestoneNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "milestone number"@en ;
    rdfs:comment "Business identifier for the inspection milestone, typically a sequential or hierarchical number within the interconnection application workflow."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "milestone_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Milestone Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InspectionMilestone.milestoneStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "milestone status"@en ;
    rdfs:comment "Current lifecycle status of the inspection milestone. Values: scheduled (appointment set), in_progress (inspection underway), completed (passed successfully), failed (did not pass), conditional_pass (passed with conditions or corrective actions required), cancelled (milestone no longer required), pending_reschedule (awaiting new appointment after failure or cancellation). Reference-value candidates: scheduled|in_progress|completed|failed|conditional_pass|cancelled|pending_reschedule."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "milestone_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Milestone Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:InspectionMilestone.milestoneType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "milestone type"@en ;
    rdfs:comment "Classification of the inspection milestone. Values: pre_installation_site_visit (utility site assessment before installation), electrical_rough_in_inspection (inspection of electrical work before final connection), final_interconnection_inspection (final verification before energization), witness_test (utility-witnessed commissioning test), meter_installation_verification (confirmation of metering equipment), pto_authorization (Permission to Operate issuance), other (additional milestone types). Reference-value candidates: pre_installation_site_visit|electrical_rough_in_inspection|final_interconnection_inspection|witness_test|meter_installation_verification|pto_authorization|other."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "milestone_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Milestone Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:InspectionMilestone.nemEnrollmentTriggeredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem enrollment triggered flag"@en ;
    rdfs:comment "Indicates whether the issuance of this PTO milestone has triggered the activation of the customer's NEM enrollment. True if NEM enrollment was activated as a result of this PTO, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_enrollment_triggered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Enrollment Triggered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.photosAttachedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "photos attached flag"@en ;
    rdfs:comment "Indicates whether inspection photos or documentation have been attached to this milestone record. True if photos attached, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "photos_attached_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Photos Attached Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.ptoAsBuiltDrawingAcceptedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto as built drawing accepted flag"@en ;
    rdfs:comment "Indicates whether the as-built electrical drawings and single-line diagrams have been submitted, reviewed, and accepted by the utility. Populated only for PTO milestone records. True if accepted, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pto_as_built_drawing_accepted_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) As-Built Drawing Accepted Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.ptoAuthorizationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto authorization date"@en ;
    rdfs:comment "The official date on which Permission to Operate was granted, marking the customer's authorization to energize and operate the DER system. Populated only when milestone_type is pto_authorization and inspection_result is pass."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "pto_authorization_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Authorization Date" ;
    cmm:cimDatatype "Date" .
cmm:InspectionMilestone.ptoAuthorizedExportCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto authorized export capacity kw"@en ;
    rdfs:comment "The maximum export capacity in kilowatts (kW) authorized for the DER system under the PTO. This value may differ from the applied-for capacity based on technical review and grid constraints. Populated only for PTO milestone records."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pto_authorized_export_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Authorized Export Capacity Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:InspectionMilestone.ptoIssuedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto issued flag"@en ;
    rdfs:comment "Indicates whether this milestone represents the issuance of Permission to Operate authorization. True if this is the PTO milestone and PTO has been granted, False otherwise. This flag marks the definitive transition from interconnection application to active DER operation."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pto_issued_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Issued Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.ptoMeteringConfigurationConfirmedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto metering configuration confirmed flag"@en ;
    rdfs:comment "Indicates whether the metering configuration (bidirectional meter, net meter, or production meter) has been verified and confirmed as compliant with NEM and interconnection requirements. Populated only for PTO milestone records. True if confirmed, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pto_metering_configuration_confirmed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Metering Configuration Confirmed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.ptoOperatingModeRestrictions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto operating mode restrictions"@en ;
    rdfs:comment "Any operating mode restrictions or limitations imposed on the DER system as a condition of PTO issuance, such as export limitations, time-of-use restrictions, or voltage support requirements. Populated only for PTO milestone records."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "pto_operating_mode_restrictions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Operating Mode Restrictions" ;
    cmm:cimDatatype "String" .
cmm:InspectionMilestone.ptoProtectiveRelaySettingsVerifiedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pto protective relay settings verified flag"@en ;
    rdfs:comment "Indicates whether the protective relay settings and anti-islanding protection have been verified and meet IEEE 1547 and utility interconnection standards. Populated only for PTO milestone records. True if verified, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pto_protective_relay_settings_verified_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Permission to Operate (PTO) Protective Relay Settings Verified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.reinspectionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reinspection date"@en ;
    rdfs:comment "The scheduled date for the follow-up reinspection after corrective actions have been completed. Null if no reinspection is required."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "reinspection_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reinspection Date" ;
    cmm:cimDatatype "Date" .
cmm:InspectionMilestone.reinspectionRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reinspection required flag"@en ;
    rdfs:comment "Indicates whether a follow-up reinspection is required after corrective actions are completed. True if reinspection needed, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reinspection_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reinspection Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.safetyIncidentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "safety incident flag"@en ;
    rdfs:comment "Indicates whether any safety incident or near-miss occurred during the inspection. True if incident occurred, False otherwise. Triggers incident reporting workflow."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "safety_incident_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Safety Incident Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.scheduledDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled date"@en ;
    rdfs:comment "The date on which the inspection or milestone activity is scheduled to occur."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Date" ;
    cmm:cimDatatype "Date" .
cmm:InspectionMilestone.scheduledTimeWindowEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled time window end"@en ;
    rdfs:comment "The end timestamp of the scheduled time window for the inspection or site visit."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_time_window_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Time Window End" ;
    cmm:cimDatatype "DateTime" .
cmm:InspectionMilestone.scheduledTimeWindowStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled time window start"@en ;
    rdfs:comment "The start timestamp of the scheduled time window for the inspection or site visit."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "scheduled_time_window_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduled Time Window Start" ;
    cmm:cimDatatype "DateTime" .
cmm:InspectionMilestone.sgipIncentivePaymentTriggeredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip incentive payment triggered flag"@en ;
    rdfs:comment "Indicates whether the issuance of this PTO milestone has triggered the release of SGIP incentive payment to the customer. True if SGIP payment was triggered, False otherwise."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sgip_incentive_payment_triggered_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Incentive Payment Triggered Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.slaComplianceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla compliance flag"@en ;
    rdfs:comment "Indicates whether the milestone was completed within the SLA target timeline. True if compliant, False if SLA was missed."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sla_compliance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Compliance Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InspectionMilestone.slaTargetCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sla target completion date"@en ;
    rdfs:comment "The target date by which this milestone should be completed per the utility's interconnection SLA or regulatory timeline requirements."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:date ;
    cmm:physicalColumn "sla_target_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Level Agreement (SLA) Target Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:InspectionMilestone.weatherConditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather conditions"@en ;
    rdfs:comment "Description of weather conditions at the time of the inspection, relevant for outdoor site visits and safety considerations."@en ;
    rdfs:domain cmm:InspectionMilestone ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_conditions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Conditions" ;
    cmm:cimDatatype "String" .

cmm:SgipEnrollment a owl:Class ;
    rdfs:label "Sgip Enrollment"@en ;
    rdfs:comment "Self-Generation Incentive Program (SGIP) enrollment record for a DER system applying for California SGIP incentives (or equivalent state battery storage incentive program). Captures SGIP program year, technology category (residential battery, non-residential battery, fuel cell, wind), incentive tier, reservation amount ($), incentive rate ($/Wh or $/W), system capacity (kWh/kW), equity budget flag, equity resiliency flag, application submission date, reservation confirmation date, installation completion date, incentive payment status, and program administrator (CPUC-designated). Tracks the incentive lifecycle from reservation through final payment."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.sgip_enrollment" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "SGIP (Self-Generation Incentive Program) — CPUC" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.sgip_enrollment" ;
    owl:hasKey ( cmm:SgipEnrollment.sgipEnrollmentId ) .

cmm:SgipEnrollment.sgipEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sgip enrollment id"@en ;
    rdfs:comment "Unique identifier for the SGIP enrollment record. Primary key for tracking a specific DER system's participation in California's Self-Generation Incentive Program or equivalent state battery storage incentive program."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "sgip_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Enrollment ID" ;
    cmm:cimDatatype "Integer" .
cmm:SgipEnrollment.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Reference to the billing service agreement under which the DER system is installed. Links the incentive to the customer's utility account."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_customer_service_agreement_id" ;
    cmm:cimAssociation "Agreement.CustomerAgreement" .
cmm:SgipEnrollment.derInstaller a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der installer"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_installer. Business justification: sgip_enrollment tracks installer_name and installer_license_number as STRING attributes. The der_installer product is the authoritative master for licensed DER installers with company_name, license_nu"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:DerInstaller ;
    cmm:physicalColumn "der_installer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installer Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_der_installer_id" ;
    cmm:cimAssociation "Agreement.OrganisationRole" .
cmm:SgipEnrollment.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "FK to interconnection.der_system.der_system_id — SGIP incentives are for a specific DER system (typically battery storage). The enrollment tracks the incentive lifecycle for that system."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_der_system_id" ;
    cmm:cimAssociation "Agreement.PowerElectronicsConnection" .
cmm:SgipEnrollment.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: SGIP incentive payments are financial transactions requiring GL account posting for regulatory reporting, cash disbursement tracking, and program cost recovery. Essential for California PUC compliance"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_gl_account_id" ;
    cmm:cimAssociation "Agreement.ErpChartOfAccounts" .
cmm:SgipEnrollment.incentiveApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "incentive application"@en ;
    rdfs:comment "Foreign key linking to renewable.incentive_application. Business justification: Incentive payment processing requires linking SGIP-specific enrollment records to the broader incentive application tracking system for payment reconciliation, compliance reporting, and program budget"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:IncentiveApplication ;
    cmm:physicalColumn "incentive_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Incentive Application Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_incentive_application_id" ;
    cmm:cimAssociation "Agreement.Request" .
cmm:SgipEnrollment.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Reference to the underlying interconnection application that this SGIP enrollment is associated with. Links the incentive enrollment to the grid connection request."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_interconnection_application_id" ;
    cmm:cimAssociation "Agreement.Request" .
cmm:SgipEnrollment.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: SGIP incentive programs require service point identification for program eligibility verification, performance monitoring, and greenhouse gas reduction metric validation. Regulatory reporting depends"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_meter_point_id" ;
    cmm:cimAssociation "Agreement.UsagePoint" .
cmm:SgipEnrollment.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer (residential, commercial, or industrial) who owns or operates the DER system and is applying for SGIP incentives."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:CustomerProfile ;
    cmm:physicalColumn "profile_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_profile_id" ;
    cmm:cimAssociation "Agreement.Customer" .
cmm:SgipEnrollment.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: SGIP incentive claims require regulatory filings to CPUC documenting program compliance, budget utilization, equity budget allocation, and performance metrics. Program administrators file quarterly re"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_regulatory_filing_id" ;
    cmm:cimAssociation "Agreement.Document" .
cmm:SgipEnrollment.sgipDerSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sgip der system"@en ;
    rdfs:comment "FK to interconnection.der_system.der_system_id — SGIP incentives are tied to a specific DER system (battery, fuel cell, etc.). This FK links the incentive enrollment to the physical system it subsidizes. Required for incentive payment verification a"@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "sgip_der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_sgip_enrollment_sgip_der_system_id" ;
    cmm:cimAssociation "Agreement.PowerElectronicsConnection" .
cmm:SgipEnrollment.applicationSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application submission date"@en ;
    rdfs:comment "The date the SGIP enrollment application was submitted to the program administrator. Determines queue position and applicable program year rules."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "application_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Application Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "The reason for cancellation if the SGIP enrollment was cancelled before incentive payment. Examples: customer withdrawal, project abandonment, failed inspection, budget exhaustion, reservation expiration."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this SGIP enrollment record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Agreement.createdDateTime .
cmm:SgipEnrollment.criticalFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical facility flag"@en ;
    rdfs:comment "Indicates whether the DER system is installed at a critical facility (True) such as a hospital, fire station, water treatment plant, or emergency shelter, qualifying for equity resiliency incentives. False if not a critical facility."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Facility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.disadvantagedCommunityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disadvantaged community flag"@en ;
    rdfs:comment "Indicates whether the installation site is located in a CalEnviroScreen-designated disadvantaged community (True), qualifying for equity budget incentives. False if not in a disadvantaged community."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disadvantaged_community_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disadvantaged Community Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.equipmentManufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment manufacturer"@en ;
    rdfs:comment "The manufacturer of the DER system equipment (battery, fuel cell, wind turbine, etc.). Required for SGIP equipment eligibility verification."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Manufacturer Name" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.equipmentModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment model"@en ;
    rdfs:comment "The specific model number of the DER system equipment. Must match CPUC-approved equipment list for SGIP eligibility."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_model" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Model Number" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.equipmentSerialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment serial number"@en ;
    rdfs:comment "The unique serial number of the installed DER system equipment. Required for final incentive claim verification and warranty tracking."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Equipment Serial Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:SgipEnrollment.equityBudgetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equity budget flag"@en ;
    rdfs:comment "Indicates whether this enrollment is funded from the SGIP equity budget (True) or general market budget (False). Equity budget is reserved for low-income customers and disadvantaged communities."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "equity_budget_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equity Budget Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.equityResiliencyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equity resiliency flag"@en ;
    rdfs:comment "Indicates whether this enrollment qualifies for the equity resiliency budget (True), which provides higher incentive rates for equity customers in high fire-threat districts or critical facilities. False if not applicable."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "equity_resiliency_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equity Resiliency Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.greenhouseGasReductionMetricTons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "greenhouse gas reduction metric tons"@en ;
    rdfs:comment "The estimated annual greenhouse gas emissions reduction in metric tons of CO2 equivalent achieved by the DER system. Used for SGIP program impact reporting."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "greenhouse_gas_reduction_metric_tons" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Greenhouse Gas (GHG) Reduction Metric Tons Carbon Dioxide Equivalent (CO2e)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:SgipEnrollment.highFireThreatDistrictFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "high fire threat district flag"@en ;
    rdfs:comment "Indicates whether the installation site is located in a CPUC-designated high fire-threat district (True), qualifying for equity resiliency incentives. False if not in a high fire-threat district."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "high_fire_threat_district_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "High Fire-Threat District Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.incentiveClaimSubmissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive claim submission date"@en ;
    rdfs:comment "The date the customer or installer submitted the incentive payment claim to the program administrator after installation completion. Triggers payment processing."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "incentive_claim_submission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Claim Submission Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.incentivePaymentAmountUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive payment amount usd"@en ;
    rdfs:comment "The actual incentive amount paid in US dollars. May differ from reservation amount due to final capacity verification, adjustments, or partial payments."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_payment_amount_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Payment Amount United States Dollars (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SgipEnrollment.incentivePaymentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive payment date"@en ;
    rdfs:comment "The date the SGIP incentive payment was issued to the customer or installer. Marks the completion of the incentive lifecycle."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "incentive_payment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Payment Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.incentiveRatePerW a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate per w"@en ;
    rdfs:comment "The SGIP incentive rate in dollars per watt ($/W) applicable to this enrollment for generation technologies (fuel cells, wind, combustion). Rate varies by program year, tier, and technology category."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_rate_per_w" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Rate per Watt ($/W)" ;
    cmm:cimDatatype "Decimal" .
cmm:SgipEnrollment.incentiveRatePerWh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate per wh"@en ;
    rdfs:comment "The SGIP incentive rate in dollars per watt-hour ($/Wh) applicable to this enrollment for battery storage systems. Rate varies by program year, tier, and technology category."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "incentive_rate_per_wh" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Rate per Watt-Hour ($/Wh)" ;
    cmm:cimDatatype "Decimal" .
cmm:SgipEnrollment.incentiveTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive tier"@en ;
    rdfs:comment "The SGIP incentive tier under which this enrollment is categorized. Determines incentive rate and budget allocation: general_market (standard), equity (low-income or disadvantaged community), equity_resiliency (equity + critical facility or high fire-threat district)."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Incentive Tier" ;
    cmm:validValues "general_market|equity|equity_resiliency" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.installationCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation completion date"@en ;
    rdfs:comment "The date the DER system installation was completed and passed final inspection. Required for incentive payment claim submission."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this SGIP enrollment record was last updated. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:SgipEnrollment.lowIncomeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "low income flag"@en ;
    rdfs:comment "Indicates whether the customer qualifies as low-income (True) based on CPUC income thresholds, qualifying for equity budget incentives. False if not low-income."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "low_income_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Low-Income Customer Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes and comments related to this SGIP enrollment. Used for documenting special circumstances, program administrator communications, or processing exceptions."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:SgipEnrollment.paymentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment status"@en ;
    rdfs:comment "Current status of the SGIP incentive payment lifecycle. Tracks progression from initial application through final payment or cancellation. Reference-value candidates: pending|reserved|claim_submitted|under_review|approved|paid|cancelled|expired."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incentive Payment Status" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.performanceRequirementMetFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance requirement met flag"@en ;
    rdfs:comment "Indicates whether the installed DER system met SGIP performance requirements during the measurement period (True) or failed to meet requirements (False). Affects final incentive payment eligibility."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "performance_requirement_met_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Requirement Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SgipEnrollment.programAdministrator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program administrator"@en ;
    rdfs:comment "The CPUC-designated program administrator responsible for processing this SGIP enrollment. One of: PG&E (Pacific Gas & Electric), SCE (Southern California Edison), SoCalGas (Southern California Gas Company), SDG&E (San Diego Gas & Electric), CSE (Center for Sustainable Energy)."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_administrator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Program Administrator" ;
    cmm:validValues "PG&E|SCE|SoCalGas|SDG&E|CSE" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.programYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program year"@en ;
    rdfs:comment "The SGIP program year (calendar year) under which this enrollment was submitted. Determines applicable incentive rates, budget allocations, and program rules."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "program_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Program Year" ;
    cmm:cimDatatype "Integer" .
cmm:SgipEnrollment.queuePosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "queue position"@en ;
    rdfs:comment "The position of this enrollment in the SGIP application queue for the applicable program year and budget category. Lower numbers indicate earlier queue position and higher priority for funding."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "queue_position" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Self-Generation Incentive Program (SGIP) Queue Position" ;
    cmm:cimDatatype "Integer" .
cmm:SgipEnrollment.reservationAmountUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation amount usd"@en ;
    rdfs:comment "The total incentive amount in US dollars reserved for this SGIP enrollment upon application approval. Calculated as system capacity multiplied by applicable incentive rate."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reservation_amount_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reservation Amount United States Dollars (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SgipEnrollment.reservationConfirmationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation confirmation date"@en ;
    rdfs:comment "The date the program administrator confirmed the incentive reservation for this enrollment. Marks the start of the installation completion deadline period."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "reservation_confirmation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reservation Confirmation Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.reservationExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reservation expiration date"@en ;
    rdfs:comment "The date by which the DER system installation must be completed and claimed, or the incentive reservation will expire. Typically 18-24 months from reservation confirmation date."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "reservation_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reservation Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:SgipEnrollment.systemCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system capacity kw"@en ;
    rdfs:comment "The nameplate power capacity of the DER system in kilowatts (kW). Used for calculating incentives for generation technologies (fuel cells, wind, combustion engines)."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "system_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Capacity Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:SgipEnrollment.systemCapacityKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system capacity kwh"@en ;
    rdfs:comment "The energy storage capacity of the battery system in kilowatt-hours (kWh). Used for calculating incentives for battery storage technologies (residential and non-residential batteries)."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "system_capacity_kwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Capacity Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:SgipEnrollment.technologyCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technology category"@en ;
    rdfs:comment "The type of self-generation technology for which SGIP incentives are being requested. Categories align with CPUC-defined eligible technologies and determine incentive rates. Reference-value candidates: residential_battery|non_residential_battery|fuel_cell|wind_turbine|internal_combustion_engine|gas_turbine|microturbine."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "technology_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Energy Resource (DER) Technology Category" ;
    cmm:cimDatatype "String" .
cmm:SgipEnrollment.warrantyYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty years"@en ;
    rdfs:comment "The duration of the manufacturer's warranty for the DER system equipment in years. SGIP requires minimum warranty periods for eligible equipment."@en ;
    rdfs:domain cmm:SgipEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "warranty_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Warranty Period Years" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .

cmm:CostResponsibility a owl:Class ;
    rdfs:label "Cost Responsibility"@en ;
    rdfs:comment "Cost responsibility allocation record defining how interconnection-related costs (impact study costs, network upgrade costs, interconnection facilities costs) are allocated between the applicant and the utility. Captures cost category (feasibility study, system impact study, facilities study, distribution upgrade, transmission upgrade, interconnection facilities), total estimated cost, applicant share ($ and %), utility share ($ and %), cost allocation methodology (beneficiary pays, socialized, pro-rata), payment schedule, deposit amount collected, refund eligibility, and final settled cost. Drives billing of interconnection fees and capital cost recovery."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.cost_responsibility" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Interconnection Cost Responsibility / FERC Order 2023 Cost Allocation" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.cost_responsibility" ;
    owl:hasKey ( cmm:CostResponsibility.costResponsibilityId ) .

cmm:CostResponsibility.costResponsibilityId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost responsibility id"@en ;
    rdfs:comment "Unique identifier for the cost responsibility allocation record. Primary key for this entity."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:long ;
    cmm:physicalColumn "cost_responsibility_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Cost Responsibility Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CostResponsibility.apInvoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ap invoice"@en ;
    rdfs:comment "Foreign key linking to finance.ap_invoice. Business justification: When utilities pay contractors for interconnection studies or network upgrades, AP invoices are created and linked to cost responsibility records for cost reconciliation, payment tracking, and applica"@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range cmm:ApInvoice ;
    cmm:physicalColumn "ap_invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ap Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cost_responsibility_ap_invoice_id" ;
    cmm:cimAssociation "Document.ErpPayable" .
cmm:CostResponsibility.costEstimatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost estimator employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Cost estimates for interconnection upgrades require utility engineer accountability for regulatory compliance, dispute resolution, and audit trails. Replaces denormalized cost_estimator_name. Critical"@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "cost_estimator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Estimator Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cost_responsibility_cost_estimator_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CostResponsibility.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Reference to the interconnection application for which costs are being allocated. Links this cost responsibility record to the specific DER interconnection request."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Identifier (ID)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cost_responsibility_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:CostResponsibility.payment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "payment"@en ;
    rdfs:comment "Foreign key linking to billing.payment. Business justification: Applicants make payments toward interconnection cost responsibilities (study costs, network upgrade costs) through standard utility payment channels. Business process: Interconnection cost invoices ar"@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range cmm:CustomerPayment ;
    cmm:physicalColumn "payment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Payment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_cost_responsibility_payment_id" ;
    cmm:cimAssociation "Document.Transaction" .
cmm:CostResponsibility.allocationApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation approval date"@en ;
    rdfs:comment "Date when the cost allocation was formally approved by the utility and accepted by the applicant. Establishes binding cost responsibility."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:date ;
    cmm:physicalColumn "allocation_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:CostResponsibility.allocationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation status"@en ;
    rdfs:comment "Current lifecycle status of the cost responsibility allocation. Tracks progression from initial estimate through final settlement. Reference-value candidates: draft|approved|invoiced|paid|disputed|settled|cancelled."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Status" ;
    cmm:cimDatatype "String" .
cmm:CostResponsibility.applicantCostShareAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicant cost share amount"@en ;
    rdfs:comment "Dollar amount of cost responsibility assigned to the interconnection applicant in USD. Represents the applicant's financial obligation for this cost category."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicant_cost_share_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicant Cost Share Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CostResponsibility.applicantCostSharePercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicant cost share percentage"@en ;
    rdfs:comment "Percentage of total cost assigned to the applicant (0.00 to 100.00). Provides proportional view of applicant responsibility."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicant_cost_share_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicant Cost Share Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CostResponsibility.capitalCostRecoveryMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital cost recovery method"@en ;
    rdfs:comment "Method by which the utility will recover its cost share from ratepayers. Defines the regulatory accounting treatment for utility-funded interconnection costs."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:string ;
    cmm:physicalColumn "capital_cost_recovery_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Cost Recovery Method" ;
    cmm:validValues "rate_base|direct_assignment|deferred_account|regulatory_asset|expense" ;
    cmm:cimDatatype "String" .
cmm:CostResponsibility.costAllocationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation methodology"@en ;
    rdfs:comment "Method used to determine how interconnection costs are divided between parties. Defines the regulatory or contractual basis for cost sharing."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Methodology" ;
    cmm:validValues "beneficiary_pays|socialized|pro_rata|participant_funded|utility_funded|hybrid" ;
    cmm:cimDatatype "String" .
cmm:CostResponsibility.costCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost category"@en ;
    rdfs:comment "Classification of the interconnection cost type. Defines the nature of the cost being allocated (study costs, upgrade costs, or facilities costs)."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cost Category" ;
    cmm:validValues "feasibility_study|system_impact_study|facilities_study|distribution_upgrade|transmission_upgrade|interconnection_facilities" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.kind .
cmm:CostResponsibility.costEstimateDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost estimate date"@en ;
    rdfs:comment "Date when the cost estimate was prepared by the utility. Establishes the baseline for cost allocation and applicant decision-making."@en ;
    rdfs:domain cmm:CostResponsibility ; rdfs:range xsd:date ;
    cmm:physicalColumn "cost_estimate_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
