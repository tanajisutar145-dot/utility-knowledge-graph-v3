cmm:FercMarketReport a owl:Class ;
    rdfs:label "Ferc Market Report"@en ;
    rdfs:comment "Transactional record of FERC-mandated market behavior and transaction reporting submissions, including Electric Quarterly Reports (EQR), FERC Form 552 (natural gas transactions), and market-based rate tariff filings. Captures reporting period, market type (DAM, RTM, bilateral), counterparty category, transaction volume (MWh), transaction value, LMP reference node, and submission confirmation number. Supports FERC market transparency and market-based rate authorization compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.ferc_market_report" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC EQR; FERC EQR (Electric Quarterly Report); FERC Form 552; FERC Order 2000" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.ferc_market_report" ;
    owl:hasKey ( cmm:FercMarketReport.fercMarketReportId ) .

cmm:FercMarketReport.fercMarketReportId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc market report id"@en ;
    rdfs:comment "Unique identifier for the FERC market report submission record."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "ferc_market_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Market Report ID" ;
    cmm:cimDatatype "Integer" .
cmm:FercMarketReport.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each FERC market report fulfills a specific FERC reporting obligation (e.g., EQR quarterly transaction reporting, market behavior reporting). Many reports can fulfill one obligation (1:N). Adding obli"@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_ferc_market_report_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:FercMarketReport.originalReportFercMarketReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original report ferc market report"@en ;
    rdfs:comment "Reference to the original FERC market report record that this submission amends or replaces, if this is an amendment filing."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range cmm:FercMarketReport ;
    cmm:physicalColumn "original_report_ferc_market_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Report ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_ferc_market_report_original_report_ferc_market_report_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:FercMarketReport.preparerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "preparer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: FERC market reports require employee preparer accountability for data accuracy. Replaces denormalized fields with FK to enable preparer workload tracking, authorization verification, and audit trail f"@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "preparer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_ferc_market_report_preparer_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:FercMarketReport.acceptanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acceptance date"@en ;
    rdfs:comment "Date on which FERC formally accepted the market report submission as complete and compliant with filing requirements."@en ;
    rdfs:domain cmm:FercMarketReport ; rdfs:range xsd:date ;
    cmm:physicalColumn "acceptance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FERC Acceptance Date" ;
    cmm:cimDatatype "Date" .
