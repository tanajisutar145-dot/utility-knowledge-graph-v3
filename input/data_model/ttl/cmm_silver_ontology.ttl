cmm:ControlArea.scadaIntegrationEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada integration enabled"@en ;
    rdfs:comment "Indicates whether SCADA telemetry integration is active for real-time data collection from substations and generation facilities."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scada_integration_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Integration Enabled" ;
