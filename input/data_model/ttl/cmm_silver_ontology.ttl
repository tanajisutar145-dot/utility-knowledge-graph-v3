cmm:ConnectivityNode a owl:Class ;
    rdfs:label "Connectivity Node"@en ;
    rdfs:comment "CIM ConnectivityNode: point where terminals of conducting equipment are connected with zero impedance. Basis of the as-built electrical connectivity model derived from the GIS (Utility Network) and EMS/ADMS."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ConnectivityNode ;
    cmm:cimExactMatch cim:ConnectivityNode ;
    cmm:cimMappingLevel "exact" ;
