cmm:SafetyIncident.workersCompClaimNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "workers comp claim number"@en ;
    rdfs:comment "Workers compensation insurance claim number associated with the incident. Links safety incident to financial and medical case management systems."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
