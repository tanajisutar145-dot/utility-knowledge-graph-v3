cmm:SparePartsInventory.sparePartsToAssetClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts to asset class"@en ;
    rdfs:comment "FK to asset.asset_class.asset_class_id — Spare parts are stocked for specific asset classes (e.g., transformer bushings for 132kV power transformers). This FK enables bill-of-materials resolution and critical spare identification."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:long ;
    cmm:physicalColumn "spare_parts_to_asset_class" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:SparePartsInventory.stockingLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stocking location code"@en ;
    rdfs:comment "Identifier for the warehouse, storeroom, or facility where the spare part inventory is physically held. May reference central warehouses, regional depots, or substation storerooms."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "stocking_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stocking Location Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.stockingLocationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stocking location name"@en ;
    rdfs:comment "Human-readable name of the warehouse or storeroom where the inventory is held."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "stocking_location_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stocking Location Name" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.storageConditionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storage condition code"@en ;
    rdfs:comment "Required environmental storage conditions for the material. Ambient for standard warehouse conditions, climate controlled for temperature and humidity sensitive items, refrigerated for cold storage, outdoor for weather-resistant bulk materials, and hazmat storage for hazardous materials requiring special containment."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "storage_condition_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Storage Condition Code" ;
    cmm:validValues "ambient|climate_controlled|refrigerated|outdoor|hazmat_storage" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.totalInventoryValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total inventory value"@en ;
    rdfs:comment "Total monetary value of the on-hand inventory calculated as quantity on hand multiplied by unit cost. Used for Regulatory Asset Base (RAB) valuation, financial reporting, and Capital Expenditure (CAPEX) / Operational Expenditure (OPEX) tracking."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_inventory_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Inventory Value" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:SparePartsInventory.unitCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit cost"@en ;
    rdfs:comment "Standard or moving average cost per unit of measure for the material. Used for inventory valuation, work order costing, and Operations and Maintenance (O&M) expense tracking."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:SparePartsInventory.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Standard unit in which the material quantity is tracked and issued. EA=each, FT=feet, M=meters, KG=kilograms, LB=pounds, GAL=gallons, L=liters, BOX=box, ROLL=roll, SET=set. Reference-value candidates: EA|FT|M|KG|LB|GAL|L|BOX|ROLL|SET."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:SparePartsInventory.valuationClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation class"@en ;
    rdfs:comment "Accounting classification code used to assign inventory value to specific general ledger accounts for financial reporting. Links material inventory to chart of accounts for CAPEX, OPEX, and balance sheet reporting."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "valuation_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Valuation Class" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.warrantyMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty months"@en ;
    rdfs:comment "Number of months of manufacturer warranty coverage from the date of purchase or installation. Used for warranty claim management and total cost of ownership analysis. Null if no warranty applies."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:int ;
    cmm:physicalColumn "warranty_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Period (Months)" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .

cmm:AssetInspection a owl:Class ;
    rdfs:label "Asset Inspection"@en ;
    rdfs:comment "Periodic, event-driven, or regulatory-mandated evaluation of utility asset condition encompassing routine patrol inspections (visual, post-storm, vegetation management), scheduled condition assessments, and advanced diagnostic tests (thermographic survey, dissolved gas analysis, partial discharge test, oil sampling, vibration analysis, ultrasonic testing). Records inspection/assessment date, method/type, inspector or assessor identity, overall condition score (1-5 scale per IEEE/IEC standards), individual test results with pass/fail thresholds, defects identified with severity classification (critical, major, minor), recommended follow-up actions (repair, replace, monitor, no action), estimated remediation cost, next assessment due date, and regulatory compliance flags (e.g., NERC FAC-003 vegetation management, OSHA confined space). Feeds asset health indices, risk-based maintenance prioritization, reliability-centered maintenance analysis, and condition-based maintenance triggers. SSOT for all asset condition evaluation data. Sourced from Ventyx Asset Suite Condition Monitoring, field inspection mobile apps, and SCADA-integrated online monitoring systems."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:InspectionDataSet ;
    cmm:cimExactMatch cim:InspectionDataSet ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Assets" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:asset , cmmsa:asset.maintenance_operations ;
    cmm:physicalTable "utility_cmm_silver.asset.inspection" ;
    cmm:dataClassification "transactional_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 61968-4; Ventyx Asset Suite — Inspection / NERC FAC-003 Transmission Vegetation Management" ;
    cmm:sourceObject "energy_utilities_ecm.asset.inspection" ;
    owl:hasKey ( cmm:AssetInspection.inspectionId ) .

cmm:AssetInspection.inspectionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inspection id"@en ;
    rdfs:comment "Unique identifier for the asset inspection record. Primary key."@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range xsd:long ;
    cmm:physicalColumn "inspection_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Asset Inspection ID" ;
    cmm:cimDatatype "Integer" .
cmm:AssetInspection.complianceObligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Asset inspections are mandated by specific regulatory obligations (FERC dam safety, NERC vegetation management, state PUC equipment inspection requirements). Direct link enables compliance reporting,"@en ;
    rdfs:domain cmm:AssetInspection ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "compliance_obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
