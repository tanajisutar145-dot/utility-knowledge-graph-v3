cmm:DrAggregator.taxIdentificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tax identification number"@en ;
    rdfs:comment "Federal tax identification number (EIN or TIN) for the aggregator legal entity, used for financial reporting and tax compliance."@en ;
    rdfs:domain cmm:DrAggregator ; rdfs:range xsd:string ;
