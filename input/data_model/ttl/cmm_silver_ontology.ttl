    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Zone" ;
    cmm:valuePattern "^[A-Z]{3,4}$" ;
    cmm:cimDatatype "String" .

cmm:EmsNode a owl:Class ;
    rdfs:label "Ems Node"@en ;
    rdfs:comment "Master record for every electrical node (bus) modeled in the Energy Management System (EMS) state estimator and network topology processor. Captures node name, bus number, nominal voltage (kV), substation reference, voltage zone, island membership, base MVA, and EMS model version. Serves as the topological anchor for SCADA measurements, LMP pricing nodes (PNodes), and contingency analysis. Distinct from the physical substation asset (owned by asset domain) — this is the EMS network model representation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:TopologicalNode ;
    cmm:cimCloseMatch cim:TopologicalNode ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Topology" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.ems_node" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 61970-456; IEC CIM BusbarSection / TopologicalNode" ;
    cmm:sourceObject "energy_utilities_ecm.grid.ems_node" ;
    owl:hasKey ( cmm:EmsNode.emsNodeId ) .

cmm:EmsNode.emsNodeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems node id"@en ;
    rdfs:comment "Unique identifier for the electrical node (bus) in the EMS network model. Primary key for the node entity. This is the EMS model representation, distinct from physical substation assets."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:long ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Energy Management System (EMS) Node Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EmsNode.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — Every EMS bus/node belongs to a control area. Critical for determining which balancing authority is responsible for voltage and frequency at each node. Required for NERC TOP compliance scoping."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_node_control_area_id" ;
    cmm:cimAssociation "TopologicalNode.ControlArea" .
cmm:EmsNode.emsControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems control area"@en ;
    rdfs:comment "Reference to the balancing authority responsible for this node. Used for coordination of generation control and frequency regulation."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "ems_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_node_ems_control_area_id" ;
    cmm:cimAssociation "TopologicalNode.ControlArea" .
cmm:EmsNode.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: EMS nodes represent physical electrical equipment (buses, breakers, transformers) that must be tracked as capital assets for maintenance scheduling, depreciation accounting, and FERC/regulatory report"@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_node_registry_id" ;
    cmm:cimAssociation "TopologicalNode.Asset" .
cmm:EmsNode.voltageZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "voltage zone"@en ;
    rdfs:comment "Reference to the voltage control zone or area to which this node belongs. Used for coordinated voltage control and reactive power management."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "voltage_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Voltage Zone Identifier" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_ems_node_voltage_zone_id" ;
    cmm:cimAssociation "TopologicalNode.LoadArea" .
cmm:EmsNode.agcParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc participation flag"@en ;
    rdfs:comment "Indicates whether generation at this node participates in Automatic Generation Control (AGC) for frequency regulation and area control error correction."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsNode.baseMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "base mva"@en ;
    rdfs:comment "Base power rating in megavolt-amperes (MVA) used for per-unit calculations in the EMS power flow model. Standardizes impedance and power values."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "base_mva" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Base Megavolt-Ampere (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:EmsNode.busNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bus number"@en ;
    rdfs:comment "Numeric identifier assigned to the bus in the EMS power flow model. Used in state estimation and contingency analysis calculations."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:int ;
    cmm:physicalColumn "bus_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bus Number" ;
    cmm:cimDatatype "Integer" .
cmm:EmsNode.contingencyAnalysisFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis flag"@en ;
    rdfs:comment "Indicates whether this node is included in EMS contingency analysis studies. True if the node is monitored for N-1 and N-2 contingency violations."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsNode.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this node record was first created in the EMS system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:TopologicalNode.createdDateTime .
cmm:EmsNode.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date when this node configuration became effective in the EMS network model. Used for model version control and historical analysis."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:EmsNode.emsModelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems model version"@en ;
    rdfs:comment "Version identifier of the EMS network model in which this node definition exists. Tracks model updates and changes over time."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Model Version" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.generationMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation mvar"@en ;
    rdfs:comment "Reactive power generation at this node in megavolt-amperes reactive (MVAR). Represents the reactive power injection from generators connected to this bus."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "generation_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:EmsNode.generationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation mw"@en ;
    rdfs:comment "Real power generation at this node in megawatts (MW). Represents the active power injection from generators connected to this bus."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "generation_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsNode.islandReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "island reference"@en ;
    rdfs:comment "Reference to the electrical island (connected network segment) to which this node currently belongs. Updated during topology processing after switching events."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:long ;
    cmm:physicalColumn "island_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Island Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:EmsNode.lastStateEstimationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last state estimation timestamp"@en ;
    rdfs:comment "Timestamp of the most recent successful state estimation run that included this node. Used for data quality monitoring and operational awareness."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_state_estimation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last State Estimation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsNode.lastTopologyUpdateTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last topology update timestamp"@en ;
    rdfs:comment "Timestamp of the most recent topology processor update that affected this nodes connectivity or energization status. Used for real-time operations tracking."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_topology_update_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Topology Update Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:EmsNode.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the node location in decimal degrees. Used for geospatial analysis and outage visualization."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:EmsNode.loadMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load mvar"@en ;
    rdfs:comment "Reactive power load at this node in megavolt-amperes reactive (MVAR). Represents the reactive power consumption at the bus in the EMS model."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:EmsNode.loadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load mw"@en ;
    rdfs:comment "Real power load at this node in megawatts (MW). Represents the active power consumption at the bus in the EMS model."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:EmsNode.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the node location in decimal degrees. Used for geospatial analysis and outage visualization."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:EmsNode.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this node record was last modified. Used for change tracking and audit compliance."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:EmsNode.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity jurisdiction for this node. Used for compliance reporting and reliability coordination. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|SPP|TRE."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.nodeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "node name"@en ;
    rdfs:comment "Human-readable name or label for the electrical node as defined in the EMS network model. Used by operators for identification and communication."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "node_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Node Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:EmsNode.nodeType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "node type"@en ;
    rdfs:comment "Classification of the node in the power flow model. Slack (reference bus), PV (voltage-controlled generator bus), PQ (load bus), or Isolated (disconnected from network)."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "node_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Node Type" ;
    cmm:validValues "slack|pv|pq|isolated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TopologicalNode.kind .
cmm:EmsNode.nominalVoltageKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nominal voltage kv"@en ;
    rdfs:comment "The nominal voltage level of the node in kilovolts (kV). Represents the design voltage class for this bus in the transmission or distribution network."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nominal_voltage_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Nominal Voltage (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:EmsNode.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or additional context about this node. Used by EMS engineers and operators for documentation."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EmsNode.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational status of the node in the EMS network model. Indicates whether the node is actively participating in state estimation and power flow calculations."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|testing|maintenance|decommissioned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TopologicalNode.status .
cmm:EmsNode.operatorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator code"@en ;
    rdfs:comment "Code identifying the entity responsible for operating and controlling this node. May differ from owner in cases of contracted operations."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Code" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.ownerCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner code"@en ;
    rdfs:comment "Code identifying the utility or entity that owns the physical assets associated with this node. Used for multi-utility coordination and cost allocation."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Owner Code" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "OSIsoft PI historian tag name for this nodes voltage or power measurements. Used for historical data retrieval and post-event analysis."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Tag Name" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.pnodeReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pnode reference"@en ;
    rdfs:comment "Locational Marginal Price (LMP) pricing node identifier used in energy market operations. Links the EMS node to wholesale market pricing and settlement."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "pnode_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode) Identifier" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.regionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "region code"@en ;
    rdfs:comment "Geographic or operational region code to which this node belongs. Used for regional coordination and reporting to Regional Transmission Organizations (RTOs) or Independent System Operators (ISOs)."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "region_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Region Code" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "Date when this node was retired or removed from the EMS network model. Null for active nodes. Used for historical model reconstruction."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:EmsNode.rtoIsoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso code"@en ;
    rdfs:comment "Code identifying the RTO or ISO market area in which this node operates. Used for market operations and LMP pricing coordination."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Code" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.shuntMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shunt mvar"@en ;
    rdfs:comment "Reactive power provided by shunt devices (capacitors, reactors) at this node in megavolt-amperes reactive (MVAR). Used for voltage support and power factor correction."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shunt_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shunt Reactive Power (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:EmsNode.stateEstimationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation flag"@en ;
    rdfs:comment "Indicates whether this node participates in the EMS state estimator calculations. True if the node has sufficient telemetry for state estimation."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "state_estimation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Estimation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:EmsNode.topologyStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology status"@en ;
    rdfs:comment "Real-time topology status of the node as determined by the EMS network topology processor. Reflects current switching state and connectivity."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:string ;
    cmm:physicalColumn "topology_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Topology Status" ;
    cmm:validValues "energized|de_energized|isolated|unknown" ;
    cmm:cimDatatype "String" .
cmm:EmsNode.voltageLimitHighKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage limit high kv"@en ;
    rdfs:comment "Upper voltage limit in kilovolts (kV) for this node. Used in contingency analysis and voltage violation detection."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_limit_high_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Limit High (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:EmsNode.voltageLimitLowKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage limit low kv"@en ;
    rdfs:comment "Lower voltage limit in kilovolts (kV) for this node. Used in contingency analysis and voltage violation detection."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_limit_low_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Limit Low (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:EmsNode.voltageSetpointKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage setpoint kv"@en ;
    rdfs:comment "Target voltage setpoint in kilovolts (kV) for voltage-controlled nodes (PV buses). Used by automatic voltage regulators and reactive power control devices."@en ;
    rdfs:domain cmm:EmsNode ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_setpoint_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Setpoint (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:ScadaPoint a owl:Class ;
    rdfs:label "Scada Point"@en ;
    rdfs:comment "Master catalog of all telemetry sources and measurement points — SCADA analog/digital points from RTUs and IEDs, plus PMU synchrophasor devices — across the transmission and generation network. SCADA point attributes include tag name (OSIsoft PI tag), point type (MW, MVAR, kV, amps, breaker status, tap position), associated EMS node or branch, RTU/IED source, scan rate, engineering units, deadband, quality flags, and PI historian archive configuration. PMU device attributes include manufacturer, model, firmware version, GPS synchronization source, reporting rate (frames/second), PDC assignment, and NERC PRC-002 registration status. SSOT for all telemetry source definitions and PI tag configuration — the unified operational and archiving metadata catalog for grid telemetry devices."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Measurement ;
    cmm:cimCloseMatch cim:Measurement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.scada_point" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "IdentifiedObject -> Location (CMM extension association)" ;
    cmm:standardReference "IEC 60870-5-104; DNP3; OSIsoft PI Point / IEC 61968 MeasurementValue" ;
    cmm:sourceObject "energy_utilities_ecm.grid.scada_point" ;
    owl:hasKey ( cmm:ScadaPoint.scadaPointId ) .

cmm:ScadaPoint.scadaPointId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada point id"@en ;
    rdfs:comment "Unique identifier for the SCADA telemetry point or PMU device. Primary key for the SCADA point master catalog."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:long ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "SCADA Point ID" ;
    cmm:cimDatatype "Integer" .
cmm:ScadaPoint.controlAreaRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — SCADA points belong to a specific control area's monitoring scope. Required for filtering telemetry by BA jurisdiction and for multi-area EMS configurations."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_control_area_id" ;
    cmm:cimAssociation "Measurement.ControlArea" .
cmm:ScadaPoint.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — SCADA telemetry points are associated with specific EMS nodes or branches. This is the fundamental link between the measurement layer and the network model. Required for state estimation input mapping"@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_ems_node_id" ;
    cmm:cimAssociation "Measurement.TopologicalNode" .
cmm:ScadaPoint.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: SCADA points monitoring BES Cyber Systems are CIP-reportable assets under NERC CIP-002. This link enables CIP-007 systems security management and CIP-010 configuration change management compliance by"@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_nerc_cip_asset_id" ;
    cmm:cimAssociation "Measurement.Asset" .
cmm:ScadaPoint.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: SCADA measurement points are physically installed on capital assets (transformers, breakers, capacitors). Operations and maintenance teams need to trace measurements back to asset records for predicti"@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_registry_id" ;
    cmm:cimAssociation "Measurement.Asset" .
cmm:ScadaPoint.scadaEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada ems node"@en ;
    rdfs:comment "The EMS network model node identifier to which this telemetry point is associated. Used for state estimation and contingency analysis."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "scada_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Node ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_scada_ems_node_id" ;
    cmm:cimAssociation "Measurement.TopologicalNode" .
cmm:ScadaPoint.toEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — SCADA points are associated with EMS nodes (buses) or branches in the network model. This FK is essential for mapping telemetry to the network topology for state estimation and contingency analysis."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "to_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_scada_point_to_ems_node_id" ;
    cmm:cimAssociation "Measurement.TopologicalNode" .
cmm:ScadaPoint.agcParticipationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc participation flag"@en ;
    rdfs:comment "Indicates whether this telemetry point participates in AGC for frequency regulation and area control error (ACE) calculation. True if AGC-enabled."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_participation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Automatic Generation Control (AGC) Participation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.alarmHighLimit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm high limit"@en ;
    rdfs:comment "The threshold above which an alarm is triggered. Used by EMS and SCADA alarm management systems."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "alarm_high_limit" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm High Limit" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.alarmLowLimit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm low limit"@en ;
    rdfs:comment "The threshold below which an alarm is triggered. Used by EMS and SCADA alarm management systems."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "alarm_low_limit" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Low Limit" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.balancingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority"@en ;
    rdfs:comment "The NERC-registered balancing authority responsible for this telemetry point. Used for coordination and reliability compliance."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.commissioningDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commissioning date"@en ;
    rdfs:comment "The date this SCADA point was commissioned and placed into operational service."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "commissioning_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commissioning Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:ScadaPoint.contingencyAnalysisMonitored a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis monitored"@en ;
    rdfs:comment "Indicates whether this telemetry point is monitored in EMS contingency analysis for N-1 and N-2 reliability assessments. True if monitored."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_monitored" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Monitored" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.controlArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "The control area or operating region to which this telemetry point belongs. Used for AGC (Automatic Generation Control) and load balancing."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Area" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this SCADA point record was first created in the master catalog."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Measurement.createdDateTime .
cmm:ScadaPoint.criticalInfrastructureFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "critical infrastructure flag"@en ;
    rdfs:comment "Indicates whether this telemetry point is associated with critical infrastructure as defined by NERC CIP standards. True if subject to enhanced cybersecurity controls."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "critical_infrastructure_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Critical Infrastructure Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.dataOwner a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data owner"@en ;
    rdfs:comment "The organizational unit or individual responsible for the accuracy and maintenance of this telemetry point configuration (e.g., Grid Operations, Transmission Planning)."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_owner" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Owner" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.deadbandValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deadband value"@en ;
    rdfs:comment "The minimum change in value required to trigger an update to the historian or EMS. Used to filter noise and reduce data volume. Expressed in engineering units."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deadband_value" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deadband Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.emsBranchReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems branch reference"@en ;
    rdfs:comment "The EMS network model branch identifier (transmission line, transformer) to which this telemetry point is associated. Null for nodal measurements."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_branch_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Branch ID" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.engineeringUnits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engineering units"@en ;
    rdfs:comment "The unit of measure for the telemetry value (e.g., MW, MVAR, kV, A, Hz, degrees, pu). Used for display, validation, and conversion."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "engineering_units" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Engineering Units" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.equipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type"@en ;
    rdfs:comment "The type of equipment this telemetry point monitors (e.g., transformer, circuit breaker, transmission line, generator, capacitor bank, reactor)."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Type" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.lastCalibrationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last calibration date"@en ;
    rdfs:comment "The date of the most recent calibration or accuracy verification for this telemetry point. Used for maintenance tracking and data quality assurance."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_calibration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Calibration Date" ;
    cmm:cimDatatype "Date" .
cmm:ScadaPoint.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this SCADA point record was last updated. Used for change tracking and audit trails."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ScadaPoint.measurementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement type"@en ;
    rdfs:comment "The specific electrical or operational parameter being measured: MW (real power), MVAR (reactive power), kV (voltage), amps (current), breaker status, tap position, frequency, voltage angle, phasor magnitude, or phasor angle. Reference-value candidates: MW|MVAR|kV|amps|breaker_status|tap_position|frequency|voltage_angle|phasor_magnitude|phasor_angle."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Type" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.nercPrc002Registered a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc prc 002 registered"@en ;
    rdfs:comment "Indicates whether this PMU is registered under NERC PRC-002 (Disturbance Monitoring and Reporting Requirements). True if registered for compliance. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_prc_002_registered" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC PRC-002 Registered" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.nextCalibrationDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next calibration due date"@en ;
    rdfs:comment "The scheduled date for the next calibration or accuracy verification. Used for preventive maintenance planning."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_calibration_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Calibration Due Date" ;
    cmm:cimDatatype "Date" .
cmm:ScadaPoint.normalMaxValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal max value"@en ;
    rdfs:comment "The expected maximum value for this measurement under normal operating conditions. Used for validation and alarm generation."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normal_max_value" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Maximum Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.normalMinValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normal min value"@en ;
    rdfs:comment "The expected minimum value for this measurement under normal operating conditions. Used for validation and alarm generation."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normal_min_value" ;
    cmm:sqlDataType "DECIMAL(15,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normal Minimum Value" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, configuration details, or special handling instructions for this SCADA point."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ScadaPoint.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "The current operational status of the SCADA point: active (in service), inactive (out of service), testing (commissioning), maintenance (temporarily offline), or decommissioned (permanently retired)."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "active|inactive|testing|maintenance|decommissioned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Measurement.status .
cmm:ScadaPoint.pdcAssignment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pdc assignment"@en ;
    rdfs:comment "The PDC (Phasor Data Concentrator) to which this PMU streams data. Used for synchrophasor data aggregation and distribution. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "pdc_assignment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Data Concentrator (PDC) Assignment" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.piArchiveEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi archive enabled"@en ;
    rdfs:comment "Indicates whether this point is archived in the OSIsoft PI historian. True if historical data is stored for analytics and compliance."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pi_archive_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Archive Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.piCompressionDeviation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi compression deviation"@en ;
    rdfs:comment "The compression deviation threshold for the PI tag. Values within this deviation are not archived. Expressed in engineering units or percentage."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pi_compression_deviation" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Compression Deviation" ;
    cmm:cimDatatype "Decimal" .
cmm:ScadaPoint.piCompressionEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi compression enabled"@en ;
    rdfs:comment "Indicates whether exception-based compression is enabled for this PI tag to reduce storage volume while preserving data fidelity."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "pi_compression_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Compression Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.pmuFirmwareVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu firmware version"@en ;
    rdfs:comment "The firmware version installed on the PMU device. Used for compliance tracking and troubleshooting. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_firmware_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Firmware Version" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.pmuGpsSyncSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu gps sync source"@en ;
    rdfs:comment "The GPS or time synchronization source for the PMU (e.g., GPS satellite, IRIG-B, NTP). Ensures time-aligned synchrophasor measurements. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_gps_sync_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) GPS Synchronization Source" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.pmuManufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu manufacturer"@en ;
    rdfs:comment "The manufacturer of the PMU device (e.g., SEL, GE, ABB). Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Manufacturer" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.pmuModel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu model"@en ;
    rdfs:comment "The model number of the PMU device. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_model" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Model" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.pmuReportingRateFps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu reporting rate fps"@en ;
    rdfs:comment "The reporting rate of the PMU in frames per second (e.g., 30, 60). High-speed synchrophasor data for wide-area monitoring. Null for non-PMU points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:int ;
    cmm:physicalColumn "pmu_reporting_rate_fps" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Reporting Rate (Frames Per Second)" ;
    cmm:cimDatatype "Integer" .
cmm:ScadaPoint.pointType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "point type"@en ;
    rdfs:comment "Classification of the telemetry point: analog (continuous measurements), digital (status/binary), calculated (derived values), or PMU synchrophasor (high-speed phasor measurements)."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "point_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "SCADA Point Type" ;
    cmm:validValues "analog|digital|calculated|pmu_synchrophasor" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Measurement.kind .
cmm:ScadaPoint.qualityFlagEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quality flag enabled"@en ;
    rdfs:comment "Indicates whether quality flags (good, bad, questionable, substituted) are enabled for this point. True if quality validation is active."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "quality_flag_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quality Flag Enabled" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.rtuAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rtu address"@en ;
    rdfs:comment "The communication address or channel identifier of the RTU/IED within the SCADA network (e.g., IP address, serial port, DNP3 address)."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "rtu_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Terminal Unit (RTU) Address" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.rtuReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rtu reference"@en ;
    rdfs:comment "Identifier of the RTU or IED (Intelligent Electronic Device) that sources this telemetry point. Links to the physical field device."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "rtu_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Terminal Unit (RTU) ID" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.scanRateSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scan rate seconds"@en ;
    rdfs:comment "The frequency at which the SCADA system polls this point, measured in seconds. Typical values: 2-10 seconds for critical analog points, 30-60 seconds for status points."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:int ;
    cmm:physicalColumn "scan_rate_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scan Rate (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:ScadaPoint.stateEstimatorObservable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimator observable"@en ;
    rdfs:comment "Indicates whether this telemetry point is used in the EMS state estimator for real-time network analysis. True if included in state estimation."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "state_estimator_observable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Estimator Observable" ;
    cmm:cimDatatype "Boolean" .
cmm:ScadaPoint.substationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation name"@en ;
    rdfs:comment "The name of the substation or generating station where this telemetry point is located. Used for geographic and operational context."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substation Name" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.tagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tag name"@en ;
    rdfs:comment "The unique tag identifier in the OSIsoft PI historian system. This is the canonical name used for real-time data retrieval and archival queries."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Tag Name" ;
    cmm:cimDatatype "String" .
cmm:ScadaPoint.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "The nominal voltage level of the equipment associated with this telemetry point, measured in kilovolts (kV). Used for network model alignment."@en ;
    rdfs:domain cmm:ScadaPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:GridScadaMeasurement a owl:Class ;
    rdfs:label "Grid Scada Measurement"@en ;
    rdfs:comment "Time-series transactional record of all real-time and near-real-time grid telemetry readings — both SCADA analog/digital measurements and PMU synchrophasor data — ingested from OSIsoft PI historian into the analytics platform. SCADA attributes include PI tag reference, UTC timestamp, raw value, engineering-unit value, quality code (Good/Substituted/Bad), scan cycle, and source RTU. PMU attributes include voltage/current phasor magnitude and angle, frequency (Hz), ROCOF (Hz/s), microsecond-precision timestamp, and PDC data quality flags. Measurement source type discriminator (SCADA/PMU) distinguishes data origin and grain. SSOT for all grid telemetry time-series data supporting post-event review, NERC TOP reliability analysis, NERC PRC-002 disturbance monitoring, wide-area situational awareness, oscillation detection, and operational analytics. Distinct from interval meter data (owned by metering domain)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MeasurementValue ;
    cmm:cimCloseMatch cim:MeasurementValue ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Meas" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.grid_scada_measurement" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "OSIsoft PI Archive / IEC 61968 MeasurementValue" ;
    cmm:sourceObject "energy_utilities_ecm.grid.grid_scada_measurement" ;
    owl:hasKey ( cmm:GridScadaMeasurement.gridScadaMeasurementId ) .

cmm:GridScadaMeasurement.gridScadaMeasurementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grid scada measurement id"@en ;
    rdfs:comment "Unique identifier for each grid telemetry measurement record. Primary key for the grid SCADA measurement event log. Inferred role: EVENT_LOG."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "grid_scada_measurement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Grid SCADA (Supervisory Control and Data Acquisition) Measurement ID" ;
    cmm:cimDatatype "Integer" .
cmm:GridScadaMeasurement.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key reference to the Balancing Authority responsible for the control area where this measurement was captured. Links telemetry to the NERC-registered Balancing Authority for compliance reporting, interchange scheduling, and frequency regulation analysis. Critical for NERC BAL and TOP standards."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_control_area_id" ;
    cmm:cimAssociation "MeasurementValue.ControlArea" .
cmm:GridScadaMeasurement.distributionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution substation"@en ;
    rdfs:comment "Foreign key reference to the substation where this measurement was captured. Links the telemetry to the physical grid location for geographic and network topology analysis."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:DistributionSubstation ;
    cmm:physicalColumn "distribution_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Substation ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_distribution_substation_id" ;
    cmm:cimAssociation "MeasurementValue.Substation" .
cmm:GridScadaMeasurement.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Real-time SCADA measurements at pricing nodes validate LMP calculations and market outcomes. Critical for market monitoring, price validation, dispute resolution, and FERC market surveillance. Enables"@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_lmp_price_id" ;
    cmm:cimAssociation "MeasurementValue.PnodeResults" .
cmm:GridScadaMeasurement.pmuDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pmu device"@en ;
    rdfs:comment "Foreign key reference to the Phasor Measurement Unit that captured this synchrophasor measurement. Identifies the source PMU device for high-precision time-synchronized measurements. Null for SCADA-sourced measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:PmuDevice ;
    cmm:physicalColumn "pmu_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "PMU (Phasor Measurement Unit) ID" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_pmu_device_id" ;
    cmm:cimAssociation "MeasurementValue.RemoteUnit" .
cmm:GridScadaMeasurement.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Real-time SCADA measurements trigger asset condition assessments and health index calculations. Linking measurements to asset records enables predictive maintenance algorithms, thermal aging models, a"@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_registry_id" ;
    cmm:cimAssociation "MeasurementValue.Asset" .
cmm:GridScadaMeasurement.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Foreign key reference to the SCADA point master registry that defines the telemetry point configuration, location, equipment association, and engineering metadata. Links this measurement to the grid asset or network element being monitored."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "SCADA (Supervisory Control and Data Acquisition) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_grid_scada_measurement_scada_point_id" ;
    cmm:cimAssociation "MeasurementValue.Measurement" .
cmm:GridScadaMeasurement.activePowerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active power mw"@en ;
    rdfs:comment "The real power flow in megawatts (MW) measured at this telemetry point. Positive values typically indicate power flowing in the defined forward direction; negative values indicate reverse flow. Used for generation dispatch monitoring, transmission loading, and energy accounting. Applicable to both SCADA and PMU measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "active_power_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Power (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GridScadaMeasurement.agcFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agc flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement is used as an input to the Automatic Generation Control (AGC) system for real-time generation dispatch and frequency regulation. True indicates the measurement (typically tie-line flows, area control error, or frequency) is part of the AGC control loop. False indicates the measurement is not used for AGC. Critical for NERC BAL-001 compliance."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "agc_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "AGC (Automatic Generation Control) Input Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridScadaMeasurement.alarmFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement triggered an alarm condition in the SCADA or EMS (Energy Management System). True indicates the value exceeded a configured threshold (high/low limit, rate-of-change limit, or deviation alarm). False indicates normal operation. Used to filter alarm-worthy events for operator notification and post-event analysis."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "alarm_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Condition Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridScadaMeasurement.alarmPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm priority"@en ;
    rdfs:comment "The priority level assigned to this measurement if it triggered an alarm. Critical indicates immediate operator action required (e.g., equipment overload, voltage collapse risk). High indicates urgent attention needed. Medium indicates abnormal condition requiring review. Low indicates informational alarm. Null if alarm_flag is false."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "alarm_priority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Priority Level" ;
    cmm:validValues "Critical|High|Medium|Low" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.breakerStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "breaker status"@en ;
    rdfs:comment "The operational status of a circuit breaker for digital SCADA measurements. Open indicates the breaker is open and the circuit is de-energized. Closed indicates the breaker is closed and the circuit is energized. Intermediate indicates a transitional state during switching. Unknown indicates communication loss or indeterminate status. Critical for outage management, switching order execution, and network topology determination. Null for analog measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "breaker_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Circuit Breaker Status" ;
    cmm:validValues "Open|Closed|Intermediate|Unknown" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.contingencyAnalysisFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency analysis flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement is monitored in the EMS contingency analysis application for N-1 and N-2 reliability assessments. True indicates the measurement is checked against post-contingency limits. False indicates the measurement is not part of contingency monitoring. Used to identify critical telemetry for NERC TPL (Transmission Planning) compliance."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_analysis_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Analysis Input Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridScadaMeasurement.currentAngleDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current angle degrees"@en ;
    rdfs:comment "The phase angle of the current phasor in degrees relative to a common time reference. Used in conjunction with voltage angle to calculate power flow direction and power factor. Null for non-current SCADA measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_angle_degrees" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phasor Angle (Degrees)" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:GridScadaMeasurement.currentMagnitudeAmperes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current magnitude amperes"@en ;
    rdfs:comment "The magnitude of the current phasor in amperes for PMU measurements. Represents the RMS current flowing through the monitored line or equipment. Used for real-time loading analysis and thermal limit monitoring. Null for non-current SCADA measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_magnitude_amperes" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Phasor Magnitude (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:GridScadaMeasurement.disturbanceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disturbance flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement was captured during a grid disturbance event (e.g., fault, generation trip, load rejection, frequency excursion). True indicates the measurement is part of a disturbance data set for NERC PRC-002 (Disturbance Monitoring and Reporting Requirements) compliance and post-event analysis. False indicates normal operation."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "disturbance_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disturbance Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridScadaMeasurement.engineeringUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engineering unit"@en ;
    rdfs:comment "The unit of measure for the engineering_value field. Common values include kV (kilovolt), MW (megawatt), MVAR (megavolt-ampere reactive), A (ampere), Hz (hertz), degrees (phase angle), percent (%). Essential for correct interpretation and aggregation of telemetry data."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "engineering_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Engineering Unit of Measure" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.engineeringValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "engineering value"@en ;
    rdfs:comment "The measurement value converted to engineering units (e.g., kV for voltage, MW for power, Hz for frequency, degrees for phase angle). This is the business-ready value used for operational analytics, state estimation, and reporting. Derived from raw_value using the SCADA point or PMU configuration scaling factors."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "engineering_value" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Engineering Unit Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:AnalogValue.value .
cmm:GridScadaMeasurement.equipmentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment type"@en ;
    rdfs:comment "The type of grid equipment or network element that this measurement is monitoring. Transformer includes power transformers and autotransformers. Transmission Line includes overhead lines and underground cables. Generator includes generating units. Circuit Breaker includes all switching devices. Capacitor Bank and Reactor are reactive power devices. Bus represents substation buses. Tie Line represents interconnection points between control areas. Used for equipment-specific analytics and asset performance monitoring. Reference-value candidates: Transformer|Transmission."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "equipment_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monitored Equipment Type" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.frequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "frequency hz"@en ;
    rdfs:comment "The measured electrical frequency in Hertz at the measurement point. Nominal frequency is 60 Hz in North America or 50 Hz in other regions. Frequency deviations indicate generation-load imbalance and are critical for NERC BAL (Balancing and Frequency) reliability standards compliance and automatic generation control (AGC). Captured by both SCADA frequency transducers and PMUs."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "frequency_hz" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Frequency (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:GridScadaMeasurement.ingestionTimestampUtc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ingestion timestamp utc"@en ;
    rdfs:comment "UTC timestamp when this measurement record was ingested from the OSIsoft PI historian into the analytics lakehouse platform. Distinct from measurement_timestamp_utc (the source event time). Used for data lineage tracking, latency analysis, and identifying data pipeline delays."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "ingestion_timestamp_utc" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Ingestion Timestamp (UTC)" ;
    cmm:cimDatatype "DateTime" .
cmm:GridScadaMeasurement.limitViolationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "limit violation type"@en ;
    rdfs:comment "The type of limit violation that triggered an alarm, if applicable. High indicates the value exceeded the high threshold. Low indicates the value fell below the low threshold. High-High and Low-Low indicate emergency thresholds. Rate-of-Change indicates the value changed too rapidly. None indicates no violation. Used for categorizing alarm events and compliance reporting."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "limit_violation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Limit Violation Type" ;
    cmm:validValues "High|Low|High-High|Low-Low|Rate-of-Change|None" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.measurementCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement category"@en ;
    rdfs:comment "High-level categorization of the measurement type for filtering and analytics. Voltage includes voltage magnitude and angle. Current includes current magnitude and angle. Power includes active and reactive power. Frequency includes frequency and ROCOF. Status includes breaker and switch positions. Temperature and Pressure are auxiliary measurements for equipment monitoring. Facilitates domain-specific queries and reporting. Reference-value candidates: Voltage|Current|Power|Frequency|Status|Temperature|Pressure."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Measurement Category" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.kind .
cmm:GridScadaMeasurement.measurementSourceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement source type"@en ;
    rdfs:comment "Discriminator indicating whether this measurement originated from SCADA (Supervisory Control and Data Acquisition) analog/digital telemetry or PMU (Phasor Measurement Unit) synchrophasor data. Determines the grain and attribute applicability of the record."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_source_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Source Type Discriminator" ;
    cmm:validValues "SCADA|PMU" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.measurementTimestampUtc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement timestamp utc"@en ;
    rdfs:comment "UTC timestamp when the telemetry measurement was captured at the source device (RTU or PMU). For SCADA measurements, precision is typically to the second or millisecond based on scan cycle. For PMU measurements, precision is to the microsecond per IEEE C37.118 synchrophasor standard. This is the principal event timestamp for the measurement."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "measurement_timestamp_utc" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Timestamp (UTC)" ;
    cmm:cimDatatype "DateTime" .
cmm:GridScadaMeasurement.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "The NERC regional entity where this measurement was captured. WECC (Western Electricity Coordinating Council), ERCOT (Electric Reliability Council of Texas), MRO (Midwest Reliability Organization), NPCC (Northeast Power Coordinating Council), RF (ReliabilityFirst), SERC (SERC Reliability Corporation), SPP (Southwest Power Pool), TRE (Texas Reliability Entity). Used for regional compliance reporting and inter-regional coordination analysis. Reference-value candidates: WECC|ERCOT|MRO|NPCC|RF|SERC|SPP|TRE."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NERC (North American Electric Reliability Corporation) Region" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.pdcReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pdc reference"@en ;
    rdfs:comment "Foreign key reference to the Phasor Data Concentrator that aggregated and time-aligned this PMU measurement before forwarding to the historian or wide-area monitoring system. PDCs collect data from multiple PMUs and provide synchronized data streams. Null for SCADA-sourced measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "pdc_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PDC (Phasor Data Concentrator) ID" ;
    cmm:cimDatatype "Integer" .
cmm:GridScadaMeasurement.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "The OSIsoft PI historian tag name that uniquely identifies this telemetry point in the PI system. This is the source-system identifier for SCADA measurements. Examples include substation voltage tags, transformer load tags, breaker status tags. Null for PMU-sourced measurements that may use a different naming convention."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI (Plant Information) Tag Name" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.pmuDataQualityFlags a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu data quality flags"@en ;
    rdfs:comment "Comma-separated list of IEEE C37.118 data quality flags for PMU measurements. Flags include: PMU_SYNC_LOST (GPS synchronization lost), PMU_ERROR (measurement error detected), DATA_SORTING (time-order issue), PMU_TRIGGER (event trigger active), CONFIG_CHANGE (PMU configuration changed). Empty string indicates no quality issues. Used to filter high-quality synchrophasor data for oscillation detection and wide-area monitoring. Null for SCADA measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "pmu_data_quality_flags" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "PMU (Phasor Measurement Unit) Data Quality Flags" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:GridScadaMeasurement.pmuReportingRateHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu reporting rate hz"@en ;
    rdfs:comment "The reporting rate in samples per second (Hz) for PMU synchrophasor measurements. Common values are 30 Hz or 60 Hz per IEEE C37.118 standard. Indicates the time resolution of the phasor data stream. Null for SCADA-sourced measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "pmu_reporting_rate_hz" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "PMU (Phasor Measurement Unit) Reporting Rate (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:GridScadaMeasurement.qualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quality code"@en ;
    rdfs:comment "OSIsoft PI or SCADA system quality indicator for this measurement. Good indicates valid data from the source device. Substituted indicates the value was estimated or filled by the historian due to communication loss. Bad indicates invalid or out-of-range data. Questionable indicates data that passed validation but has uncertainty flags. Annotated indicates manually adjusted data. Critical for filtering reliable data in operational analytics and NERC compliance reporting."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Code" ;
    cmm:validValues "Good|Substituted|Bad|Questionable|Annotated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeasurementValue.MeasurementValueQuality .
cmm:GridScadaMeasurement.rawValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "raw value"@en ;
    rdfs:comment "The raw numeric value of the measurement as captured by the source device before any engineering unit conversion or scaling. For analog measurements, this is the unscaled sensor reading. For digital measurements, this is the binary state (0/1). For PMU measurements, this may represent the raw ADC output before phasor calculation."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "raw_value" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Raw Measurement Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:AnalogValue.value .
cmm:GridScadaMeasurement.reactivePowerMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power mvar"@en ;
    rdfs:comment "The reactive power flow in megavolt-amperes reactive (MVAR) measured at this telemetry point. Critical for voltage control, VAR management, and power factor optimization. Monitored for NERC VAR-001 (Voltage and Reactive Control) compliance. Applicable to both SCADA and PMU measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_mvar" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:GridScadaMeasurement.rocofHzPerSecond a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rocof hz per second"@en ;
    rdfs:comment "The rate of change of frequency in Hertz per second, calculated from PMU synchrophasor data. A key indicator for detecting sudden generation loss, load rejection, or islanding events. High ROCOF values trigger under-frequency load shedding schemes and are monitored for NERC PRC-006 (Automatic Underfrequency Load Shedding) compliance. Null for SCADA measurements that do not calculate ROCOF."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rocof_hz_per_second" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ROCOF (Rate of Change of Frequency) (Hz/s)" ;
    cmm:cimDatatype "Decimal" .
cmm:GridScadaMeasurement.rtuReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rtu reference"@en ;
    rdfs:comment "Foreign key reference to the Remote Terminal Unit that collected and transmitted this SCADA measurement. Identifies the source device in the field for SCADA telemetry. Null for PMU-sourced measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:long ;
    cmm:physicalColumn "rtu_reference" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RTU (Remote Terminal Unit) ID" ;
    cmm:cimDatatype "Integer" .
cmm:GridScadaMeasurement.scanCycleSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scan cycle seconds"@en ;
    rdfs:comment "The scan cycle interval in seconds at which this SCADA point is polled by the RTU or SCADA master. Typical values range from 2 seconds (critical telemetry) to 60 seconds (slower-changing measurements). Null for PMU measurements which operate on continuous streaming at fixed reporting rates (e.g., 30 or 60 samples per second)."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "scan_cycle_seconds" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "SCADA Scan Cycle Duration (Seconds)" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:GridScadaMeasurement.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The name or identifier of the source system that provided this measurement to the PI historian. Examples include EMS (Energy Management System), SCADA Master, PMU Network, ADMS (Advanced Distribution Management System). Used for data lineage and troubleshooting data quality issues by tracing back to the originating system."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Identifier" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.stateEstimatorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimator flag"@en ;
    rdfs:comment "Boolean flag indicating whether this measurement is used as an input to the EMS (Energy Management System) state estimator application. True indicates the measurement is included in the state estimation model for real-time network analysis and contingency analysis. False indicates the measurement is for monitoring only. Critical for identifying the telemetry set used for NERC TOP reliability analysis."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "state_estimator_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Estimator Input Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GridScadaMeasurement.switchPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "switch position"@en ;
    rdfs:comment "The position status of a disconnect switch or sectionalizing switch for digital SCADA measurements. Open indicates the switch is open. Closed indicates the switch is closed. Grounded indicates the switch is in a grounding position (for maintenance safety). Unknown indicates communication loss. Used for network topology modeling and switching order verification. Null for analog measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:string ;
    cmm:physicalColumn "switch_position" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Switch Position Status" ;
    cmm:validValues "Open|Closed|Grounded|Unknown" ;
    cmm:cimDatatype "String" .
cmm:GridScadaMeasurement.voltageAngleDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage angle degrees"@en ;
    rdfs:comment "The phase angle of the voltage phasor in degrees relative to a common time reference (typically GPS-synchronized). Critical for wide-area situational awareness, angle difference monitoring across transmission corridors, and oscillation detection. Null for non-voltage SCADA measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_angle_degrees" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phasor Angle (Degrees)" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:GridScadaMeasurement.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "The nominal voltage level in kilovolts (kV) of the network element where this measurement was captured. Common values include 765, 500, 345, 230, 138, 115, 69, 34.5, 13.8, 4.16 kV. Used for segmenting telemetry by transmission vs. sub-transmission vs. distribution voltage classes and for voltage-specific analytics."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:int ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:GridScadaMeasurement.voltageMagnitudeKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage magnitude kv"@en ;
    rdfs:comment "The magnitude of the voltage phasor in kilovolts (kV) for PMU measurements. Represents the RMS voltage at the measurement point. Used for wide-area voltage monitoring, oscillation detection, and voltage stability analysis. Null for non-voltage SCADA measurements."@en ;
    rdfs:domain cmm:GridScadaMeasurement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_magnitude_kv" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Phasor Magnitude (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:StateEstimationRun a owl:Class ;
    rdfs:label "State Estimation Run"@en ;
    rdfs:comment "Transactional record of each EMS state estimator execution cycle including topology connectivity state, per-node/per-branch electrical results, and network island configuration. Run-level attributes include timestamp, solution status (converged/diverged/flat-start), iterations, MW mismatch tolerance, bad-data detections, observable islands, operator overrides. Topology attributes include number of energized buses, open switching devices, topology change flag, and island membership. Result-level detail (grain: one row per node/branch per run) includes estimated voltage magnitude (kV), voltage angle (degrees), active power flow (MW), reactive power flow (MVAR), current (amps), and residual. SSOT for state estimation execution, topology snapshots, and electrical results — used for NERC TOP compliance evidence, post-event voltage profile and network reconstruction analysis, contingency pre-screening, NERC FAC-002 transfer capability studies, and EMS model validation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.state_estimation_run" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "EMS State Estimator / NERC TOP-001" ;
    cmm:sourceObject "energy_utilities_ecm.grid.state_estimation_run" ;
    owl:hasKey ( cmm:StateEstimationRun.stateEstimationRunId ) .

cmm:StateEstimationRun.stateEstimationRunId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run id"@en ;
    rdfs:comment "Unique identifier for each execution cycle of the Energy Management System (EMS) state estimator. Primary key for the state estimation run record."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:long ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "State Estimation Run Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.balancingAuthorityControlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority control area"@en ;
    rdfs:comment "NERC-registered identifier of the Balancing Authority responsible for the control area where this state estimation run was executed. Used for inter-BA coordination and compliance reporting."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "balancing_authority_control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Balancing Authority Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_run_balancing_authority_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:StateEstimationRun.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "FK to grid.control_area.control_area_id — State estimation runs execute within the context of a specific control area's network model. This link is required for multi-area EMS configurations and for scoping SE results to the correct balancing"@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_run_control_area_id" ;
    cmm:cimAssociation "ActivityRecord.ControlArea" .
cmm:StateEstimationRun.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — State estimation results are per-node/per-branch. After merge of state_estimation_result into state_estimation_run, the result-level grain references ems_node. Required for post-event voltage analysis"@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_run_ems_node_id" ;
    cmm:cimAssociation "ActivityRecord.TopologicalNode" .
cmm:StateEstimationRun.stateEmsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state ems node"@en ;
    rdfs:comment "FK to grid.ems_node.ems_node_id — State estimation results (now merged into state_estimation_run) produce per-node voltage/angle estimates. The FK to ems_node is required to map results back to the network model for visualization and"@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "state_ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_run_state_ems_node_id" ;
    cmm:cimAssociation "ActivityRecord.TopologicalNode" .
cmm:StateEstimationRun.badDataDetectionCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bad data detection count"@en ;
    rdfs:comment "Number of SCADA measurements flagged as bad data (outliers or erroneous readings) during the state estimation execution. High counts indicate telemetry quality issues requiring investigation."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "bad_data_detection_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bad Data Detection Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.closedSwitchingDeviceCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closed switching device count"@en ;
    rdfs:comment "Number of circuit breakers, disconnects, and other switching devices in the closed (conducting) position during this state estimation run. Defines network connectivity paths."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "closed_switching_device_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Closed Switching Device Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.contingencyPreScreeningFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency pre screening flag"@en ;
    rdfs:comment "Boolean indicator (True/False) signaling whether this state estimation solution was used as the base case for contingency analysis pre-screening to identify critical N-1 and N-2 outage scenarios."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_pre_screening_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Pre-Screening Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationRun.controlCenterReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control center reference"@en ;
    rdfs:comment "Identifier of the physical or logical control center facility where the EMS state estimator executed this run. Used for operational audit trail and disaster recovery tracking."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_center_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Center Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this state estimation run record was first created in the data platform. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:StateEstimationRun.deEnergizedBusCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "de energized bus count"@en ;
    rdfs:comment "Total number of electrical buses (nodes) in the network topology that are de-energized (out of service) and excluded from the state estimation solution for this execution cycle."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "de_energized_bus_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "De-Energized Bus Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.emsModelVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems model version"@en ;
    rdfs:comment "Version identifier of the EMS network model (bus-branch topology, equipment parameters, ratings) used for this state estimation execution. Critical for model validation and change tracking."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_model_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Model Version" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.energizedBusCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energized bus count"@en ;
    rdfs:comment "Total number of electrical buses (nodes) in the network topology that are energized and included in the state estimation solution for this execution cycle."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "energized_bus_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energized Bus Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.executionDurationSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution duration seconds"@en ;
    rdfs:comment "Total elapsed time in seconds from state estimation run initiation to solution completion or failure. Used for EMS performance monitoring and capacity planning."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "execution_duration_seconds" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Execution Duration Seconds" ;
    cmm:unitSymbol "s" ;
    cmm:cimDatatype "Seconds" .
cmm:StateEstimationRun.iterationCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iteration count"@en ;
    rdfs:comment "Number of iterative solver cycles executed before the state estimator reached convergence or divergence. High iteration counts may indicate network stress or measurement quality issues."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "iteration_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solver Iteration Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Timestamp when this state estimation run record was last modified in the data platform. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:StateEstimationRun.mvarMismatchTolerance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mvar mismatch tolerance"@en ;
    rdfs:comment "The maximum allowable reactive power mismatch threshold in megavars (MVAR) used as the convergence criterion for the state estimation solver. Critical for voltage stability assessment."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mvar_mismatch_tolerance" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megavar (MVAR) Mismatch Tolerance" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationRun.mwMismatchTolerance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mw mismatch tolerance"@en ;
    rdfs:comment "The maximum allowable active power mismatch threshold in megawatts (MW) used as the convergence criterion for the state estimation solver. Lower values indicate tighter solution accuracy requirements."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mw_mismatch_tolerance" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megawatt (MW) Mismatch Tolerance" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationRun.observableIslandCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "observable island count"@en ;
    rdfs:comment "Number of electrically isolated network islands that have sufficient measurement coverage for state estimation. Each island requires independent solution processing."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "observable_island_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Observable Island Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.openSwitchingDeviceCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "open switching device count"@en ;
    rdfs:comment "Number of circuit breakers, disconnects, and other switching devices in the open (non-conducting) position during this state estimation run. Defines network connectivity and island boundaries."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "open_switching_device_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Open Switching Device Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.operatorOverrideFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override flag"@en ;
    rdfs:comment "Boolean indicator (True/False) signaling whether a system operator manually overrode state estimation inputs, outputs, or solver parameters during this execution cycle. Used for audit trail and compliance evidence."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "operator_override_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationRun.operatorOverrideReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator override reason"@en ;
    rdfs:comment "Free-text explanation provided by the system operator documenting the business justification for any manual override applied during this state estimation run. Required for NERC compliance and post-event review."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_override_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Override Reason" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.piHistorianTagPrefix a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag prefix"@en ;
    rdfs:comment "OSIsoft PI System tag prefix or namespace used to store time-series state estimation results (voltage, angle, flow) in the PI historian for operational analytics and post-event review."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag_prefix" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Historian Tag Prefix" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.pmuMeasurementCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pmu measurement count"@en ;
    rdfs:comment "Total number of synchrophasor measurements from Phasor Measurement Units (PMUs) available and processed as inputs to the state estimation algorithm. PMU data provides high-precision time-synchronized voltage and current phasors."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "pmu_measurement_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phasor Measurement Unit (PMU) Measurement Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.pseudoMeasurementCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pseudo measurement count"@en ;
    rdfs:comment "Number of pseudo-measurements (synthetic measurements derived from historical load profiles, generation schedules, or forecasts) injected into the state estimation to improve observability in areas with sparse SCADA coverage."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "pseudo_measurement_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pseudo Measurement Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.runStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run status"@en ;
    rdfs:comment "Current lifecycle status of the state estimation solution indicating whether the iterative solver successfully converged to a valid network state, diverged without solution, started from flat conditions, failed due to error, was aborted by operator, or produced partial results."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "run_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "State Estimation Solution Status" ;
    cmm:validValues "converged|diverged|flat_start|failed|aborted|partial" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:StateEstimationRun.runTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "run timestamp"@en ;
    rdfs:comment "The exact date and time when the state estimation execution cycle was initiated by the EMS. This is the principal business event timestamp representing when the network state was computed."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "run_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "State Estimation Run Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StateEstimationRun.scadaMeasurementCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada measurement count"@en ;
    rdfs:comment "Total number of SCADA telemetry measurements (voltage, current, MW, MVAR, breaker status) available and processed as inputs to the state estimation algorithm for this execution cycle."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "scada_measurement_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Measurement Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.solutionQualityIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solution quality indicator"@en ;
    rdfs:comment "Qualitative assessment of the state estimation solution quality based on residual magnitude, bad data detection count, and observability metrics. Used for operator confidence and post-event analysis."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "solution_quality_indicator" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solution Quality Indicator" ;
    cmm:validValues "excellent|good|acceptable|marginal|poor" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.systemFrequencyHz a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "system frequency hz"@en ;
    rdfs:comment "Measured or estimated electrical system frequency in Hertz (Hz) at the time of the state estimation run. Nominal frequency is 60 Hz in North America; deviations indicate generation-load imbalance."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "system_frequency_hz" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "System Frequency Hertz (Hz)" ;
    cmm:unitSymbol "Hz" ;
    cmm:cimDatatype "Frequency" .
cmm:StateEstimationRun.thermalViolationCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal violation count"@en ;
    rdfs:comment "Number of transmission lines, transformers, or other network branches where the estimated current or power flow exceeds thermal rating limits. Indicates potential equipment overload requiring operator intervention."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "thermal_violation_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Thermal Violation Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.topologyChangeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology change flag"@en ;
    rdfs:comment "Boolean indicator (True/False) signaling whether the network topology connectivity state changed since the previous state estimation run due to switching operations, outages, or equipment status changes."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "topology_change_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Topology Change Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationRun.topologySnapshotId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology snapshot id"@en ;
    rdfs:comment "Unique identifier or hash representing the specific network topology configuration (bus connectivity, switching device states, equipment in-service status) captured at the time of this state estimation run. Used for topology reconstruction and post-event analysis."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:string ;
    cmm:physicalColumn "topology_snapshot_id" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Topology Snapshot Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationRun.totalGenerationMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total generation mw"@en ;
    rdfs:comment "Sum of active power generation in megawatts (MW) across all generating units included in the state estimation solution. Used for system-wide power balance verification and NERC BAL compliance reporting."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_generation_mw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Generation Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StateEstimationRun.totalInterchangeMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total interchange mw"@en ;
    rdfs:comment "Net scheduled active power interchange in megawatts (MW) with neighboring balancing authorities or control areas. Positive values indicate net export; negative values indicate net import."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_interchange_mw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Interchange Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StateEstimationRun.totalLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total load mw"@en ;
    rdfs:comment "Sum of active power load in megawatts (MW) across all load buses included in the state estimation solution. Used for system-wide power balance verification and load forecasting validation."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_load_mw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Load Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StateEstimationRun.totalLossesMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total losses mw"@en ;
    rdfs:comment "Calculated active power losses in megawatts (MW) across the transmission network (lines, transformers, reactors) derived from the state estimation solution. Used for loss allocation and energy accounting."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_losses_mw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Transmission Losses Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StateEstimationRun.unobservableIslandCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unobservable island count"@en ;
    rdfs:comment "Number of electrically isolated network islands that lack sufficient SCADA measurement coverage for state estimation. These islands cannot be solved and require operator attention."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "unobservable_island_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unobservable Island Count" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationRun.voltageViolationCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violation count"@en ;
    rdfs:comment "Number of electrical buses where the estimated voltage magnitude falls outside acceptable operating limits (typically 0.95 to 1.05 per-unit). High counts indicate voltage stability concerns requiring corrective action."@en ;
    rdfs:domain cmm:StateEstimationRun ; rdfs:range xsd:int ;
    cmm:physicalColumn "voltage_violation_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Violation Count" ;
    cmm:cimDatatype "Integer" .

cmm:StateEstimationResult a owl:Class ;
    rdfs:label "State Estimation Result"@en ;
    rdfs:comment "Per-node and per-branch output record from each EMS state estimator run. Captures the estimated voltage magnitude (kV), voltage angle (degrees), active power flow (MW), reactive power flow (MVAR), current (amps), and residual for each EMS node or branch in the solved network model. Linked to a parent state_estimation_run. Enables post-event voltage profile analysis, contingency pre-screening, and NERC FAC-002 transfer capability studies."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:StateVariable ;
    cmm:cimCloseMatch cim:StateVariable ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::StateVariables" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.network_operations ;
    cmm:physicalTable "utility_cmm_silver.grid.state_estimation_result" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61970-456; IEC CIM EstimatedInjection / EMS SE Output" ;
    cmm:sourceObject "energy_utilities_ecm.grid.state_estimation_result" ;
    owl:hasKey ( cmm:StateEstimationResult.stateEstimationResultId ) .

cmm:StateEstimationResult.stateEstimationResultId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation result id"@en ;
    rdfs:comment "Unique identifier for each state estimation result record. Primary key for the state estimation result entity."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:long ;
    cmm:physicalColumn "state_estimation_result_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "State Estimation Result ID" ;
    cmm:cimDatatype "Integer" .
cmm:StateEstimationResult.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "The SCADA telemetry point identifier that provided the measurement for this element. Links state estimation results to real-time data sources."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "SCADA Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_result_scada_point_id" ;
    cmm:cimAssociation "StateVariable.Measurement" .
cmm:StateEstimationResult.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "Foreign key reference to the parent state estimation run that produced this result. Links this node or branch result to the specific EMS state estimator execution."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "State Estimation Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_state_estimation_result_state_estimation_run_id" ;
    cmm:cimAssociation "StateVariable.ActivityRecord" .
cmm:StateEstimationResult.activePowerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active power mw"@en ;
    rdfs:comment "The estimated active power flow through this branch or injected/consumed at this node in megawatts. Represents real power transfer in the network."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "active_power_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Power (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:StateEstimationResult.apparentPowerMva a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "apparent power mva"@en ;
    rdfs:comment "The estimated apparent power (vector sum of active and reactive power) in megavolt-amperes. Used for equipment loading and thermal limit assessment."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "apparent_power_mva" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Apparent Power (MVA)" ;
    cmm:unitSymbol "VA" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ApparentPower" .
cmm:StateEstimationResult.balancingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority"@en ;
    rdfs:comment "The balancing authority responsible for this network element. Identifies the control area for coordination and reliability compliance."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.contingencyViolationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency violation flag"@en ;
    rdfs:comment "Indicates whether this element would violate operating limits under contingency conditions. Used for pre-screening in contingency analysis."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "contingency_violation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Violation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationResult.controlArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "The control area to which this network element belongs. Used for area interchange control and automatic generation control (AGC)."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "control_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Area" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this state estimation result record was created in the system. Audit trail for data lineage and compliance."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:StateVariable.createdDateTime .
cmm:StateEstimationResult.currentAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current amps"@en ;
    rdfs:comment "The estimated current flow through this branch or element in amperes. Critical for thermal limit monitoring and equipment protection."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_amps" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current (Amperes)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:StateEstimationResult.currentMagnitudePu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current magnitude pu"@en ;
    rdfs:comment "The estimated current magnitude expressed in per-unit relative to the element rating. Normalized representation for loading assessment."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_magnitude_pu" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Magnitude (Per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.elementIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element identifier"@en ;
    rdfs:comment "The unique identifier or name of the network element (node, branch, bus, line) in the EMS model. Corresponds to the SCADA point or network model object."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Identifier" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.elementType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element type"@en ;
    rdfs:comment "The type of network element this result represents. Distinguishes between nodes (buses), branches (lines, transformers), generators, and loads in the EMS network model. Reference-value candidates: node|branch|bus|line|transformer|generator|load."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "element_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Type" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.estimationConfidence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation confidence"@en ;
    rdfs:comment "A confidence score (0.0 to 1.0) indicating the reliability of the state estimation for this element based on measurement redundancy and quality."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimation_confidence" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Confidence" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.fromBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "from bus name"@en ;
    rdfs:comment "For branch elements, the name of the originating bus or node. Defines the topology of the power flow path."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "from_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "From Bus Name" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.loadingPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "loading percentage"@en ;
    rdfs:comment "The percentage of the element's rated capacity being utilized based on the estimated power flow. Used for thermal limit and contingency analysis."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "loading_percentage" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Loading Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:StateEstimationResult.measurementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement status"@en ;
    rdfs:comment "The quality status of the measurement used for this element in the state estimation. Indicates whether the measurement was accepted, flagged as suspect, or rejected."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Status" ;
    cmm:validValues "valid|suspect|bad_data|missing|telemetry_failure" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.normalizedResidual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "normalized residual"@en ;
    rdfs:comment "The residual normalized by the measurement standard deviation. Used for bad data detection and measurement validation in state estimation."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "normalized_residual" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Normalized Residual" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.observabilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "observability flag"@en ;
    rdfs:comment "Indicates whether this network element was observable in the state estimation (sufficient measurements available to estimate its state). True if observable, False if unobservable."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "observability_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Observability Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationResult.piTagName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi tag name"@en ;
    rdfs:comment "The OSIsoft PI historian tag name for this measurement point. Enables integration with PI historian for operational analytics and post-event review."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_tag_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSIsoft PI Tag Name" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "The ratio of active power to apparent power at this element. Indicates the efficiency of power transfer and reactive power balance."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(6,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.reactivePowerMvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power mvar"@en ;
    rdfs:comment "The estimated reactive power flow through this branch or injected/consumed at this node in megavolt-amperes reactive. Essential for voltage control and stability."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_mvar" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power (MVAR)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ReactivePower" .
cmm:StateEstimationResult.residual a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "residual"@en ;
    rdfs:comment "The difference between the measured value and the estimated value for this element. Indicates measurement quality and potential bad data."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "residual" ;
    cmm:sqlDataType "DECIMAL(12,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Measurement Residual" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.resultTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "result timestamp"@en ;
    rdfs:comment "The timestamp when this state estimation result was calculated by the EMS state estimator. Represents the real-world event time of the solved network state."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "result_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Result Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:StateEstimationResult.solutionConvergenceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "solution convergence flag"@en ;
    rdfs:comment "Indicates whether the state estimator solution converged for this element. False indicates numerical instability or insufficient measurements."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "solution_convergence_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Solution Convergence Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationResult.substationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "substation name"@en ;
    rdfs:comment "The name of the substation where this network element is located. Provides geographic and operational context for the result."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Substation Name" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.thermalViolationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal violation flag"@en ;
    rdfs:comment "Indicates whether the estimated current or power flow exceeds the thermal rating of this element. Triggers congestion management actions."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "thermal_violation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Thermal Violation Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:StateEstimationResult.toBusName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "to bus name"@en ;
    rdfs:comment "For branch elements, the name of the destination bus or node. Completes the topology definition of the power flow path."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:string ;
    cmm:physicalColumn "to_bus_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "To Bus Name" ;
    cmm:cimDatatype "String" .
cmm:StateEstimationResult.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "The timestamp when this state estimation result record was last updated. Tracks modifications for audit and data quality purposes."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:StateEstimationResult.voltageAngleDegrees a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage angle degrees"@en ;
    rdfs:comment "The estimated voltage phase angle at this node in degrees. Critical for power flow analysis and system stability assessment."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_angle_degrees" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Angle (Degrees)" ;
    cmm:unitSymbol "deg" ;
    cmm:cimDatatype "AngleDegrees" .
cmm:StateEstimationResult.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "The nominal voltage level of the network element in kilovolts. Indicates whether this is transmission (e.g., 500kV, 345kV, 230kV) or sub-transmission (e.g., 138kV, 69kV)."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:StateEstimationResult.voltageMagnitudeKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage magnitude kv"@en ;
    rdfs:comment "The estimated voltage magnitude at this node or element in kilovolts. Core output of the state estimator representing the solved voltage level."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_magnitude_kv" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Magnitude (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .
cmm:StateEstimationResult.voltageMagnitudePu a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage magnitude pu"@en ;
    rdfs:comment "The estimated voltage magnitude expressed in per-unit (pu) relative to the nominal voltage level. Standard normalized representation for power system analysis."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_magnitude_pu" ;
    cmm:sqlDataType "DECIMAL(8,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Magnitude (Per Unit)" ;
    cmm:cimDatatype "Decimal" .
cmm:StateEstimationResult.voltageViolationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violation flag"@en ;
    rdfs:comment "Indicates whether the estimated voltage at this element is outside acceptable operating limits. Triggers voltage control actions."@en ;
    rdfs:domain cmm:StateEstimationResult ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "voltage_violation_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Violation Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:Contingency a owl:Class ;
    rdfs:label "Contingency"@en ;
    rdfs:comment "Master catalog of defined contingency cases (N-1 and N-2 scenarios) with their analysis execution records and violation results from the EMS contingency analysis (CA) function. Master attributes include contingency name, type (line outage, generator trip, transformer loss, bus fault), elements removed, NERC standard applicability (TPL-001 through TPL-004), and severity classification. Analysis run attributes (grain: one row per CA execution) include run timestamp, parent state estimation run reference, contingencies evaluated count, violations detected, worst-case contingency, solution method (full AC/linear DC), and operator acknowledgment. Violation detail attributes (grain: one row per violation per run) include violated element, violation type (thermal overload %, voltage exceedance kV), pre/post-contingency values, applicable rating, and corrective action status. SSOT for contingency definitions, security assessment execution, and N-1/N-2 violation records used in NERC TPL/TOP compliance evidence and real-time operator situational awareness."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Contingency ;
    cmm:cimExactMatch cim:Contingency ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Contingency" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:grid , cmmsa:grid.reliability_management ;
    cmm:physicalTable "utility_cmm_silver.grid.contingency" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "NERC TPL-001; NERC TPL-001 / FAC-002 Contingency List" ;
    cmm:sourceObject "energy_utilities_ecm.grid.contingency" ;
    owl:hasKey ( cmm:Contingency.contingencyId ) .

cmm:Contingency.contingencyId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency id"@en ;
    rdfs:comment "Unique identifier for the contingency case definition. Primary key for the contingency master catalog."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:long ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contingency Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:Contingency.contingencyStateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency state estimation run"@en ;
    rdfs:comment "FK to grid.state_estimation_run.state_estimation_run_id — Each contingency analysis execution (now merged into contingency) is triggered by a converged state estimation run. This FK links the security assessment to the system state it evaluated — critical fo"@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "contingency_state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_contingency_state_estimation_run_id" ;
    cmm:cimAssociation "Contingency.ActivityRecord" .
cmm:Contingency.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Contingencies (N-1 and N-2 scenarios) must be scoped to a specific control area for NERC compliance and operational context. Each contingency case is defined and analyzed within the boundaries of a ba"@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_control_area_id" ;
    cmm:cimAssociation "Contingency.ControlArea" .
cmm:Contingency.createdByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "created by employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Contingency definitions require audit trail of creator for NERC FAC-011 compliance and engineering change management. 'created_by_user' text field should be FK to employee."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "created_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Created By Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_created_by_employee_id" ;
    cmm:cimAssociation "Contingency.ErpPersonnel" .
cmm:Contingency.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Each contingency definition implements specific NERC TPL standard requirements (N-1, N-2 criteria). This link documents which obligation mandates monitoring this contingency, enabling compliance repor"@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_obligation_id" ;
    cmm:cimAssociation "Contingency.Document" .
cmm:Contingency.stateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "state estimation run"@en ;
    rdfs:comment "FK to grid.state_estimation_run.state_estimation_run_id — Contingency analysis runs are triggered after each converged state estimation solution. The CA run references its parent SE run. Required for tracing security assessment results back to the network st"@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_state_estimation_run_id" ;
    cmm:cimAssociation "Contingency.ActivityRecord" .
cmm:Contingency.toStateEstimationRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to state estimation run"@en ;
    rdfs:comment "FK to grid.state_estimation_run.state_estimation_run_id — Contingency analysis runs are triggered after each converged state estimation solution. The parent SE run provides the base-case power flow against which contingencies are evaluated. This is a critica"@en ;
    rdfs:domain cmm:Contingency ; rdfs:range cmm:StateEstimationRun ;
    cmm:physicalColumn "to_state_estimation_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_grid_contingency_to_state_estimation_run_id" ;
    cmm:cimAssociation "Contingency.ActivityRecord" .
cmm:Contingency.alarmThresholdEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "alarm threshold enabled"@en ;
    rdfs:comment "Boolean flag indicating whether operator alarms are triggered when violations are detected for this contingency."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "alarm_threshold_enabled" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Alarm Threshold Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Contingency.analysisMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "analysis method"@en ;
    rdfs:comment "Power flow solution method used for contingency analysis: full AC (alternating current) power flow, linear DC (direct current) approximation, or fast decoupled method."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:string ;
    cmm:physicalColumn "analysis_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Analysis Method" ;
    cmm:validValues "full_ac|linear_dc|fast_decoupled" ;
    cmm:cimDatatype "String" .
cmm:Contingency.complianceEvidenceRetentionYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance evidence retention years"@en ;
    rdfs:comment "Number of years that contingency analysis records and violation evidence must be retained for NERC compliance audits."@en ;
    rdfs:domain cmm:Contingency ; rdfs:range xsd:int ;
