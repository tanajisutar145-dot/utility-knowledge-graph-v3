    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "incident_location" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incident Location" ;
    cmm:cimDatatype "String" .
cmm:Grievance.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
