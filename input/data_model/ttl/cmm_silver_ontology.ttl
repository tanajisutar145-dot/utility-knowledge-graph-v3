    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:date ;
    cmm:physicalColumn "contest_filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contest Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:PenaltyAssessment.contestOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
