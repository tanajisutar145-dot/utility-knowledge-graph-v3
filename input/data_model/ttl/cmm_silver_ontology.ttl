cmm:CreditExposure a owl:Class ;
    rdfs:label "Credit Exposure"@en ;
    rdfs:comment "Counterparty credit exposure record tracking mark-to-market exposure, potential future exposure (PFE), credit limit, collateral posted, and net exposure for each trading counterparty. Captures exposure as of date, credit limit utilization percentage, margin call threshold, collateral type (cash, letter of credit), and credit breach flag. Supports credit risk management and FERC credit reporting obligations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.credit_exposure" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "ETRM Credit Exposure" ;
    cmm:sourceObject "energy_utilities_ecm.trading.credit_exposure" ;
    owl:hasKey ( cmm:CreditExposure.creditExposureId ) .

cmm:CreditExposure.creditExposureId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit exposure id"@en ;
    rdfs:comment "Unique identifier for the counterparty credit exposure record."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:long ;
    cmm:physicalColumn "credit_exposure_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Credit Exposure ID" ;
    cmm:cimDatatype "Integer" .
cmm:CreditExposure.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Credit exposure calculations are audited for compliance with credit policies and FERC credit risk reporting requirements. Internal and external auditors test credit exposure methodology, limit complia"@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_audit_id" ;
    cmm:cimAssociation "Document.ActivityRecord" .
cmm:CreditExposure.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "FK to trading.counterparty.counterparty_id — Credit exposure is calculated per counterparty. This is a fundamental master-detail relationship required for credit risk management and margin call processing."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CreditExposure.creditCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "credit counterparty"@en ;
    rdfs:comment "Identifier of the trading counterparty for which credit exposure is being tracked."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "credit_counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_credit_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CreditExposure.creditForCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "credit_for_counterparty"@en ;
    rdfs:comment "FK to trading.counterparty.counterparty_id — Credit exposure is calculated per counterparty. Without this FK, exposure records cannot be attributed to the correct counterparty for credit limit monitoring and margin call management."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "credit_for_counterparty" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_credit_for_counterparty" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CreditExposure.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Identifier of the risk manager responsible for monitoring and managing this counterparty credit exposure."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Risk Manager ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CreditExposure.nettingAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "netting agreement"@en ;
    rdfs:comment "Identifier of the master netting agreement governing the offsetting of exposures with this counterparty."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:NettingAgreement ;
    cmm:physicalColumn "netting_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Netting Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_netting_agreement_id" ;
    cmm:cimAssociation "Document.Agreement" .
cmm:CreditExposure.toCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to counterparty"@en ;
    rdfs:comment "FK to trading.counterparty.counterparty_id — Credit exposure is calculated per counterparty. This FK is essential for credit limit monitoring, margin call triggers, and FERC credit reporting."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "to_counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_to_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:CreditExposure.tradingDesk a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trading desk"@en ;
    rdfs:comment "Identifier of the trading desk or business unit responsible for transactions with this counterparty."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range cmm:TradingDesk ;
    cmm:physicalColumn "trading_desk_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trading Desk ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_credit_exposure_trading_desk_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:CreditExposure.collateralPostedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collateral posted amount"@en ;
    rdfs:comment "Total value of collateral posted by the counterparty to secure credit exposure, including cash and letters of credit."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "collateral_posted_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collateral Posted Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.collateralType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collateral type"@en ;
    rdfs:comment "Type of collateral instrument posted by the counterparty to mitigate credit risk."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "collateral_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collateral Type" ;
    cmm:validValues "cash|letter_of_credit|parent_guarantee|surety_bond|other" ;
    cmm:cimDatatype "String" .
cmm:CreditExposure.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Free-text field for risk management notes, special conditions, or explanations related to this credit exposure record."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:CreditExposure.confidenceLevelPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence level pct"@en ;
    rdfs:comment "Statistical confidence level used in the potential future exposure calculation, typically 95% or 99%."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_level_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidence Level Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CreditExposure.counterpartyCreditRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty credit rating"@en ;
    rdfs:comment "External credit rating assigned to the counterparty by recognized rating agencies such as Moody's, S&P, or Fitch."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "counterparty_credit_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Counterparty Credit Rating" ;
    cmm:cimDatatype "String" .
cmm:CreditExposure.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this credit exposure record was first created in the system."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:CreditExposure.creditBreachFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit breach flag"@en ;
    rdfs:comment "Indicator of whether the counterparty has breached their approved credit limit, triggering risk management actions."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "credit_breach_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Breach Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditExposure.creditLimitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit limit amount"@en ;
    rdfs:comment "Maximum credit limit approved for this counterparty, representing the threshold beyond which additional trading is restricted."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_limit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Limit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.creditLimitUtilizationPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit limit utilization pct"@en ;
    rdfs:comment "Percentage of the approved credit limit currently utilized, calculated as net exposure divided by credit limit."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_limit_utilization_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Limit Utilization Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:CreditExposure.exposureAsOfDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exposure as of date"@en ;
    rdfs:comment "The business date for which this credit exposure snapshot is calculated."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:date ;
    cmm:physicalColumn "exposure_as_of_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exposure As-Of Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditExposure.exposureCalculationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exposure calculation method"@en ;
    rdfs:comment "Methodology used to calculate potential future exposure, such as Monte Carlo simulation, historical simulation, or variance-covariance approach."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "exposure_calculation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exposure Calculation Method" ;
    cmm:validValues "current_exposure|peak_exposure|monte_carlo|historical_simulation|variance_covariance" ;
    cmm:cimDatatype "String" .
cmm:CreditExposure.exposureCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exposure currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code in which the credit exposure is denominated."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "exposure_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Exposure Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:CreditExposure.exposureStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exposure status"@en ;
    rdfs:comment "Current status of the credit exposure indicating the risk management posture for this counterparty."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "exposure_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Exposure Status" ;
    cmm:validValues "normal|watch|breach|suspended|default" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CreditExposure.fercReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting flag"@en ;
    rdfs:comment "Indicator of whether this credit exposure must be included in FERC regulatory credit risk reporting."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditExposure.internalCreditScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal credit score"@en ;
    rdfs:comment "Internally calculated credit score for the counterparty based on proprietary risk assessment models."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:int ;
    cmm:physicalColumn "internal_credit_score" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Internal Credit Score" ;
    cmm:cimDatatype "Integer" .
cmm:CreditExposure.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "Code identifying the ISO or RTO market in which the counterparty trades, such as CAISO, ERCOT, PJM, MISO, NYISO, ISO-NE, or SPP."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Code" ;
    cmm:cimDatatype "String" .
cmm:CreditExposure.lastReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last review date"@en ;
    rdfs:comment "Date when the counterparty credit exposure was last reviewed by the credit risk management team."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Review Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditExposure.marginCallDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "margin call due date"@en ;
    rdfs:comment "Date by which the counterparty must satisfy the margin call by posting additional collateral."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:date ;
    cmm:physicalColumn "margin_call_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Margin Call Due Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditExposure.marginCallIssuedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "margin call issued flag"@en ;
    rdfs:comment "Indicator of whether a margin call has been issued to the counterparty for this exposure date."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "margin_call_issued_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Margin Call Issued Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditExposure.marginCallThresholdAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "margin call threshold amount"@en ;
    rdfs:comment "Exposure threshold amount that triggers a margin call requiring the counterparty to post additional collateral."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "margin_call_threshold_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Margin Call Threshold Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.mtmExposureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mtm exposure amount"@en ;
    rdfs:comment "Current mark-to-market exposure representing the replacement cost of all outstanding positions with this counterparty."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mtm_exposure_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Mark-to-Market (MTM) Exposure Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.netExposureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net exposure amount"@en ;
    rdfs:comment "Net credit exposure after deducting collateral posted, representing the unsecured credit risk to the utility."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_exposure_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Exposure Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.nettingAgreementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "netting agreement flag"@en ;
    rdfs:comment "Indicator of whether a master netting agreement is in place with the counterparty, allowing offsetting of positive and negative exposures."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "netting_agreement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Netting Agreement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditExposure.nextReviewDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next review date"@en ;
    rdfs:comment "Scheduled date for the next periodic review of the counterparty credit exposure."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_review_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Review Date" ;
    cmm:cimDatatype "Date" .
cmm:CreditExposure.pfeAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pfe amount"@en ;
    rdfs:comment "Estimated potential future exposure representing the maximum expected credit exposure over the life of the transactions, calculated using statistical models and market volatility."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pfe_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Potential Future Exposure (PFE) Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.recTrackingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec tracking flag"@en ;
    rdfs:comment "Indicator of whether this exposure includes positions in renewable energy certificates requiring separate tracking for compliance."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_tracking_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Tracking Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CreditExposure.timeHorizonDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time horizon days"@en ;
    rdfs:comment "Number of days over which the potential future exposure is projected, representing the expected liquidation period."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:int ;
    cmm:physicalColumn "time_horizon_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Horizon Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:CreditExposure.totalExposureAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total exposure amount"@en ;
    rdfs:comment "Total credit exposure calculated as the sum of mark-to-market exposure and potential future exposure before collateral adjustments."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_exposure_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Exposure Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CreditExposure.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this credit exposure record was last modified."@en ;
    rdfs:domain cmm:CreditExposure ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:FtrHolding a owl:Class ;
    rdfs:label "Ftr Holding"@en ;
    rdfs:comment "Financial Transmission Right (FTR) holding record representing the utility's congestion hedging instruments acquired through ISO/RTO FTR auctions. Captures FTR type (obligation/option), source PNode, sink PNode, MW quantity, auction period, acquisition price, current market value, and ISO registration reference. Used for congestion revenue management and hedging strategy."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CRR ;
    cmm:cimCloseMatch cim:CRR ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::CongestionRevenueRights" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.ftr_holding" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 62325-301; Financial Transmission Right (FTR)" ;
    cmm:sourceObject "energy_utilities_ecm.trading.ftr_holding" ;
    owl:hasKey ( cmm:FtrHolding.ftrHoldingId ) .

cmm:FtrHolding.ftrHoldingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr holding id"@en ;
    rdfs:comment "Unique identifier for the FTR holding record. Primary key for the FTR holding entity representing a congestion hedging instrument acquired through ISO/RTO auctions."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:long ;
    cmm:physicalColumn "ftr_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Holding ID" ;
    cmm:cimDatatype "Integer" .
cmm:FtrHolding.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Identifier for the counterparty in secondary market FTR transactions. For auction-acquired FTRs, this references the ISO/RTO as counterparty. For bilateral transfers, references the selling party."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_counterparty_id" ;
    cmm:cimAssociation "CRR.MarketParticipant" .
cmm:FtrHolding.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: FTR valuation depends on congestion price forecasts between source and sink nodes. Portfolio managers link FTR holdings to price forecasts to calculate expected congestion revenue, assess hedge effect"@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_energy_price_id" ;
    cmm:cimAssociation "CRR.RegularIntervalSchedule" .
cmm:FtrHolding.hedgeStrategy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hedge strategy"@en ;
    rdfs:comment "Foreign key linking to trading.hedge_strategy. Business justification: FTR holdings are congestion hedging instruments that should be linked to the formal hedge_strategy that authorized their acquisition. The existing 'hedging_strategy' STRING attribute is a denormalized"@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:HedgeStrategy ;
    cmm:physicalColumn "hedge_strategy_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Hedge Strategy Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_hedge_strategy_id" ;
    cmm:cimAssociation "CRR.Document" .
cmm:FtrHolding.portfolio a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "portfolio"@en ;
    rdfs:comment "Identifier linking this FTR holding to a trading portfolio or book within the Energy Trading and Risk Management (ETRM) system. Used for position aggregation and risk reporting."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:TradingPortfolio ;
    cmm:physicalColumn "portfolio_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Portfolio ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_portfolio_id" ;
    cmm:cimAssociation "CRR.Document" .
cmm:FtrHolding.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: FTR holdings and auction results are reported in FERC market power analyses and transmission rate cases. Regulatory affairs reports FTR positions in market-based rate triennial filings and transmissio"@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_regulatory_filing_id" ;
    cmm:cimAssociation "CRR.Document" .
cmm:FtrHolding.sinkPnode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sink pnode"@en ;
    rdfs:comment "The ISO/RTO pricing node identifier representing the sink (withdrawal) point of the FTR path. Used to calculate Locational Marginal Price (LMP) differences for congestion revenue."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:TradingPnode ;
    cmm:physicalColumn "sink_pnode_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Sink Pricing Node (PNode) ID" ;
    cmm:sourceColumn "pnode_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_sink_pnode_id" ;
    cmm:cimAssociation "CRR.Pnode" .
cmm:FtrHolding.sourcePnode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "source pnode"@en ;
    rdfs:comment "The ISO/RTO pricing node identifier representing the source (injection) point of the FTR path. Used to calculate Locational Marginal Price (LMP) differences for congestion revenue."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range cmm:TradingPnode ;
    cmm:physicalColumn "source_pnode_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Source Pricing Node (PNode) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ftr_holding_source_pnode_id" ;
    cmm:cimAssociation "CRR.Pnode" .
cmm:FtrHolding.accountingTreatment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accounting treatment"@en ;
    rdfs:comment "The financial accounting method applied to this FTR holding. Hedge accounting defers gains/losses to match hedged items; mark-to-market recognizes fair value changes immediately; accrual recognizes revenue as earned."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "accounting_treatment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accounting Treatment" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii" ;
    cmm:validValues "hedge_accounting|mark_to_market|accrual" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.accumulatedPayout a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accumulated payout"@en ;
    rdfs:comment "The cumulative congestion revenue (or charge for obligations) in USD received from the ISO/RTO since the FTR became effective. Positive values indicate net revenue; negative values indicate net charges."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "accumulated_payout" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accumulated Payout" ;
    cmm:cimDatatype "Decimal" .
cmm:FtrHolding.acquisitionPricePerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition price per mw"@en ;
    rdfs:comment "The price paid per MW in the FTR auction to acquire this holding, expressed in USD per MW. Used to calculate total acquisition cost and evaluate hedging effectiveness."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_price_per_mw" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acquisition Price per Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FtrHolding.auctionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction date"@en ;
    rdfs:comment "The date on which the FTR auction was conducted and this holding was acquired. Critical for tracking acquisition timing and market conditions."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "auction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Date" ;
    cmm:cimDatatype "Date" .
cmm:FtrHolding.auctionPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction period"@en ;
    rdfs:comment "The time period identifier for which this FTR was auctioned, typically in format YYYY-MM or YYYY for annual auctions. Defines the delivery period for the hedging instrument."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Period" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.auctionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction type"@en ;
    rdfs:comment "Classification of the ISO/RTO auction through which this FTR was acquired. Annual and monthly are standard forward auctions; long-term covers multi-year; reconfiguration allows secondary market adjustments."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Auction Type" ;
    cmm:validValues "annual|monthly|long-term|reconfiguration" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The timestamp when this FTR holding record was first created in the ETRM system. Used for audit trails and data lineage tracking."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CRR.createdDateTime .
cmm:FtrHolding.creditRequirementAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit requirement amount"@en ;
    rdfs:comment "The collateral or credit amount in USD required by the ISO/RTO to maintain this FTR position. Based on market exposure and counterparty credit rating."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_requirement_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Requirement Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FtrHolding.currentMarketValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current market value"@en ;
    rdfs:comment "The current estimated market value in USD of this FTR holding based on recent auction clearing prices or secondary market transactions. Updated periodically for mark-to-market valuation."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_market_value" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Market Value" ;
    cmm:cimDatatype "Decimal" .
cmm:FtrHolding.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "The date when this FTR holding expires and stops accruing congestion revenue or charges. Marks the end of the delivery period."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:FtrHolding.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "The date when this FTR holding becomes effective and begins accruing congestion revenue or charges. Marks the beginning of the delivery period."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:FtrHolding.ftrClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr class"@en ;
    rdfs:comment "Time-of-use classification defining when the FTR is effective. On-peak covers high-demand hours, off-peak covers low-demand hours, 24-hour covers all hours."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "ftr_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Class" ;
    cmm:validValues "on-peak|off-peak|24-hour" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.ftrContractNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr contract number"@en ;
    rdfs:comment "The externally-known unique contract identifier assigned by the ISO/RTO for this FTR holding. Used for market settlement reconciliation and regulatory reporting."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "ftr_contract_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Contract Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:FtrHolding.ftrInBook a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr in book"@en ;
    rdfs:comment "FK to trading.trading_book.trading_book_id — FTR holdings are managed within trading books for P&L attribution and congestion hedging strategy tracking."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:long ;
    cmm:physicalColumn "ftr_in_book" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:FtrHolding.ftrSinkPnode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr sink pnode"@en ;
    rdfs:comment "FK to trading.pnode.pnode_id — FTR holdings require both source and sink PNode references for congestion revenue calculation."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:long ;
    cmm:physicalColumn "ftr_sink_pnode" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:FtrHolding.ftrSourcePnode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr source pnode"@en ;
    rdfs:comment "FK to trading.pnode.pnode_id — FTR holdings define source and sink PNodes — the congestion path. Without PNode FKs, FTR valuation against LMP differentials is impossible."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:long ;
    cmm:physicalColumn "ftr_source_pnode" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:FtrHolding.ftrType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr type"@en ;
    rdfs:comment "Classification of the FTR instrument. Obligation FTRs pay or charge based on congestion price differences; Option FTRs only pay when positive. Critical for risk management and hedging strategy."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "ftr_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Type" ;
    cmm:validValues "obligation|option" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CRR.type .
cmm:FtrHolding.hedgeEffectivenessRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge effectiveness ratio"@en ;
    rdfs:comment "A calculated metric (0 to 1) representing how effectively this FTR hedges the underlying congestion exposure. Values near 1 indicate highly effective hedges; values near 0 indicate poor correlation."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hedge_effectiveness_ratio" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Effectiveness Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:FtrHolding.holdingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "holding status"@en ;
    rdfs:comment "Current lifecycle status of the FTR holding. Active holdings are accruing revenue; expired holdings have passed their end date; transferred holdings have been sold or reassigned; terminated holdings were cancelled before expiration."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "holding_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Holding Status" ;
    cmm:validValues "active|expired|transferred|terminated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CRR.status .
cmm:FtrHolding.isoRegistrationReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso registration reference"@en ;
    rdfs:comment "The ISO/RTO system reference number or registration ID linking this FTR holding to the market operators records. Used for settlement reconciliation and dispute resolution."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_registration_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) Registration Reference" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "The ISO or RTO market operator code where this FTR was acquired and is registered. Critical for market-specific settlement rules and reporting requirements. Reference-value candidates: CAISO|ERCOT|ISONE|MISO|NYISO|PJM|SPP."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Code" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The timestamp when this FTR holding record was most recently updated. Used for change tracking and audit compliance."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FtrHolding.lastSettlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last settlement date"@en ;
    rdfs:comment "The date of the most recent ISO/RTO settlement payment or charge for this FTR holding. Used to track payment timing and reconcile accumulated payouts."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Settlement Date" ;
    cmm:cimDatatype "Date" .
cmm:FtrHolding.modifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified by user"@en ;
    rdfs:comment "The username or identifier of the person or system that last modified this FTR holding record. Used for audit trails and accountability."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "modified_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Modified By User" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.mwQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mw quantity"@en ;
    rdfs:comment "The contracted capacity in megawatts for this FTR holding. Represents the hedging volume for congestion cost exposure between source and sink nodes."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mw_quantity" ;
    cmm:sqlDataType "DECIMAL(18,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megawatt (MW) Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:FtrHolding.nextSettlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next settlement date"@en ;
    rdfs:comment "The expected date of the next ISO/RTO settlement payment or charge for this FTR holding. Used for cash flow forecasting and liquidity management."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Settlement Date" ;
    cmm:cimDatatype "Date" .
cmm:FtrHolding.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, special conditions, or operational notes related to this FTR holding. Used for audit trails and business context."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:FtrHolding.regulatoryReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this FTR holding must be included in regulatory filings to FERC, state PUCs, or other governing bodies. True indicates reportable position."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FtrHolding.riskCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk category"@en ;
    rdfs:comment "Internal risk classification for this FTR holding based on factors such as path volatility, counterparty credit, and portfolio concentration. Used for risk management and reporting."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "risk_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Category" ;
    cmm:validValues "low|medium|high|critical" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.settlementFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement frequency"@en ;
    rdfs:comment "The frequency at which the ISO/RTO settles and pays out congestion revenue for this FTR holding. Most ISOs settle monthly; some offer quarterly or annual options."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Frequency" ;
    cmm:validValues "monthly|quarterly|annual" ;
    cmm:cimDatatype "String" .
cmm:FtrHolding.totalAcquisitionCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total acquisition cost"@en ;
    rdfs:comment "The total cost in USD paid to acquire this FTR holding, calculated as MW quantity multiplied by acquisition price per MW. Represents the upfront investment in the congestion hedge."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_acquisition_cost" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Acquisition Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FtrHolding.transmissionPathDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transmission path description"@en ;
    rdfs:comment "A human-readable description of the transmission path covered by this FTR, typically including geographic or operational context (e.g., 'West Zone to East Zone', 'Generator X to Load Center Y')."@en ;
    rdfs:domain cmm:FtrHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "transmission_path_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Path Description" ;
    cmm:cimDatatype "String" .

cmm:RecHolding a owl:Class ;
    rdfs:label "Rec Holding"@en ;
    rdfs:comment "Renewable Energy Certificate (REC) inventory master and transaction ledger tracking the complete lifecycle of RECs acquired, generated, retired, sold, or transferred by the utility. Captures holding state: REC registry ID (WREGIS/NEPOOL-GIS/M-RETS/NC-RETS), vintage year, fuel type, generation facility, state of generation, RPS compliance eligibility, quantity (MWh), acquisition cost, current status, and retirement status. Tracks all transaction movements: transaction type (purchase, sale, retirement, transfer, import, export), quantity (MWh), transaction price, counterparty, registry transaction ID, compliance program (RPS, voluntary, green-e), retirement reason, and transaction timestamp. Supports WREGIS/NEPOOL-GIS reporting, RPS compliance filings, voluntary green power program tracking, and REC audit trail. SSOT for all REC inventory and movement within the trading domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.rec_holding" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "WREGIS; M-RETS; Renewable Energy Certificate (REC)" ;
    cmm:sourceObject "energy_utilities_ecm.trading.rec_holding" ;
    owl:hasKey ( cmm:RecHolding.recHoldingId ) .

cmm:RecHolding.recHoldingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec holding id"@en ;
    rdfs:comment "Unique identifier for the REC holding record. Primary key for the REC inventory and transaction ledger."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:long ;
    cmm:physicalColumn "rec_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Holding ID" ;
    cmm:cimDatatype "Integer" .
cmm:RecHolding.complianceRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance rec certificate"@en ;
    rdfs:comment "Foreign key linking to compliance.rec_certificate. Business justification: REC holdings in trading systems must reconcile with compliance REC certificates in registry systems. Compliance teams verify trading positions match registry certificates for RPS compliance reporting,"@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range cmm:ComplianceRecCertificate ;
    cmm:physicalColumn "compliance_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Rec Certificate Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_holding_compliance_rec_certificate_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RecHolding.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Unique identifier for the counterparty in the ETRM system. Links to the counterparty master for credit limit and settlement tracking."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_holding_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:RecHolding.ppaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ppa contract"@en ;
    rdfs:comment "Identifier of the PPA contract under which this REC was acquired, if applicable. Links the REC to the underlying bilateral power purchase agreement."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Purchase Agreement (PPA) Contract ID" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_holding_ppa_contract_id" ;
    cmm:cimAssociation "Document.Agreement" .
cmm:RecHolding.renewableRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable rec certificate"@en ;
    rdfs:comment "Foreign key linking to renewable.renewable_rec_certificate. Business justification: Links REC trading positions to physical certificates issued by renewable facilities. Essential for registry reconciliation, compliance reporting, and settlement validation. Removes denormalized facili"@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range cmm:RenewableRecCertificate ;
    cmm:physicalColumn "renewable_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Rec Certificate Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_holding_renewable_rec_certificate_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:RecHolding.acquisitionCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition cost usd"@en ;
    rdfs:comment "Total cost paid by the utility to acquire this REC holding, denominated in US dollars. Used for cost basis tracking and financial reporting."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "acquisition_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acquisition Cost (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RecHolding.acquisitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition date"@en ;
    rdfs:comment "Date when the utility acquired ownership of this REC. Used for cost basis tracking and inventory aging analysis."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "acquisition_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Acquisition Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.purchaseDate .
cmm:RecHolding.acquisitionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acquisition type"@en ;
    rdfs:comment "Method by which the utility acquired this REC. Indicates whether the REC was purchased from a third party, generated by utility-owned assets, or transferred from another account."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "acquisition_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acquisition Type" ;
    cmm:validValues "purchase|self_generation|transfer_in|import|allocation" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.complianceProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance program"@en ;
    rdfs:comment "Type of compliance or voluntary program for which this REC is designated. Indicates whether the REC is used for mandatory RPS compliance, voluntary green power programs, or carbon offset initiatives."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Program" ;
    cmm:validValues "state_rps|voluntary|green_e|carbon_offset|none" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.complianceYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance year"@en ;
    rdfs:comment "Calendar year for which this REC is or was used to meet RPS compliance obligations. May differ from vintage year due to banking and forward compliance rules."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:int ;
    cmm:physicalColumn "compliance_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Year" ;
    cmm:cimDatatype "Integer" .
cmm:RecHolding.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this REC holding record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:RecHolding.etrmDealCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "etrm deal code"@en ;
    rdfs:comment "Unique deal identifier in the OpenLink Endur ETRM system. Links the REC holding to the trading deal for position management and risk reporting."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "etrm_deal_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Trading and Risk Management (ETRM) Deal ID" ;
    cmm:valuePattern "^[A-Z0-9-]{6,30}$" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.expirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "expiration date"@en ;
    rdfs:comment "Date when this REC expires and can no longer be used for compliance or sold. Based on registry rules and state-specific banking limitations."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Expiration Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:RecHolding.generationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation date"@en ;
    rdfs:comment "Date when the renewable energy generation occurred. Used for vintage year determination and compliance tracking."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "generation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Date" ;
    cmm:cimDatatype "Date" .
cmm:RecHolding.greenECertifiedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "green e certified flag"@en ;
    rdfs:comment "Indicates whether this REC meets Green-e certification standards for voluntary renewable energy programs. Green-e certification requires additional eligibility criteria beyond basic RPS compliance."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "green_e_certified_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Green-e Certified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RecHolding.holdingStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "holding status"@en ;
    rdfs:comment "Current lifecycle status of the REC holding. Indicates whether the REC is available for use, has been retired for compliance, sold to a counterparty, or is in a pending transaction state."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "holding_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Holding Status" ;
    cmm:validValues "active|retired|sold|transferred|expired|pending" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:RecHolding.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this REC holding record was last updated. Used for change tracking and audit trail."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RecHolding.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes and comments related to this REC holding. Used for documenting special circumstances, compliance decisions, or transaction details."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:RecHolding.portfolioName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "portfolio name"@en ;
    rdfs:comment "Name of the trading portfolio or book to which this REC holding is assigned. Used for position aggregation and P&L reporting."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "portfolio_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Portfolio Name" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.quantityMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quantity mwh"@en ;
    rdfs:comment "Quantity of renewable energy represented by this REC holding, measured in megawatt-hours. One REC typically represents one MWh of renewable generation."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "quantity_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Quantity (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RecHolding.registryTransactionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "registry transaction code"@en ;
    rdfs:comment "Unique transaction identifier assigned by the REC registry system for this transfer, retirement, or issuance. Provides audit trail linkage to the external registry."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "registry_transaction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Registry Transaction ID" ;
    cmm:valuePattern "^[A-Z0-9-]{8,50}$" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.retirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement date"@en ;
    rdfs:comment "Date when this REC was retired in the registry system. Null if the REC has not been retired. Used for compliance period tracking and audit trail."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Retirement Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:RecHolding.retirementReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement reason"@en ;
    rdfs:comment "Business reason for retiring this REC. Provides audit trail for compliance filings and voluntary program tracking."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "retirement_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retirement Reason" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.retirementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement status"@en ;
    rdfs:comment "Indicates whether and why this REC has been retired. Retired RECs cannot be sold or transferred and represent the final disposition of the environmental attribute."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "retirement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retirement Status" ;
    cmm:validValues "not_retired|retired_compliance|retired_voluntary|retired_green_power|retired_carbon" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.rpsComplianceEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps compliance eligible flag"@en ;
    rdfs:comment "Indicates whether this REC is eligible for use in meeting state RPS compliance obligations. Eligibility is determined by fuel type, vintage, generation location, and state-specific rules."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rps_compliance_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Compliance Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RecHolding.rpsTier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps tier"@en ;
    rdfs:comment "RPS tier classification for this REC based on state-specific renewable energy portfolio standards. Different tiers have different compliance values and eligibility rules."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "rps_tier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "RPS Tier Classification" ;
    cmm:validValues "tier_1|tier_2|tier_3|not_eligible" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.settlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement date"@en ;
    rdfs:comment "Date when financial settlement for this REC transaction occurred. Used for cash flow tracking and accounts payable/receivable reconciliation."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Date" ;
    cmm:cimDatatype "Date" .
cmm:RecHolding.transactionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction date"@en ;
    rdfs:comment "Date when the REC transaction was executed. Represents the business event timestamp for inventory movement and financial settlement."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:date ;
    cmm:physicalColumn "transaction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Date" ;
    cmm:cimDatatype "Date" .
cmm:RecHolding.transactionPriceUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction price usd"@en ;
    rdfs:comment "Price per megawatt-hour for this REC transaction. Used for mark-to-market valuation, revenue recognition, and market price benchmarking."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "transaction_price_usd" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Price per MWh (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RecHolding.transactionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction type"@en ;
    rdfs:comment "Type of transaction that created or modified this REC holding record. Tracks all movements in the REC inventory ledger. Reference-value candidates: purchase|sale|retirement|transfer_in|transfer_out|import|export."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Type" ;
    cmm:cimDatatype "String" .
cmm:RecHolding.unitCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit cost usd"@en ;
    rdfs:comment "Cost per megawatt-hour paid for this REC. Calculated as acquisition cost divided by quantity. Used for market pricing analysis and portfolio valuation."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "unit_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unit Cost per MWh (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RecHolding.vintageYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vintage year"@en ;
    rdfs:comment "Calendar year in which the renewable energy generation occurred that created this REC. Critical for RPS compliance eligibility and market valuation."@en ;
    rdfs:domain cmm:RecHolding ; rdfs:range xsd:int ;
    cmm:physicalColumn "vintage_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vintage Year" ;
    cmm:cimDatatype "Integer" .

cmm:RecTransaction a owl:Class ;
    rdfs:label "Rec Transaction"@en ;
    rdfs:comment "REC transfer and retirement transaction record capturing the movement of RECs between registry accounts. Captures transaction type (purchase, sale, retirement, transfer), quantity (MWh), transaction price, counterparty, registry transaction ID, compliance program (RPS, voluntary), retirement reason, and transaction timestamp. Supports WREGIS/NEPOOL-GIS reporting and RPS compliance filings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.rec_transaction" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "REC Registry Transaction (WREGIS/NEPOOL-GIS)" ;
    cmm:sourceObject "energy_utilities_ecm.trading.rec_transaction" ;
    owl:hasKey ( cmm:RecTransaction.recTransactionId ) .

cmm:RecTransaction.recTransactionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec transaction id"@en ;
    rdfs:comment "Unique identifier for the REC transaction record. Primary key for the rec_transaction product."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:long ;
    cmm:physicalColumn "rec_transaction_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Transaction ID" ;
    cmm:cimDatatype "Integer" .
cmm:RecTransaction.complianceRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance rec certificate"@en ;
    rdfs:comment "Foreign key linking to compliance.rec_certificate. Business justification: REC transactions (purchases, sales, retirements) must reference specific compliance certificates being transferred. Essential audit trail from trading transaction to registry certificate retirement fo"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:ComplianceRecCertificate ;
    cmm:physicalColumn "compliance_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Rec Certificate Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_compliance_rec_certificate_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:RecTransaction.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: REC transactions are allocated to cost centers for compliance cost tracking and RPS program accounting. Real business process: state RPS compliance reports require cost center-level REC transaction da"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_cost_center_id" ;
    cmm:cimAssociation "ActivityRecord.Organisation" .
cmm:RecTransaction.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "FK to trading.counterparty"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_counterparty_id" ;
    cmm:cimAssociation "ActivityRecord.MarketParticipant" .
cmm:RecTransaction.derInterconnectionPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection point"@en ;
    rdfs:comment "Foreign key linking to distribution.der_interconnection_point. Business justification: REC transactions must track generation source facility. DER interconnection points identify the physical generation asset, essential for REC registry compliance, renewable attribute verification, and"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:DerInterconnectionPoint ;
    cmm:physicalColumn "der_interconnection_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Interconnection Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_der_interconnection_point_id" ;
    cmm:cimAssociation "ActivityRecord.ConnectivityNode" .
cmm:RecTransaction.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Foreign key linking to interconnection.der_system. Business justification: REC sale/purchase/retirement transactions require linking to originating DER facility for audit trail, eligibility verification, and compliance reporting. Enables tracking which interconnected systems"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Generation Facility Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_der_system_id" ;
    cmm:cimAssociation "ActivityRecord.PowerElectronicsConnection" .
cmm:RecTransaction.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: REC transactions must post to specific GL accounts for revenue recognition and inventory accounting. Real business process: monthly close requires REC sales/purchases to hit correct GL accounts for GA"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_gl_account_id" ;
    cmm:cimAssociation "ActivityRecord.ErpChartOfAccounts" .
cmm:RecTransaction.primaryRecCounterpartyAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary rec counterparty account"@en ;
    rdfs:comment "Registry account identifier for the counterparty organization. This is the account number in the REC registry system (WREGIS, NEPOOL-GIS, etc.) from which RECs are received or to which RECs are sent."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "primary_rec_counterparty_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_primary_rec_counterparty_account_id" ;
    cmm:cimAssociation "ActivityRecord.CustomerAccount" .
cmm:RecTransaction.recHolding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rec holding"@en ;
    rdfs:comment "FK to trading.rec_holding.rec_holding_id — REC transactions (purchase, sale, retirement) modify REC holdings. This FK is required for inventory reconciliation and RPS compliance tracking."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:RecHolding ;
    cmm:physicalColumn "rec_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_rec_holding_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:RecTransaction.renewableRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable rec certificate"@en ;
    rdfs:comment "Foreign key linking to renewable.renewable_rec_certificate. Business justification: Connects REC buy/sell transactions to underlying physical certificates for registry transfer validation, compliance tracking, and audit trails. Removes denormalized facility attributes now available t"@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range cmm:RenewableRecCertificate ;
    cmm:physicalColumn "renewable_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Rec Certificate Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_rec_transaction_renewable_rec_certificate_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:RecTransaction.brokerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "broker name"@en ;
    rdfs:comment "Name of the broker or intermediary who facilitated the REC transaction, if applicable. Null for direct bilateral transactions or internal transfers."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "broker_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Broker Name" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.complianceProgram a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance program"@en ;
    rdfs:comment "Name of the regulatory compliance program or voluntary program for which these RECs are intended. Examples: California RPS, Oregon RPS, Washington RPS, voluntary green power program, corporate sustainability commitment. May be null for speculative trading positions."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_program" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Program" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.complianceYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance year"@en ;
    rdfs:comment "Calendar year for which these RECs will be applied toward compliance obligations or voluntary commitments. RECs are typically vintage-dated and must be used within specified timeframes per program rules."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:int ;
    cmm:physicalColumn "compliance_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance Year" ;
    cmm:cimDatatype "Integer" .
cmm:RecTransaction.contractReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract reference"@en ;
    rdfs:comment "Reference number or identifier for the underlying contract or Power Purchase Agreement (PPA) associated with this REC transaction. Links the REC transaction to the commercial agreement. Null for spot market transactions."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "contract_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Reference" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this REC transaction record was first created in the internal system. Audit trail field for data lineage and compliance reporting."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ActivityRecord.createdDateTime .
cmm:RecTransaction.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the transaction amount. Typically USD for North American REC markets."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:RecTransaction.deliveryMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delivery method"@en ;
    rdfs:comment "Method by which the renewable energy and RECs were delivered. Bundled: RECs delivered with the physical electricity. Unbundled: RECs traded separately from electricity. Firmed and shaped: intermittent renewable energy firmed with conventional generation. Delivery method affects RPS compliance eligibility in many states."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "delivery_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Delivery Method" ;
    cmm:validValues "bundled|unbundled|firmed_shaped" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.eligibilityFlags a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligibility flags"@en ;
    rdfs:comment "Comma-separated list of compliance program eligibility certifications for these RECs. Examples: CA_RPS_Tier1, OR_RPS_Bundled, WA_RPS_Eligible, Green-e_Certified. Programs have specific eligibility criteria based on fuel type, location, vintage, and delivery method."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligibility_flags" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Eligibility Flags" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.generationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation end date"@en ;
    rdfs:comment "End date of the generation period for the renewable energy represented by these RECs. Defines the vintage period along with generation_start_date."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:date ;
    cmm:physicalColumn "generation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation End Date" ;
    cmm:cimDatatype "Date" .
cmm:RecTransaction.generationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation start date"@en ;
    rdfs:comment "Start date of the generation period for the renewable energy represented by these RECs. RECs are typically issued for monthly or quarterly generation periods."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:date ;
    cmm:physicalColumn "generation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:RecTransaction.modifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "modified timestamp"@en ;
    rdfs:comment "Date and time when this REC transaction record was last modified in the internal system. Audit trail field for change tracking and compliance reporting."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:RecTransaction.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional notes, comments, or special instructions related to the REC transaction. May include details about transaction purpose, special handling requirements, or reconciliation notes."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:RecTransaction.recQuantityMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec quantity mwh"@en ;
    rdfs:comment "Quantity of RECs transferred in this transaction, measured in megawatt-hours (MWh). Each REC typically represents 1 MWh of renewable energy generation."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "rec_quantity_mwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Quantity in Megawatt-Hours (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:RecTransaction.registryTransactionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "registry transaction code"@en ;
    rdfs:comment "External transaction identifier assigned by the REC registry system (WREGIS, NEPOOL-GIS, M-RETS, NAR, etc.). This is the authoritative reference number for the transaction in the external registry."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "registry_transaction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Registry Transaction ID" ;
    cmm:valuePattern "^[A-Z0-9-]{8,50}$" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.retirementBeneficiary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement beneficiary"@en ;
    rdfs:comment "Name of the organization or program on whose behalf the RECs are being retired. For compliance retirements, this is typically the utility itself. For voluntary programs, this may be a customer or corporate partner. Null for non-retirement transactions."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "retirement_beneficiary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retirement Beneficiary" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.retirementReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "retirement reason"@en ;
    rdfs:comment "Business reason for retiring the RECs, if transaction_type is retirement. Examples: RPS compliance obligation, voluntary green power program, corporate sustainability goal, customer green tariff fulfillment. Null for non-retirement transactions."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "retirement_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Retirement Reason" ;
    cmm:cimDatatype "String" .
cmm:RecTransaction.settlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement date"@en ;
    rdfs:comment "Date when the REC transaction was fully settled and ownership transfer was completed in the registry. May differ from transaction_timestamp for multi-day settlement cycles."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:date ;
    cmm:physicalColumn "settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Date" ;
    cmm:cimDatatype "Date" .
cmm:RecTransaction.totalTransactionAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total transaction amount"@en ;
    rdfs:comment "Total monetary value of the REC transaction, calculated as rec_quantity_mwh multiplied by transaction_price_per_rec. Denominated in USD. Zero for non-monetary transactions (transfers, retirements without purchase)."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_transaction_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Transaction Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RecTransaction.tradeConfirmationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trade confirmation number"@en ;
    rdfs:comment "Confirmation number from the Energy Trading and Risk Management (ETRM) system (e.g., OpenLink Endur) that links this REC transaction to the trading deal. Used for reconciliation between registry transactions and trading positions."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "trade_confirmation_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trade Confirmation Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:RecTransaction.transactionPricePerRec a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction price per rec"@en ;
    rdfs:comment "Unit price paid or received per REC in this transaction, denominated in USD. For purchases this is the acquisition cost; for sales this is the revenue per REC. May be zero for internal transfers or retirements."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "transaction_price_per_rec" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Price Per Renewable Energy Certificate (REC)" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:RecTransaction.transactionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction status"@en ;
    rdfs:comment "Current lifecycle status of the REC transaction: pending (awaiting approval), approved (authorized but not yet settled), completed (fully executed and settled), rejected (denied by registry or counterparty), cancelled (withdrawn before completion), reversed (unwound after completion)."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transaction Status" ;
    cmm:validValues "pending|approved|completed|rejected|cancelled|reversed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:RecTransaction.transactionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction timestamp"@en ;
    rdfs:comment "Date and time when the REC transaction was executed or recorded in the registry system. This is the authoritative business event timestamp for the transaction."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "transaction_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transaction Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:RecTransaction.transactionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transaction type"@en ;
    rdfs:comment "Type of REC transaction: purchase (acquiring RECs from counterparty), sale (selling RECs to counterparty), transfer (internal account movement), retirement (permanent removal from circulation for compliance or voluntary use), import (receiving from another registry), export (sending to another registry)."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:string ;
    cmm:physicalColumn "transaction_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Transaction Type" ;
    cmm:validValues "purchase|sale|transfer|retirement|import|export" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.type .
cmm:RecTransaction.vintageYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vintage year"@en ;
    rdfs:comment "Calendar year in which the renewable energy was generated. RECs are vintage-dated and many compliance programs have vintage eligibility windows (e.g., current year plus 2 prior years)."@en ;
    rdfs:domain cmm:RecTransaction ; rdfs:range xsd:int ;
    cmm:physicalColumn "vintage_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vintage Year" ;
    cmm:cimDatatype "Integer" .

cmm:AncillaryServiceAward a owl:Class ;
    rdfs:label "Ancillary Service Award"@en ;
    rdfs:comment "Ancillary service procurement record capturing the utility's acquisition of grid support services through ISO/RTO markets or bilateral contracts. Captures service type, resource ID, procured MW, procurement price ($/MW-hr), market interval, ISO award reference, and cost allocation to transmission or distribution tariff. Supports FERC ancillary service cost reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:AncillaryServiceClearing ;
    cmm:cimCloseMatch cim:AncillaryServiceClearing ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::MarketResults" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.ancillary_service_award" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 62325-301; ISO Ancillary Service Procurement" ;
    cmm:sourceObject "energy_utilities_ecm.trading.ancillary_service_award" ;
    owl:hasKey ( cmm:AncillaryServiceAward.ancillaryServiceAwardId ) .

cmm:AncillaryServiceAward.ancillaryServiceAwardId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary service award id"@en ;
    rdfs:comment "Primary key for ancillary_service_award"@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:long ;
    cmm:physicalColumn "ancillary_service_award_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Ancillary Service Award Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:AncillaryServiceAward.contract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contract"@en ;
    rdfs:comment "Identifier of the bilateral contract or master agreement governing this ancillary service procurement. Null for ISO/RTO market procurements without underlying contracts."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:TradingContract ;
    cmm:physicalColumn "contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contract ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_contract_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.Agreement" .
cmm:AncillaryServiceAward.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Identifier of the counterparty providing the ancillary service in bilateral contracts. Null for ISO/RTO market procurements or self-supply arrangements."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_counterparty_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.MarketParticipant" .
cmm:AncillaryServiceAward.derSystem a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der system"@en ;
    rdfs:comment "Identifier of the generation or demand response resource providing the ancillary service. May reference utility-owned assets or third-party resources registered with the ISO/RTO."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:DerSystem ;
    cmm:physicalColumn "der_system_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Resource ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_der_system_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.PowerElectronicsConnection" .
cmm:AncillaryServiceAward.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Ancillary service procurement costs are reported in rate cases and cost recovery filings. Regulatory affairs justifies ancillary service costs in rate proceedings with specific procurement records, de"@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_regulatory_filing_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.Document" .
cmm:AncillaryServiceAward.schedulingCoordinator a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scheduling coordinator"@en ;
    rdfs:comment "Identifier of the scheduling coordinator responsible for submitting bids and managing settlements for this ancillary service. Relevant in ISO/RTO markets with SC intermediaries."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:SchedulingCoordinator ;
    cmm:physicalColumn "scheduling_coordinator_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scheduling Coordinator (SC) ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_scheduling_coordinator_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.SchedulingCoordinator" .
cmm:AncillaryServiceAward.settlementStatement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "settlement statement"@en ;
    rdfs:comment "Reference to the ISO/RTO settlement statement or invoice that includes this ancillary service charge. Used for financial reconciliation and dispute management."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range cmm:SettlementStatement ;
    cmm:physicalColumn "settlement_statement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Settlement Statement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ancillary_service_award_settlement_statement_id" ;
    cmm:cimAssociation "AncillaryServiceClearing.MarketStatement" .
cmm:AncillaryServiceAward.actualDeploymentMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual deployment mw"@en ;
    rdfs:comment "Actual megawatts of ancillary service deployed or dispatched during the interval. May differ from procured capacity if the service was not called upon or only partially deployed."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_deployment_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Deployment (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceAward.awardReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "award reference number"@en ;
    rdfs:comment "External reference number assigned by the ISO/RTO or bilateral contract for this ancillary service award. Used for reconciliation with market settlement statements."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "award_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Award Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:AncillaryServiceAward.awardStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "award status"@en ;
    rdfs:comment "Current lifecycle status of the ancillary service award. Tracks progression from initial award through confirmation, settlement, and any dispute resolution."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "award_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Award Status" ;
    cmm:validValues "awarded|confirmed|settled|disputed|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AncillaryServiceClearing.status .
cmm:AncillaryServiceAward.clearedPricePerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cleared price per mw"@en ;
    rdfs:comment "Market clearing price or contract price for the ancillary service, expressed in currency per megawatt per hour. Used to calculate total procurement cost."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cleared_price_per_mw" ;
    cmm:sqlDataType "DECIMAL(12,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cleared Price per MW (Megawatt)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceAward.costAllocationCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation category"@en ;
    rdfs:comment "Regulatory cost allocation category determining how the ancillary service cost is recovered through tariffs. Aligns with FERC and state PUC rate design principles."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Category" ;
    cmm:validValues "transmission_tariff|distribution_tariff|generation_cost|wholesale_market" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this ancillary service procurement record was first created in the system. Supports audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:AncillaryServiceClearing.createdDateTime .
cmm:AncillaryServiceAward.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this record. Typically USD for North American utilities."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:validValues "USD|CAD|MXN" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:AncillaryServiceAward.deploymentPayment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deployment payment"@en ;
    rdfs:comment "Additional payment for actual deployment or dispatch of the ancillary service, separate from the capacity procurement cost. Applies when the ISO/RTO calls upon the resource to provide the service."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deployment_payment" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deployment Payment" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AncillaryServiceAward.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for booking the ancillary service cost. Typically accounts 447 (Sales for Resale) or 565 (Transmission of Electricity by Others)."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FERC (Federal Energy Regulatory Commission) Account Code" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.fercReportingCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting category"@en ;
    rdfs:comment "FERC reporting category for this ancillary service transaction as required by Electric Quarterly Report (EQR) filing. Classifies the transaction for regulatory transparency."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_reporting_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FERC (Federal Energy Regulatory Commission) Reporting Category" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.internalNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal notes"@en ;
    rdfs:comment "Free-text field for internal operational notes, exceptions, or special circumstances related to this ancillary service procurement. Not shared externally."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "internal_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:AncillaryServiceAward.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "Code identifying the Independent System Operator or Regional Transmission Organization market where the ancillary service was procured. Null for bilateral contracts outside organized markets. Reference-value candidates: CAISO|ERCOT|MISO|PJM|NYISO|ISO_NE|SPP."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "ISO/RTO (Independent System Operator/Regional Transmission Organization) Code" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this record was last updated. Tracks changes through the award lifecycle from initial award through settlement and any subsequent adjustments."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:AncillaryServiceAward.marketIntervalEnd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market interval end"@en ;
    rdfs:comment "End timestamp of the market interval or delivery period for which the ancillary service was procured. Defines the duration of service obligation."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "market_interval_end" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AncillaryServiceAward.marketIntervalStart a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market interval start"@en ;
    rdfs:comment "Start timestamp of the market interval or delivery period for which the ancillary service was procured. Typically aligned with ISO/RTO settlement intervals (5-minute, 15-minute, or hourly)."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "market_interval_start" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:AncillaryServiceAward.performanceObligationMet a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance obligation met"@en ;
    rdfs:comment "Indicates whether the resource successfully met its performance obligation during the service interval. False may trigger penalties or non-performance charges."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "performance_obligation_met" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Performance Obligation Met Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AncillaryServiceAward.pricingNode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pricing node"@en ;
    rdfs:comment "Specific pricing node or location where the ancillary service was procured in nodal markets. Used for locational marginal pricing and congestion analysis."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "pricing_node" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode)" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.procuredCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "procured capacity mw"@en ;
    rdfs:comment "Quantity of ancillary service capacity procured, measured in megawatts. Represents the resource capability committed to provide the service during the market interval."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "procured_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Procured Capacity (MW - Megawatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:AncillaryServiceAward.procurementMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "procurement method"@en ;
    rdfs:comment "Method by which the ancillary service was procured. Distinguishes between ISO/RTO market purchases, bilateral contracts with third parties, and self-supply from utility-owned resources."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "procurement_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Procurement Method" ;
    cmm:validValues "iso_day_ahead_market|iso_real_time_market|bilateral_contract|self_supply|rto_capacity_market" ;
    cmm:cimDatatype "String" .
cmm:AncillaryServiceAward.regulatoryReportingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reporting flag"@en ;
    rdfs:comment "Indicates whether this ancillary service procurement must be included in regulatory reports to FERC, state PUCs, or other governing bodies. True for transactions meeting reporting thresholds."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reporting_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reporting Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:AncillaryServiceAward.serviceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service type"@en ;
    rdfs:comment "Type of ancillary service procured to support grid reliability and stability. Includes regulation, reserves, and voltage support services as defined by NERC and ISO/RTO tariffs."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Ancillary Service Type" ;
    cmm:validValues "regulation_up|regulation_down|spinning_reserve|non_spinning_reserve|replacement_reserve|voltage_support" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:AncillaryServiceClearing.kind .
cmm:AncillaryServiceAward.totalProcurementCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total procurement cost"@en ;
    rdfs:comment "Total cost of the ancillary service procurement for the market interval, calculated as procured capacity multiplied by cleared price and interval duration. Expressed in the utility's reporting currency."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_procurement_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Procurement Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:AncillaryServiceAward.transmissionZone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transmission zone"@en ;
    rdfs:comment "Transmission zone or load zone where the ancillary service was procured. Reflects geographic pricing and reliability requirements within the ISO/RTO footprint."@en ;
    rdfs:domain cmm:AncillaryServiceAward ; rdfs:range xsd:string ;
    cmm:physicalColumn "transmission_zone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Zone" ;
    cmm:cimDatatype "String" .

cmm:TradingBook a owl:Class ;
    rdfs:label "Trading Book"@en ;
    rdfs:comment "Trading book master record defining the organizational unit within the ETRM system (OpenLink Endur) used to aggregate and manage related trades for P&L reporting, risk limits, and regulatory reporting. Captures book name, book type (physical, financial, hedging, proprietary), commodity, responsible trader/desk, risk limit (VaR), and FERC reporting category."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.asset_holdings ;
    cmm:physicalTable "utility_cmm_silver.trading.book" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "OpenLink Endur Book" ;
    cmm:sourceObject "energy_utilities_ecm.trading.book" ;
    owl:hasKey ( cmm:TradingBook.bookId ) .

cmm:TradingBook.bookId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book id"@en ;
    rdfs:comment "Unique identifier for the trading book within the Energy Trading and Risk Management (ETRM) system. Primary key."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:long ;
    cmm:physicalColumn "book_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Trading Book ID" ;
    cmm:cimDatatype "Integer" .
cmm:TradingBook.approverEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approver employee"@en ;
    rdfs:comment "Identifier of the risk officer or executive who approved the establishment of this trading book and its risk limits."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approver_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_approver_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TradingBook.bookEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "book employee"@en ;
    rdfs:comment "Identifier of the trader or portfolio manager responsible for managing positions and P&L within this trading book."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "book_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Trader ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_book_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TradingBook.bookLastModifiedByUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "book last modified by user employee"@en ;
    rdfs:comment "Identifier of the user who last modified this trading book record. Supports audit trail and change management requirements."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "book_last_modified_by_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Last Modified By User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_book_last_modified_by_user_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TradingBook.complianceSoxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "compliance sox control"@en ;
    rdfs:comment "Foreign key linking to compliance.sox_control. Business justification: Trading books are subject to SOX controls for valuation, position limits, and P&L reporting. SOX control testing validates trading book mark-to-market processes, segregation of duties, and limit monit"@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "compliance_sox_control_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Compliance Sox Control Id (Foreign Key)" ;
    cmm:sourceColumn "sox_control_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_compliance_sox_control_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:TradingBook.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Trading books are assigned to cost centers for overhead allocation and budget tracking. Real business process: annual budgeting allocates trading desk operating costs to responsible cost centers for c"@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:TradingBook.legalEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "legal entity"@en ;
    rdfs:comment "Identifier of the legal entity under which trades in this book are executed. Critical for regulatory reporting, tax accounting, and counterparty credit agreements."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:TradingLegalEntity ;
    cmm:physicalColumn "legal_entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Legal Entity ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_legal_entity_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:TradingBook.marketParticipant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "market participant"@en ;
    rdfs:comment "Unique identifier assigned by the ISO/RTO for this trading book's market participation. Used in day-ahead and real-time market bids, offers, and settlements."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:MarketParticipant ;
    cmm:physicalColumn "market_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Market Participant ID" ;
    cmm:valuePattern "^[A-Z0-9]{4,20}$" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_market_participant_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:TradingBook.tradingDesk a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trading desk"@en ;
    rdfs:comment "FK to trading.trading_desk"@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range cmm:TradingDesk ;
    cmm:physicalColumn "trading_desk_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_book_trading_desk_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:TradingBook.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the risk committee or authorized governance body approved the creation and risk limits of this trading book."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Risk Committee Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:TradingBook.bookCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book code"@en ;
    rdfs:comment "Short alphanumeric code uniquely identifying the trading book for operational reference and reporting. Used in trade capture, position reporting, and regulatory filings."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "book_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trading Book Code" ;
    cmm:valuePattern "^[A-Z0-9_-]{2,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TradingBook.bookName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book name"@en ;
    rdfs:comment "Full descriptive name of the trading book used for display and business communication. Examples: 'West Region Physical Power', 'Gas Hedging Portfolio', 'REC Trading Desk'."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "book_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Trading Book Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:TradingBook.bookStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book status"@en ;
    rdfs:comment "Current operational status of the trading book. Active books accept new trades; suspended books are temporarily inactive; closed books are archived; pending approval books await risk committee authorization."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "book_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trading Book Status" ;
    cmm:validValues "active|suspended|closed|pending_approval" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:TradingBook.bookType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "book type"@en ;
    rdfs:comment "Classification of the trading book by its primary business purpose. Physical books manage delivery obligations; financial books manage price risk; hedging books offset exposure; proprietary books capture speculative positions; structured books manage complex deals; ancillary services books manage grid support products."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "book_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trading Book Type" ;
    cmm:validValues "physical|financial|hedging|proprietary|structured|ancillary_services" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:TradingBook.businessUnitCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "business unit code"@en ;
    rdfs:comment "Code identifying the business unit or division that owns this trading book. Used for segment reporting and management accounting."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "business_unit_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Business Unit Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.collateralManagementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collateral management flag"@en ;
    rdfs:comment "Indicates whether this trading book requires active collateral management (margin calls, credit support annexes) for counterparty credit risk mitigation."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "collateral_management_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collateral Management Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TradingBook.commodity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commodity"@en ;
    rdfs:comment "Primary commodity or product traded within this book. Determines applicable market rules, settlement conventions, and regulatory reporting requirements. Reference-value candidates: power|natural_gas|coal|renewable_energy_credits|emissions_allowances|capacity|ancillary_services|fuel_oil."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "commodity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commodity Type" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this trading book record was first created in the ETRM system. Used for audit trails and data lineage."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:TradingBook.creditLimitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit limit amount"@en ;
    rdfs:comment "Maximum aggregate credit exposure allowed across all counterparties for trades booked to this trading book, expressed in USD. Used for pre-trade credit checks."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "credit_limit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Limit Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TradingBook.effectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective date"@en ;
    rdfs:comment "Date on which this trading book became active and eligible to accept trades. Used for historical analysis and audit trails."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trading Book Effective Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:TradingBook.emissionsAllowanceRegistryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions allowance registry code"@en ;
    rdfs:comment "Identifier for the emissions allowance registry account (e.g., EPA CATR, RGGI COATS) associated with this trading book. Required for books trading carbon or NOx allowances."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "emissions_allowance_registry_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Allowance Registry ID" ;
    cmm:valuePattern "^[A-Z0-9_-]{2,20}$" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.fercReportingCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting category"@en ;
    rdfs:comment "Federal Energy Regulatory Commission reporting category for this trading book. Determines which FERC forms and schedules apply (e.g., FERC Form 552 for wholesale power, FERC Form 2 for utilities)."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_reporting_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "FERC Reporting Category" ;
    cmm:validValues "wholesale_power|natural_gas|transmission_rights|ancillary_services|exempt" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.hedgeAccountingDesignation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge accounting designation"@en ;
    rdfs:comment "Accounting treatment designation under ASC 815 (Derivatives and Hedging). Determines whether mark-to-market gains/losses flow through earnings or other comprehensive income."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "hedge_accounting_designation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Accounting Designation" ;
    cmm:validValues "cash_flow_hedge|fair_value_hedge|net_investment_hedge|not_designated" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.internalNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal notes"@en ;
    rdfs:comment "Free-text field for internal operational notes, special instructions, or context about this trading book. Not visible to external parties or regulatory filings."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "internal_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Internal Notes" ;
    cmm:sensitivity "internal" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:TradingBook.isoRtoCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto code"@en ;
    rdfs:comment "Primary ISO or RTO market in which this trading book operates. Determines market rules, settlement procedures, and scheduling protocols. Non-ISO indicates bilateral or over-the-counter trading. Reference-value candidates: CAISO|ERCOT|MISO|PJM|NYISO|ISO-NE|SPP|non_iso."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) or Regional Transmission Organization (RTO) Code" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this trading book record. Tracks changes to risk limits, status, or organizational assignments."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:TradingBook.masterNettingAgreementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "master netting agreement flag"@en ;
    rdfs:comment "Indicates whether trades in this book are subject to master netting agreements (e.g., ISDA, EEI) that allow offsetting of exposures across multiple transactions with the same counterparty."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "master_netting_agreement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Master Netting Agreement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TradingBook.positionLimitQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position limit quantity"@en ;
    rdfs:comment "Maximum net position quantity (long or short) allowed in this book, expressed in the commodity's standard unit of measure (MWh for power, MMBtu for gas). Enforces concentration risk controls."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "position_limit_quantity" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Position Limit Quantity" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:TradingBook.positionLimitUom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position limit uom"@en ;
    rdfs:comment "Unit of measure for the position limit quantity. Must align with the commodity type traded in this book."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "position_limit_uom" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Position Limit Unit of Measure" ;
    cmm:validValues "MWh|MMBtu|tons|certificates|allowances" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:TradingBook.recTrackingSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec tracking system code"@en ;
    rdfs:comment "Identifier for the REC tracking system registry account associated with this trading book (e.g., WREGIS, M-RETS, PJM-GATS). Required for books trading renewable energy certificates."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "rec_tracking_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Tracking System ID" ;
    cmm:valuePattern "^[A-Z0-9_-]{2,20}$" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.regionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "region code"@en ;
    rdfs:comment "Code representing the primary geographic region or market area for this trading book (e.g., WEST, EAST, ERCOT, MISO). Used for regional P&L reporting and market analysis."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "region_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Geographic Region Code" ;
    cmm:valuePattern "^[A-Z]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.riskLimitVar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "risk limit var"@en ;
    rdfs:comment "Maximum allowable Value at Risk for this trading book, expressed in USD. Represents the risk appetite approved by the risk committee. Breaches trigger escalation and position reduction requirements."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "risk_limit_var" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Value at Risk (VaR) Limit" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:TradingBook.schedulingCoordinatorFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduling coordinator flag"@en ;
    rdfs:comment "Indicates whether this trading book acts as a Scheduling Coordinator (SC) responsible for submitting schedules and bids to the ISO/RTO on behalf of generation or load resources."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "scheduling_coordinator_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Scheduling Coordinator Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TradingBook.settlementCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for financial settlements of trades in this book. Typically USD for North American energy markets."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "settlement_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Settlement Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:TradingBook.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "Date on which this trading book was closed or deactivated. Null for active books. Used for historical reporting and compliance retention."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Trading Book Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:TradingBook.valuationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valuation method"@en ;
    rdfs:comment "Method used to value positions in this trading book for financial reporting. Mark-to-market uses observable market prices; mark-to-model uses pricing models for illiquid products; accrual recognizes value at settlement."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:string ;
    cmm:physicalColumn "valuation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Valuation Method" ;
    cmm:validValues "mark_to_market|mark_to_model|accrual|lower_of_cost_or_market" ;
    cmm:cimDatatype "String" .
cmm:TradingBook.varConfidenceLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "var confidence level"@en ;
    rdfs:comment "Statistical confidence level used for VaR calculation, typically 95% or 99%. Defines the probability threshold for the risk limit."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "var_confidence_level" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VaR Confidence Level Percentage" ;
    cmm:cimDatatype "Decimal" .
cmm:TradingBook.varTimeHorizonDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "var time horizon days"@en ;
    rdfs:comment "Time horizon in days over which VaR is calculated, typically 1 day for daily risk monitoring or 10 days for regulatory capital calculations."@en ;
    rdfs:domain cmm:TradingBook ; rdfs:range xsd:int ;
    cmm:physicalColumn "var_time_horizon_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VaR Time Horizon in Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .

cmm:FercEqrFiling a owl:Class ;
    rdfs:label "Ferc Eqr Filing"@en ;
    rdfs:comment "FERC Electric Quarterly Report (EQR) filing record capturing the utility's mandatory wholesale market transaction reporting to FERC. Captures filing period (quarter/year), transaction category (long-term, short-term, spot), counterparty, contract type, quantity (MWh), price ($/MWh), filing submission timestamp, FERC confirmation number, and amendment status. Supports FERC Order 2001 compliance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.risk_management ;
    cmm:physicalTable "utility_cmm_silver.trading.ferc_eqr_filing" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC EQR; FERC Electric Quarterly Report (EQR)" ;
    cmm:sourceObject "energy_utilities_ecm.trading.ferc_eqr_filing" ;
    owl:hasKey ( cmm:FercEqrFiling.fercEqrFilingId ) .

cmm:FercEqrFiling.fercEqrFilingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc eqr filing id"@en ;
    rdfs:comment "Unique identifier for the FERC EQR filing record. Primary key for this entity."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range xsd:long ;
    cmm:physicalColumn "ferc_eqr_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Electric Quarterly Report (EQR) Filing ID" ;
    cmm:cimDatatype "Integer" .
cmm:FercEqrFiling.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "FK to trading.counterparty.counterparty_id — FERC EQR requires counterparty identification for every reported transaction. FK ensures regulatory reporting accuracy."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:FercEqrFiling.fercCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ferc counterparty"@en ;
    rdfs:comment "Identifier of the counterparty involved in the wholesale energy transactions reported in this EQR filing."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "ferc_counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Counterparty ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_ferc_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:FercEqrFiling.fercTrade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ferc trade"@en ;
    rdfs:comment "FK to trading.trade.trade_id — FERC EQR filings report specific wholesale transactions. The filing must reference the underlying trades for audit trail and compliance verification."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "ferc_trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_ferc_trade_id" ;
    cmm:cimAssociation "Document.Trade" .
cmm:FercEqrFiling.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: FERC EQR filings must reference GL accounts for audit trail and reconciliation to financial statements. Real business process: external auditors trace EQR reported transactions to GL postings to verif"@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_gl_account_id" ;
    cmm:cimAssociation "Document.ErpChartOfAccounts" .
cmm:FercEqrFiling.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: FERC EQR filings reference IRP scenarios to demonstrate that wholesale transactions align with prudent resource planning and regulatory commitments. Compliance officers link EQR filings to IRP scenari"@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:FercEqrFiling.originalFilingFercEqrFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original filing ferc eqr filing"@en ;
    rdfs:comment "Reference to the original FERC EQR filing that this amendment corrects or updates. Null if this is an original filing."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:FercEqrFiling ;
    cmm:physicalColumn "original_filing_ferc_eqr_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Filing ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_original_filing_ferc_eqr_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:FercEqrFiling.preparerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "preparer employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: FERC EQR filings require employee accountability for regulatory compliance. Preparer_name/contact fields are denormalized employee data. New FK enables workforce qualification tracking (FERC filing ce"@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "preparer_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_preparer_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:FercEqrFiling.primaryCounterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary counterparty"@en ;
    rdfs:comment "FK to trading.counterparty.counterparty_id — FERC EQR requires counterparty identification for every reported transaction. This FK ensures regulatory reporting accuracy."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "primary_counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_primary_counterparty_id" ;
    cmm:cimAssociation "Document.MarketParticipant" .
cmm:FercEqrFiling.primaryTrade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary trade"@en ;
    rdfs:comment "FK to trading.trade.trade_id — FERC EQR filings report wholesale transactions — each filing line must trace to the originating trade for audit compliance and amendment tracking."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "primary_trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_primary_trade_id" ;
    cmm:cimAssociation "Document.Trade" .
cmm:FercEqrFiling.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: FERC EQR filings are a specific type of regulatory filing that should reference the master filing record. Regulatory affairs maintains a comprehensive filing log including EQR submissions alongside ra"@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:FercEqrFiling.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "FK to trading.trade.trade_id — FERC EQR filings report specific wholesale transactions. The FK to trade ensures audit trail from regulatory filing back to source transaction."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_ferc_eqr_filing_trade_id" ;
    cmm:cimAssociation "Document.Trade" .
cmm:FercEqrFiling.amendmentFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amendment flag"@en ;
    rdfs:comment "Indicates whether this filing is an amendment to a previously submitted EQR filing (True) or an original filing (False)."@en ;
    rdfs:domain cmm:FercEqrFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "amendment_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
