cmm:IncentiveProgram.incentiveRateStructure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incentive rate structure"@en ;
    rdfs:comment "Structure or basis for calculating the incentive payment: per_kw = dollars per kilowatt of capacity, per_mwh = dollars per megawatt-hour of generation, per_rec = dollars per Renewable Energy Certificate, percentage_of_cost = percentage of project cost, fixed_amount = lump sum, tiered = multiple rate tiers based on size or technology."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "incentive_rate_structure" ;
    cmm:sqlDataType "STRING" ;
