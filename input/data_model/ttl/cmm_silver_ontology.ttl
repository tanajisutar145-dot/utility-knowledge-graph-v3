cmm:SafetyIncident.regulatoryNotificationRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory notification required flag"@en ;
    rdfs:comment "Indicates whether the incident severity requires notification to OSHA, state agencies, or other regulatory bodies within mandated timeframes (e.g., fatality within 8 hours, hospitalization within 24 hours)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:boolean ;
