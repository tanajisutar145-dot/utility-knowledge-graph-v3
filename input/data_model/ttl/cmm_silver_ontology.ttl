    rdfs:domain cmm:PlanningPeriod ; rdfs:range cmm:PlanningPeriod ;
    cmm:physicalColumn "previous_planning_period_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
