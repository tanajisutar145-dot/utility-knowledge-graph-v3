    cmm:businessTerm "Project Location Address" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:IncentiveApplication.projectLocationCity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project location city"@en ;
    rdfs:comment "City where the renewable energy project is located."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:string ;
