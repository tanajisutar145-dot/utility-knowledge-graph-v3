cmm:ClusterStudyGroup.affectedNetworkSegments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected network segments"@en ;
    rdfs:comment "List or description of distribution and transmission network segments potentially impacted by the aggregate DER capacity in the cluster study group. Identifies circuits, substations, and transmission lines requiring analysis."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_network_segments" ;
