    cmm:businessTerm "Preventive Actions Planned" ;
    cmm:cimDatatype "String" .
cmm:SelfReport.publicDisclosureDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "public disclosure date"@en ;
    rdfs:comment "Date when the self-report or resulting enforcement action was publicly disclosed or posted to regulatory websites."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:date ;
