cmm:PlantVendorAgreement a owl:Class ;
    rdfs:label "Plant Vendor Agreement"@en ;
    rdfs:comment "This association product represents the contractual relationship between a power generation facility and its suppliers/service vendors. It captures plant-specific procurement contracts, service level agreements, and vendor performance tracking. Each record links one power plant to one vendor with commercial terms, service commitments, and spend tracking that exist only in the context of this specific plant-vendor relationship.. Existence Justification: Power plants maintain contractual relationships with multiple vendors for different services (fuel supply, parts, maintenance, emergency response), and vendors serve multiple generation facilities across the utility's portfolio. Each plant-vendor relationship has its own contract terms, service level agreements, response time commitments, and spend tracking that vary by plant criticality, location, and vendor capability. This is an operational relationship actively managed by plant operators and procurement teams."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.fuel_management ;
    cmm:physicalTable "utility_cmm_silver.generation.plant_vendor_agreement" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.generation.plant_vendor_agreement" ;
    owl:hasKey ( cmm:PlantVendorAgreement.plantVendorAgreementId ) .

cmm:PlantVendorAgreement.plantVendorAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plant vendor agreement id"@en ;
    rdfs:comment "Unique identifier for this plant-vendor agreement record. Primary key."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "plant_vendor_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Plant Vendor Agreement ID" ;
    cmm:cimDatatype "Integer" .
cmm:PlantVendorAgreement.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to the power generation facility that is party to this vendor agreement."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant Vendor Agreement - Power Plant Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_plant_vendor_agreement_power_plant_id" ;
    cmm:cimAssociation "IdentifiedObject.Plant" .
cmm:PlantVendorAgreement.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor that is party to this plant-specific agreement."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant Vendor Agreement - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_plant_vendor_agreement_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:PlantVendorAgreement.agreementStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "agreement status"@en ;
    rdfs:comment "Current lifecycle status of this plant-vendor agreement. Active = in force, Pending = negotiated but not yet effective, Expired = past end date, Terminated = ended early, Suspended = temporarily inactive."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "agreement_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Agreement Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:PlantVendorAgreement.annualSpendUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual spend usd"@en ;
    rdfs:comment "Total annual procurement spend in USD for this plant-vendor relationship. Used for vendor performance analysis and strategic sourcing decisions."@en ;
