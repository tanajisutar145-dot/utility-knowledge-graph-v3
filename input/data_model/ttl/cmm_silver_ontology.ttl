cmm:RateSchedule.hasTouPeriods a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has tou periods"@en ;
    rdfs:comment "Indicates whether this rate schedule includes time-of-use pricing periods with different rates for peak, off-peak, and shoulder periods."@en ;
