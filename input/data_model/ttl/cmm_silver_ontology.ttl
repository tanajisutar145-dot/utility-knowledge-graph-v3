cmm:PpaSettlement.settlementApprovedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement approved timestamp"@en ;
    rdfs:comment "Timestamp when the settlement was approved for invoicing and payment."@en ;
    rdfs:domain cmm:PpaSettlement ; rdfs:range xsd:dateTime ;
