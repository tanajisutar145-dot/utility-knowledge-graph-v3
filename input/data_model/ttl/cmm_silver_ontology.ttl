    rdfs:label "service level agreement"@en ;
    rdfs:comment "Description or reference to the service level agreement terms specific to this plant-vendor relationship. May include uptime guarantees, quality standards, or delivery commitments."@en ;
    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:string ;
