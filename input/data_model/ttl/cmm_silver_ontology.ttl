cmm:TransmissionServiceAgreement.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "Reason for termination of this transmission service agreement (e.g., customer request, non-payment, breach of terms, expiration)."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agreement Termination Reason" ;
    cmm:cimDatatype "String" .

cmm:FtrPosition a owl:Class ;
    rdfs:label "Ftr Position"@en ;
    rdfs:comment "Master record for Financial Transmission Rights (FTR) positions held by the utility or transmission customers as congestion revenue hedges. Captures FTR identifier, auction round and period, obligation or option type, source PNode, sink PNode, MW quantity, direction (prevailing/counter-flow), auction clearing price ($/MW), monthly settlement credits/charges, RTO/ISO market identifier, portfolio grouping, and expiration date. Supports congestion cost hedging strategy, day-ahead market settlement reconciliation, and ARR-to-FTR conversion tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CRR ;
    cmm:cimCloseMatch cim:CRR ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC62325::CongestionRevenueRights" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.service_operations ;
    cmm:physicalTable "utility_cmm_silver.transmission.ftr_position" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 62325-301; FERC FTR / RTO FTR Auction Rules" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.ftr_position" ;
    owl:hasKey ( cmm:FtrPosition.ftrPositionId ) .

cmm:FtrPosition.ftrPositionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr position id"@en ;
    rdfs:comment "Unique identifier for the FTR position record. Primary key for the FTR position master data."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:long ;
    cmm:physicalColumn "ftr_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Position Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FtrPosition.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: FTR positions are valued using energy price forecasts for mark-to-market accounting, portfolio risk assessment, and hedging strategy decisions. Treasury and trading functions require price forecasts t"@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_energy_price_id" ;
    cmm:cimAssociation "CRR.RegularIntervalSchedule" .
cmm:FtrPosition.fercMarketReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ferc market report"@en ;
    rdfs:comment "Foreign key linking to compliance.ferc_market_report. Business justification: FTR positions and settlements must be reported in FERC Electric Quarterly Reports (EQR) per 18 CFR 35.41. Market participants report FTR auction results, holdings, and settlement credits quarterly."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:FercMarketReport ;
    cmm:physicalColumn "ferc_market_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ferc Market Report Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_ferc_market_report_id" ;
    cmm:cimAssociation "CRR.Document" .
cmm:FtrPosition.ftrHolding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ftr holding"@en ;
    rdfs:comment "Foreign key linking to trading.ftr_holding. Business justification: FTR positions in transmission operations represent the same financial instruments managed as trading holdings. Energy utilities track transmission FTR positions that feed trading portfolio management"@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:FtrHolding ;
    cmm:physicalColumn "ftr_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ftr Holding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_ftr_holding_id" ;
    cmm:cimAssociation "CRR.CRR" .
cmm:FtrPosition.ftrPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ftr path"@en ;
    rdfs:comment "FK to transmission.path.path_id — FTR positions are defined between source and sink points that map to transmission paths. Required for congestion revenue hedging and settlement reconciliation."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "ftr_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_ftr_path_id" ;
    cmm:cimAssociation "CRR.TransmissionPath" .
cmm:FtrPosition.hedgedPpaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hedged ppa contract"@en ;
    rdfs:comment "Foreign key linking to renewable.ppa_contract. Business justification: Renewable generators and their offtakers routinely acquire FTR positions to hedge congestion risk between generation source and delivery sink specified in PPAs. This is standard risk management practi"@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "hedged_ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Hedged Ppa Contract Id (Foreign Key)" ;
    cmm:sourceColumn "ppa_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_hedged_ppa_contract_id" ;
    cmm:cimAssociation "CRR.Agreement" .
cmm:FtrPosition.originalFtrPosition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original ftr position"@en ;
    rdfs:comment "Reference to the original FTR position identifier if this position was created through reconfiguration or modification of an existing position. Null for positions acquired directly from auction."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:FtrPosition ;
    cmm:physicalColumn "original_ftr_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Original Financial Transmission Right (FTR) Position Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_original_ftr_position_id" ;
    cmm:cimAssociation "CRR.CRR" .
cmm:FtrPosition.primaryPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary path"@en ;
    rdfs:comment "FK to transmission.path.path_id — FTR positions hedge congestion on specific source-sink paths. This FK connects financial hedges to physical network elements."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "primary_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_primary_path_id" ;
    cmm:cimAssociation "CRR.TransmissionPath" .
cmm:FtrPosition.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: FTR positions are financial instruments assigned to profit centers for P&L tracking, mark-to-market valuation, and financial performance reporting. Required for ISO market settlement reconciliation."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_ftr_position_profit_center_id" ;
    cmm:cimAssociation "CRR.Organisation" .
cmm:FtrPosition.arrConversionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arr conversion flag"@en ;
    rdfs:comment "Indicates whether this FTR position was acquired through conversion of an Auction Revenue Right (ARR) allocation. ARRs are allocated to load-serving entities and can be converted to FTRs in annual auctions."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "arr_conversion_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Revenue Right (ARR) Conversion Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FtrPosition.arrIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arr identifier"@en ;
    rdfs:comment "Identifier of the ARR that was converted to create this FTR position, if applicable. Null for FTRs acquired directly through auction."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "arr_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Revenue Right (ARR) Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.auctionClearingPricePerMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction clearing price per mw"@en ;
    rdfs:comment "Price per MW at which this FTR position cleared in the auction, denominated in USD per MW for the contract period. Represents the upfront cost paid to acquire the FTR hedge."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "auction_clearing_price_per_mw" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Clearing Price per Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:FtrPosition.auctionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction date"@en ;
    rdfs:comment "Date on which the FTR auction was conducted and this position was awarded."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "auction_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Date" ;
    cmm:cimDatatype "Date" .
cmm:FtrPosition.auctionRound a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auction round"@en ;
    rdfs:comment "Identifier for the FTR auction round in which this position was acquired. Typically includes auction type (annual, monthly, reconfiguration) and period designation."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "auction_round" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auction Round Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this FTR position record was first created in the system."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CRR.createdDateTime .
cmm:FtrPosition.cumulativeSettlementCreditUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cumulative settlement credit usd"@en ;
    rdfs:comment "Total cumulative congestion revenue credits or charges for this FTR position since effective start date, denominated in USD. Used to track overall hedge performance."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "cumulative_settlement_credit_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cumulative Settlement Credit in United States Dollars (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FtrPosition.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date on which the FTR position expires and ceases to accrue congestion revenue. Typically aligned with auction period boundaries (end of month, end of planning year)."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:FtrPosition.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date on which the FTR position becomes effective and begins accruing congestion revenue credits or charges."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:FtrPosition.fercReportingCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reporting category"@en ;
    rdfs:comment "FERC reporting classification for this FTR position, used for regulatory compliance reporting under FERC Form 1 and FERC Electric Quarterly Reports (EQR)."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_reporting_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reporting Category" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.flowDirection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "flow direction"@en ;
    rdfs:comment "Direction of power flow for the FTR position. Prevailing flow aligns with typical congestion patterns; counter-flow opposes typical patterns and may have lower auction prices."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "flow_direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Flow Direction" ;
    cmm:validValues "prevailing|counter-flow" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.ftrIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr identifier"@en ;
    rdfs:comment "Externally-known unique identifier for the FTR position as assigned by the RTO/ISO market system. Used for market settlement reconciliation and external reporting."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "ftr_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Business Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.ftrType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ftr type"@en ;
    rdfs:comment "Type of FTR position held. Obligation FTRs pay or charge the holder based on congestion price differences; Option FTRs only pay when positive, with no charge when negative."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "ftr_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Type" ;
    cmm:validValues "obligation|option" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CRR.type .
cmm:FtrPosition.hedgeStrategyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hedge strategy code"@en ;
    rdfs:comment "Code identifying the hedging strategy or business purpose for acquiring this FTR position. Examples include load-serving hedge, generation hedge, merchant arbitrage, portfolio optimization."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "hedge_strategy_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hedge Strategy Code" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.holdingEntityName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "holding entity name"@en ;
    rdfs:comment "Name of the legal entity or business unit that holds this FTR position. May be the utility itself or a transmission customer."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "holding_entity_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Holding Entity Name" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.holdingEntityType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "holding entity type"@en ;
    rdfs:comment "Classification of the entity holding the FTR position. Utility positions are held for internal hedging; transmission customer positions are held by external market participants."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "holding_entity_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Holding Entity Type" ;
    cmm:validValues "utility|transmission_customer|affiliate|third_party" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.internalBookCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "internal book code"@en ;
    rdfs:comment "Internal accounting book or cost center code to which this FTR position is assigned for financial reporting and cost allocation."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "internal_book_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Internal Book Code" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this FTR position record was last updated in the system."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:FtrPosition.lastSettlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last settlement date"@en ;
    rdfs:comment "Date of the most recent settlement calculation for this FTR position. Typically monthly for ongoing positions."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Settlement Date" ;
    cmm:cimDatatype "Date" .
cmm:FtrPosition.monthlySettlementCreditUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monthly settlement credit usd"@en ;
    rdfs:comment "Total congestion revenue credit received for this FTR position in the most recent monthly settlement, denominated in USD. Positive values represent credits; negative values represent charges (for obligation FTRs only)."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "monthly_settlement_credit_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monthly Settlement Credit in United States Dollars (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:FtrPosition.mwQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mw quantity"@en ;
    rdfs:comment "Quantity of transmission capacity in megawatts covered by this FTR position. Determines the magnitude of congestion revenue credits or charges."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mw_quantity" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megawatt (MW) Quantity" ;
    cmm:cimDatatype "Decimal" .
cmm:FtrPosition.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes or comments regarding this FTR position, including hedging rationale, special conditions, or settlement exceptions."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Position Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:FtrPosition.onPeakOffPeakDesignation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "on peak off peak designation"@en ;
    rdfs:comment "Time-of-use designation for the FTR position. On-peak FTRs cover weekday business hours; off-peak FTRs cover nights and weekends; 24-hour FTRs cover all hours."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "on_peak_off_peak_designation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "On-Peak / Off-Peak Designation" ;
    cmm:validValues "on-peak|off-peak|24-hour" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.portfolioGrouping a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "portfolio grouping"@en ;
    rdfs:comment "Business grouping or portfolio designation for this FTR position. Used to aggregate positions for risk management, hedging strategy analysis, and financial reporting."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "portfolio_grouping" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Portfolio Grouping" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.positionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position status"@en ;
    rdfs:comment "Current lifecycle status of the FTR position. Active positions are in-force and subject to settlement; expired positions have reached their end date; settled positions have completed final financial settlement; cancelled positions were terminated before expiration."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "position_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Position Status" ;
    cmm:validValues "active|expired|settled|cancelled|pending" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CRR.status .
cmm:FtrPosition.reconfigurationFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconfiguration flag"@en ;
    rdfs:comment "Indicates whether this FTR position was acquired through a reconfiguration auction, which allows holders to modify existing positions mid-period."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reconfiguration_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconfiguration Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:FtrPosition.rtoIsoMarketCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso market code"@en ;
    rdfs:comment "Identifier for the RTO or ISO market in which this FTR position was acquired and is settled. Examples include PJM, MISO, CAISO, ERCOT, NYISO, ISO-NE, SPP."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_market_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Market Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.rtoIsoMarketName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso market name"@en ;
    rdfs:comment "Human-readable name of the RTO or ISO market."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_market_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) / Independent System Operator (ISO) Market Name" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.sinkPnodeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sink pnode code"@en ;
    rdfs:comment "Identifier for the sink pricing node (withdrawal point) of the FTR path. Congestion revenue is calculated based on the Locational Marginal Price (LMP) difference between source and sink PNodes."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "sink_pnode_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sink Pricing Node (PNode) Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.sinkPnodeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sink pnode name"@en ;
    rdfs:comment "Human-readable name of the sink pricing node for the FTR path."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "sink_pnode_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sink Pricing Node (PNode) Name" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.sourcePnodeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source pnode code"@en ;
    rdfs:comment "Identifier for the source pricing node (injection point) of the FTR path. Congestion revenue is calculated based on the Locational Marginal Price (LMP) difference between source and sink PNodes."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_pnode_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Pricing Node (PNode) Identifier" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.sourcePnodeName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source pnode name"@en ;
    rdfs:comment "Human-readable name of the source pricing node for the FTR path."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_pnode_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Pricing Node (PNode) Name" ;
    cmm:cimDatatype "String" .
cmm:FtrPosition.tradingHubFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trading hub flag"@en ;
    rdfs:comment "Indicates whether either the source or sink PNode is a major trading hub. Hub-based FTRs typically have higher liquidity and more predictable congestion patterns."@en ;
    rdfs:domain cmm:FtrPosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "trading_hub_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Trading Hub Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:CongestionEvent a owl:Class ;
    rdfs:label "Congestion Event"@en ;
    rdfs:comment "Transactional record of a transmission congestion event on a specific path or flowgate where physical power flow constraints cause economic dispatch deviations. Captures event identifier, affected path or flowgate, start and end timestamps, congestion direction, shadow price ($/MWh), curtailed MW, LMP differential between source and sink nodes, RTO/ISO market interval, binding constraint identifier, and remedial action taken (redispatch, TLR, curtailment). Used for congestion cost analysis, FTR settlement reconciliation, Transmission Loading Relief (TLR) tracking, and FERC reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PSREvent ;
    cmm:cimExtends cim:PSREvent ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.service_operations ;
    cmm:physicalTable "utility_cmm_silver.transmission.congestion_event" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "LMP Congestion Component / FERC Order 888" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.congestion_event" ;
    owl:hasKey ( cmm:CongestionEvent.congestionEventId ) .

cmm:CongestionEvent.congestionEventId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion event id"@en ;
    rdfs:comment "Unique identifier for the transmission congestion event record. Primary key for the congestion event entity."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:long ;
    cmm:physicalColumn "congestion_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Congestion Event Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:CongestionEvent.causalOutageEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "causal outage event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Transmission outages frequently cause congestion events (flowgate binding, shadow prices). Linking congestion to the causal outage enables root cause analysis, market settlement dispute resolution, an"@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "causal_outage_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Causal Outage Event Id (Foreign Key)" ;
    cmm:sourceColumn "event_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_causal_outage_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:CongestionEvent.congestionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "congestion path"@en ;
    rdfs:comment "FK to transmission.path.path_id — Congestion events occur on specific transmission paths/flowgates. Required for congestion cost analysis, FTR settlement, and FERC reporting."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "congestion_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "path_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_congestion_path_id" ;
    cmm:cimAssociation "PSREvent.TransmissionPath" .
cmm:CongestionEvent.congestionTransmissionPath a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "congestion transmission path"@en ;
    rdfs:comment "Identifier of the transmission path affected by congestion, representing the source-to-sink corridor where power flow is constrained."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:TransmissionPath ;
    cmm:physicalColumn "congestion_transmission_path_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Transmission Path Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_congestion_transmission_path_id" ;
    cmm:cimAssociation "PSREvent.TransmissionPath" .
cmm:CongestionEvent.contingencyElement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency element"@en ;
    rdfs:comment "Identifier of the contingency element (the element whose outage would cause the monitored element to exceed its limit), if the congestion is contingency-based."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:ContingencyElement ;
    cmm:physicalColumn "contingency_element_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Element Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_contingency_element_id" ;
    cmm:cimAssociation "PSREvent.ContingencyEquipment" .
cmm:CongestionEvent.emsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems event"@en ;
    rdfs:comment "Identifier of the corresponding event in the Energy Management System, used for cross-system event correlation and analysis."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "ems_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Management System (EMS) Event Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_ems_event_id" ;
    cmm:cimAssociation "PSREvent.Outage" .
cmm:CongestionEvent.energyPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "energy price"@en ;
    rdfs:comment "Foreign key linking to forecast.energy_price. Business justification: Congestion events are analyzed against energy price forecasts for FTR valuation, hedging strategy assessment, and portfolio risk management. Market operations teams use historical congestion patterns"@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:EnergyPrice ;
    cmm:physicalColumn "energy_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Energy Price Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_energy_price_id" ;
    cmm:cimAssociation "PSREvent.RegularIntervalSchedule" .
cmm:CongestionEvent.fercMarketReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ferc market report"@en ;
    rdfs:comment "Foreign key linking to compliance.ferc_market_report. Business justification: Congestion events, shadow prices, and LMP differentials are reportable market data in FERC EQR filings. ISO/RTO market participants report congestion costs and transmission constraint binding frequenc"@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:FercMarketReport ;
    cmm:physicalColumn "ferc_market_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ferc Market Report Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_ferc_market_report_id" ;
    cmm:cimAssociation "PSREvent.Document" .
cmm:CongestionEvent.flowgate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "flowgate"@en ;
    rdfs:comment "Identifier of the transmission flowgate or monitored facility experiencing congestion. A flowgate is a mathematical construct representing one or more transmission elements that may limit power flow."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:Flowgate ;
    cmm:physicalColumn "flowgate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Flowgate Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_flowgate_id" ;
    cmm:cimAssociation "PSREvent.Flowgate" .
cmm:CongestionEvent.ftrHolding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ftr holding"@en ;
    rdfs:comment "Foreign key linking to trading.ftr_holding. Business justification: Congestion events directly impact FTR settlement payouts. Trading desks link congestion events to FTR holdings to calculate actual vs expected hedge performance, required for mark-to-market valuation,"@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:FtrHolding ;
    cmm:physicalColumn "ftr_holding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Related Ftr Holding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_ftr_holding_id" ;
    cmm:cimAssociation "PSREvent.CRR" .
cmm:CongestionEvent.ftrPosition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ftr position"@en ;
    rdfs:comment "Identifier of the Financial Transmission Right position associated with the congested path, used for FTR settlement reconciliation."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:FtrPosition ;
    cmm:physicalColumn "ftr_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Financial Transmission Right (FTR) Position Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_ftr_position_id" ;
    cmm:cimAssociation "PSREvent.CRR" .
cmm:CongestionEvent.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Congestion revenue and costs are allocated to profit centers for financial reporting and performance management. Supports ISO market settlement accounting and transmission revenue tracking."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_profit_center_id" ;
    cmm:cimAssociation "PSREvent.Organisation" .
cmm:CongestionEvent.sourcePnode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "source pnode"@en ;
    rdfs:comment "Identifier of the source pricing node (PNode) at the origin of the congested transmission path, used for LMP calculation."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range cmm:TransmissionPnode ;
    cmm:physicalColumn "source_pnode_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Source Pricing Node (PNode) Identifier (ID)" ;
    cmm:sourceColumn "pnode_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_congestion_event_source_pnode_id" ;
    cmm:cimAssociation "PSREvent.Pnode" .
cmm:CongestionEvent.bindingConstraintCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "binding constraint code"@en ;
    rdfs:comment "Identifier of the specific binding constraint in the security-constrained economic dispatch that triggered the congestion event."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "binding_constraint_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Binding Constraint Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.congestionCostUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion cost usd"@en ;
    rdfs:comment "Total congestion cost in USD for the event, calculated as the product of curtailed MW, event duration, and shadow price or LMP differential."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "congestion_cost_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Congestion Cost in United States Dollars (USD)" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:CongestionEvent.congestionDirection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion direction"@en ;
    rdfs:comment "Direction of the congestion on the transmission path: forward (source to sink), reverse (sink to source), or bidirectional (constrained in both directions)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "congestion_direction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Congestion Direction" ;
    cmm:validValues "forward|reverse|bidirectional" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.congestionEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion end timestamp"@en ;
    rdfs:comment "Date and time when the transmission congestion event ended, marking the point at which the constraint was no longer binding or the event was resolved."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "congestion_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Congestion End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CongestionEvent.congestionSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion severity"@en ;
    rdfs:comment "Severity classification of the congestion event based on shadow price, curtailed MW, and duration: low, moderate, high, or critical."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "congestion_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Congestion Severity Level" ;
    cmm:validValues "low|moderate|high|critical" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.congestionStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "congestion start timestamp"@en ;
    rdfs:comment "Date and time when the transmission congestion event began, marking the point at which the flowgate or path became binding in the dispatch model."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "congestion_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Congestion Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CongestionEvent.constraintType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "constraint type"@en ;
    rdfs:comment "Type of transmission constraint that caused the congestion: thermal (line rating), voltage (voltage limit), stability (transient or dynamic stability), interface (multi-element limit), or nomogram (multi-dimensional operating limit)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "constraint_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Constraint Type" ;
    cmm:validValues "thermal|voltage|stability|interface|nomogram" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the congestion event record was first created in the system, used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:PSREvent.createdDateTime .
cmm:CongestionEvent.curtailedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "curtailed mw"@en ;
    rdfs:comment "Amount of power in megawatts that was curtailed or redispatched to relieve the congestion on the affected flowgate or path."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "curtailed_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Curtailed Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CongestionEvent.elementRatingMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "element rating mw"@en ;
    rdfs:comment "Thermal or operational rating of the monitored transmission element in megawatts, representing the maximum allowable flow under the applicable rating methodology (normal, emergency, or seasonal)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "element_rating_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Element Rating in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CongestionEvent.eventCause a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event cause"@en ;
    rdfs:comment "Primary cause of the congestion event: high demand, generation outage, transmission outage, renewable energy variability, loop flow, unscheduled flow, or market condition. Reference-value candidates: high_demand|generation_outage|transmission_outage|renewable_variability|loop_flow|unscheduled_flow|market_condition."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_cause" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Cause" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.eventDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event duration minutes"@en ;
    rdfs:comment "Total duration of the congestion event in minutes, calculated as the difference between start and end timestamps."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:int ;
    cmm:physicalColumn "event_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Event Duration in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:CongestionEvent.eventNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event number"@en ;
    rdfs:comment "Business identifier for the congestion event, typically assigned by the RTO/ISO or EMS system for external reference and reporting."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Congestion Event Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CongestionEvent.eventStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "event status"@en ;
    rdfs:comment "Current status of the congestion event in the event management lifecycle: active (ongoing), resolved (cleared), under review (post-event analysis), or escalated (requires higher-level intervention)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "event_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Event Status" ;
    cmm:validValues "active|resolved|under_review|escalated" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:PSREvent.status .
cmm:CongestionEvent.fercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reportable flag"@en ;
    rdfs:comment "Boolean flag indicating whether the congestion event meets FERC reporting thresholds and must be included in quarterly or annual transmission congestion reports."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CongestionEvent.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when the congestion event record was last modified, used for audit trail and change tracking."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CongestionEvent.lmpDifferentialUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lmp differential usd per mwh"@en ;
    rdfs:comment "Difference between sink LMP and source LMP, representing the congestion component of the price spread across the transmission path."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lmp_differential_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Locational Marginal Price (LMP) Differential in United States Dollars (USD) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CongestionEvent.marketIntervalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market interval timestamp"@en ;
    rdfs:comment "Timestamp of the RTO/ISO market interval (typically 5-minute or hourly) during which the congestion event occurred or was recorded."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "market_interval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Interval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:CongestionEvent.marketType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "market type"@en ;
    rdfs:comment "Type of wholesale electricity market in which the congestion event occurred: day-ahead market (DAM), real-time market (RTM), intra-day market, or ancillary services market."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "market_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Market Type" ;
    cmm:validValues "day_ahead|real_time|intra_day|ancillary_services" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.monitoredElementCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monitored element code"@en ;
    rdfs:comment "Identifier of the specific transmission element (line, transformer, or interface) that was monitored and became binding during the congestion event."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "monitored_element_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monitored Element Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.nercReliabilityRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reliability region"@en ;
    rdfs:comment "NERC reliability region in which the congestion event occurred (e.g., WECC, ERCOT, MRO, NPCC, RF, SERC, TRE, FRCC)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_reliability_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reliability Region" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.operatorNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator notes"@en ;
    rdfs:comment "Free-text notes entered by transmission operators or market operators describing the congestion event, actions taken, and any special circumstances."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operator Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:CongestionEvent.percentOfRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "percent of rating"@en ;
    rdfs:comment "Percentage of the element rating at which the monitored element was operating during the congestion event, calculated as (flow / rating) * 100."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "percent_of_rating" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Percent of Rating" ;
    cmm:cimDatatype "Decimal" .
cmm:CongestionEvent.postContingencyFlowMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "post contingency flow mw"@en ;
    rdfs:comment "Projected power flow in megawatts on the monitored element following the contingency event, used in security-constrained dispatch."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "post_contingency_flow_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Post-Contingency Flow in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CongestionEvent.preContingencyFlowMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pre contingency flow mw"@en ;
    rdfs:comment "Power flow in megawatts on the monitored element under normal (pre-contingency) conditions during the congestion event."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "pre_contingency_flow_mw" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pre-Contingency Flow in Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:CongestionEvent.remedialActionTaken a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remedial action taken"@en ;
    rdfs:comment "Type of remedial action taken to relieve the congestion: economic redispatch, Transmission Loading Relief (TLR), load curtailment, voltage control, phase shifter adjustment, topology change, or none. Reference-value candidates: redispatch|tlr|curtailment|voltage_control|phase_shifter|topology_change|none."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "remedial_action_taken" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remedial Action Taken" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.rtoIsoRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rto iso region"@en ;
    rdfs:comment "Name or code of the RTO or ISO region in which the congestion event occurred (e.g., PJM, MISO, CAISO, ERCOT, NYISO, ISO-NE, SPP)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "rto_iso_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regional Transmission Organization (RTO) or Independent System Operator (ISO) Region" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.scadaAlarmCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scada alarm code"@en ;
    rdfs:comment "Identifier of the SCADA alarm that triggered or was associated with the congestion event, linking the event to real-time grid monitoring systems."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "scada_alarm_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Alarm Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.shadowPriceUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shadow price usd per mwh"@en ;
    rdfs:comment "Shadow price or marginal congestion cost in USD per MWh associated with the binding constraint. Represents the incremental cost of relieving the congestion by one MWh."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "shadow_price_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shadow Price in United States Dollars (USD) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CongestionEvent.sinkLmpUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sink lmp usd per mwh"@en ;
    rdfs:comment "Locational Marginal Price at the sink PNode during the congestion event, representing the cost of delivering one additional MWh at that location."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "sink_lmp_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sink Locational Marginal Price (LMP) in United States Dollars (USD) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CongestionEvent.sinkPnodeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sink pnode code"@en ;
    rdfs:comment "Identifier of the sink pricing node (PNode) at the destination of the congested transmission path, used for LMP calculation."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "sink_pnode_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sink Pricing Node (PNode) Identifier (ID)" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.sourceLmpUsdPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source lmp usd per mwh"@en ;
    rdfs:comment "Locational Marginal Price at the source PNode during the congestion event, representing the cost of delivering one additional MWh at that location."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "source_lmp_usd_per_mwh" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Locational Marginal Price (LMP) in United States Dollars (USD) per Megawatt-Hour (MWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:CongestionEvent.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "Name or code of the source system that generated the congestion event record (e.g., EMS, market management system, SCADA historian)."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.tlrLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tlr level"@en ;
    rdfs:comment "NERC Transmission Loading Relief level invoked during the congestion event (e.g., TLR 1, TLR 2, TLR 3a, TLR 3b, TLR 4, TLR 5a, TLR 5b, TLR 6), if applicable."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "tlr_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Transmission Loading Relief (TLR) Level" ;
    cmm:cimDatatype "String" .
cmm:CongestionEvent.weatherCondition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather condition at the time of the congestion event that may have contributed to the constraint (e.g., high temperature reducing line ratings, storm causing outages). Reference-value candidates: normal|high_temperature|low_temperature|high_wind|storm|ice|fog."@en ;
    rdfs:domain cmm:CongestionEvent ; rdfs:range xsd:string ;
    cmm:physicalColumn "weather_condition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Condition" ;
    cmm:cimDatatype "String" .

cmm:TransmissionOutage a owl:Class ;
    rdfs:label "Transmission Outage"@en ;
    rdfs:comment "Transactional record of planned and forced outages on transmission facilities (lines, transformers, protection devices). Captures outage identifier, facility reference, outage type (planned/forced/maintenance), start and end timestamps, cause code, MW impact, affected paths, RTO/ISO notification status, NERC outage reporting code, restoration actions, and crew reference. Feeds transmission reliability indices and NERC OE-417 reporting. Note: this product captures transmission-specific outage events; the outage domain owns the enterprise outage management platform and customer-facing restoration workflow."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Outage ;
    cmm:cimExactMatch cim:Outage ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:transmission , cmmsa:transmission.service_operations ;
    cmm:physicalTable "utility_cmm_silver.transmission.transmission_outage" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-3; NERC OE-417 / DOE Electric Emergency Incident Reporting" ;
    cmm:sourceObject "energy_utilities_ecm.transmission.transmission_outage" ;
    owl:hasKey ( cmm:TransmissionOutage.transmissionOutageId ) .

cmm:TransmissionOutage.transmissionOutageId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "transmission outage id"@en ;
    rdfs:comment "Unique identifier for the transmission outage event. Primary key for the transmission outage record."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:long ;
    cmm:physicalColumn "transmission_outage_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Transmission Outage Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:TransmissionOutage.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Outage restoration costs are charged to specific cost centers for budget variance analysis and operational expense tracking. Essential for O&M cost management and regulatory expense reporting."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_cost_center_id" ;
    cmm:cimAssociation "Outage.Organisation" .
cmm:TransmissionOutage.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Reference to the maintenance or emergency crew assigned to address the outage and perform restoration work."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_crew_id" ;
    cmm:cimAssociation "Outage.Crew" .
cmm:TransmissionOutage.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Transmission outages trigger EMS alarms (breaker status, voltage violations). Linking enables automated outage-to-alarm correlation for NERC event reporting (OE-417), operator situational awareness, a"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_ems_alarm_id" ;
    cmm:cimAssociation "Outage.ActivityRecord" .
cmm:TransmissionOutage.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: Transmission outages must link to enterprise outage management for unified incident tracking, NERC/FERC regulatory reporting, customer impact analysis, and cross-domain restoration coordination. Real-"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_event_id" ;
    cmm:cimAssociation "Outage.Outage" .
cmm:TransmissionOutage.internalOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "internal order"@en ;
    rdfs:comment "Foreign key linking to finance.internal_order. Business justification: Major transmission outages often have dedicated internal orders for cost collection, tracking, and settlement to appropriate GL accounts. Supports project-based cost accounting for significant restora"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:InternalOrder ;
    cmm:physicalColumn "internal_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Internal Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_internal_order_id" ;
    cmm:cimAssociation "Outage.ErpProjectAccounting" .
cmm:TransmissionOutage.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the transmission facility (line, transformer, circuit breaker, or other equipment) experiencing the outage."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Facility Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_registry_id" ;
    cmm:cimAssociation "Outage.Asset" .
cmm:TransmissionOutage.regulatoryCorrespondence a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory correspondence"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_correspondence. Business justification: Major transmission outages generate regulatory inquiries from FERC, NERC, or state commissions requiring formal correspondence responses. DOE Form OE-417 submissions and follow-up correspondence are t"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:RegulatoryCorrespondence ;
    cmm:physicalColumn "regulatory_correspondence_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Correspondence Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_regulatory_correspondence_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:TransmissionOutage.restorationWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "restoration warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Outage restoration crews draw materials from designated emergency restoration warehouses. Operations teams track source warehouse for inventory replenishment planning, mutual aid material tracking, an"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "restoration_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Restoration Warehouse Id (Foreign Key)" ;
    cmm:sourceColumn "warehouse_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_restoration_warehouse_id" ;
    cmm:cimAssociation "Outage.WorkLocation" .
cmm:TransmissionOutage.selfReport a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "self report"@en ;
    rdfs:comment "Foreign key linking to compliance.self_report. Business justification: Transmission outages meeting NERC reportable criteria (BES facility outages, load loss >300MW, etc.) trigger mandatory self-reports to regional entities within 24 hours per NERC Rules of Procedure Sec"@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:SelfReport ;
    cmm:physicalColumn "self_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Self Report Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_self_report_id" ;
    cmm:cimAssociation "Outage.Document" .
cmm:TransmissionOutage.stormEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "storm event"@en ;
    rdfs:comment "Reference to a major storm event if the outage was storm-related. Links to enterprise storm tracking and mutual aid coordination."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range cmm:StormEvent ;
    cmm:physicalColumn "storm_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Storm Event Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_transmission_transmission_outage_storm_event_id" ;
    cmm:cimAssociation "Outage.Incident" .
cmm:TransmissionOutage.atcImpactMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "atc impact mw"@en ;
    rdfs:comment "Reduction in Available Transfer Capability in megawatts caused by the outage. Used for OASIS posting and market participant notification."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "atc_impact_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Available Transfer Capability (ATC) Impact Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:TransmissionOutage.besFacilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bes facility flag"@en ;
    rdfs:comment "Indicates whether the facility is classified as part of the Bulk Electric System under NERC definitions. Determines applicability of reliability standards."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "bes_facility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bulk Electric System (BES) Facility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionOutage.causeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause code"@en ;
    rdfs:comment "Standardized code identifying the root cause of the outage (e.g., equipment failure, weather, human error, vegetation). Aligned with NERC cause code taxonomy."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Code" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.causeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cause description"@en ;
    rdfs:comment "Detailed narrative description of the outage cause, including contributing factors and circumstances. Supports root cause analysis and lessons learned."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "cause_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Cause Description" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.createdByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by user"@en ;
    rdfs:comment "User identifier or system account that created the outage record. Supports accountability and audit trail requirements."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created By User" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when the outage record was first created in the system. Audit trail for data lineage and compliance."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Outage.createdDateTime .
cmm:TransmissionOutage.customerImpactCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer impact count"@en ;
    rdfs:comment "Estimated number of end-use customers indirectly affected by the transmission outage through cascading distribution impacts or load shedding."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:int ;
    cmm:physicalColumn "customer_impact_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Impact Count" ;
    cmm:cimDatatype "Integer" .
cmm:TransmissionOutage.durationHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "duration hours"@en ;
    rdfs:comment "Total duration of the outage event in hours, calculated from start to end timestamp. Key metric for transmission availability reporting."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "duration_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Duration Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:TransmissionOutage.endTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end timestamp"@en ;
    rdfs:comment "Date and time when the transmission facility was restored to service. Null for active outages. Used for duration and availability calculations."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:TransmissionOutage.equipmentAgeYears a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "equipment age years"@en ;
    rdfs:comment "Age of the failed or outaged equipment in years at the time of the outage. Used for asset health analysis and replacement planning."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:int ;
    cmm:physicalColumn "equipment_age_years" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Equipment Age Years" ;
    cmm:unitSymbol "year" ;
    cmm:cimDatatype "Integer" .
cmm:TransmissionOutage.estimatedRepairCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated repair cost"@en ;
    rdfs:comment "Estimated cost in USD to repair or replace the failed equipment and restore the facility. Used for financial planning and insurance claims."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_repair_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Repair Cost" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TransmissionOutage.facilityType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "facility type"@en ;
    rdfs:comment "Classification of the transmission facility experiencing the outage. Determines applicable reliability standards and reporting requirements."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "facility_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Facility Type" ;
    cmm:validValues "transmission_line|transformer|circuit_breaker|bus|capacitor_bank|reactor" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.fercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc reportable flag"@en ;
    rdfs:comment "Indicates whether the outage requires reporting to FERC under transmission service or reliability standards."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ferc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionOutage.lastMaintenanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last maintenance date"@en ;
    rdfs:comment "Date of the most recent maintenance activity performed on the facility prior to the outage. Used to assess maintenance effectiveness."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_maintenance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Maintenance Date" ;
    cmm:cimDatatype "Date" .
cmm:TransmissionOutage.loadShedMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load shed mw"@en ;
    rdfs:comment "Amount of customer load in megawatts that was shed or curtailed as a result of the transmission outage. Critical for reliability and regulatory reporting."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "load_shed_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Shed Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:TransmissionOutage.mwImpact a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mw impact"@en ;
    rdfs:comment "Estimated transmission capacity reduction in megawatts due to the outage. Used for congestion analysis and market impact assessment."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "mw_impact" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Megawatt (MW) Impact" ;
    cmm:cimDatatype "Decimal" .
cmm:TransmissionOutage.nercOutageReportingCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc outage reporting code"@en ;
    rdfs:comment "NERC-defined code indicating whether the outage meets criteria for mandatory reporting under NERC standards (e.g., OE-417 reportable event)."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_outage_reporting_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Outage Reporting Code" ;
    cmm:cimDatatype "String" .
cmm:TransmissionOutage.nercReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc reportable flag"@en ;
    rdfs:comment "Indicates whether the outage meets NERC criteria for mandatory reporting to DOE via OE-417 form (e.g., loss of firm load, BES facility outage exceeding thresholds)."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nerc_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TransmissionOutage.oe417ReportNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "oe417 report number"@en ;
    rdfs:comment "DOE OE-417 report number if the outage was reported to the Department of Energy. Links to federal emergency and disturbance reporting."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "oe417_report_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Office of Electricity (OE) Form 417 Report Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TransmissionOutage.outageNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage number"@en ;
    rdfs:comment "Business identifier for the transmission outage event, typically used in operational communications and reporting to RTOs/ISOs."@en ;
    rdfs:domain cmm:TransmissionOutage ; rdfs:range xsd:string ;
    cmm:physicalColumn "outage_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Outage Number" ;
    cmm:cimDatatype "String" ;
