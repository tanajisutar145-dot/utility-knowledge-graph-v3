cmm:SafetyIncident.investigationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "investigation status"@en ;
    rdfs:comment "Current status of the incident investigation workflow: not_started (incident logged, investigation pending), in_progress (active investigation), completed (findings documented), closed (corrective actions implemented and verified)."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
    cmm:physicalColumn "investigation_status" ;
