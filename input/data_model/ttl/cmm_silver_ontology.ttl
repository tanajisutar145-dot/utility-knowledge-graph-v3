cmm:DrIncentivePayment.capacityPaymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity payment amount"@en ;
    rdfs:comment "The calculated capacity payment amount in dollars based on enrolled capacity and capacity rate. Represents payment for availability."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_payment_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
