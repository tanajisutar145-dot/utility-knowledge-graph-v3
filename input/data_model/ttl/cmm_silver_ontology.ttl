    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:PostalAddress.line1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line 1"@en ;
    rdfs:comment "Primary street address line including street number, street name, and street type (e.g., 123 Main Street)."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "line_1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Line 1" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" .
cmm:PostalAddress.line2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "line 2"@en ;
    rdfs:comment "Secondary address line for apartment, suite, unit, building, floor, or other location identifiers."@en ;
    rdfs:domain cmm:PostalAddress ; rdfs:range xsd:string ;
    cmm:physicalColumn "line_2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Address Line 2" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
