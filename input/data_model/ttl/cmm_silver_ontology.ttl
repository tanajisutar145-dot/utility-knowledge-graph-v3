cmm:IncentiveProgram.fundingSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "funding source"@en ;
    rdfs:comment "Source of funding for the incentive program: ratepayer = utility customer rates, federal_grant = federal government funding, state_grant = state government funding, utility_shareholder = utility equity, carbon_credit = carbon offset revenue, rps_acp = RPS Alternative Compliance Payment funds."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "funding_source" ;
