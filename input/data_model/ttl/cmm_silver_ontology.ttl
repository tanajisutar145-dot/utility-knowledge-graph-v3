cmm:IncentiveApplication.projectCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project capacity kw"@en ;
    rdfs:comment "Nameplate capacity of the proposed renewable energy system in kilowatts."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "project_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Capacity (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
