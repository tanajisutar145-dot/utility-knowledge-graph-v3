cmm:FieldOrder a owl:Class ;
    rdfs:label "Field Order"@en ;
    rdfs:comment "Master reference table for field_order. Referenced by field_order_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:WorkTask ;
    cmm:cimCloseMatch cim:WorkTask ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:customer , cmmsa:customer.service_delivery ;
    cmm:physicalTable "utility_cmm_silver.customer.field_order" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.customer.field_order" ;
    owl:hasKey ( cmm:FieldOrder.fieldOrderId ) .

cmm:FieldOrder.fieldOrderId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field order id"@en ;
    rdfs:comment "Primary key for field_order"@en ;
    rdfs:domain cmm:FieldOrder ; rdfs:range xsd:long ;
    cmm:physicalColumn "field_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Field Order Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:FieldOrder.address a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "Identifier of the physical location where the field work is to be performed."@en ;
