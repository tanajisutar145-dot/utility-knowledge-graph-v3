cmm:JobRequisition.unionClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union classification"@en ;
    rdfs:comment "Indicates whether the position is covered by a collective bargaining agreement. Critical for labor relations, scheduling rules, and compensation administration."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Classification" ;
    cmm:validValues "union|non_union|management" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.unionLocal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "union local"@en ;
    rdfs:comment "Specific union local chapter governing the position (e.g., IBEW Local 1245, UWUA Local 246). Null for non-union positions. Determines applicable labor agreement terms."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "union_local" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Union Local" ;
