cmm:EmployeeQualification.workAuthorizationScope a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work authorization scope"@en ;
    rdfs:comment "Description of the specific work activities, equipment types, voltage classes, or operational systems the employee is authorized to work on based on this qualification. Critical for safety compliance and work assignment validation."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "work_authorization_scope" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Authorization Scope" ;
    cmm:cimDatatype "String" .

cmm:WorkforceCrewDispatch a owl:Class ;
    rdfs:label "Workforce Crew Dispatch"@en ;
    rdfs:comment "This association product represents the operational dispatch event linking field crews to outage restoration work. Each record captures a single dispatch assignment of one crew to one outage event, including dispatch timing, arrival, work execution windows, crew status transitions, priority, and field notes. This is the authoritative SSOT for crew deployment history, response time tracking, restoration labor allocation, and post-storm after-action analysis. Crew dispatches are created by OMS dispatchers, updated by field supervisors via mobile devices, and consumed by workforce analytics, FEMA reimbursement reporting, and reliability performance measurement systems.. Existence Justification: Crew dispatch to outage events is a canonical M:N operational relationship in utility outage management. A single major outage event (e.g., transmission line failure, storm damage) routinely requires multiple crews dispatched sequentially or simultaneously for damage assessment, isolation, repair, and restoration. Conversely, a single crew responds to multiple distinct outage events during a shift, storm period, or mutual aid deployment. Each dispatch is an operational business event actively managed by OMS dispatchers with rich lifecycle data including dispatch timing, arrival, work execution windows, status transitions, priority, and field notes."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:FieldDispatchHistory ;
    cmm:cimCloseMatch cim:FieldDispatchHistory ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Operations" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-3" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.workforce_crew_dispatch" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-3" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.workforce_crew_dispatch" ;
    owl:hasKey ( cmm:WorkforceCrewDispatch.workforceCrewDispatchId ) .

cmm:WorkforceCrewDispatch.workforceCrewDispatchId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "workforce crew dispatch id"@en ;
    rdfs:comment "Primary key for workforce_crew_dispatch"@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:long ;
    cmm:physicalColumn "workforce_crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "workforce_crew_dispatch Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:WorkforceCrewDispatch.crewDispatch a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew dispatch"@en ;
    rdfs:comment "Unique surrogate identifier for each crew dispatch record. Primary key for the association."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range cmm:OutageCrewDispatch ;
    cmm:physicalColumn "crew_dispatch_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch Identifier" ;
    cmm:sourceColumn "outage_crew_dispatch_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_workforce_crew_dispatch_crew_dispatch_id" ;
    cmm:cimAssociation "FieldDispatchHistory.FieldDispatchHistory" .
cmm:WorkforceCrewDispatch.crew a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "crew"@en ;
    rdfs:comment "Foreign key linking to the crew master record. Supports queries like 'show all outages this crew responded to' and enables crew performance analysis including average response time and restoration effectiveness."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range cmm:Crew ;
    cmm:physicalColumn "crew_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch - Crew Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_workforce_crew_dispatch_crew_id" ;
    cmm:cimAssociation "FieldDispatchHistory.Crew" .
cmm:WorkforceCrewDispatch.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to the outage event record for which this crew was dispatched. Supports queries like 'show all crews assigned to this outage' and enables aggregation of crew resources per event for major storm analysis."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Crew Dispatch - Outage Event Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_workforce_crew_dispatch_event_id" ;
    cmm:cimAssociation "FieldDispatchHistory.Outage" .
cmm:WorkforceCrewDispatch.actualResponseTimeMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual response time min"@en ;
    rdfs:comment "Calculated field: actual response time in minutes from dispatch to arrival (arrival_timestamp - dispatch_timestamp). Used for crew performance benchmarking, OMS dispatch optimization, and regulatory reporting of emergency response effectiveness."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_response_time_min" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Response Time Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkforceCrewDispatch.actualWorkDurationMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual work duration min"@en ;
    rdfs:comment "Calculated field: actual work duration in minutes from work start to completion (work_completed_timestamp - work_start_timestamp). Used for labor cost allocation, crew productivity analysis, and validation of OMS restoration time estimates."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "actual_work_duration_min" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Work Duration Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkforceCrewDispatch.arrivalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arrival timestamp"@en ;
    rdfs:comment "Timestamp when the crew arrived at the outage site, typically recorded via mobile device GPS check-in or crew foreman confirmation. Used to calculate actual response time (arrival - dispatch) for OMS performance metrics and IEEE 1366 reporting."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "arrival_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arrival Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkforceCrewDispatch.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the crew dispatch record was first created in the OMS or data platform. Supports audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.createdDateTime .
cmm:WorkforceCrewDispatch.crewType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "crew type"@en ;
    rdfs:comment "Classification of crew type dispatched to this outage. Captured at dispatch time to support analysis of crew type effectiveness by outage cause and to validate that appropriate crew skills were assigned. Values align with workforce.crew.crew_type enumeration."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "crew_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.kind .
cmm:WorkforceCrewDispatch.dispatchPriority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch priority"@en ;
    rdfs:comment "Numeric priority ranking assigned to this dispatch at time of assignment. Lower numbers indicate higher priority. Determined by outage severity, customer count, critical infrastructure impact, and restoration sequence optimization. Used by OMS to manage crew reassignment during major storm events when new high-priority outages emerge."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "dispatch_priority" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Priority" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Priority.rank .
cmm:WorkforceCrewDispatch.dispatchSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch source"@en ;
    rdfs:comment "Source or actor that initiated this crew dispatch. Supports analysis of automated vs. manual dispatch effectiveness and audit trail for crew assignment decisions during major events."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Source" ;
    cmm:cimDatatype "String" .
cmm:WorkforceCrewDispatch.dispatchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch status"@en ;
    rdfs:comment "Current lifecycle status of the crew dispatch assignment. Transitions tracked in OMS for real-time crew location awareness and restoration progress monitoring. Values: DISPATCHED (crew notified), EN_ROUTE (crew traveling), ON_SITE (crew arrived), WORKING (active restoration), COMPLETED (work finished), CANCELLED (dispatch cancelled before arrival), REASSIGNED (crew redirected to higher priority event)."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispatch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Dispatch Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:FieldDispatchHistory.status .
cmm:WorkforceCrewDispatch.dispatchTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispatch timestamp"@en ;
    rdfs:comment "Timestamp when the crew was officially dispatched to the outage event by the OMS dispatcher or automated dispatch system. Start of the dispatch lifecycle and baseline for response time calculation."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "dispatch_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispatch Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkforceCrewDispatch.estimatedTravelTimeMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated travel time min"@en ;
    rdfs:comment "Estimated travel time in minutes from crew location to outage site at time of dispatch. Calculated by OMS using GPS location and routing algorithms. Used to set initial ETR communicated to customers and to optimize crew assignment decisions."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:int ;
    cmm:physicalColumn "estimated_travel_time_min" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Travel Time Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WorkforceCrewDispatch.fieldCrewNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "field crew notes"@en ;
    rdfs:comment "Free-text notes entered by crew foreman or field supervisor documenting site conditions, work performed, materials used, safety incidents, or reasons for delays. Critical for post-storm after-action review, cause validation, and continuous improvement of OMS predictive models."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "field_crew_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Field Crew Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:WorkforceCrewDispatch.reassignmentReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reassignment reason"@en ;
    rdfs:comment "Free-text explanation if crew was reassigned or dispatch was cancelled before completion. Documents operational decisions during dynamic storm restoration when priorities shift rapidly."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "reassignment_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reassignment Reason" ;
    cmm:cimDatatype "String" .
cmm:WorkforceCrewDispatch.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to the crew dispatch record. Supports change data capture and real-time OMS dashboard refresh."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:WorkforceCrewDispatch.vehicleIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vehicle identifier"@en ;
    rdfs:comment "Identifier of the vehicle used by the crew for this dispatch. Captured for GPS tracking integration, equipment utilization analysis, and mutual aid reimbursement documentation. May reference workforce vehicle master or be free-text for contractor/mutual aid vehicles."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:string ;
    cmm:physicalColumn "vehicle_identifier" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Vehicle Identifier" ;
    cmm:cimDatatype "String" .
cmm:WorkforceCrewDispatch.workCompletedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work completed timestamp"@en ;
    rdfs:comment "Timestamp when the crew completed their assigned restoration work and cleared the site. Used to calculate crew work duration, support ETR accuracy analysis, and close the dispatch record in OMS."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "work_completed_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Completed Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:WorkforceCrewDispatch.workStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work start timestamp"@en ;
    rdfs:comment "Timestamp when the crew began active restoration work on the outage. May differ from arrival time due to site assessment, safety briefing, or waiting for switching orders. Used for labor cost allocation and work duration analysis."@en ;
    rdfs:domain cmm:WorkforceCrewDispatch ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "work_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Work Start Timestamp" ;
    cmm:cimDatatype "DateTime" .

cmm:ProjectAssignment a owl:Class ;
    rdfs:label "Project Assignment"@en ;
    rdfs:comment "This association product represents the Assignment between employee and capex_project. It captures the allocation of utility personnel to capital expenditure projects with role, time allocation, labor rates, and assignment lifecycle dates. Each record links one employee to one capex_project with attributes that exist only in the context of this specific project assignment. Supports capital cost tracking, labor capitalization, FERC reporting of labor costs by project, and resource planning across the capital portfolio.. Existence Justification: In utility capital project operations, employees are routinely assigned to multiple capital projects simultaneously with different roles and time allocations (e.g., a senior engineer at 30% on substation upgrade, 40% on transmission line replacement, 30% on distribution automation). Conversely, capital projects require cross-functional teams with multiple employees across disciplines (project managers, engineers, technicians, planners, safety officers). The business actively manages these assignments with specific roles, allocation percentages, labor rates, and approval workflows for capital cost tracking and FERC reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Assignment ;
    cmm:cimCloseMatch cim:Assignment ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.cost_allocation ;
    cmm:physicalTable "utility_cmm_silver.workforce.project_assignment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.project_assignment" ;
    owl:hasKey ( cmm:ProjectAssignment.projectAssignmentId ) .

cmm:ProjectAssignment.projectAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project assignment id"@en ;
    rdfs:comment "Unique identifier for this project assignment record. Primary key."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "project_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Project Assignment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ProjectAssignment.approvedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approved by employee"@en ;
    rdfs:comment "Employee identifier of the manager or resource planner who approved this project assignment. Foreign key to workforce.employee.employee_id. Used for audit trail and accountability."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approved_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approving Manager" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_project_assignment_approved_by_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ProjectAssignment.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to the capital expenditure project to which the employee is assigned"@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Assignment - Capex Project Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_project_assignment_capex_project_id" ;
    cmm:cimAssociation "Assignment.Project" .
cmm:ProjectAssignment.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Foreign key linking to the utility employee assigned to the capital project"@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Assignment - Employee Id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_project_assignment_employee_id" ;
    cmm:cimAssociation "Assignment.ErpPersonnel" .
cmm:ProjectAssignment.actualHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual hours"@en ;
    rdfs:comment "Cumulative actual hours the employee has worked on this capital project to date. Updated from timesheet system. Used for labor cost capitalization and variance analysis."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Assignment Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:ProjectAssignment.allocationPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation percentage"@en ;
    rdfs:comment "Percentage of the employee's working time allocated to this capital project. Used for resource planning and labor cost allocation. Sum of allocation_percentage across all active assignments for an employee should not exceed 100%. Example: 30.00 means 30% of employee time."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "allocation_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resource Allocation Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:ProjectAssignment.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when the project assignment was approved by the responsible manager. Used for audit trail and assignment lifecycle tracking."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectAssignment.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Workflow status of the project assignment. Pending: awaiting manager approval. Approved: authorized but not yet started. Active: employee currently working on project. Completed: assignment finished. Cancelled: assignment revoked before completion."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Approval Status" ;
    cmm:cimDatatype "String" .
cmm:ProjectAssignment.assignmentEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment end date"@en ;
    rdfs:comment "Date when the employee's assignment to this capital project ended or is planned to end. Null for ongoing assignments. Used for resource planning and labor cost cutoff."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment End Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectAssignment.assignmentNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment notes"@en ;
    rdfs:comment "Free-text notes about this project assignment, such as special skills required, shift preferences, or assignment constraints. Used for resource coordination."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "assignment_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Assignment Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:ProjectAssignment.assignmentStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assignment start date"@en ;
    rdfs:comment "Date when the employee began working on this capital project. Used to determine labor cost capitalization period and resource utilization reporting."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:date ;
    cmm:physicalColumn "assignment_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Assignment Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectAssignment.estimatedHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated hours"@en ;
    rdfs:comment "Estimated total hours the employee will work on this capital project over the assignment duration. Used for resource planning and budget forecasting."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Assignment Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:ProjectAssignment.laborRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "labor rate"@en ;
    rdfs:comment "Hourly or daily labor rate applied to this employee's work on this specific capital project, in USD. May differ from standard employee rate based on project type, funding source, or union agreement. Used for capital cost accumulation and FERC labor cost reporting."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "labor_rate" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capitalized Labor Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:ProjectAssignment.roleOnProject a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "role on project"@en ;
    rdfs:comment "The specific role or function the employee performs on this capital project. Examples: Project Manager, Lead Engineer, Field Engineer, Technician, Supervisor. Determines responsibility level and labor rate category for cost capitalization."@en ;
    rdfs:domain cmm:ProjectAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "role_on_project" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Project Role" ;
    cmm:cimDatatype "String" .

cmm:ScenarioParticipation a owl:Class ;
    rdfs:label "Scenario Participation"@en ;
    rdfs:comment "This association product represents the participation relationship between employees and IRP scenarios. It captures the role-based contribution of utility personnel (analysts, engineers, economists, managers) in developing, reviewing, and approving Integrated Resource Plan scenarios. Each record links one employee to one IRP scenario with attributes that document their specific role, contribution type, approval authority, and participation timeline. This data is critical for regulatory documentation, cross-examination preparation in PUC proceedings, and tracking accountability for scenario assumptions and modeling decisions.. Existence Justification: IRP scenario development is a collaborative multi-disciplinary process where multiple employees (analysts, engineers, economists, managers) contribute to each scenario in different roles, and each employee typically works on multiple scenarios within an IRP filing (base case, high growth, low carbon, etc.). The utility must track who participated in each scenario, their specific role and contribution type, approval authority level, and participation timeline for regulatory documentation and cross-examination preparation in PUC proceedings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.cost_allocation ;
    cmm:physicalTable "utility_cmm_silver.workforce.scenario_participation" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.scenario_participation" ;
    owl:hasKey ( cmm:ScenarioParticipation.scenarioParticipationId ) .

cmm:ScenarioParticipation.scenarioParticipationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scenario participation id"@en ;
    rdfs:comment "Unique identifier for this employee-scenario participation record. Primary key for the scenario_participation association product."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:long ;
    cmm:physicalColumn "scenario_participation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Scenario Participation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ScenarioParticipation.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Foreign key linking to the employee who participated in the IRP scenario development, review, or approval process"@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scenario Participation - Employee Id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_scenario_participation_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:ScenarioParticipation.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to the IRP scenario in which the employee participated"@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Scenario Participation - Irp Scenario Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_scenario_participation_irp_scenario_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ScenarioParticipation.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date the employee granted formal approval for this scenario (for approvers only). Null for contributors/reviewers or if approval is pending. Critical for establishing approval timeline for regulatory filing documentation."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:ScenarioParticipation.approvalLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval level"@en ;
    rdfs:comment "The approval authority level of the employee for this scenario. Contributor indicates working-level participation without approval authority. Reviewer indicates peer review responsibility. Manager/Director/VP/Executive indicate formal approval authority at different organizational levels. Used to establish approval chain for regulatory filings."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Level" ;
    cmm:cimDatatype "String" .
cmm:ScenarioParticipation.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "Current approval status for employees with approval authority. Pending indicates approval decision not yet made. Approved indicates formal approval granted. Rejected indicates approval withheld. Conditional indicates approval with conditions or caveats. Not Required for contributor-level participants without approval authority."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:cimDatatype "String" .
cmm:ScenarioParticipation.comments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "comments"@en ;
    rdfs:comment "Free-text comments or notes about this employee's participation, including specific contributions, concerns raised, conditions of approval, or areas of responsibility. Used for internal documentation and preparation for regulatory cross-examination."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:string ;
    cmm:physicalColumn "comments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Participation Comments" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ScenarioParticipation.contributionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contribution type"@en ;
    rdfs:comment "The type of work or analysis the employee contributed to this scenario. Examples include Load Forecasting (demand projections), Resource Modeling (capacity expansion modeling), Economic Analysis (cost-benefit analysis), Technical Review (engineering validation). Used to document the scope of each employee's contribution for cross-examination preparation."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:string ;
    cmm:physicalColumn "contribution_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contribution Type" ;
    cmm:cimDatatype "String" .
cmm:ScenarioParticipation.hoursContributed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "hours contributed"@en ;
    rdfs:comment "Total hours the employee contributed to this IRP scenario development. Used for project cost tracking, resource allocation analysis, and documenting level of effort for regulatory proceedings. Null if hours are not tracked for this participation type."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "hours_contributed" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Hours Contributed" ;
    cmm:cimDatatype "Decimal" .
cmm:ScenarioParticipation.participationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation end date"@en ;
    rdfs:comment "The date the employee completed their participation in this IRP scenario development. Null if participation is ongoing. Used to track duration of involvement and establish completion of review/approval responsibilities. Important for regulatory documentation showing when approvals were granted."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:date ;
    cmm:physicalColumn "participation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation End Date" ;
    cmm:cimDatatype "Date" .
cmm:ScenarioParticipation.participationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation start date"@en ;
    rdfs:comment "The date the employee began participating in this IRP scenario development. Used to track timeline of scenario development activities and establish when each contributor became involved. Important for regulatory documentation of scenario development process."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:date ;
    cmm:physicalColumn "participation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ScenarioParticipation.role a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "role"@en ;
    rdfs:comment "The specific role the employee performed in this IRP scenario development. Examples include Lead Analyst (primary scenario developer), Technical Reviewer (peer review of assumptions), Manager Approver (approval authority), Stakeholder Liaison (coordination with external parties). Critical for regulatory documentation showing who was responsible for each aspect of scenario development."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:string ;
    cmm:physicalColumn "role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Role" ;
    cmm:cimDatatype "String" .
cmm:ScenarioParticipation.testimonyWitnessFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "testimony witness flag"@en ;
    rdfs:comment "Indicates whether this employee is designated as a potential witness for testimony in PUC proceedings regarding this scenario. True if the employee may be called to testify about scenario assumptions, methodology, or results. Used for witness preparation and regulatory strategy."@en ;
    rdfs:domain cmm:ScenarioParticipation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "testimony_witness_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Testimony Witness Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:WorkLocation a owl:Class ;
    rdfs:label "Work Location"@en ;
    rdfs:comment "Master reference table for work_location. Referenced by work_location_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:WorkLocation ;
    cmm:cimExactMatch cim:WorkLocation ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Work" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.workforce_scheduling ;
    cmm:physicalTable "utility_cmm_silver.workforce.work_location" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Location (is-a; geometry via Location.PositionPoints)" ;
    cmm:standardReference "IEC 61968-6" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.work_location" ;
    owl:hasKey ( cmm:WorkLocation.workLocationId ) .

cmm:WorkLocation.workLocationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "work location id"@en ;
    rdfs:comment "Primary key for work_location"@en ;
    rdfs:domain cmm:WorkLocation ; rdfs:range xsd:long ;
    cmm:physicalColumn "work_location_id" ;
