    rdfs:domain cmm:SafetyTraining ; rdfs:range xsd:string ;
    cmm:physicalColumn "certification_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Certification Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
