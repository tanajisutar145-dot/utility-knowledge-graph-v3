    cmm:validValues "upheld|reduced|dismissed|remanded|settled" ;
    cmm:cimDatatype "String" .
cmm:PenaltyAssessment.contestResolutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contest resolution date"@en ;
