    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 62325-301" ;
    cmm:sourceObject "energy_utilities_ecm.trading.market_participant" ;
    owl:hasKey ( cmm:MarketParticipant.marketParticipantId ) .

