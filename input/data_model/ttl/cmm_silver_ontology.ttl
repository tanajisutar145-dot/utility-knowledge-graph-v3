cmm:IncentiveProgram.minimumSystemSizeKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum system size kw"@en ;
    rdfs:comment "Minimum renewable energy system capacity in kilowatts (kW) required for eligibility. Null if no minimum applies."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_system_size_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
