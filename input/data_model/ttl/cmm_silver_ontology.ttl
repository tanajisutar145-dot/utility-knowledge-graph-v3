cmm:DerSystem.nemEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem eligible flag"@en ;
    rdfs:comment "Indicates whether the DER system qualifies for net energy metering programs that credit customers for excess generation exported to the grid."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:DerSystem.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional notes, comments, or special considerations related to the DER system interconnection."@en ;
    rdfs:domain cmm:DerSystem ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "DER System Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:DerSystem.poiSpecification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi specification"@en ;
