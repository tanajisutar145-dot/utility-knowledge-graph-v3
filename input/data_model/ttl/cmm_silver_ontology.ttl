cmm:RateSchedule.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Additional notes, comments, or special instructions related to this rate schedule for internal reference."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Rate Schedule Notes" ;
