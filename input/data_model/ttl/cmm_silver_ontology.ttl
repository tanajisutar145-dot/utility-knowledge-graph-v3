    rdfs:comment "Status of Medical Review Officer review for drug test results. MRO verifies positive results and evaluates legitimate medical explanations per DOT 49 CFR Part 40."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:string ;
