cmm:DrAggregator.performancePenaltyRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "performance penalty rate"@en ;
    rdfs:comment "Financial penalty rate applied per MW of underperformance when the aggregator fails to deliver committed demand response capacity during an event."@en ;
