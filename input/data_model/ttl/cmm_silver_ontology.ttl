    cmm:cimDatatype "String" .
cmm:BillingServiceAgreement.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "Reason code or description explaining why the service agreement was terminated, such as customer move-out, non-payment disconnection, or service transfer."@en ;
    rdfs:domain cmm:BillingServiceAgreement ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agreement Termination Reason" ;
    cmm:cimDatatype "String" .

cmm:CustomerInvoice a owl:Class ;
    rdfs:label "Customer Invoice"@en ;
    rdfs:comment "Core transactional entity representing a utility bill issued to a customer for a billing period, including header-level totals and granular line-item charge detail. At the header level: captures invoice number, billing period dates, due date, total amount due, energy consumed (kWh/MWh), demand (kW), prior balance, current charges, taxes, adjustments, and payment status. At the line level: captures individual charge components including energy charges, demand charges, customer charges, fuel adjustment clauses, distribution riders, taxes, and credits with rate component reference, quantity, unit rate, calculated amount, and applicable billing determinant. Generated from Oracle CC&B and SAP IS-U billing engine. SSOT for all customer-facing billing documents and their charge detail. Supports SOX AR controls, granular revenue recognition, rate component-level analysis, and regulatory rate case evidence."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CustomerBillingInfo ;
    cmm:cimCloseMatch cim:CustomerBillingInfo ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfCustomers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.invoice_processing ;
    cmm:physicalTable "utility_cmm_silver.billing.invoice" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-8; Utility Bill / Invoice" ;
    cmm:sourceObject "energy_utilities_ecm.billing.invoice" ;
    owl:hasKey ( cmm:CustomerInvoice.invoiceId ) .

cmm:CustomerInvoice.invoiceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice id"@en ;
    rdfs:comment "Unique system identifier for the utility invoice. Primary key."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range xsd:long ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Invoice Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:CustomerInvoice.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account for which this invoice was generated."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_account_id" ;
    cmm:cimAssociation "CustomerBillingInfo.CustomerAccount" .
cmm:CustomerInvoice.billingRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing run"@en ;
    rdfs:comment "Foreign key linking to billing.billing_run. Business justification: Each invoice is created by a specific billing run execution (batch job). This FK enables tracing invoices back to the exact run that generated them, critical for exception handling, reprocessing, and"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:BillingRun ;
    cmm:physicalColumn "billing_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Run Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_billing_run_id" ;
    cmm:cimAssociation "CustomerBillingInfo.ActivityRecord" .
cmm:CustomerInvoice.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Foreign key linking to billing.billing_service_agreement. Business justification: An invoice is generated FOR a specific service agreement (the contractual billing relationship between utility and customer). While invoice currently has account_id and premise_id, it lacks the direct"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_billing_service_agreement_id" ;
    cmm:cimAssociation "CustomerBillingInfo.CustomerAgreement" .
cmm:CustomerInvoice.cycle a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle"@en ;
    rdfs:comment "Foreign key linking to billing.billing_cycle. Business justification: Each invoice is generated as part of a specific billing cycle execution. Currently invoice has billing_cycle_code (STRING) but no FK to the billing_cycle entity. This FK enables joining to retrieve cy"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:BillingCycle ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Cycle Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_cycle_id" ;
    cmm:cimAssociation "CustomerBillingInfo.TimeSchedule" .
cmm:CustomerInvoice.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Invoices post revenue to specific GL accounts for financial statement preparation and regulatory reporting. Every billed revenue transaction requires GL account assignment per FERC Uniform System of A"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_gl_account_id" ;
    cmm:cimAssociation "CustomerBillingInfo.ErpChartOfAccounts" .
cmm:CustomerInvoice.invoiceForServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice_for_service_agreement"@en ;
    rdfs:comment "FK to billing.billing_service_agreement.billing_service_agreement_id — Every invoice is generated for a specific service agreement. This is the core billing relationship — without it, invoices cannot be tied to the customer's contractual billing arrangement, rate schedul"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "invoice_for_service_agreement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_invoice_for_service_agreement" ;
    cmm:cimAssociation "CustomerBillingInfo.CustomerAgreement" .
cmm:CustomerInvoice.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Foreign key linking to metering.meter_point. Business justification: Invoices bill specific service points (meter_point). This link is fundamental for rate application, network cost allocation, and regulatory reporting by service location. Every invoice must identify w"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_meter_point_id" ;
    cmm:cimAssociation "CustomerBillingInfo.UsagePoint" .
cmm:CustomerInvoice.nemAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nem account"@en ;
    rdfs:comment "Foreign key linking to renewable.nem_account. Business justification: Invoices apply NEM credits from specific NEM accounts, track cumulative credit balances, and perform annual true-up settlements. Critical for accurate billing of net metering customers, ensuring prope"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:NemAccount ;
    cmm:physicalColumn "nem_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nem Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_nem_account_id" ;
    cmm:cimAssociation "CustomerBillingInfo.CustomerAccount" .
cmm:CustomerInvoice.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise where energy was consumed during this billing period."@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_premise_id" ;
    cmm:cimAssociation "CustomerBillingInfo.ServiceLocation" .
cmm:CustomerInvoice.serviceTerritory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service territory"@en ;
    rdfs:comment "Foreign key linking to distribution.service_territory. Business justification: Invoices require service territory reference for revenue allocation by jurisdiction, regulatory reporting (PUC filings), jurisdictional tax calculation, and franchise fee assessment. Critical for mult"@en ;
    rdfs:domain cmm:CustomerInvoice ; rdfs:range cmm:ServiceTerritory ;
    cmm:physicalColumn "service_territory_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Territory Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_invoice_service_territory_id" ;
