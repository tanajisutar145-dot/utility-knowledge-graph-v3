    cmm:businessTerm "Worker Last Name" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_name" ;
    cmm:cimDatatype "String" .
cmm:ContractorWorker.workerMiddleName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "worker middle name"@en ;
    rdfs:comment "Middle name or initial of the contractor worker, if provided."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
    cmm:physicalColumn "worker_middle_name" ;
