    rdfs:subPropertyOf cim:IdentifiedObject.mRID .
cmm:LocationAssignment.entityCimClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entity cim class"@en ;
    rdfs:comment "CIM class of the located entity."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "entity_cim_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entity Cim Class" ;
    cmm:cimDatatype "String" .
cmm:LocationAssignment.cimAssociationRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cim association role"@en ;
    rdfs:comment "CIM association implemented (e.g. PowerSystemResource.Location)."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "cim_association_role" ;
