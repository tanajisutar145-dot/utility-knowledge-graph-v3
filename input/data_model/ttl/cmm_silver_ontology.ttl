    rdfs:domain cmm:PlantVendorAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "response_time_hours" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
