cmm:NemCredit.creditPeriodEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit period end date"@en ;
    rdfs:comment "End date of the billing period during which the excess energy was exported to the grid and NEM credits were earned."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:date ;
    cmm:physicalColumn "credit_period_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Period End Date" ;
    cmm:cimDatatype "Date" .
cmm:NemCredit.creditPeriodStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit period start date"@en ;
    rdfs:comment "Start date of the billing period during which the excess energy was exported to the grid and NEM credits were earned."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:date ;
    cmm:physicalColumn "credit_period_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Period Start Date" ;
    cmm:cimDatatype "Date" .
