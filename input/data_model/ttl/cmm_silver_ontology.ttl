cmm:EmployeeQualification.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional context, special conditions, limitations, or comments related to the qualification. May include assessor observations, accommodation details, or cross-references to related certifications."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:EmployeeQualification.oshaSafetySensitiveFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha safety sensitive flag"@en ;
    rdfs:comment "Indicates whether this qualification involves safety-sensitive work activities subject to enhanced OSHA oversight, such as energized electrical work, confined space entry, or high-voltage operations. Triggers additional safety training and medical surveillance requirements."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "osha_safety_sensitive_flag" ;
