    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "dr_event_participant_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_primary_dr_event_participant_id" ;
    cmm:cimAssociation "Transaction.IdentifiedObject" .
cmm:DrIncentivePayment.primaryDrProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary dr program"@en ;
    rdfs:comment "Reference to the demand response program under which this payment is made (e.g., CPP, TOU, direct load control, interruptible tariff)."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "primary_dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Demand Response (DR) Program Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_primary_dr_program_id" ;
    cmm:cimAssociation "Transaction.DemandResponseProgram" .
cmm:DrIncentivePayment.profile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profile"@en ;
    rdfs:comment "Reference to the customer receiving the incentive payment. May be null if payment is made to an aggregator on behalf of multiple customers."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:CustomerProfile ;
