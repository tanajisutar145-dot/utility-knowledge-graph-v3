    cmm:cimDatatype "Boolean" .
cmm:CustomerInvoice.billMessageCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bill message code"@en ;
    rdfs:comment "Code identifying special messages or notices printed on the invoice (e.g., disconnection warning, rate change notice, energy efficiency tips)."@en ;
