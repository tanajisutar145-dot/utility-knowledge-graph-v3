    cmm:cimDatatype "Integer" .
cmm:NercCipAsset.besCyberSystemCategorization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bes cyber system categorization"@en ;
    rdfs:comment "Classification of the asset within the NERC CIP framework: BES Cyber System, BES Cyber Asset, Electronic Access Point (EAP), Physical Access Control System, Protected Cyber Asset, or Non-BES Cyber System."@en ;
    rdfs:domain cmm:NercCipAsset ; rdfs:range xsd:string ;
    cmm:physicalColumn "bes_cyber_system_categorization" ;
    cmm:sqlDataType "STRING" ;
