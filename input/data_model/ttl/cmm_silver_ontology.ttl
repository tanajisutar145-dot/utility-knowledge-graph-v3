cmm:AncillaryServiceOffer.offerIntervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "offer interval end timestamp"@en ;
    rdfs:comment "End date and time of the operating interval for which the ancillary service is offered."@en ;
    rdfs:domain cmm:AncillaryServiceOffer ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "offer_interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Offer Interval End Timestamp" ;
