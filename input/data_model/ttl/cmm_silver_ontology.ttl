cmm:CpcnApplication.updatedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated by user"@en ;
    rdfs:comment "User ID or name of the individual who last updated the CPCN application record."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "updated_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Updated By User" ;
    cmm:cimDatatype "String" .

cmm:IrpFiling a owl:Class ;
    rdfs:label "Irp Filing"@en ;
    rdfs:comment "Record of Integrated Resource Plan (IRP) filings submitted to state PUCs, capturing the planning horizon, load forecast assumptions, resource portfolio scenarios evaluated, preferred resource plan, renewable energy targets, demand response commitments, capital investment schedule, and commission approval status. IRPs are typically filed every 2-4 years and serve as the utility's long-term capacity and resource adequacy roadmap subject to regulatory review."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.irp_filing" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "State IRP Rules; DOE IRP Guidelines; NERC Long-Term Reliability Assessment" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.irp_filing" ;
    owl:hasKey ( cmm:IrpFiling.irpFilingId ) .

cmm:IrpFiling.irpFilingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "irp filing id"@en ;
    rdfs:comment "Unique identifier for the IRP filing record. Primary key."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:long ;
    cmm:physicalColumn "irp_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Integrated Resource Plan (IRP) Filing Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:IrpFiling.fuelPriceAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fuel price assumption"@en ;
    rdfs:comment "Foreign key linking to forecast.fuel_price_assumption. Business justification: IRP filings must document fuel price assumptions used in resource planning economic analysis. Regulatory transparency requirement - fuel costs drive LCOE calculations and portfolio optimization in pre"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:FuelPriceAssumption ;
    cmm:physicalColumn "fuel_price_assumption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fuel Price Assumption Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_fuel_price_assumption_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:IrpFiling.leadPlannerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lead planner employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: IRP filings require employee lead planner accountability for integrated resource planning process. Replaces denormalized fields with FK to enable planning capacity management and succession planning."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "lead_planner_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lead Planner Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_lead_planner_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:IrpFiling.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: IRP filings must cite the official load forecast used for planning horizon. Regulatory requirement for PUC approval - load forecast is foundational input to resource adequacy demonstration and capacit"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Base Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_load_id" ;
    cmm:cimAssociation "Document.ConformLoadSchedule" .
cmm:IrpFiling.peakDemand a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand"@en ;
    rdfs:comment "Foreign key linking to forecast.peak_demand. Business justification: IRP filings cite peak demand forecasts for capacity adequacy demonstrations and reserve margin calculations. Required for PUC approval of resource plans - peak demand drives capacity requirement deter"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:PeakDemand ;
    cmm:physicalColumn "peak_demand_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Peak Demand Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_peak_demand_id" ;
    cmm:cimAssociation "Document.RegularIntervalSchedule" .
cmm:IrpFiling.planningAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "planning assumption"@en ;
    rdfs:comment "Foreign key linking to forecast.planning_assumption. Business justification: IRP filings reference load growth and other planning assumptions as foundational inputs to resource plan justification. PUC requires documentation of all key assumptions used in modeling for stakehold"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:PlanningAssumption ;
    cmm:physicalColumn "planning_assumption_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Load Growth Assumption Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_planning_assumption_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:IrpFiling.primaryCapexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: Integrated Resource Plans identify future capital needs and preferred portfolios. While one IRP may reference multiple projects, linking to the primary/flagship project enables tracking plan-to-execut"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "primary_capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Primary Capex Project Id (Foreign Key)" ;
    cmm:sourceColumn "capex_project_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_primary_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:IrpFiling.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: irp_filing is a specialized type of regulatory filing (IRP submissions to state PUCs). This represents a specialization relationship where irp_filing extends regulatory_filing with IRP-specific attrib"@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_irp_filing_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:IrpFiling.actionPlanRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "action plan required flag"@en ;
    rdfs:comment "Indicates whether the commission required the utility to submit an action plan or compliance filing following the IRP decision."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "action_plan_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Action Plan Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IrpFiling.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Indicates whether this IRP filing record is currently active and represents the most recent filing for the jurisdiction."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Record Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IrpFiling.baselineCarbonEmissionsTons a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "baseline carbon emissions tons"@en ;
    rdfs:comment "The baseline annual carbon emissions in metric tons used as the reference point for reduction targets."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "baseline_carbon_emissions_tons" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Baseline Carbon Emissions (Tons)" ;
    cmm:unitSymbol "t" ;
    cmm:cimDatatype "Mass" .
cmm:IrpFiling.boardApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board approval date"@en ;
    rdfs:comment "The date the utility Board of Directors approved the IRP prior to regulatory filing."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board of Directors Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:IrpFiling.capitalInvestmentSchedule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capital investment schedule"@en ;
    rdfs:comment "Year-by-year breakdown of planned capital investments for resource additions and infrastructure upgrades."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "capital_investment_schedule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capital Investment Schedule" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" .
cmm:IrpFiling.carbonReductionTargetPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "carbon reduction target percent"@en ;
    rdfs:comment "The target percentage reduction in carbon emissions by the end of the planning horizon relative to a baseline year."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "carbon_reduction_target_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Carbon Emissions Reduction Target Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:IrpFiling.commissionApprovalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commission approval date"@en ;
    rdfs:comment "The date the regulatory commission issued its final order approving, rejecting, or modifying the IRP."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "commission_approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commission Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:IrpFiling.commissionDecisionSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commission decision summary"@en ;
    rdfs:comment "Summary of the regulatory commissions decision including any modifications, conditions, or directives imposed on the preferred portfolio."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "commission_decision_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Commission Decision Summary" ;
    cmm:cimDatatype "String" .
cmm:IrpFiling.commissionOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commission order number"@en ;
    rdfs:comment "The official order number issued by the regulatory commission for the IRP decision."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "commission_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commission Order Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:IrpFiling.confidentialFilingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidential filing flag"@en ;
    rdfs:comment "Indicates whether portions of the IRP filing contain confidential or commercially sensitive information subject to protective order."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "confidential_filing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Confidential Filing Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IrpFiling.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this IRP filing record was first created in the system."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:IrpFiling.demandResponseTargetMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response target mw"@en ;
    rdfs:comment "The target demand response capacity in megawatts to be achieved during the planning horizon."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_response_target_mw" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Target Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:IrpFiling.distributionInvestmentUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "distribution investment usd"@en ;
    rdfs:comment "Estimated capital investment in US dollars for distribution system upgrades and expansions during the planning horizon."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "distribution_investment_usd" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distribution Investment (USD)" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IrpFiling.energyEfficiencyTargetGwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "energy efficiency target gwh"@en ;
    rdfs:comment "The target cumulative annual energy savings in gigawatt-hours from energy efficiency programs by the end of the planning horizon."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "energy_efficiency_target_gwh" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Efficiency Target (GWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "G" ;
    cmm:cimDatatype "RealEnergy" .
cmm:IrpFiling.executiveSponsorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "executive sponsor name"@en ;
    rdfs:comment "Name of the executive sponsor or officer who authorized the IRP filing on behalf of the utility."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "executive_sponsor_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Executive Sponsor Name" ;
    cmm:cimDatatype "String" .
cmm:IrpFiling.filingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing date"@en ;
    rdfs:comment "The date the IRP was officially submitted to the regulatory commission."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "IRP Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:IrpFiling.filingJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing jurisdiction"@en ;
    rdfs:comment "The state or regulatory jurisdiction where the IRP is filed (e.g., state PUC code or name)."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Filing Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:IrpFiling.filingNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing notes"@en ;
    rdfs:comment "Additional notes, comments, or context regarding the IRP filing, review process, or implementation status."@en ;
    rdfs:domain cmm:IrpFiling ; rdfs:range xsd:string ;
    cmm:physicalColumn "filing_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "IRP Filing Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
