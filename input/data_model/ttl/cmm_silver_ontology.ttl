cmm:MarketParticipant a owl:Class ;
    rdfs:label "Market Participant"@en ;
    rdfs:comment "Master reference table for market_participant. Referenced by market_participant_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MarketParticipant ;
    cmm:cimExactMatch cim:MarketParticipant ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC62325::MarketCommon" ;
    cmm:cimStandard "IEC 62325-301" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.market_operations ;
