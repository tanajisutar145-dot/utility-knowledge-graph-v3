cmm:ClusterStudyGroup.protectionCoordinationReviewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection coordination review flag"@en ;
    rdfs:comment "Indicates whether protection coordination review was performed as part of the cluster study. True if protective relay settings and coordination were evaluated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "protection_coordination_review_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Coordination Review Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ClusterStudyGroup.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "Regulatory authority or jurisdiction governing the cluster study process and interconnection requirements. Typically state PUC or FERC for wholesale interconnections."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.shortCircuitAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "short circuit analysis performed flag"@en ;
    rdfs:comment "Indicates whether short circuit analysis was performed as part of the cluster study. True if fault current contribution and protective device coordination were evaluated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "short_circuit_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Short Circuit Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ClusterStudyGroup.stabilityAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stability analysis performed flag"@en ;
    rdfs:comment "Indicates whether dynamic stability analysis was performed as part of the cluster study. True if transient and voltage stability were evaluated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "stability_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stability Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ClusterStudyGroup.studyAgreementExecutedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study agreement executed date"@en ;
    rdfs:comment "Date when the cluster study agreement was executed by all participating applicants. Marks the contractual commitment to proceed with the study."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_agreement_executed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Agreement Executed Date" ;
    cmm:cimDatatype "Date" .
cmm:ClusterStudyGroup.studyContractor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study contractor"@en ;
    rdfs:comment "Name of the engineering firm or consultant performing the cluster study analysis. May be internal utility engineering team or external third-party contractor."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_contractor" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Contractor" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.studyContractorType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study contractor type"@en ;
    rdfs:comment "Classification of the entity performing the cluster study work. Indicates whether study is conducted by utility staff or external resources."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_contractor_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Contractor Type" ;
    cmm:validValues "internal|external_consultant|independent_engineer" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.studyCostCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the study cost estimate amount. Typically USD for US utilities."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ClusterStudyGroup.studyCostEstimateAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study cost estimate amount"@en ;
    rdfs:comment "Total estimated cost for performing the cluster study analysis. Includes engineering labor, modeling, analysis, and report preparation costs."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "study_cost_estimate_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Cost Estimate Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ClusterStudyGroup.studyDepositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study deposit amount"@en ;
    rdfs:comment "Total deposit amount collected from participating applicants to fund the cluster study. Typically a percentage of the estimated study cost."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "study_deposit_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Deposit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ClusterStudyGroup.studyDepositReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study deposit received date"@en ;
    rdfs:comment "Date when the required study deposit was received from all participating applicants. Triggers the start of study work."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_deposit_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Deposit Received Date" ;
    cmm:cimDatatype "Date" .
cmm:ClusterStudyGroup.studyDurationDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study duration days"@en ;
    rdfs:comment "Total number of calendar days from study initiation to actual completion. Used for performance tracking and regulatory compliance reporting."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:int ;
    cmm:physicalColumn "study_duration_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Duration Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:ClusterStudyGroup.studyFindingsSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study findings summary"@en ;
    rdfs:comment "Executive summary of the cluster study technical findings, conclusions, and recommendations. Provides high-level overview of study results for stakeholders."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_findings_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Findings Summary" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.studyGroupName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study group name"@en ;
    rdfs:comment "Descriptive name assigned to the cluster study group, often reflecting the geographic area or study cycle identifier."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_group_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Study Group Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:ClusterStudyGroup.studyGroupNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study group number"@en ;
    rdfs:comment "Business identifier assigned to the cluster study group for external reference and tracking. Typically follows utility-specific numbering convention for cluster studies."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_group_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Group Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ClusterStudyGroup.studyGroupStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study group status"@en ;
    rdfs:comment "Current lifecycle status of the cluster study group. Tracks progression from formation through completion or cancellation."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_group_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Group Status" ;
    cmm:validValues "forming|active|in_progress|completed|suspended|cancelled" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:ClusterStudyGroup.studyInitiationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study initiation date"@en ;
    rdfs:comment "Date when the cluster study work officially commenced. Marks the beginning of technical analysis and impact assessment activities."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_initiation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Initiation Date" ;
    cmm:cimDatatype "Date" .
cmm:ClusterStudyGroup.studyReportDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study report document reference"@en ;
    rdfs:comment "Document management system reference or file path to the final cluster study report. Provides link to the complete technical study documentation."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_report_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Report Document Reference" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.studyScopeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study scope description"@en ;
    rdfs:comment "Detailed description of the technical scope and analysis activities included in the cluster study. Outlines the specific assessments, models, and scenarios to be evaluated."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_scope_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Scope Description" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.studyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study type"@en ;
    rdfs:comment "Classification of the cluster study being performed. Determines the scope and depth of technical analysis required under FERC Order 2023 cluster study process."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Type" ;
    cmm:validValues "cluster_feasibility|cluster_system_impact|cluster_facilities|combined_cluster" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:ClusterStudyGroup.targetCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target completion date"@en ;
    rdfs:comment "Planned or estimated date for completion of the cluster study. Established based on FERC Order 2023 timelines and study scope."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:date ;
    cmm:physicalColumn "target_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:ClusterStudyGroup.technicalFeasibilityDetermination a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technical feasibility determination"@en ;
    rdfs:comment "Overall determination of technical feasibility for interconnecting the cluster study group capacity. Indicates whether the aggregate DER can be safely interconnected with or without network upgrades."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "technical_feasibility_determination" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technical Feasibility Determination" ;
    cmm:validValues "feasible|feasible_with_upgrades|not_feasible|conditional" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.totalProposedCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total proposed capacity kw"@en ;
    rdfs:comment "Aggregate nameplate capacity in kilowatts of all DER systems included in the cluster study group. Sum of all application capacities within the cohort."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_proposed_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Proposed Capacity Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:ClusterStudyGroup.totalProposedCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total proposed capacity mw"@en ;
    rdfs:comment "Aggregate nameplate capacity in megawatts of all DER systems included in the cluster study group. Calculated for transmission-level impact assessment."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_proposed_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Proposed Capacity Megawatts (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ClusterStudyGroup.upgradeCostAllocationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade cost allocation methodology"@en ;
    rdfs:comment "Method used to allocate network upgrade costs among participating interconnection applications in the cluster study group. Describes the formula or approach for distributing upgrade financial responsibility."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_cost_allocation_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Upgrade Cost Allocation Methodology" ;
    cmm:cimDatatype "String" .
cmm:ClusterStudyGroup.upgradeCostCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the network upgrade cost estimate amount. Typically USD for US utilities."@en ;
    rdfs:domain cmm:ClusterStudyGroup ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Upgrade Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .


#################################################################
# Subject area: metering
#################################################################

cmm:Meter a owl:Class ;
    rdfs:label "Meter"@en ;
    rdfs:comment "Master record for every physical metering device deployed or managed by the utility — smart meters (AMI), interval meters, demand meters, and legacy electromechanical units. Captures device identity (serial number, manufacturer, model), firmware version, meter form factor, voltage class, current rating, number of elements, register configuration, seal status, and AMI head-end system assignment. Includes embedded communication module attributes: module type (RF mesh/PLC/cellular), module serial number, MAC/IP address, signal strength baseline, module firmware version, communication protocol, assigned AMI network segment, and module status — supporting independent module replacement tracking without a separate entity. Also captures the active and historical programmed operational configuration: interval length setting (15/30/60 min), TOU rate program assignment, demand reset interval, load profile channels enabled, remote disconnect/reconnect capability, and configuration effective dates for versioning. SSOT for meter asset identity, communication endpoint, and device configuration within the metering domain; links to the asset domain for full lifecycle management."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Meter ;
    cmm:cimExactMatch cim:Meter ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.meter_management ;
    cmm:physicalTable "utility_cmm_silver.metering.meter" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "Asset.Location" ;
    cmm:standardReference "IEC 61968-9; ANSI C12; Oracle Utilities MDM — Device Master" ;
    cmm:sourceObject "energy_utilities_ecm.metering.meter" ;
    owl:hasKey ( cmm:Meter.meterId ) .

cmm:Meter.meterId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter id"@en ;
    rdfs:comment "Unique identifier for the physical metering device. Primary key for the meter entity. System-of-record: Oracle Utilities MDM meter object."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:long ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Meter Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:Meter.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: Meters are capitalized assets requiring depreciation tracking per FERC Uniform System of Accounts (Account 370 - Meters). Essential for plant-in-service accounting, RAB valuation, depreciation expense"@en ;
    rdfs:domain cmm:Meter ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_fixed_asset_id" ;
    cmm:cimAssociation "Meter.FinancialInfo" .
cmm:Meter.meterAmiHeadEnd a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter ami head end"@en ;
    rdfs:comment "Foreign key linking to metering.ami_head_end. Business justification: Meters are enrolled in and managed by specific AMI head-end systems. The meter table currently has ami_head_end_system as a STRING attribute, which should be normalized to a FK relationship. This is a"@en ;
    rdfs:domain cmm:Meter ; rdfs:range cmm:AmiHeadEnd ;
    cmm:physicalColumn "meter_ami_head_end_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ami Head End Id (Foreign Key)" ;
    cmm:sourceColumn "ami_head_end_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_meter_ami_head_end_id" ;
    cmm:cimAssociation "Meter.IdentifiedObject" .
cmm:Meter.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Meters must comply with regulatory obligations for accuracy (ANSI C12.20), testing frequency, certification. Supports compliance tracking, audit evidence, regulatory reporting on meter accuracy progra"@en ;
    rdfs:domain cmm:Meter ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_obligation_id" ;
    cmm:cimAssociation "Meter.Document" .
cmm:Meter.toAmiHeadEnd a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to ami head end"@en ;
    rdfs:comment "FK to metering.ami_head_end.ami_head_end_id — Each smart meter is assigned to an AMI head-end system for communication management. Required for data collection scheduling and network management."@en ;
    rdfs:domain cmm:Meter ; rdfs:range cmm:AmiHeadEnd ;
    cmm:physicalColumn "to_ami_head_end_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_to_ami_head_end_id" ;
    cmm:cimAssociation "Meter.IdentifiedObject" .
cmm:Meter.touRateProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tou rate program"@en ;
    rdfs:comment "Foreign key linking to metering.tou_rate_program. Business justification: Meters are configured with specific Time-of-Use (TOU) rate programs that define peak/off-peak periods, CPP event criteria, and interval data requirements. The meter table currently has tou_rate_progra"@en ;
    rdfs:domain cmm:Meter ; rdfs:range cmm:TouRateProgram ;
    cmm:physicalColumn "tou_rate_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Tou Rate Program Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_tou_rate_program_id" ;
    cmm:cimAssociation "Meter.TimeTariffInterval" .
cmm:Meter.accuracyClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accuracy class"@en ;
    rdfs:comment "ANSI accuracy classification of the meter (e.g., Class 0.2, Class 0.5, Class 1.0, Class 2.0). Lower numbers indicate higher precision. Determines acceptable measurement error tolerance and testing requirements."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "accuracy_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Accuracy Class" ;
    cmm:cimDatatype "String" .
cmm:Meter.amiNetworkSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami network segment"@en ;
    rdfs:comment "Identifier of the AMI communication network segment or cell to which this meter is assigned. Used for network planning, troubleshooting, and load balancing across AMI infrastructure."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "ami_network_segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Network Segment" ;
    cmm:cimDatatype "String" .
cmm:Meter.communicationModuleSerial a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication module serial"@en ;
    rdfs:comment "Unique serial number of the communication module. Tracked separately from meter serial to support independent module replacement without replacing the entire meter. Used for module-level warranty and troubleshooting."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_module_serial" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Module Serial Number" ;
    cmm:cimDatatype "String" .
cmm:Meter.communicationModuleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication module type"@en ;
    rdfs:comment "Technology type of the embedded or attached communication module enabling remote meter reading. RF Mesh uses radio frequency mesh networks; PLC uses power line carrier; Cellular uses mobile networks; Fiber uses optical networks; None for non-communicating meters."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_module_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Module Type" ;
    cmm:validValues "RF Mesh|PLC|Cellular|Fiber|None" ;
    cmm:cimDatatype "String" .
cmm:Meter.communicationProtocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "communication protocol"@en ;
    rdfs:comment "Application-layer protocol used for meter-to-head-end communication (e.g., ANSI C12.22, DLMS/COSEM, SEP 2.0, Modbus). Determines data format, security features, and interoperability with AMI systems."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "communication_protocol" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Protocol" ;
    cmm:cimDatatype "String" .
cmm:Meter.configurationEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "configuration effective date"@en ;
    rdfs:comment "Date when the current operational configuration (interval length, TOU program, demand reset, channels) became active. Used for configuration versioning and historical data interpretation. Critical for billing accuracy during configuration changes."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "configuration_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Configuration Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:Meter.configurationExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "configuration expiration date"@en ;
    rdfs:comment "Date when the current operational configuration is scheduled to expire or be replaced. Nullable for open-ended configurations. Used for planned configuration change management and audit trails."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "configuration_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Configuration Expiration Date" ;
    cmm:cimDatatype "Date" .
cmm:Meter.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this meter record was first created in the MDM system. Used for data lineage, audit trails, and system integration reconciliation. Distinct from installation date."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Meter.createdDateTime .
cmm:Meter.currentRatingAmps a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "current rating amps"@en ;
    rdfs:comment "Maximum continuous current the meter can measure in amperes. Typical values: 100A, 200A, 320A. Used to ensure meter capacity matches service load requirements."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "current_rating_amps" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Current Rating in Amperes (Amps)" ;
    cmm:unitSymbol "A" ;
    cmm:cimDatatype "CurrentFlow" .
cmm:Meter.demandResetIntervalMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand reset interval minutes"@en ;
    rdfs:comment "Programmed interval in minutes for resetting the demand register (e.g., 15, 30 minutes). Determines how frequently peak demand is calculated and recorded. Critical for demand billing accuracy."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:int ;
    cmm:physicalColumn "demand_reset_interval_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Reset Interval in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:Meter.disconnectSwitchStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disconnect switch status"@en ;
    rdfs:comment "Current position of the remote disconnect switch for meters with disconnect capability. Connected indicates service is on; Disconnected indicates service is off; Armed indicates ready for remote command; Not Applicable for meters without disconnect."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "disconnect_switch_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disconnect Switch Status" ;
    cmm:validValues "Connected|Disconnected|Armed|Not Applicable" ;
    cmm:cimDatatype "String" .
cmm:Meter.firmwareVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "firmware version"@en ;
    rdfs:comment "Version identifier of the embedded software running on the meter device. Critical for security patching, feature enablement, and compatibility with head-end systems. Tracked for firmware upgrade campaigns."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "firmware_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Firmware Version" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ProductAssetModel.modelVersion .
cmm:Meter.form a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "form"@en ;
    rdfs:comment "ANSI form designation describing the physical configuration and wiring arrangement of the meter (e.g., Form 2S, Form 12S, Form 16S). Determines socket compatibility and installation requirements."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "form" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Form Factor" ;
    cmm:cimDatatype "String" .
cmm:Meter.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date the meter was physically installed at its current service location. Used for age tracking, warranty calculations, and lifecycle management. Distinct from manufacturing date."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Meter Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:LifecycleDate.installationDate .
cmm:Meter.intervalLengthMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval length minutes"@en ;
    rdfs:comment "Programmed interval duration in minutes for load profile data collection (e.g., 15, 30, 60 minutes). Determines granularity of consumption data for billing, demand response, and grid analytics. Configurable parameter tracked for versioning."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_length_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Length in Minutes" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:Meter.ipAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ip address"@en ;
    rdfs:comment "Assigned IP address for meters using IP-based communication protocols (cellular, fiber). Used for direct meter communication, remote diagnostics, and firmware updates. Confidential to prevent unauthorized access."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "ip_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Internet Protocol (IP) Address" ;
    cmm:sensitivity "confidential" ;
    cmm:valuePattern "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$" ;
    cmm:cimDatatype "String" .
cmm:Meter.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to any field in this meter record. Used for change tracking, data synchronization, and audit compliance. Updated automatically on any record modification."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:Meter.lifecycleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lifecycle status"@en ;
    rdfs:comment "Current state of the meter in its asset lifecycle. Installed indicates active deployment; In Stock indicates warehouse inventory; In Transit indicates shipment; Retired indicates end-of-life; Failed indicates defective; Under Test indicates lab testing."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "lifecycle_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Lifecycle Status" ;
    cmm:validValues "Installed|In Stock|In Transit|Retired|Failed|Under Test" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Meter.status .
cmm:Meter.loadProfileChannelsEnabled a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile channels enabled"@en ;
    rdfs:comment "Comma-separated list of load profile channels currently enabled for data collection (e.g., kWh Delivered, kWh Received, kVARh, Voltage, Current). Defines which measurement streams are actively recorded in interval data."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_channels_enabled" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Profile Channels Enabled" ;
    cmm:cimDatatype "String" .
cmm:Meter.macAddress a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mac address"@en ;
    rdfs:comment "Hardware MAC address of the communication module network interface. Used for network device identification, AMI head-end provisioning, and communication diagnostics. Confidential to prevent network security risks."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "mac_address" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Media Access Control (MAC) Address" ;
    cmm:sensitivity "confidential" ;
    cmm:valuePattern "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" ;
    cmm:cimDatatype "String" .
cmm:Meter.manufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer"@en ;
    rdfs:comment "Name of the company that manufactured the meter device (e.g., Landis+Gyr, Itron, Sensus, Elster, Aclara). Used for vendor management, warranty tracking, and firmware compatibility."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Manufacturer" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Manufacturer.name .
cmm:Meter.meterType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter type"@en ;
    rdfs:comment "Classification of meter technology and capability level. AMI Smart Meter supports two-way communication and remote operations; Interval Meter records time-series consumption; Demand Meter tracks peak demand; Electromechanical is legacy analog; Electronic is digital non-communicating; Prepaid supports prepayment programs."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Type Classification" ;
    cmm:validValues "AMI Smart Meter|Interval Meter|Demand Meter|Electromechanical|Electronic|Prepaid" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Meter.type .
cmm:Meter.modelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model number"@en ;
    rdfs:comment "Manufacturer model designation identifying the specific meter product line and capabilities. Used for configuration management, firmware updates, and technical specifications lookup."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "model_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Model Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Meter.moduleFirmwareVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "module firmware version"@en ;
    rdfs:comment "Version identifier of the firmware running on the communication module, tracked separately from meter firmware. Critical for communication security patches and protocol updates."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "module_firmware_version" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Module Firmware Version" ;
    cmm:cimDatatype "String" .
cmm:Meter.moduleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "module status"@en ;
    rdfs:comment "Current operational status of the communication module. Active indicates normal operation; Inactive indicates disabled but functional; Failed indicates hardware failure; Replaced indicates module swap; Not Installed for non-AMI meters."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "module_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Communication Module Status" ;
    cmm:validValues "Active|Inactive|Failed|Replaced|Not Installed" ;
    cmm:cimDatatype "String" .
cmm:Meter.nextTestDueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next test due date"@en ;
    rdfs:comment "Scheduled date for the next required accuracy test or calibration. Calculated based on regulatory testing intervals (typically 5-15 years depending on meter type and jurisdiction). Used for test planning and compliance tracking."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_test_due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Next Test Due Date" ;
    cmm:cimDatatype "Date" .
cmm:Meter.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special handling instructions, field observations, or historical context not captured in structured fields. Used by field technicians and operations staff."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:Meter.numberOfElements a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of elements"@en ;
    rdfs:comment "Count of independent metering elements within the device. Single-phase meters have 1 element; polyphase meters have 2 or 3 elements. Determines measurement capability for multi-phase services."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_elements" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Metering Elements" ;
    cmm:cimDatatype "Integer" .
cmm:Meter.ownershipStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ownership status"@en ;
    rdfs:comment "Legal ownership classification of the meter asset. Utility Owned is standard for most deployments; Customer Owned for customer-purchased meters; Leased for rental arrangements; Third Party for meters owned by service providers."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "ownership_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Ownership Status" ;
    cmm:validValues "Utility Owned|Customer Owned|Leased|Third Party" ;
    cmm:cimDatatype "String" .
cmm:Meter.purchaseOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order number"@en ;
    rdfs:comment "Purchase order number under which this meter was procured. Used for procurement tracking, warranty validation, and vendor management. Links to financial and supply chain systems."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "purchase_order_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Purchase Order (PO) Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Meter.registerConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "register configuration"@en ;
    rdfs:comment "Description of the meter register setup including number of dials, multiplier, and measurement units (kWh, kVARh, kW demand). Defines what consumption data the meter captures and how it is displayed."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "register_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Register Configuration" ;
    cmm:cimDatatype "String" .
cmm:Meter.remoteDisconnectCapable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remote disconnect capable"@en ;
    rdfs:comment "Boolean flag indicating whether the meter has remote service disconnect/reconnect capability. True enables remote service control for collections, move-in/move-out, and emergency response. False requires manual field operations."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "remote_disconnect_capable" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Disconnect Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:Meter.removalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removal date"@en ;
    rdfs:comment "Date the meter was removed from service location. Nullable for currently installed meters. Used for lifecycle tracking, inventory management, and historical service point analysis."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "removal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Meter Removal Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:LifecycleDate.removalDate .
cmm:Meter.sealNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seal number"@en ;
    rdfs:comment "Unique identifier of the tamper-evident seal applied to the meter cover. Used to detect unauthorized meter access, tampering, and theft. Recorded during installation and verified during inspections."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "seal_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Seal Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Meter.sealStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seal status"@en ;
    rdfs:comment "Current condition of the meter seal. Intact indicates no tampering; Broken indicates potential unauthorized access requiring investigation; Missing indicates seal loss; Not Applicable for meters without seals."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "seal_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Seal Status" ;
    cmm:validValues "Intact|Broken|Missing|Not Applicable" ;
    cmm:cimDatatype "String" .
cmm:Meter.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Manufacturer-assigned unique serial number physically stamped on the meter device. Used for asset tracking, warranty claims, and field verification. SSOT for device identity."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Meter Serial Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:Asset.serialNumber .
cmm:Meter.servicePointId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service point id"@en ;
    rdfs:comment "Foreign key linking to metering.service_point. Business justification: A service point can host many meters; the many side (meter) gets a foreign key to the parent service_point. This eliminates the siloed service_point table and provides the needed inbound relationship."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:long ;
    cmm:physicalColumn "service_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Point Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" .
cmm:Meter.signalStrengthBaselineDbm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "signal strength baseline dbm"@en ;
    rdfs:comment "Baseline communication signal strength measurement in dBm at time of installation or last network optimization. Used to detect communication degradation and plan network improvements. Typical range: -110 to -40 dBm."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "signal_strength_baseline_dbm" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Signal Strength Baseline in Decibels-Milliwatts (dBm)" ;
    cmm:cimDatatype "Decimal" .
cmm:Meter.testDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test date"@en ;
    rdfs:comment "Date of the most recent accuracy test or calibration performed on the meter. Used to track compliance with regulatory testing intervals and identify meters due for testing."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Test Date" ;
    cmm:cimDatatype "Date" .
cmm:Meter.voltageClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage class"@en ;
    rdfs:comment "Nominal voltage rating for which the meter is designed and certified. Determines appropriate deployment location (residential 120/240V, commercial 277/480V, primary voltage for large industrial)."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Voltage Class Rating" ;
    cmm:validValues "120V|240V|277V|480V|Primary Voltage" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:BaseVoltage.nominalVoltage .
cmm:Meter.warrantyExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "warranty expiration date"@en ;
    rdfs:comment "Date when the manufacturer warranty coverage expires. Used for warranty claim eligibility, replacement planning, and total cost of ownership analysis. Nullable if warranty terms are not date-based."@en ;
    rdfs:domain cmm:Meter ; rdfs:range xsd:date ;
    cmm:physicalColumn "warranty_expiration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Warranty Expiration Date" ;
    cmm:cimDatatype "Date" .

cmm:MeterPoint a owl:Class ;
    rdfs:label "Meter Point"@en ;
    rdfs:comment "Represents the physical service delivery point (premise) at which a meter is installed — the logical location where energy consumption is measured. Captures service point identifier, premise address, GPS coordinates, service voltage level, load class (residential, commercial, industrial), distribution feeder and transformer association, network topology node, and AMI network segment. Distinct from the meter device itself: a meter point persists even when meters are swapped. SSOT for the measurement location concept in the metering domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:UsagePoint ;
    cmm:cimExactMatch cim:UsagePoint ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.meter_management ;
    cmm:physicalTable "utility_cmm_silver.metering.meter_point" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "UsagePoint.UsagePointLocation" ;
    cmm:standardReference "IEC 61968-9; SAP IS-U — Service Point / Installation" ;
    cmm:sourceObject "energy_utilities_ecm.metering.meter_point" ;
    owl:hasKey ( cmm:MeterPoint.meterPointId ) .

cmm:MeterPoint.meterPointId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter point id"@en ;
    rdfs:comment "Unique identifier for the meter point (service delivery point). This is the primary key representing the logical location where energy consumption is measured, persisting across meter device swaps."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:long ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Meter Point Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:MeterPoint.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Service points must be assigned to balancing authority control areas for load aggregation, interchange scheduling, ACE calculation, and NERC CPS1/CPS2 compliance reporting. Core operational requiremen"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_control_area_id" ;
    cmm:cimAssociation "UsagePoint.ControlArea" .
cmm:MeterPoint.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Service points are assigned to cost centers for operational expense tracking and budget allocation by service territory, voltage class, and operational area. Required for monthly O&M cost allocation a"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_cost_center_id" ;
    cmm:cimAssociation "UsagePoint.Organisation" .
cmm:MeterPoint.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Service points host DER installations. NEM billing reconciliation, export limit enforcement, and interconnection compliance require linking meter_point to der_registry. Essential for behind-the-meter"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_der_registry_id" ;
    cmm:cimAssociation "UsagePoint.PowerElectronicsConnection" .
cmm:MeterPoint.distributionFeeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution feeder"@en ;
    rdfs:comment "Identifier of the distribution feeder circuit serving this meter point. Critical for outage management, load balancing, and SAIDI/SAIFI reliability calculations."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "distribution_feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Feeder Identifier" ;
    cmm:sourceColumn "feeder_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_distribution_feeder_id" ;
    cmm:cimAssociation "UsagePoint.Feeder" .
cmm:MeterPoint.distributionTransformer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "distribution transformer"@en ;
    rdfs:comment "Identifier of the distribution transformer serving this meter point. Used for transformer loading analysis and secondary network modeling."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:DistributionTransformer ;
    cmm:physicalColumn "distribution_transformer_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Distribution Transformer Identifier" ;
    cmm:sourceColumn "transformer_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_distribution_transformer_id" ;
    cmm:cimAssociation "UsagePoint.PowerTransformer" .
cmm:MeterPoint.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Distribution planning and rate design require associating service points with their default pricing nodes to calculate location-based energy costs and design locational tariffs. Essential for cost-of-"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_lmp_price_id" ;
    cmm:cimAssociation "UsagePoint.PnodeResults" .
cmm:MeterPoint.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Service points subject to net metering obligations, interconnection standards, service quality requirements. Enables tariff compliance verification, regulatory reporting by service class, obligation t"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_obligation_id" ;
    cmm:cimAssociation "UsagePoint.Document" .
cmm:MeterPoint.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the physical premise where this meter point is located. Links to the customer domain premise entity."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_premise_id" ;
    cmm:cimAssociation "UsagePoint.ServiceLocation" .
cmm:MeterPoint.servicePointAssetRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "service point asset registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Service points reference physical infrastructure assets (poles, pad-mount equipment, service cabinets) where metering is installed. Field operations, outage restoration, and capital planning require l"@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "service_point_asset_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point Asset Registry Id (Foreign Key)" ;
    cmm:sourceColumn "registry_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_point_service_point_asset_registry_id" ;
    cmm:cimAssociation "UsagePoint.Asset" .
cmm:MeterPoint.amiCollectorCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami collector code"@en ;
    rdfs:comment "Identifier of the AMI data collector or concentrator device that aggregates meter data from this service point."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ami_collector_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "AMI (Advanced Metering Infrastructure) Collector Identifier" ;
    cmm:valuePattern "^[A-Z0-9]{6,20}$" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.amiNetworkSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami network segment"@en ;
    rdfs:comment "AMI communication network segment or cell serving this meter point. Determines data collection routing and network performance monitoring."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "ami_network_segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "AMI (Advanced Metering Infrastructure) Network Segment" ;
    cmm:valuePattern "^[A-Z0-9]{4,12}$" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.contractedCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contracted capacity kw"@en ;
    rdfs:comment "Contracted or subscribed service capacity in kilowatts for this meter point. Applicable to large commercial and industrial customers."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "contracted_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contracted Capacity (Kilowatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:MeterPoint.cppEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpp eligible flag"@en ;
    rdfs:comment "Indicates whether this meter point is eligible for critical peak pricing programs. Used for demand response event targeting."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cpp_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CPP (Critical Peak Pricing) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterPoint.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this meter point record was first created in the MDM system. Used for data lineage and audit trail."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:UsagePoint.createdDateTime .
cmm:MeterPoint.dataQualityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "Composite data quality score (0-100) reflecting completeness, accuracy, and consistency of meter point attributes. Used for data stewardship prioritization."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Score" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterPoint.derCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der capacity kw"@en ;
    rdfs:comment "Nameplate capacity in kilowatts of distributed generation or storage interconnected at this meter point. Used for hosting capacity analysis."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "der_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER (Distributed Energy Resource) Capacity (Kilowatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:MeterPoint.derInterconnectionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der interconnection flag"@en ;
    rdfs:comment "Indicates whether a distributed energy resource is interconnected at this meter point. Triggers special metering and grid integration requirements."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "der_interconnection_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "DER (Distributed Energy Resource) Interconnection Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterPoint.gpsLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gps latitude"@en ;
    rdfs:comment "Geographic latitude coordinate of the meter point in decimal degrees. Used for GIS mapping, outage analysis, and field crew navigation."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gps_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "GPS (Global Positioning System) Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:MeterPoint.gpsLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gps longitude"@en ;
    rdfs:comment "Geographic longitude coordinate of the meter point in decimal degrees. Used for GIS mapping, outage analysis, and field crew navigation."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gps_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "GPS (Global Positioning System) Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:MeterPoint.intervalDataCollectionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval data collection flag"@en ;
    rdfs:comment "Indicates whether this meter point supports interval data collection (15-minute, 30-minute, or hourly). Required for TOU billing and demand response."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "interval_data_collection_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Data Collection Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterPoint.intervalLengthMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval length minutes"@en ;
    rdfs:comment "Length of each measurement interval in minutes for interval data collection (typically 15, 30, or 60). Determines data granularity for analytics."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_length_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Length (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:MeterPoint.lastMeterReadingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last meter reading date"@en ;
    rdfs:comment "Date of the most recent successful meter reading for this service point. Used for billing cycle validation and data quality monitoring."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_meter_reading_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Meter Reading Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterPoint.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this meter point record was last updated. Used for change tracking and data synchronization."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:MeterPoint.loadProfileClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile class"@en ;
    rdfs:comment "Customer segment classification determining consumption patterns, rate structures, and demand response eligibility. Critical for load forecasting and grid planning."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Profile Class" ;
    cmm:validValues "residential|commercial|industrial|agricultural|street_lighting|municipal" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.meterReadingCycle a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter reading cycle"@en ;
    rdfs:comment "Two-digit billing cycle code determining the scheduled meter reading date. Used for billing run scheduling and route optimization."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_reading_cycle" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Reading Cycle" ;
    cmm:valuePattern "^[0-9]{2}$" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.meterReadingFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter reading frequency"@en ;
    rdfs:comment "Frequency at which meter readings are collected for billing purposes. AMI-enabled points support continuous interval data collection."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_reading_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Reading Frequency" ;
    cmm:validValues "monthly|bimonthly|quarterly|on_demand|continuous" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.netMeteringFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering flag"@en ;
    rdfs:comment "Indicates whether net energy metering is enabled for this service point due to behind-the-meter generation (solar, wind, CHP)."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "net_metering_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "NEM (Net Energy Metering) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterPoint.networkTopologyNode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network topology node"@en ;
    rdfs:comment "Logical node identifier in the electrical network topology model. Used by ADMS and DMS systems for network analysis and switching operations."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_topology_node" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Topology Node" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.peakDemandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak demand kw"@en ;
    rdfs:comment "Maximum recorded demand in kilowatts at this meter point. Used for capacity planning, rate design, and demand charge billing."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_demand_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand (Kilowatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:MeterPoint.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration of the service connection. Determines metering channel requirements and load balancing considerations."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase_wye|three_phase_delta|split_phase" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Tariff rate schedule code applicable to this meter point. Determines pricing structure, TOU periods, and billing determinants."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:valuePattern "^[A-Z0-9]{2,10}$" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.serviceActivationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service activation date"@en ;
    rdfs:comment "Date when service was first activated at this meter point. Marks the beginning of the service point lifecycle."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_activation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Activation Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterPoint.serviceAddressLine1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service address line1"@en ;
    rdfs:comment "Primary street address line for the meter point location. Used for field crew dispatch and outage management."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_address_line1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Address Line 1" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:MeterPoint.serviceAddressLine2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service address line2"@en ;
    rdfs:comment "Secondary address line for apartment, suite, or unit number at the meter point location."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_address_line2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Address Line 2" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:MeterPoint.serviceCity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service city"@en ;
    rdfs:comment "City or municipality where the meter point is located. Used for jurisdictional rate determination and regulatory reporting."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service City" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.name .
cmm:MeterPoint.serviceCountryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service country code"@en ;
    rdfs:comment "Three-letter ISO country code for the meter point location. Determines applicable national regulatory frameworks."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_country_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service Country Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.country .
cmm:MeterPoint.serviceDeactivationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service deactivation date"@en ;
    rdfs:comment "Date when service was permanently deactivated at this meter point. Null for active service points."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:date ;
    cmm:physicalColumn "service_deactivation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Deactivation Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterPoint.servicePointNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service point number"@en ;
    rdfs:comment "Externally-known business identifier for the service delivery point. Used in customer communications, billing, and field operations."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_point_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Service Point Number" ;
    cmm:valuePattern "^[A-Z0-9]{8,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MeterPoint.servicePointStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service point status"@en ;
    rdfs:comment "Current lifecycle status of the meter point. Active indicates the point is in service and generating consumption data."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_point_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Point Status" ;
    cmm:validValues "active|inactive|pending_activation|disconnected|abandoned" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.servicePointType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service point type"@en ;
    rdfs:comment "Classification of the commodity delivered at this meter point. Determines applicable rate schedules and measurement requirements."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_point_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Point Type" ;
    cmm:validValues "electric|gas|water|steam|dual_fuel|multi_commodity" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.servicePostalCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service postal code"@en ;
    rdfs:comment "Postal code for the meter point service address. Used for geographic analysis and service territory validation."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_postal_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service Postal Code" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:valuePattern "^[0-9]{5}(-[0-9]{4})?$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:StreetAddress.postalCode .
cmm:MeterPoint.serviceStateProvince a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service state province"@en ;
    rdfs:comment "Two-letter state or province code for the meter point location. Determines applicable PUC jurisdiction and regulatory requirements."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_state_province" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Service State or Province" ;
    cmm:valuePattern "^[A-Z]{2}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.stateOrProvince .
cmm:MeterPoint.serviceVoltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage level"@en ;
    rdfs:comment "Voltage classification at which energy is delivered to this meter point. Determines metering accuracy requirements and applicable tariffs."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Level" ;
    cmm:validValues "low_voltage|medium_voltage|high_voltage|extra_high_voltage" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.serviceVoltageValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage value"@en ;
    rdfs:comment "Nominal voltage in volts at which service is delivered (e.g., 120V, 240V, 480V, 13.8kV). Used for power quality monitoring and equipment compatibility verification."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "service_voltage_value" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage Value (Volts)" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterPoint.sourceSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system code"@en ;
    rdfs:comment "Code identifying the authoritative source system for this meter point record. Supports multi-system data integration and master data governance."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System Code" ;
    cmm:validValues "MDM|CIS|GIS|ADMS|SCADA" ;
    cmm:cimDatatype "String" .
cmm:MeterPoint.touEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou enabled flag"@en ;
    rdfs:comment "Indicates whether time-of-use rate pricing is active for this meter point. Requires interval data collection and TOU-capable metering."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "tou_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "TOU (Time of Use) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterPoint.veeProcessingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee processing flag"@en ;
    rdfs:comment "Indicates whether meter data from this point undergoes VEE processing for data quality assurance before billing and analytics."@en ;
    rdfs:domain cmm:MeterPoint ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "vee_processing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE (Validation Estimation and Editing) Processing Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:MeterInstallation a owl:Class ;
    rdfs:label "Meter Installation"@en ;
    rdfs:comment "Tracks the active and historical association between a meter device and a meter point — the physical installation record. Captures installation date, removal date, meter reading at installation (start index), meter reading at removal (end index), installation technician, seal numbers applied, multiplier/CT ratio in effect, and installation status. Enables meter-to-premise traceability for billing, VEE, and regulatory audit. Supports meter swap history and back-billing calculations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:MeterServiceWork ;
    cmm:cimCloseMatch cim:MeterServiceWork ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.meter_management ;
    cmm:physicalTable "utility_cmm_silver.metering.meter_installation" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; SAP IS-U — Device Installation / Oracle Utilities MDM — Installation" ;
    cmm:sourceObject "energy_utilities_ecm.metering.meter_installation" ;
    owl:hasKey ( cmm:MeterInstallation.meterInstallationId ) .

cmm:MeterInstallation.meterInstallationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter installation id"@en ;
    rdfs:comment "Unique identifier for the meter installation record. Primary key for the meter installation entity."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:long ;
    cmm:physicalColumn "meter_installation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Meter Installation ID" ;
    cmm:cimDatatype "Integer" .
cmm:MeterInstallation.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Installation work audited for safety compliance, metering accuracy, proper sealing per regulatory standards. Supports audit trail for regulatory inspections, SOX controls over revenue metering, eviden"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_audit_id" ;
    cmm:cimAssociation "MeterServiceWork.ActivityRecord" .
cmm:MeterInstallation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Installation labor and materials are charged to cost centers for field service cost tracking. Essential for FERC Form 1 regulatory reporting (Account 586 - Meter Expenses) and operational budget varia"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_cost_center_id" ;
    cmm:cimAssociation "MeterServiceWork.Organisation" .
cmm:MeterInstallation.customerServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer service agreement"@en ;
    rdfs:comment "Foreign key linking to customer.customer_service_agreement. Business justification: Meter installations are performed under specific service agreements that define rate schedules, metering requirements, and billing start dates. Supports billing determinism, regulatory compliance for"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:CustomerServiceAgreement ;
    cmm:physicalColumn "customer_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_customer_service_agreement_id" ;
    cmm:cimAssociation "MeterServiceWork.CustomerAgreement" .
cmm:MeterInstallation.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Physical meter installations at DER sites require bidirectional metering equipment. DER commissioning verification and permission-to-operate inspections link meter installation records to registered D"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_der_registry_id" ;
    cmm:cimAssociation "MeterServiceWork.PowerElectronicsConnection" .
cmm:MeterInstallation.installationCapexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "installation capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: New meter installations are often part of capital projects (AMI deployment, service territory expansion, voltage upgrades). Required for capital project cost accumulation, WBS tracking, and rate case"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "installation_capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installation Capex Project Id (Foreign Key)" ;
    cmm:sourceColumn "capex_project_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_installation_capex_project_id" ;
    cmm:cimAssociation "MeterServiceWork.Project" .
cmm:MeterInstallation.meterWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter work order"@en ;
    rdfs:comment "Reference to the work order that authorized and tracked the meter installation activity. Links to asset management and field service systems."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "meter_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installation Work Order ID" ;
    cmm:sourceColumn "work_order_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_meter_work_order_id" ;
    cmm:cimAssociation "MeterServiceWork.Work" .
cmm:MeterInstallation.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the premise where the meter is physically installed. Provides geographic and customer context."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_premise_id" ;
    cmm:cimAssociation "MeterServiceWork.ServiceLocation" .
cmm:MeterInstallation.primaryMeterEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter employee"@en ;
    rdfs:comment "Reference to the field technician or crew who performed the meter installation. Used for quality tracking and accountability."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_meter_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Installation Technician ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_primary_meter_employee_id" ;
    cmm:cimAssociation "MeterServiceWork.ErpPersonnel" .
cmm:MeterInstallation.primaryMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter"@en ;
    rdfs:comment "Reference to the physical meter device that was installed at the meter point. Links to the meter asset registry."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "primary_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:sourceColumn "meter_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_primary_meter_id" ;
    cmm:cimAssociation "MeterServiceWork.Meter" .
cmm:MeterInstallation.primaryMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter point"@en ;
    rdfs:comment "Reference to the meter point (service point) where the meter is installed. The logical location for energy measurement."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "primary_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Point ID" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_primary_meter_point_id" ;
    cmm:cimAssociation "MeterServiceWork.UsagePoint" .
cmm:MeterInstallation.primaryMeterRemovalWorkOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter removal work order"@en ;
    rdfs:comment "Reference to the work order that authorized and tracked the meter removal activity. Links to asset management and field service systems."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "primary_meter_removal_work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Removal Work Order ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_primary_meter_removal_work_order_id" ;
    cmm:cimAssociation "MeterServiceWork.Work" .
cmm:MeterInstallation.toMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to meter"@en ;
    rdfs:comment "FK to metering.meter.meter_id — Every installation record MUST reference the meter device being installed. This is the core association that enables meter-to-premise traceability. Without this FK, you cannot determine which meter is"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "to_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_to_meter_id" ;
    cmm:cimAssociation "MeterServiceWork.Meter" .
cmm:MeterInstallation.toMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to meter point"@en ;
    rdfs:comment "FK to metering.meter_point.meter_point_id — Every installation record MUST reference the meter point (location) where the meter is installed. This completes the meter-device-to-location association that is the foundation of the metering domain."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "to_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_to_meter_point_id" ;
    cmm:cimAssociation "MeterServiceWork.UsagePoint" .
cmm:MeterInstallation.trade a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "trade"@en ;
    rdfs:comment "Foreign key linking to trading.trade. Business justification: Behind-the-meter generation contracts and renewable PPAs require tracking which meter installation measures energy delivery for specific trade contracts. Critical for contract settlement, compliance v"@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range cmm:Trade ;
    cmm:physicalColumn "trade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trade Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_installation_trade_id" ;
    cmm:cimAssociation "MeterServiceWork.Trade" .
cmm:MeterInstallation.accuracyClass a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "accuracy class"@en ;
    rdfs:comment "Meter accuracy classification per ANSI C12.20 standard. Lower values indicate higher precision. Class 0.2 and 0.5 are used for revenue-grade metering."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "accuracy_class" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Accuracy Class" ;
    cmm:validValues "0.2|0.5|1.0|2.0" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.amiEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami enabled flag"@en ;
    rdfs:comment "Indicates whether the meter installation supports AMI (Advanced Metering Infrastructure) remote reading and two-way communication. True for smart meters with network connectivity."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ami_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterInstallation.bidirectionalMeteringFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bidirectional metering flag"@en ;
    rdfs:comment "Indicates whether the meter can measure energy flow in both directions (consumption and generation). Required for NEM (Net Energy Metering) and DER (Distributed Energy Resource) customers."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "bidirectional_metering_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bidirectional Metering Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterInstallation.billingEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing end date"@en ;
    rdfs:comment "Date when billing ends for this meter installation. Used for final bill calculation and account closure processing."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing End Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterInstallation.billingStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing start date"@en ;
    rdfs:comment "Date when billing begins for this meter installation. May differ from installation_date due to service agreement terms or proration rules."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:date ;
    cmm:physicalColumn "billing_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Start Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterInstallation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "System timestamp when the meter installation record was first created in the MDM (Meter Data Management) system. Used for audit trail and data lineage."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:MeterServiceWork.createdDateTime .
cmm:MeterInstallation.ctRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ct ratio"@en ;
    rdfs:comment "Current Transformer ratio in effect for this installation (e.g., 200:5, 400:5). Used for high-voltage metering where direct measurement is not feasible."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "ct_ratio" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Current Transformer (CT) Ratio" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeterMultiplier.value .
cmm:MeterInstallation.endReading a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end reading"@en ;
    rdfs:comment "Meter register reading captured at the time of removal. Used to calculate final consumption and validate billing for the installation period."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "end_reading" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "End Reading" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterInstallation.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date when the meter was physically installed at the meter point. Marks the start of the installation period."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:MeterInstallation.installationNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation notes"@en ;
    rdfs:comment "Free-text field for technician notes captured during installation. May include site conditions, access issues, or special configuration details."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:MeterInstallation.installationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation number"@en ;
    rdfs:comment "Business identifier for the meter installation record. Used for external reference and work order tracking."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MeterInstallation.installationReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation reason code"@en ;
    rdfs:comment "Business reason for the meter installation. Used for program tracking, cost allocation, and regulatory reporting."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Reason Code" ;
    cmm:validValues "new_service|meter_upgrade|meter_failure|ami_deployment|customer_request|regulatory_compliance" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.installationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation status"@en ;
    rdfs:comment "Current lifecycle status of the meter installation. Active indicates the meter is currently in service at the meter point."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Status" ;
    cmm:validValues "active|removed|pending|suspended|failed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeterServiceWork.status .
cmm:MeterInstallation.installationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation timestamp"@en ;
    rdfs:comment "Precise date and time when the meter installation was completed. Used for interval data alignment and VEE (Validation, Estimation, and Editing) processing."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "installation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Installation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MeterInstallation.installationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation type"@en ;
    rdfs:comment "Classification of the installation based on its intended duration and purpose. Permanent installations are standard service; temporary installations support construction or events."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "installation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Installation Type" ;
    cmm:validValues "permanent|temporary|test|emergency" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeterServiceWork.type .
cmm:MeterInstallation.meterLocationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter location code"@en ;
    rdfs:comment "Physical location classification of the meter at the premise. Used for field service routing, safety planning, and AMI (Advanced Metering Infrastructure) signal strength analysis."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_location_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Location Code" ;
    cmm:validValues "indoor|outdoor|basement|utility_room|pole_mount|pad_mount" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.multiplier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "multiplier"@en ;
    rdfs:comment "Multiplier factor applied to meter readings to calculate actual consumption. Used when Current Transformer (CT) or Potential Transformer (PT) ratios are in effect."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "multiplier" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Meter Multiplier" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:MeterMultiplier.value .
cmm:MeterInstallation.phaseConfiguration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase configuration"@en ;
    rdfs:comment "Electrical phase configuration of the service. Single-phase for residential; three-phase for commercial and industrial customers."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "phase_configuration" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Phase Configuration" ;
    cmm:validValues "single_phase|three_phase_wye|three_phase_delta" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.ptRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pt ratio"@en ;
    rdfs:comment "Potential Transformer ratio in effect for this installation (e.g., 7200:120). Used in conjunction with CT ratio for accurate high-voltage metering."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "pt_ratio" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Potential Transformer (PT) Ratio" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:MeterMultiplier.value .
cmm:MeterInstallation.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Rate schedule in effect for this meter installation. Determines pricing structure (flat, TOU, CPP) and billing determinants."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.readingUom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reading uom"@en ;
    rdfs:comment "Unit of measure for the meter readings. Typically kWh (Kilowatt-Hour) for electric meters, therms or ccf for gas meters. Reference-value candidates: kWh|MWh|kW|kVAh|kVArh|therms|ccf|mcf."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reading_uom" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reading Unit of Measure (UOM)" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:MeterInstallation.registerCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "register count"@en ;
    rdfs:comment "Number of registers (dials) on the meter. Multi-register meters support TOU (Time of Use) and demand metering programs."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:int ;
    cmm:physicalColumn "register_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Register Count" ;
    cmm:cimDatatype "Integer" .
cmm:MeterInstallation.remoteDisconnectCapableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "remote disconnect capable flag"@en ;
    rdfs:comment "Indicates whether the meter has remote service disconnect/reconnect capability. Used for credit management and demand response programs."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "remote_disconnect_capable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Remote Disconnect Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterInstallation.removalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removal date"@en ;
    rdfs:comment "Date when the meter was removed from the meter point. Marks the end of the installation period. Null for active installations."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:date ;
    cmm:physicalColumn "removal_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Removal Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:LifecycleDate.removalDate .
cmm:MeterInstallation.removalNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removal notes"@en ;
    rdfs:comment "Free-text field for technician notes captured during removal. May include meter condition, seal integrity, or reasons for discrepancies in final readings."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "removal_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Removal Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:MeterInstallation.removalReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removal reason code"@en ;
    rdfs:comment "Business reason for the meter removal. Used for asset lifecycle tracking, failure analysis, and warranty claims."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "removal_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Removal Reason Code" ;
    cmm:validValues "meter_failure|service_disconnect|meter_upgrade|customer_move|testing|end_of_life" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.removalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "removal timestamp"@en ;
    rdfs:comment "Precise date and time when the meter was removed. Used for final interval data cutoff and back-billing calculations."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "removal_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Removal Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MeterInstallation.sealNumber1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seal number 1"@en ;
    rdfs:comment "Primary tamper-evident seal number applied to the meter at installation. Used for security and regulatory audit purposes."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "seal_number_1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Seal Number 1" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.sealNumber2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "seal number 2"@en ;
    rdfs:comment "Secondary tamper-evident seal number applied to the meter at installation. Provides additional security for high-value or critical installations."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "seal_number_2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Seal Number 2" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.serviceAmperage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service amperage"@en ;
    rdfs:comment "Maximum service amperage rating at the meter point in amps. Determines meter sizing and load capacity."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "service_amperage" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Amperage" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterInstallation.serviceVoltage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service voltage"@en ;
    rdfs:comment "Nominal service voltage at the meter point in volts. Used for meter configuration, safety planning, and load analysis."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "service_voltage" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Voltage" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterInstallation.startReading a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start reading"@en ;
    rdfs:comment "Meter register reading captured at the time of installation. Used as the baseline for consumption calculations during this installation period."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "start_reading" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Start Reading" ;
    cmm:cimDatatype "Decimal" .
cmm:MeterInstallation.testDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test date"@en ;
    rdfs:comment "Date when the meter was last tested for accuracy before or after installation. Used for regulatory compliance and quality assurance."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:date ;
    cmm:physicalColumn "test_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Date" ;
    cmm:cimDatatype "Date" .
cmm:MeterInstallation.testResult a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "test result"@en ;
    rdfs:comment "Result of the most recent meter accuracy test. Passed indicates the meter meets accuracy standards; failed triggers meter replacement."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "test_result" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Test Result" ;
    cmm:validValues "passed|failed|not_tested" ;
    cmm:cimDatatype "String" .
cmm:MeterInstallation.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "System timestamp when the meter installation record was last modified. Used for change tracking and data quality monitoring."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:MeterInstallation.veeProfileCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee profile code"@en ;
    rdfs:comment "Reference to the VEE (Validation, Estimation, and Editing) rule set applied to interval data from this installation. Determines data quality thresholds and estimation algorithms."@en ;
    rdfs:domain cmm:MeterInstallation ; rdfs:range xsd:string ;
    cmm:physicalColumn "vee_profile_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation, Estimation, and Editing (VEE) Profile Code" ;
    cmm:cimDatatype "String" .

cmm:IntervalReading a owl:Class ;
    rdfs:label "Interval Reading"@en ;
    rdfs:comment "Raw interval energy consumption and demand data collected from AMI smart meters at sub-hourly or hourly granularity (typically 15-min or 60-min intervals). Stores channel identifier, interval start timestamp, interval end timestamp, raw kWh or kW value, quality code (raw/estimated/substituted), data collection method (AMI push, manual, estimated), head-end system receipt timestamp, and collection run reference. This is the foundational time-series dataset feeding Oracle Utilities MDM VEE processing, billing, demand response, and grid operations. Immutable raw record — validated versions are stored in validated_interval_reading. High-volume transactional entity; typical utility processes millions of interval records daily."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:IntervalReading ;
    cmm:cimExactMatch cim:IntervalReading ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.interval_processing ;
    cmm:physicalTable "utility_cmm_silver.metering.interval_reading" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; NAESB ESPI; Oracle Utilities MDM — Interval Data / ANSI C12.19 Interval Data Table" ;
    cmm:sourceObject "energy_utilities_ecm.metering.interval_reading" ;
    owl:hasKey ( cmm:IntervalReading.intervalReadingId ) .

cmm:IntervalReading.intervalReadingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval reading id"@en ;
    rdfs:comment "Unique identifier for the interval reading record. Primary key for raw interval energy consumption and demand data collected from AMI smart meters."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Interval Reading ID" ;
    cmm:cimDatatype "Integer" .
cmm:IntervalReading.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Interval consumption data feeds real-time control area load calculations for AGC signals, state estimation, and balancing authority settlement. Required for NERC compliance and operational balancing."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_control_area_id" ;
    cmm:cimAssociation "IntervalReading.ControlArea" .
cmm:IntervalReading.cycle a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle"@en ;
    rdfs:comment "Identifier of the billing cycle to which this interval reading contributes. Links interval data to the billing period for invoice generation and revenue recognition."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:BillingCycle ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Cycle ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_cycle_id" ;
    cmm:cimAssociation "IntervalReading.TimeSchedule" .
cmm:IntervalReading.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Interval data from DER meters feeds REC issuance, curtailment verification, and generation forecasting. REC certificate generation process requires validated interval readings linked to specific DER f"@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_der_registry_id" ;
    cmm:cimAssociation "IntervalReading.PowerElectronicsConnection" .
cmm:IntervalReading.intervalMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interval meter"@en ;
    rdfs:comment "Identifier of the smart meter device that generated this interval reading. Links to the physical AMI meter asset."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "interval_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:sourceColumn "meter_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_interval_meter_id" ;
    cmm:cimAssociation "IntervalReading.Meter" .
cmm:IntervalReading.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Raw interval consumption data must be priced using LMP at the meter's pricing node for preliminary settlement calculations before VEE processing. Required for real-time cost allocation and interval bi"@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_lmp_price_id" ;
    cmm:cimAssociation "IntervalReading.PnodeResults" .
cmm:IntervalReading.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Identifier of the service point (delivery location) where energy consumption was measured. Represents the physical location of energy delivery."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_meter_point_id" ;
    cmm:cimAssociation "IntervalReading.UsagePoint" .
cmm:IntervalReading.toMeter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to meter"@en ;
    rdfs:comment "FK to metering.meter.meter_id — Raw interval readings must reference the meter device that produced them. This is the fundamental data provenance link for all consumption data."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "to_meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_interval_reading_to_meter_id" ;
    cmm:cimAssociation "IntervalReading.Meter" .
cmm:IntervalReading.channelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel number"@en ;
    rdfs:comment "Channel identifier on the meter device. Multi-channel meters track multiple measurement types (kWh delivered, kWh received, kW demand, voltage, power factor). Typically 1-99."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "channel_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Channel Number" ;
    cmm:valuePattern "^[0-9]{1,3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:IntervalReading.collectionMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection method"@en ;
    rdfs:comment "Method by which the interval data was collected. AMI_PUSH = meter initiated transmission, AMI_POLL = head-end system requested, MANUAL = field reading, ESTIMATED = system generated, SCADA = real-time system, IMPORT = bulk file load."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "collection_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Method" ;
    cmm:validValues "AMI_PUSH|AMI_POLL|MANUAL|ESTIMATED|SCADA|IMPORT" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.collectionRunCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collection run code"@en ;
    rdfs:comment "Identifier of the batch collection run or polling cycle that retrieved this reading. Groups readings collected in the same operational batch for traceability and reprocessing."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "collection_run_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Collection Run ID" ;
    cmm:cimDatatype "Integer" .
cmm:IntervalReading.correctionReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "correction reason code"@en ;
    rdfs:comment "Code identifying the reason for manual correction or substitution of the original reading value. Examples: METER_ERROR, COMM_FAILURE, CUSTOMER_DISPUTE, DATA_QUALITY. Empty if no correction."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "correction_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Correction Reason Code" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this interval reading record was first inserted into the MDM system. Audit field for data lineage and record creation tracking."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IntervalReading.createdDateTime .
cmm:IntervalReading.dataCompletenessPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data completeness percentage"@en ;
    rdfs:comment "Percentage of expected interval data received for the associated collection period. 100.00 = complete, <100.00 = partial data. Used for data quality monitoring and VEE prioritization."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_completeness_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Completeness Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:IntervalReading.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name or identifier of the source system that provided this interval reading. Examples: AMI_HEAD_END, SCADA_HISTORIAN, MANUAL_ENTRY, BILLING_SYSTEM. Supports multi-source MDM environments."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.daylightSavingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "daylight saving flag"@en ;
    rdfs:comment "Indicates whether daylight saving time was in effect during this interval. True = DST active, False = standard time. Critical for accurate time-of-use rate application and demand response event timing."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "daylight_saving_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Daylight Saving Time (DST) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.demandResponseEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand response event flag"@en ;
    rdfs:comment "Indicates whether a demand response event was active during this interval. True = DR event in progress, False = normal operation. Used for curtailment measurement and settlement."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "demand_response_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Response (DR) Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.estimationMethodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method code"@en ;
    rdfs:comment "Code identifying the estimation algorithm applied if the reading was estimated. Examples: LIKE_DAY, LINEAR_INTERPOLATION, AVERAGE_USAGE, ZERO_FILL. Empty for actual meter readings."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Method Code" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.intervalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval duration minutes"@en ;
    rdfs:comment "Duration of the measurement interval in minutes. Common values: 15 (quarter-hourly), 30 (half-hourly), 60 (hourly). Supports variable interval lengths for different meter configurations."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:IntervalReading.intervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval end timestamp"@en ;
    rdfs:comment "Timestamp marking the end of the measurement interval. Defines the close of the accumulation period for this reading."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:IntervalReading.intervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval start timestamp"@en ;
    rdfs:comment "Timestamp marking the beginning of the measurement interval. Represents the real-world event time when the meter began accumulating energy for this interval. Typically aligned to 15-minute or 60-minute boundaries."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:IntervalReading.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this interval reading record. Tracks modifications during VEE processing, manual corrections, or reprocessing events."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:IntervalReading.loadProfileSegment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load profile segment"@en ;
    rdfs:comment "Customer load profile classification segment for this service point. Used for load forecasting, rate design, and demand response targeting. Examples: RESIDENTIAL_STANDARD, COMMERCIAL_SMALL, INDUSTRIAL_LARGE."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "load_profile_segment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Profile Segment" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.meterReadStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read status"@en ;
    rdfs:comment "Status of the meter read operation that produced this interval. SUCCESS = complete read, PARTIAL = incomplete data, FAILED = read failure, TIMEOUT = communication timeout, COMM_ERROR = network error."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_read_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Status" ;
    cmm:validValues "SUCCESS|PARTIAL|FAILED|TIMEOUT|COMM_ERROR" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.netMeteringFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net metering flag"@en ;
    rdfs:comment "Indicates whether this service point is enrolled in net energy metering (solar or DER generation). True = NEM active, False = standard consumption-only metering. Affects billing credit calculations."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "net_metering_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.originalReadingValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original reading value"@en ;
    rdfs:comment "Original raw reading value before any estimation, substitution, or manual correction. Preserved for audit trail and comparison with corrected values. Null if no correction occurred."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_reading_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Original Reading Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:IntervalReading.powerOutageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power outage flag"@en ;
    rdfs:comment "Indicates whether a power outage was detected during this interval based on meter status flags or zero-consumption patterns. True = outage detected, False = normal operation."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "power_outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.qualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "quality code"@en ;
    rdfs:comment "Data quality indicator for the raw interval reading. RAW = actual meter reading, ESTIMATED = calculated by estimation algorithm, SUBSTITUTED = replaced due to validation failure, EDITED = manually corrected, REJECTED = failed validation, MISSING = no data received."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Quality Code" ;
    cmm:validValues "RAW|ESTIMATED|SUBSTITUTED|EDITED|REJECTED|MISSING" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:IntervalReading.rateScheduleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule code"@en ;
    rdfs:comment "Rate schedule or tariff code in effect for this service point at the time of the interval. Used to determine applicable TOU (Time of Use) or CPP (Critical Peak Pricing) rates for billing."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "rate_schedule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rate Schedule Code" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.readingValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reading value"@en ;
    rdfs:comment "Raw numeric value of the interval measurement as collected from the meter. Represents energy consumption (kWh) or demand (kW) depending on channel configuration. Immutable raw value before VEE processing."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reading_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reading Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:IntervalReading.receivedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "received timestamp"@en ;
    rdfs:comment "Timestamp when the interval reading was received by the head-end system or MDM platform. Used for latency analysis and data freshness monitoring. Distinct from the interval measurement time."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "received_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Received Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:IntervalReading.reprocessingFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reprocessing flag"@en ;
    rdfs:comment "Indicates whether this interval reading has been reprocessed after initial load. True = reprocessed due to correction or VEE re-run, False = original processing. Supports data lineage tracking."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reprocessing_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reprocessing Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.reverseFlowFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reverse flow flag"@en ;
    rdfs:comment "Indicates whether energy flowed in reverse direction (customer generation exported to grid) during this interval. True = export/generation, False = import/consumption. Critical for NEM and DER settlement."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "reverse_flow_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reverse Flow Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:IntervalReading.temperatureCelsius a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature celsius"@en ;
    rdfs:comment "Ambient temperature at the service point location during the interval, if available from weather data integration. Used for weather normalization and load forecasting. Null if not available."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_celsius" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature (Celsius)" ;
    cmm:unitSymbol "degC" ;
    cmm:cimDatatype "Temperature" .
cmm:IntervalReading.timeZoneOffset a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "time zone offset"@en ;
    rdfs:comment "UTC offset for the interval timestamps in ISO 8601 format (e.g., -05:00, +00:00). Ensures correct temporal alignment across service territories and daylight saving transitions."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "time_zone_offset" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time Zone Offset" ;
    cmm:valuePattern "^[+-]\\d{2}:\\d{2}$" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.touBucket a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou bucket"@en ;
    rdfs:comment "Time-of-use pricing period classification for this interval based on rate schedule and timestamp. Determines the applicable energy rate tier for billing calculations."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_bucket" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time of Use (TOU) Bucket" ;
    cmm:validValues "ON_PEAK|OFF_PEAK|SHOULDER|SUPER_OFF_PEAK|CRITICAL_PEAK" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Unit of measurement for the reading value. kWh (kilowatt-hour) for energy consumption, kW (kilowatt) for demand, kVArh for reactive energy, kVAr for reactive demand, kVAh for apparent energy, kVA for apparent demand."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:validValues "kWh|kW|kVArh|kVAr|kVAh|kVA" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingType.unit .
cmm:IntervalReading.updatedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated by user"@en ;
    rdfs:comment "User ID or system account that last modified this interval reading record. Supports audit trail and accountability for manual edits or system corrections."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "updated_by_user" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Updated By User" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.validationExceptionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation exception code"@en ;
    rdfs:comment "Code identifying the specific validation rule or exception that flagged this reading during VEE processing. Examples: HIGH_USAGE, NEGATIVE_VALUE, MISSING_INTERVAL, SPIKE_DETECTED. Empty if no exceptions."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_exception_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Exception Code" ;
    cmm:cimDatatype "String" .
cmm:IntervalReading.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "Status of VEE (Validation, Estimation, and Editing) processing for this raw reading. PENDING = awaiting validation, VALIDATED = passed validation rules, FAILED = validation exceptions detected, BYPASSED = validation skipped."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Status" ;
    cmm:validValues "PENDING|VALIDATED|FAILED|BYPASSED" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:IntervalReading.voltageLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level"@en ;
    rdfs:comment "Voltage classification of the service point where this interval was measured. LOW = residential/small commercial (<1kV), MEDIUM = commercial/industrial (1-35kV), HIGH = large industrial (35-230kV), TRANSMISSION = bulk power (>230kV)."@en ;
    rdfs:domain cmm:IntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "voltage_level" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level" ;
    cmm:validValues "LOW|MEDIUM|HIGH|TRANSMISSION" ;
    cmm:cimDatatype "String" .

cmm:ValidatedIntervalReading a owl:Class ;
    rdfs:label "Validated Interval Reading"@en ;
    rdfs:comment "VEE-processed (Validation, Estimation, and Editing) interval data representing the authoritative, billing-quality energy consumption record for each meter point and interval. Stores validated kWh, kW demand, reactive power (kVAR), power factor, VEE rule applied, estimation method (if estimated), editor identifier, validation status (valid/estimated/edited/substituted), and VEE processing run reference. This is the SSOT for consumption data consumed by billing, demand response, and grid operations domains. Distinct from raw interval_reading by lifecycle stage and quality assurance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:IntervalReading ;
    cmm:cimCloseMatch cim:IntervalReading ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.interval_processing ;
    cmm:physicalTable "utility_cmm_silver.metering.validated_interval_reading" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9 (ReadingQuality); Oracle Utilities MDM — VEE Output / ANSI C12.19" ;
    cmm:sourceObject "energy_utilities_ecm.metering.validated_interval_reading" ;
    owl:hasKey ( cmm:ValidatedIntervalReading.validatedIntervalReadingId ) .

cmm:ValidatedIntervalReading.validatedIntervalReadingId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validated interval reading id"@en ;
    rdfs:comment "Unique identifier for the validated interval reading record. Primary key for this entity representing a single VEE-processed meter reading interval."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "validated_interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Validated Interval Reading ID" ;
    cmm:cimDatatype "Integer" .
cmm:ValidatedIntervalReading.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key linking to compliance.audit. Business justification: Interval data validation processes audited for VEE rule compliance, estimation methodology, data quality standards. Provides audit evidence for billing accuracy, regulatory data quality reviews, SOX t"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_audit_id" ;
    cmm:cimAssociation "IntervalReading.ActivityRecord" .
cmm:ValidatedIntervalReading.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: VEE-validated readings are the authoritative source for control area load profiles used in state estimation, load forecasting, and balancing authority financial settlement. Regulatory and operational"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_control_area_id" ;
    cmm:cimAssociation "IntervalReading.ControlArea" .
cmm:ValidatedIntervalReading.cycle a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle"@en ;
    rdfs:comment "Reference to the billing cycle that this interval reading contributes to. Links interval data to the billing period for invoice generation."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:BillingCycle ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Cycle ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_cycle_id" ;
    cmm:cimAssociation "IntervalReading.TimeSchedule" .
cmm:ValidatedIntervalReading.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: VEE-processed interval data from DER meters supports PPA settlement calculations, RPS compliance reporting, and curtailment event compensation. Monthly PPA settlements require validated generation dat"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_der_registry_id" ;
    cmm:cimAssociation "IntervalReading.PowerElectronicsConnection" .
cmm:ValidatedIntervalReading.drEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr event"@en ;
    rdfs:comment "Reference to the demand response event that was active during this interval, if applicable. Null if no DR event was in effect."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:DrEvent ;
    cmm:physicalColumn "dr_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "DR (Demand Response) Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_dr_event_id" ;
    cmm:cimAssociation "IntervalReading.EndDeviceControl" .
cmm:ValidatedIntervalReading.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Reference to the specific outage event record if this interval was affected by a service interruption. Null if no outage occurred."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_event_id" ;
    cmm:cimAssociation "IntervalReading.Outage" .
cmm:ValidatedIntervalReading.intervalReading a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interval reading"@en ;
    rdfs:comment "Reference to the source raw interval reading record from which this validated reading was derived. Establishes lineage from raw to validated data."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:IntervalReading ;
    cmm:physicalColumn "interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Raw Interval Reading ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_interval_reading_id" ;
    cmm:cimAssociation "IntervalReading.IntervalReading" .
cmm:ValidatedIntervalReading.lmpPrice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "lmp price"@en ;
    rdfs:comment "Foreign key linking to trading.lmp_price. Business justification: Settlement systems match validated interval consumption with LMP at the same timestamp and pricing node to calculate accurate energy costs for billing and cost allocation. This join happens in every w"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:LmpPrice ;
    cmm:physicalColumn "lmp_price_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Lmp Price Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_lmp_price_id" ;
    cmm:cimAssociation "IntervalReading.PnodeResults" .
cmm:ValidatedIntervalReading.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the physical meter device that captured this interval reading. Links to the meter asset registry."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_meter_id" ;
    cmm:cimAssociation "IntervalReading.Meter" .
cmm:ValidatedIntervalReading.primaryIntervalReading a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary interval reading"@en ;
    rdfs:comment "FK to metering.interval_reading.interval_reading_id — Each validated interval reading must trace back to its source raw interval reading for audit trail and VEE processing lineage. Regulatory requirement for billing data integrity."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:IntervalReading ;
    cmm:physicalColumn "primary_interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_primary_interval_reading_id" ;
    cmm:cimAssociation "IntervalReading.IntervalReading" .
cmm:ValidatedIntervalReading.primaryMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter point"@en ;
    rdfs:comment "FK to metering.meter_point.meter_point_id — Validated interval data is associated with the meter point (not just the meter device) because billing and downstream consumers need location-based consumption. This is the SSOT consumption record key"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "primary_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_primary_meter_point_id" ;
    cmm:cimAssociation "IntervalReading.UsagePoint" .
cmm:ValidatedIntervalReading.primaryValidatedEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary validated employee"@en ;
    rdfs:comment "The identifier of the user or system process that performed manual editing on this reading. Null for automated VEE processing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_validated_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Editor User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_primary_validated_employee_id" ;
    cmm:cimAssociation "IntervalReading.ErpPersonnel" .
cmm:ValidatedIntervalReading.primaryVeeRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary vee rule"@en ;
    rdfs:comment "FK to metering.vee_rule.vee_rule_id — Each validated reading should reference the VEE rule that was applied during validation/estimation. Required for regulatory audit of data quality processing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:VeeRule ;
    cmm:physicalColumn "primary_vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "vee_rule_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_primary_vee_rule_id" ;
    cmm:cimAssociation "IntervalReading.Document" .
cmm:ValidatedIntervalReading.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Reference to the rate schedule (tariff) that was active for this service point during this interval. Used to determine applicable TOU or CPP pricing periods."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_rate_schedule_id" ;
    cmm:cimAssociation "IntervalReading.Tariff" .
cmm:ValidatedIntervalReading.validatedMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "validated meter point"@en ;
    rdfs:comment "Reference to the service delivery point (premise connection) where energy consumption was measured. The logical metering location."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "validated_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_validated_meter_point_id" ;
    cmm:cimAssociation "IntervalReading.UsagePoint" .
cmm:ValidatedIntervalReading.validatedVeeRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "validated vee rule"@en ;
    rdfs:comment "FK to metering.vee_rule.vee_rule_id — Each validated interval reading references the VEE rule that was applied during validation/estimation. Critical for audit trail and understanding how data quality was assured."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:VeeRule ;
    cmm:physicalColumn "validated_vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_validated_vee_rule_id" ;
    cmm:cimAssociation "IntervalReading.Document" .
cmm:ValidatedIntervalReading.veeCostCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vee cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: VEE processing operations (meter data management, validation software, analyst labor) have associated costs allocated to cost centers. Required for MDM operational cost tracking, billing quality assur"@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "vee_cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Vee Cost Center Id (Foreign Key)" ;
    cmm:sourceColumn "cost_center_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_validated_interval_reading_vee_cost_center_id" ;
    cmm:cimAssociation "IntervalReading.Organisation" .
cmm:ValidatedIntervalReading.approvalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval status"@en ;
    rdfs:comment "The workflow approval state for this validated reading. Indicates whether the reading has been reviewed and approved for downstream consumption by billing and analytics systems."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "approval_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Status" ;
    cmm:validValues "pending|approved|rejected|under_review" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "The date and time when this validated reading was approved for billing and operational use. Null if not yet approved."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ValidatedIntervalReading.billingQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing quality flag"@en ;
    rdfs:comment "Boolean indicator of whether this reading meets the quality standards required for billing purposes. True indicates the reading is approved for billing calculations."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billing_quality_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Billing Quality Flag" ;
    cmm:cimDatatype "Boolean" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:ValidatedIntervalReading.channelNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "channel number"@en ;
    rdfs:comment "The specific meter channel or register from which this reading was captured. Multi-channel meters track different measurement types on separate channels."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "channel_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Channel Number" ;
    cmm:cimDatatype "Integer" .
cmm:ValidatedIntervalReading.consumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consumption kwh"@en ;
    rdfs:comment "The validated energy consumption for this interval measured in kilowatt-hours. This is the authoritative billing-quality consumption value after VEE processing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Energy Consumption (kWh - Kilowatt-Hour)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:ValidatedIntervalReading.cppEventFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpp event flag"@en ;
    rdfs:comment "Boolean indicator of whether this interval occurred during a declared Critical Peak Pricing event. True indicates CPP premium rates apply."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "cpp_event_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "CPP (Critical Peak Pricing) Event Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ValidatedIntervalReading.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this validated interval reading record was first created in the MDM system."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:IntervalReading.createdDateTime .
cmm:ValidatedIntervalReading.dataQualityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "A composite quality score (0-100) calculated by the VEE engine based on validation rules, estimation confidence, and data completeness. Higher scores indicate higher quality."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Data Quality Score" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:ValidatedIntervalReading.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "The originating system or channel from which the raw interval data was collected before VEE processing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Source System" ;
    cmm:validValues "ami_headend|manual_read|scada|estimated|customer_portal" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.demandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand kw"@en ;
    rdfs:comment "The maximum instantaneous power demand recorded during this interval, measured in kilowatts. Used for demand-based billing and capacity planning."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Demand (kW - Kilowatt)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:ValidatedIntervalReading.editComment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "edit comment"@en ;
    rdfs:comment "Free-text notes provided by the editor explaining the context or justification for manual edits to this reading."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "edit_comment" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Edit Comment" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.editReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "edit reason code"@en ;
    rdfs:comment "The business reason code explaining why this reading was manually edited. Examples include meter malfunction, data transmission error, or customer dispute resolution."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "edit_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Edit Reason Code" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.estimationConfidenceScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation confidence score"@en ;
    rdfs:comment "A numerical score (0-100) indicating the confidence level in the estimated value. Higher scores indicate greater confidence in the estimation accuracy."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimation_confidence_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Confidence Score" ;
    cmm:cimDatatype "Decimal" .
cmm:ValidatedIntervalReading.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "The algorithm or technique used to estimate this reading if the original data was missing or invalid. Set to 'none' for non-estimated readings."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Method" ;
    cmm:validValues "none|linear_interpolation|historical_average|similar_day|regression|manual" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.exceptionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception code"@en ;
    rdfs:comment "The specific exception rule code that was triggered during VEE processing. Examples include high-usage threshold breach, negative consumption, or data gap detection."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Code" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.exceptionFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception flag"@en ;
    rdfs:comment "Boolean indicator of whether this reading triggered any VEE exception rules requiring manual review. True indicates the reading requires analyst attention."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "exception_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ValidatedIntervalReading.intervalDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval duration minutes"@en ;
    rdfs:comment "The length of the measurement interval in minutes. Common values include 15, 30, or 60 minutes depending on meter configuration and rate program requirements."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_duration_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Duration (Minutes)" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:ValidatedIntervalReading.intervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval end timestamp"@en ;
    rdfs:comment "The precise date and time when this measurement interval ended. Defines the end boundary of the consumption period."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:ValidatedIntervalReading.intervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval start timestamp"@en ;
    rdfs:comment "The precise date and time when this measurement interval began. Defines the start boundary of the consumption period."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ValidatedIntervalReading.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this validated interval reading record was most recently updated or edited."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ValidatedIntervalReading.meterReadType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read type"@en ;
    rdfs:comment "Classification of how the meter reading was obtained: automatically via AMI, manually by field personnel, estimated by system, or provided by customer."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "meter_read_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Meter Read Type" ;
    cmm:validValues "automatic|manual|estimated|customer_provided" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.originalConsumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original consumption kwh"@en ;
    rdfs:comment "The raw, unmodified consumption value before VEE processing. Preserved for audit trail and comparison purposes. Null if no original value existed."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Original Energy Consumption (kWh - Kilowatt-Hour)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:ValidatedIntervalReading.outageFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outage flag"@en ;
    rdfs:comment "Boolean indicator of whether a power outage was recorded at this service point during this interval. True indicates zero consumption due to service interruption."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "outage_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outage Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ValidatedIntervalReading.powerFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power factor"@en ;
    rdfs:comment "The ratio of real power to apparent power, ranging from 0 to 1. Indicates the efficiency of power usage and may trigger power factor penalties or credits."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "power_factor" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Power Factor" ;
    cmm:cimDatatype "Decimal" .
cmm:ValidatedIntervalReading.reactivePowerKvar a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reactive power kvar"@en ;
    rdfs:comment "The reactive power component measured in kilovolt-amperes reactive. Used for power factor calculations and grid stability analysis."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reactive_power_kvar" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reactive Power (kVAR - Kilovolt-Ampere Reactive)" ;
    cmm:unitSymbol "VAr" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ReactivePower" .
cmm:ValidatedIntervalReading.readingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reading timestamp"@en ;
    rdfs:comment "The timestamp when the meter physically recorded this interval data. May differ from interval_end_timestamp in cases of delayed meter reads or backfill scenarios."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "reading_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Reading Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:ValidatedIntervalReading.temperatureFahrenheit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "temperature fahrenheit"@en ;
    rdfs:comment "The ambient temperature in degrees Fahrenheit recorded at the associated weather station during this interval. Used for load forecasting and weather normalization."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "temperature_fahrenheit" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Temperature (Fahrenheit)" ;
    cmm:unitSymbol "degF" ;
    cmm:cimDatatype "Temperature" .
cmm:ValidatedIntervalReading.touPeriodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period code"@en ;
    rdfs:comment "The time-of-use pricing period classification for this interval (e.g., on-peak, off-peak, shoulder). Determines the rate tier applied for billing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_period_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "TOU (Time of Use) Period Code" ;
    cmm:cimDatatype "String" .
cmm:ValidatedIntervalReading.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "The measurement unit for the primary consumption value. Standardizes interpretation of numeric readings across different meter types and configurations."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure" ;
    cmm:validValues "kWh|kW|kVAR|kVA|MWh|MW" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingType.unit .
cmm:ValidatedIntervalReading.validationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "validation status"@en ;
    rdfs:comment "The quality status assigned by the VEE process indicating whether the reading is original valid data, was estimated, edited, substituted, flagged as suspect, or missing."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:string ;
    cmm:physicalColumn "validation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Status" ;
    cmm:validValues "valid|estimated|edited|substituted|suspect|missing" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:ValidatedIntervalReading.veeProcessingTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee processing timestamp"@en ;
    rdfs:comment "The date and time when the VEE process completed validation and transformation of this reading into its final billing-quality state."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "vee_processing_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE (Validation, Estimation, and Editing) Processing Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:ValidatedIntervalReading.veeRunCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee run code"@en ;
    rdfs:comment "Reference to the VEE processing batch run that produced this validated reading. Enables traceability of which VEE execution cycle processed this data."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "vee_run_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE (Validation, Estimation, and Editing) Run ID" ;
    cmm:cimDatatype "Integer" .
cmm:ValidatedIntervalReading.voltageVolts a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage volts"@en ;
    rdfs:comment "The average voltage level measured during this interval in volts. Used for power quality monitoring and voltage regulation analysis."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_volts" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage (Volts)" ;
    cmm:unitSymbol "V" ;
    cmm:cimDatatype "Voltage" .
cmm:ValidatedIntervalReading.weatherStationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "weather station code"@en ;
    rdfs:comment "Reference to the weather station used for temperature normalization and weather-adjusted load analysis for this service point location."@en ;
    rdfs:domain cmm:ValidatedIntervalReading ; rdfs:range xsd:long ;
    cmm:physicalColumn "weather_station_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Weather Station ID" ;
    cmm:cimDatatype "Integer" .

cmm:MeterRead a owl:Class ;
    rdfs:label "Meter Read"@en ;
    rdfs:comment "Scalar (register-level) meter reading record and associated read scheduling — capturing both the cumulative register value at a specific point in time and the recurring schedule governing when reads are collected. For readings: stores read date, read time, register identifier, read value, read type (scheduled/special/final/initial), read source (AMR/AMI/manual/estimated), reader employee reference, and read quality flag. For scheduling: defines read cycle (monthly/bi-monthly/daily), read method (AMI automated/manual route), scheduled read date, route assignment, billing cycle alignment, schedule code, and active status. Drives field crew routing for manual reads and AMI polling schedules for automated collection. Feeds billing domain consumption calculation. Distinct from interval_reading (which is time-series) — this is the periodic scalar snapshot and its collection governance."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Reading ;
    cmm:cimExactMatch cim:Reading ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.ami_operations ;
    cmm:physicalTable "utility_cmm_silver.metering.meter_read" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; SAP IS-U — Meter Reading / Oracle CC&B — Meter Read" ;
    cmm:sourceObject "energy_utilities_ecm.metering.meter_read" ;
    owl:hasKey ( cmm:MeterRead.meterReadId ) .

cmm:MeterRead.meterReadId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "meter read id"@en ;
    rdfs:comment "Unique identifier for the meter read record. Primary key. Role: TRANSACTION_HEADER (scalar meter reading event with lifecycle and scheduling governance)."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:long ;
    cmm:physicalColumn "meter_read_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Meter Read ID" ;
    cmm:cimDatatype "Integer" .
cmm:MeterRead.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account responsible for this service point. Enables customer-level consumption reporting."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_account_id" ;
    cmm:cimAssociation "Reading.CustomerAccount" .
cmm:MeterRead.amiEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ami event"@en ;
    rdfs:comment "Unique identifier from the AMI head-end system for this read event. Used to correlate the scalar read with interval data and AMI system logs. Null for non-AMI reads."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:AmiEvent ;
    cmm:physicalColumn "ami_event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Event ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_ami_event_id" ;
    cmm:cimAssociation "Reading.EndDeviceEvent" .
cmm:MeterRead.billingRun a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing run"@en ;
    rdfs:comment "Reference to the billing run that consumed this meter read for invoice calculation. Null if not yet billed. Used for billing audit and revenue assurance."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:BillingRun ;
    cmm:physicalColumn "billing_run_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Run ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_billing_run_id" ;
    cmm:cimAssociation "Reading.ActivityRecord" .
cmm:MeterRead.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Aggregated meter reads feed control area load profiles for interchange accounting and NERC reporting. Standard practice for balancing authority operations and compliance."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_control_area_id" ;
    cmm:cimAssociation "Reading.ControlArea" .
cmm:MeterRead.cycle a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cycle"@en ;
    rdfs:comment "Reference to the billing cycle for which this read was captured. Links the read to the billing run and invoice generation process."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:BillingCycle ;
    cmm:physicalColumn "cycle_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Cycle ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_cycle_id" ;
    cmm:cimAssociation "Reading.TimeSchedule" .
cmm:MeterRead.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to renewable.der_registry. Business justification: Register-based reads from DER meters support NEM annual true-up calculations, monthly generation reporting, and capacity factor verification. NEM true-up process requires cumulative meter reads linked"@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_der_registry_id" ;
    cmm:cimAssociation "Reading.PowerElectronicsConnection" .
cmm:MeterRead.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the physical meter device from which this reading was captured. Links to the meter asset registry."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_meter_id" ;
    cmm:cimAssociation "Reading.Meter" .
cmm:MeterRead.premise a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "premise"@en ;
    rdfs:comment "Reference to the service premise where the meter is installed. Enables geographic and customer aggregation of reads."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:Premise ;
    cmm:physicalColumn "premise_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Premise ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_premise_id" ;
    cmm:cimAssociation "Reading.ServiceLocation" .
cmm:MeterRead.primaryMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary meter point"@en ;
    rdfs:comment "Reference to the logical service point (delivery point) associated with this meter read. Used for billing and consumption analysis."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "primary_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point ID" ;
    cmm:sourceColumn "meter_point_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_primary_meter_point_id" ;
    cmm:cimAssociation "Reading.UsagePoint" .
cmm:MeterRead.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Reference to the rate schedule (tariff) in effect for this service point at the time of the read. Used to determine Time-of-Use (TOU) periods, Critical Peak Pricing (CPP) applicability, and billing determinants."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_rate_schedule_id" ;
    cmm:cimAssociation "Reading.Tariff" .
cmm:MeterRead.readerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reader employee"@en ;
    rdfs:comment "Reference to the employee (field technician or meter reader) who captured the reading. Null for automated AMI/AMR reads. Used for workforce productivity analysis and audit trails."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "reader_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reader Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_reader_employee_id" ;
    cmm:cimAssociation "Reading.ErpPersonnel" .
cmm:MeterRead.register a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "register"@en ;
    rdfs:comment "Reference to the specific register on the meter (e.g., kWh delivered, kWh received, kVArh). Multi-register meters have multiple read records per read event."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:MeterRegister ;
    cmm:physicalColumn "register_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Register ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_register_id" ;
    cmm:cimAssociation "Reading.Register" .
cmm:MeterRead.route a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "route"@en ;
    rdfs:comment "Reference to the meter reading route assignment for manual reads. Defines the geographic sequence and schedule for field crews. Null for automated reads."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:MeterRoute ;
    cmm:physicalColumn "route_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Route ID" ;
    cmm:sourceColumn "meter_route_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_route_id" ;
    cmm:cimAssociation "Reading.TimeSchedule" .
cmm:MeterRead.toMeterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to meter point"@en ;
    rdfs:comment "FK to metering.meter_point.meter_point_id — Scalar meter reads must reference the meter point where the read was taken. Essential for billing cycle consumption calculation."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "to_meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_to_meter_point_id" ;
    cmm:cimAssociation "Reading.UsagePoint" .
cmm:MeterRead.veeRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vee rule"@en ;
    rdfs:comment "Reference to the VEE (Validation, Estimation, and Editing) rule that processed this read. Links to the validation rule configuration for audit and troubleshooting."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range cmm:VeeRule ;
    cmm:physicalColumn "vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Validation Rule ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_meter_read_vee_rule_id" ;
    cmm:cimAssociation "Reading.Document" .
cmm:MeterRead.averageDailyUsage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "average daily usage"@en ;
    rdfs:comment "Consumption divided by consumption days. Expressed in kWh per day or MWh per day. Used for customer usage profiling, demand response eligibility, and anomaly detection."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "average_daily_usage" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Average Daily Usage" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MeterRead.billedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billed flag"@en ;
    rdfs:comment "Indicates whether this meter read has been used in a billing run and invoice generation. True if billed; False if pending or unbilled. Used to prevent duplicate billing and support billing cycle reconciliation."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterRead.consumptionDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consumption days"@en ;
    rdfs:comment "Number of days between the current read date and the previous read date. Used to normalize consumption for billing and to calculate average daily usage."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:int ;
    cmm:physicalColumn "consumption_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Consumption Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MeterRead.consumptionKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "consumption kwh"@en ;
    rdfs:comment "Calculated energy consumption for the period (current read value minus previous read value). Expressed in kilowatt-hours (kWh) or megawatt-hours (MWh). This is the billable quantity fed to the billing domain."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "consumption_kwh" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Consumption Kilowatt-Hours (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MeterRead.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Date and time when this meter read record was first created in the MDM (Meter Data Management) system. Used for data lineage and audit trails."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Reading.createdDateTime .
cmm:MeterRead.demandKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand kw"@en ;
    rdfs:comment "Peak demand recorded during the read period, expressed in kilowatts (kW) or megawatts (MW). Captured for commercial and industrial customers on demand-based rate schedules. Null for residential meters without demand registers."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "demand_kw" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Kilowatts (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:MeterRead.demandTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demand timestamp"@en ;
    rdfs:comment "Date and time when the peak demand occurred during the read period. Used for Time-of-Use (TOU) and Critical Peak Pricing (CPP) rate application."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "demand_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Demand Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:MeterRead.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "Algorithm or rule used to estimate the read value when actual read was unavailable. Examples: HIST_AVG (historical average), PREV_YEAR (same period prior year), PRO_RATA (prorated from partial period), ADL (average daily load). Null for actual reads."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Method" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.exceptionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception code"@en ;
    rdfs:comment "Code identifying any exception or anomaly detected during read capture or validation. Examples: HIGH_USAGE, LOW_USAGE, ZERO_CONSUMPTION, NEGATIVE_CONSUMPTION, TAMPER, COMM_FAILURE. Used to trigger investigation workflows."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Code" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.multiplier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "multiplier"@en ;
    rdfs:comment "Constant multiplier applied to the raw register reading to calculate actual consumption. Used for current transformer (CT) and potential transformer (PT) ratios on high-voltage meters. Default is 1.0 for direct-connected meters."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "multiplier" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Multiplier" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:MeterMultiplier.value .
cmm:MeterRead.previousReadDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "previous read date"@en ;
    rdfs:comment "Date of the prior valid read for this register. Used to calculate the consumption period length (days between reads) and validate read sequence."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:date ;
    cmm:physicalColumn "previous_read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Previous Read Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:MeterRead.previousReadValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "previous read value"@en ;
    rdfs:comment "The register value from the prior valid read. Used to calculate consumption (current read minus previous read) and detect anomalies such as reverse flow or register rollover."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "previous_read_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Previous Read Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MeterRead.readCycleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read cycle code"@en ;
    rdfs:comment "Code identifying the recurring read schedule pattern. Examples: M01 (monthly cycle 1), B15 (bi-monthly cycle 15), D (daily), W (weekly). Aligns with billing cycle and route planning."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_cycle_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Read Cycle Code" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.readDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read date"@en ;
    rdfs:comment "The calendar date on which the meter reading was captured. Principal business event timestamp for billing cycle alignment and consumption period determination."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:date ;
    cmm:physicalColumn "read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Read Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:MeterRead.readFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read frequency"@en ;
    rdfs:comment "The recurring interval at which reads are scheduled for this meter. Monthly: standard residential. Bi-monthly: some residential jurisdictions. Daily: large commercial/industrial or AMI. On-demand: special reads only."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Read Frequency" ;
    cmm:validValues "monthly|bi-monthly|quarterly|daily|on-demand" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.readMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read method"@en ;
    rdfs:comment "Technical method used to capture the reading. Optical: infrared port. RF: radio frequency. PLC: power line carrier. Cellular: mobile network. Visual: technician reads display. Handheld: portable reader device."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Read Method" ;
    cmm:validValues "optical|RF|PLC|cellular|visual|handheld" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.readQualityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read quality code"@en ;
    rdfs:comment "Standardized code indicating the quality or exception condition of the read. Examples: OK (normal), EST (estimated), REV (reverse flow), OVF (overflow), PWR (power outage), TMR (tamper detected). Aligns with ANSI C12.19 quality flags."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_quality_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Quality Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.typeRef .
cmm:MeterRead.readReasonCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read reason code"@en ;
    rdfs:comment "Business reason for the read event. Examples: BILL (billing cycle), MOVE (move-in/move-out), DISC (disconnect), RECON (reconnect), INSP (inspection), COMP (complaint investigation). Used for operational reporting and audit."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_reason_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Read Reason Code" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.readSequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read sequence number"@en ;
    rdfs:comment "Business identifier for the meter read, often formatted as meter number plus read date. Used for external reference and audit trails."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_sequence_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Sequence Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:MeterRead.readSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read source"@en ;
    rdfs:comment "Method by which the reading was obtained. AMI: Advanced Metering Infrastructure (two-way automated). AMR: Automated Meter Reading (one-way drive-by). Manual: field technician on-site. Estimated: calculated by VEE (Validation, Estimation, and Editing) process. Customer: self-reported. Remote: handheld or mobile device."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Read Source" ;
    cmm:validValues "AMI|AMR|manual|estimated|customer|remote" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.readStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read status"@en ;
    rdfs:comment "Current lifecycle status of the meter read. Valid: passed VEE (Validation, Estimation, and Editing) and accepted for billing. Estimated: calculated value pending actual read. Suspect: flagged for review. Failed: read attempt unsuccessful. Pending_validation: awaiting VEE processing. Corrected: replaced by subsequent correction read."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Status" ;
    cmm:validValues "valid|estimated|suspect|failed|pending_validation|corrected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Reading.status .
cmm:MeterRead.readTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read timestamp"@en ;
    rdfs:comment "Precise date and time when the meter reading was captured, including time zone. Used for interval boundary alignment and AMI (Advanced Metering Infrastructure) event correlation."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "read_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Read Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:MeterRead.readType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read type"@en ;
    rdfs:comment "Classification of the read event. Scheduled: routine billing cycle read. Special: off-cycle read for move-in/move-out or investigation. Final: account closure. Initial: new service activation. Test: commissioning or validation. Correction: replacement of erroneous prior read."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Type" ;
    cmm:validValues "scheduled|special|final|initial|test|correction" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Reading.kind .
cmm:MeterRead.readUom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read uom"@en ;
    rdfs:comment "Unit of measure for the read value. Common values: kWh (kilowatt-hour), MWh (megawatt-hour), kVArh (kilovolt-ampere reactive hour) for electric; CCF, MCF, Therms for gas; Gallons for water. Reference-value candidates: kWh|MWh|kVArh|MVArh|kW|MW|kVA|MVA|CCF|MCF|Therms|Gallons."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "read_uom" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Unit of Measure (UOM)" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingType.unit .
cmm:MeterRead.readValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "read value"@en ;
    rdfs:comment "The cumulative register value captured at the read timestamp. For energy meters, typically kilowatt-hours (kWh) or megawatt-hours (MWh). This is the raw scalar reading before consumption calculation."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "read_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Read Value" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimCloseMatch cim:BaseReading.value .
cmm:MeterRead.registerDigits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "register digits"@en ;
    rdfs:comment "Number of digits on the meter register display. Used to detect register rollover (e.g., a 5-digit register rolls from 99999 to 00000). Typical values: 5, 6, 7."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:int ;
    cmm:physicalColumn "register_digits" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Register Digits" ;
    cmm:cimDatatype "Integer" .
cmm:MeterRead.registerRolloverFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "register rollover flag"@en ;
    rdfs:comment "Indicates whether the register rolled over during this read period (current read value is less than previous read value due to register capacity limit). True if rollover detected; False otherwise."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "register_rollover_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Register Rollover Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterRead.scheduledReadDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scheduled read date"@en ;
    rdfs:comment "The planned date for this meter read as defined by the read schedule. Used to measure on-time read performance and identify late or early reads."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:date ;
    cmm:physicalColumn "scheduled_read_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Scheduled Read Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimExactMatch cim:BaseReading.timeStamp .
cmm:MeterRead.touPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period"@en ;
    rdfs:comment "The TOU rate period for this register reading. On-peak: highest rate hours. Off-peak: lowest rate hours. Shoulder: mid-tier hours. Super-off-peak: ultra-low rate hours (e.g., overnight EV charging). Null for non-TOU registers."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_period" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Period" ;
    cmm:validValues "on-peak|off-peak|shoulder|super-off-peak" ;
    cmm:cimDatatype "String" .
cmm:MeterRead.touRegisterFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou register flag"@en ;
    rdfs:comment "Indicates whether this register captures Time-of-Use (TOU) segmented consumption (e.g., on-peak, off-peak, shoulder). True for TOU registers; False for cumulative registers. TOU meters have multiple read records per read event."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "tou_register_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time-of-Use (TOU) Register Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:MeterRead.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Date and time when this meter read record was last modified. Tracks VEE corrections, status changes, and data quality improvements."@en ;
    rdfs:domain cmm:MeterRead ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:VeeRule a owl:Class ;
    rdfs:label "Vee Rule"@en ;
    rdfs:comment "Defines the business rules applied during the VEE (Validation, Estimation, and Editing) process in Oracle Utilities MDM. Each rule specifies the rule type (validation/estimation/editing), rule algorithm, threshold parameters (e.g., spike tolerance percentage, zero-consumption threshold), applicable meter types, priority order, effective date range, and regulatory basis. Governs data quality for billing-quality interval data. Reference entity managed by the metering operations team."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.interval_processing ;
    cmm:physicalTable "utility_cmm_silver.metering.vee_rule" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "Oracle Utilities MDM — VEE Rule Configuration" ;
    cmm:sourceObject "energy_utilities_ecm.metering.vee_rule" ;
    owl:hasKey ( cmm:VeeRule.veeRuleId ) .

cmm:VeeRule.veeRuleId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee rule id"@en ;
    rdfs:comment "Unique identifier for the VEE rule. Primary key for the VEE rule reference entity."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:long ;
    cmm:physicalColumn "vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Rule Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:VeeRule.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: VEE rules implement regulatory obligations for data quality, estimation limits, validation thresholds mandated by state PUC orders. Enables compliance mapping, regulatory justification for VEE algorit"@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_rule_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:VeeRule.algorithmType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "algorithm type"@en ;
    rdfs:comment "The computational algorithm or method used by the rule to validate, estimate, or edit meter data (e.g., threshold-based, statistical analysis, linear regression, interpolation). Reference-value candidates: threshold|statistical|regression|interpolation|substitution|comparison|pattern_matching."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "algorithm_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Algorithm Type" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.applicableMeterTypes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable meter types"@en ;
    rdfs:comment "Comma-separated list of meter types to which this VEE rule applies (e.g., AMI electric, AMI gas, interval demand, TOU residential). Defines the scope of rule application within the meter population."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_meter_types" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Meter Types" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.applicableRateSchedules a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable rate schedules"@en ;
    rdfs:comment "Comma-separated list of rate schedule codes to which this VEE rule applies. Enables rate-specific validation and estimation logic for TOU and CPP programs."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_rate_schedules" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Rate Schedules" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.applicableServiceTypes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable service types"@en ;
    rdfs:comment "Type of utility service to which this VEE rule applies (electric, gas, water, steam). Ensures rules are applied to appropriate commodity data streams."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_service_types" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Service Types" ;
    cmm:validValues "electric|gas|water|steam" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.approvalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval required flag"@en ;
    rdfs:comment "Indicates whether changes to this VEE rule require formal approval before activation. True for rules impacting billing or regulatory compliance."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "approval_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Approval Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeRule.approvedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved by"@en ;
    rdfs:comment "User identifier of the person who approved this VEE rule for production use. Applicable when approval_required_flag is true."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "approved_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Approved By User" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.approvedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved timestamp"@en ;
    rdfs:comment "Timestamp when this VEE rule was formally approved for production use. Supports governance and compliance documentation."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approved_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Approved Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VeeRule.auditTrailEnabledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit trail enabled flag"@en ;
    rdfs:comment "Indicates whether detailed audit logging is enabled for this rule, capturing every application of the rule and its outcomes for compliance and troubleshooting."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "audit_trail_enabled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Audit Trail Enabled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeRule.billingQualityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing quality flag"@en ;
    rdfs:comment "Indicates whether data passing this VEE rule is considered billing-quality and suitable for revenue calculation. True if the rule ensures billing-grade accuracy."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billing_quality_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Quality Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeRule.confidenceThresholdPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "confidence threshold percent"@en ;
    rdfs:comment "Minimum confidence level (as a percentage) required for estimated values to be accepted as billing-quality. Used in statistical estimation algorithms."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "confidence_threshold_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Confidence Threshold Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:VeeRule.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this VEE rule record was first created in the MDM system. Supports audit trail and data lineage."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:VeeRule.effectiveEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective end date"@en ;
    rdfs:comment "Date after which the VEE rule is no longer active. Nullable for open-ended rules. Supports rule lifecycle management and historical analysis."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Effective End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:VeeRule.effectiveStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "effective start date"@en ;
    rdfs:comment "Date from which the VEE rule becomes active and is applied to meter data. Supports temporal rule management and regulatory compliance."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:date ;
    cmm:physicalColumn "effective_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Effective Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .
cmm:VeeRule.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "Specific estimation technique used when the rule type is estimation. Defines how missing or invalid interval data is calculated (e.g., linear interpolation, historical average, same-day-last-week). Reference-value candidates: linear_interpolation|historical_average|same_day_last_week|same_day_last_year|regression|zero_fill|prior_value."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Estimation Method" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.exceptionHandlingAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception handling action"@en ;
    rdfs:comment "Action taken when the rule detects a data quality exception: flag for review, automatically estimate, reject the data, route to manual review, or substitute with a default value."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_handling_action" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Exception Handling Action" ;
    cmm:validValues "flag_only|estimate|reject|manual_review|substitute" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.executionFrequency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "execution frequency"@en ;
    rdfs:comment "Frequency at which the VEE rule is executed against incoming or historical meter data (real-time, hourly, daily, weekly, on-demand)."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "execution_frequency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Execution Frequency" ;
    cmm:validValues "real_time|hourly|daily|weekly|on_demand" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User identifier of the person who last modified this VEE rule record. Supports change tracking and accountability."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Last Modified By User" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this VEE rule record was last modified. Supports audit trail and change management."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:VeeRule.lookbackPeriodDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lookback period days"@en ;
    rdfs:comment "Number of days of historical data the rule examines for validation or estimation purposes. Used by statistical and pattern-matching algorithms."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:int ;
    cmm:physicalColumn "lookback_period_days" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Lookback Period in Days" ;
    cmm:unitSymbol "d" ;
    cmm:cimDatatype "Integer" .
cmm:VeeRule.lowerLimit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lower limit"@en ;
    rdfs:comment "Minimum acceptable value for validation rules. Interval data below this limit triggers a validation exception or editing action."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "lower_limit" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Lower Limit" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeRule.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional notes, implementation guidance, or special considerations related to this VEE rule. Supports knowledge transfer and operational documentation."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:VeeRule.ownerGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner group"@en ;
    rdfs:comment "Business unit or team responsible for maintaining and governing this VEE rule (e.g., Metering Operations, Revenue Assurance, Data Quality Team)."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_group" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Owner Group" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.priorityOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "priority order"@en ;
    rdfs:comment "Execution sequence priority for the rule within the VEE processing engine. Lower numbers execute first. Determines the order in which multiple rules are applied to the same interval data."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:int ;
    cmm:physicalColumn "priority_order" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Priority Order" ;
    cmm:cimDatatype "Integer" .
cmm:VeeRule.regulatoryBasis a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory basis"@en ;
    rdfs:comment "Citation of the regulatory requirement, tariff provision, or PUC order that mandates or justifies this VEE rule. Supports compliance documentation and audit trails."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_basis" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Basis for VEE Rule" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.ruleCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule category"@en ;
    rdfs:comment "Functional category of the rule indicating the specific data quality issue it addresses (e.g., spike detection, zero consumption validation, missing data estimation)."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Category" ;
    cmm:validValues "spike_detection|zero_consumption|negative_value|missing_data|high_low_limit|consistency_check" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.kind .
cmm:VeeRule.ruleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule code"@en ;
    rdfs:comment "Business identifier code for the VEE rule, used for external reference and system integration. Typically a short alphanumeric code following utility naming conventions."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Code" ;
    cmm:valuePattern "^[A-Z0-9_]{3,20}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:VeeRule.ruleDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule description"@en ;
    rdfs:comment "Detailed description of the VEE rule including its business logic, application context, and expected outcomes when applied to interval meter data."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "VEE Rule Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:VeeRule.ruleName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule name"@en ;
    rdfs:comment "Human-readable name of the VEE rule describing its purpose and function within the meter data management process."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "VEE Rule Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:VeeRule.ruleStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule status"@en ;
    rdfs:comment "Current lifecycle status of the VEE rule indicating whether it is actively applied to meter data processing or in a non-operational state."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Status" ;
    cmm:validValues "active|inactive|draft|testing|retired|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:VeeRule.ruleType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rule type"@en ;
    rdfs:comment "Classification of the rule within the VEE process: validation (checks data quality), estimation (fills missing data), or editing (corrects erroneous data)."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "rule_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Type" ;
    cmm:validValues "validation|estimation|editing" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:VeeRule.thresholdUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "threshold unit"@en ;
    rdfs:comment "Unit of measure for the threshold value (e.g., kWh, MWh, percentage, count, standard deviations) providing context for threshold interpretation."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "threshold_unit" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Threshold Unit of Measure" ;
    cmm:validValues "kWh|MWh|percentage|count|standard_deviation|ratio" ;
    cmm:cimDatatype "String" .
cmm:VeeRule.thresholdValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "threshold value"@en ;
    rdfs:comment "Numeric threshold parameter used by the rule algorithm to determine data quality exceptions. For example, spike tolerance percentage, maximum consumption limit, or minimum expected value."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "threshold_value" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Threshold Value" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeRule.upperLimit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upper limit"@en ;
    rdfs:comment "Maximum acceptable value for validation rules. Interval data above this limit triggers a validation exception or editing action."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "upper_limit" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "VEE Rule Upper Limit" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeRule.versionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "version number"@en ;
    rdfs:comment "Version number of the VEE rule configuration. Incremented with each modification to support change tracking and rollback capabilities."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:int ;
    cmm:physicalColumn "version_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Version Number" ;
    cmm:cimDatatype "Integer" ;
    cmm:cimCloseMatch cim:Document.revisionNumber .
cmm:VeeRule.createdBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created by"@en ;
    rdfs:comment "User identifier of the person who created this VEE rule record. Supports accountability and audit requirements."@en ;
    rdfs:domain cmm:VeeRule ; rdfs:range xsd:string ;
    cmm:physicalColumn "created_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "VEE Rule Created By User" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.authorName .

cmm:VeeException a owl:Class ;
    rdfs:label "Vee Exception"@en ;
    rdfs:comment "Operational record of a VEE processing exception raised during interval data validation or estimation — capturing intervals that failed validation rules and required manual review, automatic re-estimation, or override. Stores exception type, severity, affected interval range (start/end timestamps), VEE rule triggered, auto-resolution status, manual reviewer identifier, resolution action taken (re-estimate/edit/accept/override), resolution timestamp, and exception disposition (resolved/escalated/waived). Supports MDM data quality workflows, operational dashboards for VEE pass rates, and regulatory audit trails for billing data integrity. Key metric: exception rate by rule type drives VEE rule tuning."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ReadingQuality ;
    cmm:cimCloseMatch cim:ReadingQuality ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Metering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-9" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.interval_processing ;
    cmm:physicalTable "utility_cmm_silver.metering.vee_exception" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IEC 61968-9; Oracle Utilities MDM — VEE Exception Management" ;
    cmm:sourceObject "energy_utilities_ecm.metering.vee_exception" ;
    owl:hasKey ( cmm:VeeException.veeExceptionId ) .

cmm:VeeException.veeExceptionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee exception id"@en ;
    rdfs:comment "Unique identifier for the VEE exception record. Primary key for the VEE exception entity."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:long ;
    cmm:physicalColumn "vee_exception_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Exception Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:VeeException.account a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "account"@en ;
    rdfs:comment "Reference to the customer account associated with the meter and service point for this VEE exception. Used for customer impact analysis and billing hold workflows."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Account Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_account_id" ;
    cmm:cimAssociation "ReadingQuality.CustomerAccount" .
cmm:VeeException.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: VEE exceptions identified as audit findings when indicating systematic data quality issues or control deficiencies. Supports audit evidence collection, corrective action tracking, regulatory reporting"@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_audit_finding_id" ;
    cmm:cimAssociation "ReadingQuality.Document" .
cmm:VeeException.employee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "employee"@en ;
    rdfs:comment "Reference to the employee or system user who reviewed and resolved this VEE exception. Null if exception is still open or was auto-resolved without manual review."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reviewer Identifier" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_employee_id" ;
    cmm:cimAssociation "ReadingQuality.ErpPersonnel" .
cmm:VeeException.event a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "event"@en ;
    rdfs:comment "Foreign key linking to outage.outage_event. Business justification: VEE analysts investigate whether missing/anomalous interval readings stem from power interruptions. Regulatory VEE reports require cross-referencing exceptions with outage events to justify estimation"@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:OutageEvent ;
    cmm:physicalColumn "event_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Outage Event Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_event_id" ;
    cmm:cimAssociation "ReadingQuality.Outage" .
cmm:VeeException.meter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter"@en ;
    rdfs:comment "Reference to the meter that generated the interval data which triggered this VEE exception."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:Meter ;
    cmm:physicalColumn "meter_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Meter Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_meter_id" ;
    cmm:cimAssociation "ReadingQuality.Meter" .
cmm:VeeException.meterPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "meter point"@en ;
    rdfs:comment "Reference to the service point (delivery location) associated with the meter that generated the interval data for this exception. Used to link exceptions to customer accounts and premises."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:MeterPoint ;
    cmm:physicalColumn "meter_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Service Point Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_meter_point_id" ;
    cmm:cimAssociation "ReadingQuality.UsagePoint" .
cmm:VeeException.primaryVeeRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary vee rule"@en ;
    rdfs:comment "Reference to the VEE rule that was triggered and caused this exception to be raised."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:VeeRule ;
    cmm:physicalColumn "primary_vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Rule Identifier" ;
    cmm:sourceColumn "vee_rule_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_primary_vee_rule_id" ;
    cmm:cimAssociation "ReadingQuality.Document" .
cmm:VeeException.rateSchedule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate schedule"@en ;
    rdfs:comment "Reference to the rate schedule (tariff) applicable to the service point at the time of the exception. Used to determine billing impact and priority for resolution, especially for Time-of-Use (TOU) and Critical Peak Pricing (CPP) customers."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:RateSchedule ;
    cmm:physicalColumn "rate_schedule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Rate Schedule Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_rate_schedule_id" ;
    cmm:cimAssociation "ReadingQuality.Tariff" .
cmm:VeeException.toIntervalReading a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to interval reading"@en ;
    rdfs:comment "FK to metering.interval_reading.interval_reading_id — VEE exceptions must reference the interval reading(s) that failed validation. Without this link, operators cannot identify and resolve data quality issues."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:IntervalReading ;
    cmm:physicalColumn "to_interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "interval_reading_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_to_interval_reading_id" ;
    cmm:cimAssociation "ReadingQuality.IntervalReading" .
cmm:VeeException.toVeeRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to vee rule"@en ;
    rdfs:comment "FK to metering.vee_rule.vee_rule_id — Each VEE exception must reference the VEE rule that triggered it. This is essential for exception resolution workflows and rule tuning."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:VeeRule ;
    cmm:physicalColumn "to_vee_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_to_vee_rule_id" ;
    cmm:cimAssociation "ReadingQuality.Document" .
cmm:VeeException.veeIntervalReading a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vee interval reading"@en ;
    rdfs:comment "Reference to the specific interval data record that failed VEE validation and raised this exception."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range cmm:IntervalReading ;
    cmm:physicalColumn "vee_interval_reading_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interval Data Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_vee_exception_vee_interval_reading_id" ;
    cmm:cimAssociation "ReadingQuality.IntervalReading" .
cmm:VeeException.autoResolutionAttempted a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto resolution attempted"@en ;
    rdfs:comment "Boolean flag indicating whether the VEE engine attempted automatic resolution of this exception through estimation algorithms. True if auto-resolution was attempted; False if exception was immediately flagged for manual review."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_resolution_attempted" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Resolution Attempted Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeException.autoResolutionSuccessful a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto resolution successful"@en ;
    rdfs:comment "Boolean flag indicating whether automatic resolution by the VEE engine was successful. True if the engine successfully estimated a replacement value that passed validation; False if auto-resolution failed and manual intervention is required."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_resolution_successful" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto-Resolution Successful Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeException.billingImpactFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing impact flag"@en ;
    rdfs:comment "Boolean flag indicating whether this VEE exception affects customer billing. True if the affected interval data is used in billing determinants and the exception must be resolved before bill calculation; False if the exception is for non-billing data (e.g., operational monitoring, grid analytics)."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "billing_impact_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Impact Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeException.correctedValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "corrected value"@en ;
    rdfs:comment "Final corrected interval data value (in kWh or other unit of measure) after manual review and editing. This is the value that will be used for billing if the exception is resolved. Null if not yet corrected."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "corrected_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Corrected Value" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeException.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this VEE exception record was first created in the MDM system. Audit field for data lineage and record lifecycle tracking."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:ReadingQuality.createdDateTime .
cmm:VeeException.dataQualityScore a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "Numeric data quality score (0.00 to 100.00) assigned to the interval data by the VEE engine, indicating confidence in the data accuracy. Lower scores trigger exceptions. Used for trending meter health and VEE rule tuning."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Data Quality Score" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeException.estimatedValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated value"@en ;
    rdfs:comment "Estimated interval data value (in kWh or other unit of measure) calculated by the VEE engine to replace the invalid or missing original value. Null if estimation was not performed or failed."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "estimated_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimated Value" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeException.estimationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimation method"@en ;
    rdfs:comment "Method used by the VEE engine or analyst to estimate the corrected interval value. Linear interpolation: average of adjacent intervals. Historical average: average of same interval from prior days. Similar day: value from comparable day (same day-of-week, season). Regression: statistical model. Manual entry: analyst-provided value. None: no estimation performed."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "estimation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Estimation Method" ;
    cmm:validValues "linear_interpolation|historical_average|similar_day|regression|manual_entry|none" ;
    cmm:cimDatatype "String" .
cmm:VeeException.exceptionDisposition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception disposition"@en ;
    rdfs:comment "Final disposition category of the VEE exception indicating how it was ultimately handled. Resolved: data corrected and validated. Escalated: sent to engineering or management for further investigation. Waived: accepted without correction per approved business rule or regulatory guidance."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_disposition" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Disposition" ;
    cmm:validValues "resolved|escalated|waived" ;
    cmm:cimDatatype "String" .
cmm:VeeException.exceptionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception number"@en ;
    rdfs:comment "Business-facing unique exception number assigned to this VEE exception for tracking and audit purposes. Format: VEE-xxxxxxxxxx."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Exception Number" ;
    cmm:valuePattern "^VEE-[0-9]{10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:VeeException.exceptionRaisedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception raised timestamp"@en ;
    rdfs:comment "Timestamp when the VEE exception was first raised by the MDM VEE engine during interval data validation processing. Represents the business event time of exception detection."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "exception_raised_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Raised Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VeeException.exceptionSeverity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception severity"@en ;
    rdfs:comment "Severity level of the VEE exception indicating business impact and urgency for resolution. Critical exceptions block billing; high exceptions require immediate review; medium and low exceptions are tracked for quality metrics; informational exceptions are logged for audit only."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_severity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Exception Severity" ;
    cmm:validValues "critical|high|medium|low|informational" ;
    cmm:cimDatatype "String" .
cmm:VeeException.exceptionSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception source system"@en ;
    rdfs:comment "Source system that originated the interval data which triggered this VEE exception. Typically MDM (Meter Data Management) for AMI data, AMI head-end for direct meter reads, SCADA for grid operations data, manual entry for field reads, or billing system for estimated reads."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Exception Source System" ;
    cmm:validValues "MDM|AMI_head_end|SCADA|manual_entry|billing_system" ;
    cmm:cimDatatype "String" .
cmm:VeeException.exceptionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception status"@en ;
    rdfs:comment "Current lifecycle status of the VEE exception. Open: newly raised and awaiting review. In Review: assigned to analyst for investigation. Resolved: corrective action taken and data corrected. Escalated: requires supervisor or engineering review. Waived: exception accepted without correction per business rule. Closed: final disposition recorded and exception archived."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Exception Status" ;
    cmm:validValues "open|in_review|resolved|escalated|waived|closed" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.status .
cmm:VeeException.exceptionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "exception type"@en ;
    rdfs:comment "Classification of the VEE exception indicating the nature of the data quality issue: validation failure (data failed validation rule), estimation failure (unable to estimate missing interval), editing failure (manual edit rejected), missing data (no interval data received), suspect data (data flagged as questionable), or out of range (value exceeds expected bounds)."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "exception_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Exception Type" ;
    cmm:validValues "validation_failure|estimation_failure|editing_failure|missing_data|suspect_data|out_of_range" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ReadingQuality.kind .
cmm:VeeException.intervalCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval count"@en ;
    rdfs:comment "Number of individual interval readings affected by this VEE exception. For 15-minute interval meters, a 1-hour exception would affect 4 intervals."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:int ;
    cmm:physicalColumn "interval_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Count" ;
    cmm:cimDatatype "Integer" .
cmm:VeeException.intervalEndTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval end timestamp"@en ;
    rdfs:comment "End timestamp of the interval data range affected by this VEE exception. Defines the end of the time window containing suspect or invalid data."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_end_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval End Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VeeException.intervalStartTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interval start timestamp"@en ;
    rdfs:comment "Start timestamp of the interval data range affected by this VEE exception. Defines the beginning of the time window containing suspect or invalid data."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "interval_start_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interval Start Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VeeException.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this VEE exception record was last updated. Audit field for tracking changes to exception status, resolution actions, and data corrections."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:VeeException.originalValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "original value"@en ;
    rdfs:comment "Original raw interval data value (in kWh or other unit of measure) that triggered the VEE exception before any estimation or editing was applied."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "original_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Original Value" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeException.regulatoryReportableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory reportable flag"@en ;
    rdfs:comment "Boolean flag indicating whether this VEE exception must be reported to regulatory authorities (e.g., state Public Utility Commission) as part of data quality and billing accuracy compliance reporting. True if reportable; False otherwise."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "regulatory_reportable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Reportable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:VeeException.resolutionAction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution action"@en ;
    rdfs:comment "Action taken to resolve the VEE exception. Re-estimate: apply different estimation algorithm. Manual edit: analyst manually corrected the value. Accept original: original value accepted despite exception. Override: supervisor approved exception without correction. Escalate: sent to engineering for investigation. Waive: exception acknowledged but no correction required per business rule."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_action" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Action" ;
    cmm:validValues "re_estimate|manual_edit|accept_original|override|escalate|waive" ;
    cmm:cimDatatype "String" .
cmm:VeeException.resolutionNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution notes"@en ;
    rdfs:comment "Free-text notes entered by the analyst or system documenting the resolution action, rationale for the decision, and any additional context for audit purposes."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "resolution_notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Resolution Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:VeeException.resolutionTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolution timestamp"@en ;
    rdfs:comment "Timestamp when the VEE exception was resolved (status changed to resolved, waived, or closed). Null if exception is still open or in review. Used to calculate exception aging and VEE team performance metrics."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "resolution_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Resolution Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:VeeException.reviewerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer name"@en ;
    rdfs:comment "Full name of the analyst or system user who reviewed and resolved this VEE exception. Captured for audit trail and operational reporting."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "reviewer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reviewer Name" ;
    cmm:cimDatatype "String" .
cmm:VeeException.thresholdValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "threshold value"@en ;
    rdfs:comment "Numeric threshold value defined in the VEE rule that was exceeded or violated, triggering this exception. For example, maximum expected consumption in kWh, or maximum percent deviation from historical average."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "threshold_value" ;
    cmm:sqlDataType "DECIMAL(18,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Threshold Value" ;
    cmm:cimDatatype "Decimal" .
cmm:VeeException.unitOfMeasure a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:comment "Unit of measure for the interval data values associated with this exception. Typically kWh (kilowatt-hour) for electric energy consumption, kW for demand, or gas volume units. Reference-value candidates: kWh|MWh|kW|kVAR|kVA|CCF|MCF|therms."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_of_measure" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit of Measure (UOM)" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "UnitSymbol" .
cmm:VeeException.veeBatchCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "vee batch code"@en ;
    rdfs:comment "Reference to the VEE processing batch run that raised this exception. Used to group exceptions by processing cycle for operational dashboards and batch-level quality metrics."@en ;
    rdfs:domain cmm:VeeException ; rdfs:range xsd:long ;
    cmm:physicalColumn "vee_batch_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Validation Estimation and Editing (VEE) Batch Identifier" ;
    cmm:cimDatatype "Integer" .

cmm:AmiHeadEnd a owl:Class ;
    rdfs:label "Ami Head End"@en ;
    rdfs:comment "Master record for each AMI head-end system instance managing a population of smart meters — the central communication hub for the AMI network. Captures head-end system name, vendor, software version, communication protocol (RF mesh, PLC, cellular), geographic coverage area, maximum device capacity, current enrolled device count, network uptime SLA, integration endpoint details for MDM, and data collection run statistics (scheduled/on-demand collection execution, success rates, timing, and completeness metrics). Supports multi-vendor AMI environments, head-end performance monitoring, and MDM data completeness tracking for VEE processing readiness."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:metering , cmmsa:metering.ami_operations ;
    cmm:physicalTable "utility_cmm_silver.metering.ami_head_end" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-9 (HeadEnd); AMI Head-End System — Network Management" ;
    cmm:sourceObject "energy_utilities_ecm.metering.ami_head_end" ;
    owl:hasKey ( cmm:AmiHeadEnd.amiHeadEndId ) .

cmm:AmiHeadEnd.amiHeadEndId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ami head end id"@en ;
    rdfs:comment "Unique identifier for the AMI head-end system instance. Primary key."@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range xsd:long ;
    cmm:physicalColumn "ami_head_end_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Advanced Metering Infrastructure (AMI) Head-End System ID" ;
    cmm:cimDatatype "Integer" .
cmm:AmiHeadEnd.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: AMI head-end deployments are major capital projects requiring CPCN approval and IRP alignment. Essential for smart grid investment tracking, project cost-to-completion monitoring, RAB inclusion date d"@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_ami_head_end_capex_project_id" ;
    cmm:cimAssociation "IdentifiedObject.Project" .
cmm:AmiHeadEnd.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: AMI infrastructure O&M costs (software licenses, maintenance, network operations) are allocated to cost centers. Required for smart grid program cost tracking, rate case O&M justification, and regulat"@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_ami_head_end_cost_center_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:AmiHeadEnd.fixedAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fixed asset"@en ;
    rdfs:comment "Foreign key linking to finance.fixed_asset. Business justification: AMI head-end systems are capital assets (FERC Account 397 - Communication Equipment). Required for smart grid capital asset tracking, depreciation calculation, asset retirement obligation accounting,"@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range cmm:FixedAsset ;
    cmm:physicalColumn "fixed_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Fixed Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_ami_head_end_fixed_asset_id" ;
    cmm:cimAssociation "IdentifiedObject.FinancialInfo" .
cmm:AmiHeadEnd.nercCipAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "nerc cip asset"@en ;
    rdfs:comment "Foreign key linking to compliance.nerc_cip_asset. Business justification: AMI head-end systems classified as BES Cyber Systems under NERC CIP-002, requiring cybersecurity controls. Enables CIP compliance tracking, vulnerability assessment scheduling, cyber security incident"@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range cmm:NercCipAsset ;
    cmm:physicalColumn "nerc_cip_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Nerc Cip Asset Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_ami_head_end_nerc_cip_asset_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:AmiHeadEnd.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: AMI head-end systems are capital network infrastructure assets requiring asset tagging, depreciation, maintenance plans, warranty tracking, and rate base inclusion. Utilities manage these as major IT/"@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ami Head End Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_metering_ami_head_end_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.Asset" .
cmm:AmiHeadEnd.actualUptimePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual uptime percent"@en ;
    rdfs:comment "Actual measured network uptime availability for the head-end system over the most recent reporting period, expressed as a percentage."@en ;
    rdfs:domain cmm:AmiHeadEnd ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_uptime_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
