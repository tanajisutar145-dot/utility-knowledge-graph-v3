cmm:CostCenter.lockIndicator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "lock indicator"@en ;
    rdfs:comment "Indicates whether the cost center is locked for actual postings. Used during period-end close and budget planning cycles."@en ;
