cmm:TechnicalReview.reviewStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review start date"@en ;
    rdfs:comment "Date when the technical review was initiated. Used to track review cycle time and Service Level Agreement (SLA) compliance."@en ;
