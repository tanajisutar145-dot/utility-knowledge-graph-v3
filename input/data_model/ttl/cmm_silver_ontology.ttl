    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PowerPlant.fercLicenseNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc license number"@en ;
    rdfs:comment "FERC license number for hydroelectric projects or other federally-licensed generation facilities."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
