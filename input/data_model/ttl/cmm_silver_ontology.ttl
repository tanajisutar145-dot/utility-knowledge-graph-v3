cmm:RegulatoryCorrespondence.correspondenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "correspondence number"@en ;
    rdfs:comment "Business identifier or reference number assigned to the correspondence by the utility or regulatory body. Used for tracking and citation in regulatory proceedings."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
    cmm:physicalColumn "correspondence_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
