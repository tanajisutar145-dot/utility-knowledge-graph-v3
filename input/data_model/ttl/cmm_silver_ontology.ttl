    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:CostCenter.locationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location code"@en ;
    rdfs:comment "Physical location or plant where the cost center operates. Used for geographic cost analysis and facility-level reporting."@en ;
