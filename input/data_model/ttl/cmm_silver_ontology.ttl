cmm:NetworkAssociation a owl:Class ;
    rdfs:label "Network Association"@en ;
    rdfs:comment "Esri Utility Network associations (connectivity, containment, structural attachment) aligned to CIM: connectivity = Terminal/ConnectivityNode, containment = Equipment.EquipmentContainer / Asset.AssetContainer, structural attachment = Asset.AssetContainer (Structure)."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.network_association" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Esri ArcGIS Utility Network" ;
    owl:hasKey ( cmm:NetworkAssociation.networkAssociationId ) .

cmm:NetworkAssociation.networkAssociationId a owl:DatatypeProperty , owl:FunctionalProperty ;
