cmm:TradingContract a owl:Class ;
    rdfs:label "Trading Contract"@en ;
    rdfs:comment "Master reference table for contract. Referenced by contract_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Agreement ;
    cmm:cimExtends cim:Agreement ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:trading , cmmsa:trading.asset_holdings ;
    cmm:physicalTable "utility_cmm_silver.trading.contract" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.trading.contract" ;
    owl:hasKey ( cmm:TradingContract.contractId ) .

cmm:TradingContract.contractId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract id"@en ;
    rdfs:comment "Primary key for contract"@en ;
    rdfs:domain cmm:TradingContract ; rdfs:range xsd:long ;
    cmm:physicalColumn "contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Contract Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:TradingContract.counterparty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "counterparty"@en ;
    rdfs:comment "Unique identifier of the counterparty organization associated with the contract."@en ;
    rdfs:domain cmm:TradingContract ; rdfs:range cmm:Counterparty ;
    cmm:physicalColumn "counterparty_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_contract_counterparty_id" ;
    cmm:cimAssociation "Agreement.MarketParticipant" .
cmm:TradingContract.masterContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "master contract"@en ;
    rdfs:comment "Self-referencing FK on contract (master_contract_id)"@en ;
    rdfs:domain cmm:TradingContract ; rdfs:range cmm:TradingContract ;
    cmm:physicalColumn "master_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_trading_contract_master_contract_id" ;
    cmm:cimAssociation "Agreement.Agreement" .
cmm:TradingContract.collateralAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "collateral amount"@en ;
    rdfs:comment "Monetary collateral posted to secure the contract."@en ;
    rdfs:domain cmm:TradingContract ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "collateral_amount" ;
    cmm:sqlDataType "DECIMAL(18,4)" ;
    cmm:nullable true ;
