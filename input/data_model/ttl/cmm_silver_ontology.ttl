    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Attendance Status" ;
    cmm:validValues "Attended|Absent|Partial|Excused" ;
    cmm:cimDatatype "String" .
cmm:SafetyTraining.certificationExpirationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
