    cmm:cimAssociation "IdentifiedObject.GeneratingUnit" .
cmm:UnitCertificationRequirement.createdDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created date"@en ;
    rdfs:comment "Timestamp when this unit-certification requirement record was created in the system."@en ;
    rdfs:domain cmm:UnitCertificationRequirement ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_date" ;
