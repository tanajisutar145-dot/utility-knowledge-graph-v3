cmm:SafetyIncident.sapReferralFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sap referral flag"@en ;
    rdfs:comment "Indicates whether the employee was referred to a Substance Abuse Professional for evaluation and treatment following a positive test or refusal. Required per DOT 49 CFR Part 40.287."@en ;
    rdfs:domain cmm:SafetyIncident ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sap_referral_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
