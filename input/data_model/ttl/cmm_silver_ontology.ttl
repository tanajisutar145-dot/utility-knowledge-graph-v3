cmm:MessageTemplate.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent modification to the template record."@en ;
    rdfs:domain cmm:MessageTemplate ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
