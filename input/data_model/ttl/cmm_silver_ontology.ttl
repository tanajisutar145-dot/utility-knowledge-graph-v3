    cmm:businessTerm "Hierarchy Area Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" .
cmm:CostCenter.lastModifiedByUser a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by user"@en ;
    rdfs:comment "User ID of the person who last modified the cost center master record."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
