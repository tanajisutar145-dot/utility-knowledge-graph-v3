cmm:StudyPathAnalysis.thermalViolationsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal violations count"@en ;
    rdfs:comment "Number of thermal overload violations identified on this specific path during this study's contingency analysis"@en ;
    rdfs:domain cmm:StudyPathAnalysis ; rdfs:range xsd:int ;
