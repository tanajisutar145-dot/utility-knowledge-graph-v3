    cmm:cimDatatype "Frequency" .
cmm:ControlArea.nonSpinningReserveMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "non spinning reserve mw"@en ;
    rdfs:comment "Amount of non-spinning (offline) reserve in megawatts that can be deployed within 10 minutes for contingency response."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "non_spinning_reserve_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Spinning Reserve (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional operational notes, configuration details, or special instructions related to this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ControlArea.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the control area in the grid operations environment."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "active|inactive|suspended|testing|decommissioned" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ControlArea.status .
cmm:ControlArea.peakLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "peak load mw"@en ;
    rdfs:comment "Historical or forecasted peak electrical load in megawatts for this control area, used for capacity planning and reserve calculations."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "peak_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Peak Load (Megawatts)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:ControlArea.piHistorianTagPrefix a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pi historian tag prefix"@en ;
    rdfs:comment "Standard tag prefix used in OSIsoft PI historian for all telemetry points associated with this control area."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "pi_historian_tag_prefix" ;
