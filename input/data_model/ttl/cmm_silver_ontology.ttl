    cmm:businessTerm "Assessment Method" ;
    cmm:cimDatatype "String" .
cmm:ControlAreaObligation.complianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance status"@en ;
    rdfs:comment "Current compliance status of this specific control area with respect to this specific obligation. Values: compliant, non-compliant, partial-compliance, not-assessed, not-applicable."@en ;
    rdfs:domain cmm:ControlAreaObligation ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_status" ;
