cmm:Feeder.feederCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "feeder code"@en ;
    rdfs:comment "Externally-known unique business identifier for the feeder, typically used in operational systems and field communications. Often follows utility-specific naming conventions combining substation code and circuit number."@en ;
    rdfs:domain cmm:Feeder ; rdfs:range xsd:string ;
    cmm:physicalColumn "feeder_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
