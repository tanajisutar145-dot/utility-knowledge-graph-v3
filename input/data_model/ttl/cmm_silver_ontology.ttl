cmm:EmployeeQualification.qualificationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualification name"@en ;
    rdfs:comment "Full descriptive name of the qualification as it appears in workforce records and competency documentation."@en ;
