cmm:CpcnApplication a owl:Class ;
    rdfs:label "Cpcn Application"@en ;
    rdfs:comment "Master record for Certificate of Public Convenience and Necessity (CPCN) applications filed with state PUCs for major capital projects including new generation facilities, transmission line construction, substation upgrades, and large distribution infrastructure investments. Captures project description, estimated capital cost, applied-for certificate type, filing date, PUC docket number, environmental review status, public hearing schedule, commission order date, and certificate conditions. SSOT for major capital authorization proceedings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.compliance.cpcn_application" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "State PUC CPCN Rules; FERC Section 203 Authorization" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.cpcn_application" ;
    owl:hasKey ( cmm:CpcnApplication.cpcnApplicationId ) .

cmm:CpcnApplication.cpcnApplicationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cpcn application id"@en ;
    rdfs:comment "Unique identifier for the CPCN application record. Primary key."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:long ;
    cmm:physicalColumn "cpcn_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Certificate of Public Convenience and Necessity (CPCN) Application ID" ;
    cmm:cimDatatype "Integer" .
cmm:CpcnApplication.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to finance.capex_project. Business justification: CPCN applications authorize specific capital projects. Regulatory approval gates project execution; finance tracks actual spend against approved budget. Essential for reconciling regulatory commitment"@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capex Project Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_cpcn_application_capex_project_id" ;
    cmm:cimAssociation "Document.Project" .
cmm:CpcnApplication.projectManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "project manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: CPCN applications require employee project manager accountability for construction project execution. Replaces text field with FK to enable resource allocation, project portfolio management, and regul"@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "project_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_cpcn_application_project_manager_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:CpcnApplication.acceptanceDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "acceptance date"@en ;
    rdfs:comment "Date on which the PUC formally accepted the application as complete and sufficient for review."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:date ;
    cmm:physicalColumn "acceptance_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Acceptance Date" ;
    cmm:cimDatatype "Date" .
cmm:CpcnApplication.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Indicates whether the CPCN application record is currently active in the system or has been archived."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CpcnApplication.appealFiledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "appeal filed flag"@en ;
    rdfs:comment "Indicates whether an appeal of the PUC decision has been filed with a state court or appellate body."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "appeal_filed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Appeal Filed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CpcnApplication.applicationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application number"@en ;
    rdfs:comment "Externally-known application number assigned by the utility or regulatory body for tracking and reference purposes."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "CPCN Application Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CpcnApplication.applicationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application status"@en ;
    rdfs:comment "Current lifecycle status of the CPCN application within the regulatory approval process. Reference-value candidates: draft|filed|under_review|hearing_scheduled|approved|denied|withdrawn|suspended."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Application Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:CpcnApplication.applicationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "application type"@en ;
    rdfs:comment "Type of capital project for which the CPCN is being sought, categorizing the nature of the infrastructure investment."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "application_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "CPCN Application Type" ;
    cmm:validValues "generation_facility|transmission_line|substation|distribution_infrastructure|combined_project|other" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:CpcnApplication.boardApprovalRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board approval required flag"@en ;
    rdfs:comment "Indicates whether Board of Directors approval was required prior to filing the CPCN application due to capital expenditure thresholds."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "board_approval_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Approval Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:CpcnApplication.boardNotificationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "board notification date"@en ;
    rdfs:comment "Date on which the utility Board of Directors was notified of the CPCN application filing or decision."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:date ;
    cmm:physicalColumn "board_notification_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board Notification Date" ;
    cmm:cimDatatype "Date" .
cmm:CpcnApplication.certificateConditions a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "certificate conditions"@en ;
    rdfs:comment "Specific conditions, restrictions, or requirements imposed by the PUC as part of the certificate approval, including construction milestones, reporting obligations, and operational constraints."@en ;
    rdfs:domain cmm:CpcnApplication ; rdfs:range xsd:string ;
