cmm:IncentiveProgram.eligibleTechnologyTypes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "eligible technology types"@en ;
    rdfs:comment "Comma-separated list of renewable energy technology types eligible for this incentive program (e.g., solar_pv, wind, battery_storage, hydroelectric, biomass, geothermal)."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "eligible_technology_types" ;
