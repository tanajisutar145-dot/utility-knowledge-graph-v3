    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Settlement Rule Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:SettlementRule.supersededSettlementRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "superseded settlement rule"@en ;
    rdfs:comment "Self-referencing FK on settlement_rule (superseded_settlement_rule_id)"@en ;
    rdfs:domain cmm:SettlementRule ; rdfs:range cmm:SettlementRule ;
    cmm:physicalColumn "superseded_settlement_rule_id" ;
