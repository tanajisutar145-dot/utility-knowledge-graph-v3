cmm:JobRequisition.requisitionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition status"@en ;
    rdfs:comment "Current lifecycle status of the job requisition in the hiring workflow. Tracks progression from draft through approval to fulfillment or cancellation. Reference-value candidates: draft|submitted|approved|rejected|open|in_progress|filled|cancelled|on_hold."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "requisition_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Requisition Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.status .
cmm:JobRequisition.requisitionSubmittedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition submitted date"@en ;
    rdfs:comment "Date when the hiring manager submitted the requisition for approval. Marks the start of the approval workflow."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:date ;
    cmm:physicalColumn "requisition_submitted_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requisition Submitted Date" ;
    cmm:cimDatatype "Date" .
cmm:JobRequisition.requisitionType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requisition type"@en ;
    rdfs:comment "Classification of the hiring need. Distinguishes between new headcount, backfill for departed employee, seasonal staffing, temporary assignments, and contractor positions. Reference-value candidates: new_position|backfill|replacement|seasonal|temporary|contractor|intern."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "requisition_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Requisition Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Request.type .
cmm:JobRequisition.salaryRangeMaximum a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "salary range maximum"@en ;
    rdfs:comment "Maximum annual salary for the position in USD. Defines the upper bound of the compensation band for the pay grade."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "salary_range_maximum" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Salary Range Maximum" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:JobRequisition.salaryRangeMinimum a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "salary range minimum"@en ;
    rdfs:comment "Minimum annual salary for the position in USD. Defines the lower bound of the compensation band for the pay grade."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "salary_range_minimum" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Salary Range Minimum" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "Decimal" .
cmm:JobRequisition.securityClearanceRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "security clearance required"@en ;
    rdfs:comment "Indicates whether the position requires government or utility security clearance. Common for positions with access to critical infrastructure or sensitive operational data."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "security_clearance_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Security Clearance Required" ;
    cmm:cimDatatype "Boolean" .
cmm:JobRequisition.shiftPattern a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift pattern"@en ;
    rdfs:comment "Standard work schedule pattern for the position. Critical for operations and field services roles requiring 24/7 coverage."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_pattern" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Pattern" ;
    cmm:validValues "day|night|rotating|on_call|flexible" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.sourcingChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sourcing channel"@en ;
    rdfs:comment "Primary recruitment channel for candidate sourcing. Used to track recruitment effectiveness and cost-per-hire by channel. Reference-value candidates: internal_posting|external_posting|employee_referral|recruitment_agency|campus_recruiting|job_board|social_media|direct_sourcing."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:string ;
    cmm:physicalColumn "sourcing_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sourcing Channel" ;
    cmm:cimDatatype "String" .
cmm:JobRequisition.targetHireDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "target hire date"@en ;
    rdfs:comment "Desired start date for the new hire. Used for recruitment timeline planning and workforce capacity forecasting."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:date ;
    cmm:physicalColumn "target_hire_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Target Hire Date" ;
    cmm:cimDatatype "Date" .
cmm:JobRequisition.travelRequirementPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "travel requirement pct"@en ;
    rdfs:comment "Expected percentage of work time requiring travel away from primary work location. Ranges from 0 (no travel) to 100 (constant travel). Important for field engineering and mutual aid roles."@en ;
    rdfs:domain cmm:JobRequisition ; rdfs:range xsd:int ;
    cmm:physicalColumn "travel_requirement_pct" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Travel Requirement Percentage" ;
