cmm:TaxProvision.deferredTaxExpense a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deferred tax expense"@en ;
    rdfs:comment "The portion of total income tax expense attributable to changes in deferred tax assets and liabilities for the fiscal period."@en ;
