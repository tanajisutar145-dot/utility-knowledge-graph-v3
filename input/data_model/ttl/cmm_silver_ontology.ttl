    rdfs:comment "Numeric score (0-100) representing overall data quality for the station."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "data_quality_score" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Decimal" .
cmm:WeatherStation.dataSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data source system"@en ;
    rdfs:comment "Name of the upstream system that provides raw sensor data."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "data_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.dataUpdateFrequencyMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data update frequency minutes"@en ;
    rdfs:comment "Interval in minutes between successive data pushes from the station."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:int ;
    cmm:physicalColumn "data_update_frequency_minutes" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:unitSymbol "min" ;
    cmm:cimDatatype "Minutes" .
cmm:WeatherStation.decommissionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "decommission date"@en ;
    rdfs:comment "Date the station was permanently retired or removed from service."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:date ;
    cmm:physicalColumn "decommission_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.retiredDate .
cmm:WeatherStation.description a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Free-form notes describing location specifics, installation remarks, or operational considerations."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sourceColumn "weather_station_description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:WeatherStation.elevationM a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "elevation m"@en ;
    rdfs:comment "Station elevation in meters above mean sea level."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:double ;
    cmm:physicalColumn "elevation_m" ;
    cmm:sqlDataType "DOUBLE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:unitSymbol "m" ;
    cmm:cimDatatype "Length" ;
    cmm:cimExactMatch cim:PositionPoint.zPosition .
cmm:WeatherStation.installationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "installation date"@en ;
    rdfs:comment "Date the weather station was installed and became operational."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:date ;
    cmm:physicalColumn "installation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:LifecycleDate.installationDate .
cmm:WeatherStation.lastCalibrationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last calibration date"@en ;
    rdfs:comment "Date the station's sensors were last calibrated."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_calibration_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:WeatherStation.latitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Geographic latitude of the station in decimal degrees (WGS84)."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:WeatherStation.longitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Geographic longitude of the station in decimal degrees (WGS84)."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:WeatherStation.maintenanceContactEmail a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance contact email"@en ;
    rdfs:comment "Email address for the maintenance contact."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_contact_email" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_email" ;
    cmm:cimDatatype "String" ;
    cmm:cimAssociation "ElectronicAddress.email1" .
cmm:WeatherStation.maintenanceContactName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance contact name"@en ;
    rdfs:comment "Name of the person or team responsible for station upkeep."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_contact_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.maintenanceContactPhone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance contact phone"@en ;
    rdfs:comment "Phone number for the maintenance contact."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "maintenance_contact_phone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_phone" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:TelephoneNumber.ituPhone .
cmm:WeatherStation.manufacturer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "manufacturer"@en ;
    rdfs:comment "Company that manufactured the weather station hardware."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "manufacturer" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Manufacturer.name .
cmm:WeatherStation.measurementCapabilities a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement capabilities"@en ;
    rdfs:comment "Comma-separated list of measurement types the station can capture."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_capabilities" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.measurementUnits a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "measurement units"@en ;
    rdfs:comment "Standard units used for the station's measurements (e.g., °C, m/s, %)."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "measurement_units" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.model a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "model"@en ;
    rdfs:comment "Model designation of the weather station equipment."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "model" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:ProductAssetModel.modelNumber .
cmm:WeatherStation.nextCalibrationDue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "next calibration due"@en ;
    rdfs:comment "Scheduled date for the next calibration activity."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:date ;
    cmm:physicalColumn "next_calibration_due" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Date" .
cmm:WeatherStation.ownerOrganization a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner organization"@en ;
    rdfs:comment "Business unit or subsidiary that owns the weather station."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_organization" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.powerSource a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power source"@en ;
    rdfs:comment "Primary energy source powering the station equipment."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "power_source" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.regulatoryComplianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory compliance status"@en ;
    rdfs:comment "Current status of the station's compliance with NERC, FERC, or other applicable regulations."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:WeatherStation.serialNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "serial number"@en ;
    rdfs:comment "Unique serial number assigned by the manufacturer."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "serial_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Asset.serialNumber .
cmm:WeatherStation.stationCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "station code"@en ;
    rdfs:comment "External business code or identifier assigned by the utility or regulatory body."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "station_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:WeatherStation.stationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "station name"@en ;
    rdfs:comment "Human-readable name of the weather station used in reports and dashboards."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "station_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:WeatherStation.stationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "station type"@en ;
    rdfs:comment "Classification of the station based on deployment and data collection method."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "station_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:WeatherStation.kind .
cmm:WeatherStation.status a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current operational state of the station within its lifecycle."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sourceColumn "weather_station_status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:WeatherStation.status .
cmm:WeatherStation.timezone a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "timezone"@en ;
    rdfs:comment "IANA time zone identifier for the station location (e.g., America/New_York)."@en ;
    rdfs:domain cmm:WeatherStation ; rdfs:range xsd:string ;
    cmm:physicalColumn "timezone" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .


#################################################################
# Subject area: generation
#################################################################

cmm:GeneratingUnit a owl:Class ;
    rdfs:label "Generating Unit"@en ;
    rdfs:comment "Master record for each individual generation unit (CCGT, coal, nuclear, hydro, wind turbine, solar array, biomass boiler) within the generation fleet. Captures nameplate capacity (MW), unit type, fuel type, commercial operation date, retirement date, ISO/RTO interconnection node (PNode), NERC unit code, regulatory classification, heat rate design point (BTU/kWh), minimum stable load, ramp rate limits, and ABB Ability Symphony Plus DCS asset tag. SSOT for generation unit identity across the enterprise."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:GeneratingUnit ;
    cmm:cimExactMatch cim:GeneratingUnit ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61970::Generation::Production" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.generation_assets ;
    cmm:physicalTable "utility_cmm_silver.generation.generating_unit" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "NERC GADS; NERC Generating Unit Registry / EIA Form 860" ;
    cmm:sourceObject "energy_utilities_ecm.generation.generating_unit" ;
    owl:hasKey ( cmm:GeneratingUnit.generatingUnitId ) .

cmm:GeneratingUnit.generatingUnitId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generating unit id"@en ;
    rdfs:comment "Unique identifier for the generating unit. Primary key. _canonical_skip_reason: MASTER_RESOURCE role inferred; all required categories present."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:long ;
    cmm:physicalColumn "generating_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Generating Unit ID" ;
    cmm:cimDatatype "Integer" .
cmm:GeneratingUnit.book a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "book"@en ;
    rdfs:comment "Foreign key linking to trading.trading_book. Business justification: Generation assets are assigned to trading books for P&L tracking, position management, and risk limit enforcement. Essential for financial reporting and market risk management in energy trading operat"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:TradingBook ;
    cmm:physicalColumn "book_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trading Book Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_book_id" ;
    cmm:cimAssociation "GeneratingUnit.Document" .
cmm:GeneratingUnit.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Generating units are primary elements in N-1/N-2 contingency definitions for reliability studies. Required for NERC TPL-001 compliance and operations planning."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_contingency_id" ;
    cmm:cimAssociation "GeneratingUnit.Contingency" .
cmm:GeneratingUnit.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Generating units are cost centers for O&M expense tracking, FERC accounting, and rate case cost allocation. Essential for monthly variance analysis and regulatory reporting."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_cost_center_id" ;
    cmm:cimAssociation "GeneratingUnit.Organisation" .
cmm:GeneratingUnit.criticalSparePartMaterialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "critical spare part material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Generating units consume spare parts (bearings, seals, filters) tracked in material master for maintenance planning and MRO procurement. Standard asset-material linkage in EAM/ERP systems for work ord"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "critical_spare_part_material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Critical Spare Part Material Master Id (Foreign Key)" ;
    cmm:sourceColumn "material_master_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_critical_spare_part_material_master_id" ;
    cmm:cimAssociation "GeneratingUnit.ErpItemMaster" .
cmm:GeneratingUnit.emsAlarm a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems alarm"@en ;
    rdfs:comment "Foreign key linking to grid.ems_alarm. Business justification: Generator alarms (trip, limit violation, AVR failure) are monitored in EMS. Required for real-time operator response and equipment protection."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:EmsAlarm ;
    cmm:physicalColumn "ems_alarm_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Alarm Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_ems_alarm_id" ;
    cmm:cimAssociation "GeneratingUnit.ActivityRecord" .
cmm:GeneratingUnit.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Foreign key linking to grid.ems_node. Business justification: Generating units connect to grid at specific EMS nodes (injection points). Required for state estimation, power flow analysis, and LMP calculation."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Node Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_ems_node_id" ;
    cmm:cimAssociation "GeneratingUnit.TopologicalNode" .
cmm:GeneratingUnit.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Generating units operate within specific forecast zones for dispatch optimization, locational marginal pricing, and zonal capacity planning. Required for day-ahead market bidding, real-time dispatch c"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_forecast_zone_id" ;
    cmm:cimAssociation "GeneratingUnit.LoadArea" .
cmm:GeneratingUnit.generatingBelongsToPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating_belongs_to_power_plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — Every generating unit physically resides within a power plant. This is the fundamental parent-child hierarchy of the generation fleet. Without this FK, unit records are orphaned from their plant conte"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "generating_belongs_to_power_plant" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_generating_belongs_to_power_plant" ;
    cmm:cimAssociation "GeneratingUnit.Plant" .
cmm:GeneratingUnit.generatingPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "generating power plant"@en ;
    rdfs:comment "Identifier of the generation plant or facility to which this unit belongs. Links unit to plant-level master data."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "generating_power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_generating_power_plant_id" ;
    cmm:cimAssociation "GeneratingUnit.Plant" .
cmm:GeneratingUnit.hedgeStrategy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hedge strategy"@en ;
    rdfs:comment "Foreign key linking to trading.hedge_strategy. Business justification: Physical generation assets are hedged via specific hedge strategies to mitigate price and volume risk. Critical for integrated risk management programs that link physical assets to financial hedges."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:HedgeStrategy ;
    cmm:physicalColumn "hedge_strategy_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Hedge Strategy Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_hedge_strategy_id" ;
    cmm:cimAssociation "GeneratingUnit.Document" .
cmm:GeneratingUnit.maintenancePlan a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "maintenance plan"@en ;
    rdfs:comment "Foreign key linking to asset.maintenance_plan. Business justification: Generating units require preventive maintenance plans (time-based, condition-based, regulatory-mandated) to ensure reliability, compliance, and optimal performance. Maintenance planning drives work or"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:MaintenancePlan ;
    cmm:physicalColumn "maintenance_plan_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Maintenance Plan Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_maintenance_plan_id" ;
    cmm:cimAssociation "GeneratingUnit.Procedure" .
cmm:GeneratingUnit.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Units must track applicable regulatory obligations (NERC reliability standards, emissions limits, operational requirements) for compliance tracking, audit preparation, and regulatory reporting. Essent"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_obligation_id" ;
    cmm:cimAssociation "GeneratingUnit.Document" .
cmm:GeneratingUnit.operatingLimit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operating limit"@en ;
    rdfs:comment "Foreign key linking to grid.operating_limit. Business justification: Generating units have operating limits (Pmin/Pmax, Qmin/Qmax) modeled in EMS. Required for economic dispatch, AGC, and voltage control."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:OperatingLimit ;
    cmm:physicalColumn "operating_limit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operating Limit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_operating_limit_id" ;
    cmm:cimAssociation "GeneratingUnit.OperationalLimit" .
cmm:GeneratingUnit.pmuDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pmu device"@en ;
    rdfs:comment "Foreign key linking to grid.pmu_device. Business justification: PMUs monitor generator terminal voltage/current phasors. Required for NERC PRC-002 synchrophasor data and oscillation detection."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:PmuDevice ;
    cmm:physicalColumn "pmu_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Pmu Device Id (Foreign Key)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_pmu_device_id" ;
    cmm:cimAssociation "GeneratingUnit.RemoteUnit" .
cmm:GeneratingUnit.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "FK to generation.power_plant.power_plant_id — Fundamental parent-child relationship: every generating unit physically resides within a power plant. This is the most critical FK in the domain — without it, you cannot aggregate unit-level data to p"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_power_plant_id" ;
    cmm:cimAssociation "GeneratingUnit.Plant" .
cmm:GeneratingUnit.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Units are profit centers in merchant markets for P&L tracking, ISO settlement reconciliation, and unit-level profitability analysis. Critical for competitive generation operations."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_profit_center_id" ;
    cmm:cimAssociation "GeneratingUnit.Organisation" .
cmm:GeneratingUnit.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Generating units are physical assets requiring comprehensive asset management for maintenance scheduling, depreciation, valuation, regulatory rate base reporting, and capital planning. Every generatio"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_registry_id" ;
    cmm:cimAssociation "GeneratingUnit.Asset" .
cmm:GeneratingUnit.scadaPoint a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "scada point"@en ;
    rdfs:comment "Primary SCADA point identifier for real-time generation telemetry and monitoring. Used for integration with OSIsoft PI historian."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:ScadaPoint ;
    cmm:physicalColumn "scada_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Supervisory Control and Data Acquisition (SCADA) Point ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_scada_point_id" ;
    cmm:cimAssociation "GeneratingUnit.Measurement" .
cmm:GeneratingUnit.sparePartsCatalog a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "spare parts catalog"@en ;
    rdfs:comment "Foreign key linking to supply.spare_parts_catalog. Business justification: Units have critical spare parts catalogs defining recommended stock levels for maintenance planning. Asset reliability management requires linking units to their spare parts catalogs for inventory opt"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:SparePartsCatalog ;
    cmm:physicalColumn "spare_parts_catalog_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Spare Parts Catalog Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_spare_parts_catalog_id" ;
    cmm:cimAssociation "GeneratingUnit.ErpItemMaster" .
cmm:GeneratingUnit.transmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Every generating unit physically interconnects to the grid at a specific transmission substation (point of interconnection). Critical for interconnection agreements, dispatch instructions, settlement"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Substation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_transmission_substation_id" ;
    cmm:cimAssociation "GeneratingUnit.Substation" .
cmm:GeneratingUnit.unitEnvironmentalPermit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "unit environmental permit"@en ;
    rdfs:comment "Foreign key linking to compliance.environmental_permit. Business justification: Individual units operate under specific air/water permits with unit-level emissions limits and CEMS monitoring requirements, distinct from plant-level permits. Required for permit condition tracking,"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:EnvironmentalPermit ;
    cmm:physicalColumn "unit_environmental_permit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Unit Environmental Permit Id (Foreign Key)" ;
    cmm:sourceColumn "environmental_permit_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_unit_environmental_permit_id" ;
    cmm:cimAssociation "GeneratingUnit.Document" .
cmm:GeneratingUnit.unitOperatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "unit operator employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Generating units have assigned certified operators per shift for control room operations, NERC CIP personnel accountability, and operational decision tracking. Critical for safety incidents, NERC GADS"@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "unit_operator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Unit Operator Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_generating_unit_unit_operator_employee_id" ;
    cmm:cimAssociation "GeneratingUnit.ErpPersonnel" .
cmm:GeneratingUnit.actualRetirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual retirement date"@en ;
    rdfs:comment "Actual date when the generating unit was permanently retired from service. Null if unit is still active."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Retirement Date" ;
    cmm:cimDatatype "Date" .
cmm:GeneratingUnit.ancillaryServicesCapableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ancillary services capable flag"@en ;
    rdfs:comment "Indicates whether the unit is capable of providing ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) to the grid."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ancillary_services_capable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ancillary Services Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GeneratingUnit.balancingAuthority a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "balancing authority"@en ;
    rdfs:comment "NERC-registered balancing authority area in which the generating unit operates. Determines scheduling and settlement rules."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "balancing_authority" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Balancing Authority" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.blackStartCapableFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "black start capable flag"@en ;
    rdfs:comment "Indicates whether the unit can start and energize the grid without external power supply, critical for system restoration after blackouts."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "black_start_capable_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Black Start Capable Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GeneratingUnit.capacityFactorDesignPct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity factor design pct"@en ;
    rdfs:comment "Design or expected capacity factor as a percentage, representing the ratio of actual output to maximum possible output over a period. Used for LCOE and IRP modeling."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_factor_design_pct" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Factor Design Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:GeneratingUnit.commercialOperationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commercial operation date"@en ;
    rdfs:comment "Date when the generating unit entered commercial service and began producing electricity for sale. Key milestone for asset lifecycle and depreciation."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:date ;
    cmm:physicalColumn "commercial_operation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commercial Operation Date (COD)" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:GeneratingUnit.dcsAssetTag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dcs asset tag"@en ;
    rdfs:comment "Asset tag or identifier in the ABB Ability Symphony Plus DCS system for real-time SCADA integration and plant control. Links to telemetry and control points."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "dcs_asset_tag" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Distributed Control System (DCS) Asset Tag" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.emissionsControlledFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions controlled flag"@en ;
    rdfs:comment "Indicates whether the unit is equipped with emissions control equipment (scrubbers, SCR, baghouse, etc.) to meet EPA standards."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "emissions_controlled_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Controlled Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GeneratingUnit.emissionsRateCo2LbPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate co2 lb per mwh"@en ;
    rdfs:comment "Carbon dioxide emissions rate in pounds per megawatt-hour (MWh) of electricity generated. Used for environmental compliance and carbon accounting."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_rate_co2_lb_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Rate Carbon Dioxide (CO2) Pounds per MWh" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GeneratingUnit.emissionsRateNoxLbPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate nox lb per mwh"@en ;
    rdfs:comment "Nitrogen oxides emissions rate in pounds per megawatt-hour. Used for air quality compliance and NOx budget trading programs."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_rate_nox_lb_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Rate Nitrogen Oxides (NOx) Pounds per MWh" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GeneratingUnit.emissionsRateSo2LbPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate so2 lb per mwh"@en ;
    rdfs:comment "Sulfur dioxide emissions rate in pounds per megawatt-hour. Used for acid rain program compliance and SO2 allowance trading."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "emissions_rate_so2_lb_per_mwh" ;
    cmm:sqlDataType "DECIMAL(10,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Emissions Rate Sulfur Dioxide (SO2) Pounds per MWh" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GeneratingUnit.emsResourceCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ems resource code"@en ;
    rdfs:comment "Resource identifier in the Energy Management System used for unit commitment, economic dispatch, and real-time grid operations."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "ems_resource_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Energy Management System (EMS) Resource ID" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.fuelType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fuel type"@en ;
    rdfs:comment "Primary fuel or energy source used by the generating unit for power production. Reference-value candidates: natural_gas|coal|nuclear|water|wind|solar|biomass|diesel|geothermal|mixed."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "fuel_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fuel Type" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.geographicLatitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic latitude"@en ;
    rdfs:comment "Latitude coordinate of the generating unit location in decimal degrees. Used for GIS mapping and spatial analysis."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "geographic_latitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Latitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.yPosition .
cmm:GeneratingUnit.geographicLongitude a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "geographic longitude"@en ;
    rdfs:comment "Longitude coordinate of the generating unit location in decimal degrees. Used for GIS mapping and spatial analysis."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "geographic_longitude" ;
    cmm:sqlDataType "DECIMAL(10,7)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Geographic Longitude" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "Decimal" ;
    cmm:cimExactMatch cim:PositionPoint.xPosition .
cmm:GeneratingUnit.heatRateDesignBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate design btu per kwh"@en ;
    rdfs:comment "Design-point heat rate of the unit in British Thermal Units (BTU) per kilowatt-hour (kWh), representing thermal efficiency. Lower values indicate higher efficiency. Used for LCOE analysis and fuel cost forecasting."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_rate_design_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Rate Design Point (BTU per kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GeneratingUnit.heatRateFullLoadBtuPerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "heat rate full load btu per kwh"@en ;
    rdfs:comment "Heat rate at full load operating conditions in BTU per kWh. Used for economic dispatch and fuel consumption modeling."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "heat_rate_full_load_btu_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Heat Rate Full Load (BTU per kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GeneratingUnit.isoRtoMarket a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "iso rto market"@en ;
    rdfs:comment "ISO or RTO market in which the unit participates for energy and ancillary services trading. Reference-value candidates: caiso|ercot|isone|miso|nyiso|pjm|spp|non_iso."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "iso_rto_market" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Independent System Operator (ISO) / Regional Transmission Organization (RTO) Market" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.minimumDownTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum down time hours"@en ;
    rdfs:comment "Minimum time in hours the unit must remain offline after shutdown before it can be restarted. Constraint for unit commitment."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_down_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Down Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:GeneratingUnit.minimumRunTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum run time hours"@en ;
    rdfs:comment "Minimum time in hours the unit must remain online once started. Constraint for unit commitment and dispatch."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_run_time_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Run Time (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:GeneratingUnit.minimumStableLoadMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum stable load mw"@en ;
    rdfs:comment "Minimum electrical output in megawatts (MW) at which the unit can operate continuously without shutdown. Critical for unit commitment and dispatch optimization."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_stable_load_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Stable Load (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GeneratingUnit.nameplateCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nameplate capacity mw"@en ;
    rdfs:comment "Maximum rated electrical output capacity of the generating unit in megawatts (MW) under ideal conditions. Principal quantitative fact about the resource."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nameplate_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Nameplate Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" ;
    cmm:cimCloseMatch cim:GeneratingUnit.ratedNetMaxP .
cmm:GeneratingUnit.nercUnitCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc unit code"@en ;
    rdfs:comment "NERC-assigned unique identifier for the generating unit, required for reliability reporting and compliance."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_unit_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Unit Code" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.netCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "net capacity mw"@en ;
    rdfs:comment "Net electrical output capacity in megawatts (MW) after accounting for auxiliary loads and station service consumption."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "net_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Net Capacity (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" ;
    cmm:cimCloseMatch cim:GeneratingUnit.ratedNetMaxP .
cmm:GeneratingUnit.operationalStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational status"@en ;
    rdfs:comment "Current operational state of the generating unit in its lifecycle. Determines availability for dispatch and capacity planning."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Operational Status" ;
    cmm:validValues "in_service|out_of_service|standby|mothballed|under_construction|retired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GeneratingUnit.status .
cmm:GeneratingUnit.operatorEntity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operator entity"@en ;
    rdfs:comment "Entity responsible for day-to-day operations and maintenance of the generating unit. May differ from owner in PPA or tolling arrangements."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "operator_entity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operator Entity" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.ownerEntity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "owner entity"@en ;
    rdfs:comment "Legal entity or business unit that owns the generating unit. Used for financial reporting and regulatory filings."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "owner_entity" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Owner Entity" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.plannedRetirementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "planned retirement date"@en ;
    rdfs:comment "Scheduled date for permanent retirement or decommissioning of the generating unit. Used for long-term capacity planning and IRP."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:date ;
    cmm:physicalColumn "planned_retirement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Planned Retirement Date" ;
    cmm:cimDatatype "Date" .
cmm:GeneratingUnit.pnodeCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pnode code"@en ;
    rdfs:comment "ISO/RTO pricing node identifier where the generating unit is interconnected to the transmission grid. Used for LMP settlement and energy trading."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "pnode_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Pricing Node (PNode) ID" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.rampRateDownMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate down mw per min"@en ;
    rdfs:comment "Maximum rate at which the unit can decrease electrical output, measured in megawatts per minute. Used for dispatch scheduling and grid balancing."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_down_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Down (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:GeneratingUnit.rampRateUpMwPerMin a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ramp rate up mw per min"@en ;
    rdfs:comment "Maximum rate at which the unit can increase electrical output, measured in megawatts per minute. Used for dispatch scheduling and grid balancing."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "ramp_rate_up_mw_per_min" ;
    cmm:sqlDataType "DECIMAL(8,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Ramp Rate Up (MW per Minute)" ;
    cmm:unitSymbol "W/min" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePowerChangeRate" .
cmm:GeneratingUnit.recEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec eligible flag"@en ;
    rdfs:comment "Indicates whether the unit is eligible to generate Renewable Energy Certificates for compliance and trading."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GeneratingUnit.recordCreatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record created timestamp"@en ;
    rdfs:comment "Timestamp when this generating unit record was first created in the system. Audit trail for data lineage."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GeneratingUnit.recordUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record updated timestamp"@en ;
    rdfs:comment "Timestamp when this generating unit record was last modified. Audit trail for change tracking."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "record_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Updated Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:GeneratingUnit.regulatoryClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory classification"@en ;
    rdfs:comment "Regulatory classification of the generating unit under FERC and state PUC rules. Determines rate treatment and market participation rules."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Classification" ;
    cmm:validValues "rate_base|merchant|qualifying_facility|exempt_wholesale_generator|independent_power_producer" ;
    cmm:cimDatatype "String" .
cmm:GeneratingUnit.renewableEnergyFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "renewable energy flag"@en ;
    rdfs:comment "Indicates whether the unit qualifies as a renewable energy resource under state RPS and federal standards."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "renewable_energy_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GeneratingUnit.startupTimeColdHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup time cold hours"@en ;
    rdfs:comment "Time in hours required to bring the unit from cold shutdown to minimum stable load. Used for unit commitment optimization."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_time_cold_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Time Cold (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:GeneratingUnit.startupTimeHotHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "startup time hot hours"@en ;
    rdfs:comment "Time in hours required to bring the unit from hot shutdown to minimum stable load. Used for unit commitment optimization."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "startup_time_hot_hours" ;
    cmm:sqlDataType "DECIMAL(6,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Startup Time Hot (Hours)" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:GeneratingUnit.unitCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit code"@en ;
    rdfs:comment "Externally-known unique code for the generating unit, used across operational systems and regulatory filings. Business identifier for the resource."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit Code" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GeneratingUnit.unitName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit name"@en ;
    rdfs:comment "Human-readable name or designation of the generating unit (e.g., 'Turbine 3A', 'Solar Array East', 'CCGT Unit 1'). Identity label for the resource."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Unit Name" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.name .
cmm:GeneratingUnit.unitType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unit type"@en ;
    rdfs:comment "Classification of the generating unit by technology type. Categorical field that segments the generation fleet. Reference-value candidates: ccgt|coal|nuclear|hydro|wind|solar|biomass|gas_turbine|steam_turbine|diesel|geothermal."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:string ;
    cmm:physicalColumn "unit_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Unit Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:GeneratingUnit.kind .
cmm:GeneratingUnit.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Nominal voltage level in kilovolts (kV) at which the unit interconnects to the grid."@en ;
    rdfs:domain cmm:GeneratingUnit ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(8,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:PowerPlant a owl:Class ;
    rdfs:label "Power Plant"@en ;
    rdfs:comment "Master record for each physical generation facility (plant/station) that may contain one or more generating units. Captures plant name, NERC plant code, EIA plant ID, geographic coordinates, ISO/RTO balancing authority, state/jurisdiction, fuel mix classification, total installed capacity (MW), interconnection voltage level, environmental permit IDs, and operational status. Parent entity for generating_unit records."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Plant ;
    cmm:cimCloseMatch cim:Plant ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:generation , cmmsa:generation.generation_assets ;
    cmm:physicalTable "utility_cmm_silver.generation.power_plant" ;
    cmm:dataClassification "master_data" ;
    cmm:cimLocationRole "PowerSystemResource.Location" ;
    cmm:standardReference "EIA-860; EIA Form 860 Plant Registry / NERC GADS Plant" ;
    cmm:sourceObject "energy_utilities_ecm.generation.power_plant" ;
    owl:hasKey ( cmm:PowerPlant.powerPlantId ) .

cmm:PowerPlant.powerPlantId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "power plant id"@en ;
    rdfs:comment "Unique identifier for the power generation facility. Primary key for the power plant master record."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:long ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Power Plant Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:PowerPlant.book a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "book"@en ;
    rdfs:comment "Foreign key linking to trading.trading_book. Business justification: Power plants (aggregated units) are assigned to trading books for portfolio-level P&L attribution, risk limits, and regulatory reporting. Standard practice in utility trading operations."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:TradingBook ;
    cmm:physicalColumn "book_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Trading Book Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_book_id" ;
    cmm:cimAssociation "Plant.Document" .
cmm:PowerPlant.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Multi-unit plants are modeled as contingency elements (loss of entire plant). Required for NERC TPL standards and worst-case contingency analysis."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_contingency_id" ;
    cmm:cimAssociation "Plant.Contingency" .
cmm:PowerPlant.controlArea a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "control area"@en ;
    rdfs:comment "Foreign key linking to grid.control_area. Business justification: Power plants operate within a balancing authority/control area for scheduling, ACE accounting, and reserve obligations. Essential for interchange scheduling and CPS compliance reporting."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:ControlArea ;
    cmm:physicalColumn "control_area_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Control Area Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_control_area_id" ;
    cmm:cimAssociation "Plant.ControlArea" .
cmm:PowerPlant.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Plants are primary cost centers for aggregated O&M, fuel, and labor costs. Required for budget vs actual reporting and FERC Form 1 preparation."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_cost_center_id" ;
    cmm:cimAssociation "Plant.Organisation" .
cmm:PowerPlant.emsNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ems node"@en ;
    rdfs:comment "Foreign key linking to grid.ems_node. Business justification: Power plants connect at substation/node level for aggregate injection modeling. Required for EMS network topology and voltage control."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:EmsNode ;
    cmm:physicalColumn "ems_node_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ems Node Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_ems_node_id" ;
    cmm:cimAssociation "Plant.TopologicalNode" .
cmm:PowerPlant.forecastZone a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "forecast zone"@en ;
    rdfs:comment "Foreign key linking to forecast.zone. Business justification: Power plants are assigned to forecast zones for load planning, generation forecasting, and market operations. Zone assignment drives capacity adequacy assessments and transmission planning. Essential"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:ForecastZone ;
    cmm:physicalColumn "forecast_zone_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Zone Id (Foreign Key)" ;
    cmm:sourceColumn "zone_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_forecast_zone_id" ;
    cmm:cimAssociation "Plant.LoadArea" .
cmm:PowerPlant.gridTopologySnapshot a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grid topology snapshot"@en ;
    rdfs:comment "Foreign key linking to grid.topology_snapshot. Business justification: Plant topology (bus configuration, breaker status) is captured in EMS snapshots. Required for state estimation and switching order validation."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:TopologySnapshot ;
    cmm:physicalColumn "grid_topology_snapshot_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grid Topology Snapshot Id (Foreign Key)" ;
    cmm:sourceColumn "topology_snapshot_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_grid_topology_snapshot_id" ;
    cmm:cimAssociation "Plant.TopologicalIsland" .
cmm:PowerPlant.operatingLimit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operating limit"@en ;
    rdfs:comment "Foreign key linking to grid.operating_limit. Business justification: Power plants have aggregate operating limits for multi-unit dispatch. Required for plant-level economic dispatch and reserve allocation."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:OperatingLimit ;
    cmm:physicalColumn "operating_limit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Operating Limit Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_operating_limit_id" ;
    cmm:cimAssociation "Plant.OperationalLimit" .
cmm:PowerPlant.plantManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "plant manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Power plants require designated plant managers for operational oversight, safety compliance, regulatory reporting (NERC, EPA), and personnel management. Essential for organizational accountability and"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "plant_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Plant Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_plant_manager_employee_id" ;
    cmm:cimAssociation "Plant.ErpPersonnel" .
cmm:PowerPlant.pmuDevice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pmu device"@en ;
    rdfs:comment "Foreign key linking to grid.pmu_device. Business justification: Plant-level PMUs monitor common bus and aggregate generation. Required for WAMS and inter-area oscillation monitoring."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:PmuDevice ;
    cmm:physicalColumn "pmu_device_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Pmu Device Id (Foreign Key)" ;
    cmm:sensitivity "internal" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_pmu_device_id" ;
    cmm:cimAssociation "Plant.RemoteUnit" .
cmm:PowerPlant.poiTransmissionSubstation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "poi transmission substation"@en ;
    rdfs:comment "Foreign key linking to transmission.transmission_substation. Business justification: Power plants connect to transmission grid at a point of interconnection (POI) substation. Essential for interconnection studies, FERC generator interconnection agreements, transmission service request"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:TransmissionSubstation ;
    cmm:physicalColumn "poi_transmission_substation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Poi Transmission Substation Id (Foreign Key)" ;
    cmm:sourceColumn "transmission_substation_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_poi_transmission_substation_id" ;
    cmm:cimAssociation "Plant.Substation" .
cmm:PowerPlant.primaryWarehouse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary warehouse"@en ;
    rdfs:comment "Foreign key linking to supply.warehouse. Business justification: Plants receive materials from designated warehouses for operations and maintenance. Physical supply chain requires tracking which warehouse serves each plant for inventory planning, emergency restorat"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:Warehouse ;
    cmm:physicalColumn "primary_warehouse_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Primary Warehouse Id (Foreign Key)" ;
    cmm:sourceColumn "warehouse_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_primary_warehouse_id" ;
    cmm:cimAssociation "Plant.WorkLocation" .
cmm:PowerPlant.profitCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "profit center"@en ;
    rdfs:comment "Foreign key linking to finance.profit_center. Business justification: Plants are profit centers for consolidated financial performance tracking, executive dashboards, and regulatory ROE calculations. Standard in utility financial structures."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:ProfitCenter ;
    cmm:physicalColumn "profit_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Profit Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_profit_center_id" ;
    cmm:cimAssociation "Plant.Organisation" .
cmm:PowerPlant.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Foreign key linking to asset.asset_registry. Business justification: Power plants are major capital assets requiring asset registry tracking for regulatory rate base inclusion, depreciation schedules, insurance valuation, capital project planning, and PUC prudency revi"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Asset Registry Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_registry_id" ;
    cmm:cimAssociation "Plant.Asset" .
cmm:PowerPlant.renewablePpaContract a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable ppa contract"@en ;
    rdfs:comment "Foreign key linking to renewable.ppa_contract. Business justification: Renewable power plants operate under PPAs defining energy pricing, capacity payments, REC ownership, and delivery obligations. Finance and settlements teams require this link for revenue recognition,"@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range cmm:PpaContract ;
    cmm:physicalColumn "renewable_ppa_contract_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Ppa Contract Id (Foreign Key)" ;
    cmm:sourceColumn "ppa_contract_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_generation_power_plant_renewable_ppa_contract_id" ;
    cmm:cimAssociation "Plant.Agreement" .
cmm:PowerPlant.addressLine1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line 1"@en ;
    rdfs:comment "Primary street address of the generation facility including street number and name."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line_1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Street Address Line 1" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:PowerPlant.addressLine2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line 2"@en ;
    rdfs:comment "Secondary address information such as building, suite, or unit number."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line_2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Street Address Line 2" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:PowerPlant.annualGenerationGwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual generation gwh"@en ;
    rdfs:comment "Total electricity generation in the most recent calendar year, measured in gigawatt-hours (GWh)."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_generation_gwh" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Generation (Gigawatt-Hours)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "G" ;
    cmm:cimDatatype "RealEnergy" .
cmm:PowerPlant.capacityFactorPercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "capacity factor percent"@en ;
    rdfs:comment "Historical average capacity factor representing actual generation as a percentage of maximum potential generation."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "capacity_factor_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Capacity Factor (Percent)" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:PowerPlant.city a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "city"@en ;
    rdfs:comment "City or municipality where the generation facility is located."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
    cmm:physicalColumn "city" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "City" ;
    cmm:cimDatatype "String" ;
    cmm:cimExactMatch cim:TownDetail.name .
cmm:PowerPlant.commercialOperationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "commercial operation date"@en ;
    rdfs:comment "Date when the generation facility first entered commercial service and began delivering power to the grid."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:date ;
    cmm:physicalColumn "commercial_operation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Commercial Operation Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:InUseDate.inUseDate .
cmm:PowerPlant.countryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "country code"@en ;
    rdfs:comment "Three-letter ISO country code where the generation facility is located."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:string ;
