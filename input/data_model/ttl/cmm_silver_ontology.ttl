cmm:AuditScope a owl:Class ;
    rdfs:label "Audit Scope"@en ;
    rdfs:comment "This association product represents the scoping relationship between organizational units and compliance audits. It captures which organizational units are included in each audit's scope, along with audit-specific metrics for that unit including findings count, audit effort hours, and the specific scope description for that unit. Each record links one org_unit to one audit with attributes that exist only in the context of this scoping relationship.. Existence Justification: In energy utility compliance operations, audits routinely scope multiple organizational units (e.g., a NERC CIP audit may cover Generation, Transmission, and Distribution units), and each organizational unit undergoes multiple audits annually from different regulatory bodies (NERC, FERC, PUC, EPA, SOX). The scoping relationship is actively managed by audit coordinators who track findings, audit hours, and scope descriptions specific to each org_unit-audit combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.audit_scope" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.audit_scope" ;
    owl:hasKey ( cmm:AuditScope.auditScopeId ) .

cmm:AuditScope.auditScopeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit scope id"@en ;
    rdfs:comment "Unique identifier for this audit scope assignment record. Primary key."@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:long ;
    cmm:physicalColumn "audit_scope_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Audit Scope Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:AuditScope.audit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit"@en ;
    rdfs:comment "Foreign key to compliance.audit identifying the audit that includes this organizational unit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range cmm:ComplianceAudit ;
    cmm:physicalColumn "audit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_audit_scope_audit_id" ;
    cmm:cimAssociation "IdentifiedObject.ActivityRecord" .
cmm:AuditScope.orgUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "org unit"@en ;
    rdfs:comment "Foreign key to workforce.org_unit identifying the organizational unit in scope for this audit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range cmm:OrgUnit ;
    cmm:physicalColumn "org_unit_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Organizational Unit Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_audit_scope_org_unit_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:AuditScope.unitCoordinatorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "unit coordinator employee"@en ;
    rdfs:comment "Employee identifier of the person from this organizational unit responsible for coordinating audit activities and evidence submission for their unit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "unit_coordinator_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Unit Audit Coordinator" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_audit_scope_unit_coordinator_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:AuditScope.auditHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "audit hours"@en ;
    rdfs:comment "Total audit effort hours spent by auditors examining this organizational unit during this audit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "audit_hours" ;
    cmm:sqlDataType "DECIMAL(10,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Audit Hours" ;
    cmm:unitSymbol "h" ;
    cmm:cimDatatype "Hours" .
cmm:AuditScope.endDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "end date"@en ;
    rdfs:comment "Date when audit activities concluded for this specific organizational unit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Audit End Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:AuditScope.findingsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "findings count"@en ;
    rdfs:comment "Number of audit findings or violations identified specifically for this organizational unit within this audit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:int ;
    cmm:physicalColumn "findings_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Findings Count" ;
    cmm:cimDatatype "Integer" .
cmm:AuditScope.scopeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scope description"@en ;
    rdfs:comment "Detailed description of what aspects of this organizational unit are included in the audit scope (e.g., NERC CIP controls for transmission operations, SOX financial controls for accounting department)"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "scope_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Scope Description" ;
    cmm:cimDatatype "String" ;
    rdfs:subPropertyOf cim:IdentifiedObject.description .
cmm:AuditScope.scopeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "scope status"@en ;
    rdfs:comment "Current status of audit activities for this organizational unit within the overall audit lifecycle"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:string ;
    cmm:physicalColumn "scope_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Scope Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:AuditScope.startDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "start date"@en ;
    rdfs:comment "Date when audit activities commenced for this specific organizational unit"@en ;
    rdfs:domain cmm:AuditScope ; rdfs:range xsd:date ;
    cmm:physicalColumn "start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Audit Start Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.start .

cmm:ComplianceViolation a owl:Class ;
