cmm:SparePartsInventory.materialStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material status"@en ;
    rdfs:comment "Current lifecycle status of the material master record. Active materials are available for procurement and issue, inactive materials are temporarily blocked, obsolete materials are phased out, pending approval materials are under review, and discontinued materials are no longer supported by the manufacturer."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Material Status" ;
    cmm:validValues "active|inactive|obsolete|pending_approval|discontinued" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.materialType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "material type"@en ;
    rdfs:comment "Classification of the inventory item by usage category. Spare parts are replaceable components for assets, consumables are items used up during maintenance, critical spares are high-value low-turnover items essential for emergency restoration, tools are reusable equipment, safety equipment includes PPE and protective gear, and bulk materials are commodities purchased in volume."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "material_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Material Type" ;
    cmm:validValues "spare_part|consumable|critical_spare|tool|safety_equipment|bulk_material" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.maximumStockLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maximum stock level"@en ;
    rdfs:comment "Maximum inventory quantity threshold to avoid overstocking and excess capital tied up in inventory. Used for inventory optimization and storage capacity planning."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "maximum_stock_level" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maximum Stock Level" ;
    cmm:cimDatatype "Decimal" .
cmm:SparePartsInventory.minimumStockLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum stock level"@en ;
    rdfs:comment "Minimum inventory quantity threshold below which replenishment should be triggered. Set based on lead time, usage rate, and criticality to ensure availability for planned and emergency maintenance."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "minimum_stock_level" ;
    cmm:sqlDataType "DECIMAL(15,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Minimum Stock Level" ;
    cmm:cimDatatype "Decimal" .
cmm:SparePartsInventory.obsoleteFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "obsolete flag"@en ;
    rdfs:comment "Indicates whether the material has been marked as obsolete and should no longer be procured or issued. True if obsolete, False if active. Obsolete materials may still have on-hand inventory for legacy asset support."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "obsolete_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Obsolete Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SparePartsInventory.plantCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "plant code"@en ;
    rdfs:comment "Identifier for the organizational plant or business unit to which this inventory record belongs. Used for multi-site inventory management and cost allocation across generation, transmission, and distribution operations."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "plant_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Plant Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,6}$" ;
    cmm:cimDatatype "String" .
cmm:SparePartsInventory.preferredSupplierCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preferred supplier code"@en ;
    rdfs:comment "Identifier for the preferred or primary supplier from whom this material should be procured. Links to vendor master data in the enterprise resource planning system."@en ;
    rdfs:domain cmm:SparePartsInventory ; rdfs:range xsd:string ;
    cmm:physicalColumn "preferred_supplier_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
