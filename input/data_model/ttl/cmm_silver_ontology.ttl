cmm:CustomerInvoice.invoiceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "invoice status"@en ;
    rdfs:comment "Current lifecycle status of the invoice in the billing and collections workflow. Reference-value candidates: draft|issued|sent|paid|partially_paid|overdue|cancelled|disputed|adjusted|written_off."@en ;
