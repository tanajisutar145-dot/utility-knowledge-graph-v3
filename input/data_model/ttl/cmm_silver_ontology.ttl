cmm:PowerPlant.totalInstalledCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total installed capacity mw"@en ;
    rdfs:comment "Aggregate nameplate generation capacity across all generating units at the facility, measured in megawatts (MW)."@en ;
    rdfs:domain cmm:PowerPlant ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_installed_capacity_mw" ;
