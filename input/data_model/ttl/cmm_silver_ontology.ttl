    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Control Effectiveness Rating" ;
    cmm:validValues "effective|needs_improvement|ineffective|not_assessed" ;
    cmm:cimDatatype "String" .
cmm:ComplianceObligation.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
