cmm:PositionPoint a owl:Class ;
    rdfs:label "Position Point"@en ;
    rdfs:comment "CIM PositionPoint: ordered set of coordinates (vertices) of a Location's geometry, expressed in the Location's CoordinateSystem. groupNumber separates parts of multi-part geometries / polygon rings."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PositionPoint ;
    cmm:cimExactMatch cim:PositionPoint ;
    cmm:cimMappingLevel "exact" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.position_point" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "IEC 61968-11 Common; OGC GeoSPARQL 1.1; ISO 19125; ISO 19111 (EPSG)" ;
    owl:hasKey ( cmm:PositionPoint.positionPointId ) .

cmm:PositionPoint.positionPointId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position point id"@en ;
    rdfs:comment "Surrogate primary key of PositionPoint."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:long ;
    cmm:physicalColumn "position_point_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "PositionPoint Id" ;
    cmm:cimDatatype "Integer" .
cmm:PositionPoint.location a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Owning location."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range cmm:GisLocation ;
    cmm:physicalColumn "location_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Location Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_gis_position_point_location_id" ;
    cmm:cimAssociation "PositionPoint.Location" .
cmm:PositionPoint.sequenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sequence number"@en ;
    rdfs:comment "Zero-or-one based ordinal of the vertex within the group."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:int ;
    cmm:physicalColumn "sequence_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Sequence Number" ;
    cmm:cimDatatype "Integer" ;
    rdfs:subPropertyOf cim:PositionPoint.sequenceNumber .
cmm:PositionPoint.groupNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "group number"@en ;
    rdfs:comment "Part / ring number for multi-part geometries."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:int ;
    cmm:physicalColumn "group_number" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Group Number" ;
    cmm:cimDatatype "Integer" ;
    rdfs:subPropertyOf cim:PositionPoint.groupNumber .
cmm:PositionPoint.xPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "x position"@en ;
    rdfs:comment "X axis position (longitude or easting)."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:double ;
    cmm:physicalColumn "x_position" ;
    cmm:sqlDataType "DOUBLE" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "X Position" ;
    cmm:cimDatatype "Float" ;
    rdfs:subPropertyOf cim:PositionPoint.xPosition .
cmm:PositionPoint.yPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "y position"@en ;
    rdfs:comment "Y axis position (latitude or northing)."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:double ;
    cmm:physicalColumn "y_position" ;
    cmm:sqlDataType "DOUBLE" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Y Position" ;
    cmm:cimDatatype "Float" ;
    rdfs:subPropertyOf cim:PositionPoint.yPosition .
cmm:PositionPoint.zPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "z position"@en ;
    rdfs:comment "Z axis position (elevation)."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:double ;
    cmm:physicalColumn "z_position" ;
    cmm:sqlDataType "DOUBLE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Z Position" ;
    cmm:cimDatatype "Float" ;
    rdfs:subPropertyOf cim:PositionPoint.zPosition .
cmm:PositionPoint.mValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "m value"@en ;
    rdfs:comment "Linear-referencing measure value at the vertex (ISO 19148)."@en ;
    rdfs:domain cmm:PositionPoint ; rdfs:range xsd:double ;
    cmm:physicalColumn "m_value" ;
    cmm:sqlDataType "DOUBLE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "M Value" ;
    cmm:cimDatatype "Float" .

cmm:LocationAssignment a owl:Class ;
    rdfs:label "Location Assignment"@en ;
    rdfs:comment "Polymorphic, time-variant association between any canonical entity and a CIM Location (implements PowerSystemResource.Location, Asset.Location, UsagePoint.UsagePointLocation, BaseWork.WorkLocation, Incident.Location). Supports relocations and multiple location roles."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:gis ;
    cmm:physicalTable "utility_cmm_silver.gis.location_assignment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "IEC 61968-11 Common; OGC GeoSPARQL 1.1; ISO 19125; ISO 19111 (EPSG)" ;
    owl:hasKey ( cmm:LocationAssignment.locationAssignmentId ) .

cmm:LocationAssignment.locationAssignmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "location assignment id"@en ;
    rdfs:comment "Surrogate primary key of LocationAssignment."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "location_assignment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "LocationAssignment Id" ;
    cmm:cimDatatype "Integer" .
cmm:LocationAssignment.location a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Assigned location."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range cmm:GisLocation ;
    cmm:physicalColumn "location_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Location Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_gis_location_assignment_location_id" .
cmm:LocationAssignment.entitySchema a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entity schema"@en ;
    rdfs:comment "Canonical schema of the located entity."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "entity_schema" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entity Schema" ;
    cmm:cimDatatype "String" .
cmm:LocationAssignment.entityTable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entity table"@en ;
    rdfs:comment "Canonical table of the located entity."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "entity_table" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entity Table" ;
    cmm:cimDatatype "String" .
cmm:LocationAssignment.entityId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entity id"@en ;
    rdfs:comment "Primary key value of the located entity."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:long ;
    cmm:physicalColumn "entity_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Entity Id" ;
    cmm:cimDatatype "Integer" .
cmm:LocationAssignment.entityMrid a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "entity mrid"@en ;
    rdfs:comment "mRID of the located entity."@en ;
    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "entity_mrid" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "exact" ;
    cmm:businessTerm "Entity Mrid" ;
