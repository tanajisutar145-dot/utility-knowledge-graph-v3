cmm:Crew.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for operational notes, special instructions, or crew-specific information (e.g., equipment limitations, training status, deployment restrictions)."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Crew Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:Crew.operationalReadinessStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "operational readiness status"@en ;
    rdfs:comment "Assessment of crew readiness for dispatch based on personnel availability, equipment status, certification currency, and safety compliance. Updated by crew lead and operations supervisor."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "operational_readiness_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Operational Readiness Status" ;
    cmm:validValues "ready|not_ready|partial_readiness|under_review" ;
    cmm:cimDatatype "String" .
cmm:Crew.oshaComplianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "osha compliance status"@en ;
    rdfs:comment "Current compliance status with OSHA safety training and certification requirements (1910.269 electric power generation, transmission, and distribution). Updated quarterly."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "osha_compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "OSHA (Occupational Safety and Health Administration) Compliance Status" ;
    cmm:validValues "compliant|non_compliant|pending_review" ;
    cmm:cimDatatype "String" .
cmm:Crew.primaryVehicleCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "primary vehicle code"@en ;
    rdfs:comment "Reference to the primary vehicle or truck assigned to the crew. Critical for dispatch routing, equipment tracking, and GPS-based crew location."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:long ;
    cmm:physicalColumn "primary_vehicle_code" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Primary Vehicle Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:Crew.reimbursableCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reimbursable cost amount"@en ;
    rdfs:comment "Total reimbursable cost for mutual aid deployment including labor, equipment, travel, and lodging. Used for invoicing requesting utility and FEMA reimbursement claims."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reimbursable_cost_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reimbursable Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:Crew.shiftSchedule a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shift schedule"@en ;
    rdfs:comment "Standard work shift assignment for the crew. Determines availability windows for dispatch and overtime calculation rules."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "shift_schedule" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Shift Schedule" ;
    cmm:validValues "day_shift|night_shift|rotating_shift|on_call|storm_duty" ;
    cmm:cimDatatype "String" .
cmm:Crew.size a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "size"@en ;
    rdfs:comment "Number of personnel assigned to the crew. Varies by crew type and work complexity (typically 2-8 for line crews, 3-5 for substation crews)."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:int ;
    cmm:physicalColumn "size" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Crew Size" ;
    cmm:cimDatatype "Integer" .
cmm:Crew.stormDutyRotation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "storm duty rotation"@en ;
    rdfs:comment "Assigned rotation group for storm duty and emergency response call-out. Determines crew availability during major events and ensures equitable distribution of overtime."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:string ;
    cmm:physicalColumn "storm_duty_rotation" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
