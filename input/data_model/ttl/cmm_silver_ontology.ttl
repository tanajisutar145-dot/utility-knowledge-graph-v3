cmm:TreasuryPosition a owl:Class ;
    rdfs:label "Treasury Position"@en ;
    rdfs:comment "Treasury operations master in SAP S/4HANA covering cash and debt position management, liquidity monitoring, and bank reconciliation. Position attributes: position date, instrument type (cash, short-term investment, credit facility, commercial paper, first mortgage bond, pollution control revenue bond, tax-exempt bond), outstanding balance, interest rate (fixed/variable), maturity date, credit rating, debt covenant compliance status, and debt service coverage ratio. Bank reconciliation attributes: reconciliation date, bank account, statement balance, GL balance, reconciling items (outstanding checks, deposits in transit, bank charges), variance amount, reconciliation status, and preparer/reviewer sign-off. Supports daily cash positioning, liquidity risk management, bond covenant monitoring, bank statement reconciliation, SOX control evidence for cash accounts, and FERC balance sheet reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.treasury_position" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "SAP S/4HANA TRM Treasury Position" ;
    cmm:sourceObject "energy_utilities_ecm.finance.treasury_position" ;
    owl:hasKey ( cmm:TreasuryPosition.treasuryPositionId ) .

cmm:TreasuryPosition.treasuryPositionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "treasury position id"@en ;
    rdfs:comment "Unique identifier for the treasury position record. Primary key for the treasury position entity."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:long ;
    cmm:physicalColumn "treasury_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Treasury Position ID" ;
    cmm:cimDatatype "Integer" .
cmm:TreasuryPosition.primaryGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary gl account"@en ;
    rdfs:comment "FK to finance.gl_account.gl_account_id — Treasury positions (cash, debt instruments) must reconcile to GL accounts. Each treasury instrument maps to a GL account for balance sheet reporting."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "primary_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:sourceColumn "gl_account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_treasury_position_primary_gl_account_id" ;
    cmm:cimAssociation "Document.ErpChartOfAccounts" .
cmm:TreasuryPosition.primaryTreasuryEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary treasury employee"@en ;
    rdfs:comment "The SAP user ID of the treasury analyst or accountant who prepared the bank reconciliation. Part of the SOX control evidence for segregation of duties."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_treasury_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_treasury_position_primary_treasury_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TreasuryPosition.reviewerUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer user employee"@en ;
    rdfs:comment "The SAP user ID of the supervisor or manager who reviewed and approved the bank reconciliation. Part of the SOX control evidence for segregation of duties."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "reviewer_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reviewer User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_treasury_position_reviewer_user_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:TreasuryPosition.toGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to gl account"@en ;
    rdfs:comment "FK to finance.gl_account.gl_account_id — Treasury positions (cash, debt instruments, bank reconciliation items) map to GL accounts for balance sheet reporting. This FK enables treasury-to-GL reconciliation and daily cash position verificatio"@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "to_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_treasury_position_to_gl_account_id" ;
    cmm:cimAssociation "Document.ErpChartOfAccounts" .
cmm:TreasuryPosition.treasuryGlAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "treasury gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Treasury positions (debt instruments, cash positions) are tracked in GL accounts. The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve account"@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "treasury_gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_treasury_position_treasury_gl_account_id" ;
    cmm:cimAssociation "Document.ErpChartOfAccounts" .
cmm:TreasuryPosition.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "The date on which the bank reconciliation was formally approved by the reviewer. Used to track timeliness of reconciliation approval for SOX compliance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:TreasuryPosition.bankAccountNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank account number"@en ;
    rdfs:comment "The bank account number associated with cash positions. Used for bank reconciliation and cash management. Confidential business information."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_account_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Bank Account Number" ;
    cmm:sensitivity "confidential" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TreasuryPosition.bankChargesAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank charges amount"@en ;
    rdfs:comment "The total amount of bank service charges, fees, and other deductions reflected on the bank statement but not yet recorded in the GL as of the reconciliation date."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bank_charges_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Charges Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.bankKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank key"@en ;
    rdfs:comment "The bank routing number or bank key used to identify the financial institution in SAP S/4HANA (e.g., ABA routing number in the US)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_key" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Key" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.bankName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank name"@en ;
    rdfs:comment "The name of the financial institution holding the cash account or providing the credit facility."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Name" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code representing the legal entity for which this treasury position is maintained. Links to the organizational structure in SAP S/4HANA."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:valuePattern "^[A-Z0-9]{4}$" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.covenantComplianceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "covenant compliance status"@en ;
    rdfs:comment "Indicates whether the utility is in compliance with all financial covenants associated with the debt instrument. Non-compliance may trigger default provisions or require remediation."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "covenant_compliance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Covenant Compliance Status" ;
    cmm:validValues "compliant|non_compliant|waived|not_applicable" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.covenantDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "covenant description"@en ;
    rdfs:comment "Textual description of the key financial covenants associated with the debt instrument (e.g., minimum debt service coverage ratio, maximum leverage ratio, minimum equity requirements)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "covenant_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Covenant Description" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "The date and time when this treasury position record was first created in the system. Audit trail field for data lineage and SOX compliance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:TreasuryPosition.creditRating a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "credit rating"@en ;
    rdfs:comment "The current credit rating assigned to the debt instrument by a recognized rating agency (e.g., Moody's, S&P, Fitch). Format examples: AAA, AA+, BBB-, etc."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "credit_rating" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Credit Rating" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the outstanding balance and related monetary amounts."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:TreasuryPosition.debtServiceCoverageRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "debt service coverage ratio"@en ;
    rdfs:comment "The ratio of cash available for debt servicing to interest, principal, and lease payments. Calculated as operating income divided by total debt service. A key covenant metric for utility debt instruments."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "debt_service_coverage_ratio" ;
    cmm:sqlDataType "DECIMAL(7,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Debt Service Coverage Ratio (DSCR)" ;
    cmm:cimDatatype "Decimal" .
cmm:TreasuryPosition.depositsInTransitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposits in transit amount"@en ;
    rdfs:comment "The total amount of deposits recorded in the GL that have not yet been reflected in the bank statement as of the reconciliation date."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposits_in_transit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposits in Transit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "The FERC Uniform System of Accounts code applicable to this treasury position for regulatory financial reporting (e.g., Account 131 for Cash, Account 221 for Bonds)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.glBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl balance"@en ;
    rdfs:comment "The balance recorded in the general ledger for the cash account as of the reconciliation date. Used in the bank reconciliation process to identify discrepancies with the bank statement balance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gl_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.instrumentNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "instrument number"@en ;
    rdfs:comment "Unique identifier or reference number for the specific financial instrument (e.g., bond CUSIP, loan agreement number, credit facility ID)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "instrument_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Instrument Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:TreasuryPosition.instrumentType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "instrument type"@en ;
    rdfs:comment "Classification of the financial instrument held in the treasury position. Includes cash, short-term investments, credit facilities, commercial paper, first mortgage bonds, pollution control revenue bonds, tax-exempt bonds, and other debt instruments. Reference-value candidates: cash|short_term_investment|credit_facility|commercial_paper|first_mortgage_bond|pollution_control_revenue_bond|tax_exempt_bond|revolving_credit|term_loan."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "instrument_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Instrument Type" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.interestRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest rate"@en ;
    rdfs:comment "The current interest rate applicable to the instrument, expressed as a decimal percentage (e.g., 0.0525 for 5.25%). For debt instruments, this is the coupon or borrowing rate; for investments, this is the yield."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "interest_rate" ;
    cmm:sqlDataType "DECIMAL(7,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:TreasuryPosition.interestRateIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest rate index"@en ;
    rdfs:comment "The benchmark index used for variable or floating rate instruments (e.g., SOFR, LIBOR, Prime Rate). Null for fixed-rate instruments."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "interest_rate_index" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Rate Index" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.interestRateType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "interest rate type"@en ;
    rdfs:comment "Classification of the interest rate structure: fixed (constant rate), variable (adjusts periodically based on index), floating (market-based adjustment), or zero coupon (no periodic interest payments)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "interest_rate_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Interest Rate Type" ;
    cmm:validValues "fixed|variable|floating|zero_coupon" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.issueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "issue date"@en ;
    rdfs:comment "The date on which the debt instrument was originally issued or the investment was initiated."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "issue_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Issue Date" ;
    cmm:cimDatatype "Date" .
cmm:TreasuryPosition.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "The date and time when this treasury position record was most recently updated. Audit trail field for data lineage and SOX compliance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:TreasuryPosition.liquidityClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "liquidity classification"@en ;
    rdfs:comment "Classification of the instrument based on its liquidity profile: immediate (cash and cash equivalents available on demand), short-term (maturities within one year), or long-term (maturities beyond one year)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "liquidity_classification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Liquidity Classification" ;
    cmm:validValues "immediate|short_term|long_term" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.maturityDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "maturity date"@en ;
    rdfs:comment "The date on which the principal amount of the debt instrument is due for repayment, or the date when the investment matures. Null for perpetual instruments or demand deposits."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "maturity_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Maturity Date" ;
    cmm:cimDatatype "Date" .
cmm:TreasuryPosition.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional comments, explanations, or context related to the treasury position, reconciliation variances, or covenant compliance issues."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:TreasuryPosition.outstandingBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding balance"@en ;
    rdfs:comment "The current outstanding principal balance or cash position for the instrument as of the position date. Positive values represent assets (cash, investments); negative values may represent overdrafts or liabilities."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outstanding Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.outstandingChecksAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding checks amount"@en ;
    rdfs:comment "The total amount of checks issued by the utility that have been recorded in the GL but have not yet cleared the bank as of the reconciliation date."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_checks_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outstanding Checks Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.positionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position date"@en ;
    rdfs:comment "The business date for which this treasury position snapshot is recorded. Represents the as-of date for cash and debt balances."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "position_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Position Date" ;
    cmm:cimDatatype "Date" .
cmm:TreasuryPosition.positionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "position status"@en ;
    rdfs:comment "The current lifecycle status of the treasury position: active (currently held), matured (reached maturity date), closed (position liquidated or paid off), or suspended (temporarily inactive)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "position_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Position Status" ;
    cmm:validValues "active|matured|closed|suspended" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:TreasuryPosition.preparerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preparer name"@en ;
    rdfs:comment "The full name of the treasury analyst or accountant who prepared the bank reconciliation."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "preparer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preparer Name" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.ratingAgency a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rating agency"@en ;
    rdfs:comment "The name of the credit rating agency that assigned the credit rating (e.g., Moody's Investors Service, Standard & Poor's, Fitch Ratings)."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "rating_agency" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Rating Agency" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.reconciliationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation date"@en ;
    rdfs:comment "The date on which the most recent bank reconciliation was performed for this cash position. Used to track the timeliness of reconciliation activities for SOX compliance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:date ;
    cmm:physicalColumn "reconciliation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Date" ;
    cmm:cimDatatype "Date" .
cmm:TreasuryPosition.reconciliationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation status"@en ;
    rdfs:comment "The current status of the bank reconciliation process for this cash position. Tracks the workflow from initial reconciliation through review and approval for SOX compliance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "reconciliation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Status" ;
    cmm:validValues "reconciled|pending|variance_under_review|approved" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.reconcilingItemsAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciling items amount"@en ;
    rdfs:comment "The total amount of reconciling items identified during the bank reconciliation process (e.g., outstanding checks, deposits in transit, bank charges, errors). Sum of all reconciling adjustments."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "reconciling_items_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciling Items Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.reviewerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer name"@en ;
    rdfs:comment "The full name of the supervisor or manager who reviewed and approved the bank reconciliation."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:string ;
    cmm:physicalColumn "reviewer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reviewer Name" ;
    cmm:cimDatatype "String" .
cmm:TreasuryPosition.soxControlFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control flag"@en ;
    rdfs:comment "Boolean indicator (True/False) denoting whether this treasury position is subject to SOX internal control requirements. True for material cash accounts and debt instruments requiring enhanced reconciliation and approval controls."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TreasuryPosition.statementBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statement balance"@en ;
    rdfs:comment "The balance reported on the bank statement as of the reconciliation date. Used in the bank reconciliation process to identify discrepancies with the GL balance."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "statement_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Statement Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:TreasuryPosition.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "The net difference between the statement balance and the GL balance after accounting for all known reconciling items. A non-zero variance indicates unresolved discrepancies requiring investigation."@en ;
    rdfs:domain cmm:TreasuryPosition ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:BankReconciliation a owl:Class ;
    rdfs:label "Bank Reconciliation"@en ;
    rdfs:comment "Bank reconciliation record matching SAP S/4HANA FI bank statement line items to GL postings and payment clearing documents. Captures reconciliation date, bank account, statement balance, GL balance, reconciling items (outstanding checks, deposits in transit, bank charges), variance amount, reconciliation status, and preparer/reviewer sign-off. Supports daily cash position verification, SOX control evidence for cash accounts, and treasury audit trail."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:ActivityRecord ;
    cmm:cimExtends cim:ActivityRecord ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.revenue_operations ;
    cmm:physicalTable "utility_cmm_silver.finance.bank_reconciliation" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.finance.bank_reconciliation" ;
    owl:hasKey ( cmm:BankReconciliation.bankReconciliationId ) .

cmm:BankReconciliation.bankReconciliationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank reconciliation id"@en ;
    rdfs:comment "Unique identifier for the bank reconciliation record. Primary key for the bank reconciliation entity."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:long ;
    cmm:physicalColumn "bank_reconciliation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Bank Reconciliation ID" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.approverUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approver user employee"@en ;
    rdfs:comment "System user ID of the person who approved the bank reconciliation. Final sign-off authority per SOX control framework."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approver_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approver User ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_approver_user_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:BankReconciliation.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Bank reconciliations reconcile bank accounts to GL accounts (cash accounts). The gl_account_code (STRING) should be replaced with FK to gl_account.gl_account_id, enabling JOIN to retrieve GL account m"@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_gl_account_id" ;
    cmm:cimAssociation "ActivityRecord.ErpChartOfAccounts" .
cmm:BankReconciliation.primaryBankEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "primary bank employee"@en ;
    rdfs:comment "System user ID of the person who prepared the bank reconciliation. Part of SOX-compliant segregation of duties control framework."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "primary_bank_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Preparer User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_primary_bank_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:BankReconciliation.reviewerUserEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer user employee"@en ;
    rdfs:comment "System user ID of the person who reviewed the bank reconciliation. Must be different from preparer per SOX segregation of duties requirements."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "reviewer_user_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Reviewer User ID" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_reviewer_user_employee_id" ;
    cmm:cimAssociation "ActivityRecord.ErpPersonnel" .
cmm:BankReconciliation.soxControl a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sox control"@en ;
    rdfs:comment "Reference to the SOX control framework identifier for bank reconciliation controls. Links this reconciliation to the entity-level control testing program."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:SoxControl ;
    cmm:physicalColumn "sox_control_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_sox_control_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:BankReconciliation.treasuryPosition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "treasury position"@en ;
    rdfs:comment "FK to finance.treasury_position.treasury_position_id — Bank reconciliation references the bank account tracked in treasury positions. Required for daily cash position verification and liquidity management."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:TreasuryPosition ;
    cmm:physicalColumn "treasury_position_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_treasury_position_id" ;
    cmm:cimAssociation "ActivityRecord.Document" .
cmm:BankReconciliation.priorBankReconciliation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "prior bank reconciliation"@en ;
    rdfs:comment "Self-referencing FK on bank_reconciliation (prior_bank_reconciliation_id)"@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range cmm:BankReconciliation ;
    cmm:physicalColumn "prior_bank_reconciliation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_bank_reconciliation_prior_bank_reconciliation_id" ;
    cmm:cimAssociation "ActivityRecord.ActivityRecord" .
cmm:BankReconciliation.adjustedBankBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjusted bank balance"@en ;
    rdfs:comment "The bank statement balance after applying outstanding checks, deposits in transit, and other timing differences. Should equal the adjusted GL balance when reconciliation is complete."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjusted_bank_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjusted Bank Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.adjustedGlBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "adjusted gl balance"@en ;
    rdfs:comment "The GL balance after applying all necessary adjustments for bank charges, interest, NSF checks, and other items. Should equal the adjusted bank balance when reconciliation is complete."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "adjusted_gl_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Adjusted General Ledger (GL) Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.approvalTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval timestamp"@en ;
    rdfs:comment "Date and time when the bank reconciliation was approved. Final step in SOX-compliant reconciliation workflow."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "approval_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BankReconciliation.approverName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approver name"@en ;
    rdfs:comment "Full name of the person who approved the bank reconciliation. Provides human-readable audit trail for SOX compliance."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "approver_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approver Name" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.bankChargesAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank charges amount"@en ;
    rdfs:comment "Total amount of bank service charges, fees, and other deductions appearing on the bank statement but not yet recorded in the GL. Requires GL adjustment entry."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bank_charges_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Charges Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.bankInterestEarnedAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank interest earned amount"@en ;
    rdfs:comment "Total amount of interest income credited by the bank but not yet recorded in the GL. Requires GL adjustment entry."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "bank_interest_earned_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Interest Earned Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.bankStatementReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "bank statement reference"@en ;
    rdfs:comment "The bank's statement number or reference identifier for the statement being reconciled. Provides audit trail to source bank documents."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "bank_statement_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Statement Reference Number" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.clearingDocumentCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "clearing document count"@en ;
    rdfs:comment "Number of payment clearing documents and bank statement line items matched during this reconciliation. Provides volume metric for reconciliation complexity."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:int ;
    cmm:physicalColumn "clearing_document_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Clearing Document Count" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.companyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "company code"@en ;
    rdfs:comment "SAP company code identifying the legal entity for which the bank reconciliation is performed. Supports multi-entity financial consolidation."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "company_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Company Code" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for the bank account and all monetary amounts in this reconciliation record."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:BankReconciliation.depositsInTransitAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposits in transit amount"@en ;
    rdfs:comment "Total amount of deposits recorded in the GL but not yet reflected on the bank statement. Reconciling item increasing bank balance to GL balance."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposits_in_transit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposits in Transit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.fercAccountCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ferc account code"@en ;
    rdfs:comment "FERC Uniform System of Accounts code for the cash account. Required for regulatory financial reporting to FERC for utilities under federal jurisdiction."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "ferc_account_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Federal Energy Regulatory Commission (FERC) Account Code" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.fiscalPeriod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal period"@en ;
    rdfs:comment "The fiscal period (month) within the fiscal year for this bank reconciliation. Supports monthly close processes and period-over-period analysis."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_period" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Period" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fiscal year"@en ;
    rdfs:comment "The fiscal year to which this bank reconciliation belongs. Used for financial period reporting and SOX control testing organization."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:int ;
    cmm:physicalColumn "fiscal_year" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fiscal Year" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.glBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "gl balance"@en ;
    rdfs:comment "The balance in the general ledger cash account as of the reconciliation date. Represents the company's book balance before reconciling items."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "gl_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "General Ledger (GL) Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for preparer, reviewer, or approver comments regarding unusual items, variances, or resolution actions. Provides narrative audit trail."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reconciliation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:BankReconciliation.nsfChecksAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nsf checks amount"@en ;
    rdfs:comment "Total amount of customer checks returned by the bank due to insufficient funds. Requires GL adjustment to reverse the original deposit entry."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "nsf_checks_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Non-Sufficient Funds (NSF) Checks Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.otherReconcilingItemsAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "other reconciling items amount"@en ;
    rdfs:comment "Total amount of miscellaneous reconciling items not classified in standard categories. Includes wire transfer fees, foreign exchange adjustments, and other bank-initiated transactions."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "other_reconciling_items_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Other Reconciling Items Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.outstandingChecksAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding checks amount"@en ;
    rdfs:comment "Total amount of checks issued by the company that have been recorded in the GL but have not yet cleared the bank. Reconciling item reducing bank balance to GL balance."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_checks_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outstanding Checks Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.preparationTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preparation timestamp"@en ;
    rdfs:comment "Date and time when the bank reconciliation was initially prepared. Establishes timeline for SOX control testing and audit evidence."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "preparation_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preparation Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BankReconciliation.preparerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "preparer name"@en ;
    rdfs:comment "Full name of the person who prepared the bank reconciliation. Provides human-readable audit trail for SOX compliance."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "preparer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Preparer Name" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.reconciliationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation date"@en ;
    rdfs:comment "The business date on which the bank reconciliation was performed. Represents the as-of date for the reconciliation snapshot."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:date ;
    cmm:physicalColumn "reconciliation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Date" ;
    cmm:cimDatatype "Date" .
cmm:BankReconciliation.reconciliationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation method"@en ;
    rdfs:comment "The method used to perform the bank reconciliation. Indicates level of automation and manual intervention required."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reconciliation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Method" ;
    cmm:validValues "manual|semi_automated|fully_automated" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.reconciliationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reconciliation status"@en ;
    rdfs:comment "Current workflow status of the bank reconciliation. Tracks progression from initial draft through review and approval stages."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reconciliation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Reconciliation Status" ;
    cmm:validValues "draft|in_progress|balanced|unbalanced|approved|rejected" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:ActivityRecord.status .
cmm:BankReconciliation.reviewTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review timestamp"@en ;
    rdfs:comment "Date and time when the bank reconciliation was reviewed. Establishes timeline for SOX control testing and demonstrates timely review."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "review_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Review Timestamp" ;
    cmm:cimDatatype "DateTime" .
cmm:BankReconciliation.reviewerName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "reviewer name"@en ;
    rdfs:comment "Full name of the person who reviewed the bank reconciliation. Provides human-readable audit trail for SOX compliance."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "reviewer_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reviewer Name" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.sourceDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source document reference"@en ;
    rdfs:comment "The unique identifier of this reconciliation record in the source system. Enables traceability back to the operational system for audit purposes."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source Document ID" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.sourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "source system"@en ;
    rdfs:comment "The system of record from which this bank reconciliation data originated. Typically SAP S/4HANA FI or treasury management system."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:string ;
    cmm:physicalColumn "source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Source System" ;
    cmm:cimDatatype "String" .
cmm:BankReconciliation.soxControlEvidenceFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sox control evidence flag"@en ;
    rdfs:comment "Indicates whether this reconciliation record serves as evidence for SOX control testing. True for reconciliations selected for audit sample testing."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "sox_control_evidence_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Sarbanes-Oxley (SOX) Control Evidence Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:BankReconciliation.statementBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statement balance"@en ;
    rdfs:comment "The ending balance reported on the bank statement for the reconciliation period. Represents the bank's view of cash position."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "statement_balance" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Statement Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BankReconciliation.statementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statement date"@en ;
    rdfs:comment "The ending date of the bank statement being reconciled. Typically the last day of the statement period."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:date ;
    cmm:physicalColumn "statement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Bank Statement Date" ;
    cmm:cimDatatype "Date" .
cmm:BankReconciliation.unmatchedBankItemsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unmatched bank items count"@en ;
    rdfs:comment "Number of bank statement line items that could not be matched to GL postings. Indicates potential missing entries or errors requiring investigation."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:int ;
    cmm:physicalColumn "unmatched_bank_items_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unmatched Bank Items Count" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.unmatchedGlItemsCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "unmatched gl items count"@en ;
    rdfs:comment "Number of GL postings that could not be matched to bank statement line items. Indicates potential timing differences or errors requiring investigation."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:int ;
    cmm:physicalColumn "unmatched_gl_items_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Unmatched General Ledger (GL) Items Count" ;
    cmm:cimDatatype "Integer" .
cmm:BankReconciliation.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "The difference between adjusted bank balance and adjusted GL balance. A zero variance indicates a successful reconciliation; non-zero variance requires investigation and resolution."@en ;
    rdfs:domain cmm:BankReconciliation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Reconciliation Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:RegulatoryAssetRateCaseInclusion a owl:Class ;
    rdfs:label "Regulatory Asset Rate Case Inclusion"@en ;
    rdfs:comment "This association product represents the inclusion and presentation of regulatory assets and liabilities in rate case filings submitted to regulatory commissions (PUC or FERC). Each record captures the requested and approved recovery amounts, amortization periods, carrying cost rates, and regulatory outcomes for a specific regulatory asset within a specific rate case proceeding. This is a core business entity in utility regulatory accounting, actively managed by rate case analysts and regulatory accountants throughout the rate case lifecycle from filing preparation through commission approval and implementation.. Existence Justification: In utility regulatory accounting, a single regulatory asset can be presented in multiple rate case filings over time (initial authorization, subsequent rate cases for continued recovery, or re-authorization after regulatory changes), and each rate case filing includes multiple regulatory assets in its revenue requirement calculation. Rate case analysts actively manage the inclusion of each asset in each filing, tracking requested vs. approved amounts, amortization periods, carrying cost rates, and commission rulings. This is a core operational business process with its own lifecycle (preparation, filing, testimony, commission review, approval/disallowance, implementation) that is tracked in regulatory accounting systems."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.regulatory_reporting ;
    cmm:physicalTable "utility_cmm_silver.finance.regulatory_asset_rate_case_inclusion" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.finance.regulatory_asset_rate_case_inclusion" ;
    owl:hasKey ( cmm:RegulatoryAssetRateCaseInclusion.regulatoryAssetRateCaseInclusionId ) .

cmm:RegulatoryAssetRateCaseInclusion.regulatoryAssetRateCaseInclusionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset rate case inclusion id"@en ;
    rdfs:comment "Unique identifier for this regulatory asset rate case inclusion record. Primary key."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:long ;
    cmm:physicalColumn "regulatory_asset_rate_case_inclusion_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Regulatory Asset Rate Case Inclusion ID" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryAssetRateCaseInclusion.rateCaseFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "rate case filing"@en ;
    rdfs:comment "Foreign key linking to the rate case filing in which the regulatory asset is presented for recovery"@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range cmm:RateCaseFiling ;
    cmm:physicalColumn "rate_case_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Asset Rate Case Inclusion - Rate Case Filing Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_rate_case_inclusion_rate_case_filing_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:RegulatoryAssetRateCaseInclusion.regulatoryAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory asset"@en ;
    rdfs:comment "Foreign key linking to the regulatory asset or liability being included in the rate case filing"@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range cmm:RegulatoryAsset ;
    cmm:physicalColumn "regulatory_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Asset Rate Case Inclusion - Regulatory Asset Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_regulatory_asset_rate_case_inclusion_regulatory_asset_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:RegulatoryAssetRateCaseInclusion.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date on which the regulatory commission issued its final order approving (or disallowing) recovery of this regulatory asset in this rate case. Null if still under review or withdrawn."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAssetRateCaseInclusion.approvedAmortizationPeriodMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved amortization period months"@en ;
    rdfs:comment "Amortization period in months approved by the regulatory commission for this regulatory asset in this rate case. Becomes the basis for rate recovery implementation."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:int ;
    cmm:physicalColumn "approved_amortization_period_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Amortization Period" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryAssetRateCaseInclusion.approvedCarryingCostRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved carrying cost rate"@en ;
    rdfs:comment "Annual carrying cost rate approved by the regulatory commission for this regulatory asset in this rate case. Used to calculate ongoing carrying costs during the amortization period."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_carrying_cost_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Carrying Cost Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAssetRateCaseInclusion.approvedRecoveryAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approved recovery amount"@en ;
    rdfs:comment "Total recovery amount for this regulatory asset approved by the regulatory commission in the final order for this rate case. May differ from requested amount due to commission disallowances or adjustments."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "approved_recovery_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Approved Recovery Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAssetRateCaseInclusion.disallowanceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disallowance amount"@en ;
    rdfs:comment "Amount of the regulatory asset disallowed by the regulatory commission in this rate case (requested amount minus approved amount). Represents costs deemed imprudent or not recoverable."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "disallowance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disallowance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAssetRateCaseInclusion.disallowanceReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "disallowance reason"@en ;
    rdfs:comment "Regulatory commission's stated reason for any disallowance of the requested recovery amount for this regulatory asset in this rate case (e.g., imprudent costs, lack of documentation, alternative cost recovery method required)."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:string ;
    cmm:physicalColumn "disallowance_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Disallowance Reason" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAssetRateCaseInclusion.implementationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "implementation date"@en ;
    rdfs:comment "Date on which the approved recovery terms for this regulatory asset became effective in customer rates following this rate case. Used to trigger rate schedule updates and amortization schedule adjustments."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:date ;
    cmm:physicalColumn "implementation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Implementation Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAssetRateCaseInclusion.inclusionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inclusion date"@en ;
    rdfs:comment "Date on which this regulatory asset was formally included in this rate case filing. Typically the filing date, but may differ if asset was added via amendment or supplemental filing."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:date ;
    cmm:physicalColumn "inclusion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Inclusion Date" ;
    cmm:cimDatatype "Date" .
cmm:RegulatoryAssetRateCaseInclusion.inclusionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "inclusion status"@en ;
    rdfs:comment "Current lifecycle status of this regulatory asset's inclusion in this rate case filing. Values: proposed (internal planning), filed (submitted to commission), under_review (in regulatory proceeding), approved (commission approved full request), partially_approved (commission approved reduced amount), disallowed (commission rejected recovery), withdrawn (utility withdrew from filing)."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:string ;
    cmm:physicalColumn "inclusion_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Inclusion Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:RegulatoryAssetRateCaseInclusion.intervenorPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intervenor position"@en ;
    rdfs:comment "Summary of intervenor or commission staff positions on this regulatory asset's recovery in this rate case (e.g., consumer advocate recommended 50% disallowance, staff recommended approval with modified amortization period). Captures regulatory proceeding dynamics."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:string ;
    cmm:physicalColumn "intervenor_position" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Intervenor Position" ;
    cmm:cimDatatype "String" .
cmm:RegulatoryAssetRateCaseInclusion.requestedAmortizationPeriodMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested amortization period months"@en ;
    rdfs:comment "Amortization period in months requested by the utility for this regulatory asset in this rate case filing. May differ from the asset's authorized period if the utility is requesting a change."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:int ;
    cmm:physicalColumn "requested_amortization_period_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Amortization Period" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:RegulatoryAssetRateCaseInclusion.requestedCarryingCostRate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested carrying cost rate"@en ;
    rdfs:comment "Annual carrying cost rate (return rate) requested by the utility for this regulatory asset in this rate case filing. Typically based on WACC or authorized ROE."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_carrying_cost_rate" ;
    cmm:sqlDataType "DECIMAL(5,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Carrying Cost Rate" ;
    cmm:cimDatatype "Decimal" .
cmm:RegulatoryAssetRateCaseInclusion.requestedRecoveryAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requested recovery amount"@en ;
    rdfs:comment "Total recovery amount for this regulatory asset requested by the utility in this specific rate case filing. This amount is specific to the asset-filing combination and may differ from the asset's carrying amount due to rate case strategy or partial recovery requests."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "requested_recovery_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requested Recovery Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:RegulatoryAssetRateCaseInclusion.settlementIncludedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "settlement included flag"@en ;
    rdfs:comment "Indicates whether this regulatory asset was included in a settlement agreement reached during this rate case proceeding. If true, approved amounts reflect settlement terms rather than litigated outcome."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "settlement_included_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Settlement Included Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:RegulatoryAssetRateCaseInclusion.testimonyReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "testimony reference"@en ;
    rdfs:comment "Reference to the specific witness testimony exhibit or schedule in the rate case filing that presents this regulatory asset (e.g., Exhibit RRA-3, Schedule 5.2). Used for regulatory proceeding tracking and audit trail."@en ;
    rdfs:domain cmm:RegulatoryAssetRateCaseInclusion ; rdfs:range xsd:string ;
    cmm:physicalColumn "testimony_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Testimony Reference" ;
    cmm:cimDatatype "String" .

cmm:ProjectCostAllocation a owl:Class ;
    rdfs:label "Project Cost Allocation"@en ;
    rdfs:comment "This association product represents the cost allocation agreement between capital projects and cost centers in SAP S/4HANA PS/CO integration. It captures the negotiated budget allocations, actual cost tracking, and variance analysis for cross-organizational capital project funding. Each record links one CAPEX project to one cost center with allocation percentages, budget amounts, and actual spend that exist only in the context of this funding relationship. This is a core operational entity in utility capital project management where projects are funded by multiple organizational units and cost centers contribute to multiple capital initiatives.. Existence Justification: In utility capital project management, projects are routinely funded by multiple cost centers (e.g., a substation upgrade funded by transmission operations, engineering services, and corporate IT), and cost centers contribute to multiple capital projects simultaneously. Project managers and cost center managers negotiate and actively manage these allocation agreements with specific budget amounts, approval workflows, and variance tracking. This is a core operational process in SAP PS/CO integration where the allocation itself is a managed business entity with its own lifecycle."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:finance , cmmsa:finance.cost_control ;
    cmm:physicalTable "utility_cmm_silver.finance.project_cost_allocation" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.finance.project_cost_allocation" ;
    owl:hasKey ( cmm:ProjectCostAllocation.projectCostAllocationId ) .

cmm:ProjectCostAllocation.projectCostAllocationId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "project cost allocation id"@en ;
    rdfs:comment "Unique identifier for this project-cost center allocation relationship. Primary key."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:long ;
    cmm:physicalColumn "project_cost_allocation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Project Cost Allocation Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:ProjectCostAllocation.approvedByEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "approved by employee"@en ;
    rdfs:comment "Employee ID of the manager who approved this cost allocation (typically the cost center manager or project sponsor). Links to employee master data."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "approved_by_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Approving Manager Employee ID" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_project_cost_allocation_approved_by_employee_id" ;
    cmm:cimAssociation "IdentifiedObject.ErpPersonnel" .
cmm:ProjectCostAllocation.capexProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capex project"@en ;
    rdfs:comment "Foreign key linking to the capital expenditure project receiving cost center funding"@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range cmm:CapexProject ;
    cmm:physicalColumn "capex_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Cost Allocation - Capex Project Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_project_cost_allocation_capex_project_id" ;
    cmm:cimAssociation "IdentifiedObject.Project" .
cmm:ProjectCostAllocation.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to the cost center providing funding or charging costs to the project"@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Cost Allocation - Cost Center Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_project_cost_allocation_cost_center_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:ProjectCostAllocation.settlementRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "settlement rule"@en ;
    rdfs:comment "SAP CO settlement rule identifier governing how costs are transferred from the cost center to the project WBS element. Links to SAP configuration for automated cost allocation."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range cmm:SettlementRule ;
    cmm:physicalColumn "settlement_rule_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Settlement Rule Identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_finance_project_cost_allocation_settlement_rule_id" ;
    cmm:cimAssociation "IdentifiedObject.Document" .
cmm:ProjectCostAllocation.actualCostToDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual cost to date"@en ;
    rdfs:comment "Cumulative actual costs posted to this project-cost center allocation to date, in USD. Tracks actual spend against the allocated budget for variance monitoring."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_cost_to_date" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Cost to Date" ;
    cmm:cimDatatype "Decimal" .
cmm:ProjectCostAllocation.allocationEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation end date"@en ;
    rdfs:comment "Effective end date when this cost center stopped funding or charging costs to this capital project. Null if allocation is still active."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "allocation_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation End Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectCostAllocation.allocationStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation start date"@en ;
    rdfs:comment "Effective start date when this cost center began funding or charging costs to this capital project. Supports time-phased allocation tracking."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "allocation_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Start Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectCostAllocation.allocationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation status"@en ;
    rdfs:comment "Current lifecycle status of this cost allocation: approved (budget authorized but not yet active), active (costs being posted), suspended (temporarily halted), closed (project complete), cancelled (allocation revoked)."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:ProjectCostAllocation.allocationType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation type"@en ;
    rdfs:comment "Nature of the cost allocation relationship: direct_funding (cost center directly funds project), overhead_allocation (indirect cost distribution), shared_service (shared resource costs), interdepartmental_charge (cross-functional cost recovery)."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.kind .
cmm:ProjectCostAllocation.approvalDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "approval date"@en ;
    rdfs:comment "Date when this cost allocation was approved by both the project manager and cost center manager. Required for budget governance and audit trail."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:date ;
    cmm:physicalColumn "approval_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Approval Date" ;
    cmm:cimDatatype "Date" .
cmm:ProjectCostAllocation.budgetAllocationAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "budget allocation amount"@en ;
    rdfs:comment "The approved budget amount allocated from this cost center to this capital project, in USD. Represents the cost center's committed funding contribution to the project."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "budget_allocation_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocated Budget Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ProjectCostAllocation.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text notes documenting the business justification for this allocation, special terms, or variance explanations. Used for audit trail and management reporting."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Allocation Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:ProjectCostAllocation.percentageAllocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "percentage allocation"@en ;
    rdfs:comment "Percentage of the project's total budget funded by this cost center, or percentage of the cost center's budget allocated to this project. Used for proportional cost distribution and variance analysis."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "percentage_allocation" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Percentage" ;
    cmm:cimDatatype "Decimal" .
cmm:ProjectCostAllocation.varianceAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "variance amount"@en ;
    rdfs:comment "Difference between allocated budget and actual cost to date for this specific cost center-project allocation, in USD. Positive indicates under-spend, negative indicates over-spend."@en ;
    rdfs:domain cmm:ProjectCostAllocation ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "variance_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Variance Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

