cmm:ComplianceDocument a owl:Class ;
    rdfs:label "Compliance Document"@en ;
    rdfs:comment "Master reference table for compliance_document. Referenced by compliance_document_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimCloseMatch cim:Document ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.compliance_document" ;
    cmm:dataClassification "master_data" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.compliance_document" ;
    owl:hasKey ( cmm:ComplianceDocument.complianceDocumentId ) .

