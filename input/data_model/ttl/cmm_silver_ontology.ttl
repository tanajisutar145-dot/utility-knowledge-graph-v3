cmm:Crew.mutualAidEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mutual aid eligible"@en ;
    rdfs:comment "Indicates whether the crew is eligible for deployment under EEI (Edison Electric Institute) or EATON mutual aid agreements during major storm events or grid emergencies at other utilities."@en ;
    rdfs:domain cmm:Crew ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "mutual_aid_eligible" ;
