cmm:EmployeeQualification.qualificationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "qualification status"@en ;
    rdfs:comment "Current lifecycle status of the qualification. Active indicates the employee is currently qualified; expired indicates renewal is required; suspended indicates temporary hold pending review; revoked indicates permanent removal."@en ;
    rdfs:domain cmm:EmployeeQualification ; rdfs:range xsd:string ;
