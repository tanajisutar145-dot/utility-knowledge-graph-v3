    cmm:businessTerm "Technical Justification" ;
    cmm:cimDatatype "String" .
cmm:NetworkUpgrade.upgradeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade description"@en ;
