    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "operating_regions" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "String" .
cmm:ContractorCompany.paymentTerms a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment terms"@en ;
