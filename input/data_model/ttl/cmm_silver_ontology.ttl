    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agreement Term End Date" ;
    cmm:cimDatatype "Date" .
cmm:TransmissionServiceAgreement.termStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "term start date"@en ;
    rdfs:comment "Effective start date when the transmission service agreement becomes binding and service begins."@en ;
    rdfs:domain cmm:TransmissionServiceAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "term_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Agreement Term Start Date" ;
