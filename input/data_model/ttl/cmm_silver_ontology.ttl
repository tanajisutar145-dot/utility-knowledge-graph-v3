cmm:RegulatoryCorrespondence.closureNotes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "closure notes"@en ;
    rdfs:comment "Notes documenting the resolution or closure of the correspondence matter, including any final actions taken or outcomes achieved."@en ;
    rdfs:domain cmm:RegulatoryCorrespondence ; rdfs:range xsd:string ;
