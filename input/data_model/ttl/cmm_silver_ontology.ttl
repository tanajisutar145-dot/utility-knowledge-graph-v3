    cmm:cimDatatype "ActivePower" .
cmm:DrIncentivePayment.aggregatorShareAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "aggregator share amount"@en ;
    rdfs:comment "Dollar amount of the payment allocated to the aggregator based on the aggregator share percentage."@en ;
