cmm:TopologySnapshot.topologyProcessorAlgorithm a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "topology processor algorithm"@en ;
    rdfs:comment "Name or identifier of the topology processing algorithm or method used to generate this snapshot (e.g., depth-first search, breadth-first search, matrix-based)."@en ;
    rdfs:domain cmm:TopologySnapshot ; rdfs:range xsd:string ;
    cmm:physicalColumn "topology_processor_algorithm" ;
