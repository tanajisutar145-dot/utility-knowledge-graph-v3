cmm:DrIncentivePayment.toDrEventParticipant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to dr event participant"@en ;
    rdfs:comment "FK to demand.dr_event_participant.dr_event_participant_id — Incentive payments are calculated based on participant event performance. This FK links financial records to the performance data that generated them."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrEventParticipant ;
    cmm:physicalColumn "to_dr_event_participant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_demand_dr_incentive_payment_to_dr_event_participant_id" ;
    cmm:cimAssociation "Transaction.IdentifiedObject" .
cmm:DrIncentivePayment.toDrProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to dr program"@en ;
    rdfs:comment "FK to demand.dr_program.dr_program_id — Financial settlements must reference the program for rate structure, incentive rules, and regulatory reporting."@en ;
    rdfs:domain cmm:DrIncentivePayment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "to_dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
