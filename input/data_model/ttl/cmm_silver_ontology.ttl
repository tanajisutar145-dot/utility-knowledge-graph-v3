cmm:SelfReport.publicDisclosureRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "public disclosure required flag"@en ;
    rdfs:comment "Indicates whether this self-report must be publicly disclosed per regulatory requirements or materiality thresholds."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "public_disclosure_required_flag" ;
