cmm:CrewAssignment.isPrimaryAssignment a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is primary assignment"@en ;
    rdfs:comment "Boolean flag indicating whether this is the employee's primary crew assignment. True if this is the employee's home crew, false if this is a secondary or temporary assignment."@en ;
    rdfs:domain cmm:CrewAssignment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "is_primary_assignment" ;
