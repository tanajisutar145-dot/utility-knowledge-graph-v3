cmm:Grievance a owl:Class ;
    rdfs:label "Grievance"@en ;
    rdfs:comment "Union grievance records filed by bargaining unit employees or union representatives alleging violations of the collective bargaining agreement. Captures grievance number, filing date, grievant employee, union local, alleged CBA violation, step in grievance procedure (Step 1 through arbitration), management response, resolution outcome, and settlement terms. Supports labor relations management and CBA compliance tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:workforce , cmmsa:workforce.talent_management ;
    cmm:physicalTable "utility_cmm_silver.workforce.grievance" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "IBEW/UWUA CBA Grievance Procedure" ;
    cmm:sourceObject "energy_utilities_ecm.workforce.grievance" ;
    owl:hasKey ( cmm:Grievance.grievanceId ) .

cmm:Grievance.grievanceId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grievance id"@en ;
    rdfs:comment "Unique identifier for the union grievance record. Primary key."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:long ;
    cmm:physicalColumn "grievance_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Grievance Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:Grievance.grievanceEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grievance employee"@en ;
    rdfs:comment "Identifier of the union steward or business agent representing the grievant in the grievance procedure."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "grievance_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Union Representative Identifier (ID)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_grievance_grievance_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:Grievance.grievanceGrievantEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grievance grievant employee"@en ;
    rdfs:comment "Identifier of the bargaining unit employee who filed the grievance or on whose behalf the grievance was filed."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "grievance_grievant_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Grievant Employee Identifier (ID)" ;
    cmm:sensitivity "restricted" ;
    cmm:sensitivity "pii_identifier" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_grievance_grievance_grievant_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:Grievance.grievanceLaborRelationsSpecialistEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grievance labor relations specialist employee"@en ;
    rdfs:comment "Identifier of the company labor relations specialist or human resources representative managing the grievance on behalf of management."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "grievance_labor_relations_specialist_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Labor Relations Specialist Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_grievance_grievance_labor_relations_specialist_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:Grievance.grievanceManagementRespondentEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "grievance management respondent employee"@en ;
    rdfs:comment "Identifier of the management representative or supervisor whose action or decision is being grieved."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "grievance_management_respondent_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Management Respondent Identifier (ID)" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_grievance_grievance_management_respondent_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:Grievance.unionAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "union agreement"@en ;
    rdfs:comment "Foreign key linking to workforce.union_agreement. Business justification: Grievances allege violations of collective bargaining agreements (CBAs). Adding union_agreement_id FK links each grievance to the specific CBA being contested. Currently stores alleged_cba_violation a"@en ;
    rdfs:domain cmm:Grievance ; rdfs:range cmm:UnionAgreement ;
    cmm:physicalColumn "union_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Union Agreement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_workforce_grievance_union_agreement_id" ;
    cmm:cimAssociation "Document.Agreement" .
cmm:Grievance.arbitrationCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration cost amount"@en ;
    rdfs:comment "Total cost of arbitration including arbitrator fees, hearing room rental, and administrative expenses, in USD."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "arbitration_cost_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitration Cost Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:Grievance.arbitrationDecisionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration decision date"@en ;
    rdfs:comment "Date the arbitrator issued the binding arbitration award or decision."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "arbitration_decision_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitration Decision Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.arbitrationFiledDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration filed date"@en ;
    rdfs:comment "Date the union filed for binding arbitration after exhausting internal grievance procedure steps."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "arbitration_filed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitration Filed Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.arbitrationHearingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration hearing date"@en ;
    rdfs:comment "Date of the formal arbitration hearing where both parties present evidence and arguments."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "arbitration_hearing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitration Hearing Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.arbitrationOutcome a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitration outcome"@en ;
    rdfs:comment "Final outcome of the arbitration: sustained (grievance upheld), denied (management decision upheld), or partially sustained (split decision)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "arbitration_outcome" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitration Outcome" ;
    cmm:validValues "sustained|denied|partially_sustained" ;
    cmm:cimDatatype "String" .
cmm:Grievance.arbitratorName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "arbitrator name"@en ;
    rdfs:comment "Name of the neutral arbitrator selected to hear and decide the grievance if it proceeds to arbitration."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "arbitrator_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Arbitrator Name" ;
    cmm:cimDatatype "String" .
cmm:Grievance.backPayAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "back pay amount"@en ;
    rdfs:comment "Monetary amount of back pay awarded to the grievant as part of the grievance resolution or arbitration award, in USD."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "back_pay_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Back Pay Amount" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:Grievance.costCenter a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Cost center to which any financial settlement, back pay, or arbitration costs are allocated for accounting purposes."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center" ;
    cmm:valuePattern "^[0-9]{10}$" ;
    cmm:cimDatatype "String" .
cmm:Grievance.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this grievance record was first created in the system."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Record Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:Grievance.filingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "filing date"@en ;
    rdfs:comment "Date the grievance was formally filed with management, triggering the grievance procedure timeline per the collective bargaining agreement."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "filing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Grievance Filing Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.grievanceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grievance number"@en ;
    rdfs:comment "Business identifier for the grievance, typically formatted as GRV-YYYY-NNNNN for external reference and tracking."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "grievance_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Grievance Number" ;
    cmm:valuePattern "^GRV-[0-9]{4}-[0-9]{5}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:Grievance.grievanceStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grievance status"@en ;
    rdfs:comment "Current status of the grievance in the resolution lifecycle, tracking progression through the grievance procedure steps defined in the CBA. Reference-value candidates: filed|step_1_pending|step_2_pending|step_3_pending|arbitration_pending|resolved|withdrawn|denied."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "grievance_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Grievance Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:Grievance.grievanceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "grievance type"@en ;
    rdfs:comment "Classification of the grievance: individual (single employee), group (multiple employees), policy (interpretation of CBA language), or continuing (ongoing violation)."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:string ;
    cmm:physicalColumn "grievance_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Grievance Type" ;
    cmm:validValues "individual|group|policy|continuing" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:Grievance.incidentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident date"@en ;
    rdfs:comment "Date the alleged CBA violation or incident that gave rise to the grievance occurred."@en ;
    rdfs:domain cmm:Grievance ; rdfs:range xsd:date ;
    cmm:physicalColumn "incident_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Incident Date" ;
    cmm:cimDatatype "Date" .
cmm:Grievance.incidentLocation a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "incident location"@en ;
