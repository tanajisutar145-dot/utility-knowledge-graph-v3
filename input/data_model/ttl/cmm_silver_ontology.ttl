cmm:ContractorCompany.addressLine1 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line1"@en ;
    rdfs:comment "First line of the contractor's primary address."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line1" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:ContractorCompany.addressLine2 a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "address line2"@en ;
    rdfs:comment "Second line of the contractor's primary address (optional)."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:string ;
    cmm:physicalColumn "address_line2" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii_address" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:StreetDetail.addressGeneral .
cmm:ContractorCompany.annualRevenue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual revenue"@en ;
    rdfs:comment "Reported annual revenue of the contractor company in USD."@en ;
    rdfs:domain cmm:ContractorCompany ; rdfs:range xsd:decimal ;
