cmm:MessageTemplate a owl:Class ;
    rdfs:label "Message Template"@en ;
    rdfs:comment "Master reference table for message_template. Referenced by message_template_id."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:outage , cmmsa:outage.outage_management ;
