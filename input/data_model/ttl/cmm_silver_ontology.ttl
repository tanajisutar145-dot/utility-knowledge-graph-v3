    cmm:cimCloseMatch cim:Document.comment .
cmm:TechnicalReview.screeningCriteriaApplied a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "screening criteria applied"@en ;
    rdfs:comment "Description of the technical screening criteria and rules applied during the review. May reference Fast Track screens (15% rule, 100% rule per FERC Order 2023), IEEE 1547 screens, or utility-specific criteria."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:string ;
    cmm:physicalColumn "screening_criteria_applied" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Screening Criteria Applied" ;
    cmm:cimDatatype "String" .
cmm:TechnicalReview.shortCircuitRatio a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "short circuit ratio"@en ;
    rdfs:comment "Ratio of the available short circuit current at the Point of Interconnection (POI) to the Distributed Energy Resource (DER) rated current. Used to assess system strength and fault contribution."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "short_circuit_ratio" ;
    cmm:sqlDataType "DECIMAL(8,4)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Short Circuit Ratio" ;
    cmm:cimDatatype "Decimal" .
cmm:TechnicalReview.technicalIssuesSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technical issues summary"@en ;
    rdfs:comment "Comprehensive narrative summary of all technical issues, concerns, and findings identified during the review. Includes voltage violations, thermal constraints, protection conflicts, and power quality concerns."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:string ;
    cmm:physicalColumn "technical_issues_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technical Issues Summary" ;
    cmm:cimDatatype "String" .
cmm:TechnicalReview.thermalOverloadIdentified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "thermal overload identified"@en ;
    rdfs:comment "Indicates whether thermal overload conditions on conductors or equipment were identified during the technical review. True if thermal issues detected."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "thermal_overload_identified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Thermal Overload Identified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TechnicalReview.ul1741CertificationVerified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ul 1741 certification verified"@en ;
    rdfs:comment "Indicates whether the proposed inverter equipment has valid Underwriters Laboratories (UL) 1741 certification for grid interconnection. True if certification verified."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "ul_1741_certification_verified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Underwriters Laboratories (UL) 1741 Certification Verified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TechnicalReview.voltageViolationIdentified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage violation identified"@en ;
    rdfs:comment "Indicates whether voltage regulation violations were identified during the technical review. True if voltage issues detected."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "voltage_violation_identified" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Violation Identified Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:TechnicalReview.witnessTestRequired a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "witness test required"@en ;
    rdfs:comment "Indicates whether a utility witness test of the Distributed Energy Resource (DER) equipment and protective functions is required before final approval. True if witness test needed."@en ;
    rdfs:domain cmm:TechnicalReview ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "witness_test_required" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Witness Test Required Flag" ;
    cmm:cimDatatype "Boolean" .

cmm:ImpactStudy a owl:Class ;
    rdfs:label "Impact Study"@en ;
    rdfs:comment "Record of a formal grid impact study ordered for an interconnection application that fails Fast Track or simplified review screens. Captures study type (Feasibility Study, System Impact Study, Facilities Study per FERC Order 2023 or state PUC rules), study scope (affected network segments, contingency scenarios), study contractor (utility internal or third-party), study initiation and completion dates, study cost estimate, cost responsibility allocation reference, identified network upgrades required, upgrade cost estimate, and study findings summary. Also manages cluster/group study cohorts formed under FERC Order 2023 — including cluster study group identifier, geographic study area (feeder, substation zone, planning area), study group formation date, number of applications in group, group study cost allocation methodology, study type classification (cluster feasibility, cluster system impact, cluster facilities), and group study contractor assignment. Supports both individual application studies and FERC Order 2023 cluster study processing for efficient handling of high-volume DER interconnection queues. Drives the determination of required network upgrades and cost allocation across grouped applications."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.impact_study" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "FERC Order 2023; FERC Order 2023 Feasibility / System Impact / Facilities Study" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.impact_study" ;
    owl:hasKey ( cmm:ImpactStudy.impactStudyId ) .

cmm:ImpactStudy.impactStudyId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "impact study id"@en ;
    rdfs:comment "Unique identifier for the grid impact study record. Primary key for the impact study entity."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:long ;
    cmm:physicalColumn "impact_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Impact Study Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:ImpactStudy.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Impact studies are ordered for applications that fail Fast Track screens. After cluster_study_group merge, impact_study also carries the cluster grouping — but each study still traces back to one or m"@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:ImpactStudy.clusterStudyGroup a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cluster study group"@en ;
    rdfs:comment "Identifier for the cluster study group formed under FERC Order 2023. Multiple interconnection applications may be grouped together for efficient processing. Null for individual application studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:ClusterStudyGroup ;
    cmm:physicalColumn "cluster_study_group_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cluster Study Group Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_cluster_study_group_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ImpactStudy.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Impact studies evaluate how proposed DER affects existing NERC-defined contingency scenarios (N-1, N-2) and may trigger new contingency definitions. Required for NERC TPL standard compliance and deter"@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_contingency_id" ;
    cmm:cimAssociation "Document.Contingency" .
cmm:ImpactStudy.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Impact study costs (internal engineering labor, contractor fees, software tools) are charged to cost centers for cost tracking, overhead allocation, and study cost recovery from applicants per interco"@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_cost_center_id" ;
    cmm:cimAssociation "Document.Organisation" .
cmm:ImpactStudy.impactApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "impact application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Impact studies are ordered when an application fails Fast Track screens. The study determines what network upgrades are needed for that specific application (or cluster of applications)."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "impact_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_impact_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:ImpactStudy.impactInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "impact interconnection application"@en ;
    rdfs:comment "Reference to the interconnection application that triggered this impact study. Links the study to the originating DER interconnection request."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "impact_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_impact_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:ImpactStudy.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Clustered impact studies inform IRP scenario planning for DER penetration assumptions, grid investment needs, and capacity expansion plans. Regulatory filing requirement - utilities must demonstrate h"@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:ImpactStudy.load a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "load"@en ;
    rdfs:comment "Foreign key linking to forecast.load. Business justification: Impact studies model DER effects on forecasted load profiles using load flow and stability analysis. Study scope requires baseline load forecast as input for voltage, thermal, and protection coordinat"@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range cmm:LoadForecast ;
    cmm:physicalColumn "load_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Forecast Load Forecast Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_impact_study_load_id" ;
    cmm:cimAssociation "Document.ConformLoadSchedule" .
cmm:ImpactStudy.affectedNetworkSegments a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected network segments"@en ;
    rdfs:comment "List or description of transmission and distribution network segments that may be impacted by the proposed interconnection. Includes feeders, substations, and transmission lines."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_network_segments" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Network Segments" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.applicableTariffReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicable tariff reference"@en ;
    rdfs:comment "Reference to the applicable interconnection tariff or rule governing the study process, such as FERC pro forma LGIP or state-specific interconnection rules."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "applicable_tariff_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicable Tariff Reference" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.clusterApplicationCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster application count"@en ;
    rdfs:comment "Number of interconnection applications included in the cluster study group. Null for individual application studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:int ;
    cmm:physicalColumn "cluster_application_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cluster Application Count" ;
    cmm:cimDatatype "Integer" .
cmm:ImpactStudy.clusterCostAllocationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster cost allocation methodology"@en ;
    rdfs:comment "Specific cost allocation methodology applied to cluster study groups, such as pro-rata by capacity, equal share, or impact-based allocation. Null for individual studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "cluster_cost_allocation_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cluster Cost Allocation Methodology" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.clusterGeographicArea a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster geographic area"@en ;
    rdfs:comment "Geographic study area for cluster studies, such as feeder, substation zone, or planning area. Defines the network boundary for grouped impact analysis."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "cluster_geographic_area" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cluster Geographic Area" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.clusterGroupFormationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cluster group formation date"@en ;
    rdfs:comment "Date when the cluster study group was formed under FERC Order 2023 cluster study process. Null for individual application studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "cluster_group_formation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cluster Group Formation Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.contingencyScenarios a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contingency scenarios"@en ;
    rdfs:comment "Description of contingency scenarios analyzed in the study, such as N-1 or N-2 outage conditions, to assess grid reliability and stability impacts."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "contingency_scenarios" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contingency Scenarios" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.costResponsibilityAllocationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost responsibility allocation method"@en ;
    rdfs:comment "Description of the methodology used to allocate study costs among applicants in cluster studies or between utility and applicant in individual studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_responsibility_allocation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Responsibility Allocation Method" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when the impact study record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.createdDateTime .
cmm:ImpactStudy.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when the impact study record was last modified. Tracks the most recent update to any field in the record."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ImpactStudy.loadFlowAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "load flow analysis performed flag"@en ;
    rdfs:comment "Boolean indicator of whether load flow analysis was performed to assess voltage and thermal impacts on the distribution or transmission system."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "load_flow_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Load Flow Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ImpactStudy.networkUpgradeCostEstimateAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrade cost estimate amount"@en ;
    rdfs:comment "Estimated total cost of required network upgrades identified in the impact study. Expressed in USD. Critical for applicant financial feasibility assessment."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "network_upgrade_cost_estimate_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Upgrade Cost Estimate Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ImpactStudy.networkUpgradesDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrades description"@en ;
    rdfs:comment "Detailed description of the network upgrades identified as necessary by the impact study. Includes equipment additions, replacements, and system modifications."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "network_upgrades_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Upgrades Description" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.networkUpgradesRequiredFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrades required flag"@en ;
    rdfs:comment "Boolean indicator of whether the study identified network upgrades as necessary for safe and reliable interconnection. True if upgrades are required."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "network_upgrades_required_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Network Upgrades Required Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ImpactStudy.poiSpecification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "poi specification"@en ;
    rdfs:comment "Detailed specification of the Point of Interconnection (POI) where the DER will connect to the utility grid. Includes voltage level, substation, and feeder information."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "poi_specification" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Point of Interconnection (POI) Specification" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.protectionCoordinationReviewFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protection coordination review flag"@en ;
    rdfs:comment "Boolean indicator of whether protection coordination review was performed to ensure proper operation of protective devices with the new DER interconnection."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "protection_coordination_review_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Protection Coordination Review Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ImpactStudy.recordSourceSystem a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "record source system"@en ;
    rdfs:comment "Name of the source system from which this impact study record originated, such as interconnection queue management system or CIS module."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "record_source_system" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Record Source System" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.regulatoryJurisdiction a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory jurisdiction"@en ;
    rdfs:comment "Regulatory jurisdiction governing the interconnection study process, such as FERC for wholesale or state PUC for retail interconnections."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "regulatory_jurisdiction" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Regulatory Jurisdiction" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.shortCircuitAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "short circuit analysis performed flag"@en ;
    rdfs:comment "Boolean indicator of whether short circuit analysis was performed as part of the impact study. Required for system impact and facilities studies."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "short_circuit_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Short Circuit Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ImpactStudy.stabilityAnalysisPerformedFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "stability analysis performed flag"@en ;
    rdfs:comment "Boolean indicator of whether transient or dynamic stability analysis was performed for larger interconnections that may impact grid stability."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "stability_analysis_performed_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Stability Analysis Performed Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:ImpactStudy.studyActualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study actual completion date"@en ;
    rdfs:comment "Actual date when the impact study was completed and results delivered. Used to track adherence to regulatory timelines and SLA compliance."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_actual_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Actual Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.studyAgreementExecutedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study agreement executed date"@en ;
    rdfs:comment "Date when the study agreement was executed between the utility and the interconnection applicant. Formalizes the study scope and cost responsibility."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_agreement_executed_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Agreement Executed Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.studyContractor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study contractor"@en ;
    rdfs:comment "Name of the organization conducting the impact study. May be utility internal engineering team or third-party consultant."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_contractor" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Contractor" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.studyContractorType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study contractor type"@en ;
    rdfs:comment "Classification of the study contractor as utility internal resources, third-party consultant, or ISO/RTO staff."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_contractor_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Contractor Type" ;
    cmm:validValues "utility_internal|third_party_consultant|iso_rto" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.studyCostCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for study cost amounts. Typically USD for North American utilities."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ImpactStudy.studyCostEstimateAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study cost estimate amount"@en ;
    rdfs:comment "Estimated total cost to conduct the impact study, including engineering analysis, modeling, and reporting. Expressed in USD."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "study_cost_estimate_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Cost Estimate Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ImpactStudy.studyDepositAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study deposit amount"@en ;
    rdfs:comment "Deposit amount paid by the applicant to initiate the impact study. Typically applied against final study costs. Expressed in USD."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "study_deposit_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Deposit Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:ImpactStudy.studyDepositReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study deposit received date"@en ;
    rdfs:comment "Date when the study deposit was received from the applicant. Triggers the start of the study timeline in many jurisdictions."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_deposit_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Deposit Received Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.studyFindingsSummary a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study findings summary"@en ;
    rdfs:comment "Executive summary of the impact study findings, including key conclusions, identified issues, and recommended next steps for interconnection approval."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_findings_summary" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Findings Summary" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.studyInitiationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study initiation date"@en ;
    rdfs:comment "Date when the impact study was formally initiated. Marks the start of the study timeline and triggers contractual obligations."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_initiation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Initiation Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.studyNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study number"@en ;
    rdfs:comment "Business identifier for the impact study, typically assigned by the utility or ISO/RTO. Used for external communication and tracking."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:ImpactStudy.studyReportDocumentReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study report document reference"@en ;
    rdfs:comment "Reference to the formal impact study report document, typically stored in a document management system. Used for audit trail and regulatory compliance."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_report_document_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Report Document Reference" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.studyScopeDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study scope description"@en ;
    rdfs:comment "Detailed description of the study scope including affected network segments, contingency scenarios, and analysis boundaries. Defines what will be evaluated in the impact study."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_scope_description" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Scope Description" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.studyStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study status"@en ;
    rdfs:comment "Current lifecycle status of the impact study. Tracks progression from initiation through completion or cancellation."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Status" ;
    cmm:validValues "pending|in_progress|on_hold|completed|cancelled|superseded" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:ImpactStudy.studyTargetCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study target completion date"@en ;
    rdfs:comment "Target date for completion of the impact study as defined by interconnection agreement or regulatory timeline requirements."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:date ;
    cmm:physicalColumn "study_target_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Study Target Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:ImpactStudy.studyToApplication a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study to application"@en ;
    rdfs:comment "FK to interconnection.interconnection_application.interconnection_application_id — Impact studies are ordered for applications that fail screening. This FK links the study results back to the originating application. Essential for tracking study status and costs per application."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:long ;
    cmm:physicalColumn "study_to_application" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:ImpactStudy.studyType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "study type"@en ;
    rdfs:comment "Classification of the impact study type per FERC Order 2023 or state PUC rules. Determines the scope and depth of analysis required for grid interconnection approval."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "study_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Study Type" ;
    cmm:validValues "feasibility_study|system_impact_study|facilities_study|cluster_feasibility_study|cluster_system_impact_study|cluster_facilities_study" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:ImpactStudy.technicalFeasibilityDetermination a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "technical feasibility determination"@en ;
    rdfs:comment "Overall determination of technical feasibility for the proposed interconnection based on study results. Drives approval or rejection decision."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "technical_feasibility_determination" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Technical Feasibility Determination" ;
    cmm:validValues "feasible|feasible_with_upgrades|not_feasible|requires_further_study" ;
    cmm:cimDatatype "String" .
cmm:ImpactStudy.upgradeCostCurrencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "upgrade cost currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for network upgrade cost amounts. Typically USD for North American utilities."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:string ;
    cmm:physicalColumn "upgrade_cost_currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Upgrade Cost Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:ImpactStudy.voltageLevelKv a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "voltage level kv"@en ;
    rdfs:comment "Voltage level at the Point of Interconnection expressed in kilovolts (kV). Critical parameter for equipment specification and protection coordination."@en ;
    rdfs:domain cmm:ImpactStudy ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "voltage_level_kv" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Voltage Level (kV)" ;
    cmm:unitSymbol "V" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "Voltage" .

cmm:NetworkUpgrade a owl:Class ;
    rdfs:label "Network Upgrade"@en ;
    rdfs:comment "Record of a distribution or transmission network upgrade identified as required to accommodate one or more DER interconnections. Captures upgrade type (transformer upsizing, line reconductoring, protection relay replacement/addition, voltage regulator addition, capacitor bank addition, communication infrastructure for transfer trip), affected asset (feeder, transformer, substation, circuit segment), estimated cost, applicant-funded vs. utility-funded vs. shared cost split (references fee product for detailed cost responsibility allocation), upgrade status (identified, designed, permitted, contracted, in-progress, completed, cancelled), required completion date, actual completion date, and final settled cost. Tracks the physical grid improvements needed to enable safe DER integration and drives capital project initiation in the asset domain."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Project ;
    cmm:cimCloseMatch cim:Project ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::InfWork" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-6" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.technical_review ;
    cmm:physicalTable "utility_cmm_silver.interconnection.network_upgrade" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Distribution Interconnection Network Upgrade" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.network_upgrade" ;
    owl:hasKey ( cmm:NetworkUpgrade.networkUpgradeId ) .

cmm:NetworkUpgrade.networkUpgradeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "network upgrade id"@en ;
    rdfs:comment "Unique identifier for the network upgrade record. Primary key for the network upgrade entity."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:long ;
    cmm:physicalColumn "network_upgrade_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Network Upgrade Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:NetworkUpgrade.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Network upgrades are ultimately required by specific applications (or groups of applications in cluster studies). This FK enables cost allocation back to the responsible applicant(s)."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_application_id" ;
    cmm:cimAssociation "Project.Request" .
cmm:NetworkUpgrade.capacityRequirement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capacity requirement"@en ;
    rdfs:comment "Foreign key linking to forecast.capacity_requirement. Business justification: Network upgrades triggered by DER interconnection affect capacity requirement calculations and resource adequacy assessments. Planning process - upgrades increase available capacity and must be reflec"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:CapacityRequirement ;
    cmm:physicalColumn "capacity_requirement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capacity Requirement Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_capacity_requirement_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:NetworkUpgrade.capitalProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "capital project"@en ;
    rdfs:comment "Reference to the capital project record in the asset management domain that tracks the execution of this network upgrade. Links interconnection-driven upgrades to capital planning and execution."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:CapitalProject ;
    cmm:physicalColumn "capital_project_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Capital Project Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_capital_project_id" ;
    cmm:cimAssociation "Project.Project" .
cmm:NetworkUpgrade.contingency a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "contingency"@en ;
    rdfs:comment "Foreign key linking to grid.contingency. Business justification: Network upgrades are often driven by specific contingency analysis violations that DER interconnection would cause. Links upgrade requirements to the contingency scenario that triggered the need, supp"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:Contingency ;
    cmm:physicalColumn "contingency_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Contingency Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_contingency_id" ;
    cmm:cimAssociation "Project.Contingency" .
cmm:NetworkUpgrade.costCenter a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "cost center"@en ;
    rdfs:comment "Foreign key linking to finance.cost_center. Business justification: Network upgrade costs (design, construction, project management) are allocated to responsible cost centers for internal accounting, departmental budgeting, overhead allocation, and cost recovery track"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:CostCenter ;
    cmm:physicalColumn "cost_center_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Cost Center Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_cost_center_id" ;
    cmm:cimAssociation "Project.Organisation" .
cmm:NetworkUpgrade.feeder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "feeder"@en ;
    rdfs:comment "Foreign key linking to distribution.feeder. Business justification: Network upgrades triggered by interconnection applications target specific distribution feeders for capacity expansion, protection coordination, or voltage regulation improvements. Capital project tra"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:Feeder ;
    cmm:physicalColumn "feeder_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Feeder Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_feeder_id" ;
    cmm:cimAssociation "Project.Feeder" .
cmm:NetworkUpgrade.impactStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "impact study"@en ;
    rdfs:comment "FK to interconnection.impact_study.impact_study_id — Network upgrades are identified BY impact studies. One study may identify multiple required upgrades. This FK traces upgrade requirements back to the study that identified them — critical for cost all"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:ImpactStudy ;
    cmm:physicalColumn "impact_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_impact_study_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:NetworkUpgrade.materialMaster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "material master"@en ;
    rdfs:comment "Foreign key linking to supply.material_master. Business justification: Network upgrades for interconnection (transformer replacements, conductor upgrades, protection equipment installations) consume utility materials from inventory. Capital project material planning and"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:MaterialMaster ;
    cmm:physicalColumn "material_master_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Material Master Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_material_master_id" ;
    cmm:cimAssociation "Project.ErpItemMaster" .
cmm:NetworkUpgrade.networkApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Network upgrades are required to accommodate specific DER interconnection applications. While identified through impact studies, the cost responsibility and completion tracking ties back to the origin"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "network_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_network_application_id" ;
    cmm:cimAssociation "Project.Request" .
cmm:NetworkUpgrade.networkImpactStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network_impact_study"@en ;
    rdfs:comment "FK to interconnection.impact_study.impact_study_id — Network upgrades are identified BY impact studies. The study determines what upgrades are needed and their cost estimates. This FK is essential for tracing upgrade requirements back to study findings."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:ImpactStudy ;
    cmm:physicalColumn "network_impact_study" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_network_impact_study" ;
    cmm:cimAssociation "Project.Document" .
cmm:NetworkUpgrade.networkImpactStudyRef a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network impact study"@en ;
    rdfs:comment "Reference to the interconnection impact study that identified the need for this network upgrade. Links to the engineering analysis that determined upgrade requirements."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:ImpactStudy ;
    cmm:physicalColumn "network_impact_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Impact Study Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_network_impact_study_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:NetworkUpgrade.networkInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network interconnection application"@en ;
    rdfs:comment "Reference to the interconnection request that triggered or is associated with this network upgrade. Links to the interconnection application that identified the need for this upgrade."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "network_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Request Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_network_interconnection_application_id" ;
    cmm:cimAssociation "Project.Request" .
cmm:NetworkUpgrade.networkSegment a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "network segment"@en ;
    rdfs:comment "Foreign key linking to distribution.network_segment. Business justification: Upgrades often target specific line segments (reconductoring, sectionalizing device installation, transformer additions). Work order planning, construction management, and as-built documentation requi"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:NetworkSegment ;
    cmm:physicalColumn "network_segment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Network Segment Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_network_segment_id" ;
    cmm:cimAssociation "Project.EquipmentContainer" .
cmm:NetworkUpgrade.projectManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "project manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Network upgrade projects require utility project manager assignment for capital project coordination, contractor oversight, budget tracking, and regulatory compliance reporting. Replaces denormalized"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "project_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Project Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_project_manager_employee_id" ;
    cmm:cimAssociation "Project.ErpPersonnel" .
cmm:NetworkUpgrade.purchaseOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "purchase order"@en ;
    rdfs:comment "Foreign key linking to supply.purchase_order. Business justification: Network upgrades often require procurement of specialized equipment (distribution transformers, switchgear, protection relays, reconductoring materials) not available from stock. Utilities track procu"@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:PurchaseOrder ;
    cmm:physicalColumn "purchase_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Purchase Order Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_purchase_order_id" ;
    cmm:cimAssociation "Project.ErpPurchaseOrder" .
cmm:NetworkUpgrade.registry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "registry"@en ;
    rdfs:comment "Reference to the specific grid asset (feeder, transformer, substation, circuit segment) that requires upgrade. Links to the asset registry for detailed asset information."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:AssetRegistry ;
    cmm:physicalColumn "registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Affected Asset Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_registry_id" ;
    cmm:cimAssociation "Project.Asset" .
cmm:NetworkUpgrade.toImpactStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "to impact study"@en ;
    rdfs:comment "FK to interconnection.impact_study.impact_study_id — Network upgrades are identified BY impact studies. The study findings drive the upgrade requirements. This is the causal link between analysis and capital action."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:ImpactStudy ;
    cmm:physicalColumn "to_impact_study_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_to_impact_study_id" ;
    cmm:cimAssociation "Project.Document" .
cmm:NetworkUpgrade.workOrder a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "work order"@en ;
    rdfs:comment "Reference to the work order used to execute the network upgrade construction or installation. Links to field operations and maintenance management systems."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range cmm:WorkOrder ;
    cmm:physicalColumn "work_order_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Work Order Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_network_upgrade_work_order_id" ;
    cmm:cimAssociation "Project.Work" .
cmm:NetworkUpgrade.actualCompletionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual completion date"@en ;
    rdfs:comment "Date when the network upgrade was actually completed and placed in service. Used to track project delivery performance and enable DER energization."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:date ;
    cmm:physicalColumn "actual_completion_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Completion Date" ;
    cmm:cimDatatype "Date" .
cmm:NetworkUpgrade.actualCostAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "actual cost amount"@en ;
    rdfs:comment "Final settled cost of the completed network upgrade, in USD. Recorded after project completion and final invoicing. May differ from estimated cost."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "actual_cost_amount" ;
    cmm:sqlDataType "DECIMAL(18,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Actual Cost Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:NetworkUpgrade.affectedAssetType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected asset type"@en ;
    rdfs:comment "Type of grid asset that requires upgrade or modification. Categorizes the infrastructure component impacted by the DER interconnection. Reference-value candidates: feeder|transformer|substation|circuit_segment|transmission_line|distribution_line|protection_device|voltage_control_device."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_asset_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Affected Asset Type" ;
    cmm:cimDatatype "String" .
cmm:NetworkUpgrade.affectedSubstationName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "affected substation name"@en ;
    rdfs:comment "Name of the substation where the upgrade will be performed or that serves the affected circuit. Key geographic and operational reference point."@en ;
    rdfs:domain cmm:NetworkUpgrade ; rdfs:range xsd:string ;
    cmm:physicalColumn "affected_substation_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
