    rdfs:domain cmm:TransmissionConstraint ; rdfs:range cmm:TransmissionConstraint ;
    cmm:physicalColumn "parent_constraint_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
