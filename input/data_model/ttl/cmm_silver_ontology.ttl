cmm:RateSchedule.prepayEligible a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "prepay eligible"@en ;
    rdfs:comment "Indicates whether customers on this rate schedule are eligible for prepaid metering programs."@en ;
    rdfs:domain cmm:RateSchedule ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "prepay_eligible" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Prepay Eligible" ;
