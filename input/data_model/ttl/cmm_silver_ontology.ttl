    rdfs:comment "Indicates whether this penalty assessment was reported to the Board of Directors due to materiality or strategic significance."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "board_notification_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Board of Directors Notification Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:PenaltyAssessment.complianceHistoryFactor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "compliance history factor"@en ;
    rdfs:comment "Whether the utility's compliance history was considered an aggravating, neutral, or mitigating factor in penalty calculation."@en ;
    rdfs:domain cmm:PenaltyAssessment ; rdfs:range xsd:string ;
    cmm:physicalColumn "compliance_history_factor" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Compliance History Factor" ;
    cmm:validValues "aggravating|neutral|mitigating" ;
    cmm:cimDatatype "String" .
cmm:PenaltyAssessment.contestFilingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contest filing date"@en ;
