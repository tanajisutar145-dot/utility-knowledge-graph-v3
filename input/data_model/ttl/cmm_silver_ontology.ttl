cmm:SelfReport.regionalEntityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regional entity code"@en ;
    rdfs:comment "Code identifying the NERC Regional Entity with jurisdiction over this self-report, if applicable to bulk electric system reliability standards. Reference-value candidates: WECC|NPCC|MRO|SERC|RF|TRE|SPP|FRCC."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:string ;
    cmm:physicalColumn "regional_entity_code" ;
