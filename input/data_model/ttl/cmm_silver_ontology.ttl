cmm:IncentiveApplication.estimatedAnnualGenerationMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "estimated annual generation mwh"@en ;
    rdfs:comment "Projected annual energy generation from the renewable energy system in megawatt-hours."@en ;
