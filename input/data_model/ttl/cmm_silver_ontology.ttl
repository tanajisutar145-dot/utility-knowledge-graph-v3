cmm:NetworkFeature a owl:Class ;
    rdfs:label "Network Feature"@en ;
    rdfs:comment "Esri ArcGIS Utility Network feature registry aligned to CIM: each GIS network feature (device, junction, line, assembly, structure, subnet line) mapped to its canonical entity, CIM class and Location. Carries UN asset group/type, tier, subnetwork and lifecycle."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:PowerSystemResource ;
    cmm:cimExtends cim:PowerSystemResource ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:gis ;
