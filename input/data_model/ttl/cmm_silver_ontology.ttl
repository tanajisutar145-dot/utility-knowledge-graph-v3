    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:date ;
    cmm:physicalColumn "review_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Review Start Date" ;
    cmm:cimDatatype "Date" .
cmm:IncentiveApplication.serviceTerritoryCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "service territory code"@en ;
    rdfs:comment "Utility service territory identifier where the renewable energy project is located."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:string ;
    cmm:physicalColumn "service_territory_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Service Territory Code" ;
    cmm:cimDatatype "String" .
cmm:IncentiveApplication.totalPaidAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total paid amount"@en ;
    rdfs:comment "Cumulative dollar amount of incentive payments disbursed to date."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_paid_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Paid Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IncentiveApplication.totalProjectCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total project cost"@en ;
    rdfs:comment "Total estimated cost of the renewable energy project including equipment, installation, and permitting."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_project_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Project Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:IncentiveApplication.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when the incentive application record was last modified."@en ;
    rdfs:domain cmm:IncentiveApplication ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .

cmm:GreenTariffSubscription a owl:Class ;
    rdfs:label "Green Tariff Subscription"@en ;
    rdfs:comment "Customer subscription record for utility green tariff, community solar, or renewable choice programs where customers elect to source a percentage or fixed volume of their electricity from renewable sources. Captures customer account reference, program name (Green Power, Community Solar, 100% Renewable), subscription percentage or block size (kWh/month), premium rate ($/kWh), subscription start/end date, REC retirement on behalf of customer flag, allocation method (pro-rata, fixed block), and subscription status. SSOT for green tariff and community solar program enrollment within the renewable domain. Supports program management, REC retirement tracking, and customer billing premium calculations."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:CustomerAgreement ;
    cmm:cimCloseMatch cim:CustomerAgreement ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::Customers" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.program_incentives ;
    cmm:physicalTable "utility_cmm_silver.renewable.green_tariff_subscription" ;
    cmm:dataClassification "master_data" ;
    cmm:standardReference "State PUC Green Tariff / Community Solar Program" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.green_tariff_subscription" ;
    owl:hasKey ( cmm:GreenTariffSubscription.greenTariffSubscriptionId ) .

cmm:GreenTariffSubscription.greenTariffSubscriptionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "green tariff subscription id"@en ;
    rdfs:comment "Unique identifier for the green tariff subscription record. Primary key for the green tariff subscription entity."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:long ;
    cmm:physicalColumn "green_tariff_subscription_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Green Tariff Subscription ID" ;
    cmm:cimDatatype "Integer" .
cmm:GreenTariffSubscription.customerAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer account"@en ;
    rdfs:comment "Reference to the customer account enrolled in the green tariff program. Links subscription to the customer account master record."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:CustomerAccount ;
    cmm:physicalColumn "customer_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Customer Account ID" ;
    cmm:sourceColumn "account_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_customer_account_id" ;
    cmm:cimAssociation "CustomerAgreement.CustomerAccount" .
cmm:GreenTariffSubscription.enrollmentProcessorEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment processor employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Green tariff enrollments require customer service representatives to verify eligibility, process applications, and configure billing systems for renewable energy premium charges. Tracks processor for"@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "enrollment_processor_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Enrollment Processor Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_enrollment_processor_employee_id" ;
    cmm:cimAssociation "CustomerAgreement.ErpPersonnel" .
cmm:GreenTariffSubscription.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Foreign key linking to compliance.obligation. Business justification: Green tariff programs must comply with regulatory requirements (tariff approval, RPS eligibility, consumer protection rules). Links subscription program to governing compliance obligation. Essential f"@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_obligation_id" ;
    cmm:cimAssociation "CustomerAgreement.Document" .
cmm:GreenTariffSubscription.powerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "power plant"@en ;
    rdfs:comment "Foreign key linking to generation.power_plant. Business justification: Green tariff programs allocate output from specific renewable power plants to subscribing customers for marketing authenticity and REC retirement. Customer programs teams track which facility serves e"@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Power Plant Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_power_plant_id" ;
    cmm:cimAssociation "CustomerAgreement.Plant" .
cmm:GreenTariffSubscription.receivable a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "receivable"@en ;
    rdfs:comment "Foreign key linking to finance.receivable. Business justification: Green tariff premiums create receivables separate from base rates; link enables revenue recognition, AR aging, and program-specific financial reporting for voluntary renewable energy programs and regu"@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:FinanceReceivable ;
    cmm:physicalColumn "receivable_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ar Item Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_receivable_id" ;
    cmm:cimAssociation "CustomerAgreement.ErpReceivable" .
cmm:GreenTariffSubscription.renewableFacilityPowerPlant a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable facility power plant"@en ;
    rdfs:comment "Reference to the specific renewable generation facility or portfolio of facilities supplying energy for this subscription. Links to renewable asset registry for community solar or dedicated facility programs."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:PowerPlant ;
    cmm:physicalColumn "renewable_facility_power_plant_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Facility ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_renewable_facility_power_plant_id" ;
    cmm:cimAssociation "CustomerAgreement.Plant" .
cmm:GreenTariffSubscription.renewableRecCertificate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable rec certificate"@en ;
    rdfs:comment "FK to renewable.renewable_rec_certificate.renewable_rec_certificate_id — Green tariff subscriptions require REC retirement on behalf of the customer. The subscription must link to the RECs retired to substantiate the renewable claim."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range cmm:RenewableRecCertificate ;
    cmm:physicalColumn "renewable_rec_certificate_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_green_tariff_subscription_renewable_rec_certificate_id" ;
    cmm:cimAssociation "CustomerAgreement.Document" .
cmm:GreenTariffSubscription.allocationMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "allocation method"@en ;
    rdfs:comment "Method used to allocate renewable energy to the customer account. Pro-rata allocates based on usage proportion, fixed block allocates a set kWh amount, percentage-based allocates a percentage of total usage, full usage covers 100% of customer consumption."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "allocation_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Allocation Method" ;
    cmm:validValues "pro_rata|fixed_block|percentage_based|full_usage" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.autoRenewalFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "auto renewal flag"@en ;
    rdfs:comment "Indicates whether the subscription automatically renews at the end of the contract term. True means subscription continues unless customer cancels, false means subscription expires at term end."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "auto_renewal_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Auto Renewal Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GreenTariffSubscription.billingCycleDay a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "billing cycle day"@en ;
    rdfs:comment "Day of month when green tariff charges are calculated and applied to customer bill. Aligns with customer account billing cycle for premium charge calculation."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:int ;
    cmm:physicalColumn "billing_cycle_day" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Billing Cycle Day" ;
    cmm:cimDatatype "Integer" .
cmm:GreenTariffSubscription.blockSizeKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "block size kwh"@en ;
    rdfs:comment "Fixed quantity of renewable energy in kilowatt-hours (kWh) allocated per billing period when using fixed block allocation method. Common block sizes are 100 kWh, 200 kWh, or 500 kWh per month."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "block_size_kwh" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Block Size Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GreenTariffSubscription.cancellationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation date"@en ;
    rdfs:comment "Date when the customer cancelled or terminated the green tariff subscription. Populated only for cancelled or expired subscriptions."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "cancellation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.cancellationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cancellation reason"@en ;
    rdfs:comment "Reason provided by customer or system for subscription cancellation. Examples include cost concerns, relocation, dissatisfaction with program, account closure, or program termination."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "cancellation_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cancellation Reason" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.contractTermMonths a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract term months"@en ;
    rdfs:comment "Duration of the subscription commitment in months. Defines the minimum enrollment period before customer can cancel without penalty."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:int ;
    cmm:physicalColumn "contract_term_months" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract Term Months" ;
    cmm:unitSymbol "month" ;
    cmm:cimDatatype "Integer" .
cmm:GreenTariffSubscription.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this green tariff subscription record was first created in the system. Used for audit trail and data lineage tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:CustomerAgreement.createdDateTime .
cmm:GreenTariffSubscription.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "Three-letter ISO 4217 currency code for all monetary amounts in this subscription record. Typically USD for US utilities."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:valuePattern "^[A-Z]{3}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:GreenTariffSubscription.customerAllocatedCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "customer allocated capacity kw"@en ;
    rdfs:comment "Generation capacity in kilowatts (kW) allocated to this specific customer subscription. Used in community solar programs where customers subscribe to a share of facility capacity."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "customer_allocated_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Customer Allocated Capacity Kilowatt (kW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:GreenTariffSubscription.enrollmentChannel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment channel"@en ;
    rdfs:comment "Channel through which the customer enrolled in the green tariff program. Used for program marketing analysis and channel effectiveness tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_channel" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Channel" ;
    cmm:validValues "web_portal|mobile_app|call_center|in_person|mail|email" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date when the customer submitted enrollment application for the green tariff program. May differ from subscription_start_date due to processing time or waitlist periods."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.generationSourceType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "generation source type"@en ;
    rdfs:comment "Type of renewable energy generation technology sourcing this subscription. Identifies whether energy comes from solar, wind, hydroelectric, biomass, geothermal, or a mixed renewable portfolio."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "generation_source_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Generation Source Type" ;
    cmm:validValues "solar|wind|hydro|biomass|geothermal|mixed_renewable" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.jurisdictionCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "jurisdiction code"@en ;
    rdfs:comment "State or regulatory jurisdiction code governing this green tariff program. Two or three letter abbreviation identifying the Public Utility Commission (PUC) authority."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "jurisdiction_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Jurisdiction Code" ;
    cmm:valuePattern "^[A-Z]{2,3}$" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.lastBillingDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last billing date"@en ;
    rdfs:comment "Date of the most recent billing cycle where green tariff premium charges were calculated and applied to customer account."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "last_billing_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Billing Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.monthlyPremiumAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "monthly premium amount"@en ;
    rdfs:comment "Fixed monthly subscription fee for participation in the green tariff program. Charged in addition to or instead of per-kWh premium. Expressed in dollars."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "monthly_premium_amount" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Monthly Premium Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:GreenTariffSubscription.nemCreditEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nem credit eligible flag"@en ;
    rdfs:comment "Indicates whether this subscription qualifies for Net Energy Metering (NEM) bill credits. True for community solar and virtual net metering programs where generation credits offset customer usage charges."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "nem_credit_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Net Energy Metering (NEM) Credit Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GreenTariffSubscription.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-form text field for additional information, special conditions, or administrative notes related to this green tariff subscription. Used for customer service documentation and program management."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.comment .
cmm:GreenTariffSubscription.numberOfBlocks a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "number of blocks"@en ;
    rdfs:comment "Quantity of renewable energy blocks subscribed by the customer. Used with block_size_kwh to calculate total monthly renewable allocation."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:int ;
    cmm:physicalColumn "number_of_blocks" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Number of Blocks" ;
    cmm:cimDatatype "Integer" .
cmm:GreenTariffSubscription.premiumRatePerKwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "premium rate per kwh"@en ;
    rdfs:comment "Additional charge per kilowatt-hour (kWh) for renewable energy above standard electricity rates. Expressed in dollars per kWh. This premium funds renewable generation and REC procurement."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "premium_rate_per_kwh" ;
    cmm:sqlDataType "DECIMAL(10,6)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Premium Rate Per Kilowatt-Hour (kWh)" ;
    cmm:unitSymbol "Wh" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "RealEnergy" .
cmm:GreenTariffSubscription.programCapacityMw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program capacity mw"@en ;
    rdfs:comment "Total generation capacity in megawatts (MW) allocated to this green tariff program. Used for community solar and dedicated facility programs to track subscription against available capacity."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "program_capacity_mw" ;
    cmm:sqlDataType "DECIMAL(10,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Capacity Megawatt (MW)" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "M" ;
    cmm:cimDatatype "ActivePower" .
cmm:GreenTariffSubscription.programName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program name"@en ;
    rdfs:comment "Name of the green tariff or renewable energy program the customer has enrolled in. Identifies the specific utility renewable offering."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_name" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Name" ;
    cmm:validValues "Green Power|Community Solar|100% Renewable|Renewable Choice|Clean Energy Option|Solar Share" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.programType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program type"@en ;
    rdfs:comment "Classification of the renewable program structure. Distinguishes between utility green tariff, community solar subscription, renewable energy certificate (REC) purchase, or behind-the-meter (BTM) generation programs."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Type" ;
    cmm:validValues "green_tariff|community_solar|renewable_choice|rec_purchase|btm_generation" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.recRetirementFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec retirement flag"@en ;
    rdfs:comment "Indicates whether Renewable Energy Certificates (RECs) are retired on behalf of the customer as part of this subscription. True means RECs are retired for customer environmental claims, false means utility retains RECs for RPS compliance."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rec_retirement_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Retirement Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GreenTariffSubscription.recTrackingSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec tracking system code"@en ;
    rdfs:comment "Identifier for the REC tracking system registry where certificates are issued and retired. Examples include WREGIS, M-RETS, PJM-GATS, NEPOOL-GIS."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "rec_tracking_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Tracking System ID" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.rpsComplianceEligibleFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rps compliance eligible flag"@en ;
    rdfs:comment "Indicates whether renewable energy from this subscription counts toward utility Renewable Portfolio Standard (RPS) compliance obligations. False when RECs are retired for customer, true when utility retains RECs for compliance."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "rps_compliance_eligible_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Portfolio Standard (RPS) Compliance Eligible Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:GreenTariffSubscription.subscriptionEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription end date"@en ;
    rdfs:comment "Date when the green tariff subscription terminates or expires. Nullable for open-ended subscriptions without a fixed term."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "subscription_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Subscription End Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.subscriptionNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription number"@en ;
    rdfs:comment "Externally visible unique identifier for the green tariff subscription. Used in customer communications and billing statements."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "subscription_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Subscription Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:GreenTariffSubscription.subscriptionPercentage a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription percentage"@en ;
    rdfs:comment "Percentage of customer electricity usage sourced from renewable energy under this subscription. Ranges from 0.00 to 100.00 percent. Used when allocation method is percentage-based."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "subscription_percentage" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Subscription Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:GreenTariffSubscription.subscriptionRecRetirement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription rec retirement"@en ;
    rdfs:comment "FK to renewable.rec_certificate.rec_certificate_id — Green tariff subscriptions trigger REC retirements on behalf of the customer. Linking subscription to retired RECs supports audit trail and program integrity."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:long ;
    cmm:physicalColumn "subscription_rec_retirement" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimDatatype "Integer" .
cmm:GreenTariffSubscription.subscriptionStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription start date"@en ;
    rdfs:comment "Date when the green tariff subscription becomes effective and renewable energy allocation begins. Used for billing cycle alignment and REC retirement tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "subscription_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Subscription Start Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.subscriptionStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "subscription status"@en ;
    rdfs:comment "Current lifecycle status of the green tariff subscription. Indicates whether the subscription is actively providing renewable energy credits to the customer."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "subscription_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Subscription Status" ;
    cmm:validValues "active|pending|suspended|cancelled|expired|waitlisted" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:CustomerAgreement.status .
cmm:GreenTariffSubscription.tariffScheduleReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff schedule reference"@en ;
    rdfs:comment "Reference to the approved utility tariff schedule governing this green tariff program. Links to the official rate schedule filed with and approved by the Public Utility Commission (PUC)."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_schedule_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Schedule Reference" ;
    cmm:cimDatatype "String" .
cmm:GreenTariffSubscription.totalKwhAllocatedLifetime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total kwh allocated lifetime"@en ;
    rdfs:comment "Cumulative total kilowatt-hours (kWh) of renewable energy allocated to this customer subscription since enrollment. Used for customer reporting and program impact tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_kwh_allocated_lifetime" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Kilowatt-Hour (kWh) Allocated Lifetime" ;
    cmm:cimDatatype "Decimal" .
cmm:GreenTariffSubscription.totalPremiumPaidLifetime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total premium paid lifetime"@en ;
    rdfs:comment "Cumulative total premium amount paid by customer for this green tariff subscription since enrollment. Expressed in dollars. Used for customer value analysis and program revenue tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_premium_paid_lifetime" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Premium Paid Lifetime" ;
    cmm:cimDatatype "Decimal" .
cmm:GreenTariffSubscription.updatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "updated timestamp"@en ;
    rdfs:comment "Timestamp when this green tariff subscription record was last modified. Used for audit trail and change tracking."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:GreenTariffSubscription.waitlistEntryDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "waitlist entry date"@en ;
    rdfs:comment "Date when customer was placed on the program waitlist. Used to manage first-come-first-served allocation when capacity becomes available."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:date ;
    cmm:physicalColumn "waitlist_entry_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Waitlist Entry Date" ;
    cmm:cimDatatype "Date" .
cmm:GreenTariffSubscription.waitlistPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "waitlist position"@en ;
    rdfs:comment "Customer position in the program waitlist queue when subscription status is waitlisted. Populated only when program capacity is full and customer is awaiting availability."@en ;
    rdfs:domain cmm:GreenTariffSubscription ; rdfs:range xsd:int ;
    cmm:physicalColumn "waitlist_position" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Waitlist Position" ;
    cmm:cimDatatype "Integer" .

cmm:DerProgramEnrollment a owl:Class ;
    rdfs:label "Der Program Enrollment"@en ;
    rdfs:comment "This association product represents the enrollment contract between a distributed energy resource and a demand response program. It captures the business relationship where a single DER asset participates in multiple DR programs simultaneously (e.g., ISO capacity market, utility peak-time rebate, emergency DR, VPP aggregation), each with distinct contract terms, capacity commitments, settlement rules, and performance history. Each record links one DER to one DR program with enrollment-specific attributes including dates, capacity commitments, participation rates, incentive payments, and opt-out history that exist only in the context of this specific enrollment relationship.. Existence Justification: In energy utilities operations, a single DER asset (e.g., solar+storage system) routinely enrolls in multiple demand response programs simultaneously to optimize revenue and meet grid service obligations. For example, a battery storage system may be enrolled in an ISO capacity market program, a utility peak-time rebate program, an emergency DR program, and a VPP aggregation program at the same time. Each enrollment is a distinct business contract with its own capacity commitment, settlement rules, term dates, performance tracking, and incentive payments. The business actively manages this portfolio of enrollments per asset, tracking enrollment status, participation rates, opt-out history, and cumulative payments for each DER-program combination."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.program_incentives ;
    cmm:physicalTable "utility_cmm_silver.renewable.der_program_enrollment" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.der_program_enrollment" ;
    owl:hasKey ( cmm:DerProgramEnrollment.derProgramEnrollmentId ) .

cmm:DerProgramEnrollment.derProgramEnrollmentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der program enrollment id"@en ;
    rdfs:comment "Unique identifier for this specific enrollment relationship between a DER and a DR program. Primary key."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:long ;
    cmm:physicalColumn "der_program_enrollment_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "DER Program Enrollment Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:DerProgramEnrollment.derRegistry a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "der registry"@en ;
    rdfs:comment "Foreign key linking to the distributed energy resource enrolled in this DR program"@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range cmm:DerRegistry ;
    cmm:physicalColumn "der_registry_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Program Enrollment - Der Registry Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_program_enrollment_der_registry_id" ;
    cmm:cimAssociation "IdentifiedObject.PowerElectronicsConnection" .
cmm:DerProgramEnrollment.drProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dr program"@en ;
    rdfs:comment "Foreign key linking to the demand response program in which the DER is enrolled"@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range cmm:DrProgram ;
    cmm:physicalColumn "dr_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Der Program Enrollment - Dr Program Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_der_program_enrollment_dr_program_id" ;
    cmm:cimAssociation "IdentifiedObject.DemandResponseProgram" .
cmm:DerProgramEnrollment.enrolledCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrolled capacity kw"@en ;
    rdfs:comment "Committed load reduction or generation capacity in kilowatts that this specific DER has enrolled for this specific DR program. May differ from nameplate capacity and varies by program based on contract terms."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "enrolled_capacity_kw" ;
    cmm:sqlDataType "DECIMAL(12,3)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrolled Capacity" ;
    cmm:unitSymbol "W" ;
    cmm:unitMultiplier "k" ;
    cmm:cimDatatype "ActivePower" .
cmm:DerProgramEnrollment.enrollmentDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:comment "Date when the DER was enrolled into this specific DR program. Marks the start of the enrollment relationship."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Date" ;
    cmm:cimDatatype "Date" .
cmm:DerProgramEnrollment.enrollmentStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment status"@en ;
    rdfs:comment "Current lifecycle status of this enrollment. Active indicates the DER is currently participating. Suspended indicates temporary pause. Terminated indicates enrollment has ended. Pending indicates enrollment is awaiting approval or activation."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "enrollment_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Enrollment Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.status .
cmm:DerProgramEnrollment.enrollmentTermEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment term end date"@en ;
    rdfs:comment "End date of the current enrollment contract term for this DER in this DR program. Null for open-ended enrollments. Used for contract expiration and renewal workflows."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_term_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Term End Date" ;
    cmm:cimDatatype "Date" .
cmm:DerProgramEnrollment.enrollmentTermStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "enrollment term start date"@en ;
    rdfs:comment "Start date of the current enrollment contract term for this DER in this DR program. Used for contract lifecycle management and renewal tracking."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "enrollment_term_start_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Enrollment Term Start Date" ;
    cmm:cimDatatype "Date" .
cmm:DerProgramEnrollment.optOutCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "opt out count"@en ;
    rdfs:comment "Number of times the DER owner has opted out of dispatched DR events for this program. Used to track compliance with program rules and assess penalties if applicable."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:int ;
    cmm:physicalColumn "opt_out_count" ;
    cmm:sqlDataType "INT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Opt-Out Count" ;
    cmm:cimDatatype "Integer" .
cmm:DerProgramEnrollment.participationRatePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "participation rate percent"@en ;
    rdfs:comment "Percentage of dispatched DR events for this program that this DER successfully participated in. Calculated as (events_participated / events_dispatched) * 100. Used for performance tracking and incentive settlement."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "participation_rate_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Participation Rate Percentage" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:DerProgramEnrollment.terminationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination date"@en ;
    rdfs:comment "Date when this enrollment was terminated. Null for active enrollments. Populated when enrollment_status transitions to Terminated."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:date ;
    cmm:physicalColumn "termination_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Termination Date" ;
    cmm:cimDatatype "Date" ;
    cmm:cimCloseMatch cim:DateTimeInterval.end .
cmm:DerProgramEnrollment.terminationReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "termination reason"@en ;
    rdfs:comment "Business reason for enrollment termination. Examples: Customer Request, Non-Performance, Program Ended, DER Decommissioned, Contract Expiration. Null for active enrollments."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:string ;
    cmm:physicalColumn "termination_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Termination Reason" ;
    cmm:cimDatatype "String" .
cmm:DerProgramEnrollment.totalIncentivePaymentsUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total incentive payments usd"@en ;
    rdfs:comment "Cumulative incentive payments in USD paid to the DER owner for participation in this specific DR program since enrollment. Aggregated from individual event settlements and capacity payments."@en ;
    rdfs:domain cmm:DerProgramEnrollment ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_incentive_payments_usd" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Incentive Payments" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .

cmm:BatteryVendorServiceAgreement a owl:Class ;
    rdfs:label "Battery Vendor Service Agreement"@en ;
    rdfs:comment "This association product represents the service contract relationship between battery storage assets and their vendors. Each battery storage system requires multiple vendors for different service types (battery OEM, inverter supplier, BMS provider, O&M contractor), and each vendor provides services to multiple battery assets. Each record captures vendor-specific contract terms, warranty coverage, and SLA commitments that exist only in the context of this specific asset-vendor relationship.. Existence Justification: In energy utilities operations, battery storage assets require multiple specialized vendors simultaneously: the battery cell OEM provides capacity warranty, the inverter supplier maintains power conversion equipment, the BMS provider supports control systems, and O&M contractors handle daily operations. Each vendor relationship has distinct contract terms, SLA commitments, warranty coverage types, and performance metrics. This is an operational M:N relationship that asset managers actively maintain, not an analytical correlation."@en ;
    rdfs:subClassOf cmm:CanonicalEntity ;
    cmm:cimExtends cim:IdentifiedObject ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61970::Core" ;
    cmm:cimStandard "IEC 61970-301" ;
    dcterms:subject cmmsa:renewable , cmmsa:renewable.asset_management ;
    cmm:physicalTable "utility_cmm_silver.renewable.battery_vendor_service_agreement" ;
    cmm:dataClassification "association_data" ;
    cmm:standardReference "Internal - M:N Association" ;
    cmm:sourceObject "energy_utilities_ecm.renewable.battery_vendor_service_agreement" ;
    owl:hasKey ( cmm:BatteryVendorServiceAgreement.batteryVendorServiceAgreementId ) .

cmm:BatteryVendorServiceAgreement.batteryVendorServiceAgreementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "battery vendor service agreement id"@en ;
    rdfs:comment "Unique identifier for this battery asset-vendor service agreement record. Primary key."@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range xsd:long ;
    cmm:physicalColumn "battery_vendor_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Battery Vendor Service Agreement ID" ;
    cmm:cimDatatype "Integer" .
cmm:BatteryVendorServiceAgreement.batteryStorageAsset a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "battery storage asset"@en ;
    rdfs:comment "Foreign key linking to the battery storage asset receiving vendor services"@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range cmm:BatteryStorageAsset ;
    cmm:physicalColumn "battery_storage_asset_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Battery Vendor Service Agreement - Battery Storage Asset Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_battery_vendor_service_agreement_battery_storage_asset_id" ;
    cmm:cimAssociation "IdentifiedObject.BatteryUnit" .
cmm:BatteryVendorServiceAgreement.vendor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "vendor"@en ;
    rdfs:comment "Foreign key linking to the vendor providing services to the battery asset"@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range cmm:Vendor ;
    cmm:physicalColumn "vendor_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Battery Vendor Service Agreement - Vendor Id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_renewable_battery_vendor_service_agreement_vendor_id" ;
    cmm:cimAssociation "IdentifiedObject.Organisation" .
cmm:BatteryVendorServiceAgreement.annualServiceFeeUsd a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "annual service fee usd"@en ;
    rdfs:comment "Annual recurring service fee charged by this vendor for this battery asset. Used for O&M cost forecasting and vendor cost comparison."@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "annual_service_fee_usd" ;
    cmm:sqlDataType "DECIMAL(12,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Annual Service Fee USD" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:BatteryVendorServiceAgreement.contractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contract end date"@en ;
    rdfs:comment "Expiration date of this vendor service contract. Critical for contract renewal planning and ensuring continuous service coverage for battery assets."@en ;
    rdfs:domain cmm:BatteryVendorServiceAgreement ; rdfs:range xsd:date ;
    cmm:physicalColumn "contract_end_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Contract End Date" ;
    cmm:cimDatatype "Date" .
