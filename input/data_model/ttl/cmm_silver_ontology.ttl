cmm:ContractorWorker.tradeClassification a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "trade classification"@en ;
    rdfs:comment "Primary skilled trade or craft classification of the contractor worker (e.g., lineman, electrician, welder, heavy equipment operator, relay technician, turbine technician, instrumentation technician). Reference-value candidates: lineman|electrician|welder|heavy_equipment_operator|relay_technician|turbine_technician|instrumentation_technician|substation_technician|meter_technician|civil_engineer|structural_engineer|environmental_specialist|safety_coordinator."@en ;
    rdfs:domain cmm:ContractorWorker ; rdfs:range xsd:string ;
