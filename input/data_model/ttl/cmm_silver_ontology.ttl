    cmm:sensitivity "financial" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:PlantVendorAgreement.contractEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
