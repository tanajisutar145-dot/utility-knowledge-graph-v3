cmm:IncentiveProgram.programStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program status"@en ;
    rdfs:comment "Current lifecycle status of the incentive program indicating whether it is accepting applications and issuing incentives."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Status" ;
    cmm:validValues "active|suspended|closed|pending_approval|expired" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.status .
cmm:IncentiveProgram.programType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program type"@en ;
    rdfs:comment "Classification of the incentive program. ITC = Investment Tax Credit, PTC = Production Tax Credit, SREC = Solar Renewable Energy Certificate, storage_incentive = battery/storage incentive, interconnection_rebate = grid connection rebate, green_tariff = voluntary renewable energy tariff."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Program Type" ;
    cmm:validValues "ITC|PTC|SREC|storage_incentive|interconnection_rebate|green_tariff" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Document.type .
cmm:IncentiveProgram.programWebsiteUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "program website url"@en ;
    rdfs:comment "Web address where customers and stakeholders can access detailed program information, application forms, and guidelines."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "program_website_url" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Program Website Uniform Resource Locator (URL)" ;
    cmm:cimDatatype "String" .
cmm:IncentiveProgram.recTrackingSystemCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "rec tracking system code"@en ;
    rdfs:comment "Identifier for the REC tracking system used to verify and retire RECs associated with this program (e.g., NEPOOL GIS, WREGIS, M-RETS, PJM GATS)."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:string ;
    cmm:physicalColumn "rec_tracking_system_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Renewable Energy Certificate (REC) Tracking System ID" ;
    cmm:cimDatatype "String" .
cmm:IncentiveProgram.requiresInterconnectionApproval a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requires interconnection approval"@en ;
    rdfs:comment "Indicates whether the participant must receive utility interconnection approval before receiving incentive payments."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "requires_interconnection_approval" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requires Interconnection Approval" ;
    cmm:cimDatatype "Boolean" .
cmm:IncentiveProgram.requiresRecTransfer a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "requires rec transfer"@en ;
    rdfs:comment "Indicates whether participants must transfer ownership of Renewable Energy Certificates (RECs) to the utility or program administrator as a condition of receiving incentives."@en ;
    rdfs:domain cmm:IncentiveProgram ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "requires_rec_transfer" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Requires Renewable Energy Certificate (REC) Transfer" ;
