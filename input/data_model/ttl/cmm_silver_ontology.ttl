cmm:TechnicalReview.derCapacityKw a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "der capacity kw"@en ;
    rdfs:comment "Nameplate capacity of the Distributed Energy Resource (DER) in kilowatts. Used for screening criteria evaluation (15% rule, 100% rule) and impact assessment."@en ;
