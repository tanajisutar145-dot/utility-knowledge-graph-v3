cmm:PowerPlant.emissionsRateCo2TonsPerMwh a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "emissions rate co2 tons per mwh"@en ;
    rdfs:comment "Average carbon dioxide emissions rate in tons per MWh of generation."@en ;
