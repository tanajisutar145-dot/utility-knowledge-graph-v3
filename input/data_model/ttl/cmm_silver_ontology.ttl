cmm:InterconnectionFee a owl:Class ;
    rdfs:label "Interconnection Fee"@en ;
    rdfs:comment "Master record for all financial obligations, fee transactions, and cost responsibility allocations between the utility and a DER interconnection applicant throughout the application lifecycle. Captures fee type (application fee, study deposit, supplemental study fee, inspection fee, facilities charge, standby charge), fee amount, invoice date, due date, payment received date, payment method, payment status (invoiced, paid, overdue, refunded), and applicable tariff schedule reference. Also serves as the SSOT for cost responsibility allocation — defining how interconnection-related costs (impact study costs, network upgrade costs, interconnection facilities costs) are split between applicant and utility, including cost category, total estimated cost, applicant share ($ and %), utility share ($ and %), cost allocation methodology (beneficiary pays, socialized, pro-rata), payment schedule, deposit amount collected, refund eligibility, and final settled cost. This is the single authoritative source for all interconnection-related monetary transactions, cost allocations, applicant invoicing, deposit tracking, refund processing, and capital cost recovery reporting."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Charge ;
    cmm:cimCloseMatch cim:Charge ;
    cmm:cimMappingLevel "close" ;
    cmm:cimPackage "IEC61968::PaymentMetering" ;
    cmm:cimStandard "IEC 61968-11 / IEC 61968-10" ;
    dcterms:subject cmmsa:interconnection , cmmsa:interconnection.agreement_finance ;
    cmm:physicalTable "utility_cmm_silver.interconnection.fee" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "Interconnection Application Fee / Study Deposit — Utility Tariff" ;
    cmm:sourceObject "energy_utilities_ecm.interconnection.fee" ;
    owl:hasKey ( cmm:InterconnectionFee.feeId ) .

cmm:InterconnectionFee.feeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fee id"@en ;
    rdfs:comment "Primary key for fee"@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:long ;
    cmm:physicalColumn "fee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Fee Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:InterconnectionFee.application a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — Fees and cost responsibilities are charged against a specific interconnection application. After cost_responsibility merge, fee is the single SSOT for all financial obligations tied to an application."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_application_id" ;
    cmm:cimAssociation "Charge.Request" .
cmm:InterconnectionFee.feeApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fee application"@en ;
    rdfs:comment "FK to interconnection.application.application_id — All interconnection fees are charged in the context of a specific application. After merging cost_responsibility into fee, this link carries both fee transactions and cost allocation records."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "fee_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_fee_application_id" ;
    cmm:cimAssociation "Charge.Request" .
cmm:InterconnectionFee.feeInterconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fee interconnection application"@en ;
    rdfs:comment "Reference to the interconnection application to which this fee applies. Links fee obligations to the specific DER interconnection request."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "fee_interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_fee_interconnection_application_id" ;
    cmm:cimAssociation "Charge.Request" .
cmm:InterconnectionFee.glAccount a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "gl account"@en ;
    rdfs:comment "Foreign key linking to finance.gl_account. Business justification: Interconnection fees (application fees, study deposits, upgrade cost recovery) are posted to specific GL accounts for revenue recognition, cash application, regulatory reporting, and FERC account clas"@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:GlAccount ;
    cmm:physicalColumn "gl_account_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Gl Account Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_gl_account_id" ;
    cmm:cimAssociation "Charge.ErpChartOfAccounts" .
cmm:InterconnectionFee.invoice a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "invoice"@en ;
    rdfs:comment "Foreign key linking to billing.invoice. Business justification: Interconnection fees (application fees, study deposits, inspection fees) are invoiced through the utility's standard billing system and appear on customer invoices. Business process: Interconnection f"@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:CustomerInvoice ;
    cmm:physicalColumn "invoice_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Invoice Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_invoice_id" ;
    cmm:cimAssociation "Charge.CustomerBillingInfo" .
cmm:InterconnectionFee.receivable a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "receivable"@en ;
    rdfs:comment "Foreign key linking to finance.receivable. Business justification: Interconnection fees billed to applicants create accounts receivable tracked in AR for cash collection, aging analysis, dunning, and write-off management. Essential for cash forecasting and DSO report"@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range cmm:FinanceReceivable ;
    cmm:physicalColumn "receivable_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Ar Item Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_interconnection_fee_receivable_id" ;
    cmm:cimAssociation "Charge.ErpReceivable" .
cmm:InterconnectionFee.amount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "Total monetary value of the fee obligation in USD. Represents the gross amount invoiced to the applicant before any payments or adjustments."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Fee Amount" ;
    cmm:cimDatatype "Decimal" .
cmm:InterconnectionFee.applicantCostShareAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicant cost share amount"@en ;
    rdfs:comment "Dollar amount of the total estimated cost allocated to the interconnection applicant. Represents the applicant's financial responsibility for interconnection work."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicant_cost_share_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicant Cost Share Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.applicantCostSharePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "applicant cost share percent"@en ;
    rdfs:comment "Percentage of the total estimated cost allocated to the applicant (0-100%). Calculated as (applicant_cost_share_amount / total_estimated_cost) * 100."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "applicant_cost_share_percent" ;
    cmm:sqlDataType "DECIMAL(5,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Applicant Cost Share Percent" ;
    cmm:unitSymbol "%" ;
    cmm:cimDatatype "PerCent" .
cmm:InterconnectionFee.costAllocationMethodology a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost allocation methodology"@en ;
    rdfs:comment "Method used to allocate interconnection-related costs between the applicant and the utility. Defines the cost-sharing framework per FERC Order 2003 and state tariff rules."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_allocation_methodology" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Allocation Methodology" ;
    cmm:validValues "beneficiary_pays|socialized|pro_rata|tariff_based|negotiated" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.costCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost category"@en ;
    rdfs:comment "Classification of the interconnection cost being allocated. Distinguishes between study costs, facility construction costs, and system upgrade costs. Reference-value candidates: impact_study|interconnection_facilities|network_upgrades|distribution_upgrades|transmission_upgrades|metering|protection|administrative."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Category" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.costCenterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center code"@en ;
    rdfs:comment "Cost center responsible for managing this fee transaction. Typically the interconnection services department or distributed generation operations group."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.costReconciliationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost reconciliation date"@en ;
    rdfs:comment "Date when final costs were reconciled against deposits and estimates. Triggers final invoicing or refund processing."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "cost_reconciliation_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Cost Reconciliation Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.createdTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "created timestamp"@en ;
    rdfs:comment "Timestamp when this fee record was first created in the system. Audit field for data lineage and compliance tracking."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "created_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Created Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Charge.createdDateTime .
cmm:InterconnectionFee.currencyCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "currency code"@en ;
    rdfs:comment "ISO 4217 three-letter currency code for the fee amount. Standardized to USD for domestic utility operations."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "currency_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Currency Code" ;
    cmm:validValues "USD" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Money.currency .
cmm:InterconnectionFee.depositAmountCollected a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "deposit amount collected"@en ;
    rdfs:comment "Total deposit amount collected from the applicant to secure interconnection work or study costs. Held in escrow until work is completed or application is withdrawn."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "deposit_amount_collected" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Deposit Amount Collected" ;
    cmm:cimDatatype "Decimal" .
cmm:InterconnectionFee.disputeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute flag"@en ;
    rdfs:comment "Indicates whether the applicant has formally disputed this fee. True if a dispute case has been opened; triggers dispute resolution workflow."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "dispute_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionFee.disputeReason a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute reason"@en ;
    rdfs:comment "Applicant's stated reason for disputing the fee. Captures the nature of the disagreement (amount, applicability, calculation methodology, tariff interpretation)."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "dispute_reason" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Reason" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.disputeResolutionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispute resolution date"@en ;
    rdfs:comment "Date the fee dispute was resolved. Null if dispute is still open. Resolution may result in fee adjustment, waiver, or confirmation of original amount."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "dispute_resolution_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Dispute Resolution Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.dueDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "due date"@en ;
    rdfs:comment "Date by which payment of the fee is required. Determined by tariff payment terms (typically 30 days from invoice date). Late payments may result in application suspension or penalties."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "due_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Due Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.feeCategory a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fee category"@en ;
    rdfs:comment "Categorization of the fee based on payment structure and refund eligibility. Distinguishes between upfront deposits, one-time charges, and ongoing service fees."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "fee_category" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fee Category" ;
    cmm:validValues "one_time|recurring|deposit|refundable|non_refundable" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Charge.kind .
cmm:InterconnectionFee.feeNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fee number"@en ;
    rdfs:comment "Business identifier for the fee transaction. Externally-known reference number used in invoicing, payment tracking, and customer correspondence."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "fee_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fee Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterconnectionFee.feeStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fee status"@en ;
    rdfs:comment "Current lifecycle status of the fee obligation. Tracks the fee from initial assessment through payment, refund, or cancellation. Reference-value candidates: pending|invoiced|partially_paid|paid|overdue|waived|refunded|cancelled|disputed."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "fee_status" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fee Status" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Charge.status .
cmm:InterconnectionFee.feeType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "fee type"@en ;
    rdfs:comment "Classification of the fee obligation. Defines the nature of the charge within the interconnection lifecycle (application processing, technical study, construction, ongoing service). Reference-value candidates: application_fee|study_deposit|supplemental_study_fee|inspection_fee|facilities_charge|standby_charge|interconnection_facilities_cost|network_upgrade_cost|impact_study_cost|witness_test_fee|commissioning_fee|administrative_fee."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "fee_type" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fee Type" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Charge.kind .
cmm:InterconnectionFee.finalSettledCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "final settled cost"@en ;
    rdfs:comment "Actual final cost of the interconnection work or study after completion. Used to reconcile deposits and determine final applicant payment or refund amounts."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "final_settled_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Final Settled Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.lastModifiedBy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified by"@en ;
    rdfs:comment "User ID or system identifier that last modified this fee record. Audit field for accountability and compliance tracking."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "last_modified_by" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Last Modified By" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.lastModifiedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last modified timestamp"@en ;
    rdfs:comment "Timestamp when this fee record was last updated. Audit field for change tracking and data lineage."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_modified_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Modified Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:InterconnectionFee.notes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "notes"@en ;
    rdfs:comment "Free-text field for additional context, special instructions, or clarifications related to this fee. Used for documenting non-standard situations, payment arrangements, or regulatory exceptions."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "notes" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Fee Notes" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:IdentifiedObject.description .
cmm:InterconnectionFee.outstandingBalance a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "outstanding balance"@en ;
    rdfs:comment "Remaining unpaid amount for this fee (fee_amount minus payment_amount). Zero indicates full payment; positive values indicate amounts due."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "outstanding_balance" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Outstanding Balance" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.paymentAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment amount"@en ;
    rdfs:comment "Total amount paid by the applicant toward this fee obligation. May differ from fee_amount if partial payments or overpayments occur."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "payment_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.paymentMethod a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment method"@en ;
    rdfs:comment "Financial instrument used by the applicant to remit payment. Determines processing time and reconciliation procedures. Reference-value candidates: check|wire_transfer|ach|credit_card|debit_card|cash|money_order."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_method" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Method" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.paymentReceivedDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment received date"@en ;
    rdfs:comment "Date the utility received payment for this fee. Used to calculate payment timeliness and release application holds."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "payment_received_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Payment Received Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.paymentReferenceNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "payment reference number"@en ;
    rdfs:comment "External reference number from the payment transaction (check number, wire confirmation, ACH trace number). Used for payment reconciliation and dispute resolution."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "payment_reference_number" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Payment Reference Number" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:InterconnectionFee.refundAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund amount"@en ;
    rdfs:comment "Amount refunded to the applicant for this fee. Applies to refundable deposits or overpayments. Null if no refund has been issued."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "refund_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.refundDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund date"@en ;
    rdfs:comment "Date the refund was processed and issued to the applicant. Null if no refund has been issued."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "refund_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.refundEligibilityFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "refund eligibility flag"@en ;
    rdfs:comment "Indicates whether this fee is eligible for refund under tariff rules. True for refundable deposits; false for non-refundable application fees and administrative charges."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "refund_eligibility_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Refund Eligibility Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:InterconnectionFee.tariffEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff effective date"@en ;
    rdfs:comment "Effective date of the tariff schedule under which this fee was assessed. Ensures fee amounts comply with the tariff version in effect at the time of application."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:date ;
    cmm:physicalColumn "tariff_effective_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Effective Date" ;
    cmm:cimDatatype "Date" .
cmm:InterconnectionFee.tariffScheduleReference a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tariff schedule reference"@en ;
    rdfs:comment "Reference to the applicable utility tariff schedule or rate schedule that governs this fee. Identifies the regulatory authority and fee structure (e.g., Electric Rule 21, Schedule DG)."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:string ;
    cmm:physicalColumn "tariff_schedule_reference" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Tariff Schedule Reference" ;
    cmm:cimDatatype "String" .
cmm:InterconnectionFee.totalEstimatedCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total estimated cost"@en ;
    rdfs:comment "Total estimated cost for the interconnection work or study associated with this fee. Represents the full project cost before allocation between applicant and utility."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "total_estimated_cost" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Total Estimated Cost" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.utilityCostShareAmount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility cost share amount"@en ;
    rdfs:comment "Dollar amount of the total estimated cost allocated to the utility. Represents the utility's financial responsibility for interconnection work, typically for system upgrades that benefit multiple customers."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_cost_share_amount" ;
    cmm:sqlDataType "DECIMAL(15,2)" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Utility Cost Share Amount" ;
    cmm:unitSymbol "USD" ;
    cmm:cimDatatype "Money" .
cmm:InterconnectionFee.utilityCostSharePercent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "utility cost share percent"@en ;
    rdfs:comment "Percentage of the total estimated cost allocated to the utility (0-100%). Calculated as (utility_cost_share_amount / total_estimated_cost) * 100."@en ;
    rdfs:domain cmm:InterconnectionFee ; rdfs:range xsd:decimal ;
    cmm:physicalColumn "utility_cost_share_percent" ;
