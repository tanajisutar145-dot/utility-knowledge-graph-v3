    cmm:cimDatatype "String" .
cmm:NemCredit.touPeriodCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "tou period code"@en ;
    rdfs:comment "Time-of-use period classification for exported energy, affecting credit rate when NEM tariff includes TOU differentiation."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:string ;
    cmm:physicalColumn "tou_period_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Time of Use (TOU) Period Code" ;
    cmm:cimDatatype "String" .
cmm:NemCredit.trueUpPeriodFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "true up period flag"@en ;
    rdfs:comment "Indicates whether this credit transaction is part of an annual true-up reconciliation period where unused credits are settled or forfeited."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "true_up_period_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "True-Up Period Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:NemCredit.trueUpSettlementDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "true up settlement date"@en ;
    rdfs:comment "Date of the annual true-up settlement when cumulative NEM credits are reconciled and excess credits are either paid out or forfeited per tariff rules."@en ;
    rdfs:domain cmm:NemCredit ; rdfs:range xsd:date ;
    cmm:physicalColumn "true_up_settlement_date" ;
    cmm:sqlDataType "DATE" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "True-Up Settlement Date" ;
    cmm:cimDatatype "Date" .

cmm:AssistanceProgram a owl:Class ;
    rdfs:label "Assistance Program"@en ;
    rdfs:comment "Reference and transactional entity defining utility-administered financial assistance programs and tracking individual customer enrollments. At the program level: captures program name (LIHEAP, CARE, FERA, arrearage management), eligibility criteria, benefit type (discount rate, bill credit, arrearage forgiveness), maximum benefit amount, funding source, regulatory mandate, and program period. At the enrollment level: captures enrollment date, enrolled service agreement, program type, eligibility verification status, benefit amount, enrollment expiration date, re-certification due date, disenrollment reason, and enrollment status. Sourced from Oracle CC&B program management and SAP IS-U. SSOT for all financial assistance program definitions and customer enrollment records. Supports PUC low-income program compliance reporting and customer affordability tracking."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:billing , cmmsa:billing.revenue_recognition ;
    cmm:physicalTable "utility_cmm_silver.billing.assistance_program" ;
    cmm:dataClassification "reference_data" ;
    cmm:standardReference "LIHEAP; Low-Income Assistance Program / LIHEAP / CARE Program" ;
    cmm:sourceObject "energy_utilities_ecm.billing.assistance_program" ;
    owl:hasKey ( cmm:AssistanceProgram.assistanceProgramId ) .

cmm:AssistanceProgram.assistanceProgramId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "assistance program id"@en ;
    rdfs:comment "Primary key for assistance_program"@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range xsd:long ;
    cmm:physicalColumn "assistance_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Assistance Program Identifier" ;
    cmm:cimDatatype "Integer" .
cmm:AssistanceProgram.billingServiceAgreement a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing service agreement"@en ;
    rdfs:comment "Reference to the service agreement receiving the assistance program benefit."@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range cmm:BillingServiceAgreement ;
    cmm:physicalColumn "billing_service_agreement_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Billing Service Agreement ID" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_assistance_program_billing_service_agreement_id" ;
    cmm:cimAssociation "Document.CustomerAgreement" .
cmm:AssistanceProgram.interconnectionApplication a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "interconnection application"@en ;
    rdfs:comment "Foreign key linking to interconnection.application. Business justification: Equity-focused interconnection programs (SGIP equity resiliency budget, community solar for low-income) coordinate with utility financial assistance programs. Business process: Eligibility verificatio"@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range cmm:InterconnectionApplication ;
    cmm:physicalColumn "interconnection_application_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Interconnection Application Id (Foreign Key)" ;
    cmm:sourceColumn "application_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_assistance_program_interconnection_application_id" ;
    cmm:cimAssociation "Document.Request" .
cmm:AssistanceProgram.irpScenario a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "irp scenario"@en ;
    rdfs:comment "Foreign key linking to forecast.irp_scenario. Business justification: Low-income assistance programs are designed and funded based on rate impact projections from IRP scenarios. Program budgets and eligibility thresholds reference specific IRP scenarios to ensure afford"@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range cmm:IrpScenario ;
    cmm:physicalColumn "irp_scenario_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Irp Scenario Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_assistance_program_irp_scenario_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:AssistanceProgram.regulatoryFiling a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "regulatory filing"@en ;
    rdfs:comment "Foreign key linking to compliance.regulatory_filing. Business justification: Low-income assistance programs require annual reporting to regulatory commissions on enrollment, costs, and effectiveness. Links the program to the regulatory filing where program performance and cost"@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range cmm:RegulatoryFiling ;
    cmm:physicalColumn "regulatory_filing_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Regulatory Filing Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_assistance_program_regulatory_filing_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:AssistanceProgram.renewableIncentiveProgram a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "renewable incentive program"@en ;
    rdfs:comment "Foreign key linking to renewable.incentive_program. Business justification: Low-income assistance programs often stack with renewable incentives for solar installations, energy efficiency, and green tariffs. Regulatory coordination required to ensure customers receive combine"@en ;
    rdfs:domain cmm:AssistanceProgram ; rdfs:range cmm:IncentiveProgram ;
    cmm:physicalColumn "renewable_incentive_program_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Renewable Incentive Program Id (Foreign Key)" ;
    cmm:sourceColumn "incentive_program_id" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_billing_assistance_program_renewable_incentive_program_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:AssistanceProgram.applicationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
