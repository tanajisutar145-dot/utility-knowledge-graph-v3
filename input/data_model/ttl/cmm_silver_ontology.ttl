    rdfs:domain cmm:LocationAssignment ; rdfs:range xsd:string ;
    cmm:physicalColumn "location_role" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Location Role" ;
    cmm:validValues "primary|service|mailing|work|installed|planned|historical|fault" ;
