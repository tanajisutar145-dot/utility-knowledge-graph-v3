cmm:ControlArea.lastUpdatedTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "last updated timestamp"@en ;
    rdfs:comment "Timestamp of the most recent update to this control area master record."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:dateTime ;
    cmm:physicalColumn "last_updated_timestamp" ;
    cmm:sqlDataType "TIMESTAMP" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Last Updated Timestamp" ;
    cmm:cimDatatype "DateTime" ;
    cmm:cimCloseMatch cim:Document.lastModifiedDateTime .
cmm:ControlArea.nercRegion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nerc region"@en ;
    rdfs:comment "NERC regional entity responsible for reliability oversight of this control area (e.g., WECC, NPCC, MRO, SERC, RF, TRE). Reference-value candidates: WECC|NPCC|MRO|SERC|RF|TRE|FRCC|SPP."@en ;
    rdfs:domain cmm:ControlArea ; rdfs:range xsd:string ;
    cmm:physicalColumn "nerc_region" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "North American Electric Reliability Corporation (NERC) Region" ;
