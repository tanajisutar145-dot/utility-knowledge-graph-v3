cmm:CostCenter.costCenterCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center code"@en ;
    rdfs:comment "Business identifier for the cost center. Alphanumeric code used in financial reporting and cost allocation. Typically follows organizational coding standards (e.g., GEN-001 for Generation, TRN-002 for Transmission)."@en ;
    rdfs:domain cmm:CostCenter ; rdfs:range xsd:string ;
    cmm:physicalColumn "cost_center_code" ;
    cmm:sqlDataType "STRING" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "close" ;
    cmm:businessTerm "Cost Center Code" ;
    cmm:valuePattern "^[A-Z0-9]{4,10}$" ;
    cmm:cimDatatype "String" ;
    cmm:cimCloseMatch cim:Name.name .
cmm:CostCenter.costCenterDescription a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cost center description"@en ;
