cmm:SelfReport a owl:Class ;
    rdfs:label "Self Report"@en ;
    rdfs:comment "Record of self-reported potential violations (SPVs) or compliance exceptions that the utility proactively discloses to regulators before being identified through audit, including NERC self-reports, FERC voluntary disclosures, and EPA self-disclosure submissions. Captures the self-report reference number, associated obligation or standard, disclosure date, regulatory recipient, violation description, root cause, and mitigation actions taken. Proactive self-reporting typically results in reduced penalties."@en ;
    rdfs:subClassOf cmm:CanonicalEntity , cim:Document ;
    cmm:cimExtends cim:Document ;
    cmm:cimMappingLevel "extension" ;
    cmm:cimPackage "IEC61968::Common" ;
    cmm:cimStandard "IEC 61968-11" ;
    dcterms:subject cmmsa:compliance , cmmsa:compliance.audit_management ;
    cmm:physicalTable "utility_cmm_silver.compliance.self_report" ;
    cmm:dataClassification "transactional_data" ;
    cmm:standardReference "NERC CMEP; NERC Self-Report Process; FERC Voluntary Compliance; EPA Audit Policy" ;
    cmm:sourceObject "energy_utilities_ecm.compliance.self_report" ;
    owl:hasKey ( cmm:SelfReport.selfReportId ) .

cmm:SelfReport.selfReportId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "self report id"@en ;
    rdfs:comment "Unique identifier for the self-reported potential violation or compliance exception. Primary key."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:long ;
    cmm:physicalColumn "self_report_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable false ;
    cmm:cimMappingLevel "surrogate-key" ;
    cmm:businessTerm "Self-Report Identifier (ID)" ;
    cmm:cimDatatype "Integer" .
cmm:SelfReport.auditFinding a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "audit finding"@en ;
    rdfs:comment "Foreign key linking to compliance.audit_finding. Business justification: A self-report may be triggered by an internal audit finding that discovered a compliance gap. Many self-reports can relate to one finding (1:N). Adding audit_finding_id FK links the self-report to the"@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range cmm:AuditFinding ;
    cmm:physicalColumn "audit_finding_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Audit Finding Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_self_report_audit_finding_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:SelfReport.exception a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "exception"@en ;
    rdfs:comment "Foreign key linking to compliance.exception. Business justification: A self-report may be triggered by a compliance exception discovered through internal monitoring. Many self-reports can relate to one exception (1:N). Adding exception_id FK links the self-report to th"@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range cmm:ComplianceException ;
    cmm:physicalColumn "exception_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Exception Id (Foreign Key)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_self_report_exception_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:SelfReport.obligation a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "obligation"@en ;
    rdfs:comment "Reference to the specific compliance obligation, regulatory standard, or requirement that was allegedly violated or not met."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range cmm:ComplianceObligation ;
    cmm:physicalColumn "obligation_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Obligation Identifier (ID)" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_self_report_obligation_id" ;
    cmm:cimAssociation "Document.Document" .
cmm:SelfReport.responsibleManagerEmployee a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "responsible manager employee"@en ;
    rdfs:comment "Foreign key linking to workforce.employee. Business justification: Self-reports require manager accountability for violation discovery and mitigation. Replaces text field with FK to enable self-reporting workload tracking, escalation management, and compliance cultur"@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range cmm:Employee ;
    cmm:physicalColumn "responsible_manager_employee_id" ;
    cmm:sqlDataType "BIGINT" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "association" ;
    cmm:businessTerm "Responsible Manager Employee Id (Foreign Key)" ;
    cmm:sourceColumn "employee_id" ;
    cmm:sensitivity "confidential" ;
    cmm:sensitivity "pii" ;
    cmm:cimDatatype "Integer" ;
    cmm:fkConstraint "fk_compliance_self_report_responsible_manager_employee_id" ;
    cmm:cimAssociation "Document.ErpPersonnel" .
cmm:SelfReport.activeFlag a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "active flag"@en ;
    rdfs:comment "Indicates whether this self-report record is currently active and valid in the system."@en ;
    rdfs:domain cmm:SelfReport ; rdfs:range xsd:boolean ;
    cmm:physicalColumn "active_flag" ;
    cmm:sqlDataType "BOOLEAN" ;
    cmm:nullable true ;
    cmm:cimMappingLevel "extension" ;
    cmm:businessTerm "Active Flag" ;
    cmm:cimDatatype "Boolean" .
cmm:SelfReport.actualPenaltyAssessed a owl:DatatypeProperty , owl:FunctionalProperty ;
