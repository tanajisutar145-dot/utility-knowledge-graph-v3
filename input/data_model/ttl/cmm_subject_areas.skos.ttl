cmmsa:workforce a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:topConceptOf cmmsa:scheme ;
    skos:prefLabel "Workforce"@en ;
    skos:definition "Utility workforce management including field crews, linemen, plant operators, engineers, dispatchers, meter readers, and administrative staff. Manages employee records, certifications (NERC CIP personnel risk assessments), OSHA safety compliance, union agreements, crew scheduling, time and attendance, contractor workforce, and labor cost allocations to work orders. Serves as SSOT for personnel identity referenced by asset maintenance, grid operations, and compliance domains."@en ;
    skos:scopeNote "CIM packages: IEC61968::Common (Crew, Person); IEC61968::InfERPSupport (ErpPersonnel); IEC61968::InfWork | Standards: IEC 61968-6; IEC 61968-10; OSHA 29 CFR 1910.269; NERC CIP-004; DOT 49 CFR Part 40"@en ;
    skos:narrower cmmsa:workforce.cost_allocation , cmmsa:workforce.safety_compliance , cmmsa:workforce.talent_management , cmmsa:workforce.workforce_scheduling .
cmmsa:workforce.cost_allocation a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:broader cmmsa:workforce ; skos:prefLabel "Cost Allocation"@en .
cmmsa:workforce.safety_compliance a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:broader cmmsa:workforce ; skos:prefLabel "Safety Compliance"@en .
cmmsa:workforce.talent_management a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:broader cmmsa:workforce ; skos:prefLabel "Talent Management"@en .
cmmsa:workforce.workforce_scheduling a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:broader cmmsa:workforce ; skos:prefLabel "Workforce Scheduling"@en .

cmmsa:gis a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:topConceptOf cmmsa:scheme ;
    skos:prefLabel "Gis"@en ;
    skos:definition "CMM GIS / spatial subject area: CIM Location, PositionPoint and CoordinateSystem, CIM network topology (ConnectivityNode, Terminal), geographical regions and the Esri ArcGIS Utility Network feature/association model. Single source of geometry for every locatable canonical entity."@en ;
    skos:scopeNote "CIM packages: IEC61968::Common (Location, PositionPoint, CoordinateSystem); IEC61970::Topology; IEC61970::Core | Standards: OGC GeoSPARQL 1.1; ISO 19125 Simple Features; ISO 19111/EPSG; Esri ArcGIS Utility Network; H3"@en .

cmmsa:cmm_meta a skos:Concept ; skos:inScheme cmmsa:scheme ; skos:topConceptOf cmmsa:scheme ;
    skos:prefLabel "Cmm Meta"@en ;
    skos:definition "CMM model metadata registry (ISO/IEC 11179 style): CIM class registry, canonical entity/attribute registries, relationships, enumerations, source lineage and data-quality results."@en ;
    skos:scopeNote "CIM packages:  | Standards: ISO/IEC 11179 (metadata registry)"@en .

